tionary_mapping_workstream","hrefExact":"?bref=Ezra.10.30","rawQueryValue":"Ezra.10.30","sourceRefExact":"Ezra.10.30"},{"anchorText":"Ezr 10:35","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.10.35","rawQueryValue":"Ezra.10.35","sourceRefExact":"Ezra.10.35"},{"anchorText":"Ezr 10:43","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.10.43","rawQueryValue":"Ezra.10.43","sourceRefExact":"Ezra.10.43"},{"anchorText":"Ez 11:1, 13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.11.1,13","rawQueryValue":"Ezek.11.1,13","sourceRefExact":"Ezek.11.1,13"}],"sourceItemFragmentSha256":"4ab5b55d5ec0e5f1e0880e106c0760b1da2aa528c1c2b8197f57784e34a49500","sourceItemName":"Benaiah","sourceItemOrder":174,"sourceMember":"Articles/B.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Benaiah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Benaiah","title":"Benaiah","version":"v2-a101d843a2f0cd3fc0c6"}