{"content":[{"c":["ETHBAAL"],"sourceClass":"h1","t":"p"},{"c":["King of Sidon whose daughter Jezebel entered into a political marriage with Ahab of Israel (",{"href":"?bref=1Kgs.16.31","r":"1Kgs.16.31","rawR":"1Kgs.16.31","sourceRefs":[{"raw":"1Kgs.16.31","value":"1Kgs.16.31"}],"t":"ref","v":"1 Kgs 16:31"},"). Ethbaal was credited with building Botrys in Phoenicia and founding the colony of Auza in Libya. He also established commercial relations with Damascus."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Ethbaal","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Kgs 16:31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.16.31","rawQueryValue":"1Kgs.16.31","sourceRefExact":"1Kgs.16.31"}],"sourceItemFragmentSha256":"3aadad860570e4f004d71aaa501ad38361a0574220c511040ae152227052ce0e","sourceItemName":"Ethbaal","sourceItemOrder":261,"sourceMember":"Articles/E.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Ethbaal","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Ethbaal","title":"Ethbaal","version":"v2-a101d843a2f0cd3fc0c6"}