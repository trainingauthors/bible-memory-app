{"content":[{"c":["IGAL"],"sourceClass":"h1","t":"p"},{"c":["1. Joseph’s son from Issachar’s tribe and one of the 12 spies sent by Moses to search out Canaan (",{"href":"?bref=Num.13.7","r":"Num.13.7","rawR":"Num.13.7","sourceRefs":[{"raw":"Num.13.7","value":"Num.13.7"}],"t":"ref","v":"Nm 13:7"},")."],"sourceClass":"list","t":"p"},{"c":["2. Nathan’s son and one of David’s mighty men (",{"href":"?bref=2Sam.23.36","r":"2Sam.23.36","rawR":"2Sam.23.36","sourceRefs":[{"raw":"2Sam.23.36","value":"2Sam.23.36"}],"t":"ref","v":"2 Sm 23:36"},"). In ",{"href":"?bref=1Chr.11.38","r":"1Chr.11.38","rawR":"1Chr.11.38","sourceRefs":[{"raw":"1Chr.11.38","value":"1Chr.11.38"}],"t":"ref","v":"1 Chronicles 11:38"}," he is called Joel, Nathan’s brother (in Hebrew, only one letter different from Igal)."],"sourceClass":"list","t":"p"},{"c":["3. Shemaiah’s son and a descendant of King David through King Jehoiachin (",{"href":"?bref=1Chr.3.22","r":"1Chr.3.22","rawR":"1Chr.3.22","sourceRefs":[{"raw":"1Chr.3.22","value":"1Chr.3.22"}],"t":"ref","v":"1 Chr 3:22"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Igal","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Nm 13:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.13.7","rawQueryValue":"Num.13.7","sourceRefExact":"Num.13.7"},{"anchorText":"2 Sm 23:36","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.23.36","rawQueryValue":"2Sam.23.36","sourceRefExact":"2Sam.23.36"},{"anchorText":"1 Chronicles 11:38","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.11.38","rawQueryValue":"1Chr.11.38","sourceRefExact":"1Chr.11.38"},{"anchorText":"1 Chr 3:22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.3.22","rawQueryValue":"1Chr.3.22","sourceRefExact":"1Chr.3.22"}],"so