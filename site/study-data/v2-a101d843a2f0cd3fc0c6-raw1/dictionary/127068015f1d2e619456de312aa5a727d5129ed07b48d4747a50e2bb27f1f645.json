{"content":[{"c":["MIJAMIN"],"sourceClass":"h1","t":"p"},{"c":["1. Priest who ministered during the time of David (",{"href":"?bref=1Chr.24.9","r":"1Chr.24.9","rawR":"1Chr.24.9","sourceRefs":[{"raw":"1Chr.24.9","value":"1Chr.24.9"}],"t":"ref","v":"1 Chr 24:9"},")."],"sourceClass":"list","t":"p"},{"c":["2. Parosh’s son, who was encouraged by Ezra to divorce his foreign wife during the postexilic period (",{"href":"?bref=Ezra.10.25","r":"Ezra.10.25","rawR":"Ezra.10.25","sourceRefs":[{"raw":"Ezra.10.25","value":"Ezra.10.25"}],"t":"ref","v":"Ezr 10:25"},")."],"sourceClass":"list","t":"p"},{"c":["3. One of the priests who signed Ezra’s covenant during the postexilic period (",{"href":"?bref=Neh.10.7","r":"Neh.10.7","rawR":"Neh.10.7","sourceRefs":[{"raw":"Neh.10.7","value":"Neh.10.7"}],"t":"ref","v":"Neh 10:7"},")."],"sourceClass":"list","t":"p"},{"c":["4. Priest who returned to Jerusalem with Zerubbabel after the exile (",{"href":"?bref=Neh.12.5","r":"Neh.12.5","rawR":"Neh.12.5","sourceRefs":[{"raw":"Neh.12.5","value":"Neh.12.5"}],"t":"ref","v":"Neh 12:5"},", ",{"c":["nlt"],"sourceClass":"sc","t":"span"}," “Miniamin”)."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Mijamin","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 24:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.24.9","rawQueryValue":"1Chr.24.9","sourceRefExact":"1Chr.24.9"},{"anchorText":"Ezr 10:25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.10.25","rawQueryValue":"Ezra.10.25","sourceRefExact":"Ezra.10.25"},{"anchorText":"Neh 10:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.10.7","rawQueryValue":"Neh.10.7","sourceRefExact":"Neh.10.7"},{"anchorText":"Neh 12:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.12