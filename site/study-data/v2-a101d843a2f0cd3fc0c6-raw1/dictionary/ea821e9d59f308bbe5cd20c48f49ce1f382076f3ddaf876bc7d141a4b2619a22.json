{"content":[{"c":["ELAH, Valley of"],"sourceClass":"h1","t":"p"},{"c":["Southernmost valley in the Shephelah, starting at Hebron and descending in a northerly direction before turning west. At the Wadi al-Sant it comes together with other valleys, and at this juncture there is a wide, level valley about one-half mile (.8 kilometer) wide. It was here that the great struggle between David and Goliath took place, with the Philistine army camped on the southern hills and Saul’s army on the north or northeast (",{"href":"?bref=1Sam.17.2,19","r":"1Sam.17.2,19","rawR":"1Sam.17.2,19","sourceRefs":[{"raw":"1Sam.17.2,19","value":"1Sam.17.2,19"}],"t":"ref","v":"1 Sm 17:2, 19"},"; ",{"href":"?bref=1Sam.21.9","r":"1Sam.21.9","rawR":"1Sam.21.9","sourceRefs":[{"raw":"1Sam.21.9","value":"1Sam.21.9"}],"t":"ref","v":"21:9"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"ElahValleyof","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Sm 17:2, 19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.17.2,19","rawQueryValue":"1Sam.17.2,19","sourceRefExact":"1Sam.17.2,19"},{"anchorText":"21:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.21.9","rawQueryValue":"1Sam.21.9","sourceRefExact":"1Sam.21.9"}],"sourceItemFragmentSha256":"36d1d694d9662af2d64a1c62921cf02e945dcfe179484ede3e39be1ff66fc4d7","sourceItemName":"ElahValleyof","sourceItemOrder":55,"sourceMember":"Articles/E.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"ElahValleyof","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Elah, Valley of","title":"Elah, Valley of","version":"v2-a101d843a2f0cd3fc0c6"}