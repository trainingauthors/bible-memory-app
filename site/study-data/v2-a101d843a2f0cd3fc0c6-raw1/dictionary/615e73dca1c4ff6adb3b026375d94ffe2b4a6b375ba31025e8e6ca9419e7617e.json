{"content":[{"c":["SHETHAR-BOZENAI, SHETHAR-BOZNAI*"],"sourceClass":"h1","t":"p"},{"c":["Persian official in a province west of the Euphrates River, who joined with Tattenai and his colleagues in writing a letter to Darius Hystaspeis, king of Persia, protesting the rebuilding of the temple and walls of Jerusalem under Zerubbabel (",{"href":"?bref=Ezra.5.3,6","r":"Ezra.5.3,6","rawR":"Ezra.5.3,6","sourceRefs":[{"raw":"Ezra.5.3,6","value":"Ezra.5.3,6"}],"t":"ref","v":"Ezr 5:3, 6"},"). Darius warned them not to interfere with Zerubbabel’s work, and they obeyed him (",{"href":"?bref=Ezra.6.6,13","r":"Ezra.6.6,13","rawR":"Ezra.6.6,13","sourceRefs":[{"raw":"Ezra.6.6,13","value":"Ezra.6.6,13"}],"t":"ref","v":"Ezr 6:6, 13"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"ShetharBozenaiShetharBoznai","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ezr 5:3, 6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.5.3,6","rawQueryValue":"Ezra.5.3,6","sourceRefExact":"Ezra.5.3,6"},{"anchorText":"Ezr 6:6, 13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.6.6,13","rawQueryValue":"Ezra.6.6,13","sourceRefExact":"Ezra.6.6,13"}],"sourceItemFragmentSha256":"4d9b115cbfabb938414bcc8f0510c7f329f26bcc37c7f319eb37bfa1993db1a9","sourceItemName":"ShetharBozenaiShetharBoznai","sourceItemOrder":305,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"ShetharBozenaiShetharBoznai","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Shethar-Bozenai, Shethar-Boznai*","title":"Shethar-Bozenai, Shethar-Boznai*","version":"v2-a101d843a2f0cd3fc0c6"}