lization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.28.1-26","rawQueryValue":"Ezek.28.1-26","sourceRefExact":"Ezek.28.1-26"},{"anchorText":"Is 3:16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.3.16","rawQueryValue":"Isa.3.16","sourceRefExact":"Isa.3.16"},{"anchorText":"5:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.5.15","rawQueryValue":"Isa.5.15","sourceRefExact":"Isa.5.15"},{"anchorText":"Ez 16:50","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.16.50","rawQueryValue":"Ezek.16.50","sourceRefExact":"Ezek.16.50"},{"anchorText":"Hos 13:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Hos.13.6","rawQueryValue":"Hos.13.6","sourceRefExact":"Hos.13.6"},{"anchorText":"Zep 3:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Zeph.3.11","rawQueryValue":"Zeph.3.11","sourceRefExact":"Zeph.3.11"},{"anchorText":"Is 10:12, 33","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.10.12,33","rawQueryValue":"Isa.10.12,33","sourceRefExact":"Isa.10.12,33"},{"anchorText":"Jer 48:29","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.48.29","rawQueryValue":"Jer.48.29","sourceRefExact":"Jer.48.29"},{"anchorText":"Dt 8:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.8.14","rawQueryValue":"Deut.8.14","sourceRefExact":"Deut.8.14"},{"anchorText":"Prv 6:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Pr.6.17","rawQueryValue":"Pr.6.17","sourceRefExact":"Pr.6.17"},{"anchorText":"Jas 4:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jas.4.6","rawQueryValue":"Jas.4.6","sourceRefExact":"Jas.4.6"},{"anchorText":"1 Pt 5:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Pet.5.5","rawQueryValue":"1Pet.5.5","sourceRefExact":"1Pet.5.5"},{"anchorText":"Prv 3:34","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Pr.3.34","rawQueryValue":"Pr.3.34","sourceRefExact":"Pr.3.34"},{"anchorText":"18:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Pr.18.12","rawQueryValue":"Pr.18.12","sourceRefExact":"Pr.18.12"},{"anchorText":"Lk 1:51-52","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.1.51-52","rawQueryValue":"Luke.1.51-52","sourceRefExact":"Luke.1.51-52"}],"sourceItemFragmentSha256":"85c8e7d7f75e78844d6cc3cabce103610cde3462ca536d91effbfd388e6fd38f","sourceItemName":"Pride","sourceItemOrder":269,"sourceMember":"Articles/P.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Pride","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Pride","title":"Pride","version":"v2-a101d843a2f0cd3fc0c6"}