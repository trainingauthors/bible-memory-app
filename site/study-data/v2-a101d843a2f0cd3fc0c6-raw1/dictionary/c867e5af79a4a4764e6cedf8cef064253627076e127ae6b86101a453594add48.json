sourceRefExact":"Ps.89.1-52"},{"anchorText":"1 Chronicles 15:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.15.17","rawQueryValue":"1Chr.15.17","sourceRefExact":"1Chr.15.17"},{"anchorText":"Nm 26:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.26.13","rawQueryValue":"Num.26.13","sourceRefExact":"Num.26.13"},{"anchorText":"1 Chr 4:24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.4.24","rawQueryValue":"1Chr.4.24","sourceRefExact":"1Chr.4.24"},{"anchorText":"Genesis 46:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.46.10","rawQueryValue":"Gen.46.10","sourceRefExact":"Gen.46.10"},{"anchorText":"Exodus 6:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.6.15","rawQueryValue":"Exod.6.15","sourceRefExact":"Exod.6.15"},{"anchorText":"1 Chr 6:21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.6.21","rawQueryValue":"1Chr.6.21","sourceRefExact":"1Chr.6.21"},{"anchorText":"1 Chr 6:41","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.6.41","rawQueryValue":"1Chr.6.41","sourceRefExact":"1Chr.6.41"},{"anchorText":"2 Chr 14:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.14.9","rawQueryValue":"2Chr.14.9","sourceRefExact":"2Chr.14.9"}],"sourceItemFragmentSha256":"a98214ed27439978ecce3eec766633cec4183bcc6149b7663f5236a1b75b4121","sourceItemName":"Zerah","sourceItemOrder":82,"sourceMember":"Articles/Z.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Zerah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Zerah","title":"Zerah","version":"v2-a101d843a2f0cd3fc0c6"}