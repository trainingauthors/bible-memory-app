,17","sourceRefExact":"1Chr.25.3,17"},{"anchorText":"1 Chr 27:27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.27.27","rawQueryValue":"1Chr.27.27","sourceRefExact":"1Chr.27.27"},{"anchorText":"2 Chr 29:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.29.14","rawQueryValue":"2Chr.29.14","sourceRefExact":"2Chr.29.14"},{"anchorText":"2 Chr 31:12-13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.31.12-13","rawQueryValue":"2Chr.31.12-13","sourceRefExact":"2Chr.31.12-13"},{"anchorText":"Ezr 10:23, 33, 38","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.10.23,33,38","rawQueryValue":"Ezra.10.23,33,38","sourceRefExact":"Ezra.10.23,33,38"},{"anchorText":"Est 2:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Esth.2.5","rawQueryValue":"Esth.2.5","sourceRefExact":"Esth.2.5"}],"sourceItemFragmentSha256":"84360cb1c5b0ee38d718361967655fd82e98b3eb725e547ed141a5c63bd3d25d","sourceItemName":"Shimei","sourceItemOrder":330,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Shimei","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Shimei","title":"Shimei","version":"v2-a101d843a2f0cd3fc0c6"}