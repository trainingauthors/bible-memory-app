{"content":[{"c":["JETUR, JETURITES"],"sourceClass":"h1","t":"p"},{"c":["Son of Ishmael and his descendants (",{"href":"?bref=Gen.25.15","r":"Gen.25.15","rawR":"Gen.25.15","sourceRefs":[{"raw":"Gen.25.15","value":"Gen.25.15"}],"t":"ref","v":"Gn 25:15"},"; ",{"href":"?bref=1Chr.1.31","r":"1Chr.1.31","rawR":"1Chr.1.31","sourceRefs":[{"raw":"1Chr.1.31","value":"1Chr.1.31"}],"t":"ref","v":"1 Chr 1:31"},"); the Israelite tribes who settled east of the Jordan had to fight them (",{"href":"?bref=1Chr.5.19","r":"1Chr.5.19","rawR":"1Chr.5.19","sourceRefs":[{"raw":"1Chr.5.19","value":"1Chr.5.19"}],"t":"ref","v":"1 Chr 5:19"},"). Also called Itureans, they survived into NT times, giving their name to Iturea, an area northeast of Galilee (",{"href":"?bref=Luke.3.1","r":"Luke.3.1","rawR":"Luke.3.1","sourceRefs":[{"raw":"Luke.3.1","value":"Luke.3.1"}],"t":"ref","v":"Lk 3:1"},"). ",{"c":["See"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=IturaeaItureaItureans_Article_TyndaleOpenBibleDictionary","id":"IturaeaItureaItureans_Article_TyndaleOpenBibleDictionary","rawId":"IturaeaItureaItureans_Article_TyndaleOpenBibleDictionary","t":"link","v":"Ituraea, Iturea, Itureans"},"."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"JeturJeturites","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 25:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.25.15","rawQueryValue":"Gen.25.15","sourceRefExact":"Gen.25.15"},{"anchorText":"1 Chr 1:31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.1.31","rawQueryValue":"1Chr.1.31","sourceRefExact":"1Chr.1.31"},{"anchorText":"1 Chr 5:19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.5.19","rawQueryValue":"1Chr.5.19","sourceRefExact":"1Chr.5.19"},{"anchorText":"Lk 3:1","canonicalization":"deferred_to_dic