{"content":[{"c":["TENTMAKER"],"sourceClass":"h1","t":"p"},{"c":["Artisans who made tents from the cloth of woven goats’ hair. The Greek term for tentmaker may have served to denote a range of activities in cloth and leather. The single biblical reference (",{"href":"?bref=Acts.18.3","r":"Acts.18.3","rawR":"Acts.18.3","sourceRefs":[{"raw":"Acts.18.3","value":"Acts.18.3"}],"t":"ref","v":"Acts 18:3"},") is to Aquila and Priscilla of Corinth, who worked in this trade. Paul joined them because he was trained in the same craft. He regularly earned his living at this trade during his missionary journeys (",{"href":"?bref=2Cor.11.7-10","r":"2Cor.11.7-10","rawR":"2Cor.11.7-10","sourceRefs":[{"raw":"2Cor.11.7-10","value":"2Cor.11.7-10"}],"t":"ref","v":"2 Cor 11:7-10"},"; ",{"href":"?bref=1Thes.2.9","r":"1Thes.2.9","rawR":"1Thes.2.9","sourceRefs":[{"raw":"1Thes.2.9","value":"1Thes.2.9"}],"t":"ref","v":"1 Thes 2:9"},"; ",{"href":"?bref=2Thes.3.8","r":"2Thes.3.8","rawR":"2Thes.3.8","sourceRefs":[{"raw":"2Thes.3.8","value":"2Thes.3.8"}],"t":"ref","v":"2 Thes 3:8"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Tentmaker","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Acts 18:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.18.3","rawQueryValue":"Acts.18.3","sourceRefExact":"Acts.18.3"},{"anchorText":"2 Cor 11:7-10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Cor.11.7-10","rawQueryValue":"2Cor.11.7-10","sourceRefExact":"2Cor.11.7-10"},{"anchorText":"1 Thes 2:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Thes.2.9","rawQueryValue":"1Thes.2.9","sourceRefExact":"1Thes.2.9"},{"anchorText":"2 Thes 3:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Thes.3.8","rawQueryValue":"2Thes.3.8","sourceRefExact":"2Thes.3.8"}],"sourceItemFragmentSha256":"458f47e9c7e96c3a886d7f3dcd355661e0608e6cb4bfc2f18bf8cf33e639be77","sourceItemName":"Tentmaker","sourceItemOrder":99,"sourceMember":"Articles/T.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Tentmaker","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Tentmaker","title":"Tentmaker","version":"v2-a101d843a2f0cd3fc0c6"}