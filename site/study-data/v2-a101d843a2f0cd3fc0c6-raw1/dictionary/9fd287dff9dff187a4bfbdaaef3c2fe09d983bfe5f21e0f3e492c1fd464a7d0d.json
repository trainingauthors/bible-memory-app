{"content":[{"c":["ACZIB"],"sourceClass":"h1","t":"p"},{"c":["1. City in Judah’s territory (",{"href":"?bref=Josh.15.44","r":"Josh.15.44","rawR":"Josh.15.44","sourceRefs":[{"raw":"Josh.15.44","value":"Josh.15.44"}],"t":"ref","v":"Jos 15:44"},"). The prophet Micah listed it among cities that would be destroyed with Samaria (",{"href":"?bref=Mic.1.14","r":"Mic.1.14","rawR":"Mic.1.14","sourceRefs":[{"raw":"Mic.1.14","value":"Mic.1.14"}],"t":"ref","v":"Mi 1:14"},"). It was probably the same as Chezib (",{"href":"?bref=Gen.38.5","r":"Gen.38.5","rawR":"Gen.38.5","sourceRefs":[{"raw":"Gen.38.5","value":"Gen.38.5"}],"t":"ref","v":"Gn 38:5"},") and Cozeba (",{"href":"?bref=1Chr.4.22","r":"1Chr.4.22","rawR":"1Chr.4.22","sourceRefs":[{"raw":"1Chr.4.22","value":"1Chr.4.22"}],"t":"ref","v":"1 Chr 4:22"},")."],"sourceClass":"list","t":"p"},{"c":["2. City in Asher’s territory (",{"href":"?bref=Josh.19.29","r":"Josh.19.29","rawR":"Josh.19.29","sourceRefs":[{"raw":"Josh.19.29","value":"Josh.19.29"}],"t":"ref","v":"Jos 19:29"},"), one of seven from which the tribe failed to drive out the Canaanite inhabitants (",{"href":"?bref=Judg.1.31","r":"Judg.1.31","rawR":"Judg.1.31","sourceRefs":[{"raw":"Judg.1.31","value":"Judg.1.31"}],"t":"ref","v":"Jgs 1:31"},"). Recent excavations at Aczib (modern ez-Zib) show that the town was occupied almost continuously from the ninth to the third centuries ",{"c":["BC"],"sourceClass":"era","t":"span"},"."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Aczib","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 15:44","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.44","rawQueryValue":"Josh.15.44","sourceRefExact":"Josh.15.44"},{"anchorText":"Mi 1:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mic.1.14","rawQueryValue":"Mic.1.14","sourceRefExact":"Mic.1.14"},{"anchorText":"Gn 38:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.38.5","rawQueryValue":"Gen.38.5","sourceRefExact":"Gen.38.5"},{"anchorText":"1 Chr 4:22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.4.22","rawQueryValue":"1Chr.4.22","sourceRefExact":"1Chr.4.22"},{"anchorText":"Jos 19:29","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.19.29","rawQueryValue":"Josh.19.29","sourceRefExact":"Josh.19.29"},{"anchorText":"Jgs 1:31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.1.31","rawQueryValue":"Judg.1.31","sourceRefExact":"Judg.1.31"}],"sourceItemFragmentSha256":"717522a26f2545c0d70efd24e04ee606b3e49b042a5b04e7df93ca23ad4a959b","sourceItemName":"Aczib","sourceItemOrder":96,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Aczib","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Aczib","title":"Aczib","version":"v2-a101d843a2f0cd3fc0c6"}