yValue":"Josh.13.4-5","sourceRefExact":"Josh.13.4-5"},{"anchorText":"Jgs 1:34-35","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.1.34-35","rawQueryValue":"Judg.1.34-35","sourceRefExact":"Judg.1.34-35"},{"anchorText":"Jos 18:1-4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.18.1-4","rawQueryValue":"Josh.18.1-4","sourceRefExact":"Josh.18.1-4"},{"anchorText":"19:40-48","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.19.40-48","rawQueryValue":"Josh.19.40-48","sourceRefExact":"Josh.19.40-48"},{"anchorText":"Jgs 18:30-31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.18.30-31","rawQueryValue":"Judg.18.30-31","sourceRefExact":"Judg.18.30-31"},{"anchorText":"1 Kgs 12:28-29","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.12.28-29","rawQueryValue":"1Kgs.12.28-29","sourceRefExact":"1Kgs.12.28-29"},{"anchorText":"2 Kgs 10:29","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.10.29","rawQueryValue":"2Kgs.10.29","sourceRefExact":"2Kgs.10.29"},{"anchorText":"2 Kgs 17:1-23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.17.1-23","rawQueryValue":"2Kgs.17.1-23","sourceRefExact":"2Kgs.17.1-23"},{"anchorText":"Ez 48:1-2, 32","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.48.1-2,32","rawQueryValue":"Ezek.48.1-2,32","sourceRefExact":"Ezek.48.1-2,32"},{"anchorText":"Rv 7:4-8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.7.4-8","rawQueryValue":"Rev.7.4-8","sourceRefExact":"Rev.7.4-8"}],"sourceItemFragmentSha256":"ed65aa0f0d03eb925aefecf7910521c0db99777d280f5514dbf0bcdaa34b6fd7","sourceItemName":"DanTribeof","sourceItemOrder":15,"sourceMember":"Articles/D.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"DanTribeof","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Dan, Tribe of","title":"Dan, Tribe of","version":"v2-a101d843a2f0cd3fc0c6"}