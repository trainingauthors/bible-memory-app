{"content":[{"c":["POTSHERD GATE"],"sourceClass":"h1","t":"p"},{"c":["Gate in the south section of the preexilic Jerusalem wall. It led to the valley of Hinnom and to the Potter’s Field. Potters could dispose of sherds there, hence its name. The ",{"c":["kjv"],"sourceClass":"sc","t":"span"}," (relating the term to the Hebrew word for sun) renders it “east gate” (",{"href":"?bref=Jer.19.2","r":"Jer.19.2","rawR":"Jer.19.2","sourceRefs":[{"raw":"Jer.19.2","value":"Jer.19.2"}],"t":"ref","v":"Jer 19:2"},")."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Jerusalem_Article_TyndaleOpenBibleDictionary","id":"Jerusalem_Article_TyndaleOpenBibleDictionary","rawId":"Jerusalem_Article_TyndaleOpenBibleDictionary","t":"link","v":"Jerusalem"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"PotsherdGate","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jer 19:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.19.2","rawQueryValue":"Jer.19.2","sourceRefExact":"Jer.19.2"}],"sourceItemFragmentSha256":"1c3b075b94c79f42848f1db744fc375c8f8392317b8c1ca6cfad0877f7d3c4c8","sourceItemName":"PotsherdGate","sourceItemOrder":249,"sourceMember":"Articles/P.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"PotsherdGate","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Potsherd Gate","title":"Potsherd Gate","version":"v2-a101d843a2f0cd3fc0c6"}