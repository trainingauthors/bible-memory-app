{"content":[{"c":["AHZAI"],"sourceClass":"h1","t":"p"},{"c":["Priest of the order of Immer. Ahzai’s descendant, Amashsai, was a leading priest in Jerusalem in Ezra’s day (",{"href":"?bref=Neh.11.13","r":"Neh.11.13","rawR":"Neh.11.13","sourceRefs":[{"raw":"Neh.11.13","value":"Neh.11.13"}],"t":"ref","v":"Neh 11:13"},"). In all probability Ahzai and Jahzerah were the same person (",{"href":"?bref=1Chr.9.12","r":"1Chr.9.12","rawR":"1Chr.9.12","sourceRefs":[{"raw":"1Chr.9.12","value":"1Chr.9.12"}],"t":"ref","v":"1 Chr 9:12"},"). ",{"c":["See"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Jahzerah_Article_TyndaleOpenBibleDictionary","id":"Jahzerah_Article_TyndaleOpenBibleDictionary","rawId":"Jahzerah_Article_TyndaleOpenBibleDictionary","t":"link","v":"Jahzerah"},"."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Ahzai","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Neh 11:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.11.13","rawQueryValue":"Neh.11.13","sourceRefExact":"Neh.11.13"},{"anchorText":"1 Chr 9:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.9.12","rawQueryValue":"1Chr.9.12","sourceRefExact":"1Chr.9.12"}],"sourceItemFragmentSha256":"d0eecf80e681964d42d33894749c5cd5ff9a3093bec7f94ecb670c99d73ff8f7","sourceItemName":"Ahzai","sourceItemOrder":212,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Ahzai","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Ahzai","title":"Ahzai","version":"v2-a101d843a2f0cd3fc0c6"}