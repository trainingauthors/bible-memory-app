{"content":[{"c":["MISHAEL"],"sourceClass":"h1","t":"p"},{"c":["1. Uzziel’s son (",{"href":"?bref=Exod.6.22","r":"Exod.6.22","rawR":"Exod.6.22","sourceRefs":[{"raw":"Exod.6.22","value":"Exod.6.22"}],"t":"ref","v":"Ex 6:22"},"), who, with his brother Elzaphan, was summoned by Moses to remove the bodies of Nadab and Abihu after they were killed for defiling the altar of the Lord (",{"href":"?bref=Lev.10.1-5","r":"Lev.10.1-5","rawR":"Lev.10.1-5","sourceRefs":[{"raw":"Lev.10.1-5","value":"Lev.10.1-5"}],"t":"ref","v":"Lv 10:1-5"},")."],"sourceClass":"list","t":"p"},{"c":["2. One who stood beside Ezra when the law was read (",{"href":"?bref=Neh.8.4","r":"Neh.8.4","rawR":"Neh.8.4","sourceRefs":[{"raw":"Neh.8.4","value":"Neh.8.4"}],"t":"ref","v":"Neh 8:4"},")."],"sourceClass":"list","t":"p"},{"c":["3. Hebrew name for one of Daniel’s companions in Babylon (",{"href":"?bref=Dan.1.6","r":"Dan.1.6","rawR":"Dan.1.6","sourceRefs":[{"raw":"Dan.1.6","value":"Dan.1.6"}],"t":"ref","v":"Dn 1:6"},"), who, with Daniel and two others, remained faithful to God (vv ",{"href":"?bref=Dan.1.11,19","r":"Dan.1.11,19","rawR":"Dan.1.11,19","sourceRefs":[{"raw":"Dan.1.11,19","value":"Dan.1.11,19"}],"t":"ref","v":"11, 19"},") and was delivered from the fiery furnace into which he had been cast for refusing to obey the king’s edict (ch ",{"href":"?bref=Dan.3.1-30","r":"Dan.3.1-30","rawR":"Dan.3.1-30","sourceRefs":[{"raw":"Dan.3.1-30","value":"Dan.3.1-30"}],"t":"ref","v":"3"},"). His Babylonian name was Meshach (",{"href":"?bref=Dan.1.7","r":"Dan.1.7","rawR":"Dan.1.7","sourceRefs":[{"raw":"Dan.1.7","value":"Dan.1.7"}],"t":"ref","v":"1:7"},")."],"sourceClass":"list","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=ShadrachMeshachandAbednego_Article_TyndaleOpenBibleDictionary","id":"ShadrachMeshachandAbednego_Article_TyndaleOpenBibleDictionary","rawId":"ShadrachMeshachandAbednego_Article_TyndaleOpenBibleDictionary","t":"link","v":"Shadrach, Meshach, and Abednego"},"."],"sourceClass":"list-text","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Mishael","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ex 6:22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.6.22","rawQueryValue":"Exod.6.22","sourceRefExact":"Exod.6.22"},{"anchorText":"Lv 10:1-5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Lev.10.1-5","rawQueryValue":"Lev.10.1-5","sourceRefExact":"Lev.10.1-5"},{"anchorText":"Neh 8:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.8.4","rawQueryValue":"Neh.8.4","sourceRefExact":"Neh.8.4"},{"anchorText":"Dn 1:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Dan.1.6","rawQueryValue":"Dan.1.6","sourceRefExact":"Dan.1.6"},{"anchorText":"11, 19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Dan.1.11,19","rawQueryValue":"Dan.1.11,19","sourceRefExact":"Dan.1.11,19"},{"anchorText":"3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Dan.3.1-30","rawQueryValue":"Dan.3.1-30","sourceRefExact":"Dan.3.1-30"},{"anchorText":"1:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Dan.1.7","rawQueryValue":"Dan.1.7","sourceRefExact":"Dan.1.7"}],"sourceItemFragmentSha256":"e0a4f2afe724046c0abafa1cc252d87077e0f470324951e65c92e8ab78a4c8fa","sourceItemName":"Mishael","sourceItemOrder":352,"sourceMember":"Articles/M.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Mishael","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Mishael","title":"Mishael","version":"v2-a101d843a2f0cd3fc0c6"}