{"content":[{"c":["VALLEY GATE"],"sourceClass":"h1","t":"p"},{"c":["Gate from which Nehemiah went out to inspect the walls of Jerusalem and by which he reentered (",{"href":"?bref=Neh.2.13-14","r":"Neh.2.13-14","rawR":"Neh.2.13-14","sourceRefs":[{"raw":"Neh.2.13-14","value":"Neh.2.13-14"}],"t":"ref","v":"Neh 2:13-14"},"). It was on the west side of the city facing the Tyropeon Valley. King Uzziah is said to have built and fortified a tower at this gate (",{"href":"?bref=2Chr.26.9","r":"2Chr.26.9","rawR":"2Chr.26.9","sourceRefs":[{"raw":"2Chr.26.9","value":"2Chr.26.9"}],"t":"ref","v":"2 Chr 26:9"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"ValleyGate","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Neh 2:13-14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.2.13-14","rawQueryValue":"Neh.2.13-14","sourceRefExact":"Neh.2.13-14"},{"anchorText":"2 Chr 26:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.26.9","rawQueryValue":"2Chr.26.9","sourceRefExact":"2Chr.26.9"}],"sourceItemFragmentSha256":"1c9dc51fa5d8b761ea846c294d461e79245337a481fba36eef0a3799bfcea265","sourceItemName":"ValleyGate","sourceItemOrder":2,"sourceMember":"Articles/V.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"ValleyGate","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Valley Gate","title":"Valley Gate","version":"v2-a101d843a2f0cd3fc0c6"}