{"content":[{"c":["ARBA"],"sourceClass":"h1","t":"p"},{"c":["Ancestor of the giant Anakim and a great hero among them (",{"href":"?bref=Josh.15.13","r":"Josh.15.13","rawR":"Josh.15.13","sourceRefs":[{"raw":"Josh.15.13","value":"Josh.15.13"}],"t":"ref","v":"Jos 15:13"},"; ",{"href":"?bref=Josh.21.11","r":"Josh.21.11","rawR":"Josh.21.11","sourceRefs":[{"raw":"Josh.21.11","value":"Josh.21.11"}],"t":"ref","v":"21:11"},"). Arba was the founder of Kiriath-arba (city of Arba), later known as Hebron (",{"href":"?bref=Josh.14.15","r":"Josh.14.15","rawR":"Josh.14.15","sourceRefs":[{"raw":"Josh.14.15","value":"Josh.14.15"}],"t":"ref","v":"Jos 14:15"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Arba","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 15:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.13","rawQueryValue":"Josh.15.13","sourceRefExact":"Josh.15.13"},{"anchorText":"21:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.21.11","rawQueryValue":"Josh.21.11","sourceRefExact":"Josh.21.11"},{"anchorText":"Jos 14:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.14.15","rawQueryValue":"Josh.14.15","sourceRefExact":"Josh.14.15"}],"sourceItemFragmentSha256":"200eb174cb25bd0b48e33a5609adc9248f369a0b2d1a8929992d858aa35e577f","sourceItemName":"Arba","sourceItemOrder":449,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Arba","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Arba","title":"Arba","version":"v2-a101d843a2f0cd3fc0c6"}