{"content":[{"c":["AYYAH"],"sourceClass":"h1","t":"p"},{"c":["Town belonging to Ephraim’s tribe (",{"href":"?bref=1Chr.7.28","r":"1Chr.7.28","rawR":"1Chr.7.28","sourceRefs":[{"raw":"1Chr.7.28","value":"1Chr.7.28"}],"t":"ref","v":"1 Chr 7:28"},"), Gaza, but different from the Philistine Gaza. Some scholars think that Aija (",{"href":"?bref=Neh.11.31","r":"Neh.11.31","rawR":"Neh.11.31","sourceRefs":[{"raw":"Neh.11.31","value":"Neh.11.31"}],"t":"ref","v":"Neh 11:31"},") refers to Ayyah or to Ai, possibly a neighboring town. Many identify Aiath (",{"href":"?bref=Isa.10.28","r":"Isa.10.28","rawR":"Isa.10.28","sourceRefs":[{"raw":"Isa.10.28","value":"Isa.10.28"}],"t":"ref","v":"Is 10:28"},") with Ayyah and the town with the modern Khirbet Haiyan."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Ayyah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 7:28","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.7.28","rawQueryValue":"1Chr.7.28","sourceRefExact":"1Chr.7.28"},{"anchorText":"Neh 11:31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.11.31","rawQueryValue":"Neh.11.31","sourceRefExact":"Neh.11.31"},{"anchorText":"Is 10:28","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.10.28","rawQueryValue":"Isa.10.28","sourceRefExact":"Isa.10.28"}],"sourceItemFragmentSha256":"da4b30ca08589dd362467183bbc2b0523de76371ef4e2aad9bb420cb6cac556b","sourceItemName":"Ayyah","sourceItemOrder":633,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Ayyah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Ayyah","title":"Ayyah","version":"v2-a101d843a2f0cd3fc0c6"}