in","sourceItemOrder":147,"sourceMember":"Articles/J.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Jehoiachin","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Jehoiachin","title":"Jehoiachin","version":"v2-a101d843a2f0cd3fc0c6"}