{"content":[{"c":["NEPHTOAH, Waters of"],"sourceClass":"h1","t":"p"},{"c":["Geographical landmark situated between Mt Ephron to the west and the valley of Hinnom to the east, defining part of the boundary separating the tribes of Judah and Benjamin (",{"href":"?bref=Josh.15.9","r":"Josh.15.9","rawR":"Josh.15.9","sourceRefs":[{"raw":"Josh.15.9","value":"Josh.15.9"}],"t":"ref","v":"Jos 15:9"},"; ",{"href":"?bref=Josh.18.15","r":"Josh.18.15","rawR":"Josh.18.15","sourceRefs":[{"raw":"Josh.18.15","value":"Josh.18.15"}],"t":"ref","v":"18:15"},"). Its site is generally identified with Ain Lifta, three miles (4.8 kilometers) northwest of Jerusalem."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"NephtoahWatersof","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 15:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.9","rawQueryValue":"Josh.15.9","sourceRefExact":"Josh.15.9"},{"anchorText":"18:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.18.15","rawQueryValue":"Josh.18.15","sourceRefExact":"Josh.18.15"}],"sourceItemFragmentSha256":"700ce2ecc757660bfc2e0a5bcea687b21c9c9903ab51804aacce383d899ee83b","sourceItemName":"NephtoahWatersof","sourceItemOrder":103,"sourceMember":"Articles/N.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"NephtoahWatersof","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Nephtoah, Waters of","title":"Nephtoah, Waters of","version":"v2-a101d843a2f0cd3fc0c6"}