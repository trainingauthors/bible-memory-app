ictionary_mapping_workstream","hrefExact":"?bref=Gal.5.1","rawQueryValue":"Gal.5.1","sourceRefExact":"Gal.5.1"},{"anchorText":"Rom 8:21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rom.8.21","rawQueryValue":"Rom.8.21","sourceRefExact":"Rom.8.21"},{"anchorText":"Rom 6:1-4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rom.6.1-4","rawQueryValue":"Rom.6.1-4","sourceRefExact":"Rom.6.1-4"},{"anchorText":"Gal 5:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gal.5.13","rawQueryValue":"Gal.5.13","sourceRefExact":"Gal.5.13"},{"anchorText":"1 Pt 2:16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Pet.2.16","rawQueryValue":"1Pet.2.16","sourceRefExact":"1Pet.2.16"}],"sourceItemFragmentSha256":"f0b91a9f16daa6c67df95a556c983d0a2c31a381b8528030fee76cb0b4da6876","sourceItemName":"Liberty","sourceItemOrder":85,"sourceMember":"Articles/L.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Liberty","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Liberty*","title":"Liberty*","version":"v2-a101d843a2f0cd3fc0c6"}