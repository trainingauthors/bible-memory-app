{"content":[{"c":["BETH-TAPPUAH"],"sourceClass":"h1","t":"p"},{"c":["Town in the hill country of Judah’s territory (",{"href":"?bref=Josh.15.53","r":"Josh.15.53","rawR":"Josh.15.53","sourceRefs":[{"raw":"Josh.15.53","value":"Josh.15.53"}],"t":"ref","v":"Jos 15:53"},") named “place of fruit trees” because of its high ridge location and many fruitful orchards. Beth-tappuah is identified with modern Taffuh about four miles (6.4 kilometers) northwest of Hebron."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"BethTappuah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 15:53","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.53","rawQueryValue":"Josh.15.53","sourceRefExact":"Josh.15.53"}],"sourceItemFragmentSha256":"ec251611a4d06b3ff7e11846502ca157ec8b0324d9d6f8589c6354ff6a49f2f2","sourceItemName":"BethTappuah","sourceItemOrder":280,"sourceMember":"Articles/B.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"BethTappuah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Beth-Tappuah","title":"Beth-Tappuah","version":"v2-a101d843a2f0cd3fc0c6"}