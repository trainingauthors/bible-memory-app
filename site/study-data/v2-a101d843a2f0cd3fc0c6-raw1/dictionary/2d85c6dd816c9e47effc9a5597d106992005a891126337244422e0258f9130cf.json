{"content":[{"c":["APOLLONIA"],"sourceClass":"h1","t":"p"},{"c":["Town located on the Egnatian Way in eastern Macedonia. Paul passed through Apollonia on his second missionary journey west from Philippi to Thessalonica, a trip of about 90 miles (145 kilometers) (",{"href":"?bref=Acts.17.1","r":"Acts.17.1","rawR":"Acts.17.1","sourceRefs":[{"raw":"Acts.17.1","value":"Acts.17.1"}],"t":"ref","v":"Acts 17:1"},"). It is usually identified with modern Pollina."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Apollonia","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Acts 17:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.17.1","rawQueryValue":"Acts.17.1","sourceRefExact":"Acts.17.1"}],"sourceItemFragmentSha256":"83942f9ddd075fe4a17965fed3aefc78fbb93fc526bbae0007378ed15a8de262","sourceItemName":"Apollonia","sourceItemOrder":404,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Apollonia","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Apollonia","title":"Apollonia","version":"v2-a101d843a2f0cd3fc0c6"}