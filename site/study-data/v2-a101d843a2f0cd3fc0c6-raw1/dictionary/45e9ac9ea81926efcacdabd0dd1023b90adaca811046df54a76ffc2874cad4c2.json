ization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.13.10","rawQueryValue":"Isa.13.10","sourceRefExact":"Isa.13.10"},{"anchorText":"Ez 32:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.32.7","rawQueryValue":"Ezek.32.7","sourceRefExact":"Ezek.32.7"},{"anchorText":"Jl 2:10, 31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Joel.2.10,31","rawQueryValue":"Joel.2.10,31","sourceRefExact":"Joel.2.10,31"},{"anchorText":"3:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Joel.3.15","rawQueryValue":"Joel.3.15","sourceRefExact":"Joel.3.15"},{"anchorText":"Zep 1:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Zeph.1.15","rawQueryValue":"Zeph.1.15","sourceRefExact":"Zeph.1.15"},{"anchorText":"Mt 24:29","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.24.29","rawQueryValue":"Matt.24.29","sourceRefExact":"Matt.24.29"},{"anchorText":"Rv 8:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.8.12","rawQueryValue":"Rev.8.12","sourceRefExact":"Rev.8.12"},{"anchorText":"Is 30:26","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.30.26","rawQueryValue":"Isa.30.26","sourceRefExact":"Isa.30.26"}],"sourceItemFragmentSha256":"8630282198d2cd5b524a6f0c967a9c3f71f46f08d15211b53e5f50dfc2c262bb","sourceItemName":"Sun","sourceItemOrder":575,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Sun","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Sun","title":"Sun","version":"v2-a101d843a2f0cd3fc0c6"}