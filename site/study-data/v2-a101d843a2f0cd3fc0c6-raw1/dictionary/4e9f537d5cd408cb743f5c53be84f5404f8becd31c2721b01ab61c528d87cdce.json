{"content":[{"c":["MAHLAH"],"sourceClass":"h1","t":"p"},{"c":["1. Manassite; one of Zelophehad’s five daughters. She, with her sisters, appealed to Moses to work out an arrangement that would allow them to retain their inheritance in spite of having no brothers (",{"href":"?bref=Num.26.33","r":"Num.26.33","rawR":"Num.26.33","sourceRefs":[{"raw":"Num.26.33","value":"Num.26.33"}],"t":"ref","v":"Nm 26:33"},"; ",{"href":"?bref=Num.27.1","r":"Num.27.1","rawR":"Num.27.1","sourceRefs":[{"raw":"Num.27.1","value":"Num.27.1"}],"t":"ref","v":"27:1"},"; ",{"href":"?bref=Num.36.11","r":"Num.36.11","rawR":"Num.36.11","sourceRefs":[{"raw":"Num.36.11","value":"Num.36.11"}],"t":"ref","v":"36:11"},"; ",{"href":"?bref=Josh.17.3","r":"Josh.17.3","rawR":"Josh.17.3","sourceRefs":[{"raw":"Josh.17.3","value":"Josh.17.3"}],"t":"ref","v":"Jos 17:3"},")."],"sourceClass":"list","t":"p"},{"c":["2. Hammoleketh’s son from Manasseh’s tribe (",{"href":"?bref=1Chr.7.18","r":"1Chr.7.18","rawR":"1Chr.7.18","sourceRefs":[{"raw":"1Chr.7.18","value":"1Chr.7.18"}],"t":"ref","v":"1 Chr 7:18"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Mahlah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Nm 26:33","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.26.33","rawQueryValue":"Num.26.33","sourceRefExact":"Num.26.33"},{"anchorText":"27:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.27.1","rawQueryValue":"Num.27.1","sourceRefExact":"Num.27.1"},{"anchorText":"36:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.36.11","rawQueryValue":"Num.36.11","sourceRefExact":"Num.36.11"},{"anchorText":"Jos 17:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.17.3","rawQueryValue":"Josh.17.3","sourceRefExact":"Josh.17.3"},{"anchorTe