_workstream","hrefExact":"?bref=Neh.12.8","rawQueryValue":"Neh.12.8","sourceRefExact":"Neh.12.8"},{"anchorText":"Neh 12:34","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.12.34","rawQueryValue":"Neh.12.34","sourceRefExact":"Neh.12.34"},{"anchorText":"Neh 12:36","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.12.36","rawQueryValue":"Neh.12.36","sourceRefExact":"Neh.12.36"},{"anchorText":"Lk 3:30","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.3.30","rawQueryValue":"Luke.3.30","sourceRefExact":"Luke.3.30"}],"sourceItemFragmentSha256":"85b3fd0adda992d6bdf4a076662193fda3396d23362579731497e6dd38a86dc8","sourceItemName":"JudahPerson","sourceItemOrder":349,"sourceMember":"Articles/J.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"JudahPerson","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Judah (Person)","title":"Judah (Person)","version":"v2-a101d843a2f0cd3fc0c6"}