{"content":[{"c":["ANNA"],"sourceClass":"h1","t":"p"},{"c":["Phanuel’s daughter from Asher’s tribe and a prophetess in Jerusalem when Jesus was a young child. Advanced in years, she worshiped with prayer and fasting day and night in the temple. When Jesus was brought by his parents and presented to the Lord in the temple, she came up, thanking God and speaking of him to all who were looking for the redemption of Jerusalem (",{"href":"?bref=Luke.2.36-38","r":"Luke.2.36-38","rawR":"Luke.2.36-38","sourceRefs":[{"raw":"Luke.2.36-38","value":"Luke.2.36-38"}],"t":"ref","v":"Lk 2:36-38"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Anna","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Lk 2:36-38","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.2.36-38","rawQueryValue":"Luke.2.36-38","sourceRefExact":"Luke.2.36-38"}],"sourceItemFragmentSha256":"d92633bbceafc468f92af8f784f0b3449f8f467963e2e8ed8b9d457ebdf1fbb7","sourceItemName":"Anna","sourceItemOrder":357,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Anna","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Anna","title":"Anna","version":"v2-a101d843a2f0cd3fc0c6"}