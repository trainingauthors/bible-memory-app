{"content":[{"c":["TALMAI"],"sourceClass":"h1","t":"p"},{"c":["1. Son of Anak and brother of Ahiman and Sheshai. Talmai and his people were observed by the 12 Israelite spies when they searched out the land (",{"href":"?bref=Num.13.22","r":"Num.13.22","rawR":"Num.13.22","sourceRefs":[{"raw":"Num.13.22","value":"Num.13.22"}],"t":"ref","v":"Nm 13:22"},"). Later, Caleb successfully defeated Talmai and his brothers, who were living in Hebron (",{"href":"?bref=Josh.15.14","r":"Josh.15.14","rawR":"Josh.15.14","sourceRefs":[{"raw":"Josh.15.14","value":"Josh.15.14"}],"t":"ref","v":"Jos 15:14"},"; ",{"href":"?bref=Judg.1.10","r":"Judg.1.10","rawR":"Judg.1.10","sourceRefs":[{"raw":"Judg.1.10","value":"Judg.1.10"}],"t":"ref","v":"Jgs 1:10"},")."],"sourceClass":"list","t":"p"},{"c":["2. Son of Ammihud and father of Maacah. Maacah gave birth to Absalom, David’s third son (",{"href":"?bref=2Sam.3.3","r":"2Sam.3.3","rawR":"2Sam.3.3","sourceRefs":[{"raw":"2Sam.3.3","value":"2Sam.3.3"}],"t":"ref","v":"2 Sm 3:3"},"; ",{"href":"?bref=1Chr.3.2","r":"1Chr.3.2","rawR":"1Chr.3.2","sourceRefs":[{"raw":"1Chr.3.2","value":"1Chr.3.2"}],"t":"ref","v":"1 Chr 3:2"},"). Absalom eventually sought refuge in Talmai’s small kingdom of Geshur after murdering Amnon (",{"href":"?bref=2Sam.13.37","r":"2Sam.13.37","rawR":"2Sam.13.37","sourceRefs":[{"raw":"2Sam.13.37","value":"2Sam.13.37"}],"t":"ref","v":"2 Sm 13:37"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Talmai","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Nm 13:22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.13.22","rawQueryValue":"Num.13.22","sourceRefExact":"Num.13.22"},{"anchorText":"Jos 15:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.14","rawQueryValue":"Josh.15.14","sourceRefExact":"Josh.15.14"},{"anchorText":"Jgs 1:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.1.10","rawQueryValue":"Judg.1.10","sourceRefExact":"Judg.1.10"},{"anchorText":"2 Sm 3:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.3.3","rawQueryValue":"2Sam.3.3","sourceRefExact":"2Sam.3.3"},{"anchorText":"1 Chr 3:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.3.2","rawQueryValue":"1Chr.3.2","sourceRefExact":"1Chr.3.2"},{"anchorText":"2 Sm 13:37","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.13.37","rawQueryValue":"2Sam.13.37","sourceRefExact":"2Sam.13.37"}],"sourceItemFragmentSha256":"30eb3f5166381210e6ba7eb26573779ffe1edf3fbcf7c72410d29bf93ef143ae","sourceItemName":"Talmai","sourceItemOrder":35,"sourceMember":"Articles/T.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Talmai","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Talmai","title":"Talmai","version":"v2-a101d843a2f0cd3fc0c6"}