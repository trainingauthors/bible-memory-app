{"content":[{"c":["ZIPPORAH"],"sourceClass":"h1","t":"p"},{"c":["Wife of Moses and mother of his sons Gershom and Eliezer (",{"href":"?bref=Exod.2.21","r":"Exod.2.21","rawR":"Exod.2.21","sourceRefs":[{"raw":"Exod.2.21","value":"Exod.2.21"}],"t":"ref","v":"Ex 2:21"},"). Though she is listed as the daughter of Reuel (v ",{"href":"?bref=Exod.2.18","r":"Exod.2.18","rawR":"Exod.2.18","sourceRefs":[{"raw":"Exod.2.18","value":"Exod.2.18"}],"t":"ref","v":"18"},"), Reuel was probably the father of Hobab (",{"href":"?bref=Num.10.29","r":"Num.10.29","rawR":"Num.10.29","sourceRefs":[{"raw":"Num.10.29","value":"Num.10.29"}],"t":"ref","v":"Nm 10:29"},"; also called Jethro, ",{"href":"?bref=Exod.3.1","r":"Exod.3.1","rawR":"Exod.3.1","sourceRefs":[{"raw":"Exod.3.1","value":"Exod.3.1"}],"t":"ref","v":"Ex 3:1"},"; ",{"href":"?bref=Exod.4.18","r":"Exod.4.18","rawR":"Exod.4.18","sourceRefs":[{"raw":"Exod.4.18","value":"Exod.4.18"}],"t":"ref","v":"4:18"},"), who in turn was the father of Zipporah. Zipporah circumcised Gershom to prevent Moses’ death prior to his return to Egypt (",{"href":"?bref=Exod.4.25","r":"Exod.4.25","rawR":"Exod.4.25","sourceRefs":[{"raw":"Exod.4.25","value":"Exod.4.25"}],"t":"ref","v":"Ex 4:25"},"). Apparently at that point Zipporah and the children left Moses and went back to live with her father, returning later during the wilderness wanderings (",{"href":"?bref=Exod.18.2","r":"Exod.18.2","rawR":"Exod.18.2","sourceRefs":[{"raw":"Exod.18.2","value":"Exod.18.2"}],"t":"ref","v":"18:2"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Zipporah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ex 2:21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.2.21","rawQueryValue":"Exod.2.21","sourceRefExact":"Exod.2.21"},{"anchorText":"18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.2.18","rawQueryValue":"Exod.2.18","sourceRefExact":"Exod.2.18"},{"anchorText":"Nm 10:29","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.10.29","rawQueryValue":"Num.10.29","sourceRefExact":"Num.10.29"},{"anchorText":"Ex 3:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.3.1","rawQueryValue":"Exod.3.1","sourceRefExact":"Exod.3.1"},{"anchorText":"4:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.4.18","rawQueryValue":"Exod.4.18","sourceRefExact":"Exod.4.18"},{"anchorText":"Ex 4:25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.4.25","rawQueryValue":"Exod.4.25","sourceRefExact":"Exod.4.25"},{"anchorText":"18:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.18.2","rawQueryValue":"Exod.18.2","sourceRefExact":"Exod.18.2"}],"sourceItemFragmentSha256":"858d8ea9ffe6403a523ba7101011b8154172963f988ed0674190478b0ca65ae9","sourceItemName":"Zipporah","sourceItemOrder":136,"sourceMember":"Articles/Z.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Zipporah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Zipporah","title":"Zipporah","version":"v2-a101d843a2f0cd3fc0c6"}