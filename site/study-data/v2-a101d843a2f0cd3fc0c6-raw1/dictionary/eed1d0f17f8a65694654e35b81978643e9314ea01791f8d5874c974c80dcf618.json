{"content":[{"c":["ZIMRI (P",{"c":["lace"],"sourceClass":"lc","t":"span"},")"],"sourceClass":"h1","t":"p"},{"c":["Place and peoples of the East, listed along with Elam and Media, against whom God’s wrath would fall (",{"href":"?bref=Jer.25.25","r":"Jer.25.25","rawR":"Jer.25.25","sourceRefs":[{"raw":"Jer.25.25","value":"Jer.25.25"}],"t":"ref","v":"Jer 25:25"},"). Zimri’s location and history are unknown; some identify its progenitor with Zimran, Abraham and Keturah’s son (",{"href":"?bref=Gen.25.2","r":"Gen.25.2","rawR":"Gen.25.2","sourceRefs":[{"raw":"Gen.25.2","value":"Gen.25.2"}],"t":"ref","v":"Gn 25:2"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"ZimriPlace","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jer 25:25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.25.25","rawQueryValue":"Jer.25.25","sourceRefExact":"Jer.25.25"},{"anchorText":"Gn 25:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.25.2","rawQueryValue":"Gen.25.2","sourceRefExact":"Gen.25.2"}],"sourceItemFragmentSha256":"d5dac2ffb737b12f84ac6eb918d4f06c6b64960f1d2decbcf0cd9e728b122fdd","sourceItemName":"ZimriPlace","sourceItemOrder":122,"sourceMember":"Articles/Z.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"ZimriPlace","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Zimri (Place)","title":"Zimri (Place)","version":"v2-a101d843a2f0cd3fc0c6"}