{"content":[{"c":["MAON (P",{"c":["lace"],"sourceClass":"lc","t":"span"},")"],"sourceClass":"h1","t":"p"},{"c":["Chief town in the hill country of Judah (",{"href":"?bref=Josh.15.55","r":"Josh.15.55","rawR":"Josh.15.55","sourceRefs":[{"raw":"Josh.15.55","value":"Josh.15.55"}],"t":"ref","v":"Jos 15:55"},"), about nine miles (14.5 kilometers) south of Hebron. David and his men hid in this area while fleeing from Saul (",{"href":"?bref=1Sam.23.24-25","r":"1Sam.23.24-25","rawR":"1Sam.23.24-25","sourceRefs":[{"raw":"1Sam.23.24-25","value":"1Sam.23.24-25"}],"t":"ref","v":"1 Sm 23:24-25"},"), and David’s wife Abigail was from this town (",{"href":"?bref=1Sam.25.2-3","r":"1Sam.25.2-3","rawR":"1Sam.25.2-3","sourceRefs":[{"raw":"1Sam.25.2-3","value":"1Sam.25.2-3"}],"t":"ref","v":"25:2-3"},"). It has been identified with modern Tell Ma’in, where pottery was found dating from the time of David."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=MeunimMeunites_Article_TyndaleOpenBibleDictionary","id":"MeunimMeunites_Article_TyndaleOpenBibleDictionary","rawId":"MeunimMeunites_Article_TyndaleOpenBibleDictionary","t":"link","v":"Meunim, Meunites"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"MaonPlace","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 15:55","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.55","rawQueryValue":"Josh.15.55","sourceRefExact":"Josh.15.55"},{"anchorText":"1 Sm 23:24-25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.23.24-25","rawQueryValue":"1Sam.23.24-25","sourceRefExact":"1Sam.23.24-25"},{"anchorText":"25:2-3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.25.2-3","rawQueryValue":"1Sam.25.2-3","sourceRefExact":"1Sam.25.2-3"}],"sourceItemFragm