{"content":[{"c":["SHEMARIAH"],"sourceClass":"h1","t":"p"},{"c":["1. Warrior from the tribe of Benjamin who joined David at Ziklag in his struggle against King Saul. Shemariah was one of David’s ambidextrous archers and slingers (",{"href":"?bref=1Chr.12.5","r":"1Chr.12.5","rawR":"1Chr.12.5","sourceRefs":[{"raw":"1Chr.12.5","value":"1Chr.12.5"}],"t":"ref","v":"1 Chr 12:5"},")."],"sourceClass":"list","t":"p"},{"c":["2. One of Rehoboam’s sons (",{"href":"?bref=2Chr.11.19","r":"2Chr.11.19","rawR":"2Chr.11.19","sourceRefs":[{"raw":"2Chr.11.19","value":"2Chr.11.19"}],"t":"ref","v":"2 Chr 11:19"},"; ",{"c":["kjv"],"sourceClass":"sc","t":"span"}," “Shamariah”)."],"sourceClass":"list","t":"p"},{"c":["3. Harim’s son, who obeyed Ezra’s exhortation to divorce his foreign wife after the exile (",{"href":"?bref=Ezra.10.32","r":"Ezra.10.32","rawR":"Ezra.10.32","sourceRefs":[{"raw":"Ezra.10.32","value":"Ezra.10.32"}],"t":"ref","v":"Ezr 10:32"},")."],"sourceClass":"list","t":"p"},{"c":["4. Binnui’s son, who obeyed Ezra’s exhortation to divorce his foreign wife (",{"href":"?bref=Ezra.10.41","r":"Ezra.10.41","rawR":"Ezra.10.41","sourceRefs":[{"raw":"Ezra.10.41","value":"Ezra.10.41"}],"t":"ref","v":"Ezr 10:41"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Shemariah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 12:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.12.5","rawQueryValue":"1Chr.12.5","sourceRefExact":"1Chr.12.5"},{"anchorText":"2 Chr 11:19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.11.19","rawQueryValue":"2Chr.11.19","sourceRefExact":"2Chr.11.19"},{"anchorText":"Ezr 10:32","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.10.32","rawQueryValue":"Ezra.10.32","sourceRefExact":"Ezra.10.32"},{"anchorText":"Ezr 10:41","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.10.41","rawQueryValue":"Ezra.10.41","sourceRefExact":"Ezra.10.41"}],"sourceItemFragmentSha256":"2a98b3dbd1ba169fa082b156a0bd724e2651f22d8a285b6f688fad3f34285a55","sourceItemName":"Shemariah","sourceItemOrder":274,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Shemariah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Shemariah","title":"Shemariah","version":"v2-a101d843a2f0cd3fc0c6"}