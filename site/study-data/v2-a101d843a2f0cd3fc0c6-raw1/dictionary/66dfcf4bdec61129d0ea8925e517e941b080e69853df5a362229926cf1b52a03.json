{"content":[{"c":["HODAVIAH"],"sourceClass":"h1","t":"p"},{"c":["1. Postexilic descendant of David (",{"href":"?bref=1Chr.3.24","r":"1Chr.3.24","rawR":"1Chr.3.24","sourceRefs":[{"raw":"1Chr.3.24","value":"1Chr.3.24"}],"t":"ref","v":"1 Chr 3:24"},")."],"sourceClass":"list","t":"p"},{"c":["2. Chieftain of Manasseh’s half-tribe east of the Jordan (",{"href":"?bref=1Chr.5.24","r":"1Chr.5.24","rawR":"1Chr.5.24","sourceRefs":[{"raw":"1Chr.5.24","value":"1Chr.5.24"}],"t":"ref","v":"1 Chr 5:24"},")."],"sourceClass":"list","t":"p"},{"c":["3. Hassenuah’s son and the father of Meshullam from Benjamin’s tribe (",{"href":"?bref=1Chr.9.7","r":"1Chr.9.7","rawR":"1Chr.9.7","sourceRefs":[{"raw":"1Chr.9.7","value":"1Chr.9.7"}],"t":"ref","v":"1 Chr 9:7"},")."],"sourceClass":"list","t":"p"},{"c":["4. Progenitor of a family of Levites who returned with the exiles from Babylon (",{"href":"?bref=Ezra.2.40","r":"Ezra.2.40","rawR":"Ezra.2.40","sourceRefs":[{"raw":"Ezra.2.40","value":"Ezra.2.40"}],"t":"ref","v":"Ezr 2:40"},"); alternately called Judah in ",{"href":"?bref=Ezra.3.9","r":"Ezra.3.9","rawR":"Ezra.3.9","sourceRefs":[{"raw":"Ezra.3.9","value":"Ezra.3.9"}],"t":"ref","v":"Ezra 3:9"}," and Hodevah in ",{"href":"?bref=Neh.7.43","r":"Neh.7.43","rawR":"Neh.7.43","sourceRefs":[{"raw":"Neh.7.43","value":"Neh.7.43"}],"t":"ref","v":"Nehemiah 7:43"},"."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Hodaviah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 3:24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.3.24","rawQueryValue":"1Chr.3.24","sourceRefExact":"1Chr.3.24"},{"anchorText":"1 Chr 5:24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.5.24","rawQueryValue":"1Chr.5.24","sourceRefExact":"1Chr.5.24"},{"anchorText":"1 Chr 9:7","canonicalization":"deferred_to_dictionary_ma