{"content":[{"c":["MAMRE (P",{"c":["lace"],"sourceClass":"lc","t":"span"},")"],"sourceClass":"h1","t":"p"},{"c":["Important oak grove near which Abraham lived, and named for an Amorite who helped him defeat Chedorlaomer and rescue Lot (",{"href":"?bref=Gen.14.13,24","r":"Gen.14.13,24","rawR":"Gen.14.13,24","sourceRefs":[{"raw":"Gen.14.13,24","value":"Gen.14.13,24"}],"t":"ref","v":"Gn 14:13, 24"},"). Abraham erected an altar under the oak of Mamre (",{"href":"?bref=Gen.13.18","r":"Gen.13.18","rawR":"Gen.13.18","sourceRefs":[{"raw":"Gen.13.18","value":"Gen.13.18"}],"t":"ref","v":"13:18"},"). Abraham was sitting by the sacred tree when he welcomed three mysterious guests (ch ",{"href":"?bref=Gen.18.1-33","r":"Gen.18.1-33","rawR":"Gen.18.1-33","sourceRefs":[{"raw":"Gen.18.1-33","value":"Gen.18.1-33"}],"t":"ref","v":"18"},"). Mamre is also a possible site for the scene of Abrahamic covenant ceremonies (ch ",{"href":"?bref=Gen.15.1-21","r":"Gen.15.1-21","rawR":"Gen.15.1-21","sourceRefs":[{"raw":"Gen.15.1-21","value":"Gen.15.1-21"}],"t":"ref","v":"15"},"). Isaac and Jacob also lived there (",{"href":"?bref=Gen.35.27","r":"Gen.35.27","rawR":"Gen.35.27","sourceRefs":[{"raw":"Gen.35.27","value":"Gen.35.27"}],"t":"ref","v":"35:27"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"MamrePlace","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 14:13, 24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.14.13,24","rawQueryValue":"Gen.14.13,24","sourceRefExact":"Gen.14.13,24"},{"anchorText":"13:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.13.18","rawQueryValue":"Gen.13.18","sourceRefExact":"Gen.13.18"},{"anchorText":"18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.18.1-33","rawQueryValue":"Gen.18.1-33","sourceRefExact":"Gen.18.1-33"},{"anchorText":"15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.15.1-21","rawQueryValue":"Gen.15.1-21","sourceRefExact":"Gen.15.1-21"},{"anchorText":"35:27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.35.27","rawQueryValue":"Gen.35.27","sourceRefExact":"Gen.35.27"}],"sourceItemFragmentSha256":"e932e93891ec5f14897df05423437a0762f40b84d78852a1a3106d8e4bb01cdd","sourceItemName":"MamrePlace","sourceItemOrder":105,"sourceMember":"Articles/M.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"MamrePlace","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Mamre (Place)","title":"Mamre (Place)","version":"v2-a101d843a2f0cd3fc0c6"}