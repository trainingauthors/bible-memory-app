{"content":[{"c":["ELDAD"],"sourceClass":"h1","t":"p"},{"c":["One of the 70 elders of Israel who were commissioned to assist Moses in governing the people (",{"href":"?bref=Num.11.26-27","r":"Num.11.26-27","rawR":"Num.11.26-27","sourceRefs":[{"raw":"Num.11.26-27","value":"Num.11.26-27"}],"t":"ref","v":"Nm 11:26-27"},"). Though Eldad and another elder, Medad, were not among the 68 elders who had gathered around the tabernacle at Moses’ command, they too received the Spirit and prophesied. When Joshua, out of concern for Moses’ authority, asked Moses to stop them, Moses showed great humility and sensitivity to God’s will by answering, “I wish that all the ",{"c":["Lord"],"sourceClass":"divine-name","t":"span"},"’s people were prophets” (",{"href":"?bref=Num.11.29","r":"Num.11.29","rawR":"Num.11.29","sourceRefs":[{"raw":"Num.11.29","value":"Num.11.29"}],"t":"ref","v":"Nm 11:29"},", ",{"c":["niv"],"sourceClass":"sc","t":"span"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Eldad","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Nm 11:26-27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.11.26-27","rawQueryValue":"Num.11.26-27","sourceRefExact":"Num.11.26-27"},{"anchorText":"Nm 11:29","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.11.29","rawQueryValue":"Num.11.29","sourceRefExact":"Num.11.29"}],"sourceItemFragmentSha256":"1907571d25145928b6293415f278905b5d453bf948103f6e9c027efcef9369c3","sourceItemName":"Eldad","sourceItemOrder":64,"sourceMember":"Articles/E.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Eldad","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Eldad","title":"Eldad","version":"v2-a101d843a2f0cd3fc0c6"}