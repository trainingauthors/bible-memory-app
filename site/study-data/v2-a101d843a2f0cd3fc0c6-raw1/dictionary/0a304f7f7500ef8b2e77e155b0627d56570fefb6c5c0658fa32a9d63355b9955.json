am.24.7","rawQueryValue":"2Sam.24.7","sourceRefExact":"2Sam.24.7"},{"anchorText":"Gn 46:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.46.10","rawQueryValue":"Gen.46.10","sourceRefExact":"Gen.46.10"},{"anchorText":"Ex 6:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.6.15","rawQueryValue":"Exod.6.15","sourceRefExact":"Exod.6.15"},{"anchorText":"1 Chr 4:25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.4.25","rawQueryValue":"1Chr.4.25","sourceRefExact":"1Chr.4.25"},{"anchorText":"Gn 25:13-14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.25.13-14","rawQueryValue":"Gen.25.13-14","sourceRefExact":"Gen.25.13-14"},{"anchorText":"1 Chr 1:29-30","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.1.29-30","rawQueryValue":"1Chr.1.29-30","sourceRefExact":"1Chr.1.29-30"},{"anchorText":"Gn 46:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.46.10","rawQueryValue":"Gen.46.10","sourceRefExact":"Gen.46.10"},{"anchorText":"Ex 6:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.6.15","rawQueryValue":"Exod.6.15","sourceRefExact":"Exod.6.15"},{"anchorText":"1 Chr 2:27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.2.27","rawQueryValue":"1Chr.2.27","sourceRefExact":"1Chr.2.27"},{"anchorText":"Rv 7:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.7.7","rawQueryValue":"Rev.7.7","sourceRefExact":"Rev.7.7"}],"sourceItemFragmentSha256":"601327ec885c847f1309a0515de7b3b901b2b0eb2210d3c7eb15a3db9b65b787","sourceItemName":"SimeonTribeof","sourceItemOrder":425,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"SimeonTribeof","product":"TyndaleOpenBibleDictionary","typename":"Article"