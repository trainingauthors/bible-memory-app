","sourceRefExact":"1Kgs.22.5-23"},{"anchorText":"Ex 28:30","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.28.30","rawQueryValue":"Exod.28.30","sourceRefExact":"Exod.28.30"},{"anchorText":"Lv 8:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Lev.8.8","rawQueryValue":"Lev.8.8","sourceRefExact":"Lev.8.8"},{"anchorText":"1 Sm 30:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.30.7","rawQueryValue":"1Sam.30.7","sourceRefExact":"1Sam.30.7"},{"anchorText":"2 Sm 5:19-23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.5.19-23","rawQueryValue":"2Sam.5.19-23","sourceRefExact":"2Sam.5.19-23"},{"anchorText":"Jos 6:17-18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.6.17-18","rawQueryValue":"Josh.6.17-18","sourceRefExact":"Josh.6.17-18"},{"anchorText":"Dt 7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.7.1-26","rawQueryValue":"Deut.7.1-26","sourceRefExact":"Deut.7.1-26"},{"anchorText":"Jos 6:17-21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.6.17-21","rawQueryValue":"Josh.6.17-21","sourceRefExact":"Josh.6.17-21"},{"anchorText":"1 Sm 15:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.15.3","rawQueryValue":"1Sam.15.3","sourceRefExact":"1Sam.15.3"},{"anchorText":"Is 2:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.2.4","rawQueryValue":"Isa.2.4","sourceRefExact":"Isa.2.4"},{"anchorText":"Mi 4:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mic.4.3","rawQueryValue":"Mic.4.3","sourceRefExact":"Mic.4.3"},{"anchorText":"Is 9:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.9.6","rawQueryValue":"Isa.9.6","sourceRefExact":"Isa.9.6"},{"anchorText":"Ps 110","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ps.110.1-7","rawQueryValue":"Ps.110.1-7","sourceRefExact":"Ps.110.1-7"},{"anchorText":"Dn 7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Dan.7.1-28","rawQueryValue":"Dan.7.1-28","sourceRefExact":"Dan.7.1-28"},{"anchorText":"Zec 14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Zech.14.1-21","rawQueryValue":"Zech.14.1-21","sourceRefExact":"Zech.14.1-21"}],"sourceItemFragmentSha256":"71685ebeb685826f359f2d3be219efb84d52aef278b73edf339ce53076240244","sourceItemName":"WarHoly","sourceItemOrder":6,"sourceMember":"Articles/W.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"WarHoly","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"War*, Holy","title":"War*, Holy","version":"v2-a101d843a2f0cd3fc0c6"}