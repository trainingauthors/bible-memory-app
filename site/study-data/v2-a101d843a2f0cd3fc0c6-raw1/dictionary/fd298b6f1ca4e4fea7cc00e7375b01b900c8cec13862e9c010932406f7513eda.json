l","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Banquet","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Banquet","title":"Banquet","version":"v2-a101d843a2f0cd3fc0c6"}