{"content":[{"c":["SOPATER"],"sourceClass":"h1","t":"p"},{"c":["Man from the church at Berea who, with others, accompanied Paul to Jerusalem to deliver the offering collected by the gentile churches for the Jewish Christians who were suffering from the effects of a famine (",{"href":"?bref=Acts.20.4","r":"Acts.20.4","rawR":"Acts.20.4","sourceRefs":[{"raw":"Acts.20.4","value":"Acts.20.4"}],"t":"ref","v":"Acts 20:4"},"). Sopater is perhaps identical to Sosipater, the kinsman of Paul who sent greetings to the church at Rome (",{"href":"?bref=Rom.16.21","r":"Rom.16.21","rawR":"Rom.16.21","sourceRefs":[{"raw":"Rom.16.21","value":"Rom.16.21"}],"t":"ref","v":"Rom 16:21"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Sopater","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Acts 20:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.20.4","rawQueryValue":"Acts.20.4","sourceRefExact":"Acts.20.4"},{"anchorText":"Rom 16:21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rom.16.21","rawQueryValue":"Rom.16.21","sourceRefExact":"Rom.16.21"}],"sourceItemFragmentSha256":"88122d483db49657bc08462070c0468f428e744fb499757198c389fd239c084c","sourceItemName":"Sopater","sourceItemOrder":504,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Sopater","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Sopater","title":"Sopater","version":"v2-a101d843a2f0cd3fc0c6"}