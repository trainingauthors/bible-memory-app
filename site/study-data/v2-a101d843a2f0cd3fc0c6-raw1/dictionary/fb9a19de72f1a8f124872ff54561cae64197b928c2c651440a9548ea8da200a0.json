{"content":[{"c":["HAZOR-HADATTAH"],"sourceClass":"h1","t":"p"},{"c":["One of the cities located in the southern extremity of Judah, near the border of Edom (",{"href":"?bref=Josh.15.25","r":"Josh.15.25","rawR":"Josh.15.25","sourceRefs":[{"raw":"Josh.15.25","value":"Josh.15.25"}],"t":"ref","v":"Jos 15:25"},"). The ",{"c":["kjv"],"sourceClass":"sc","t":"span"}," translates the term as two different cities, “Hazor and Hadattah.” The Aramaic adjective “Hadattah” indicates this as a settlement from Hazor, but this is unsure."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"HazorHadattah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 15:25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.25","rawQueryValue":"Josh.15.25","sourceRefExact":"Josh.15.25"}],"sourceItemFragmentSha256":"b0227ee3fc21896613d092262f935bdd7625d8766eaf0003ce3e3938eddb6f21","sourceItemName":"HazorHadattah","sourceItemOrder":189,"sourceMember":"Articles/H.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"HazorHadattah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Hazor-Hadattah","title":"Hazor-Hadattah","version":"v2-a101d843a2f0cd3fc0c6"}