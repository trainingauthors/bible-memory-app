{"content":[{"c":["ACHSA*, ACHSAH*"],"sourceClass":"h1","t":"p"},{"c":["Caleb’s daughter (",{"href":"?bref=1Chr.2.49","r":"1Chr.2.49","rawR":"1Chr.2.49","sourceRefs":[{"raw":"1Chr.2.49","value":"1Chr.2.49"}],"t":"ref","v":"1 Chr 2:49"},"). Othniel, Caleb’s nephew, accepted his uncle’s challenge to capture Kiriath-sepher in order to marry Achsah. She persuaded Othniel to ask her father, Caleb, for a field, and she herself asked Caleb for two springs of water, a necessity for life in the desert (",{"href":"?bref=Josh.15.16-19","r":"Josh.15.16-19","rawR":"Josh.15.16-19","sourceRefs":[{"raw":"Josh.15.16-19","value":"Josh.15.16-19"}],"t":"ref","v":"Jos 15:16-19"},"; ",{"href":"?bref=Judg.1.12-15","r":"Judg.1.12-15","rawR":"Judg.1.12-15","sourceRefs":[{"raw":"Judg.1.12-15","value":"Judg.1.12-15"}],"t":"ref","v":"Jgs 1:12-15"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"AchsaAchsah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 2:49","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.2.49","rawQueryValue":"1Chr.2.49","sourceRefExact":"1Chr.2.49"},{"anchorText":"Jos 15:16-19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.16-19","rawQueryValue":"Josh.15.16-19","sourceRefExact":"Josh.15.16-19"},{"anchorText":"Jgs 1:12-15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.1.12-15","rawQueryValue":"Judg.1.12-15","sourceRefExact":"Judg.1.12-15"}],"sourceItemFragmentSha256":"1f40ad247b0ea27da7a113cafd1d3d65643d4f9c84a9ac3eb844c09a70282414","sourceItemName":"AchsaAchsah","sourceItemOrder":84,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"AchsaAchsah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Achsa*, Achsah*","title":"Achsa*, 