{"content":[{"c":["EPHRON (P",{"c":["erson"],"sourceClass":"lc","t":"span"},")"],"sourceClass":"h1","t":"p"},{"c":["Hittite from whom Abraham purchased the cave of Machpelah with its adjoining field for 400 shekels of silver (",{"href":"?bref=Gen.23.8-17","r":"Gen.23.8-17","rawR":"Gen.23.8-17","sourceRefs":[{"raw":"Gen.23.8-17","value":"Gen.23.8-17"}],"t":"ref","v":"Gn 23:8-17"},"). Sarah was buried there, as was Abraham (",{"href":"?bref=Gen.25.9","r":"Gen.25.9","rawR":"Gen.25.9","sourceRefs":[{"raw":"Gen.25.9","value":"Gen.25.9"}],"t":"ref","v":"25:9"},") and Jacob (",{"href":"?bref=Gen.50.13","r":"Gen.50.13","rawR":"Gen.50.13","sourceRefs":[{"raw":"Gen.50.13","value":"Gen.50.13"}],"t":"ref","v":"50:13"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"EphronPerson","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 23:8-17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.23.8-17","rawQueryValue":"Gen.23.8-17","sourceRefExact":"Gen.23.8-17"},{"anchorText":"25:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.25.9","rawQueryValue":"Gen.25.9","sourceRefExact":"Gen.25.9"},{"anchorText":"50:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.50.13","rawQueryValue":"Gen.50.13","sourceRefExact":"Gen.50.13"}],"sourceItemFragmentSha256":"a2303644167895b2e499f86318fba2648d4bda47596fc7e227157f77b92d6950","sourceItemName":"EphronPerson","sourceItemOrder":213,"sourceMember":"Articles/E.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"EphronPerson","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Ephron (Person)","title":"Ephron (Person)","version":"v2-a101d843a2f0cd3fc0c6"}