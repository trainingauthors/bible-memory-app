{"content":[{"c":["MEARAH"],"sourceClass":"h1","t":"p"},{"c":["Region of Palestine that the Israelites had not possessed (",{"href":"?bref=Josh.13.4","r":"Josh.13.4","rawR":"Josh.13.4","sourceRefs":[{"raw":"Josh.13.4","value":"Josh.13.4"}],"t":"ref","v":"Jos 13:4"},", ",{"c":["niv"],"sourceClass":"sc","t":"span"}," “Arah”). Its location is uncertain. Suggestions include the district of caves (Mearah means “cave”) near Sidon called Mughar Jezzin, and the towns Khirbet ‘Arah and Mogheiriyeh."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Mearah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 13:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.13.4","rawQueryValue":"Josh.13.4","sourceRefExact":"Josh.13.4"}],"sourceItemFragmentSha256":"c70eb86c3a098d266142527c77ee65cb3fff36ec3d30cbae1fe3b1a3a69c24da","sourceItemName":"Mearah","sourceItemOrder":192,"sourceMember":"Articles/M.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Mearah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Mearah","title":"Mearah","version":"v2-a101d843a2f0cd3fc0c6"}