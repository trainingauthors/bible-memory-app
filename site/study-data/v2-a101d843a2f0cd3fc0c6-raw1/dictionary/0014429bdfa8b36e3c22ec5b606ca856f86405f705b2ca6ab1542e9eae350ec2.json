{"content":[{"c":["GEDOR (P",{"c":["lace"],"sourceClass":"lc","t":"span"},")"],"sourceClass":"h1","t":"p"},{"c":["1. City in the Shephelah (hill country) allotted to Judah’s tribe (",{"href":"?bref=Josh.15.58","r":"Josh.15.58","rawR":"Josh.15.58","sourceRefs":[{"raw":"Josh.15.58","value":"Josh.15.58"}],"t":"ref","v":"Jos 15:58"},") named with Halhul, Beth-zur, Maarath, Beth-anoth, and Eltekon. It has been identified with Khirbet Gedur north of Hebron near Bethlehem."],"sourceClass":"list","t":"p"},{"c":["2. Place founded by Penuel, one of the families of Judah (",{"href":"?bref=1Chr.4.4","r":"1Chr.4.4","rawR":"1Chr.4.4","sourceRefs":[{"raw":"1Chr.4.4","value":"1Chr.4.4"}],"t":"ref","v":"1 Chr 4:4"},")."],"sourceClass":"list","t":"p"},{"c":["3. Settlement established by Jered of Judah (",{"href":"?bref=1Chr.4.18","r":"1Chr.4.18","rawR":"1Chr.4.18","sourceRefs":[{"raw":"1Chr.4.18","value":"1Chr.4.18"}],"t":"ref","v":"1 Chr 4:18"},")."],"sourceClass":"list","t":"p"},{"c":["4. City and its valley settled by the Simeonites (",{"href":"?bref=1Chr.4.39","r":"1Chr.4.39","rawR":"1Chr.4.39","sourceRefs":[{"raw":"1Chr.4.39","value":"1Chr.4.39"}],"t":"ref","v":"1 Chr 4:39"},")."],"sourceClass":"list","t":"p"},{"c":["5. Town in the territory of Benjamin and the home of Joelah and Zebadiah, the sons of Jeroham (",{"href":"?bref=1Chr.12.7","r":"1Chr.12.7","rawR":"1Chr.12.7","sourceRefs":[{"raw":"1Chr.12.7","value":"1Chr.12.7"}],"t":"ref","v":"1 Chr 12:7"},"); perhaps the same as #1 above."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"GedorPlace","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 15:58","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.58","rawQueryValue":"Josh.15.58","sourceRefExact":"Josh.15.58"},{"anchorText":"1 Chr 4:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.4.4","rawQueryValue":"1Chr.4.4","sourceRefExact":"1Chr.4.4"},{"anchorText":"1 Chr 4:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.4.18","rawQueryValue":"1Chr.4.18","sourceRefExact":"1Chr.4.18"},{"anchorText":"1 Chr 4:39","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.4.39","rawQueryValue":"1Chr.4.39","sourceRefExact":"1Chr.4.39"},{"anchorText":"1 Chr 12:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.12.7","rawQueryValue":"1Chr.12.7","sourceRefExact":"1Chr.12.7"}],"sourceItemFragmentSha256":"d8e60f5b32236f3db37681026ce7b6b8954ee249c0f1cd012f7531937d152f89","sourceItemName":"GedorPlace","sourceItemOrder":78,"sourceMember":"Articles/G.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"GedorPlace","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Gedor (Place)","title":"Gedor (Place)","version":"v2-a101d843a2f0cd3fc0c6"}