{"content":[{"c":["NEBALLAT"],"sourceClass":"h1","t":"p"},{"c":["Town situated in the hills overlooking the southeastern region of the plain of Sharon, settled by Benjamites after the exile (",{"href":"?bref=Neh.11.34","r":"Neh.11.34","rawR":"Neh.11.34","sourceRefs":[{"raw":"Neh.11.34","value":"Neh.11.34"}],"t":"ref","v":"Neh 11:34"},"). It is identified with modern Beit Nebala, four miles (6.4 kilometers) east of Lod and two miles (3.2 kilometers) north of Hadid."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Neballat","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Neh 11:34","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.11.34","rawQueryValue":"Neh.11.34","sourceRefExact":"Neh.11.34"}],"sourceItemFragmentSha256":"a2119ae8c29ac260ddfed3be9941d86b6b42d93fbec80b2fc6d52027bba80149","sourceItemName":"Neballat","sourceItemOrder":69,"sourceMember":"Articles/N.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Neballat","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Neballat","title":"Neballat","version":"v2-a101d843a2f0cd3fc0c6"}