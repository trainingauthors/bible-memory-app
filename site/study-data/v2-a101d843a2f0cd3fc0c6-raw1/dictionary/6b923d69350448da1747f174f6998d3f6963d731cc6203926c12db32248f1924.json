{"content":[{"c":["HIRAH"],"sourceClass":"h1","t":"p"},{"c":["Adullamite and friend of Judah to whose house Judah went after he and his brothers sold Joseph (",{"href":"?bref=Gen.38.1","r":"Gen.38.1","rawR":"Gen.38.1","sourceRefs":[{"raw":"Gen.38.1","value":"Gen.38.1"}],"t":"ref","v":"Gn 38:1"},"). He accompanied Judah to the sheepshearing after Judah’s wife died (v ",{"href":"?bref=Gen.38.12","r":"Gen.38.12","rawR":"Gen.38.12","sourceRefs":[{"raw":"Gen.38.12","value":"Gen.38.12"}],"t":"ref","v":"12"},"), and he served as the messenger to carry a kid from Judah to Tamar (v ",{"href":"?bref=Gen.38.20","r":"Gen.38.20","rawR":"Gen.38.20","sourceRefs":[{"raw":"Gen.38.20","value":"Gen.38.20"}],"t":"ref","v":"20"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Hirah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 38:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.38.1","rawQueryValue":"Gen.38.1","sourceRefExact":"Gen.38.1"},{"anchorText":"12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.38.12","rawQueryValue":"Gen.38.12","sourceRefExact":"Gen.38.12"},{"anchorText":"20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.38.20","rawQueryValue":"Gen.38.20","sourceRefExact":"Gen.38.20"}],"sourceItemFragmentSha256":"50906a828bd24749b4d150740680c283cee64daf73f4c6d2d4465efd28805a9b","sourceItemName":"Hirah","sourceItemOrder":305,"sourceMember":"Articles/H.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Hirah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Hirah","title":"Hirah","version":"v2-a101d843a2f0cd3fc0c6"}