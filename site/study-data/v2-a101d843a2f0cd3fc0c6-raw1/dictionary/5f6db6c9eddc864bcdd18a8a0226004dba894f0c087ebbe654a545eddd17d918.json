{"content":[{"c":["SOOTHSAYER*"],"sourceClass":"h1","t":"p"},{"c":["One who foretells events; a pagan practice, soothsaying was forbidden in Israel (",{"href":"?bref=Deut.18.10,14","r":"Deut.18.10,14","rawR":"Deut.18.10,14","sourceRefs":[{"raw":"Deut.18.10,14","value":"Deut.18.10,14"}],"t":"ref","v":"Dt 18:10, 14"},"). In Scripture, soothsaying was practiced by Balaam, Beor’s son (",{"href":"?bref=Josh.13.22","r":"Josh.13.22","rawR":"Josh.13.22","sourceRefs":[{"raw":"Josh.13.22","value":"Josh.13.22"}],"t":"ref","v":"Jos 13:22"},") and King Manasseh of Judah (",{"href":"?bref=2Kgs.21.6","r":"2Kgs.21.6","rawR":"2Kgs.21.6","sourceRefs":[{"raw":"2Kgs.21.6","value":"2Kgs.21.6"}],"t":"ref","v":"2 Kgs 21:6"},"; ",{"href":"?bref=2Chr.33.6","r":"2Chr.33.6","rawR":"2Chr.33.6","sourceRefs":[{"raw":"2Chr.33.6","value":"2Chr.33.6"}],"t":"ref","v":"2 Chr 33:6"},"); Jacob’s descendants were likened to the soothsayers of Philistia (",{"href":"?bref=Isa.2.6","r":"Isa.2.6","rawR":"Isa.2.6","sourceRefs":[{"raw":"Isa.2.6","value":"Isa.2.6"}],"t":"ref","v":"Is 2:6"},"); they were listed among the false prophets of Judah (",{"href":"?bref=Jer.27.9","r":"Jer.27.9","rawR":"Jer.27.9","sourceRefs":[{"raw":"Jer.27.9","value":"Jer.27.9"}],"t":"ref","v":"Jer 27:9"},"). During NT times, soothsaying was the source of a lucrative trade in Philippi (",{"href":"?bref=Acts.16.16","r":"Acts.16.16","rawR":"Acts.16.16","sourceRefs":[{"raw":"Acts.16.16","value":"Acts.16.16"}],"t":"ref","v":"Acts 16:16"},")."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Magic_Article_TyndaleOpenBibleDictionary","id":"Magic_Article_TyndaleOpenBibleDictionary","rawId":"Magic_Article_TyndaleOpenBibleDictionary","t":"link","v":"Magic"},"; ",{"href":"?item=Sorcery_Article_TyndaleOpenBibleDictionary","id":"Sorcery_Article_TyndaleOpenBibleDictionary","rawId":"Sorcery_Article_TyndaleOpenBibleDictionary","t":"link","v":"Sorcery"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Soothsayer","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Dt 18:10, 14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.18.10,14","rawQueryValue":"Deut.18.10,14","sourceRefExact":"Deut.18.10,14"},{"anchorText":"Jos 13:22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.13.22","rawQueryValue":"Josh.13.22","sourceRefExact":"Josh.13.22"},{"anchorText":"2 Kgs 21:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.21.6","rawQueryValue":"2Kgs.21.6","sourceRefExact":"2Kgs.21.6"},{"anchorText":"2 Chr 33:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.33.6","rawQueryValue":"2Chr.33.6","sourceRefExact":"2Chr.33.6"},{"anchorText":"Is 2:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.2.6","rawQueryValue":"Isa.2.6","sourceRefExact":"Isa.2.6"},{"anchorText":"Jer 27:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.27.9","rawQueryValue":"Jer.27.9","sourceRefExact":"Jer.27.9"},{"anchorText":"Acts 16:16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.16.16","rawQueryValue":"Acts.16.16","sourceRefExact":"Acts.16.16"}],"sourceItemFragmentSha256":"2379e075bd03543aa71b499a018827058951d384c9802b0b8a38a5ab34f96c31","sourceItemName":"Soothsayer","sourceItemOrder":502,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Soothsayer","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Soothsayer*","title":"Soothsayer*","version":"v2-a101d843a2f0cd3fc0c6"}