{"content":[{"c":["MAARATH"],"sourceClass":"h1","t":"p"},{"c":["One of Judah’s cities of inheritance located in the hill country (",{"href":"?bref=Josh.15.59","r":"Josh.15.59","rawR":"Josh.15.59","sourceRefs":[{"raw":"Josh.15.59","value":"Josh.15.59"}],"t":"ref","v":"Jos 15:59"},"), perhaps modern Biet Ummar, seven miles (11.3 kilometers) north of Hebron. It may be the same as Maroth, mentioned in ",{"href":"?bref=Mic.1.12","r":"Mic.1.12","rawR":"Mic.1.12","sourceRefs":[{"raw":"Mic.1.12","value":"Mic.1.12"}],"t":"ref","v":"Micah 1:12"},"."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Maarath","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 15:59","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.59","rawQueryValue":"Josh.15.59","sourceRefExact":"Josh.15.59"},{"anchorText":"Micah 1:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mic.1.12","rawQueryValue":"Mic.1.12","sourceRefExact":"Mic.1.12"}],"sourceItemFragmentSha256":"2e04b9dda76435182f5f346070015b436dca64fadaf4fe02c3172e2a36fd8904","sourceItemName":"Maarath","sourceItemOrder":9,"sourceMember":"Articles/M.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Maarath","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Maarath","title":"Maarath","version":"v2-a101d843a2f0cd3fc0c6"}