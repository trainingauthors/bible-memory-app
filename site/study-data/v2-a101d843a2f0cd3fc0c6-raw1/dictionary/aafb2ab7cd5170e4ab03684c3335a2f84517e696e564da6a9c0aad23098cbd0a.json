{"content":[{"c":["BAR-JONA*"],"sourceClass":"h1","t":"p"},{"c":["Aramaic form of Simon Peter’s surname, meaning “son of Jonah” (",{"href":"?bref=Matt.16.17","r":"Matt.16.17","rawR":"Matt.16.17","sourceRefs":[{"raw":"Matt.16.17","value":"Matt.16.17"}],"t":"ref","v":"Mt 16:17"},"). Another variant of the name appears in ",{"href":"?bref=John.1.42","r":"John.1.42","rawR":"John.1.42","sourceRefs":[{"raw":"John.1.42","value":"John.1.42"}],"t":"ref","v":"John 1:42"}," and ",{"href":"?bref=John.21.15-17","r":"John.21.15-17","rawR":"John.21.15-17","sourceRefs":[{"raw":"John.21.15-17","value":"John.21.15-17"}],"t":"ref","v":"21:15-17"},", where the best Greek texts have “son of John” rather than “son of Jona[s]” (",{"c":["kjv"],"sourceClass":"sc","t":"span"},"). ",{"c":["See"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=SimonPeter_Article_TyndaleOpenBibleDictionary","id":"SimonPeter_Article_TyndaleOpenBibleDictionary","rawId":"SimonPeter_Article_TyndaleOpenBibleDictionary","t":"link","v":"Simon Peter"},"."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"BarJona","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Mt 16:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.16.17","rawQueryValue":"Matt.16.17","sourceRefExact":"Matt.16.17"},{"anchorText":"John 1:42","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=John.1.42","rawQueryValue":"John.1.42","sourceRefExact":"John.1.42"},{"anchorText":"21:15-17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=John.21.15-17","rawQueryValue":"John.21.15-17","sourceRefExact":"John.21.15-17"}],"sourceItemFragmentSha256":"1170843bd2918d16e5c91e8827a603c3ee95f59899ad622b1e131d29cfd4f727","sourceItemName":"BarJona","sourceItemOrder":82,"sourceMember":"Articles/B.xml","supplementPointersNotIncludedAsConten