{"content":[{"c":["CNIDUS"],"sourceClass":"h1","t":"p"},{"c":["Port city situated off the southwest corner of Asia Minor, mentioned as a harbor passed by the apostle Paul en route to Italy (",{"href":"?bref=Acts.27.7","r":"Acts.27.7","rawR":"Acts.27.7","sourceRefs":[{"raw":"Acts.27.7","value":"Acts.27.7"}],"t":"ref","v":"Acts 27:7"},"). During the second century ",{"c":["BC"],"sourceClass":"era","t":"span"},", it had a Jewish colony (",{"href":"?bref=1Macc.15.23","r":"1Macc.15.23","rawR":"1Macc.15.23","sourceRefs":[{"raw":"1Macc.15.23","value":"1Macc.15.23"}],"t":"ref","v":"1 Macc 15:23"},"). The island on which Cnidus was built is now joined to the mainland by a sandbar."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Cnidus","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Acts 27:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.27.7","rawQueryValue":"Acts.27.7","sourceRefExact":"Acts.27.7"},{"anchorText":"1 Macc 15:23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Macc.15.23","rawQueryValue":"1Macc.15.23","sourceRefExact":"1Macc.15.23"}],"sourceItemFragmentSha256":"a68389c186d9ed7159e4148b52f0efd41c11e712f970a6af94741c28db45e865","sourceItemName":"Cnidus","sourceItemOrder":228,"sourceMember":"Articles/C.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Cnidus","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Cnidus","title":"Cnidus","version":"v2-a101d843a2f0cd3fc0c6"}