{"content":[{"c":["NEHELAMITE"],"sourceClass":"h1","t":"p"},{"c":["Ancestral name or the geographical designation for Shemaiah the false prophet (",{"href":"?bref=Jer.29.24,31-32","r":"Jer.29.24,31-32","rawR":"Jer.29.24,31-32","sourceRefs":[{"raw":"Jer.29.24,31-32","value":"Jer.29.24,31-32"}],"t":"ref","v":"Jer 29:24, 31-32"},"). Its derivation is unknown. Etymologically similar to the Hebrew word for “dream,” Nehelamite is perhaps an epithet coined by Jeremiah to deride Shemaiah, the false prophet, as a dreamer."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Nehelamite","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jer 29:24, 31-32","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.29.24,31-32","rawQueryValue":"Jer.29.24,31-32","sourceRefExact":"Jer.29.24,31-32"}],"sourceItemFragmentSha256":"5b8c624829e641c4d7f35ea94df229efdc2d2147cf10e5237d1a8f8b0787d0c8","sourceItemName":"Nehelamite","sourceItemOrder":85,"sourceMember":"Articles/N.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Nehelamite","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Nehelamite","title":"Nehelamite","version":"v2-a101d843a2f0cd3fc0c6"}