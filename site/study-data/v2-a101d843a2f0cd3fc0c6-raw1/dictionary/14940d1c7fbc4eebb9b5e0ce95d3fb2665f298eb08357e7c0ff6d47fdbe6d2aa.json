.18"},{"anchorText":"Neh 2:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.2.8","rawQueryValue":"Neh.2.8","sourceRefExact":"Neh.2.8"}],"sourceItemFragmentSha256":"caa7161f589bd515f12f9fbe00c4a062cc1bfb7f76a56921d076b27fde25bebb","sourceItemName":"Asaph","sourceItemOrder":520,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Asaph","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Asaph","title":"Asaph","version":"v2-a101d843a2f0cd3fc0c6"}