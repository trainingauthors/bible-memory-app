{"content":[{"c":["GEDER"],"sourceClass":"h1","t":"p"},{"c":["One of the 31 royal cities in Canaan, whose kings were defeated by Joshua (",{"href":"?bref=Josh.12.13","r":"Josh.12.13","rawR":"Josh.12.13","sourceRefs":[{"raw":"Josh.12.13","value":"Josh.12.13"}],"t":"ref","v":"Jos 12:13"},"). Geder is perhaps identifiable with Gedor in the mountains of Judah (",{"href":"?bref=Josh.15.58","r":"Josh.15.58","rawR":"Josh.15.58","sourceRefs":[{"raw":"Josh.15.58","value":"Josh.15.58"}],"t":"ref","v":"15:58"},") or with Beth-gader (",{"href":"?bref=1Chr.2.51","r":"1Chr.2.51","rawR":"1Chr.2.51","sourceRefs":[{"raw":"1Chr.2.51","value":"1Chr.2.51"}],"t":"ref","v":"1 Chr 2:51"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Geder","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 12:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.12.13","rawQueryValue":"Josh.12.13","sourceRefExact":"Josh.12.13"},{"anchorText":"15:58","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.58","rawQueryValue":"Josh.15.58","sourceRefExact":"Josh.15.58"},{"anchorText":"1 Chr 2:51","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.2.51","rawQueryValue":"1Chr.2.51","sourceRefExact":"1Chr.2.51"}],"sourceItemFragmentSha256":"0f2c180575d6fd8c2ec48b5551de0088d090c19ae949bb0b7166c809287b9a8b","sourceItemName":"Geder","sourceItemOrder":73,"sourceMember":"Articles/G.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Geder","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Geder","title":"Geder","version":"v2-a101d843a2f0cd3fc0c6"}