{"content":[{"c":["HARBONA"],"sourceClass":"h1","t":"p"},{"c":["One of King Ahasuerus’s seven personal attendants. They were ordered by Ahasuerus to parade Queen Vashti before a drunken banquet to satisfy his vanity (",{"href":"?bref=Esth.1.10","r":"Esth.1.10","rawR":"Esth.1.10","sourceRefs":[{"raw":"Esth.1.10","value":"Esth.1.10"}],"t":"ref","v":"Est 1:10"},"). Harbona later suggested that Haman be hanged on the gallows he had built for Mordecai (",{"href":"?bref=Esth.7.9","r":"Esth.7.9","rawR":"Esth.7.9","sourceRefs":[{"raw":"Esth.7.9","value":"Esth.7.9"}],"t":"ref","v":"7:9"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Harbona","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Est 1:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Esth.1.10","rawQueryValue":"Esth.1.10","sourceRefExact":"Esth.1.10"},{"anchorText":"7:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Esth.7.9","rawQueryValue":"Esth.7.9","sourceRefExact":"Esth.7.9"}],"sourceItemFragmentSha256":"afd9aa1c2264ba86c603bcbfb56001d3baad5112efc14e1245559d7d558ff3fd","sourceItemName":"Harbona","sourceItemOrder":108,"sourceMember":"Articles/H.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Harbona","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Harbona","title":"Harbona","version":"v2-a101d843a2f0cd3fc0c6"}