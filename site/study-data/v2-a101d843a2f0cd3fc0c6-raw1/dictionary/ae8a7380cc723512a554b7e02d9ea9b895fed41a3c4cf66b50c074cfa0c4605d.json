{"content":[{"c":["NAHOR (P",{"c":["lace"],"sourceClass":"lc","t":"span"},")"],"sourceClass":"h1","t":"p"},{"c":["Northwestern Mesopotamian city; home of Rebekah, Isaac’s wife, and Nahor, Abraham’s brother (",{"href":"?bref=Gen.24.10","r":"Gen.24.10","rawR":"Gen.24.10","sourceRefs":[{"raw":"Gen.24.10","value":"Gen.24.10"}],"t":"ref","v":"Gn 24:10"},"). Nahor is frequently mentioned in the Mari documents (18th century ",{"c":["BC"],"sourceClass":"era","t":"span"},") as the town of Nakhur, located near Haran in the Balikh River Valley. This city was probably the home of some of the ancient Habiru people. Its site is unknown."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=NahorPerson_Article_TyndaleOpenBibleDictionary","id":"NahorPerson_Article_TyndaleOpenBibleDictionary","rawId":"NahorPerson_Article_TyndaleOpenBibleDictionary","t":"link","v":"Nahor (Person) #2"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"NahorPlace","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 24:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.24.10","rawQueryValue":"Gen.24.10","sourceRefExact":"Gen.24.10"}],"sourceItemFragmentSha256":"cab64b8fb2438932e4ea286a6e835c320169b9dffa43718804f94726f06523d8","sourceItemName":"NahorPlace","sourceItemOrder":34,"sourceMember":"Articles/N.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"NahorPlace","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Nahor (Place)","title":"Nahor (Place)","version":"v2-a101d843a2f0cd3fc0c6"}