{"content":[{"c":["ANNIAS"],"sourceClass":"h1","t":"p"},{"c":["Ancestor of a family of 101 sons that undertook the rigorous migration from Babylon with Zerubbabel, according to the Apocrypha (",{"href":"?bref=1Esd.5.16","r":"1Esd.5.16","rawR":"1Esd.5.16","sourceRefs":[{"raw":"1Esd.5.16","value":"1Esd.5.16"}],"t":"ref","v":"1 Esd 5:16"},"). Parallel canonical texts omit this family (",{"href":"?bref=Ezra.2.16-20","r":"Ezra.2.16-20","rawR":"Ezra.2.16-20","sourceRefs":[{"raw":"Ezra.2.16-20","value":"Ezra.2.16-20"}],"t":"ref","v":"Ezr 2:16-20"},"; ",{"href":"?bref=Neh.7.21-25","r":"Neh.7.21-25","rawR":"Neh.7.21-25","sourceRefs":[{"raw":"Neh.7.21-25","value":"Neh.7.21-25"}],"t":"ref","v":"Neh 7:21-25"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Annias","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Esd 5:16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Esd.5.16","rawQueryValue":"1Esd.5.16","sourceRefExact":"1Esd.5.16"},{"anchorText":"Ezr 2:16-20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.2.16-20","rawQueryValue":"Ezra.2.16-20","sourceRefExact":"Ezra.2.16-20"},{"anchorText":"Neh 7:21-25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.7.21-25","rawQueryValue":"Neh.7.21-25","sourceRefExact":"Neh.7.21-25"}],"sourceItemFragmentSha256":"494a559b7a7aaa3fa42d0cfa5671d36900602bd3eec4949303cccdd7bf700882","sourceItemName":"Annias","sourceItemOrder":360,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Annias","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Annias","title":"Annias","version":"v2-a101d843a2f0cd3fc0c6"}