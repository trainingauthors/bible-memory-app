{"content":[{"c":["EMIM*, EMITES"],"sourceClass":"h1","t":"p"},{"c":["Name given to the original inhabitants of Moab (",{"href":"?bref=Gen.14.5","r":"Gen.14.5","rawR":"Gen.14.5","sourceRefs":[{"raw":"Gen.14.5","value":"Gen.14.5"}],"t":"ref","v":"Gn 14:5"},") by the Moabites who ousted them from their land. They were a tall people, known also as Rephaim (",{"href":"?bref=Deut.2.10-11","r":"Deut.2.10-11","rawR":"Deut.2.10-11","sourceRefs":[{"raw":"Deut.2.10-11","value":"Deut.2.10-11"}],"t":"ref","v":"Dt 2:10-11"},"), and were compared with the Zuzites, Anakim, and Horites for their size. This phenomenon is evidently an indication of genetic isolation. ",{"c":["See"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Giants_Article_TyndaleOpenBibleDictionary","id":"Giants_Article_TyndaleOpenBibleDictionary","rawId":"Giants_Article_TyndaleOpenBibleDictionary","t":"link","v":"Giants"},"."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"EmimEmites","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 14:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.14.5","rawQueryValue":"Gen.14.5","sourceRefExact":"Gen.14.5"},{"anchorText":"Dt 2:10-11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.2.10-11","rawQueryValue":"Deut.2.10-11","sourceRefExact":"Deut.2.10-11"}],"sourceItemFragmentSha256":"61c4d498dcaa2bf6a18cf5d2fe15753528576bbc226a35030fb583bf59c265e4","sourceItemName":"EmimEmites","sourceItemOrder":160,"sourceMember":"Articles/E.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"EmimEmites","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Emim*, Emites","title":"Emim*, Emites","version":"v2-a101d843a2f0cd3fc0c6"}