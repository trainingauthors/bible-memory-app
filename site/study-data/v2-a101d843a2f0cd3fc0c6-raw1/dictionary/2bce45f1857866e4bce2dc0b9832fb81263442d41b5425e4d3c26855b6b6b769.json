l","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Confession","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Confession","title":"Confession","version":"v2-a101d843a2f0cd3fc0c6"}