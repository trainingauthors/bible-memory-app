{"content":[{"c":["JEHUDI"],"sourceClass":"h1","t":"p"},{"c":["Son of Nethaniah and a messenger of King Jehoiakim of Judah. He was sent by a number of princes to summon Baruch to read Jeremiah’s scroll privately to them. Later, Jehoiakim ordered Jehudi to read the same scroll publicly before him and all the court, after which the writing was burned (",{"href":"?bref=Jer.36.14-23","r":"Jer.36.14-23","rawR":"Jer.36.14-23","sourceRefs":[{"raw":"Jer.36.14-23","value":"Jer.36.14-23"}],"t":"ref","v":"Jer 36:14-23"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Jehudi","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jer 36:14-23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.36.14-23","rawQueryValue":"Jer.36.14-23","sourceRefExact":"Jer.36.14-23"}],"sourceItemFragmentSha256":"98061825d308078dc801817cc72d6a7582f0b71589c14757a932dad9f440ff49","sourceItemName":"Jehudi","sourceItemOrder":167,"sourceMember":"Articles/J.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Jehudi","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Jehudi","title":"Jehudi","version":"v2-a101d843a2f0cd3fc0c6"}