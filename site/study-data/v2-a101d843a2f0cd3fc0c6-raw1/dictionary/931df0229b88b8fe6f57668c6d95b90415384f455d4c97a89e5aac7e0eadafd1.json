{"content":[{"c":["ADIEL"],"sourceClass":"h1","t":"p"},{"c":["1. Prince of Simeon’s tribe who led some Simeonites to the entrance of Gedor to find pasture for their flocks (",{"href":"?bref=1Chr.4.36-39","r":"1Chr.4.36-39","rawR":"1Chr.4.36-39","sourceRefs":[{"raw":"1Chr.4.36-39","value":"1Chr.4.36-39"}],"t":"ref","v":"1 Chr 4:36-39"},")."],"sourceClass":"list","t":"p"},{"c":["2. Ancestor of Maasai, a priest of Israel who was among the first to return to Palestine following the Babylonian captivity (",{"href":"?bref=1Chr.9.12","r":"1Chr.9.12","rawR":"1Chr.9.12","sourceRefs":[{"raw":"1Chr.9.12","value":"1Chr.9.12"}],"t":"ref","v":"1 Chr 9:12"},")."],"sourceClass":"list","t":"p"},{"c":["3. Ancestor of Azmaveth. Azmaveth was in charge of King David’s treasuries (",{"href":"?bref=1Chr.27.25","r":"1Chr.27.25","rawR":"1Chr.27.25","sourceRefs":[{"raw":"1Chr.27.25","value":"1Chr.27.25"}],"t":"ref","v":"1 Chr 27:25"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Adiel","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 4:36-39","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.4.36-39","rawQueryValue":"1Chr.4.36-39","sourceRefExact":"1Chr.4.36-39"},{"anchorText":"1 Chr 9:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.9.12","rawQueryValue":"1Chr.9.12","sourceRefExact":"1Chr.9.12"},{"anchorText":"1 Chr 27:25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.27.25","rawQueryValue":"1Chr.27.25","sourceRefExact":"1Chr.27.25"}],"sourceItemFragmentSha256":"b4eed581d97478d7bffaf5c536543dfd3bba445c5370247f328951156198205d","sourceItemName":"Adiel","sourceItemOrder":118,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Adiel","product":"TyndaleOpenBibleDictionary","typename