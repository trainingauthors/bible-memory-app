{"content":[{"c":["EPHAI"],"sourceClass":"h1","t":"p"},{"c":["Netophathite (resident of the town Netophah, near Bethlehem) whose sons fought against the Babylonian army (",{"href":"?bref=Jer.40.8","r":"Jer.40.8","rawR":"Jer.40.8","sourceRefs":[{"raw":"Jer.40.8","value":"Jer.40.8"}],"t":"ref","v":"Jer 40:8"},"). They, with others, approached Gedaliah, the governor of Judah appointed by Babylon, and requested his protection. They died, along with Gedaliah, in an uprising led by Ishmael, the son of Nethaniah (",{"href":"?bref=Jer.41.3","r":"Jer.41.3","rawR":"Jer.41.3","sourceRefs":[{"raw":"Jer.41.3","value":"Jer.41.3"}],"t":"ref","v":"41:3"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Ephai","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jer 40:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.40.8","rawQueryValue":"Jer.40.8","sourceRefExact":"Jer.40.8"},{"anchorText":"41:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.41.3","rawQueryValue":"Jer.41.3","sourceRefExact":"Jer.41.3"}],"sourceItemFragmentSha256":"3c07875be180dd06b8158fa4e26bc6756e00589d11b1fc5964fc9d2fe4066d72","sourceItemName":"Ephai","sourceItemOrder":192,"sourceMember":"Articles/E.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Ephai","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Ephai","title":"Ephai","version":"v2-a101d843a2f0cd3fc0c6"}