ng_workstream","hrefExact":"?bref=Pr.30.8-9","rawQueryValue":"Pr.30.8-9","sourceRefExact":"Pr.30.8-9"},{"anchorText":"Pss 9:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ps.9.18","rawQueryValue":"Ps.9.18","sourceRefExact":"Ps.9.18"},{"anchorText":"10:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ps.10.14","rawQueryValue":"Ps.10.14","sourceRefExact":"Ps.10.14"},{"anchorText":"12:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ps.12.5","rawQueryValue":"Ps.12.5","sourceRefExact":"Ps.12.5"},{"anchorText":"34:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ps.34.6","rawQueryValue":"Ps.34.6","sourceRefExact":"Ps.34.6"},{"anchorText":"35:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ps.35.10","rawQueryValue":"Ps.35.10","sourceRefExact":"Ps.35.10"},{"anchorText":"74:19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ps.74.19","rawQueryValue":"Ps.74.19","sourceRefExact":"Ps.74.19"},{"anchorText":"Pss 10:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ps.10.17","rawQueryValue":"Ps.10.17","sourceRefExact":"Ps.10.17"},{"anchorText":"14:5-6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ps.14.5-6","rawQueryValue":"Ps.14.5-6","sourceRefExact":"Ps.14.5-6"},{"anchorText":"37:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ps.37.11","rawQueryValue":"Ps.37.11","sourceRefExact":"Ps.37.11"},{"anchorText":"Zep 3:12-13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Zeph.3.12-13","rawQueryValue":"Zeph.3.12-13","sourceRefExact":"Zeph.3.12-13"},{"anchorText":"Rom 15:26","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rom.15.26","rawQueryValue":"Rom.15.26","sourceRefExact":"Rom.15.26"},{"anchorText":"Gal 2:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gal.2.10","rawQueryValue":"Gal.2.10","sourceRefExact":"Gal.2.10"},{"anchorText":"Mk 10:23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mark.10.23","rawQueryValue":"Mark.10.23","sourceRefExact":"Mark.10.23"},{"anchorText":"Lk 12:13-21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.12.13-21","rawQueryValue":"Luke.12.13-21","sourceRefExact":"Luke.12.13-21"},{"anchorText":"16:19-31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.16.19-31","rawQueryValue":"Luke.16.19-31","sourceRefExact":"Luke.16.19-31"},{"anchorText":"Mt 5:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.5.3","rawQueryValue":"Matt.5.3","sourceRefExact":"Matt.5.3"},{"anchorText":"Lk 6:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.6.20","rawQueryValue":"Luke.6.20","sourceRefExact":"Luke.6.20"},{"anchorText":"Mt 11:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.11.5","rawQueryValue":"Matt.11.5","sourceRefExact":"Matt.11.5"},{"anchorText":"Lk 4:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.4.18","rawQueryValue":"Luke.4.18","sourceRefExact":"Luke.4.18"},{"anchorText":"2 Cor 8:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Cor.8.9","rawQueryValue":"2Cor.8.9","sourceRefExact":"2Cor.8.9"}],"sourceItemFragmentSha256":"244ce8848571bd4e0082abf2b35e58d7649e73931a70b396e75c30823ddfef79","sourceItemName":"Poorthe","sourceItemOrder":233,"sourceMember":"Articles/P.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Poorthe","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Poor, the","title":"Poor, the","version":"v2-a101d843a2f0cd3fc0c6"}