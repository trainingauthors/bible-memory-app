{"content":[{"c":["ACBOR"],"sourceClass":"h1","t":"p"},{"c":["1. Father of the Edomite king Baal-hanan before the establishment of Israel’s monarchy (",{"href":"?bref=Gen.36.38-39","r":"Gen.36.38-39","rawR":"Gen.36.38-39","sourceRefs":[{"raw":"Gen.36.38-39","value":"Gen.36.38-39"}],"t":"ref","v":"Gn 36:38-39"},"; ",{"href":"?bref=1Chr.1.49","r":"1Chr.1.49","rawR":"1Chr.1.49","sourceRefs":[{"raw":"1Chr.1.49","value":"1Chr.1.49"}],"t":"ref","v":"1 Chr 1:49"},")."],"sourceClass":"list","t":"p"},{"c":["2. Micaiah’s son, courtier of King Josiah of the southern kingdom of Judah. Josiah sent Acbor in a delegation to ask Huldah the prophetess about the newly found Book of the Law (",{"href":"?bref=2Kgs.22.12-14","r":"2Kgs.22.12-14","rawR":"2Kgs.22.12-14","sourceRefs":[{"raw":"2Kgs.22.12-14","value":"2Kgs.22.12-14"}],"t":"ref","v":"2 Kgs 22:12-14"},"). Acbor was also referred to as Abdon, son of Micah (",{"href":"?bref=2Chr.34.20","r":"2Chr.34.20","rawR":"2Chr.34.20","sourceRefs":[{"raw":"2Chr.34.20","value":"2Chr.34.20"}],"t":"ref","v":"2 Chr 34:20"},"). He was the father of Elnathan (",{"href":"?bref=Jer.26.22","r":"Jer.26.22","rawR":"Jer.26.22","sourceRefs":[{"raw":"Jer.26.22","value":"Jer.26.22"}],"t":"ref","v":"Jer 26:22"},"; ",{"href":"?bref=Jer.36.12","r":"Jer.36.12","rawR":"Jer.36.12","sourceRefs":[{"raw":"Jer.36.12","value":"Jer.36.12"}],"t":"ref","v":"36:12"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Acbor","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 36:38-39","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.36.38-39","rawQueryValue":"Gen.36.38-39","sourceRefExact":"Gen.36.38-39"},{"anchorText":"1 Chr 1:49","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.1.49","rawQueryValue":"1Chr.1.49","sourceRefExact":"1Chr.1.49"},{"anchorText":"2 Kgs 22:12-14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.22.12-14","rawQueryValue":"2Kgs.22.12-14","sourceRefExact":"2Kgs.22.12-14"},{"anchorText":"2 Chr 34:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.34.20","rawQueryValue":"2Chr.34.20","sourceRefExact":"2Chr.34.20"},{"anchorText":"Jer 26:22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.26.22","rawQueryValue":"Jer.26.22","sourceRefExact":"Jer.26.22"},{"anchorText":"36:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.36.12","rawQueryValue":"Jer.36.12","sourceRefExact":"Jer.36.12"}],"sourceItemFragmentSha256":"947f3030d93e17f1b0cf45b5bb693aa88d29ee8aa39acab1d4d011e048d2727c","sourceItemName":"Acbor","sourceItemOrder":69,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Acbor","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Acbor","title":"Acbor","version":"v2-a101d843a2f0cd3fc0c6"}