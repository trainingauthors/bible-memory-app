{"content":[{"c":["JOTBAH"],"sourceClass":"h1","t":"p"},{"c":["Hometown of Haruz, the father of Meshullemeth, who was the mother of King Amon of Judah (",{"href":"?bref=2Kgs.21.19","r":"2Kgs.21.19","rawR":"2Kgs.21.19","sourceRefs":[{"raw":"2Kgs.21.19","value":"2Kgs.21.19"}],"t":"ref","v":"2 Kgs 21:19"},"). Its location is uncertain; however, some identify it with the town later named Jotapata by the Romans, situated six miles (9.7 kilometers) north of Sepphoris (modern Khirbet Jefat)."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Jotbah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Kgs 21:19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.21.19","rawQueryValue":"2Kgs.21.19","sourceRefExact":"2Kgs.21.19"}],"sourceItemFragmentSha256":"b74585432cc39398058d3ea7dd1b3e0a21efa6f9b9528d0da5d1e0bceb45b2f9","sourceItemName":"Jotbah","sourceItemOrder":335,"sourceMember":"Articles/J.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Jotbah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Jotbah","title":"Jotbah","version":"v2-a101d843a2f0cd3fc0c6"}