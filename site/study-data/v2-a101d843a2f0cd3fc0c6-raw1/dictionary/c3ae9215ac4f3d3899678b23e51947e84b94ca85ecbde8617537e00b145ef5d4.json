{"content":[{"c":["HARA"],"sourceClass":"h1","t":"p"},{"c":["Place where Tiglath-pileser of Assyria exiled Reuben, Gad, and the half-tribe of Manasseh (",{"href":"?bref=1Chr.5.26","r":"1Chr.5.26","rawR":"1Chr.5.26","sourceRefs":[{"raw":"1Chr.5.26","value":"1Chr.5.26"}],"t":"ref","v":"1 Chr 5:26"},"). A possible miscopying of ",{"href":"?bref=2Kgs.17.6","r":"2Kgs.17.6","rawR":"2Kgs.17.6","sourceRefs":[{"raw":"2Kgs.17.6","value":"2Kgs.17.6"}],"t":"ref","v":"2 Kings 17:6"}," and ",{"href":"?bref=2Kgs.18.11","r":"2Kgs.18.11","rawR":"2Kgs.18.11","sourceRefs":[{"raw":"2Kgs.18.11","value":"2Kgs.18.11"}],"t":"ref","v":"18:11"}," may have substituted Hara for “cities of Media.” The Greek version reads “mountains of Media,” indicating an area east of the Tigris Valley. A district rather than a single site seems to be indicated."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Hara","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 5:26","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.5.26","rawQueryValue":"1Chr.5.26","sourceRefExact":"1Chr.5.26"},{"anchorText":"2 Kings 17:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.17.6","rawQueryValue":"2Kgs.17.6","sourceRefExact":"2Kgs.17.6"},{"anchorText":"18:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.18.11","rawQueryValue":"2Kgs.18.11","sourceRefExact":"2Kgs.18.11"}],"sourceItemFragmentSha256":"0cd3becb10a39c3860cd2fb6b4ec702c2f631703bfd0be09c167101fccf6bc6d","sourceItemName":"Hara","sourceItemOrder":103,"sourceMember":"Articles/H.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Hara","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Hara","title":"Hara","version":"v2-a101d843a2f0cd3fc0c6"}