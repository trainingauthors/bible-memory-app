{"content":[{"c":["BUNNI"],"sourceClass":"h1","t":"p"},{"c":["1. Levite who sang praise to God after Ezra’s public reading of the law (",{"href":"?bref=Neh.9.4","r":"Neh.9.4","rawR":"Neh.9.4","sourceRefs":[{"raw":"Neh.9.4","value":"Neh.9.4"}],"t":"ref","v":"Neh 9:4"},")."],"sourceClass":"list","t":"p"},{"c":["2. Political leader who signed Ezra’s covenant of faithfulness to God with Nehemiah and others after the exile (",{"href":"?bref=Neh.10.15","r":"Neh.10.15","rawR":"Neh.10.15","sourceRefs":[{"raw":"Neh.10.15","value":"Neh.10.15"}],"t":"ref","v":"Neh 10:15"},")."],"sourceClass":"list","t":"p"},{"c":["3. Hashabiah’s father (",{"href":"?bref=Neh.11.15","r":"Neh.11.15","rawR":"Neh.11.15","sourceRefs":[{"raw":"Neh.11.15","value":"Neh.11.15"}],"t":"ref","v":"Neh 11:15"},"), a Levite descended from Merari (",{"href":"?bref=1Chr.9.14","r":"1Chr.9.14","rawR":"1Chr.9.14","sourceRefs":[{"raw":"1Chr.9.14","value":"1Chr.9.14"}],"t":"ref","v":"1 Chr 9:14"},"). Possibly the same as #1 above."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Bunni","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Neh 9:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.9.4","rawQueryValue":"Neh.9.4","sourceRefExact":"Neh.9.4"},{"anchorText":"Neh 10:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.10.15","rawQueryValue":"Neh.10.15","sourceRefExact":"Neh.10.15"},{"anchorText":"Neh 11:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.11.15","rawQueryValue":"Neh.11.15","sourceRefExact":"Neh.11.15"},{"anchorText":"1 Chr 9:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.9.14","rawQueryValue":"1Chr.9.14","sourceRefExact":"1Chr.9.14"}],"sourceItemFragmentSha256":"463e9a8a40330a1579bf1e97566ee41fbb98af9c7344d58f00de