e":"Luke.10.12","sourceRefExact":"Luke.10.12"},{"anchorText":"17:29","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.17.29","rawQueryValue":"Luke.17.29","sourceRefExact":"Luke.17.29"},{"anchorText":"Rom 9:29","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rom.9.29","rawQueryValue":"Rom.9.29","sourceRefExact":"Rom.9.29"},{"anchorText":"2 Pt 2:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Pet.2.6","rawQueryValue":"2Pet.2.6","sourceRefExact":"2Pet.2.6"},{"anchorText":"Jude 1:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jude.1.7","rawQueryValue":"Jude.1.7","sourceRefExact":"Jude.1.7"},{"anchorText":"Rv 11:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.11.8","rawQueryValue":"Rev.11.8","sourceRefExact":"Rev.11.8"},{"anchorText":"Genesis 18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.18.1-33","rawQueryValue":"Gen.18.1-33","sourceRefExact":"Gen.18.1-33"},{"anchorText":"19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.19.1-38","rawQueryValue":"Gen.19.1-38","sourceRefExact":"Gen.19.1-38"},{"anchorText":"13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.13.1-18","rawQueryValue":"Gen.13.1-18","sourceRefExact":"Gen.13.1-18"},{"anchorText":"Gn 14:1-5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.14.1-5","rawQueryValue":"Gen.14.1-5","sourceRefExact":"Gen.14.1-5"},{"anchorText":"18:20-33","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.18.20-33","rawQueryValue":"Gen.18.20-33","sourceRefExact":"Gen.18.20-33"},{"anchorText":"19:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.19.1","rawQueryValue":"Gen.19.1","sourceRefExact":"Gen.19.1"}],"sourceItemFrag