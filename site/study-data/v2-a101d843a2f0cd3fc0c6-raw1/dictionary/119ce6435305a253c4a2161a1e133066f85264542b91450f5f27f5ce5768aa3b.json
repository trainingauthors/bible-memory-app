{"content":[{"c":["LOINS"],"sourceClass":"h1","t":"p"},{"c":["Region of the body from the chest to the lower part of the hip; an expression in the ",{"c":["kjv"],"sourceClass":"sc","t":"span"}," (“out of his loins”) for that part of the body that involved procreation (",{"href":"?bref=Gen.35.11","r":"Gen.35.11","rawR":"Gen.35.11","sourceRefs":[{"raw":"Gen.35.11","value":"Gen.35.11"}],"t":"ref","v":"Gn 35:11"},"; ",{"href":"?bref=Gen.46.26","r":"Gen.46.26","rawR":"Gen.46.26","sourceRefs":[{"raw":"Gen.46.26","value":"Gen.46.26"}],"t":"ref","v":"46:26"},"; ",{"href":"?bref=Exod.1.5","r":"Exod.1.5","rawR":"Exod.1.5","sourceRefs":[{"raw":"Exod.1.5","value":"Exod.1.5"}],"t":"ref","v":"Ex 1:5"},"; ",{"href":"?bref=1Kgs.8.19","r":"1Kgs.8.19","rawR":"1Kgs.8.19","sourceRefs":[{"raw":"1Kgs.8.19","value":"1Kgs.8.19"}],"t":"ref","v":"1 Kgs 8:19"},"). In most instances, the word describes physical features, although occasionally emotion, power, or strength is meant (see ",{"href":"?bref=Nah.2.1","r":"Nah.2.1","rawR":"Nah.2.1","sourceRefs":[{"raw":"Nah.2.1","value":"Nah.2.1"}],"t":"ref","v":"Na 2:1"},"). As was the custom of the Hebrews and other Near Eastern peoples, a man would tie up his clothes around the loins before traveling a long distance on foot (",{"href":"?bref=Exod.12.11","r":"Exod.12.11","rawR":"Exod.12.11","sourceRefs":[{"raw":"Exod.12.11","value":"Exod.12.11"}],"t":"ref","v":"Ex 12:11"},"; ",{"href":"?bref=1Kgs.18.46","r":"1Kgs.18.46","rawR":"1Kgs.18.46","sourceRefs":[{"raw":"1Kgs.18.46","value":"1Kgs.18.46"}],"t":"ref","v":"1 Kgs 18:46"},"; ",{"href":"?bref=2Kgs.9.1","r":"2Kgs.9.1","rawR":"2Kgs.9.1","sourceRefs":[{"raw":"2Kgs.9.1","value":"2Kgs.9.1"}],"t":"ref","v":"2 Kgs 9:1"},"). In the NT girded loins signified that a man was ready for service or heavy battle (",{"href":"?bref=Luke.12.35","r":"Luke.12.35","rawR":"Luke.12.35","sourceRefs":[{"raw":"Luke.12.35","value":"Luke.12.35"}],"t":"ref","v":"Lk 12:35"},"). Metaphorically, girding the loins is a symbolic way of saying that one is standing firm and/or exercising self-control (",{"href":"?bref=Eph.6.14","r":"Eph.6.14","rawR":"Eph.6.14","sourceRefs":[{"raw":"Eph.6.14","value":"Eph.6.14"}],"t":"ref","v":"Eph 6:14"},"; ",{"href":"?bref=1Pet.1.13","r":"1Pet.1.13","rawR":"1Pet.1.13","sourceRefs":[{"raw":"1Pet.1.13","value":"1Pet.1.13"}],"t":"ref","v":"1 Pt 1:13"},", ",{"c":["kjv"],"sourceClass":"sc","t":"span"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Loins","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 35:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.35.11","rawQueryValue":"Gen.35.11","sourceRefExact":"Gen.35.11"},{"anchorText":"46:26","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.46.26","rawQueryValue":"Gen.46.26","sourceRefExact":"Gen.46.26"},{"anchorText":"Ex 1:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.1.5","rawQueryValue":"Exod.1.5","sourceRefExact":"Exod.1.5"},{"anchorText":"1 Kgs 8:19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.8.19","rawQueryValue":"1Kgs.8.19","sourceRefExact":"1Kgs.8.19"},{"anchorText":"Na 2:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Nah.2.1","rawQueryValue":"Nah.2.1","sourceRefExact":"Nah.2.1"},{"anchorText":"Ex 12:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.12.11","rawQueryValue":"Exod.12.11","sourceRefExact":"Exod.12.11"},{"anchorText":"1 Kgs 18:46","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.18.46","rawQueryValue":"1Kgs.18.46","sourceRefExact":"1Kgs.18.46"},{"anchorText":"2 Kgs 9:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.9.1","rawQueryValue":"2Kgs.9.1","sourceRefExact":"2Kgs.9.1"},{"anchorText":"Lk 12:35","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.12.35","rawQueryValue":"Luke.12.35","sourceRefExact":"Luke.12.35"},{"anchorText":"Eph 6:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Eph.6.14","rawQueryValue":"Eph.6.14","sourceRefExact":"Eph.6.14"},{"anchorText":"1 Pt 1:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Pet.1.13","rawQueryValue":"1Pet.1.13","sourceRefExact":"1Pet.1.13"}],"sourceItemFragmentSha256":"4fc8acf2d9c30a9c632bbeca9cbb32a6b37232bede1c70a9bab4380f55a5d757","sourceItemName":"Loins","sourceItemOrder":120,"sourceMember":"Articles/L.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Loins","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Loins","title":"Loins","version":"v2-a101d843a2f0cd3fc0c6"}