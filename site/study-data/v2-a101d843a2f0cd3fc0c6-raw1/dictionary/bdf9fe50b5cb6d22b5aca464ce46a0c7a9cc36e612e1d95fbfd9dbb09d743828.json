{"content":[{"c":["AHAVA"],"sourceClass":"h1","t":"p"},{"c":["The name of the river (and possibly town) in Babylonia where Ezra added some Levites to the remnant of exiles. There he also declared a fast for the Jews to humble themselves before God and seek his protection before returning to Palestine (",{"href":"?bref=Ezra.8.15,21,31","r":"Ezra.8.15,21,31","rawR":"Ezra.8.15,21,31","sourceRefs":[{"raw":"Ezra.8.15,21,31","value":"Ezra.8.15,21,31"}],"t":"ref","v":"Ezr 8:15, 21, 31"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Ahava","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ezr 8:15, 21, 31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.8.15,21,31","rawQueryValue":"Ezra.8.15,21,31","sourceRefExact":"Ezra.8.15,21,31"}],"sourceItemFragmentSha256":"d97755a101d9f5353b161bff9fe42e584c68b0c83db7583433dd85726df0fc45","sourceItemName":"Ahava","sourceItemOrder":174,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Ahava","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Ahava","title":"Ahava","version":"v2-a101d843a2f0cd3fc0c6"}