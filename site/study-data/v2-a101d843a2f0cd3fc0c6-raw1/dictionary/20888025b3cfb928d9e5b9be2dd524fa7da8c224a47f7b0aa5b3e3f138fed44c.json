{"content":[{"c":["HENADAD"],"sourceClass":"h1","t":"p"},{"c":["Head of a Levite family that participated in the rebuilding of the temple (",{"href":"?bref=Ezra.3.9","r":"Ezra.3.9","rawR":"Ezra.3.9","sourceRefs":[{"raw":"Ezra.3.9","value":"Ezra.3.9"}],"t":"ref","v":"Ezr 3:9"},"). Members of this family also helped to build the Jerusalem wall (",{"href":"?bref=Neh.3.18,24","r":"Neh.3.18,24","rawR":"Neh.3.18,24","sourceRefs":[{"raw":"Neh.3.18,24","value":"Neh.3.18,24"}],"t":"ref","v":"Neh 3:18, 24"},"), and signed Ezra’s covenant of faithfulness to God together with Nehemiah (",{"href":"?bref=Neh.10.9","r":"Neh.10.9","rawR":"Neh.10.9","sourceRefs":[{"raw":"Neh.10.9","value":"Neh.10.9"}],"t":"ref","v":"10:9"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Henadad","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ezr 3:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.3.9","rawQueryValue":"Ezra.3.9","sourceRefExact":"Ezra.3.9"},{"anchorText":"Neh 3:18, 24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.3.18,24","rawQueryValue":"Neh.3.18,24","sourceRefExact":"Neh.3.18,24"},{"anchorText":"10:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.10.9","rawQueryValue":"Neh.10.9","sourceRefExact":"Neh.10.9"}],"sourceItemFragmentSha256":"5ab61370f9a6e6bd179c24bd74b249391418063a430dc6ff79da79910dc9be22","sourceItemName":"Henadad","sourceItemOrder":248,"sourceMember":"Articles/H.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Henadad","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Henadad","title":"Henadad","version":"v2-a101d843a2f0cd3fc0c6"}