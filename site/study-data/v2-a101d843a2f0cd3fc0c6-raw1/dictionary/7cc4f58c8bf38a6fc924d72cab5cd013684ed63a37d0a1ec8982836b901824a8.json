{"content":[{"c":["KESALON"],"sourceClass":"h1","t":"p"},{"c":["City in northern Judah near the border of Dan, situated on the northern slope of Mt Jearim; usually identified with modern Kesla, about nine miles (14.5 kilometers) west of Jerusalem. Kesalon is mentioned only in the period of Israel’s initial settlement of Canaan under Joshua (",{"href":"?bref=Josh.15.10","r":"Josh.15.10","rawR":"Josh.15.10","sourceRefs":[{"raw":"Josh.15.10","value":"Josh.15.10"}],"t":"ref","v":"Jos 15:10"},")."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=JearimMount_Article_TyndaleOpenBibleDictionary","id":"JearimMount_Article_TyndaleOpenBibleDictionary","rawId":"JearimMount_Article_TyndaleOpenBibleDictionary","t":"link","v":"Jearim, Mount"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Kesalon","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 15:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.10","rawQueryValue":"Josh.15.10","sourceRefExact":"Josh.15.10"}],"sourceItemFragmentSha256":"0a86e09d6897ff66b8118b92fb149bde39f1da66f362a7f63cdeff97ae8bdbc2","sourceItemName":"Kesalon","sourceItemOrder":56,"sourceMember":"Articles/K.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Kesalon","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Kesalon","title":"Kesalon","version":"v2-a101d843a2f0cd3fc0c6"}