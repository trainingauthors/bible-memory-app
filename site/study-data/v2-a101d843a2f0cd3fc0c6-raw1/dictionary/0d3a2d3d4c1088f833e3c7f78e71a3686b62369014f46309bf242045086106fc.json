7.1-28","sourceRefExact":"Dan.7.1-28"},{"anchorText":"8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Dan.8.1-27","rawQueryValue":"Dan.8.1-27","sourceRefExact":"Dan.8.1-27"},{"anchorText":"9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Dan.9.1-27","rawQueryValue":"Dan.9.1-27","sourceRefExact":"Dan.9.1-27"},{"anchorText":"11–12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Dan.11.1-12.13","rawQueryValue":"Dan.11.1-12.13","sourceRefExact":"Dan.11.1-12.13"},{"anchorText":"Ez 28:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.28.3","rawQueryValue":"Ezek.28.3","sourceRefExact":"Ezek.28.3"},{"anchorText":"14:14, 20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.14.14,20","rawQueryValue":"Ezek.14.14,20","sourceRefExact":"Ezek.14.14,20"}],"sourceItemFragmentSha256":"6570e71bba4f6fedcff152b74b4b27953a82868f94e9e4547531611709f5890d","sourceItemName":"DanielPerson","sourceItemOrder":17,"sourceMember":"Articles/D.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"DanielPerson","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Daniel (Person)","title":"Daniel (Person)","version":"v2-a101d843a2f0cd3fc0c6"}