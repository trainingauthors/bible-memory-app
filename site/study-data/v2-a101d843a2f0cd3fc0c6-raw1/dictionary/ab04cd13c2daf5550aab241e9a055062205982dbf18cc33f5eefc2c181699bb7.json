{"content":[{"c":["FULLER*"],"sourceClass":"h1","t":"p"},{"c":["One who cleans, shrinks, thickens, or dyes cloth or newly shorn wool. It was the fuller’s job to prepare fibers used for weaving by cleansing them of oil and other impurities. The cleansing materials the fuller used were white clay, urine, and ashes of special plants. The fuller’s plant lay outside the town because of offensive odors and because space was needed for spreading the fibers to dry, as was the case of the Fuller’s Field outside Jerusalem in Isaiah’s day (",{"href":"?bref=2Kgs.18.17","r":"2Kgs.18.17","rawR":"2Kgs.18.17","sourceRefs":[{"raw":"2Kgs.18.17","value":"2Kgs.18.17"}],"t":"ref","v":"2 Kgs 18:17"},"; ",{"href":"?bref=Isa.7.3","r":"Isa.7.3","rawR":"Isa.7.3","sourceRefs":[{"raw":"Isa.7.3","value":"Isa.7.3"}],"t":"ref","v":"Is 7:3"},"; ",{"href":"?bref=Isa.36.2","r":"Isa.36.2","rawR":"Isa.36.2","sourceRefs":[{"raw":"Isa.36.2","value":"Isa.36.2"}],"t":"ref","v":"36:2"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Fuller","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Kgs 18:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.18.17","rawQueryValue":"2Kgs.18.17","sourceRefExact":"2Kgs.18.17"},{"anchorText":"Is 7:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.7.3","rawQueryValue":"Isa.7.3","sourceRefExact":"Isa.7.3"},{"anchorText":"36:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.36.2","rawQueryValue":"Isa.36.2","sourceRefExact":"Isa.36.2"}],"sourceItemFragmentSha256":"3355ce537683e96780ef340d9027a5c00f2e85065fb646966ffe8bd9b26f23b5","sourceItemName":"Fuller","sourceItemOrder":90,"sourceMember":"Articles/F.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Fuller","product":"TyndaleOpenBibleDictionary","t