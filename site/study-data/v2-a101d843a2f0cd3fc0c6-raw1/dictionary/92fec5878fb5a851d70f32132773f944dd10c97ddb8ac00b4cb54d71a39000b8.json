{"content":[{"c":["SCEVA"],"sourceClass":"h1","t":"p"},{"c":["Father of seven sons and a Jewish chief priest in Ephesus at the time of Paul’s visit on his third missionary journey. Sceva’s sons attempted to imitate Paul’s exorcism of evil spirits in the name of Jesus. The exorcisms failed, and their authority was not recognized. Consequently, they were attacked and harmed by the evil spirits they tried to rebuke (",{"href":"?bref=Acts.19.14","r":"Acts.19.14","rawR":"Acts.19.14","sourceRefs":[{"raw":"Acts.19.14","value":"Acts.19.14"}],"t":"ref","v":"Acts 19:14"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Sceva","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Acts 19:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.19.14","rawQueryValue":"Acts.19.14","sourceRefExact":"Acts.19.14"}],"sourceItemFragmentSha256":"4a2fb7807d88b80370fd387668652d54d3d32bf396f2819a3aba5e03840595fc","sourceItemName":"Sceva","sourceItemOrder":90,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Sceva","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Sceva","title":"Sceva","version":"v2-a101d843a2f0cd3fc0c6"}