{"content":[{"c":["CUP"],"sourceClass":"h1","t":"p"},{"c":["The word may refer either to the vessel itself or to its contents and may be intended literally or figuratively."],"sourceClass":"fl","t":"p"},{"c":["1. A small drinking vessel, made of various materials (leather, metal, or pottery), sizes, and designs."],"sourceClass":"list-space","t":"p"},{"c":["2. A figure of speech to represent one’s portion of or participation in something. It is associated with consolation (",{"href":"?bref=Jer.16.7","r":"Jer.16.7","rawR":"Jer.16.7","sourceRefs":[{"raw":"Jer.16.7","value":"Jer.16.7"}],"t":"ref","v":"Jer 16:7"},"), demons (",{"href":"?bref=1Cor.10.21","r":"1Cor.10.21","rawR":"1Cor.10.21","sourceRefs":[{"raw":"1Cor.10.21","value":"1Cor.10.21"}],"t":"ref","v":"1 Cor 10:21"},"), divination (",{"href":"?bref=Gen.44.2,5","r":"Gen.44.2,5","rawR":"Gen.44.2,5","sourceRefs":[{"raw":"Gen.44.2,5","value":"Gen.44.2,5"}],"t":"ref","v":"Gn 44:2, 5"},"), drunkenness (",{"href":"?bref=Pr.23.31","r":"Pr.23.31","rawR":"Pr.23.31","sourceRefs":[{"raw":"Pr.23.31","value":"Pr.23.31"}],"t":"ref","v":"Prv 23:31"},"), immorality (",{"href":"?bref=Rev.17.4","r":"Rev.17.4","rawR":"Rev.17.4","sourceRefs":[{"raw":"Rev.17.4","value":"Rev.17.4"}],"t":"ref","v":"Rv 17:4"},"; ",{"href":"?bref=Rev.18.6","r":"Rev.18.6","rawR":"Rev.18.6","sourceRefs":[{"raw":"Rev.18.6","value":"Rev.18.6"}],"t":"ref","v":"18:6"},"), inheritance (",{"href":"?bref=Ps.16.5","r":"Ps.16.5","rawR":"Ps.16.5","sourceRefs":[{"raw":"Ps.16.5","value":"Ps.16.5"}],"t":"ref","v":"Ps 16:5"},"), judgment (",{"href":"?bref=Ps.11.6","r":"Ps.11.6","rawR":"Ps.11.6","sourceRefs":[{"raw":"Ps.11.6","value":"Ps.11.6"}],"t":"ref","v":"Pss 11:6"},"; ",{"href":"?bref=Ps.75.8","r":"Ps.75.8","rawR":"Ps.75.8","sourceRefs":[{"raw":"Ps.75.8","value":"Ps.75.8"}],"t":"ref","v":"75:8"},"; ",{"href":"?bref=Isa.51.17,22","r":"Isa.51.17,22","rawR":"Isa.51.17,22","sourceRefs":[{"raw":"Isa.51.17,22","value":"Isa.51.17,22"}],"t":"ref","v":"Is 51:17, 22"},"; ",{"