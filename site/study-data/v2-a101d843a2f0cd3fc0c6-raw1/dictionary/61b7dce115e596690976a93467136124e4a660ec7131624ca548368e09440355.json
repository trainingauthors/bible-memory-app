.1.20","rawQueryValue":"1Tim.1.20","sourceRefExact":"1Tim.1.20"},{"anchorText":"Rom 16:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rom.16.20","rawQueryValue":"Rom.16.20","sourceRefExact":"Rom.16.20"},{"anchorText":"Rv 20:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.20.10","rawQueryValue":"Rev.20.10","sourceRefExact":"Rev.20.10"}],"sourceItemFragmentSha256":"6f823bcadf5ba24479eac918355ecded518fdf842fad17cc20f93f6008cc21ea","sourceItemName":"Satan","sourceItemOrder":79,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Satan","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Satan","title":"Satan","version":"v2-a101d843a2f0cd3fc0c6"}