.10-17","rawQueryValue":"Lev.25.10-17","sourceRefExact":"Lev.25.10-17"},{"anchorText":"Lv 26","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Lev.26.1-46","rawQueryValue":"Lev.26.1-46","sourceRefExact":"Lev.26.1-46"},{"anchorText":"Lv 26:37","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Lev.26.37","rawQueryValue":"Lev.26.37","sourceRefExact":"Lev.26.37"},{"anchorText":"Dt 28:64","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.28.64","rawQueryValue":"Deut.28.64","sourceRefExact":"Deut.28.64"},{"anchorText":"Is 62:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.62.4","rawQueryValue":"Isa.62.4","sourceRefExact":"Isa.62.4"},{"anchorText":"Rom 8:19-23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rom.8.19-23","rawQueryValue":"Rom.8.19-23","sourceRefExact":"Rom.8.19-23"},{"anchorText":"Jl 3:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Joel.3.18","rawQueryValue":"Joel.3.18","sourceRefExact":"Joel.3.18"},{"anchorText":"Am 9:13-15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Amos.9.13-15","rawQueryValue":"Amos.9.13-15","sourceRefExact":"Amos.9.13-15"},{"anchorText":"Zec 14:6-9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Zech.14.6-9","rawQueryValue":"Zech.14.6-9","sourceRefExact":"Zech.14.6-9"},{"anchorText":"2 Pt 3:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Pet.3.10","rawQueryValue":"2Pet.3.10","sourceRefExact":"2Pet.3.10"},{"anchorText":"Rv 21:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.21.1","rawQueryValue":"Rev.21.1","sourceRefExact":"Rev.21.1"}],"sourceItemFragmentSha256":"9ab6b90ec0bcc53503581f771c3a511b6ca42be42bcf2dcb15ffc440bcb68854","sourceItemName":"Earth","sourceItemOrder":3,"sourceMember":"Articles/E.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Earth","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Earth","title":"Earth","version":"v2-a101d843a2f0cd3fc0c6"}