{"content":[{"c":["OHOLIAB"],"sourceClass":"h1","t":"p"},{"c":["Man assigned by Moses to assist Bezalel, the master craftsman, in the construction and ornamentation of the tabernacle. Son of Ahisamach and member of Dan’s tribe, Oholiab was specifically noted as a designer and embroiderer. Along with Bezalel, he taught the skills necessary for the construction of the tabernacle (",{"href":"?bref=Exod.31.6","r":"Exod.31.6","rawR":"Exod.31.6","sourceRefs":[{"raw":"Exod.31.6","value":"Exod.31.6"}],"t":"ref","v":"Ex 31:6"},"; ",{"href":"?bref=Exod.35.34","r":"Exod.35.34","rawR":"Exod.35.34","sourceRefs":[{"raw":"Exod.35.34","value":"Exod.35.34"}],"t":"ref","v":"35:34"},"; ",{"href":"?bref=Exod.36.1-2","r":"Exod.36.1-2","rawR":"Exod.36.1-2","sourceRefs":[{"raw":"Exod.36.1-2","value":"Exod.36.1-2"}],"t":"ref","v":"36:1-2"},"; ",{"href":"?bref=Exod.38.23","r":"Exod.38.23","rawR":"Exod.38.23","sourceRefs":[{"raw":"Exod.38.23","value":"Exod.38.23"}],"t":"ref","v":"38:23"},"; ",{"c":["kjv"],"sourceClass":"sc","t":"span"}," “Aholiab”)."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Oholiab","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ex 31:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.31.6","rawQueryValue":"Exod.31.6","sourceRefExact":"Exod.31.6"},{"anchorText":"35:34","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.35.34","rawQueryValue":"Exod.35.34","sourceRefExact":"Exod.35.34"},{"anchorText":"36:1-2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.36.1-2","rawQueryValue":"Exod.36.1-2","sourceRefExact":"Exod.36.1-2"},{"anchorText":"38:23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.38.23","rawQueryValue":"Exod.38.23","sourceRefExact":"Exod.38.23"}],"sourceItemFragmentSha256":"4d