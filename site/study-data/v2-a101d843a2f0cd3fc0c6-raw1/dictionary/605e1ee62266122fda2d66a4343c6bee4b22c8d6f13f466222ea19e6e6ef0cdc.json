{"content":[{"c":["LANDMARK*"],"sourceClass":"h1","t":"p"},{"c":["Inscribed stone that denoted a boundary of fields, districts, or nations (",{"href":"?bref=Gen.31.51-52","r":"Gen.31.51-52","rawR":"Gen.31.51-52","sourceRefs":[{"raw":"Gen.31.51-52","value":"Gen.31.51-52"}],"t":"ref","v":"Gn 31:51-52"},"). In most Near Eastern countries the removal of a landmark was a serious crime; in Israel it was a violation of the law of Moses (",{"href":"?bref=Deut.19.14","r":"Deut.19.14","rawR":"Deut.19.14","sourceRefs":[{"raw":"Deut.19.14","value":"Deut.19.14"}],"t":"ref","v":"Dt 19:14"},"; ",{"href":"?bref=Deut.27.17","r":"Deut.27.17","rawR":"Deut.27.17","sourceRefs":[{"raw":"Deut.27.17","value":"Deut.27.17"}],"t":"ref","v":"27:17"},"). Removing landmarks (",{"c":["nlt"],"sourceClass":"sc","t":"span"}," “boundary markers”) could be represented as changing ancient customs and laws (",{"href":"?bref=Pr.22.28","r":"Pr.22.28","rawR":"Pr.22.28","sourceRefs":[{"raw":"Pr.22.28","value":"Pr.22.28"}],"t":"ref","v":"Prv 22:28"},"; ",{"href":"?bref=Pr.23.10","r":"Pr.23.10","rawR":"Pr.23.10","sourceRefs":[{"raw":"Pr.23.10","value":"Pr.23.10"}],"t":"ref","v":"23:10"},"; cf. ",{"href":"?bref=Job.24.2","r":"Job.24.2","rawR":"Job.24.2","sourceRefs":[{"raw":"Job.24.2","value":"Job.24.2"}],"t":"ref","v":"Jb 24:2"},")."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Inscriptions_Article_TyndaleOpenBibleDictionary","id":"Inscriptions_Article_TyndaleOpenBibleDictionary","rawId":"Inscriptions_Article_TyndaleOpenBibleDictionary","t":"link","v":"Inscriptions"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Landmark","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 31:51-52","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.31.51-52","rawQueryValue":"Gen.31.51-52","sourceRefExact":"Gen.31.51-52"},{"anchorText":"Dt 19:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.19.14","rawQueryValue":"Deut.19.14","sourceRefExact":"Deut.19.14"},{"anchorText":"27:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.27.17","rawQueryValue":"Deut.27.17","sourceRefExact":"Deut.27.17"},{"anchorText":"Prv 22:28","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Pr.22.28","rawQueryValue":"Pr.22.28","sourceRefExact":"Pr.22.28"},{"anchorText":"23:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Pr.23.10","rawQueryValue":"Pr.23.10","sourceRefExact":"Pr.23.10"},{"anchorText":"Jb 24:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Job.24.2","rawQueryValue":"Job.24.2","sourceRefExact":"Job.24.2"}],"sourceItemFragmentSha256":"8677a2dab165f171988376b8b7bdebeea77a52c3323d7237f4b6546beb5fcc4e","sourceItemName":"Landmark","sourceItemOrder":26,"sourceMember":"Articles/L.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Landmark","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Landmark*","title":"Landmark*","version":"v2-a101d843a2f0cd3fc0c6"}