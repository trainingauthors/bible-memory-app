_workstream","hrefExact":"?bref=Exod.5.1","rawQueryValue":"Exod.5.1","sourceRefExact":"Exod.5.1"},{"anchorText":"5–12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.5.1-12.51","rawQueryValue":"Exod.5.1-12.51","sourceRefExact":"Exod.5.1-12.51"},{"anchorText":"Ex 8:19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.8.19","rawQueryValue":"Exod.8.19","sourceRefExact":"Exod.8.19"},{"anchorText":"12:1-28","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.12.1-28","rawQueryValue":"Exod.12.1-28","sourceRefExact":"Exod.12.1-28"},{"anchorText":"13:1-16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.13.1-16","rawQueryValue":"Exod.13.1-16","sourceRefExact":"Exod.13.1-16"},{"anchorText":"Ex 16:1-6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.16.1-6","rawQueryValue":"Exod.16.1-6","sourceRefExact":"Exod.16.1-6"},{"anchorText":"17:8-16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.17.8-16","rawQueryValue":"Exod.17.8-16","sourceRefExact":"Exod.17.8-16"},{"anchorText":"18:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.18.12","rawQueryValue":"Exod.18.12","sourceRefExact":"Exod.18.12"},{"anchorText":"19:24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.19.24","rawQueryValue":"Exod.19.24","sourceRefExact":"Exod.19.24"},{"anchorText":"24:1-8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.24.1-8","rawQueryValue":"Exod.24.1-8","sourceRefExact":"Exod.24.1-8"},{"anchorText":"24:9-10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.24.9-10","rawQueryValue":"Exod.24.9-10","sourceRefExact":"Exod.24.9-10"},{"anchorText":"13-14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.24.13-14","rawQueryValue":"Exod.24.13-14","sourceRefExact":"Exod.24.13-14"},{"anchorText":"Ex 32:1-4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.32.1-4","rawQueryValue":"Exod.32.1-4","sourceRefExact":"Exod.32.1-4"},{"anchorText":"5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.32.5","rawQueryValue":"Exod.32.5","sourceRefExact":"Exod.32.5"},{"anchorText":"6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.32.6","rawQueryValue":"Exod.32.6","sourceRefExact":"Exod.32.6"},{"anchorText":"Ex 32:7-14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.32.7-14","rawQueryValue":"Exod.32.7-14","sourceRefExact":"Exod.32.7-14"},{"anchorText":"21-24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.32.21-24","rawQueryValue":"Exod.32.21-24","sourceRefExact":"Exod.32.21-24"},{"anchorText":"Ex 32:25-28","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.32.25-28","rawQueryValue":"Exod.32.25-28","sourceRefExact":"Exod.32.25-28"},{"anchorText":"35","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.32.35","rawQueryValue":"Exod.32.35","sourceRefExact":"Exod.32.35"},{"anchorText":"Dt 9:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.9.20","rawQueryValue":"Deut.9.20","sourceRefExact":"Deut.9.20"},{"anchorText":"Nm 1:1-3, 17-18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.1.1-3,17-18","rawQueryValue":"Num.1.1-3,17-18","sourceRefExact":"Num.1.1-3,17-18"},{"anchorText":"Nm 12:1-4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.12.1-4","rawQueryValue":"Num.12.1-4","sourceRefExact":"Num.12.1-4"},{"anchorText":"12:5-15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.12.5-15","rawQueryValue":"Num.12.5-15","sourceRefExact":"Num.12.5-15"},{"anchorText":"14:1-5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.14.1-5","rawQueryValue":"Num.14.1-5","sourceRefExact":"Num.14.1-5"},{"anchorText":"16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.16.1-50","rawQueryValue":"Num.16.1-50","sourceRefExact":"Num.16.1-50"},{"anchorText":"20:1-12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.20.1-12","rawQueryValue":"Num.20.1-12","sourceRefExact":"Num.20.1-12"},{"anchorText":"Nm 20:23-29","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.20.23-29","rawQueryValue":"Num.20.23-29","sourceRefExact":"Num.20.23-29"},{"anchorText":"33:38-39","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.33.38-39","rawQueryValue":"Num.33.38-39","sourceRefExact":"Num.33.38-39"}],"sourceItemFragmentSha256":"8b99fd736d9245dd8c2a2445040a1079ee0cd587c36e74fc7f33b3eb478cf014","sourceItemName":"Aaron","sourceItemOrder":1,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[{"name":"AaronThePriest","src":"../Textboxes/Textboxes.xml"}]},"sourceAttributes":{"name":"Aaron","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Aaron","title":"Aaron","version":"v2-a101d843a2f0cd3fc0c6"}