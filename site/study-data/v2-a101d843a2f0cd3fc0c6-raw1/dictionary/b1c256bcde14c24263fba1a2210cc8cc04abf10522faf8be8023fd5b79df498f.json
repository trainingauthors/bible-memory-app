{"content":[{"c":["MAHATH"],"sourceClass":"h1","t":"p"},{"c":["1. Levite, son of Amasai, and ancestor of Heman the temple singer in David’s time (",{"href":"?bref=1Chr.6.35","r":"1Chr.6.35","rawR":"1Chr.6.35","sourceRefs":[{"raw":"1Chr.6.35","value":"1Chr.6.35"}],"t":"ref","v":"1 Chr 6:35"},")."],"sourceClass":"list","t":"p"},{"c":["2. Levite who assisted in the cleansing of the temple during Hezekiah’s time (",{"href":"?bref=2Chr.29.12","r":"2Chr.29.12","rawR":"2Chr.29.12","sourceRefs":[{"raw":"2Chr.29.12","value":"2Chr.29.12"}],"t":"ref","v":"2 Chr 29:12"},"). He was appointed an overseer of the contributions, the tithes, and the things dedicated to God (",{"href":"?bref=2Chr.31.13","r":"2Chr.31.13","rawR":"2Chr.31.13","sourceRefs":[{"raw":"2Chr.31.13","value":"2Chr.31.13"}],"t":"ref","v":"31:13"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Mahath","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 6:35","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.6.35","rawQueryValue":"1Chr.6.35","sourceRefExact":"1Chr.6.35"},{"anchorText":"2 Chr 29:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.29.12","rawQueryValue":"2Chr.29.12","sourceRefExact":"2Chr.29.12"},{"anchorText":"31:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.31.13","rawQueryValue":"2Chr.31.13","sourceRefExact":"2Chr.31.13"}],"sourceItemFragmentSha256":"1c06295ad3d2eb563df41634079d70089e98c7172f9f4b11d8513587e454c042","sourceItemName":"Mahath","sourceItemOrder":64,"sourceMember":"Articles/M.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Mahath","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Mahath","title":"Mahath","version":"v2-a101d843a2f0cd3fc0c6"}