{"content":[{"c":["DIMONAH"],"sourceClass":"h1","t":"p"},{"c":["Town mentioned in ",{"href":"?bref=Josh.15.22","r":"Josh.15.22","rawR":"Josh.15.22","sourceRefs":[{"raw":"Josh.15.22","value":"Josh.15.22"}],"t":"ref","v":"Joshua 15:22"}," as being located in the Judean Negev, close to Edomite territory. It was one of 29 towns in the general area of Beersheba; some scholars have identified it with the Dibon mentioned in ",{"href":"?bref=Neh.11.25","r":"Neh.11.25","rawR":"Neh.11.25","sourceRefs":[{"raw":"Neh.11.25","value":"Neh.11.25"}],"t":"ref","v":"Nehemiah 11:25"},"."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Dimonah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Joshua 15:22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.22","rawQueryValue":"Josh.15.22","sourceRefExact":"Josh.15.22"},{"anchorText":"Nehemiah 11:25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.11.25","rawQueryValue":"Neh.11.25","sourceRefExact":"Neh.11.25"}],"sourceItemFragmentSha256":"e8b28bd9a7152e20cedf267e104cfcab764055cc9d7abc1badb3f2442047672a","sourceItemName":"Dimonah","sourceItemOrder":116,"sourceMember":"Articles/D.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Dimonah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Dimonah","title":"Dimonah","version":"v2-a101d843a2f0cd3fc0c6"}