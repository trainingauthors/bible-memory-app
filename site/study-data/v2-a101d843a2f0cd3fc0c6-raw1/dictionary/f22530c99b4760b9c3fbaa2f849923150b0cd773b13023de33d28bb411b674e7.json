{"content":[{"c":["GIZON, GIZONITE*"],"sourceClass":"h1","t":"p"},{"c":["Designation for Hashem (Jashen, ",{"c":["nlt"],"sourceClass":"sc","t":"span"},"), one of David’s mighty men (",{"href":"?bref=1Chr.11.34","r":"1Chr.11.34","rawR":"1Chr.11.34","sourceRefs":[{"raw":"1Chr.11.34","value":"1Chr.11.34"}],"t":"ref","v":"1 Chr 11:34"},"). Gizon may have been an ancient Canaanite settlement. Some scholars have emended the text to read “Gunite” (cf. ",{"href":"?bref=1Chr.5.15","r":"1Chr.5.15","rawR":"1Chr.5.15","sourceRefs":[{"raw":"1Chr.5.15","value":"1Chr.5.15"}],"t":"ref","v":"1 Chr 5:15"},"; ",{"href":"?bref=1Chr.7.13","r":"1Chr.7.13","rawR":"1Chr.7.13","sourceRefs":[{"raw":"1Chr.7.13","value":"1Chr.7.13"}],"t":"ref","v":"7:13"},") or “from Gimzo” (cf. ",{"href":"?bref=2Chr.28.18","r":"2Chr.28.18","rawR":"2Chr.28.18","sourceRefs":[{"raw":"2Chr.28.18","value":"2Chr.28.18"}],"t":"ref","v":"2 Chr 28:18"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"GizonGizonite","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 11:34","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.11.34","rawQueryValue":"1Chr.11.34","sourceRefExact":"1Chr.11.34"},{"anchorText":"1 Chr 5:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.5.15","rawQueryValue":"1Chr.5.15","sourceRefExact":"1Chr.5.15"},{"anchorText":"7:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.7.13","rawQueryValue":"1Chr.7.13","sourceRefExact":"1Chr.7.13"},{"anchorText":"2 Chr 28:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.28.18","rawQueryValue":"2Chr.28.18","sourceRefExact":"2Chr.28.18"}],"sourceItemFragmentSha256":"baf50c5d1c8771c24ab5042fa994a7c4b737606b4d6f867fb492f9ea3f1e6a1c","sourceItemName":"GizonGizonite","sourceItemO