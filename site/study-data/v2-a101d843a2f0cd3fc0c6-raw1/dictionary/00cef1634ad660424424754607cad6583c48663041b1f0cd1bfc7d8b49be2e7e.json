{"content":[{"c":["MASON, MASONRY"],"sourceClass":"h1","t":"p"},{"c":["Worker in and craft of brick and stonework. The mason prepared stone from the quarry for use in building. In Israel’s early days masons were brought from Phoenicia (",{"href":"?bref=2Sam.5.11","r":"2Sam.5.11","rawR":"2Sam.5.11","sourceRefs":[{"raw":"2Sam.5.11","value":"2Sam.5.11"}],"t":"ref","v":"2 Sm 5:11"},"; ",{"href":"?bref=1Kgs.5.17-18","r":"1Kgs.5.17-18","rawR":"1Kgs.5.17-18","sourceRefs":[{"raw":"1Kgs.5.17-18","value":"1Kgs.5.17-18"}],"t":"ref","v":"1 Kgs 5:17-18"},"; ",{"href":"?bref=1Chr.14.1","r":"1Chr.14.1","rawR":"1Chr.14.1","sourceRefs":[{"raw":"1Chr.14.1","value":"1Chr.14.1"}],"t":"ref","v":"1 Chr 14:1"},"), but later Israelite masons did their own work (",{"href":"?bref=2Kgs.12.12","r":"2Kgs.12.12","rawR":"2Kgs.12.12","sourceRefs":[{"raw":"2Kgs.12.12","value":"2Kgs.12.12"}],"t":"ref","v":"2 Kgs 12:12"},"; ",{"href":"?bref=2Kgs.22.6","r":"2Kgs.22.6","rawR":"2Kgs.22.6","sourceRefs":[{"raw":"2Kgs.22.6","value":"2Kgs.22.6"}],"t":"ref","v":"22:6"},"; ",{"href":"?bref=2Chr.24.12","r":"2Chr.24.12","rawR":"2Chr.24.12","sourceRefs":[{"raw":"2Chr.24.12","value":"2Chr.24.12"}],"t":"ref","v":"2 Chr 24:12"},"; ",{"href":"?bref=Ezra.3.7","r":"Ezra.3.7","rawR":"Ezra.3.7","sourceRefs":[{"raw":"Ezra.3.7","value":"Ezra.3.7"}],"t":"ref","v":"Ezr 3:7"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"MasonMasonry","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Sm 5:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.5.11","rawQueryValue":"2Sam.5.11","sourceRefExact":"2Sam.5.11"},{"anchorText":"1 Kgs 5:17-18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.5.17-18","rawQueryValue":"1Kgs.5.17-18","sourceRefExact":"1Kgs.5.17-18"},{"anchorText":"1 Chr 14:1","canonicalization":"deferred_to_dict