{"content":[{"c":["ATTAI"],"sourceClass":"h1","t":"p"},{"c":["1. Son of Sheshan’s daughter and of Jarha, Sheshan’s Egyptian slave. Attai was from Judah’s tribe (",{"href":"?bref=1Chr.2.35-36","r":"1Chr.2.35-36","rawR":"1Chr.2.35-36","sourceRefs":[{"raw":"1Chr.2.35-36","value":"1Chr.2.35-36"}],"t":"ref","v":"1 Chr 2:35-36"},")."],"sourceClass":"list","t":"p"},{"c":["2. Warrior from Gad’s tribe who joined David at Ziklag in his struggle against King Saul (",{"href":"?bref=1Chr.12.11","r":"1Chr.12.11","rawR":"1Chr.12.11","sourceRefs":[{"raw":"1Chr.12.11","value":"1Chr.12.11"}],"t":"ref","v":"1 Chr 12:11"},")."],"sourceClass":"list","t":"p"},{"c":["3. Son of King Rehoboam of Judah by Maachah, and Solomon’s grandson (",{"href":"?bref=2Chr.11.20","r":"2Chr.11.20","rawR":"2Chr.11.20","sourceRefs":[{"raw":"2Chr.11.20","value":"2Chr.11.20"}],"t":"ref","v":"2 Chr 11:20"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Attai","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 2:35-36","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.2.35-36","rawQueryValue":"1Chr.2.35-36","sourceRefExact":"1Chr.2.35-36"},{"anchorText":"1 Chr 12:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.12.11","rawQueryValue":"1Chr.12.11","sourceRefExact":"1Chr.12.11"},{"anchorText":"2 Chr 11:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.11.20","rawQueryValue":"2Chr.11.20","sourceRefExact":"2Chr.11.20"}],"sourceItemFragmentSha256":"d499f1db9d9aa6183e8ad70267f6c893a1f0ab1ab9888350476e637afbe1caef","sourceItemName":"Attai","sourceItemOrder":610,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Attai","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Attai","tit