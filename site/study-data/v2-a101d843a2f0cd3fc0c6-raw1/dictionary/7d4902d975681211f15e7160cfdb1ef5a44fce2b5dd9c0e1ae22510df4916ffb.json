{"content":[{"c":["ZEPHATH"],"sourceClass":"h1","t":"p"},{"c":["Canaanite city conquered by Judah and Simeon and subsequently renamed Hormah (",{"href":"?bref=Judg.1.17","r":"Judg.1.17","rawR":"Judg.1.17","sourceRefs":[{"raw":"Judg.1.17","value":"Judg.1.17"}],"t":"ref","v":"Jgs 1:17"},"). Zephath (Hormah) was the site of Israel’s first abortive attempt to enter Canaan when they violated Moses’ command and were, as a result, defeated by the Amalekites and the Canaanites (",{"href":"?bref=Num.14.45","r":"Num.14.45","rawR":"Num.14.45","sourceRefs":[{"raw":"Num.14.45","value":"Num.14.45"}],"t":"ref","v":"Nm 14:45"},")."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Hormah_Article_TyndaleOpenBibleDictionary","id":"Hormah_Article_TyndaleOpenBibleDictionary","rawId":"Hormah_Article_TyndaleOpenBibleDictionary","t":"link","v":"Hormah"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Zephath","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jgs 1:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.1.17","rawQueryValue":"Judg.1.17","sourceRefExact":"Judg.1.17"},{"anchorText":"Nm 14:45","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.14.45","rawQueryValue":"Num.14.45","sourceRefExact":"Num.14.45"}],"sourceItemFragmentSha256":"302e8f16b2542d04b4de482cb11f83dcc8daa8ac93e01d9e10ad2a116eb0bf08","sourceItemName":"Zephath","sourceItemOrder":77,"sourceMember":"Articles/Z.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Zephath","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Zephath","title":"Zephath","version":"v2-a101d843a2f0cd3fc0c6"}