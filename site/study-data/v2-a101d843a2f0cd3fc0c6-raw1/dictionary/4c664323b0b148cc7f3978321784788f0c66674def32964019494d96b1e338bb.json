{"content":[{"c":["BETH-HARAM, BETH-HARAN"],"sourceClass":"h1","t":"p"},{"c":["Town given to Gad’s tribe at the partitioning of Canaan (",{"href":"?bref=Josh.13.27","r":"Josh.13.27","rawR":"Josh.13.27","sourceRefs":[{"raw":"Josh.13.27","value":"Josh.13.27"}],"t":"ref","v":"Jos 13:27"},"). Fortified and used to accommodate sheep herds (",{"href":"?bref=Num.32.36","r":"Num.32.36","rawR":"Num.32.36","sourceRefs":[{"raw":"Num.32.36","value":"Num.32.36"}],"t":"ref","v":"Nm 32:36"},"), it is probably the same as Beth-aramphtha, a city mentioned by the Jewish historian Josephus."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"BethHaramBethHaran","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 13:27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.13.27","rawQueryValue":"Josh.13.27","sourceRefExact":"Josh.13.27"},{"anchorText":"Nm 32:36","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.32.36","rawQueryValue":"Num.32.36","sourceRefExact":"Num.32.36"}],"sourceItemFragmentSha256":"b3f1bde979e8bf0d90d784a797cb074b158dc785386144733c50cc5ecdf32615","sourceItemName":"BethHaramBethHaran","sourceItemOrder":254,"sourceMember":"Articles/B.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"BethHaramBethHaran","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Beth-Haram, Beth-Haran","title":"Beth-Haram, Beth-Haran","version":"v2-a101d843a2f0cd3fc0c6"}