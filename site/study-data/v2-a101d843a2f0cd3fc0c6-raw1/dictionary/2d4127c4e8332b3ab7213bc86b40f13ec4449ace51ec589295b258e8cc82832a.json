{"content":[{"c":["CANDACE*"],"sourceClass":"h1","t":"p"},{"c":["Title given to ancient Ethiopian queens. Philip, a leader in the early church, met and baptized an Ethiopian eunuch, who was a minister under Candace, queen of the Ethiopians (",{"href":"?bref=Acts.8.27","r":"Acts.8.27","rawR":"Acts.8.27","sourceRefs":[{"raw":"Acts.8.27","value":"Acts.8.27"}],"t":"ref","v":"Acts 8:27"},"). That Candace, whose name was probably Amanitere, ruled over Nubia (modern Sudan) from ",{"c":["AD"],"sourceClass":"era","t":"span"}," 25 to 41."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Candace","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Acts 8:27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.8.27","rawQueryValue":"Acts.8.27","sourceRefExact":"Acts.8.27"}],"sourceItemFragmentSha256":"06d97ddd758f2a06bd8361fa3227cebc165363be6b500741dd2f8ad43e3dacdc","sourceItemName":"Candace","sourceItemOrder":34,"sourceMember":"Articles/C.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Candace","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Candace*","title":"Candace*","version":"v2-a101d843a2f0cd3fc0c6"}