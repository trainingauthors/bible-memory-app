{"content":[{"c":["ZEBEDEE"],"sourceClass":"h1","t":"p"},{"c":["Father of the disciples James and John (",{"href":"?bref=Matt.26.37","r":"Matt.26.37","rawR":"Matt.26.37","sourceRefs":[{"raw":"Matt.26.37","value":"Matt.26.37"}],"t":"ref","v":"Mt 26:37"},"; ",{"href":"?bref=Mark.3.17","r":"Mark.3.17","rawR":"Mark.3.17","sourceRefs":[{"raw":"Mark.3.17","value":"Mark.3.17"}],"t":"ref","v":"Mk 3:17"},"; ",{"href":"?bref=Mark.10.35","r":"Mark.10.35","rawR":"Mark.10.35","sourceRefs":[{"raw":"Mark.10.35","value":"Mark.10.35"}],"t":"ref","v":"10:35"},"). Zebedee was in the fishing business and may have been wealthy, considering that he had servants and apparent connections with the high priest (",{"href":"?bref=John.18.15","r":"John.18.15","rawR":"John.18.15","sourceRefs":[{"raw":"John.18.15","value":"John.18.15"}],"t":"ref","v":"Jn 18:15"},"). Although he personally appears only once in the narrative (",{"href":"?bref=Matt.4.21","r":"Matt.4.21","rawR":"Matt.4.21","sourceRefs":[{"raw":"Matt.4.21","value":"Matt.4.21"}],"t":"ref","v":"Mt 4:21"},"; ",{"href":"?bref=Mark.1.19-20","r":"Mark.1.19-20","rawR":"Mark.1.19-20","sourceRefs":[{"raw":"Mark.1.19-20","value":"Mark.1.19-20"}],"t":"ref","v":"Mk 1:19-20"},"), his wife, Salome, appears frequently as one of the pious women who followed Christ."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Zebedee","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Mt 26:37","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.26.37","rawQueryValue":"Matt.26.37","sourceRefExact":"Matt.26.37"},{"anchorText":"Mk 3:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mark.3.17","rawQueryValue":"Mark.3.17","sourceRefExact":"Mark.3.17"},{"anchorText":"10:35","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mark.10.35","rawQueryValue":"Mark.10.35","sourceRefExact":"Mark.10.35"},{"anchorText":"Jn 18:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=John.18.15","rawQueryValue":"John.18.15","sourceRefExact":"John.18.15"},{"anchorText":"Mt 4:21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.4.21","rawQueryValue":"Matt.4.21","sourceRefExact":"Matt.4.21"},{"anchorText":"Mk 1:19-20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mark.1.19-20","rawQueryValue":"Mark.1.19-20","sourceRefExact":"Mark.1.19-20"}],"sourceItemFragmentSha256":"3326040daa92edda167e6147bf9ad4fa7f021d80c0b45fa501bcc5deb376510b","sourceItemName":"Zebedee","sourceItemOrder":49,"sourceMember":"Articles/Z.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Zebedee","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Zebedee","title":"Zebedee","version":"v2-a101d843a2f0cd3fc0c6"}