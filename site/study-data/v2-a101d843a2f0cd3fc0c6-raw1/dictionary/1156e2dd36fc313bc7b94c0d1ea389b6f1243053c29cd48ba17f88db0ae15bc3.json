{"content":[{"c":["RIPHATH"],"sourceClass":"h1","t":"p"},{"c":["Gomer’s son and the brother of Ashkenaz and Togarmah, non-Semitic descendants of Noah through Japheth’s line (",{"href":"?bref=Gen.10.3","r":"Gen.10.3","rawR":"Gen.10.3","sourceRefs":[{"raw":"Gen.10.3","value":"Gen.10.3"}],"t":"ref","v":"Gn 10:3"},"). ",{"href":"?bref=1Chr.1.6","r":"1Chr.1.6","rawR":"1Chr.1.6","sourceRefs":[{"raw":"1Chr.1.6","value":"1Chr.1.6"}],"t":"ref","v":"First Chronicles 1:6"},", a parallel passage, reads Diphath instead of Riphath, undoubtedly a latter copyist’s misspelling that was never corrected."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Riphath","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 10:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.10.3","rawQueryValue":"Gen.10.3","sourceRefExact":"Gen.10.3"},{"anchorText":"First Chronicles 1:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.1.6","rawQueryValue":"1Chr.1.6","sourceRefExact":"1Chr.1.6"}],"sourceItemFragmentSha256":"2286cd2dbc8844045c107285eadba2b4f62eb265a0912787b795a49c70e153ba","sourceItemName":"Riphath","sourceItemOrder":157,"sourceMember":"Articles/R.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Riphath","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Riphath","title":"Riphath","version":"v2-a101d843a2f0cd3fc0c6"}