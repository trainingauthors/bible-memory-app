{"content":[{"c":["ANAH"],"sourceClass":"h1","t":"p"},{"c":["1. Son of Zibeon the Hivite and father of Oholibamah. Oholibamah was one of Esau’s wives (",{"href":"?bref=Gen.36.2,18","r":"Gen.36.2,18","rawR":"Gen.36.2,18","sourceRefs":[{"raw":"Gen.36.2,18","value":"Gen.36.2,18"}],"t":"ref","v":"Gn 36:2, 18"},")."],"sourceClass":"list","t":"p"},{"c":["2. Fourth son of Seir the Horite. Anah was a chief among the Horites who also had a daughter named Oholibamah (",{"href":"?bref=Gen.36.20,25","r":"Gen.36.20,25","rawR":"Gen.36.20,25","sourceRefs":[{"raw":"Gen.36.20,25","value":"Gen.36.20,25"}],"t":"ref","v":"Gn 36:20, 25"},"; ",{"href":"?bref=1Chr.1.38,41","r":"1Chr.1.38,41","rawR":"1Chr.1.38,41","sourceRefs":[{"raw":"1Chr.1.38,41","value":"1Chr.1.38,41"}],"t":"ref","v":"1 Chr 1:38, 41"},")."],"sourceClass":"list","t":"p"},{"c":["3. Son of Zibeon who found hot springs in the wasteland (",{"href":"?bref=Gen.36.24","r":"Gen.36.24","rawR":"Gen.36.24","sourceRefs":[{"raw":"Gen.36.24","value":"Gen.36.24"}],"t":"ref","v":"Gn 36:24"},"). This Zibeon was a brother to #2 above. ",{"c":["See"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Zibeon_Article_TyndaleOpenBibleDictionary","id":"Zibeon_Article_TyndaleOpenBibleDictionary","rawId":"Zibeon_Article_TyndaleOpenBibleDictionary","t":"link","v":"Zibeon"},"."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Anah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 36:2, 18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.36.2,18","rawQueryValue":"Gen.36.2,18","sourceRefExact":"Gen.36.2,18"},{"anchorText":"Gn 36:20, 25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.36.20,25","rawQueryValue":"Gen.36.20,25","sourceRefExact":"Gen.36.20,25"},{"anchorText":"1 Chr 1:38, 41","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.1.38,41","rawQueryValue":"1Chr.1.38,41","sourceRefExact":"1Chr.1.38,41"},{"anchorText":"Gn 36:24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.36.24","rawQueryValue":"Gen.36.24","sourceRefExact":"Gen.36.24"}],"sourceItemFragmentSha256":"a99c5d80c5d9cc4b35b2a6140165e4a3d172d3a36eea7a6913a7b26db10825e1","sourceItemName":"Anah","sourceItemOrder":325,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Anah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Anah","title":"Anah","version":"v2-a101d843a2f0cd3fc0c6"}