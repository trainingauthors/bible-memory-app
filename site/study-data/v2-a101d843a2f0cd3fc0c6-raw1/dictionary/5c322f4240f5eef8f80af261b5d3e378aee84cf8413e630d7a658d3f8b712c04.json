{"content":[{"c":["HUPPIM"],"sourceClass":"h1","t":"p"},{"c":["Perhaps the son of Ir (Iri) and a descendant of Benjamin through Bela’s line (",{"href":"?bref=Gen.46.21","r":"Gen.46.21","rawR":"Gen.46.21","sourceRefs":[{"raw":"Gen.46.21","value":"Gen.46.21"}],"t":"ref","v":"Gn 46:21"},"; ",{"href":"?bref=1Chr.7.12,15","r":"1Chr.7.12,15","rawR":"1Chr.7.12,15","sourceRefs":[{"raw":"1Chr.7.12,15","value":"1Chr.7.12,15"}],"t":"ref","v":"1 Chr 7:12, 15"},"). Huppim is probably an alternate spelling of Hupham, the father of the Huphamite family from Benjamin’s tribe (",{"href":"?bref=Num.26.39","r":"Num.26.39","rawR":"Num.26.39","sourceRefs":[{"raw":"Num.26.39","value":"Num.26.39"}],"t":"ref","v":"Nm 26:39"},"). His precise lineage is difficult to determine."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Huppim","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 46:21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.46.21","rawQueryValue":"Gen.46.21","sourceRefExact":"Gen.46.21"},{"anchorText":"1 Chr 7:12, 15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.7.12,15","rawQueryValue":"1Chr.7.12,15","sourceRefExact":"1Chr.7.12,15"},{"anchorText":"Nm 26:39","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.26.39","rawQueryValue":"Num.26.39","sourceRefExact":"Num.26.39"}],"sourceItemFragmentSha256":"384d278183bd549e6a1fb795a54044816176aea9f7a361a66eddb02c01489275","sourceItemName":"Huppim","sourceItemOrder":394,"sourceMember":"Articles/H.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Huppim","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Huppim","title":"Huppim","version":"v2-a101d843a2f0cd3fc0c6"}