ream","hrefExact":"?bref=1Chr.9.44","rawQueryValue":"1Chr.9.44","sourceRefExact":"1Chr.9.44"},{"anchorText":"2 Chr 19:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.19.11","rawQueryValue":"2Chr.19.11","sourceRefExact":"2Chr.19.11"},{"anchorText":"2 Chr 23:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.23.1","rawQueryValue":"2Chr.23.1","sourceRefExact":"2Chr.23.1"},{"anchorText":"Ezr 10:22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.10.22","rawQueryValue":"Ezra.10.22","sourceRefExact":"Ezra.10.22"}],"sourceItemFragmentSha256":"96c11afd58f4bc6aa1f800b41cc122d9cfee61853ae754096d7e8450e0fd6d13","sourceItemName":"Ishmael","sourceItemOrder":102,"sourceMember":"Articles/I.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Ishmael","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Ishmael","title":"Ishmael","version":"v2-a101d843a2f0cd3fc0c6"}