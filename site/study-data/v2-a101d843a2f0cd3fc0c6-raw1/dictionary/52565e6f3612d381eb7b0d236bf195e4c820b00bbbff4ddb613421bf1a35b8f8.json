{"content":[{"c":["NOADIAH"],"sourceClass":"h1","t":"p"},{"c":["1. Binnui’s son and one of the two Levites present when the temple treasure that was brought back to Jerusalem by Ezra was weighed and recorded (",{"href":"?bref=Ezra.8.33","r":"Ezra.8.33","rawR":"Ezra.8.33","sourceRefs":[{"raw":"Ezra.8.33","value":"Ezra.8.33"}],"t":"ref","v":"Ezr 8:33"},")."],"sourceClass":"list","t":"p"},{"c":["2. Prophetess who, along with Tobiah, Sanballat, and some false prophets, attempted to intimidate Nehemiah when he was engaged in rebuilding Jerusalem’s walls after the exile (",{"href":"?bref=Neh.6.14","r":"Neh.6.14","rawR":"Neh.6.14","sourceRefs":[{"raw":"Neh.6.14","value":"Neh.6.14"}],"t":"ref","v":"Neh 6:14"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Noadiah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ezr 8:33","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.8.33","rawQueryValue":"Ezra.8.33","sourceRefExact":"Ezra.8.33"},{"anchorText":"Neh 6:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.6.14","rawQueryValue":"Neh.6.14","sourceRefExact":"Neh.6.14"}],"sourceItemFragmentSha256":"1924dd329ec6f3b2b675320eac6ca56268fd99ab72e1f9faac3ca4f6675c6dad","sourceItemName":"Noadiah","sourceItemOrder":156,"sourceMember":"Articles/N.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Noadiah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Noadiah","title":"Noadiah","version":"v2-a101d843a2f0cd3fc0c6"}