{"content":[{"c":["ABARIM*"],"sourceClass":"h1","t":"p"},{"c":["Mountainous area located east of the Jordan River and the Dead Sea, and extending northward from the plains of Moab. From the highest point on Mt Nebo, called Pisgah, located in Abarim (2,643 feet; 805 meters), Moses looked into the Promised Land shortly before he died (",{"href":"?bref=Deut.32.48-50","r":"Deut.32.48-50","rawR":"Deut.32.48-50","sourceRefs":[{"raw":"Deut.32.48-50","value":"Deut.32.48-50"}],"t":"ref","v":"Dt 32:48-50"},"; ",{"href":"?bref=Deut.34.1-6","r":"Deut.34.1-6","rawR":"Deut.34.1-6","sourceRefs":[{"raw":"Deut.34.1-6","value":"Deut.34.1-6"}],"t":"ref","v":"34:1-6"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Abarim","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Dt 32:48-50","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.32.48-50","rawQueryValue":"Deut.32.48-50","sourceRefExact":"Deut.32.48-50"},{"anchorText":"34:1-6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.34.1-6","rawQueryValue":"Deut.34.1-6","sourceRefExact":"Deut.34.1-6"}],"sourceItemFragmentSha256":"23db5d8cd79af7662891c30b910b34c3706f58b12ffa477650bc76daed5fefbc","sourceItemName":"Abarim","sourceItemOrder":8,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Abarim","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Abarim*","title":"Abarim*","version":"v2-a101d843a2f0cd3fc0c6"}