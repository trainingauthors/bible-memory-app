{"content":[{"c":["HAKKOZ"],"sourceClass":"h1","t":"p"},{"c":["Name borne by a priestly family during the monarchy (",{"href":"?bref=1Chr.24.10","r":"1Chr.24.10","rawR":"1Chr.24.10","sourceRefs":[{"raw":"1Chr.24.10","value":"1Chr.24.10"}],"t":"ref","v":"1 Chr 24:10"},"). In Ezra’s time, the family pedigree could not be documented properly; consequently, the privilege of priestly service was withdrawn (",{"href":"?bref=Ezra.2.61","r":"Ezra.2.61","rawR":"Ezra.2.61","sourceRefs":[{"raw":"Ezra.2.61","value":"Ezra.2.61"}],"t":"ref","v":"Ezr 2:61"},"; ",{"href":"?bref=Neh.3.4,21","r":"Neh.3.4,21","rawR":"Neh.3.4,21","sourceRefs":[{"raw":"Neh.3.4,21","value":"Neh.3.4,21"}],"t":"ref","v":"Neh 3:4, 21"},"; ",{"href":"?bref=Neh.7.63","r":"Neh.7.63","rawR":"Neh.7.63","sourceRefs":[{"raw":"Neh.7.63","value":"Neh.7.63"}],"t":"ref","v":"7:63"},"; ",{"c":["kjv"],"sourceClass":"sc","t":"span"}," “Koz”)."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Hakkoz","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 24:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.24.10","rawQueryValue":"1Chr.24.10","sourceRefExact":"1Chr.24.10"},{"anchorText":"Ezr 2:61","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.2.61","rawQueryValue":"Ezra.2.61","sourceRefExact":"Ezra.2.61"},{"anchorText":"Neh 3:4, 21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.3.4,21","rawQueryValue":"Neh.3.4,21","sourceRefExact":"Neh.3.4,21"},{"anchorText":"7:63","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.7.63","rawQueryValue":"Neh.7.63","sourceRefExact":"Neh.7.63"}],"sourceItemFragmentSha256":"e850fccafceadb2f45b12cf0633455838b99ab165fe7472924b7f6cbbe966e8b","sourceItemName":"Hakkoz","sourceItemOrder":47,"sourceMember":"Articles/H.