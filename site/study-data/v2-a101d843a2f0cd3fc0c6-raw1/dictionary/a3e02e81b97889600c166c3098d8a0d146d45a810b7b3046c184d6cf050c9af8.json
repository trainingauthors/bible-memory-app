{"content":[{"c":["SHEMIRAMOTH"],"sourceClass":"h1","t":"p"},{"c":["1. One of the Levites whom David commanded to play the harp when the ark of God was brought from the house of Obed-edom to Jerusalem (",{"href":"?bref=1Chr.15.18-22","r":"1Chr.15.18-22","rawR":"1Chr.15.18-22","sourceRefs":[{"raw":"1Chr.15.18-22","value":"1Chr.15.18-22"}],"t":"ref","v":"1 Chr 15:18-22"},"), and who retained a permanent position under Asaph as one of the ministers of the ark (",{"href":"?bref=1Chr.16.4-5","r":"1Chr.16.4-5","rawR":"1Chr.16.4-5","sourceRefs":[{"raw":"1Chr.16.4-5","value":"1Chr.16.4-5"}],"t":"ref","v":"16:4-5"},")."],"sourceClass":"list","t":"p"},{"c":["2. Levite commissioned by Jehoshaphat to teach the law “through all the cities of Judah” (",{"href":"?bref=2Chr.17.8","r":"2Chr.17.8","rawR":"2Chr.17.8","sourceRefs":[{"raw":"2Chr.17.8","value":"2Chr.17.8"}],"t":"ref","v":"2 Chr 17:8"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Shemiramoth","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 15:18-22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.15.18-22","rawQueryValue":"1Chr.15.18-22","sourceRefExact":"1Chr.15.18-22"},{"anchorText":"16:4-5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.16.4-5","rawQueryValue":"1Chr.16.4-5","sourceRefExact":"1Chr.16.4-5"},{"anchorText":"2 Chr 17:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.17.8","rawQueryValue":"2Chr.17.8","sourceRefExact":"2Chr.17.8"}],"sourceItemFragmentSha256":"d8d520c9fd80dd4f6872123452e89600938f9af3811132769dc834ad99338d04","sourceItemName":"Shemiramoth","sourceItemOrder":280,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Shemiramoth","product":"TyndaleOpenBibleDictionary","typename":"Articl