.2","sourceRefExact":"Ps.133.2"},{"anchorText":"Lk 7:37-40","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.7.37-40","rawQueryValue":"Luke.7.37-40","sourceRefExact":"Luke.7.37-40"},{"anchorText":"Mk 14:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mark.14.3","rawQueryValue":"Mark.14.3","sourceRefExact":"Mark.14.3"},{"anchorText":"Acts 9:37","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.9.37","rawQueryValue":"Acts.9.37","sourceRefExact":"Acts.9.37"},{"anchorText":"Mk 16:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mark.16.1","rawQueryValue":"Mark.16.1","sourceRefExact":"Mark.16.1"},{"anchorText":"Lk 23:56","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.23.56","rawQueryValue":"Luke.23.56","sourceRefExact":"Luke.23.56"},{"anchorText":"Jn 19:40","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=John.19.40","rawQueryValue":"John.19.40","sourceRefExact":"John.19.40"},{"anchorText":"Lk 10:34","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.10.34","rawQueryValue":"Luke.10.34","sourceRefExact":"Luke.10.34"},{"anchorText":"Jer 8:22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.8.22","rawQueryValue":"Jer.8.22","sourceRefExact":"Jer.8.22"},{"anchorText":"Gn 37:25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.37.25","rawQueryValue":"Gen.37.25","sourceRefExact":"Gen.37.25"},{"anchorText":"Ez 27:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.27.17","rawQueryValue":"Ezek.27.17","sourceRefExact":"Ezek.27.17"},{"anchorText":"Rv 3:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.3.18","rawQueryValue":"Rev.3.18","sourceRefExact":"Rev.3.18"},{"anchorText":"18:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.18.13","rawQueryValue":"Rev.18.13","sourceRefExact":"Rev.18.13"},{"anchorText":"Ps 45:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ps.45.7","rawQueryValue":"Ps.45.7","sourceRefExact":"Ps.45.7"},{"anchorText":"Is 61:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.61.3","rawQueryValue":"Isa.61.3","sourceRefExact":"Isa.61.3"},{"anchorText":"2 Sm 14:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.14.2","rawQueryValue":"2Sam.14.2","sourceRefExact":"2Sam.14.2"},{"anchorText":"Mi 6:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mic.6.15","rawQueryValue":"Mic.6.15","sourceRefExact":"Mic.6.15"},{"anchorText":"2 Sm 1:21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.1.21","rawQueryValue":"2Sam.1.21","sourceRefExact":"2Sam.1.21"}],"sourceItemFragmentSha256":"6c171110ba8a8b299fbac5d1118876d649d077346434361078f7cd695f22222b","sourceItemName":"Ointment","sourceItemOrder":33,"sourceMember":"Articles/O.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Ointment","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Ointment","title":"Ointment","version":"v2-a101d843a2f0cd3fc0c6"}