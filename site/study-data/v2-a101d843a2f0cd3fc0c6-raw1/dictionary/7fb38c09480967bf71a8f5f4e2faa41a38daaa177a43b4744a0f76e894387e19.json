{"content":[{"c":["ABADDON"],"sourceClass":"h1","t":"p"},{"c":["Hebrew word that means “place of destruction.” The word occurs six times in the OT, generally referring to the place of the dead (",{"href":"?bref=Job.26.6","r":"Job.26.6","rawR":"Job.26.6","sourceRefs":[{"raw":"Job.26.6","value":"Job.26.6"}],"t":"ref","v":"Jb 26:6"},"; ",{"href":"?bref=Job.28.22","r":"Job.28.22","rawR":"Job.28.22","sourceRefs":[{"raw":"Job.28.22","value":"Job.28.22"}],"t":"ref","v":"28:22"},"; ",{"href":"?bref=Job.31.12","r":"Job.31.12","rawR":"Job.31.12","sourceRefs":[{"raw":"Job.31.12","value":"Job.31.12"}],"t":"ref","v":"31:12"},"; ",{"href":"?bref=Ps.88.11","r":"Ps.88.11","rawR":"Ps.88.11","sourceRefs":[{"raw":"Ps.88.11","value":"Ps.88.11"}],"t":"ref","v":"Ps 88:11"},"; ",{"href":"?bref=Pr.15.11","r":"Pr.15.11","rawR":"Pr.15.11","sourceRefs":[{"raw":"Pr.15.11","value":"Pr.15.11"}],"t":"ref","v":"Prv 15:11"},"; ",{"href":"?bref=Pr.27.20","r":"Pr.27.20","rawR":"Pr.27.20","sourceRefs":[{"raw":"Pr.27.20","value":"Pr.27.20"}],"t":"ref","v":"27:20"},"). It serves as a synonym for Sheol and is variously translated “hell,” “death,” “the grave,” or “destruction.” The same Hebrew word occurs once in the NT in its Greek equivalent, Apollyon (",{"href":"?bref=Rev.9.11","r":"Rev.9.11","rawR":"Rev.9.11","sourceRefs":[{"raw":"Rev.9.11","value":"Rev.9.11"}],"t":"ref","v":"Rv 9:11"},"). Here the idea of destruction is personified as the “angel from the bottomless pit,” so the word is often translated “destroyer.” Abaddon (or Apollyon) was the angel reigning over the realm of the dead, who appeared after the fifth trumpet in John’s vision (",{"href":"?bref=Rev.9.1","r":"Rev.9.1","rawR":"Rev.9.1","sourceRefs":[{"raw":"Rev.9.1","value":"Rev.9.1"}],"t":"ref","v":"Rv 9:1"},")."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Sheol_Article_TyndaleOpenBibleDictionary","id":"Sheol_Article_TyndaleOpenBibleDictionary","rawId":"Sheol_Article_TyndaleOpenBibleDictionary","t":"link","v":"Sheol"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Abaddon","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jb 26:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Job.26.6","rawQueryValue":"Job.26.6","sourceRefExact":"Job.26.6"},{"anchorText":"28:22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Job.28.22","rawQueryValue":"Job.28.22","sourceRefExact":"Job.28.22"},{"anchorText":"31:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Job.31.12","rawQueryValue":"Job.31.12","sourceRefExact":"Job.31.12"},{"anchorText":"Ps 88:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ps.88.11","rawQueryValue":"Ps.88.11","sourceRefExact":"Ps.88.11"},{"anchorText":"Prv 15:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Pr.15.11","rawQueryValue":"Pr.15.11","sourceRefExact":"Pr.15.11"},{"anchorText":"27:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Pr.27.20","rawQueryValue":"Pr.27.20","sourceRefExact":"Pr.27.20"},{"anchorText":"Rv 9:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.9.11","rawQueryValue":"Rev.9.11","sourceRefExact":"Rev.9.11"},{"anchorText":"Rv 9:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.9.1","rawQueryValue":"Rev.9.1","sourceRefExact":"Rev.9.1"}],"sourceItemFragmentSha256":"4d1dce792be05bfe9ee6f093528cf9a25c54accc83c7756d6364c36c0ac6c41a","sourceItemName":"Abaddon","sourceItemOrder":5,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Abaddon","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Abaddon","title":"Abaddon","version":"v2-a101d843a2f0cd3fc0c6"}