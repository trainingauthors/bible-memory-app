{"content":[{"c":["GEHAZI"],"sourceClass":"h1","t":"p"},{"c":["Servant of Elisha (",{"href":"?bref=2Kgs.5.25","r":"2Kgs.5.25","rawR":"2Kgs.5.25","sourceRefs":[{"raw":"2Kgs.5.25","value":"2Kgs.5.25"}],"t":"ref","v":"2 Kgs 5:25"},") who instructed the prophet how best to recompense the generous Shunammite woman for her kindness to him (",{"href":"?bref=2Kgs.4.11-17","r":"2Kgs.4.11-17","rawR":"2Kgs.4.11-17","sourceRefs":[{"raw":"2Kgs.4.11-17","value":"2Kgs.4.11-17"}],"t":"ref","v":"4:11-17"},"). Gehazi took Elisha’s staff to use in reviving the woman’s dead son, but he was unsuccessful (v ",{"href":"?bref=2Kgs.4.31","r":"2Kgs.4.31","rawR":"2Kgs.4.31","sourceRefs":[{"raw":"2Kgs.4.31","value":"2Kgs.4.31"}],"t":"ref","v":"31"},"), and the prophet himself had to revive the child (vv ",{"href":"?bref=2Kgs.4.32-37","r":"2Kgs.4.32-37","rawR":"2Kgs.4.32-37","sourceRefs":[{"raw":"2Kgs.4.32-37","value":"2Kgs.4.32-37"}],"t":"ref","v":"32-37"},"). His greed in securing from Naaman presents declined by Elisha resulted in his contracting Naaman’s leprosy (",{"href":"?bref=2Kgs.5.20-23,27","r":"2Kgs.5.20-23,27","rawR":"2Kgs.5.20-23,27","sourceRefs":[{"raw":"2Kgs.5.20-23,27","value":"2Kgs.5.20-23,27"}],"t":"ref","v":"5:20-23, 27"},"). In ",{"href":"?bref=2Kgs.8.1-6","r":"2Kgs.8.1-6","rawR":"2Kgs.8.1-6","sourceRefs":[{"raw":"2Kgs.8.1-6","value":"2Kgs.8.1-6"}],"t":"ref","v":"2 Kings 8:1-6"}," Gehazi again encountered the Shunammite woman as she was petitioning the king of Israel."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Gehazi","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Kgs 5:25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.5.25","rawQueryValue":"2Kgs.5.25","sourceRefExact":"2Kgs.5.25"},{"anchorText":"4:11-17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.4.11-17","rawQueryValue":"2Kgs.4.11-17","sourceRefExact":"2Kgs.4.11-17"},{"anchorText":"31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.4.31","rawQueryValue":"2Kgs.4.31","sourceRefExact":"2Kgs.4.31"},{"anchorText":"32-37","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.4.32-37","rawQueryValue":"2Kgs.4.32-37","sourceRefExact":"2Kgs.4.32-37"},{"anchorText":"5:20-23, 27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.5.20-23,27","rawQueryValue":"2Kgs.5.20-23,27","sourceRefExact":"2Kgs.5.20-23,27"},{"anchorText":"2 Kings 8:1-6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.8.1-6","rawQueryValue":"2Kgs.8.1-6","sourceRefExact":"2Kgs.8.1-6"}],"sourceItemFragmentSha256":"ccf324e9ca8034c4d334a098d8fc6a2a3fcb86b319b185c56386fb7bb3339d41","sourceItemName":"Gehazi","sourceItemOrder":80,"sourceMember":"Articles/G.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Gehazi","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Gehazi","title":"Gehazi","version":"v2-a101d843a2f0cd3fc0c6"}