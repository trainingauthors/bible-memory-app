{"content":[{"c":["TIKVAH"],"sourceClass":"h1","t":"p"},{"c":["1. Harhas’s son, father of Shallum, and the father-in-law of Huldah the prophetess (",{"href":"?bref=2Kgs.22.14","r":"2Kgs.22.14","rawR":"2Kgs.22.14","sourceRefs":[{"raw":"2Kgs.22.14","value":"2Kgs.22.14"}],"t":"ref","v":"2 Kgs 22:14"},"); alternately called Tokhath (",{"c":["kjv"],"sourceClass":"sc","t":"span"}," “Tikvath”) in ",{"href":"?bref=2Chr.34.22","r":"2Chr.34.22","rawR":"2Chr.34.22","sourceRefs":[{"raw":"2Chr.34.22","value":"2Chr.34.22"}],"t":"ref","v":"2 Chronicles 34:22"},"."],"sourceClass":"list","t":"p"},{"c":["2. Father of Jahzeiah, who was one of the four individuals on record who opposed Ezra’s command to divorce foreign wives (",{"href":"?bref=Ezra.10.15","r":"Ezra.10.15","rawR":"Ezra.10.15","sourceRefs":[{"raw":"Ezra.10.15","value":"Ezra.10.15"}],"t":"ref","v":"Ezr 10:15"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Tikvah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Kgs 22:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.22.14","rawQueryValue":"2Kgs.22.14","sourceRefExact":"2Kgs.22.14"},{"anchorText":"2 Chronicles 34:22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.34.22","rawQueryValue":"2Chr.34.22","sourceRefExact":"2Chr.34.22"},{"anchorText":"Ezr 10:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.10.15","rawQueryValue":"Ezra.10.15","sourceRefExact":"Ezra.10.15"}],"sourceItemFragmentSha256":"f42c2990e5d52808d2c0c7aa339495e35cc888dfb03e80a0536fc023ed73cfe8","sourceItemName":"Tikvah","sourceItemOrder":152,"sourceMember":"Articles/T.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Tikvah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Tikvah","title":"Ti