{"content":[{"c":["ARNON"],"sourceClass":"h1","t":"p"},{"c":["River of Transjordan, the present Wadi el-Mojib, running from east to west through a canyon with walls 1,500 feet (457 meters) high into the Dead Sea. At the time of the Israelite conquest of Canaan, the gorge served as a natural border between Moab to the south and the Ammonite kingdoms to the north (",{"href":"?bref=Num.21.13-15","r":"Num.21.13-15","rawR":"Num.21.13-15","sourceRefs":[{"raw":"Num.21.13-15","value":"Num.21.13-15"}],"t":"ref","v":"Nm 21:13-15"},"). After the division of the land under Joshua the river Arnon became the southern boundary of Reuben’s territory (",{"href":"?bref=Deut.3.12,16","r":"Deut.3.12,16","rawR":"Deut.3.12,16","sourceRefs":[{"raw":"Deut.3.12,16","value":"Deut.3.12,16"}],"t":"ref","v":"Dt 3:12, 16"},"; ",{"href":"?bref=Josh.13.16","r":"Josh.13.16","rawR":"Josh.13.16","sourceRefs":[{"raw":"Josh.13.16","value":"Josh.13.16"}],"t":"ref","v":"Jos 13:16"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Arnon","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Nm 21:13-15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.21.13-15","rawQueryValue":"Num.21.13-15","sourceRefExact":"Num.21.13-15"},{"anchorText":"Dt 3:12, 16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.3.12,16","rawQueryValue":"Deut.3.12,16","sourceRefExact":"Deut.3.12,16"},{"anchorText":"Jos 13:16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.13.16","rawQueryValue":"Josh.13.16","sourceRefExact":"Josh.13.16"}],"sourceItemFragmentSha256":"5ae718133e216ec803f980fb842c284ec2da3447aecbdbd871023d68444fd74f","sourceItemName":"Arnon","sourceItemOrder":497,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Arnon","product