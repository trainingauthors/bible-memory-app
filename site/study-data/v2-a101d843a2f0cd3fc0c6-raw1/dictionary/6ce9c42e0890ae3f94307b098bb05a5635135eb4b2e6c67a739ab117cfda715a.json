{"content":[{"c":["JERAH"],"sourceClass":"h1","t":"p"},{"c":["Son of Joktan and nephew of Peleg, during whose lifetime the earth was divided, probably a reference to the dispersion following Babel. Jerah is likely also the name of an Arabian tribe or district (",{"href":"?bref=Gen.10.25-26","r":"Gen.10.25-26","rawR":"Gen.10.25-26","sourceRefs":[{"raw":"Gen.10.25-26","value":"Gen.10.25-26"}],"t":"ref","v":"Gn 10:25-26"},"; ",{"href":"?bref=1Chr.1.20","r":"1Chr.1.20","rawR":"1Chr.1.20","sourceRefs":[{"raw":"1Chr.1.20","value":"1Chr.1.20"}],"t":"ref","v":"1 Chr 1:20"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Jerah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 10:25-26","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.10.25-26","rawQueryValue":"Gen.10.25-26","sourceRefExact":"Gen.10.25-26"},{"anchorText":"1 Chr 1:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.1.20","rawQueryValue":"1Chr.1.20","sourceRefExact":"1Chr.1.20"}],"sourceItemFragmentSha256":"15c7dbf899caf83bbe36faf68934e898efdd4d9915e9569ca870875446409b0d","sourceItemName":"Jerah","sourceItemOrder":179,"sourceMember":"Articles/J.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Jerah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Jerah","title":"Jerah","version":"v2-a101d843a2f0cd3fc0c6"}