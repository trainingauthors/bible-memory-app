{"content":[{"c":["ADONIRAM"],"sourceClass":"h1","t":"p"},{"c":["Important official in Israel during the reigns of David, Solomon, and Rehoboam (",{"href":"?bref=1Kgs.4.6","r":"1Kgs.4.6","rawR":"1Kgs.4.6","sourceRefs":[{"raw":"1Kgs.4.6","value":"1Kgs.4.6"}],"t":"ref","v":"1 Kgs 4:6"},"; ",{"href":"?bref=1Kgs.5.14","r":"1Kgs.5.14","rawR":"1Kgs.5.14","sourceRefs":[{"raw":"1Kgs.5.14","value":"1Kgs.5.14"}],"t":"ref","v":"5:14"},"). Adoniram is also referred to as Adoram, possibly a contraction of his name (",{"href":"?bref=2Sam.20.24","r":"2Sam.20.24","rawR":"2Sam.20.24","sourceRefs":[{"raw":"2Sam.20.24","value":"2Sam.20.24"}],"t":"ref","v":"2 Sm 20:24"},"; ",{"href":"?bref=1Kgs.12.18","r":"1Kgs.12.18","rawR":"1Kgs.12.18","sourceRefs":[{"raw":"1Kgs.12.18","value":"1Kgs.12.18"}],"t":"ref","v":"1 Kgs 12:18"},"), and as Hadoram (",{"href":"?bref=2Chr.10.18","r":"2Chr.10.18","rawR":"2Chr.10.18","sourceRefs":[{"raw":"2Chr.10.18","value":"2Chr.10.18"}],"t":"ref","v":"2 Chr 10:18"},"). While Solomon’s temple was under construction, Adoniram was overseer of a labor force of 30,000 men (",{"href":"?bref=1Kgs.5.13-14","r":"1Kgs.5.13-14","rawR":"1Kgs.5.13-14","sourceRefs":[{"raw":"1Kgs.5.13-14","value":"1Kgs.5.13-14"}],"t":"ref","v":"1 Kgs 5:13-14"},"). Evidently David had instituted a system of forced Israelite labor that Solomon continued, not only for building the temple, but for many other projects."],"sourceClass":"fl","t":"p"},{"c":["When Rehoboam became king the people asked for relief, but Rehoboam announced that instead, he would increase the labor requirements (",{"href":"?bref=1Kgs.12.1-15","r":"1Kgs.12.1-15","rawR":"1Kgs.12.1-15","sourceRefs":[{"raw":"1Kgs.12.1-15","value":"1Kgs.12.1-15"}],"t":"ref","v":"1 Kgs 12:1-15"},"). When Adoniram was sent to enforce the king’s orders, he was stoned to death by the rebellious people (",{"href":"?bref=1Kgs.12.16-19","r":"1Kgs.12.16-19","rawR":"1Kgs.12.16-19","sourceRefs":[{"raw":"1Kgs.12.16-19","value":"1Kgs.12.16-19"}],"t":"ref","v":"12:16-19"},")."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Adoniram","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Kgs 4:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.4.6","rawQueryValue":"1Kgs.4.6","sourceRefExact":"1Kgs.4.6"},{"anchorText":"5:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.5.14","rawQueryValue":"1Kgs.5.14","sourceRefExact":"1Kgs.5.14"},{"anchorText":"2 Sm 20:24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.20.24","rawQueryValue":"2Sam.20.24","sourceRefExact":"2Sam.20.24"},{"anchorText":"1 Kgs 12:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.12.18","rawQueryValue":"1Kgs.12.18","sourceRefExact":"1Kgs.12.18"},{"anchorText":"2 Chr 10:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.10.18","rawQueryValue":"2Chr.10.18","sourceRefExact":"2Chr.10.18"},{"anchorText":"1 Kgs 5:13-14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.5.13-14","rawQueryValue":"1Kgs.5.13-14","sourceRefExact":"1Kgs.5.13-14"},{"anchorText":"1 Kgs 12:1-15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.12.1-15","rawQueryValue":"1Kgs.12.1-15","sourceRefExact":"1Kgs.12.1-15"},{"anchorText":"12:16-19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.12.16-19","rawQueryValue":"1Kgs.12.16-19","sourceRefExact":"1Kgs.12.16-19"}],"sourceItemFragmentSha256":"99dc734e3313adbf2009b487cf84c39994c743de5487041b0b5b3d7a34803188","sourceItemName":"Adoniram","sourceItemOrder":133,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Adoniram","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Adoniram","title":"Adoniram","version":"v2-a101d843a2f0cd3fc0c6"}