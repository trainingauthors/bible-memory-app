{"content":[{"c":["EL-PARAN"],"sourceClass":"h1","t":"p"},{"c":["Place located on the edge of the wilderness of Paran, probably at the southern tip of the mountains of Seir in the Sinai Peninsula, present-day Arabia. It was the farthest point south to which King Kedorlaomer and his allies pushed their punitive raid against the rebellious kings of Sodom and Gomorrah (",{"href":"?bref=Gen.14.5-6","r":"Gen.14.5-6","rawR":"Gen.14.5-6","sourceRefs":[{"raw":"Gen.14.5-6","value":"Gen.14.5-6"}],"t":"ref","v":"Gn 14:5-6"},"). ",{"c":["See"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Elath_Article_TyndaleOpenBibleDictionary","id":"Elath_Article_TyndaleOpenBibleDictionary","rawId":"Elath_Article_TyndaleOpenBibleDictionary","t":"link","v":"Elath"},"."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"ElParan","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 14:5-6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.14.5-6","rawQueryValue":"Gen.14.5-6","sourceRefExact":"Gen.14.5-6"}],"sourceItemFragmentSha256":"ad23e1355ad226db4dfe7d2558d4a9dee5fe9489be809f6625aa78f851c29519","sourceItemName":"ElParan","sourceItemOrder":141,"sourceMember":"Articles/E.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"ElParan","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"El-Paran","title":"El-Paran","version":"v2-a101d843a2f0cd3fc0c6"}