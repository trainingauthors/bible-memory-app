{"content":[{"c":["ZEMARITES"],"sourceClass":"h1","t":"p"},{"c":["One of the families of the Canaanites in the ethnological lists of ",{"href":"?bref=Gen.10.1-32","r":"Gen.10.1-32","rawR":"Gen.10.1-32","sourceRefs":[{"raw":"Gen.10.1-32","value":"Gen.10.1-32"}],"t":"ref","v":"Genesis 10"}," (v ",{"href":"?bref=Gen.10.18","r":"Gen.10.18","rawR":"Gen.10.18","sourceRefs":[{"raw":"Gen.10.18","value":"Gen.10.18"}],"t":"ref","v":"18"},") and ",{"href":"?bref=1Chr.1.1-54","r":"1Chr.1.1-54","rawR":"1Chr.1.1-54","sourceRefs":[{"raw":"1Chr.1.1-54","value":"1Chr.1.1-54"}],"t":"ref","v":"1 Chronicles 1"}," (v ",{"href":"?bref=1Chr.1.16","r":"1Chr.1.16","rawR":"1Chr.1.16","sourceRefs":[{"raw":"1Chr.1.16","value":"1Chr.1.16"}],"t":"ref","v":"16"},"). The Zemarites were a Hamitic tribe mentioned in connection with the Arvadites and the Hamathites. They were probably located near the Mediterranean in the vicinity of Tripoli."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Zemarites","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Genesis 10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.10.1-32","rawQueryValue":"Gen.10.1-32","sourceRefExact":"Gen.10.1-32"},{"anchorText":"18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.10.18","rawQueryValue":"Gen.10.18","sourceRefExact":"Gen.10.18"},{"anchorText":"1 Chronicles 1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.1.1-54","rawQueryValue":"1Chr.1.1-54","sourceRefExact":"1Chr.1.1-54"},{"anchorText":"16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.1.16","rawQueryValue":"1Chr.1.16","sourceRefExact":"1Chr.1.16"}],"sourceItemFragmentSha256":"4152a09d7fefd4b19819f33d10c03c6baf67009c3ad28994592c685ef3a5db28","sourceItemName":"Zemarites","sourceItemOrder":