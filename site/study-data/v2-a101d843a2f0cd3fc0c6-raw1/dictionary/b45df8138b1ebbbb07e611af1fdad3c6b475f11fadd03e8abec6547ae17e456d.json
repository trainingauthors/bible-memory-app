,"canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.21.15-17","rawQueryValue":"Deut.21.15-17","sourceRefExact":"Deut.21.15-17"},{"anchorText":"Gn 21:9-13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.21.9-13","rawQueryValue":"Gen.21.9-13","sourceRefExact":"Gen.21.9-13"},{"anchorText":"Jgs 11:1-2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.11.1-2","rawQueryValue":"Judg.11.1-2","sourceRefExact":"Judg.11.1-2"},{"anchorText":"2 Chr 21:1-3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.21.1-3","rawQueryValue":"2Chr.21.1-3","sourceRefExact":"2Chr.21.1-3"},{"anchorText":"11:18-23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.11.18-23","rawQueryValue":"2Chr.11.18-23","sourceRefExact":"2Chr.11.18-23"},{"anchorText":"12:16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.12.16","rawQueryValue":"2Chr.12.16","sourceRefExact":"2Chr.12.16"},{"anchorText":"Heb 12:16-17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Heb.12.16-17","rawQueryValue":"Heb.12.16-17","sourceRefExact":"Heb.12.16-17"},{"anchorText":"Gn 25:19-34","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.25.19-34","rawQueryValue":"Gen.25.19-34","sourceRefExact":"Gen.25.19-34"},{"anchorText":"Gn 27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.27.1-46","rawQueryValue":"Gen.27.1-46","sourceRefExact":"Gen.27.1-46"}],"sourceItemFragmentSha256":"606087727941f9f931d980969982f0c467f375251099b287621586e5bd427090","sourceItemName":"Birthright","sourceItemOrder":327,"sourceMember":"Articles/B.xml","supplementPointersNotIncludedAsContent":[{"name":"AnEternalInheritance","src":"../Textboxes/Textboxes.xml"}]},"sourceAttributes":{"name":"Birthright","product":"TyndaleOpenBibleDicti