{"content":[{"c":["JADDUA"],"sourceClass":"h1","t":"p"},{"c":["1. Leader who set his seal on Ezra’s covenant during the postexilic era (",{"href":"?bref=Neh.10.21","r":"Neh.10.21","rawR":"Neh.10.21","sourceRefs":[{"raw":"Neh.10.21","value":"Neh.10.21"}],"t":"ref","v":"Neh 10:21"},")."],"sourceClass":"list","t":"p"},{"c":["2. Eliashib’s descendant and a contemporary of Nehemiah (",{"href":"?bref=Neh.12.11,22","r":"Neh.12.11,22","rawR":"Neh.12.11,22","sourceRefs":[{"raw":"Neh.12.11,22","value":"Neh.12.11,22"}],"t":"ref","v":"Neh 12:11, 22"},"). Jaddua’s father, Jonathan (v ",{"href":"?bref=Neh.12.11","r":"Neh.12.11","rawR":"Neh.12.11","sourceRefs":[{"raw":"Neh.12.11","value":"Neh.12.11"}],"t":"ref","v":"11"},"), is mentioned in the Elephantine papyri as Johanan (see also v ",{"href":"?bref=Neh.12.22","r":"Neh.12.22","rawR":"Neh.12.22","sourceRefs":[{"raw":"Neh.12.22","value":"Neh.12.22"}],"t":"ref","v":"22"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Jaddua","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Neh 10:21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.10.21","rawQueryValue":"Neh.10.21","sourceRefExact":"Neh.10.21"},{"anchorText":"Neh 12:11, 22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.12.11,22","rawQueryValue":"Neh.12.11,22","sourceRefExact":"Neh.12.11,22"},{"anchorText":"11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.12.11","rawQueryValue":"Neh.12.11","sourceRefExact":"Neh.12.11"},{"anchorText":"22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.12.22","rawQueryValue":"Neh.12.22","sourceRefExact":"Neh.12.22"}],"sourceItemFragmentSha256":"0163de9543a68558267c6db05ab7fe6351bef10efcbaa9e76a3a7be3d3ea7a28","sourceItemName":"Jaddua","sourceItemOrder":38,"sou