{"content":[{"c":["JAHZERAH"],"sourceClass":"h1","t":"p"},{"c":["Ancestor of a priest who returned to Judah after the Babylonian exile (",{"href":"?bref=1Chr.9.12","r":"1Chr.9.12","rawR":"1Chr.9.12","sourceRefs":[{"raw":"1Chr.9.12","value":"1Chr.9.12"}],"t":"ref","v":"1 Chr 9:12"},"). He is called Ahzai in ",{"href":"?bref=Neh.11.13","r":"Neh.11.13","rawR":"Neh.11.13","sourceRefs":[{"raw":"Neh.11.13","value":"Neh.11.13"}],"t":"ref","v":"Nehemiah 11:13"},". Little else is known about him except that he was a great-grandson of a priest named Immer who lived in Jerusalem before the exile."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Ahzai_Article_TyndaleOpenBibleDictionary","id":"Ahzai_Article_TyndaleOpenBibleDictionary","rawId":"Ahzai_Article_TyndaleOpenBibleDictionary","t":"link","v":"Ahzai"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Jahzerah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 9:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.9.12","rawQueryValue":"1Chr.9.12","sourceRefExact":"1Chr.9.12"},{"anchorText":"Nehemiah 11:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.11.13","rawQueryValue":"Neh.11.13","sourceRefExact":"Neh.11.13"}],"sourceItemFragmentSha256":"f0a35efb99a773069e76886083ceae0cd70c766783e5b32ec6acb1295a7612b8","sourceItemName":"Jahzerah","sourceItemOrder":57,"sourceMember":"Articles/J.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Jahzerah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Jahzerah","title":"Jahzerah","version":"v2-a101d843a2f0cd3fc0c6"}