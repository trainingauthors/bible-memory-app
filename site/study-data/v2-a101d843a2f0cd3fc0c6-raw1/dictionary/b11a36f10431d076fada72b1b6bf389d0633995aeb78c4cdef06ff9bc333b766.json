{"content":[{"c":["DIOSCURI*"],"sourceClass":"h1","t":"p"},{"c":["Twin sons of Zeus known as Castor and Pollux. In Greek mythology they were the patron deities of navigation and represented in the constellation Gemini. The Dioscuri (the “Twin Brothers”) were the figurehead of the Alexandrian ship on which Paul sailed to Rome (",{"href":"?bref=Acts.28.11","r":"Acts.28.11","rawR":"Acts.28.11","sourceRefs":[{"raw":"Acts.28.11","value":"Acts.28.11"}],"t":"ref","v":"Acts 28:11"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Dioscuri","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Acts 28:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.28.11","rawQueryValue":"Acts.28.11","sourceRefExact":"Acts.28.11"}],"sourceItemFragmentSha256":"aeac3d953d006ba29243bc0a3ccb9379852e45cf1d4e5097c9e0ff6741f70d71","sourceItemName":"Dioscuri","sourceItemOrder":123,"sourceMember":"Articles/D.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Dioscuri","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Dioscuri*","title":"Dioscuri*","version":"v2-a101d843a2f0cd3fc0c6"}