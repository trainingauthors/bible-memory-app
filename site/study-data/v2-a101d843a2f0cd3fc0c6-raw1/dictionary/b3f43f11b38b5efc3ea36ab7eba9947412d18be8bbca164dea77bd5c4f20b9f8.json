"hrefExact":"?bref=Jas.5.19-20","rawQueryValue":"Jas.5.19-20","sourceRefExact":"Jas.5.19-20"},{"anchorText":"Rv 2:5, 16, 22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.2.5,16,22","rawQueryValue":"Rev.2.5,16,22","sourceRefExact":"Rev.2.5,16,22"},{"anchorText":"3:19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.3.19","rawQueryValue":"Rev.3.19","sourceRefExact":"Rev.3.19"},{"anchorText":"1 Thes 1:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Thes.1.9","rawQueryValue":"1Thes.1.9","sourceRefExact":"1Thes.1.9"},{"anchorText":"Rv 9:20-21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.9.20-21","rawQueryValue":"Rev.9.20-21","sourceRefExact":"Rev.9.20-21"},{"anchorText":"16:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.16.11","rawQueryValue":"Rev.16.11","sourceRefExact":"Rev.16.11"},{"anchorText":"Acts 11:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.11.18","rawQueryValue":"Acts.11.18","sourceRefExact":"Acts.11.18"},{"anchorText":"Rom 2:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rom.2.4","rawQueryValue":"Rom.2.4","sourceRefExact":"Rom.2.4"},{"anchorText":"2 Cor 7:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Cor.7.10","rawQueryValue":"2Cor.7.10","sourceRefExact":"2Cor.7.10"},{"anchorText":"2 Tm 2:25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Tim.2.25","rawQueryValue":"2Tim.2.25","sourceRefExact":"2Tim.2.25"},{"anchorText":"2 Pt 3:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Pet.3.9","rawQueryValue":"2Pet.3.9","sourceRefExact":"2Pet.3.9"},{"anchorText":"Acts 14:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.14.15","rawQueryValue":"Acts.14.15","sourceRefExact":"Acts.14.15"},{"anchorText":"1 Thes 1:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Thes.1.9","rawQueryValue":"1Thes.1.9","sourceRefExact":"1Thes.1.9"},{"anchorText":"1 Pt 2:25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Pet.2.25","rawQueryValue":"1Pet.2.25","sourceRefExact":"1Pet.2.25"}],"sourceItemFragmentSha256":"60d9af4154613db44053453a286c62bb1e6fbe77f02b2e572d987be045bff0ac","sourceItemName":"Conversion","sourceItemOrder":268,"sourceMember":"Articles/C.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Conversion","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Conversion","title":"Conversion","version":"v2-a101d843a2f0cd3fc0c6"}