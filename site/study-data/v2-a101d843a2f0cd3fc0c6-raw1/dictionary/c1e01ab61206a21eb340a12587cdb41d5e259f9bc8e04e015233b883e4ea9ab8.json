{"content":[{"c":["CHOBA"],"sourceClass":"h1","t":"p"},{"c":["Village mentioned in the book of Judith as being fortified by the Jews when Assyrian commander Holofernes invaded Palestine (",{"href":"?bref=Jdt.4.4","r":"Jdt.4.4","rawR":"Jdt.4.4","sourceRefs":[{"raw":"Jdt.4.4","value":"Jdt.4.4"}],"t":"ref","v":"Jdt 4:4"},"). The precise location cannot be identified, but it may be el-Makhubbi, three miles (4.8 kilometers) from Besan, or possibly the Hobah of ",{"href":"?bref=Gen.14.15","r":"Gen.14.15","rawR":"Gen.14.15","sourceRefs":[{"raw":"Gen.14.15","value":"Gen.14.15"}],"t":"ref","v":"Genesis 14:15"},". The account indicates that the Jews pursued Holofernes’ army to Choba and beyond Damascus (",{"href":"?bref=Jdt.15.4-5","r":"Jdt.15.4-5","rawR":"Jdt.15.4-5","sourceRefs":[{"raw":"Jdt.15.4-5","value":"Jdt.15.4-5"}],"t":"ref","v":"Jdt 15:4-5"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Choba","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jdt 4:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jdt.4.4","rawQueryValue":"Jdt.4.4","sourceRefExact":"Jdt.4.4"},{"anchorText":"Genesis 14:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.14.15","rawQueryValue":"Gen.14.15","sourceRefExact":"Gen.14.15"},{"anchorText":"Jdt 15:4-5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jdt.15.4-5","rawQueryValue":"Jdt.15.4-5","sourceRefExact":"Jdt.15.4-5"}],"sourceItemFragmentSha256":"6b9069feeb0e72be849d8f60862dfb32501d42b2517e39d5963a55393d240b36","sourceItemName":"Choba","sourceItemOrder":166,"sourceMember":"Articles/C.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Choba","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Choba","title":"Choba","version":"v2-a101d843a2f0cd3fc0c