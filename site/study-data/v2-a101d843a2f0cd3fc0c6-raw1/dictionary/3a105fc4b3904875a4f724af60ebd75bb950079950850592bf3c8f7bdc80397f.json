"sourceRefExact":"2Cor.4.4-6"},{"anchorText":"Heb 1:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Heb.1.3","rawQueryValue":"Heb.1.3","sourceRefExact":"Heb.1.3"}],"sourceItemFragmentSha256":"d22a2d19fa9afea9578773f2a610eb83c1da50dee2fe7603fead30a8c56e991a","sourceItemName":"Shekinah","sourceItemOrder":256,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Shekinah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Shekinah*","title":"Shekinah*","version":"v2-a101d843a2f0cd3fc0c6"}