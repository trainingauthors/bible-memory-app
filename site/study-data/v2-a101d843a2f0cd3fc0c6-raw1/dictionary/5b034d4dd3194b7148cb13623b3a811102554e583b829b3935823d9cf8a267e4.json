{"content":[{"c":["EZBAI"],"sourceClass":"h1","t":"p"},{"c":["Father of Naarai, one of David’s elite force known as “the thirty” (",{"href":"?bref=1Chr.11.37","r":"1Chr.11.37","rawR":"1Chr.11.37","sourceRefs":[{"raw":"1Chr.11.37","value":"1Chr.11.37"}],"t":"ref","v":"1 Chr 11:37"},"). In ",{"href":"?bref=2Sam.23.35","r":"2Sam.23.35","rawR":"2Sam.23.35","sourceRefs":[{"raw":"2Sam.23.35","value":"2Sam.23.35"}],"t":"ref","v":"2 Samuel 23:35"}," he is called Paarai the Arbite. This has led some interpreters to suggest that “the son of Ezbai” in the 1 Chronicles passage is a corruption of “the Arbite” and that the correct reading of his name should be Naarai the Arbite."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Ezbai","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 11:37","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.11.37","rawQueryValue":"1Chr.11.37","sourceRefExact":"1Chr.11.37"},{"anchorText":"2 Samuel 23:35","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.23.35","rawQueryValue":"2Sam.23.35","sourceRefExact":"2Sam.23.35"}],"sourceItemFragmentSha256":"a470679a69ac51be015c101eb5ec86ac529f5c585566541e67323ab656556688","sourceItemName":"Ezbai","sourceItemOrder":302,"sourceMember":"Articles/E.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Ezbai","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Ezbai","title":"Ezbai","version":"v2-a101d843a2f0cd3fc0c6"}