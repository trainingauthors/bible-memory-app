{"content":[{"c":["BEER-LAHAIROI"],"sourceClass":"h1","t":"p"},{"c":["Well between Kadesh and Bered where Hagar, pregnant with Ishmael, was confronted by the angel of the Lord (",{"href":"?bref=Gen.16.7-14","r":"Gen.16.7-14","rawR":"Gen.16.7-14","sourceRefs":[{"raw":"Gen.16.7-14","value":"Gen.16.7-14"}],"t":"ref","v":"Gn 16:7-14"},"). The name given to the site means “the well of the Living One who sees me,” referring to God’s appearance to Sarai’s servant girl. Later, it became a frequent watering place for Isaac on his travels (",{"href":"?bref=Gen.24.62","r":"Gen.24.62","rawR":"Gen.24.62","sourceRefs":[{"raw":"Gen.24.62","value":"Gen.24.62"}],"t":"ref","v":"Gn 24:62"},"; ",{"href":"?bref=Gen.25.11","r":"Gen.25.11","rawR":"Gen.25.11","sourceRefs":[{"raw":"Gen.25.11","value":"Gen.25.11"}],"t":"ref","v":"25:11"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"BeerLahairoi","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 16:7-14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.16.7-14","rawQueryValue":"Gen.16.7-14","sourceRefExact":"Gen.16.7-14"},{"anchorText":"Gn 24:62","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.24.62","rawQueryValue":"Gen.24.62","sourceRefExact":"Gen.24.62"},{"anchorText":"25:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.25.11","rawQueryValue":"Gen.25.11","sourceRefExact":"Gen.25.11"}],"sourceItemFragmentSha256":"efc8ffb45e7102c9bbc699f3e4843aa919b399d83d6040954a6e77988c8002b7","sourceItemName":"BeerLahairoi","sourceItemOrder":144,"sourceMember":"Articles/B.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"BeerLahairoi","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Beer-Lahairoi","title":"Beer-Lahairoi","version":"v2-a101d843a2