-24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.5.23-24","rawQueryValue":"Matt.5.23-24","sourceRefExact":"Matt.5.23-24"},{"anchorText":"23:18-20, 35","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.23.18-20,35","rawQueryValue":"Matt.23.18-20,35","sourceRefExact":"Matt.23.18-20,35"},{"anchorText":"Lk 11:51","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.11.51","rawQueryValue":"Luke.11.51","sourceRefExact":"Luke.11.51"},{"anchorText":"1 Cor 9:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Cor.9.13","rawQueryValue":"1Cor.9.13","sourceRefExact":"1Cor.9.13"},{"anchorText":"10:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Cor.10.18","rawQueryValue":"1Cor.10.18","sourceRefExact":"1Cor.10.18"},{"anchorText":"Heb 7:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Heb.7.13","rawQueryValue":"Heb.7.13","sourceRefExact":"Heb.7.13"},{"anchorText":"Rv 11:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.11.1","rawQueryValue":"Rev.11.1","sourceRefExact":"Rev.11.1"},{"anchorText":"Lk 1:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.1.11","rawQueryValue":"Luke.1.11","sourceRefExact":"Luke.1.11"},{"anchorText":"Rv 6:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.6.9","rawQueryValue":"Rev.6.9","sourceRefExact":"Rev.6.9"},{"anchorText":"8:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.8.5","rawQueryValue":"Rev.8.5","sourceRefExact":"Rev.8.5"},{"anchorText":"9:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.9.13","rawQueryValue":"Rev.9.13","sourceRefExact":"Rev.9.13"}],"sourceItemFragmentSha256":"cbaba5a51181d4005794fa2149cb54bf7a2fdf0675d8231b1e