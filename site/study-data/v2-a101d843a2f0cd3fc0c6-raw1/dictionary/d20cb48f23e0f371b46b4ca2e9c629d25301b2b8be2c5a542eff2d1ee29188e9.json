{"content":[{"c":["AR"],"sourceClass":"h1","t":"p"},{"c":["Capital city of Moab located on the northern border (",{"href":"?bref=Deut.2.18,29","r":"Deut.2.18,29","rawR":"Deut.2.18,29","sourceRefs":[{"raw":"Deut.2.18,29","value":"Deut.2.18,29"}],"t":"ref","v":"Dt 2:18, 29"},") near the Arnon River (",{"href":"?bref=Num.21.28","r":"Num.21.28","rawR":"Num.21.28","sourceRefs":[{"raw":"Num.21.28","value":"Num.21.28"}],"t":"ref","v":"Nm 21:28"},"). Ar was sometimes used figuratively to refer to all of Moab (",{"href":"?bref=Deut.2.9","r":"Deut.2.9","rawR":"Deut.2.9","sourceRefs":[{"raw":"Deut.2.9","value":"Deut.2.9"}],"t":"ref","v":"Dt 2:9"},"). The prophet Isaiah predicted the destruction of the Moabite cities Ar and Kir (",{"href":"?bref=Isa.15.1","r":"Isa.15.1","rawR":"Isa.15.1","sourceRefs":[{"raw":"Isa.15.1","value":"Isa.15.1"}],"t":"ref","v":"Is 15:1"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Ar","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Dt 2:18, 29","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.2.18,29","rawQueryValue":"Deut.2.18,29","sourceRefExact":"Deut.2.18,29"},{"anchorText":"Nm 21:28","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.21.28","rawQueryValue":"Num.21.28","sourceRefExact":"Num.21.28"},{"anchorText":"Dt 2:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.2.9","rawQueryValue":"Deut.2.9","sourceRefExact":"Deut.2.9"},{"anchorText":"Is 15:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.15.1","rawQueryValue":"Isa.15.1","sourceRefExact":"Isa.15.1"}],"sourceItemFragmentSha256":"d97902d527ce48825c55521bc9e0e605dc07fe8508f50ebfc729375fda91e5ff","sourceItemName":"Ar","sourceItemOrder":425,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Ar","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Ar","title":"Ar","version":"v2-a101d843a2f0cd3fc0c6"}