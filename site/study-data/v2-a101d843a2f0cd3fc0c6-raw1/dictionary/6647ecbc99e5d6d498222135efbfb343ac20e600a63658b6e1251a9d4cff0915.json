zation":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.24.13","rawQueryValue":"Matt.24.13","sourceRefExact":"Matt.24.13"},{"anchorText":"Lk 21:19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.21.19","rawQueryValue":"Luke.21.19","sourceRefExact":"Luke.21.19"},{"anchorText":"Rom 5:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rom.5.3","rawQueryValue":"Rom.5.3","sourceRefExact":"Rom.5.3"},{"anchorText":"Col 1:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Col.1.11","rawQueryValue":"Col.1.11","sourceRefExact":"Col.1.11"},{"anchorText":"Jer 31:31-34","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.31.31-34","rawQueryValue":"Jer.31.31-34","sourceRefExact":"Jer.31.31-34"}],"sourceItemFragmentSha256":"dc59ba19ea8c0894b49f913e90efba44e3c897d17d12c78ed8225ef3cf02b10c","sourceItemName":"Perseverance","sourceItemOrder":129,"sourceMember":"Articles/P.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Perseverance","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Perseverance","title":"Perseverance","version":"v2-a101d843a2f0cd3fc0c6"}