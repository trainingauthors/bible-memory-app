{"content":[{"c":["MANOAH"],"sourceClass":"h1","t":"p"},{"c":["Danite from Zorah whose wife was barren. Through encounters with the Angel of the Lord, the couple learned that God was about to give them a son who would judge the Philistines and deliver Israel from its oppression. Manoah later fathered Samson, who fulfilled these promises (",{"href":"?bref=Judg.13.1-25","r":"Judg.13.1-25","rawR":"Judg.13.1-25","sourceRefs":[{"raw":"Judg.13.1-25","value":"Judg.13.1-25"}],"t":"ref","v":"Jgs 13"},"; ",{"href":"?bref=Judg.16.31","r":"Judg.16.31","rawR":"Judg.16.31","sourceRefs":[{"raw":"Judg.16.31","value":"Judg.16.31"}],"t":"ref","v":"16:31"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Manoah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jgs 13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.13.1-25","rawQueryValue":"Judg.13.1-25","sourceRefExact":"Judg.13.1-25"},{"anchorText":"16:31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.16.31","rawQueryValue":"Judg.16.31","sourceRefExact":"Judg.16.31"}],"sourceItemFragmentSha256":"bcf21a12e0069f94f548f6086a14fe77a3b6019ce702749d1e990512f1bcf80e","sourceItemName":"Manoah","sourceItemOrder":122,"sourceMember":"Articles/M.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Manoah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Manoah","title":"Manoah","version":"v2-a101d843a2f0cd3fc0c6"}