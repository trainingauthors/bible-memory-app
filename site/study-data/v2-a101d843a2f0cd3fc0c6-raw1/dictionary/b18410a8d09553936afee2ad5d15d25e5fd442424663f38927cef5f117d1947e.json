"2Chr.21.4","sourceRefExact":"2Chr.21.4"},{"anchorText":"2 Kgs 8:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.8.18","rawQueryValue":"2Kgs.8.18","sourceRefExact":"2Kgs.8.18"},{"anchorText":"2 Kgs 8:19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.8.19","rawQueryValue":"2Kgs.8.19","sourceRefExact":"2Kgs.8.19"},{"anchorText":"2 Sm 7:12-16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.7.12-16","rawQueryValue":"2Sam.7.12-16","sourceRefExact":"2Sam.7.12-16"},{"anchorText":"2 Chr 21:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.21.9","rawQueryValue":"2Chr.21.9","sourceRefExact":"2Chr.21.9"},{"anchorText":"16-17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.21.16-17","rawQueryValue":"2Chr.21.16-17","sourceRefExact":"2Chr.21.16-17"},{"anchorText":"19-20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.21.19-20","rawQueryValue":"2Chr.21.19-20","sourceRefExact":"2Chr.21.19-20"},{"anchorText":"2 Kgs 1:2, 17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.1.2,17","rawQueryValue":"2Kgs.1.2,17","sourceRefExact":"2Kgs.1.2,17"},{"anchorText":"2 Kgs 3:4-27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.3.4-27","rawQueryValue":"2Kgs.3.4-27","sourceRefExact":"2Kgs.3.4-27"},{"anchorText":"2 Kgs 8:29","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.8.29","rawQueryValue":"2Kgs.8.29","sourceRefExact":"2Kgs.8.29"},{"anchorText":"2 Kgs 9:14-24, 27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.9.14-24,27","rawQueryValue":"2Kgs.9.14-24,27","sourceRefExact":"2Kgs.9.14-24,27"},{"anchorText":"28","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.9.28","rawQueryValue":"2Kgs.9.28","sourceRefExact":"2Kgs.9.28"},{"anchorText":"25-26","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.9.25-26","rawQueryValue":"2Kgs.9.25-26","sourceRefExact":"2Kgs.9.25-26"},{"anchorText":"2 Chr 17:7-9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.17.7-9","rawQueryValue":"2Chr.17.7-9","sourceRefExact":"2Chr.17.7-9"}],"sourceItemFragmentSha256":"9df023cf6f62667793fde8a0a31ec28393f970e43896c73782a6241263919c3a","sourceItemName":"Jehoram","sourceItemOrder":153,"sourceMember":"Articles/J.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Jehoram","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Jehoram","title":"Jehoram","version":"v2-a101d843a2f0cd3fc0c6"}