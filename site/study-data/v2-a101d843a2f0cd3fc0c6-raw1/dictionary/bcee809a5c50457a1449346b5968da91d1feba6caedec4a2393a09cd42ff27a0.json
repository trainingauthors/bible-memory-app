{"content":[{"c":["PAHATH-MOAB"],"sourceClass":"h1","t":"p"},{"c":["Head of a family of Israelites who returned with Zerubbabel to Palestine after the Babylonian captivity (",{"href":"?bref=Ezra.2.6","r":"Ezra.2.6","rawR":"Ezra.2.6","sourceRefs":[{"raw":"Ezra.2.6","value":"Ezra.2.6"}],"t":"ref","v":"Ezr 2:6"},"; ",{"href":"?bref=Neh.7.11","r":"Neh.7.11","rawR":"Neh.7.11","sourceRefs":[{"raw":"Neh.7.11","value":"Neh.7.11"}],"t":"ref","v":"Neh 7:11"},"). Other members of his family, about 200 men, came with Ezra (",{"href":"?bref=Ezra.8.4","r":"Ezra.8.4","rawR":"Ezra.8.4","sourceRefs":[{"raw":"Ezra.8.4","value":"Ezra.8.4"}],"t":"ref","v":"Ezr 8:4"},"). After the return, certain of his sons were included among the Israelites who vowed to sever their relationships with foreign wives (",{"href":"?bref=Ezra.10.30","r":"Ezra.10.30","rawR":"Ezra.10.30","sourceRefs":[{"raw":"Ezra.10.30","value":"Ezra.10.30"}],"t":"ref","v":"10:30"},"). Hasshub, Pahath-moab’s son, helped rebuild the Jerusalem wall and the tower of furnaces in Nehemiah’s day (",{"href":"?bref=Neh.3.11","r":"Neh.3.11","rawR":"Neh.3.11","sourceRefs":[{"raw":"Neh.3.11","value":"Neh.3.11"}],"t":"ref","v":"Neh 3:11"},"). Pahath-moab, called a chief of the people, set his seal on Ezra’s covenant (",{"href":"?bref=Neh.10.14","r":"Neh.10.14","rawR":"Neh.10.14","sourceRefs":[{"raw":"Neh.10.14","value":"Neh.10.14"}],"t":"ref","v":"10:14"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"PahathMoab","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ezr 2:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.2.6","rawQueryValue":"Ezra.2.6","sourceRefExact":"Ezra.2.6"},{"anchorText":"Neh 7:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.7.11","rawQueryValue":"Neh.7.11","sourceRefExact":"Neh.7.11"},{"anchorText":"Ezr 8:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.8.4","rawQueryValue":"Ezra.8.4","sourceRefExact":"Ezra.8.4"},{"anchorText":"10:30","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.10.30","rawQueryValue":"Ezra.10.30","sourceRefExact":"Ezra.10.30"},{"anchorText":"Neh 3:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.3.11","rawQueryValue":"Neh.3.11","sourceRefExact":"Neh.3.11"},{"anchorText":"10:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.10.14","rawQueryValue":"Neh.10.14","sourceRefExact":"Neh.10.14"}],"sourceItemFragmentSha256":"8fb7bba6894f492ae2e06b7d8161244be0d0c3586442afcd674f4ad3574c4fc8","sourceItemName":"PahathMoab","sourceItemOrder":7,"sourceMember":"Articles/P.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"PahathMoab","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Pahath-Moab","title":"Pahath-Moab","version":"v2-a101d843a2f0cd3fc0c6"}