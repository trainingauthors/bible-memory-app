{"content":[{"c":["ONO"],"sourceClass":"h1","t":"p"},{"c":["Benjaminite town built by Shemed (",{"href":"?bref=1Chr.8.12","r":"1Chr.8.12","rawR":"1Chr.8.12","sourceRefs":[{"raw":"1Chr.8.12","value":"1Chr.8.12"}],"t":"ref","v":"1 Chr 8:12"},"). Some of its inhabitants returned to Palestine with Zerubbabel following the exile (",{"href":"?bref=Ezra.2.33","r":"Ezra.2.33","rawR":"Ezra.2.33","sourceRefs":[{"raw":"Ezra.2.33","value":"Ezra.2.33"}],"t":"ref","v":"Ezr 2:33"},"; ",{"href":"?bref=Neh.7.37","r":"Neh.7.37","rawR":"Neh.7.37","sourceRefs":[{"raw":"Neh.7.37","value":"Neh.7.37"}],"t":"ref","v":"Neh 7:37"},"). Its location was variously known as the plain of Ono (",{"href":"?bref=Neh.6.2","r":"Neh.6.2","rawR":"Neh.6.2","sourceRefs":[{"raw":"Neh.6.2","value":"Neh.6.2"}],"t":"ref","v":"Neh 6:2"},") or as the valley of craftsmen (",{"href":"?bref=Neh.11.35","r":"Neh.11.35","rawR":"Neh.11.35","sourceRefs":[{"raw":"Neh.11.35","value":"Neh.11.35"}],"t":"ref","v":"11:35"},"). Ono is identified with Kefr ‘Ana, seven miles (11.3 kilometers) southeast of Joppa."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Ono","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 8:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.8.12","rawQueryValue":"1Chr.8.12","sourceRefExact":"1Chr.8.12"},{"anchorText":"Ezr 2:33","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.2.33","rawQueryValue":"Ezra.2.33","sourceRefExact":"Ezra.2.33"},{"anchorText":"Neh 7:37","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.7.37","rawQueryValue":"Neh.7.37","sourceRefExact":"Neh.7.37"},{"anchorText":"Neh 6:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.6.2","rawQueryValue":"Neh.6.2","sourceRefExact":"Neh.6.2"},{"anchorText":"11:35","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.11.35","rawQueryValue":"Neh.11.35","sourceRefExact":"Neh.11.35"}],"sourceItemFragmentSha256":"7df2d2249a5e99239874a881f357cce5212893c95af5077ed5a01c7c27be4ae6","sourceItemName":"Ono","sourceItemOrder":62,"sourceMember":"Articles/O.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Ono","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Ono","title":"Ono","version":"v2-a101d843a2f0cd3fc0c6"}