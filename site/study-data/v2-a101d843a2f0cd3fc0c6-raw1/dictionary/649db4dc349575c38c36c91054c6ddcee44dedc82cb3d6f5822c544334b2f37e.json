{"content":[{"c":["GABBATHA"],"sourceClass":"h1","t":"p"},{"c":["Transliteration of an uncertain Aramaic expression, which is rendered in Greek as “paved with stones” and refers to the raised area before the palace in Jerusalem where formal sentencing by the governor occurred. Pilate seated himself on the elevated judgment seat here in order to preside over the trial of Jesus (",{"href":"?bref=John.19.13","r":"John.19.13","rawR":"John.19.13","sourceRefs":[{"raw":"John.19.13","value":"John.19.13"}],"t":"ref","v":"Jn 19:13"},"). "],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Gabbatha","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jn 19:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=John.19.13","rawQueryValue":"John.19.13","sourceRefExact":"John.19.13"}],"sourceItemFragmentSha256":"8068b14cf39b3f2fe05547c1184c77839e04550c51f852117020a28836ebb165","sourceItemName":"Gabbatha","sourceItemOrder":7,"sourceMember":"Articles/G.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Gabbatha","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Gabbatha","title":"Gabbatha","version":"v2-a101d843a2f0cd3fc0c6"}