{"content":[{"c":["GENUBATH"],"sourceClass":"h1","t":"p"},{"c":["Son of Hadad, the Edomite prince who, as a young lad, was taken to Egypt to escape Joab’s slaughter. There Hadad married a sister of Queen Tahpenes. She bore Genubath, who was raised by the queen as a son of Pharaoh (",{"href":"?bref=1Kgs.11.20","r":"1Kgs.11.20","rawR":"1Kgs.11.20","sourceRefs":[{"raw":"1Kgs.11.20","value":"1Kgs.11.20"}],"t":"ref","v":"1 Kgs 11:20"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Genubath","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Kgs 11:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.11.20","rawQueryValue":"1Kgs.11.20","sourceRefExact":"1Kgs.11.20"}],"sourceItemFragmentSha256":"cb58a55d5962436bfafb69ffadb1649c1afb0dd5710d24359e490e676c046e48","sourceItemName":"Genubath","sourceItemOrder":97,"sourceMember":"Articles/G.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Genubath","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Genubath","title":"Genubath","version":"v2-a101d843a2f0cd3fc0c6"}