{"content":[{"c":["ARISTARCHUS"],"sourceClass":"h1","t":"p"},{"c":["Companion of the apostle Paul; Macedonian from Thessalonica, possibly of Jewish ancestry. He is first mentioned as one of those seized by an angry mob in Ephesus (",{"href":"?bref=Acts.19.29","r":"Acts.19.29","rawR":"Acts.19.29","sourceRefs":[{"raw":"Acts.19.29","value":"Acts.19.29"}],"t":"ref","v":"Acts 19:29"},"). Later he accompanied Paul on the return from his third missionary journey (",{"href":"?bref=Acts.20.4","r":"Acts.20.4","rawR":"Acts.20.4","sourceRefs":[{"raw":"Acts.20.4","value":"Acts.20.4"}],"t":"ref","v":"Acts 20:4"},") as well as to Rome to face Caesar (",{"href":"?bref=Acts.27.1-2","r":"Acts.27.1-2","rawR":"Acts.27.1-2","sourceRefs":[{"raw":"Acts.27.1-2","value":"Acts.27.1-2"}],"t":"ref","v":"Acts 27:1-2"},"). Paul described him as a coworker (",{"href":"?bref=Phlm.1.24","r":"Phlm.1.24","rawR":"Phlm.1.24","sourceRefs":[{"raw":"Phlm.1.24","value":"Phlm.1.24"}],"t":"ref","v":"Phlm 1:24"},") and fellow prisoner from whom he received great comfort (",{"href":"?bref=Col.4.10-11","r":"Col.4.10-11","rawR":"Col.4.10-11","sourceRefs":[{"raw":"Col.4.10-11","value":"Col.4.10-11"}],"t":"ref","v":"Col 4:10-11"},"). Tradition says that Aristarchus was martyred in Rome under Nero."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Aristarchus","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Acts 19:29","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.19.29","rawQueryValue":"Acts.19.29","sourceRefExact":"Acts.19.29"},{"anchorText":"Acts 20:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.20.4","rawQueryValue":"Acts.20.4","sourceRefExact":"Acts.20.4"},{"anchorText":"Acts 27:1-2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.27.1-2","rawQueryValue":"Acts.27.1-2","sourceRefExact":"Acts.27.1-2"},{"anchorText":"Phlm 1:24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Phlm.1.24","rawQueryValue":"Phlm.1.24","sourceRefExact":"Phlm.1.24"},{"anchorText":"Col 4:10-11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Col.4.10-11","rawQueryValue":"Col.4.10-11","sourceRefExact":"Col.4.10-11"}],"sourceItemFragmentSha256":"11f801bf435a58467daf7ffbcc66f4a56a87e387a6f6c3b901c79ae55e99c1bf","sourceItemName":"Aristarchus","sourceItemOrder":482,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Aristarchus","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Aristarchus","title":"Aristarchus","version":"v2-a101d843a2f0cd3fc0c6"}