{"content":[{"c":["IMRI"],"sourceClass":"h1","t":"p"},{"c":["1. Ancestor of Uthai, one of the postexilic Jews of Judah’s tribe (",{"href":"?bref=1Chr.9.4","r":"1Chr.9.4","rawR":"1Chr.9.4","sourceRefs":[{"raw":"1Chr.9.4","value":"1Chr.9.4"}],"t":"ref","v":"1 Chr 9:4"},"). In the genealogy of ",{"href":"?bref=Neh.11.4","r":"Neh.11.4","rawR":"Neh.11.4","sourceRefs":[{"raw":"Neh.11.4","value":"Neh.11.4"}],"t":"ref","v":"Nehemiah 11:4"},", Imri and Amariah are probably the same person."],"sourceClass":"list","t":"p"},{"c":["2. Father of Zaccur, a rebuilder of the Jerusalem wall (",{"href":"?bref=Neh.3.2","r":"Neh.3.2","rawR":"Neh.3.2","sourceRefs":[{"raw":"Neh.3.2","value":"Neh.3.2"}],"t":"ref","v":"Neh 3:2"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Imri","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 9:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.9.4","rawQueryValue":"1Chr.9.4","sourceRefExact":"1Chr.9.4"},{"anchorText":"Nehemiah 11:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.11.4","rawQueryValue":"Neh.11.4","sourceRefExact":"Neh.11.4"},{"anchorText":"Neh 3:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.3.2","rawQueryValue":"Neh.3.2","sourceRefExact":"Neh.3.2"}],"sourceItemFragmentSha256":"76ea5bb1aecc0a2ed35fd0a99a62f3afbe1753dba47244e6c3e7847639baa0c3","sourceItemName":"Imri","sourceItemOrder":44,"sourceMember":"Articles/I.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Imri","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Imri","title":"Imri","version":"v2-a101d843a2f0cd3fc0c6"}