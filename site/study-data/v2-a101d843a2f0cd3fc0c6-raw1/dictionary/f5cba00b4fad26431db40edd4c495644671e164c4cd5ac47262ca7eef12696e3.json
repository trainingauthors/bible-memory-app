{"content":[{"c":["AMBER"],"sourceClass":"h1","t":"p"},{"c":["Fossilized resin of certain cone-bearing plants. The resinous product of these conifers loses its volatile components and turns into a translucent yellow or orange solid. The word is used in the ",{"c":["kjv"],"sourceClass":"sc","t":"span"}," to describe a color seen in visions of the Lord (",{"href":"?bref=Ezek.8.2","r":"Ezek.8.2","rawR":"Ezek.8.2","sourceRefs":[{"raw":"Ezek.8.2","value":"Ezek.8.2"}],"t":"ref","v":"Ez 8:2"},"). The color is similar to that of polished brass or bronze (",{"href":"?bref=Ezek.1.4,27","r":"Ezek.1.4,27","rawR":"Ezek.1.4,27","sourceRefs":[{"raw":"Ezek.1.4,27","value":"Ezek.1.4,27"}],"t":"ref","v":"Ez 1:4, 27"},"). ",{"c":["See"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Color_Article_TyndaleOpenBibleDictionary","id":"Color_Article_TyndaleOpenBibleDictionary","rawId":"Color_Article_TyndaleOpenBibleDictionary","t":"link","v":"Color"},"."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Amber","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ez 8:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.8.2","rawQueryValue":"Ezek.8.2","sourceRefExact":"Ezek.8.2"},{"anchorText":"Ez 1:4, 27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.1.4,27","rawQueryValue":"Ezek.1.4,27","sourceRefExact":"Ezek.1.4,27"}],"sourceItemFragmentSha256":"089549242a4edc384fe38dae73b566cfe076a4004d9f2b4504ff8e5d199dbe02","sourceItemName":"Amber","sourceItemOrder":289,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Amber","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Amber","title":"Amber","version":"v2-a101d843a2f0cd3fc0c6"}