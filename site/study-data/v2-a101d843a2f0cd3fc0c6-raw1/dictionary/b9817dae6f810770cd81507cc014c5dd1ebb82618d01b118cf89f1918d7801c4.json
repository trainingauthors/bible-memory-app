{"content":[{"c":["ABIEZER"],"sourceClass":"h1","t":"p"},{"c":["1. Descendant of Manasseh (",{"href":"?bref=Josh.17.1-2","r":"Josh.17.1-2","rawR":"Josh.17.1-2","sourceRefs":[{"raw":"Josh.17.1-2","value":"Josh.17.1-2"}],"t":"ref","v":"Jos 17:1-2"},"). Although Abiezer’s father is not named, Abiezer is listed with the descendants of his mother’s brother, Gilead (",{"href":"?bref=1Chr.7.18","r":"1Chr.7.18","rawR":"1Chr.7.18","sourceRefs":[{"raw":"1Chr.7.18","value":"1Chr.7.18"}],"t":"ref","v":"1 Chr 7:18"},"). In ",{"href":"?bref=Num.26.30","r":"Num.26.30","rawR":"Num.26.30","sourceRefs":[{"raw":"Num.26.30","value":"Num.26.30"}],"t":"ref","v":"Numbers 26:30"},", Abiezer’s name is shortened to Iezer (",{"c":["kjv"],"sourceClass":"sc","t":"span"}," “Jeezer”), and the family is called Iezerites (",{"c":["kjv"],"sourceClass":"sc","t":"span"}," “Jeezerites”). Abiezer’s family, to which Gideon belonged, was the first clan to respond to Gideon’s call to fight the Midianites (",{"href":"?bref=Judg.6.34","r":"Judg.6.34","rawR":"Judg.6.34","sourceRefs":[{"raw":"Judg.6.34","value":"Judg.6.34"}],"t":"ref","v":"Jgs 6:34"},"). Abiezer’s descendants were referred to as Abiezrites (",{"href":"?bref=Judg.6.11,24,34","r":"Judg.6.11,24,34","rawR":"Judg.6.11,24,34","sourceRefs":[{"raw":"Judg.6.11,24,34","value":"Judg.6.11,24,34"}],"t":"ref","v":"Jgs 6:11, 24, 34"},"; ",{"href":"?bref=Judg.8.32","r":"Judg.8.32","rawR":"Judg.8.32","sourceRefs":[{"raw":"Judg.8.32","value":"Judg.8.32"}],"t":"ref","v":"8:32"},")."],"sourceClass":"list","t":"p"},{"c":["2. Member of Benjamin’s tribe from Anathoth and warrior among David’s mighty men, known as “the thirty” (",{"href":"?bref=2Sam.23.27","r":"2Sam.23.27","rawR":"2Sam.23.27","sourceRefs":[{"raw":"2Sam.23.27","value":"2Sam.23.27"}],"t":"ref","v":"2 Sm 23:27"},"; ",{"href":"?bref=1Chr.11.28","r":"1Chr.11.28","rawR":"1Chr.11.28","sourceRefs":[{"raw":"1Chr.11.28","value":"1Chr.11.28"}],"t":"ref","v":"1 Chr 11:28"},"). This Abiezer was commander of the ninth division of the army in the rotation system established by David (",{"href":"?bref=1Chr.27.12","r":"1Chr.27.12","rawR":"1Chr.27.12","sourceRefs":[{"raw":"1Chr.27.12","value":"1Chr.27.12"}],"t":"ref","v":"1 Chr 27:12"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Abiezer","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 17:1-2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.17.1-2","rawQueryValue":"Josh.17.1-2","sourceRefExact":"Josh.17.1-2"},{"anchorText":"1 Chr 7:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.7.18","rawQueryValue":"1Chr.7.18","sourceRefExact":"1Chr.7.18"},{"anchorText":"Numbers 26:30","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.26.30","rawQueryValue":"Num.26.30","sourceRefExact":"Num.26.30"},{"anchorText":"Jgs 6:34","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.6.34","rawQueryValue":"Judg.6.34","sourceRefExact":"Judg.6.34"},{"anchorText":"Jgs 6:11, 24, 34","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.6.11,24,34","rawQueryValue":"Judg.6.11,24,34","sourceRefExact":"Judg.6.11,24,34"},{"anchorText":"8:32","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.8.32","rawQueryValue":"Judg.8.32","sourceRefExact":"Judg.8.32"},{"anchorText":"2 Sm 23:27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.23.27","rawQueryValue":"2Sam.23.27","sourceRefExact":"2Sam.23.27"},{"anchorText":"1 Chr 11:28","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.11.28","rawQueryValue":"1Chr.11.28","sourceRefExact":"1Chr.11.28"},{"anchorText":"1 Chr 27:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.27.12","rawQueryValue":"1Chr.27.12","sourceRefExact":"1Chr.27.12"}],"sourceItemFragmentSha256":"3b7c6767e850ed5e28b67e9c61866cd28c27b1175ca5e055145b8621c6f911b0","sourceItemName":"Abiezer","sourceItemOrder":36,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Abiezer","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Abiezer","title":"Abiezer","version":"v2-a101d843a2f0cd3fc0c6"}