{"content":[{"c":["ADADAH"],"sourceClass":"h1","t":"p"},{"c":["One of 30 cities assigned to Judah’s tribe in the Negev, or southern desert region (",{"href":"?bref=Josh.15.22","r":"Josh.15.22","rawR":"Josh.15.22","sourceRefs":[{"raw":"Josh.15.22","value":"Josh.15.22"}],"t":"ref","v":"Jos 15:22"},"). A Greek textual variant in the Septuagint is ",{"c":["Ararah"],"sourceClass":"greek","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," which appears as “Aroer” in ",{"href":"?bref=1Sam.30.28","r":"1Sam.30.28","rawR":"1Sam.30.28","sourceRefs":[{"raw":"1Sam.30.28","value":"1Sam.30.28"}],"t":"ref","v":"1 Samuel 30:28"},". It may be modern Khirbet Ar’arah, located 12 miles (19 kilometers) south of Beersheba."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Adadah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 15:22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.22","rawQueryValue":"Josh.15.22","sourceRefExact":"Josh.15.22"},{"anchorText":"1 Samuel 30:28","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.30.28","rawQueryValue":"1Sam.30.28","sourceRefExact":"1Sam.30.28"}],"sourceItemFragmentSha256":"fd13faaf782c5708f0419a3665fc702f6fa37e0dc085ae1008ea2a35217d0fff","sourceItemName":"Adadah","sourceItemOrder":97,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Adadah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Adadah","title":"Adadah","version":"v2-a101d843a2f0cd3fc0c6"}