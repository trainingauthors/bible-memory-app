{"content":[{"c":["ADONIKAM"],"sourceClass":"h1","t":"p"},{"c":["Head of a family whose descendants returned to Jerusalem with Zerubbabel after the Babylonian exile (",{"href":"?bref=Ezra.2.13","r":"Ezra.2.13","rawR":"Ezra.2.13","sourceRefs":[{"raw":"Ezra.2.13","value":"Ezra.2.13"}],"t":"ref","v":"Ezr 2:13"},"; ",{"href":"?bref=Neh.7.18","r":"Neh.7.18","rawR":"Neh.7.18","sourceRefs":[{"raw":"Neh.7.18","value":"Neh.7.18"}],"t":"ref","v":"Neh 7:18"},"). Ezra states the number of Adonikam’s family returning as 666; Nehemiah gives the number as 667 (as does ",{"href":"?bref=1Esd.5.14","r":"1Esd.5.14","rawR":"1Esd.5.14","sourceRefs":[{"raw":"1Esd.5.14","value":"1Esd.5.14"}],"t":"ref","v":"1 Esd 5:14"},"), probably a scribal variation."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Adonikam","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ezr 2:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.2.13","rawQueryValue":"Ezra.2.13","sourceRefExact":"Ezra.2.13"},{"anchorText":"Neh 7:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.7.18","rawQueryValue":"Neh.7.18","sourceRefExact":"Neh.7.18"},{"anchorText":"1 Esd 5:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Esd.5.14","rawQueryValue":"1Esd.5.14","sourceRefExact":"1Esd.5.14"}],"sourceItemFragmentSha256":"abc66eec3456c9dffee5f87b8d6d556b433cf86f2af0dc7531388e95b113a163","sourceItemName":"Adonikam","sourceItemOrder":132,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Adonikam","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Adonikam","title":"Adonikam","version":"v2-a101d843a2f0cd3fc0c6"}