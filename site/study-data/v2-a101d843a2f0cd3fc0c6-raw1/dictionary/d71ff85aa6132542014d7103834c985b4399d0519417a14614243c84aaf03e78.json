{"content":[{"c":["TAHPENES"],"sourceClass":"h1","t":"p"},{"c":["Egyptian queen who lived during the reigns of David (1000–961 ",{"c":["BC"],"sourceClass":"era","t":"span"},") and Solomon (970–930 ",{"c":["BC"],"sourceClass":"era","t":"span"},"). Pharaoh gave her sister to Hadad the Edomite in marriage. Tahpenes’s sister bore to Hadad a son named Genubath (",{"href":"?bref=1Kgs.11.19-20","r":"1Kgs.11.19-20","rawR":"1Kgs.11.19-20","sourceRefs":[{"raw":"1Kgs.11.19-20","value":"1Kgs.11.19-20"}],"t":"ref","v":"1 Kgs 11:19-20"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Tahpenes","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Kgs 11:19-20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.11.19-20","rawQueryValue":"1Kgs.11.19-20","sourceRefExact":"1Kgs.11.19-20"}],"sourceItemFragmentSha256":"8be2e5653b14b86692b7c43569f6a601c38520a65fa77f7ad8ce4a6935881398","sourceItemName":"Tahpenes","sourceItemOrder":30,"sourceMember":"Articles/T.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Tahpenes","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Tahpenes","title":"Tahpenes","version":"v2-a101d843a2f0cd3fc0c6"}