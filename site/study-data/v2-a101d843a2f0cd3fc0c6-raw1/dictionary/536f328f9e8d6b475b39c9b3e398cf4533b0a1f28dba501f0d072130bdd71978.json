{"content":[{"c":["SENEH"],"sourceClass":"h1","t":"p"},{"c":["Name of one of the two rocky crags at a pass across the Wadi es-Suweinit over which Jonathan and his armor bearer crossed in their skirmish against the Philistines. The crag opposite Seneh was called Bozez and faced the town of Micmash to the north. Seneh was visible to the town of Geba to the south (",{"href":"?bref=1Sam.14.4-5","r":"1Sam.14.4-5","rawR":"1Sam.14.4-5","sourceRefs":[{"raw":"1Sam.14.4-5","value":"1Sam.14.4-5"}],"t":"ref","v":"1 Sm 14:4-5"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Seneh","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Sm 14:4-5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.14.4-5","rawQueryValue":"1Sam.14.4-5","sourceRefExact":"1Sam.14.4-5"}],"sourceItemFragmentSha256":"99a21b93d249d2d4f63518279924f6b46aacaecdfa8164eb0e0f267af34a858e","sourceItemName":"Seneh","sourceItemOrder":146,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Seneh","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Seneh","title":"Seneh","version":"v2-a101d843a2f0cd3fc0c6"}