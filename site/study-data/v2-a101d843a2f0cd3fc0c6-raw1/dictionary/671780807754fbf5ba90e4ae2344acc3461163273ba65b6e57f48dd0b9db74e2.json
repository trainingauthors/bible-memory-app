{"content":[{"c":["IJON"],"sourceClass":"h1","t":"p"},{"c":["Town assigned to Naphtali’s tribe in the extreme north of Palestine. Some identify it with Tell ed-Dibbon between the Litani River and Mt Hermon, but this is disputed. Ijon was one of the towns taken by Ben-hadad of Damascus during Baasha’s reign (c. 900 ",{"c":["BC"],"sourceClass":"era","t":"span"},"; ",{"href":"?bref=1Kgs.15.20","r":"1Kgs.15.20","rawR":"1Kgs.15.20","sourceRefs":[{"raw":"1Kgs.15.20","value":"1Kgs.15.20"}],"t":"ref","v":"1 Kgs 15:20"},"; ",{"href":"?bref=2Chr.16.4","r":"2Chr.16.4","rawR":"2Chr.16.4","sourceRefs":[{"raw":"2Chr.16.4","value":"2Chr.16.4"}],"t":"ref","v":"2 Chr 16:4"},"). Tiglath-pileser III of Assyria captured the town and deported its people during Pekah’s reign (c. 733 ",{"c":["BC"],"sourceClass":"era","t":"span"},"; ",{"href":"?bref=2Kgs.15.29","r":"2Kgs.15.29","rawR":"2Kgs.15.29","sourceRefs":[{"raw":"2Kgs.15.29","value":"2Kgs.15.29"}],"t":"ref","v":"2 Kgs 15:29"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Ijon","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Kgs 15:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.15.20","rawQueryValue":"1Kgs.15.20","sourceRefExact":"1Kgs.15.20"},{"anchorText":"2 Chr 16:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.16.4","rawQueryValue":"2Chr.16.4","sourceRefExact":"2Chr.16.4"},{"anchorText":"2 Kgs 15:29","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.15.29","rawQueryValue":"2Kgs.15.29","sourceRefExact":"2Kgs.15.29"}],"sourceItemFragmentSha256":"47fa2cef530f14ecd014ae11f257faa6a802df4fbd9dbae1d2cffa768775156c","sourceItemName":"Ijon","sourceItemOrder":25,"sourceMember":"Articles/I.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Ijon","product":"