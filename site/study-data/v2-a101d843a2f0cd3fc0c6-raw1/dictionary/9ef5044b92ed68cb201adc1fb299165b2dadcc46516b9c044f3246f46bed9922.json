{"content":[{"c":["TERESH"],"sourceClass":"h1","t":"p"},{"c":["One of two chamberlains who guarded the chambers of King Ahasuerus (Xerxes). When the two planned to kill the king, Mordecai discovered their plot and informed Esther, who in turn told the king. The guards were hanged (",{"href":"?bref=Esth.2.21-23","r":"Esth.2.21-23","rawR":"Esth.2.21-23","sourceRefs":[{"raw":"Esth.2.21-23","value":"Esth.2.21-23"}],"t":"ref","v":"Est 2:21-23"},"; ",{"href":"?bref=Esth.6.2","r":"Esth.6.2","rawR":"Esth.6.2","sourceRefs":[{"raw":"Esth.6.2","value":"Esth.6.2"}],"t":"ref","v":"6:2"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Teresh","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Est 2:21-23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Esth.2.21-23","rawQueryValue":"Esth.2.21-23","sourceRefExact":"Esth.2.21-23"},{"anchorText":"6:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Esth.6.2","rawQueryValue":"Esth.6.2","sourceRefExact":"Esth.6.2"}],"sourceItemFragmentSha256":"0894f75e76327f995aedae756aa6d786f0884cbe84b6b8f6d79068811fd83c31","sourceItemName":"Teresh","sourceItemOrder":105,"sourceMember":"Articles/T.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Teresh","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Teresh","title":"Teresh","version":"v2-a101d843a2f0cd3fc0c6"}