{"content":[{"c":["BITTER HERBS"],"sourceClass":"h1","t":"p"},{"c":["Some kind of bitter vegetable(s), perhaps a certain variety of lettuce. The people of Israel were commanded to eat bitter herbs, roast lamb, and unleavened bread on the night when the Lord inflicted the plague of death on all the Egyptian firstborn (",{"href":"?bref=Exod.12.8-11","r":"Exod.12.8-11","rawR":"Exod.12.8-11","sourceRefs":[{"raw":"Exod.12.8-11","value":"Exod.12.8-11"}],"t":"ref","v":"Ex 12:8-11"},")."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Plants_Article_TyndaleOpenBibleDictionary","id":"Plants_Article_TyndaleOpenBibleDictionary","rawId":"Plants_Article_TyndaleOpenBibleDictionary","t":"link","v":"Plants"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"BitterHerbs","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ex 12:8-11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.12.8-11","rawQueryValue":"Exod.12.8-11","sourceRefExact":"Exod.12.8-11"}],"sourceItemFragmentSha256":"9ce29b8cfa4e217741cfae1fae52fcf9d2638d92972335807c316fdc6465fe05","sourceItemName":"BitterHerbs","sourceItemOrder":334,"sourceMember":"Articles/B.xml","supplementPointersNotIncludedAsContent":[{"name":"TheSignificanceOfBitterHerbs","src":"../Textboxes/Textboxes.xml"}]},"sourceAttributes":{"name":"BitterHerbs","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Bitter Herbs","title":"Bitter Herbs","version":"v2-a101d843a2f0cd3fc0c6"}