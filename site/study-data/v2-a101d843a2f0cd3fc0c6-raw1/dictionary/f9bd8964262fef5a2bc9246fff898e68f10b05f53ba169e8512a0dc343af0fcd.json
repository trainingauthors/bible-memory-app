ceRefExact":"Acts.16.1-3"},{"anchorText":"Rom 1:16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rom.1.16","rawQueryValue":"Rom.1.16","sourceRefExact":"Rom.1.16"},{"anchorText":"10:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rom.10.12","rawQueryValue":"Rom.10.12","sourceRefExact":"Rom.10.12"},{"anchorText":"1 Cor 1:22, 24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Cor.1.22,24","rawQueryValue":"1Cor.1.22,24","sourceRefExact":"1Cor.1.22,24"},{"anchorText":"Gal 2:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gal.2.3","rawQueryValue":"Gal.2.3","sourceRefExact":"Gal.2.3"},{"anchorText":"3:28","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gal.3.28","rawQueryValue":"Gal.3.28","sourceRefExact":"Gal.3.28"},{"anchorText":"Jn 19:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=John.19.20","rawQueryValue":"John.19.20","sourceRefExact":"John.19.20"},{"anchorText":"Acts 21:37","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.21.37","rawQueryValue":"Acts.21.37","sourceRefExact":"Acts.21.37"},{"anchorText":"Rv 9:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.9.11","rawQueryValue":"Rev.9.11","sourceRefExact":"Rev.9.11"},{"anchorText":"Mk 7:26","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mark.7.26","rawQueryValue":"Mark.7.26","sourceRefExact":"Mark.7.26"},{"anchorText":"Acts 14:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.14.1","rawQueryValue":"Acts.14.1","sourceRefExact":"Acts.14.1"},{"anchorText":"17:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.17.4","rawQueryValue":"Acts.17.4","sourceRefExact":"Acts.17.4"},{"anchorText":"18:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.18.4","rawQueryValue":"Acts.18.4","sourceRefExact":"Acts.18.4"},{"anchorText":"Acts 18:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.18.12","rawQueryValue":"Acts.18.12","sourceRefExact":"Acts.18.12"}],"sourceItemFragmentSha256":"1e6f2ae1dd941e7eef823e725fbcfce5496059457e99a9be49a7795733f4a09d","sourceItemName":"GreeceGreek","sourceItemOrder":212,"sourceMember":"Articles/G.xml","supplementPointersNotIncludedAsContent":[{"name":"AncientTheaterInDelphi","src":"../Pictures/Pictures.xml"},{"name":"EgnatianWay","src":"../Pictures/Pictures.xml"}]},"sourceAttributes":{"name":"GreeceGreek","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Greece, Greek","title":"Greece, Greek","version":"v2-a101d843a2f0cd3fc0c6"}