{"content":[{"c":["HANES"],"sourceClass":"h1","t":"p"},{"c":["City in Egypt included with Zoan (or Tanis) in ",{"href":"?bref=Isa.30.4","r":"Isa.30.4","rawR":"Isa.30.4","sourceRefs":[{"raw":"Isa.30.4","value":"Isa.30.4"}],"t":"ref","v":"Isaiah 30:4"}," as a center of Egyptian government to which ambassadors would be sent. This indicates that it was one of the dynastic centers. It has been identified with Heracleopolis Magna, south of Memphis, the capital of northern Egypt in Roman times, and also with Heracleopolis Parva in the eastern delta region."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Hanes","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Isaiah 30:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.30.4","rawQueryValue":"Isa.30.4","sourceRefExact":"Isa.30.4"}],"sourceItemFragmentSha256":"e735dbdd0f35ebda3c5d3fc0be5b3e39dac2d7ad3b2e2fa1e343b2beaf8059cf","sourceItemName":"Hanes","sourceItemOrder":91,"sourceMember":"Articles/H.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Hanes","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Hanes","title":"Hanes","version":"v2-a101d843a2f0cd3fc0c6"}