{"content":[{"c":["BETH-ARBEL"],"sourceClass":"h1","t":"p"},{"c":["Town whose violent destruction at the hands of the Assyrians was compared by the prophet Hosea to Ephraim’s forthcoming destruction (",{"href":"?bref=Hos.10.14","r":"Hos.10.14","rawR":"Hos.10.14","sourceRefs":[{"raw":"Hos.10.14","value":"Hos.10.14"}],"t":"ref","v":"Hos 10:14"},"). Beth-arbel is most commonly identified with present-day Irbid in Gilead, located at an important crossroads in northern Transjordan."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"BethArbel","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Hos 10:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Hos.10.14","rawQueryValue":"Hos.10.14","sourceRefExact":"Hos.10.14"}],"sourceItemFragmentSha256":"b1559d8eb812a81ad1d5085e4452e929883a0205783ae78f50752a76ab69e9e2","sourceItemName":"BethArbel","sourceItemOrder":230,"sourceMember":"Articles/B.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"BethArbel","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Beth-Arbel","title":"Beth-Arbel","version":"v2-a101d843a2f0cd3fc0c6"}