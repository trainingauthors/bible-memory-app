{"content":[{"c":["UPPER GATE"],"sourceClass":"h1","t":"p"},{"c":["One of the gates leading to the temple mount in Jerusalem. It was built by Jotham (",{"href":"?bref=2Kgs.15.35","r":"2Kgs.15.35","rawR":"2Kgs.15.35","sourceRefs":[{"raw":"2Kgs.15.35","value":"2Kgs.15.35"}],"t":"ref","v":"2 Kgs 15:35"},"; ",{"href":"?bref=2Chr.27.3","r":"2Chr.27.3","rawR":"2Chr.27.3","sourceRefs":[{"raw":"2Chr.27.3","value":"2Chr.27.3"}],"t":"ref","v":"2 Chr 27:3"},") and served as the principal access between the royal palace and the temple area (",{"href":"?bref=2Chr.23.20","r":"2Chr.23.20","rawR":"2Chr.23.20","sourceRefs":[{"raw":"2Chr.23.20","value":"2Chr.23.20"}],"t":"ref","v":"2 Chr 23:20"},"; ",{"href":"?bref=Ezek.9.2","r":"Ezek.9.2","rawR":"Ezek.9.2","sourceRefs":[{"raw":"Ezek.9.2","value":"Ezek.9.2"}],"t":"ref","v":"Ez 9:2"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"UpperGate","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Kgs 15:35","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.15.35","rawQueryValue":"2Kgs.15.35","sourceRefExact":"2Kgs.15.35"},{"anchorText":"2 Chr 27:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.27.3","rawQueryValue":"2Chr.27.3","sourceRefExact":"2Chr.27.3"},{"anchorText":"2 Chr 23:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.23.20","rawQueryValue":"2Chr.23.20","sourceRefExact":"2Chr.23.20"},{"anchorText":"Ez 9:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.9.2","rawQueryValue":"Ezek.9.2","sourceRefExact":"Ezek.9.2"}],"sourceItemFragmentSha256":"47b65bfe4477ec3f0a1b6229ad9adb7facceee7e7c1bd1765003061def69f207","sourceItemName":"UpperGate","sourceItemOrder":20,"sourceMember":"Articles/U.xml","supplementPointersNotIncludedAsContent":[]},"sourceAtt