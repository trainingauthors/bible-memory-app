Exact":"?bref=Luke.2.36-38","rawQueryValue":"Luke.2.36-38","sourceRefExact":"Luke.2.36-38"}],"sourceItemFragmentSha256":"1c228254143fce81214d4bc42828824c833479ad314b5218484c9df437642765","sourceItemName":"AsherTribe","sourceItemOrder":540,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"AsherTribe","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Asher (Tribe)","title":"Asher (Tribe)","version":"v2-a101d843a2f0cd3fc0c6"}