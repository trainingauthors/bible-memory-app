{"content":[{"c":["ZIHA"],"sourceClass":"h1","t":"p"},{"c":["1. Ancestor of a family of temple servants who returned to Jerusalem with Zerubbabel after the exile (",{"href":"?bref=Ezra.2.43","r":"Ezra.2.43","rawR":"Ezra.2.43","sourceRefs":[{"raw":"Ezra.2.43","value":"Ezra.2.43"}],"t":"ref","v":"Ezr 2:43"},"; ",{"href":"?bref=Neh.7.46","r":"Neh.7.46","rawR":"Neh.7.46","sourceRefs":[{"raw":"Neh.7.46","value":"Neh.7.46"}],"t":"ref","v":"Neh 7:46"},")."],"sourceClass":"list","t":"p"},{"c":["2. Overseer of the temple servants living at Ophel during the postexilic era (",{"href":"?bref=Neh.11.21","r":"Neh.11.21","rawR":"Neh.11.21","sourceRefs":[{"raw":"Neh.11.21","value":"Neh.11.21"}],"t":"ref","v":"Neh 11:21"},"). If Ziha is simply a family name, then this person is likely the same as #1 above."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Ziha","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ezr 2:43","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.2.43","rawQueryValue":"Ezra.2.43","sourceRefExact":"Ezra.2.43"},{"anchorText":"Neh 7:46","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.7.46","rawQueryValue":"Neh.7.46","sourceRefExact":"Neh.7.46"},{"anchorText":"Neh 11:21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.11.21","rawQueryValue":"Neh.11.21","sourceRefExact":"Neh.11.21"}],"sourceItemFragmentSha256":"a8558528c393041f74323ba6800bf5b5f8835d646156fad48a255d75da4c3803","sourceItemName":"Ziha","sourceItemOrder":113,"sourceMember":"Articles/Z.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Ziha","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Ziha","title":"Ziha","version":"v2-a101d843a2f0cd3fc0c6"}