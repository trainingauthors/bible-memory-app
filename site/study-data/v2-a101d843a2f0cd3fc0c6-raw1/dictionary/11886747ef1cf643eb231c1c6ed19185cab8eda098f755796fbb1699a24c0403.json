{"content":[{"c":["NACON"],"sourceClass":"h1","t":"p"},{"c":["A place David passed when he brought the ark from Baale-judah (Kiriath-jearim) to Jerusalem. At the threshing floor of Nacon, Uzzah was struck dead for touching the ark (",{"href":"?bref=2Sam.6.6","r":"2Sam.6.6","rawR":"2Sam.6.6","sourceRefs":[{"raw":"2Sam.6.6","value":"2Sam.6.6"}],"t":"ref","v":"2 Sm 6:6"},"). Hence, this place was called Perez-uzzah, meaning “the breaking forth upon Uzzah” (v ",{"href":"?bref=2Sam.6.8","r":"2Sam.6.8","rawR":"2Sam.6.8","sourceRefs":[{"raw":"2Sam.6.8","value":"2Sam.6.8"}],"t":"ref","v":"8"},"). Nacon is alternately called Kidon in ",{"href":"?bref=1Chr.13.9","r":"1Chr.13.9","rawR":"1Chr.13.9","sourceRefs":[{"raw":"1Chr.13.9","value":"1Chr.13.9"}],"t":"ref","v":"1 Chronicles 13:9"}," (see ",{"c":["nlt"],"sourceClass":"sc","t":"span"}," mg)."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Nacon","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Sm 6:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.6.6","rawQueryValue":"2Sam.6.6","sourceRefExact":"2Sam.6.6"},{"anchorText":"8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.6.8","rawQueryValue":"2Sam.6.8","sourceRefExact":"2Sam.6.8"},{"anchorText":"1 Chronicles 13:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.13.9","rawQueryValue":"1Chr.13.9","sourceRefExact":"1Chr.13.9"}],"sourceItemFragmentSha256":"da9b603312ea46c004779fc49e42abf5f1bb11d49bb3493244c92f69675bed22","sourceItemName":"Nacon","sourceItemOrder":19,"sourceMember":"Articles/N.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Nacon","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Nacon","title":"Nacon","version":"v2-a101d843a2f0cd3fc0c6"}