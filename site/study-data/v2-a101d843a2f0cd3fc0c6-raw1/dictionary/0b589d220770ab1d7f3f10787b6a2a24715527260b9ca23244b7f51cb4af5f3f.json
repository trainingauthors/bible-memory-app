{"content":[{"c":["JUNIA"],"sourceClass":"h1","t":"p"},{"c":["A Jew who, along with Andronicus, was greeted by Paul in his letter to the church in Rome—according to the reading of some manuscripts (",{"href":"?bref=Rom.16.7","r":"Rom.16.7","rawR":"Rom.16.7","sourceRefs":[{"raw":"Rom.16.7","value":"Rom.16.7"}],"t":"ref","v":"Rom 16:7"},"). Paul recognized Junia as an apostle who had been a prisoner with Paul for the sake of the gospel. This person could have been a male or female. ",{"c":["See"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Julia_Article_TyndaleOpenBibleDictionary","id":"Julia_Article_TyndaleOpenBibleDictionary","rawId":"Julia_Article_TyndaleOpenBibleDictionary","t":"link","v":"Julia #2"},"."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Junia","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Rom 16:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rom.16.7","rawQueryValue":"Rom.16.7","sourceRefExact":"Rom.16.7"}],"sourceItemFragmentSha256":"eaa00b7debda25ae72e3b5998b49772a5183d9ca517049281b0006e19e10b47a","sourceItemName":"Junia","sourceItemOrder":371,"sourceMember":"Articles/J.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Junia","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Junia","title":"Junia","version":"v2-a101d843a2f0cd3fc0c6"}