{"content":[{"c":["SILVERSMITH"],"sourceClass":"h1","t":"p"},{"c":["One who refined silver-bearing ore and then cast it or beat it into the desired shape. Silversmiths produced musical instruments like trumpets (",{"href":"?bref=Num.10.2","r":"Num.10.2","rawR":"Num.10.2","sourceRefs":[{"raw":"Num.10.2","value":"Num.10.2"}],"t":"ref","v":"Nm 10:2"},"), bases on which the frame of the tabernacle rested (",{"href":"?bref=Exod.26.19-25","r":"Exod.26.19-25","rawR":"Exod.26.19-25","sourceRefs":[{"raw":"Exod.26.19-25","value":"Exod.26.19-25"}],"t":"ref","v":"Ex 26:19-25"},"), and objects for use in the tabernacle and temple (",{"href":"?bref=Num.7.13-85","r":"Num.7.13-85","rawR":"Num.7.13-85","sourceRefs":[{"raw":"Num.7.13-85","value":"Num.7.13-85"}],"t":"ref","v":"Nm 7:13-85"},"), as well as ornaments for private use. Silversmiths also made religious statues for false worship (",{"href":"?bref=Exod.20.23","r":"Exod.20.23","rawR":"Exod.20.23","sourceRefs":[{"raw":"Exod.20.23","value":"Exod.20.23"}],"t":"ref","v":"Ex 20:23"},"; ",{"href":"?bref=Judg.17.4","r":"Judg.17.4","rawR":"Judg.17.4","sourceRefs":[{"raw":"Judg.17.4","value":"Judg.17.4"}],"t":"ref","v":"Jgs 17:4"},"). The silversmith Demetrius (",{"href":"?bref=Acts.19.24","r":"Acts.19.24","rawR":"Acts.19.24","sourceRefs":[{"raw":"Acts.19.24","value":"Acts.19.24"}],"t":"ref","v":"Acts 19:24"},") made silver shrines for Artemis at Ephesus. The profession was well known in NT times (",{"href":"?bref=2Tim.2.20","r":"2Tim.2.20","rawR":"2Tim.2.20","sourceRefs":[{"raw":"2Tim.2.20","value":"2Tim.2.20"}],"t":"ref","v":"2 Tm 2:20"},"; ",{"href":"?bref=Rev.9.20","r":"Rev.9.20","rawR":"Rev.9.20","sourceRefs":[{"raw":"Rev.9.20","value":"Rev.9.20"}],"t":"ref","v":"Rv 9:20"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Silversmith","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Nm 10:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.10.2","rawQueryValue":"Num.10.2","sourceRefExact":"Num.10.2"},{"anchorText":"Ex 26:19-25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.26.19-25","rawQueryValue":"Exod.26.19-25","sourceRefExact":"Exod.26.19-25"},{"anchorText":"Nm 7:13-85","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.7.13-85","rawQueryValue":"Num.7.13-85","sourceRefExact":"Num.7.13-85"},{"anchorText":"Ex 20:23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.20.23","rawQueryValue":"Exod.20.23","sourceRefExact":"Exod.20.23"},{"anchorText":"Jgs 17:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.17.4","rawQueryValue":"Judg.17.4","sourceRefExact":"Judg.17.4"},{"anchorText":"Acts 19:24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.19.24","rawQueryValue":"Acts.19.24","sourceRefExact":"Acts.19.24"},{"anchorText":"2 Tm 2:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Tim.2.20","rawQueryValue":"2Tim.2.20","sourceRefExact":"2Tim.2.20"},{"anchorText":"Rv 9:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.9.20","rawQueryValue":"Rev.9.20","sourceRefExact":"Rev.9.20"}],"sourceItemFragmentSha256":"2c6cf184a13cad7b305a6a0ab21257d952187ce49dfab35bba4ae90d3464bfcb","sourceItemName":"Silversmith","sourceItemOrder":423,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Silversmith","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Silversmith","title":"Silversmith","version":"v2-a101d843a2f0cd3fc0c6"}