{"content":[{"c":["BLASTUS"],"sourceClass":"h1","t":"p"},{"c":["Royal secretary to Herod Agrippa I (",{"href":"?bref=Acts.12.20","r":"Acts.12.20","rawR":"Acts.12.20","sourceRefs":[{"raw":"Acts.12.20","value":"Acts.12.20"}],"t":"ref","v":"Acts 12:20"},"). The cities of Tyre and Sidon were looked down upon by Herod, so when their delegates wanted an appointment with the king when he was in nearby Caesarea, they approached him through Blastus. Herod addressed them and was struck by a fatal illness for accepting their worship (vv ",{"href":"?bref=Acts.12.21-23","r":"Acts.12.21-23","rawR":"Acts.12.21-23","sourceRefs":[{"raw":"Acts.12.21-23","value":"Acts.12.21-23"}],"t":"ref","v":"21-23"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Blastus","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Acts 12:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.12.20","rawQueryValue":"Acts.12.20","sourceRefExact":"Acts.12.20"},{"anchorText":"21-23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.12.21-23","rawQueryValue":"Acts.12.21-23","sourceRefExact":"Acts.12.21-23"}],"sourceItemFragmentSha256":"b374ef5191f69ae469af276e6e015428e2d395571f4efa69c7c98f7383f16ba8","sourceItemName":"Blastus","sourceItemOrder":343,"sourceMember":"Articles/B.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Blastus","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Blastus","title":"Blastus","version":"v2-a101d843a2f0cd3fc0c6"}