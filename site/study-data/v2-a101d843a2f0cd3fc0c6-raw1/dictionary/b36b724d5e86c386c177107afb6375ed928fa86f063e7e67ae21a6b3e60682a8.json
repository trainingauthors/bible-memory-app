{"content":[{"c":["ENOSH"],"sourceClass":"h1","t":"p"},{"c":["Seth’s son and the grandson of Adam (",{"href":"?bref=Gen.4.26","r":"Gen.4.26","rawR":"Gen.4.26","sourceRefs":[{"raw":"Gen.4.26","value":"Gen.4.26"}],"t":"ref","v":"Gn 4:26"},"; ",{"href":"?bref=1Chr.1.1","r":"1Chr.1.1","rawR":"1Chr.1.1","sourceRefs":[{"raw":"1Chr.1.1","value":"1Chr.1.1"}],"t":"ref","v":"1 Chr 1:1"},"). He became the father of Kenan at 90 years of age, after which he fathered other sons and daughters, dying at the age of 905 (",{"href":"?bref=Gen.5.6-11","r":"Gen.5.6-11","rawR":"Gen.5.6-11","sourceRefs":[{"raw":"Gen.5.6-11","value":"Gen.5.6-11"}],"t":"ref","v":"Gn 5:6-11"},"). He is mentioned as Jesus’ ancestor in Luke’s genealogy (",{"href":"?bref=Luke.3.38","r":"Luke.3.38","rawR":"Luke.3.38","sourceRefs":[{"raw":"Luke.3.38","value":"Luke.3.38"}],"t":"ref","v":"Lk 3:38"},"; ",{"c":["kjv"],"sourceClass":"sc","t":"span"},", ",{"c":["rsv"],"sourceClass":"sc","t":"span"}," “Enos”). ",{"c":["See"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=GenealogyofJesusChrist_Article_TyndaleOpenBibleDictionary","id":"GenealogyofJesusChrist_Article_TyndaleOpenBibleDictionary","rawId":"GenealogyofJesusChrist_Article_TyndaleOpenBibleDictionary","t":"link","v":"Genealogy of Jesus Christ"},"."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Enosh","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 4:26","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.4.26","rawQueryValue":"Gen.4.26","sourceRefExact":"Gen.4.26"},{"anchorText":"1 Chr 1:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.1.1","rawQueryValue":"1Chr.1.1","sourceRefExact":"1Chr.1.1"},{"anchorText":"Gn 5:6-11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.5.6-11","rawQueryValue":"Gen.5.6-11","sourceRefExact":"Gen.5.6-11"},{"anchorText":"Lk 3:38","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.3.38","rawQueryValue":"Luke.3.38","sourceRefExact":"Luke.3.38"}],"sourceItemFragmentSha256":"a590941ae6d93c8df4661e44826dd8232b94d2204410460bc199700ec83a7c67","sourceItemName":"Enosh","sourceItemOrder":180,"sourceMember":"Articles/E.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Enosh","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Enosh","title":"Enosh","version":"v2-a101d843a2f0cd3fc0c6"}