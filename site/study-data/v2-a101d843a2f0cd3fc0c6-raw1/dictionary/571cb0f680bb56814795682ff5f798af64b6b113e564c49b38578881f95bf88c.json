{"content":[{"c":["BAANA"],"sourceClass":"h1","t":"p"},{"c":["1. Ahilud’s son, one of 12 officers appointed to requisition food for King Solomon’s household. He served in the district of Taanach and Megiddo (",{"href":"?bref=1Kgs.4.12","r":"1Kgs.4.12","rawR":"1Kgs.4.12","sourceRefs":[{"raw":"1Kgs.4.12","value":"1Kgs.4.12"}],"t":"ref","v":"1 Kgs 4:12"},")."],"sourceClass":"list","t":"p"},{"c":["2. Hushai’s son, another of King Solomon’s supply officers; his district was Asher and Aloth (",{"href":"?bref=1Kgs.4.16","r":"1Kgs.4.16","rawR":"1Kgs.4.16","sourceRefs":[{"raw":"1Kgs.4.16","value":"1Kgs.4.16"}],"t":"ref","v":"1 Kgs 4:16"},")."],"sourceClass":"list","t":"p"},{"c":["3. Zadok’s father. Zadok helped Nehemiah rebuild the Jerusalem wall (",{"href":"?bref=Neh.3.4","r":"Neh.3.4","rawR":"Neh.3.4","sourceRefs":[{"raw":"Neh.3.4","value":"Neh.3.4"}],"t":"ref","v":"Neh 3:4"},"). He is possibly the same as Baanah (",{"href":"?bref=Neh.10.27","r":"Neh.10.27","rawR":"Neh.10.27","sourceRefs":[{"raw":"Neh.10.27","value":"Neh.10.27"}],"t":"ref","v":"Neh 10:27"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Baana","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Kgs 4:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.4.12","rawQueryValue":"1Kgs.4.12","sourceRefExact":"1Kgs.4.12"},{"anchorText":"1 Kgs 4:16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.4.16","rawQueryValue":"1Kgs.4.16","sourceRefExact":"1Kgs.4.16"},{"anchorText":"Neh 3:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.3.4","rawQueryValue":"Neh.3.4","sourceRefExact":"Neh.3.4"},{"anchorText":"Neh 10:27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.10.27","rawQueryValue":"Neh.10.27","sourceRefExact":"Neh.10.27"}],"sourceItemFragmentSha256":"21d965fb13e7b1b21443dd741ad0c38edc3a331ff10ff1b80db13a90dc77e061","sourceItemName":"Baana","sourceItemOrder":24,"sourceMember":"Articles/B.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Baana","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Baana","title":"Baana","version":"v2-a101d843a2f0cd3fc0c6"}