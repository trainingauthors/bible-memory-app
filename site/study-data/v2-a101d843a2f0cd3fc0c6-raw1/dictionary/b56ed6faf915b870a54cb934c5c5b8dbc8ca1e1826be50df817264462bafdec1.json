{"content":[{"c":["PSYCHICS"],"sourceClass":"h1","t":"p"},{"c":["People who have contact with supernatural forces and who claim to be able to interpret their intentions. In the OT, such people are grouped with “mediums”—that is, people who claim to mediate between supernatural forces and human beings. The Scriptures everywhere prohibit God’s people to use the services of psychics or mediums (",{"href":"?bref=Lev.19.31","r":"Lev.19.31","rawR":"Lev.19.31","sourceRefs":[{"raw":"Lev.19.31","value":"Lev.19.31"}],"t":"ref","v":"Lv 19:31"},"; ",{"href":"?bref=Lev.20.6,27","r":"Lev.20.6,27","rawR":"Lev.20.6,27","sourceRefs":[{"raw":"Lev.20.6,27","value":"Lev.20.6,27"}],"t":"ref","v":"20:6, 27"},")."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Magic_Article_TyndaleOpenBibleDictionary","id":"Magic_Article_TyndaleOpenBibleDictionary","rawId":"Magic_Article_TyndaleOpenBibleDictionary","t":"link","v":"Magic"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Psychics","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Lv 19:31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Lev.19.31","rawQueryValue":"Lev.19.31","sourceRefExact":"Lev.19.31"},{"anchorText":"20:6, 27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Lev.20.6,27","rawQueryValue":"Lev.20.6,27","sourceRefExact":"Lev.20.6,27"}],"sourceItemFragmentSha256":"42cb035b933e60f6ea8c16e61a1d3524c467b2695a926d6ce5c47b7a29f1213a","sourceItemName":"Psychics","sourceItemOrder":300,"sourceMember":"Articles/P.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Psychics","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Psychics","title":"Psychics","version":"v2-a101d843a2f0cd3fc0c6"}