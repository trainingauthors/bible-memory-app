{"content":[{"c":["JAAZIEL"],"sourceClass":"h1","t":"p"},{"c":["One of the eight men appointed to play harps or lyres when the ark was brought up to Jerusalem by David (",{"href":"?bref=1Chr.15.18-20","r":"1Chr.15.18-20","rawR":"1Chr.15.18-20","sourceRefs":[{"raw":"1Chr.15.18-20","value":"1Chr.15.18-20"}],"t":"ref","v":"1 Chr 15:18-20"},"; and probably ",{"href":"?bref=1Chr.16.5","r":"1Chr.16.5","rawR":"1Chr.16.5","sourceRefs":[{"raw":"1Chr.16.5","value":"1Chr.16.5"}],"t":"ref","v":"16:5a"},", “Jeiel,” which is most likely a copyist’s error). He is called Aziel in verse ",{"href":"?bref=1Chr.15.20","r":"1Chr.15.20","rawR":"1Chr.15.20","sourceRefs":[{"raw":"1Chr.15.20","value":"1Chr.15.20"}],"t":"ref","v":"20"},"."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Jaaziel","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 15:18-20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.15.18-20","rawQueryValue":"1Chr.15.18-20","sourceRefExact":"1Chr.15.18-20"},{"anchorText":"16:5a","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.16.5","rawQueryValue":"1Chr.16.5","sourceRefExact":"1Chr.16.5"},{"anchorText":"20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.15.20","rawQueryValue":"1Chr.15.20","sourceRefExact":"1Chr.15.20"}],"sourceItemFragmentSha256":"e294459899474b3b91a6f04ede1fa1280a45031ffca0321301b9ec0c2e0d39ae","sourceItemName":"Jaaziel","sourceItemOrder":15,"sourceMember":"Articles/J.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Jaaziel","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Jaaziel","title":"Jaaziel","version":"v2-a101d843a2f0cd3fc0c6"}