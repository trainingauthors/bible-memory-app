{"content":[{"c":["JEARIM, Mount"],"sourceClass":"h1","t":"p"},{"c":["Mountain on the northwest border of Judah’s territory between Beth-shemesh and Kiriath-jearim. Kesalon was located on its northern slope (",{"href":"?bref=Josh.15.10","r":"Josh.15.10","rawR":"Josh.15.10","sourceRefs":[{"raw":"Josh.15.10","value":"Josh.15.10"}],"t":"ref","v":"Jos 15:10"},"). It is associated with Mt Seir and Mt Ephron."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Kesalon_Article_TyndaleOpenBibleDictionary","id":"Kesalon_Article_TyndaleOpenBibleDictionary","rawId":"Kesalon_Article_TyndaleOpenBibleDictionary","t":"link","v":"Kesalon"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"JearimMount","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 15:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.10","rawQueryValue":"Josh.15.10","sourceRefExact":"Josh.15.10"}],"sourceItemFragmentSha256":"d504c31209974cb67ce418dff64cee46d0590b80980d4adeb723de9b845127b5","sourceItemName":"JearimMount","sourceItemOrder":118,"sourceMember":"Articles/J.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"JearimMount","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Jearim, Mount","title":"Jearim, Mount","version":"v2-a101d843a2f0cd3fc0c6"}