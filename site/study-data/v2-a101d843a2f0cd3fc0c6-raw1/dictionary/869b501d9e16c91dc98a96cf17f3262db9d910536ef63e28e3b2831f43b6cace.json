{"content":[{"c":["CUSHAN-RISHATHAIM"],"sourceClass":"h1","t":"p"},{"c":["King of Mesopotamia whom Israel served for eight years. The Lord raised up Othniel, Kenaz’s son, to deliver Israel out of his hand; later, Cushan-rishathaim was defeated by Othniel in war (",{"href":"?bref=Judg.3.8-10","r":"Judg.3.8-10","rawR":"Judg.3.8-10","sourceRefs":[{"raw":"Judg.3.8-10","value":"Judg.3.8-10"}],"t":"ref","v":"Jgs 3:8-10"},"). His exact identity is uncertain."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"CushanRishathaim","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jgs 3:8-10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.3.8-10","rawQueryValue":"Judg.3.8-10","sourceRefExact":"Judg.3.8-10"}],"sourceItemFragmentSha256":"fb2bef68f9a4a37d954ee619588c99ac6aac7a475b0237430d45d9f6cb53d4cb","sourceItemName":"CushanRishathaim","sourceItemOrder":345,"sourceMember":"Articles/C.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"CushanRishathaim","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Cushan-Rishathaim","title":"Cushan-Rishathaim","version":"v2-a101d843a2f0cd3fc0c6"}