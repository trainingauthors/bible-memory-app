ceRefExact":"Gen.23.1-20"},{"anchorText":"Isaiah 51:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.51.2","rawQueryValue":"Isa.51.2","sourceRefExact":"Isa.51.2"},{"anchorText":"Romans 4:19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rom.4.19","rawQueryValue":"Rom.4.19","sourceRefExact":"Rom.4.19"},{"anchorText":"9:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rom.9.9","rawQueryValue":"Rom.9.9","sourceRefExact":"Rom.9.9"},{"anchorText":"Hebrews 11:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Heb.11.11","rawQueryValue":"Heb.11.11","sourceRefExact":"Heb.11.11"},{"anchorText":"1 Peter 3:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Pet.3.6","rawQueryValue":"1Pet.3.6","sourceRefExact":"1Pet.3.6"},{"anchorText":"Galatians 4:21-31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gal.4.21-31","rawQueryValue":"Gal.4.21-31","sourceRefExact":"Gal.4.21-31"},{"anchorText":"Numbers 26:46","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.26.46","rawQueryValue":"Num.26.46","sourceRefExact":"Num.26.46"},{"anchorText":"Tb 6:9ff","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Tb.6.9-27","rawQueryValue":"Tb.6.9-27","sourceRefExact":"Tb.6.9-27"},{"anchorText":"8:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Tb.8.2","rawQueryValue":"Tb.8.2","sourceRefExact":"Tb.8.2"},{"anchorText":"14:12ff","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Tb.14.12-45","rawQueryValue":"Tb.14.12-45","sourceRefExact":"Tb.14.12-45"}],"sourceItemFragmentSha256":"a8108b3bfa5a6446b06de9d5ad4f861d6836450f0147660dba98958708912458","sourceItemName":"Sarah","sourceItemOrder":65,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Sarah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Sarah","title":"Sarah","version":"v2-a101d843a2f0cd3fc0c6"}