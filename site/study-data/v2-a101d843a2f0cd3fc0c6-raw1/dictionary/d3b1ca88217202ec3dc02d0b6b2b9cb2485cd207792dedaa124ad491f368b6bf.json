{"content":[{"c":["HOGLAH"],"sourceClass":"h1","t":"p"},{"c":["One of Zelophehad’s five daughters (",{"href":"?bref=Num.26.33","r":"Num.26.33","rawR":"Num.26.33","sourceRefs":[{"raw":"Num.26.33","value":"Num.26.33"}],"t":"ref","v":"Nm 26:33"},"; ",{"href":"?bref=Num.27.1","r":"Num.27.1","rawR":"Num.27.1","sourceRefs":[{"raw":"Num.27.1","value":"Num.27.1"}],"t":"ref","v":"27:1"},"; ",{"href":"?bref=Josh.17.3","r":"Josh.17.3","rawR":"Josh.17.3","sourceRefs":[{"raw":"Josh.17.3","value":"Josh.17.3"}],"t":"ref","v":"Jos 17:3"},"). Zelophehad, who was of Manasseh’s tribe, had no sons, so that his inheritance passed to his daughters. They married within their own tribe according to God’s command, so that their land remained in the tribe of the family of their father (",{"href":"?bref=Num.36.11-12","r":"Num.36.11-12","rawR":"Num.36.11-12","sourceRefs":[{"raw":"Num.36.11-12","value":"Num.36.11-12"}],"t":"ref","v":"Nm 36:11-12"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Hoglah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Nm 26:33","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.26.33","rawQueryValue":"Num.26.33","sourceRefExact":"Num.26.33"},{"anchorText":"27:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.27.1","rawQueryValue":"Num.27.1","sourceRefExact":"Num.27.1"},{"anchorText":"Jos 17:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.17.3","rawQueryValue":"Josh.17.3","sourceRefExact":"Josh.17.3"},{"anchorText":"Nm 36:11-12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.36.11-12","rawQueryValue":"Num.36.11-12","sourceRefExact":"Num.36.11-12"}],"sourceItemFragmentSha256":"0d0cee9c9041239bd63d77dbc14530a05f04b9b968202ad78e7ca18d9b84f5f7","sourceItemName":"Hoglah","sourceItemO