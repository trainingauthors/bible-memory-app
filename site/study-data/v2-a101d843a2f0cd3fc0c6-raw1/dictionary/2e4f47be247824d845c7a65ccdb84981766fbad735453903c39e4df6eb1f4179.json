{"content":[{"c":["BETH-MILLO"],"sourceClass":"h1","t":"p"},{"c":["House or fortress associated with the city of Shechem mentioned in connection with the crowning of Abimelech (son of Gideon) as king there (",{"href":"?bref=Judg.9.6,20","r":"Judg.9.6,20","rawR":"Judg.9.6,20","sourceRefs":[{"raw":"Judg.9.6,20","value":"Judg.9.6,20"}],"t":"ref","v":"Jgs 9:6, 20"},"). Since the term “millo” probably means “mount” or “earthwork,” Beth-millo is often identified with the “tower of Shechem” mentioned later in the same chapter (",{"href":"?bref=Judg.9.46-49","r":"Judg.9.46-49","rawR":"Judg.9.46-49","sourceRefs":[{"raw":"Judg.9.46-49","value":"Judg.9.46-49"}],"t":"ref","v":"Jgs 9:46-49"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"BethMillo","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jgs 9:6, 20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.9.6,20","rawQueryValue":"Judg.9.6,20","sourceRefExact":"Judg.9.6,20"},{"anchorText":"Jgs 9:46-49","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.9.46-49","rawQueryValue":"Judg.9.46-49","sourceRefExact":"Judg.9.46-49"}],"sourceItemFragmentSha256":"fe59c51e9af821de0454498654e4718f20a481868f2c0a2b54b72fdc3cfca3b0","sourceItemName":"BethMillo","sourceItemOrder":265,"sourceMember":"Articles/B.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"BethMillo","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Beth-Millo","title":"Beth-Millo","version":"v2-a101d843a2f0cd3fc0c6"}