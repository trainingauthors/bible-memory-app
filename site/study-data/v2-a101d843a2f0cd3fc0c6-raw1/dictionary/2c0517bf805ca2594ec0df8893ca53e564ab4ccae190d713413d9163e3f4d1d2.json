{"content":[{"c":["ISSHIAH"],"sourceClass":"h1","t":"p"},{"c":["1. Izrahiah’s son from Issachar’s tribe (",{"href":"?bref=1Chr.7.3","r":"1Chr.7.3","rawR":"1Chr.7.3","sourceRefs":[{"raw":"1Chr.7.3","value":"1Chr.7.3"}],"t":"ref","v":"1 Chr 7:3"},")."],"sourceClass":"list","t":"p"},{"c":["2. Warrior from Benjamin’s tribe who joined David in his struggle against King Saul. Isshiah was one of David’s ambidextrous archers and slingers (",{"href":"?bref=1Chr.12.6","r":"1Chr.12.6","rawR":"1Chr.12.6","sourceRefs":[{"raw":"1Chr.12.6","value":"1Chr.12.6"}],"t":"ref","v":"1 Chr 12:6"},")."],"sourceClass":"list","t":"p"},{"c":["3. Uzziel’s son from Levi’s tribe (",{"href":"?bref=1Chr.23.20","r":"1Chr.23.20","rawR":"1Chr.23.20","sourceRefs":[{"raw":"1Chr.23.20","value":"1Chr.23.20"}],"t":"ref","v":"1 Chr 23:20"},"; ",{"href":"?bref=1Chr.24.25","r":"1Chr.24.25","rawR":"1Chr.24.25","sourceRefs":[{"raw":"1Chr.24.25","value":"1Chr.24.25"}],"t":"ref","v":"24:25"},")."],"sourceClass":"list","t":"p"},{"c":["4. Rehabiah’s son from Levi’s tribe and a descendant of Moses (",{"href":"?bref=1Chr.24.21","r":"1Chr.24.21","rawR":"1Chr.24.21","sourceRefs":[{"raw":"1Chr.24.21","value":"1Chr.24.21"}],"t":"ref","v":"1 Chr 24:21"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Isshiah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 7:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.7.3","rawQueryValue":"1Chr.7.3","sourceRefExact":"1Chr.7.3"},{"anchorText":"1 Chr 12:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.12.6","rawQueryValue":"1Chr.12.6","sourceRefExact":"1Chr.12.6"},{"anchorText":"1 Chr 23:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.23.20","rawQueryValue":"1Chr.23.20","sourceRefExact":"1Chr.23.20"},{"anchorText":"24:25