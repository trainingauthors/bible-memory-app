{"content":[{"c":["JOTBATHAH"],"sourceClass":"h1","t":"p"},{"c":["Temporary camping place of the Israelites during their wilderness wanderings, located between Hor-haggidgad and Abronah (",{"href":"?bref=Num.33.33-34","r":"Num.33.33-34","rawR":"Num.33.33-34","sourceRefs":[{"raw":"Num.33.33-34","value":"Num.33.33-34"}],"t":"ref","v":"Nm 33:33-34"},"). Later, following the death of Aaron, Israel journeyed from Gudgodah to this place, noted for its streams of water (",{"href":"?bref=Deut.10.7","r":"Deut.10.7","rawR":"Deut.10.7","sourceRefs":[{"raw":"Deut.10.7","value":"Deut.10.7"}],"t":"ref","v":"Dt 10:7"},")."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=WildernessWanderings_Article_TyndaleOpenBibleDictionary","id":"WildernessWanderings_Article_TyndaleOpenBibleDictionary","rawId":"WildernessWanderings_Article_TyndaleOpenBibleDictionary","t":"link","v":"Wilderness Wanderings"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Jotbathah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Nm 33:33-34","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.33.33-34","rawQueryValue":"Num.33.33-34","sourceRefExact":"Num.33.33-34"},{"anchorText":"Dt 10:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.10.7","rawQueryValue":"Deut.10.7","sourceRefExact":"Deut.10.7"}],"sourceItemFragmentSha256":"0715cf90f3313c4c2a5ae5c642ba5be93d1f670faadff9f1f8217e685d284025","sourceItemName":"Jotbathah","sourceItemOrder":336,"sourceMember":"Articles/J.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Jotbathah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Jotbathah","title":"Jotbathah","version":"v2-a101d843a2f0cd3fc0c6"}