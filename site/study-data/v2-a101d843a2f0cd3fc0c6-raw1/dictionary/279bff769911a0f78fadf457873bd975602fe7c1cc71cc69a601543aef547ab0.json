{"content":[{"c":["RAISIN"],"sourceClass":"h1","t":"p"},{"c":["Staple food in biblical lands made by drying grapes on housetops. Raisins were used as gifts (",{"href":"?bref=1Sam.25.18","r":"1Sam.25.18","rawR":"1Sam.25.18","sourceRefs":[{"raw":"1Sam.25.18","value":"1Sam.25.18"}],"t":"ref","v":"1 Sm 25:18"},"; ",{"href":"?bref=2Sam.16.1-3","r":"2Sam.16.1-3","rawR":"2Sam.16.1-3","sourceRefs":[{"raw":"2Sam.16.1-3","value":"2Sam.16.1-3"}],"t":"ref","v":"2 Sm 16:1-3"},"), sometimes offered to false gods (",{"href":"?bref=Hos.3.1","r":"Hos.3.1","rawR":"Hos.3.1","sourceRefs":[{"raw":"Hos.3.1","value":"Hos.3.1"}],"t":"ref","v":"Hos 3:1"},"), and considered a source of nourishment (",{"href":"?bref=1Sam.30.12","r":"1Sam.30.12","rawR":"1Sam.30.12","sourceRefs":[{"raw":"1Sam.30.12","value":"1Sam.30.12"}],"t":"ref","v":"1 Sm 30:12"},"; ",{"href":"?bref=1Chr.12.40","r":"1Chr.12.40","rawR":"1Chr.12.40","sourceRefs":[{"raw":"1Chr.12.40","value":"1Chr.12.40"}],"t":"ref","v":"1 Chr 12:40"},")."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=FoodandFoodPreparation_Article_TyndaleOpenBibleDictionary","id":"FoodandFoodPreparation_Article_TyndaleOpenBibleDictionary","rawId":"FoodandFoodPreparation_Article_TyndaleOpenBibleDictionary","t":"link","v":"Food and Food Preparation"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Raisin","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Sm 25:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.25.18","rawQueryValue":"1Sam.25.18","sourceRefExact":"1Sam.25.18"},{"anchorText":"2 Sm 16:1-3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.16.1-3","rawQueryValue":"2Sam.16.1-3","sourceRefExact":"2Sam.16.1-3"},{"anchorText":"Hos 3:1","canonicalization":"deferred_to_dictionary_mapping_wor