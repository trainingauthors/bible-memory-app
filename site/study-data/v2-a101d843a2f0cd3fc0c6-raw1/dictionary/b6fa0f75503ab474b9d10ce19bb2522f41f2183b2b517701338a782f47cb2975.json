{"content":[{"c":["MATTANAH"],"sourceClass":"h1","t":"p"},{"c":["Place of encampment for Israel following the exodus as the company moved east of the Dead Sea from the Arnon River northward into the territory of Sihon, king of the Amorites (",{"href":"?bref=Num.21.18-19","r":"Num.21.18-19","rawR":"Num.21.18-19","sourceRefs":[{"raw":"Num.21.18-19","value":"Num.21.18-19"}],"t":"ref","v":"Nm 21:18-19"},"). Its exact location is unknown, but Khirbet el-Medeiyineh on the left bank of Wadi eth-Themed is considered its most likely setting."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Mattanah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Nm 21:18-19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.21.18-19","rawQueryValue":"Num.21.18-19","sourceRefExact":"Num.21.18-19"}],"sourceItemFragmentSha256":"931313507fb0ad5e9b62cef70ed61456f58a6cd51747d8be5840a9a445f03f2d","sourceItemName":"Mattanah","sourceItemOrder":172,"sourceMember":"Articles/M.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Mattanah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Mattanah","title":"Mattanah","version":"v2-a101d843a2f0cd3fc0c6"}