{"content":[{"c":["SHUAH"],"sourceClass":"h1","t":"p"},{"c":["1. One of six sons borne to Abraham by Keturah (",{"href":"?bref=Gen.25.2","r":"Gen.25.2","rawR":"Gen.25.2","sourceRefs":[{"raw":"Gen.25.2","value":"Gen.25.2"}],"t":"ref","v":"Gn 25:2"},"; ",{"href":"?bref=1Chr.1.32","r":"1Chr.1.32","rawR":"1Chr.1.32","sourceRefs":[{"raw":"1Chr.1.32","value":"1Chr.1.32"}],"t":"ref","v":"1 Chr 1:32"},"). He was perhaps the forefather of the Shuhite Arab tribe that dwelt near the land of Uz (",{"href":"?bref=Job.2.11","r":"Job.2.11","rawR":"Job.2.11","sourceRefs":[{"raw":"Job.2.11","value":"Job.2.11"}],"t":"ref","v":"Jb 2:11"},")."],"sourceClass":"list","t":"p"},{"c":["2. KJV spelling of Shua, Judah’s father-in-law, in ",{"href":"?bref=Gen.38.2,12","r":"Gen.38.2,12","rawR":"Gen.38.2,12","sourceRefs":[{"raw":"Gen.38.2,12","value":"Gen.38.2,12"}],"t":"ref","v":"Genesis 38:2, 12"},". ",{"c":["See"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Shua_Article_TyndaleOpenBibleDictionary","id":"Shua_Article_TyndaleOpenBibleDictionary","rawId":"Shua_Article_TyndaleOpenBibleDictionary","t":"link","v":"Shua #1"},"."],"sourceClass":"list","t":"p"},{"c":["3. KJV spelling of Shuhah, Kelub’s brother, in ",{"href":"?bref=1Chr.4.11","r":"1Chr.4.11","rawR":"1Chr.4.11","sourceRefs":[{"raw":"1Chr.4.11","value":"1Chr.4.11"}],"t":"ref","v":"1 Chronicles 4:11"},". ",{"c":["See"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Shuhah_Article_TyndaleOpenBibleDictionary","id":"Shuhah_Article_TyndaleOpenBibleDictionary","rawId":"Shuhah_Article_TyndaleOpenBibleDictionary","t":"link","v":"Shuhah"},"."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Shuah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 25:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.25.2","rawQueryValue":"Gen.25.2","sourceRefExact":"Gen.25.2"},{"anc