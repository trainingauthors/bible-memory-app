9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.11.19","rawQueryValue":"2Kgs.11.19","sourceRefExact":"2Kgs.11.19"},{"anchorText":"1 Kgs 16:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.16.11","rawQueryValue":"1Kgs.16.11","sourceRefExact":"1Kgs.16.11"},{"anchorText":"2 Kgs 13:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.13.13","rawQueryValue":"2Kgs.13.13","sourceRefExact":"2Kgs.13.13"},{"anchorText":"1 Kgs 2:24, 45","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.2.24,45","rawQueryValue":"1Kgs.2.24,45","sourceRefExact":"1Kgs.2.24,45"},{"anchorText":"Is 9:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.9.7","rawQueryValue":"Isa.9.7","sourceRefExact":"Isa.9.7"},{"anchorText":"1 Kgs 10:18-20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.10.18-20","rawQueryValue":"1Kgs.10.18-20","sourceRefExact":"1Kgs.10.18-20"},{"anchorText":"1:47","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.1.47","rawQueryValue":"1Kgs.1.47","sourceRefExact":"1Kgs.1.47"},{"anchorText":"2 Sm 13:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.13.7","rawQueryValue":"2Sam.13.7","sourceRefExact":"2Sam.13.7"},{"anchorText":"18-19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.13.18-19","rawQueryValue":"2Sam.13.18-19","sourceRefExact":"2Sam.13.18-19"},{"anchorText":"2 Kgs 11:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.11.2","rawQueryValue":"2Kgs.11.2","sourceRefExact":"2Kgs.11.2"},{"anchorText":"10:1, 6-7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.10.1,6-7","rawQueryValue":"2Kgs.10.1,6-7","sourceRefExact":"2Kgs.10.1,6-7"},{"anchorText":"2 Sm 8:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.8.18","rawQueryValue":"2Sam.8.18","sourceRefExact":"2Sam.8.18"},{"anchorText":"1 Chr 18:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.18.17","rawQueryValue":"1Chr.18.17","sourceRefExact":"1Chr.18.17"},{"anchorText":"2 Chr 21:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.21.3","rawQueryValue":"2Chr.21.3","sourceRefExact":"2Chr.21.3"},{"anchorText":"2 Sm 13:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.13.5","rawQueryValue":"2Sam.13.5","sourceRefExact":"2Sam.13.5"},{"anchorText":"13:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.13.20","rawQueryValue":"2Sam.13.20","sourceRefExact":"2Sam.13.20"},{"anchorText":"14:24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.14.24","rawQueryValue":"2Sam.14.24","sourceRefExact":"2Sam.14.24"},{"anchorText":"13:23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.13.23","rawQueryValue":"2Sam.13.23","sourceRefExact":"2Sam.13.23"},{"anchorText":"14:30","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.14.30","rawQueryValue":"2Sam.14.30","sourceRefExact":"2Sam.14.30"},{"anchorText":"1 Kgs 10:4-5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.10.4-5","rawQueryValue":"1Kgs.10.4-5","sourceRefExact":"1Kgs.10.4-5"},{"anchorText":"2 Sm 14:24, 28, 32","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.14.24,28,32","rawQueryValue":"2Sam.14.24,28,32","sourceRefExact":"2Sam.14.24,28,32"},{"anchorText":"1 Sm 16:21-22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.16.21-22","rawQueryValue":"1Sam.16.21-22","sourceRefExact":"1Sam.16.21-22"},{"anchorText":"Jer 52:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.52.12","rawQueryValue":"Jer.52.12","sourceRefExact":"Jer.52.12"},{"anchorText":"2 Sm 9:7, 13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.9.7,13","rawQueryValue":"2Sam.9.7,13","sourceRefExact":"2Sam.9.7,13"}],"sourceItemFragmentSha256":"253d35e845cd44cdb663abb4d8c42fe3ed57b7d79dac9a3e3922bf5efe3bca6e","sourceItemName":"Palace","sourceItemOrder":9,"sourceMember":"Articles/P.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Palace","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Palace","title":"Palace","version":"v2-a101d843a2f0cd3fc0c6"}