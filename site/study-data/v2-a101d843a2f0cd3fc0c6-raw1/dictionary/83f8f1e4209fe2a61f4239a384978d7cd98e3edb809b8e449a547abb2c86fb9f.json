{"content":[{"c":["SOSTHENES"],"sourceClass":"h1","t":"p"},{"c":["1. Leader of the synagogue in Corinth who brought legal action against Paul before Gallio, proconsul of Achaia. Upon hearing Gallio’s dismissal of the Jewish accusations against Paul, a mob, possibly of Greeks, seized Sosthenes and beat him (",{"href":"?bref=Acts.18.17","r":"Acts.18.17","rawR":"Acts.18.17","sourceRefs":[{"raw":"Acts.18.17","value":"Acts.18.17"}],"t":"ref","v":"Acts 18:17"},")."],"sourceClass":"list","t":"p"},{"c":["2. Christian brother and companion of Paul, known to the Christians at Corinth and mentioned by Paul in ",{"href":"?bref=1Cor.1.1","r":"1Cor.1.1","rawR":"1Cor.1.1","sourceRefs":[{"raw":"1Cor.1.1","value":"1Cor.1.1"}],"t":"ref","v":"1 Corinthians 1:1"},"."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Sosthenes","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Acts 18:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.18.17","rawQueryValue":"Acts.18.17","sourceRefExact":"Acts.18.17"},{"anchorText":"1 Corinthians 1:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Cor.1.1","rawQueryValue":"1Cor.1.1","sourceRefExact":"1Cor.1.1"}],"sourceItemFragmentSha256":"56fd7d959eee478e7b07c92788d335c813a7fdcbc3ed5d102e727e7293ccf0ac","sourceItemName":"Sosthenes","sourceItemOrder":511,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Sosthenes","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Sosthenes","title":"Sosthenes","version":"v2-a101d843a2f0cd3fc0c6"}