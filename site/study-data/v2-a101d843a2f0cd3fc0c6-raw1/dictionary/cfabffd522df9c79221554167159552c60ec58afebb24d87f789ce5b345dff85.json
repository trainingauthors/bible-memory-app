{"content":[{"c":["SEIR (P",{"c":["erson"],"sourceClass":"lc","t":"span"},")"],"sourceClass":"h1","t":"p"},{"c":["Father of seven sons and a descendant of Abraham through Esau’s line. Originally a Horite tribe dwelling in the land of Edom, the nation descended from Seir was first dispossessed by, but later intermarried with, Esau’s descendants. Perhaps for this reason Seir and his offspring were included in the genealogies of Abraham (",{"href":"?bref=Gen.36.20-21","r":"Gen.36.20-21","rawR":"Gen.36.20-21","sourceRefs":[{"raw":"Gen.36.20-21","value":"Gen.36.20-21"}],"t":"ref","v":"Gn 36:20-21"},"; ",{"href":"?bref=1Chr.1.38","r":"1Chr.1.38","rawR":"1Chr.1.38","sourceRefs":[{"raw":"1Chr.1.38","value":"1Chr.1.38"}],"t":"ref","v":"1 Chr 1:38"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"SeirPerson","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 36:20-21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.36.20-21","rawQueryValue":"Gen.36.20-21","sourceRefExact":"Gen.36.20-21"},{"anchorText":"1 Chr 1:38","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.1.38","rawQueryValue":"1Chr.1.38","sourceRefExact":"1Chr.1.38"}],"sourceItemFragmentSha256":"001a7db2d161a9291d1ae66ae2c6033927a5c9697e7c14974cdf7b0784c35d49","sourceItemName":"SeirPerson","sourceItemOrder":134,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"SeirPerson","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Seir (Person)","title":"Seir (Person)","version":"v2-a101d843a2f0cd3fc0c6"}