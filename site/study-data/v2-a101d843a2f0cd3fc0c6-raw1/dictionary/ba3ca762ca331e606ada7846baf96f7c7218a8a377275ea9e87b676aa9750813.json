,{"anchorText":"Jn 3:3-7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=John.3.3-7","rawQueryValue":"John.3.3-7","sourceRefExact":"John.3.3-7"},{"anchorText":"Mk 14:24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mark.14.24","rawQueryValue":"Mark.14.24","sourceRefExact":"Mark.14.24"},{"anchorText":"Rom 6:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rom.6.4","rawQueryValue":"Rom.6.4","sourceRefExact":"Rom.6.4"},{"anchorText":"1 Cor 11:25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Cor.11.25","rawQueryValue":"1Cor.11.25","sourceRefExact":"1Cor.11.25"},{"anchorText":"Heb 9:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Heb.9.15","rawQueryValue":"Heb.9.15","sourceRefExact":"Heb.9.15"},{"anchorText":"10:19-20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Heb.10.19-20","rawQueryValue":"Heb.10.19-20","sourceRefExact":"Heb.10.19-20"},{"anchorText":"2 Cor 3:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Cor.3.3","rawQueryValue":"2Cor.3.3","sourceRefExact":"2Cor.3.3"},{"anchorText":"2 Cor 5:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Cor.5.17","rawQueryValue":"2Cor.5.17","sourceRefExact":"2Cor.5.17"},{"anchorText":"Gal 6:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gal.6.15","rawQueryValue":"Gal.6.15","sourceRefExact":"Gal.6.15"},{"anchorText":"Eph 2:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Eph.2.15","rawQueryValue":"Eph.2.15","sourceRefExact":"Eph.2.15"},{"anchorText":"Col 3:10-11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Col.3.10-11","rawQueryValue":"Col.3.10-11","sourceRefExact":"Col.3.10-11"},{"anchorText":"Eph 4:24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Eph.4.24","rawQueryValue":"Eph.4.24","sourceRefExact":"Eph.4.24"},{"anchorText":"Col 3:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Col.3.12","rawQueryValue":"Col.3.12","sourceRefExact":"Col.3.12"},{"anchorText":"Jn 13:34","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=John.13.34","rawQueryValue":"John.13.34","sourceRefExact":"John.13.34"},{"anchorText":"1 Jn 2:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Jn.2.8","rawQueryValue":"1Jn.2.8","sourceRefExact":"1Jn.2.8"},{"anchorText":"1 Jn 2:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Jn.2.7","rawQueryValue":"1Jn.2.7","sourceRefExact":"1Jn.2.7"},{"anchorText":"Rom 12:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rom.12.2","rawQueryValue":"Rom.12.2","sourceRefExact":"Rom.12.2"},{"anchorText":"2 Cor 4:16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Cor.4.16","rawQueryValue":"2Cor.4.16","sourceRefExact":"2Cor.4.16"},{"anchorText":"Rv 21:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.21.5","rawQueryValue":"Rev.21.5","sourceRefExact":"Rev.21.5"},{"anchorText":"2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.21.2","rawQueryValue":"Rev.21.2","sourceRefExact":"Rev.21.2"},{"anchorText":"3:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.3.12","rawQueryValue":"Rev.3.12","sourceRefExact":"Rev.3.12"},{"anchorText":"5:12-13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.5.12-13","rawQueryValue":"Rev.5.12-13","sourceRefExact":"Rev.5.12-13"}],"sourceItemFragmentSha256":"bb32b2752ab5acdafacc1e838d8566b31613ab02220565df3e7c51e9bc12b8bd","sourceItemName":"New","sourceItemOrder":120,"sourceMember":"Articles/N.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"New","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"New","title":"New","version":"v2-a101d843a2f0cd3fc0c6"}