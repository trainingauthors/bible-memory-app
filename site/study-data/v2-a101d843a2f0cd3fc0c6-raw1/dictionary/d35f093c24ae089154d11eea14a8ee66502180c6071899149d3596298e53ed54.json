{"content":[{"c":["ABISHAG"],"sourceClass":"h1","t":"p"},{"c":["Beautiful young woman from Shunem who was appointed to care for David during his last days (",{"href":"?bref=1Kgs.1.1-4","r":"1Kgs.1.1-4","rawR":"1Kgs.1.1-4","sourceRefs":[{"raw":"1Kgs.1.1-4","value":"1Kgs.1.1-4"}],"t":"ref","v":"1 Kgs 1:1-4"},"). After David’s death, Adonijah asked permission from his half brother King Solomon to marry Abishag. In the ancient Near East, to claim the concubine of a deceased king was to claim the throne. Enraged, Solomon ordered Adonijah to be killed (",{"href":"?bref=1Kgs.2.13-25","r":"1Kgs.2.13-25","rawR":"1Kgs.2.13-25","sourceRefs":[{"raw":"1Kgs.2.13-25","value":"1Kgs.2.13-25"}],"t":"ref","v":"1 Kgs 2:13-25"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Abishag","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Kgs 1:1-4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.1.1-4","rawQueryValue":"1Kgs.1.1-4","sourceRefExact":"1Kgs.1.1-4"},{"anchorText":"1 Kgs 2:13-25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.2.13-25","rawQueryValue":"1Kgs.2.13-25","sourceRefExact":"1Kgs.2.13-25"}],"sourceItemFragmentSha256":"350457b4034dbc5c5dd0183faf85605636667055bfa9fd53384c9770659fff89","sourceItemName":"Abishag","sourceItemOrder":51,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Abishag","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Abishag","title":"Abishag","version":"v2-a101d843a2f0cd3fc0c6"}