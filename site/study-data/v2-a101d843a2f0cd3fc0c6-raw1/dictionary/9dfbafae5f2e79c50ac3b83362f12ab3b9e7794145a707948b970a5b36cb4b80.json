{"content":[{"c":["TABERAH"],"sourceClass":"h1","t":"p"},{"c":["Temporary stopping place for Israel in the wilderness of Paran, listed with Massah and Kibroth-hattaavah as places where Israel complained against the Lord. Taberah was named for the fire that God used to judge the grumbling Israelites (",{"href":"?bref=Num.11.3","r":"Num.11.3","rawR":"Num.11.3","sourceRefs":[{"raw":"Num.11.3","value":"Num.11.3"}],"t":"ref","v":"Nm 11:3"},"; ",{"href":"?bref=Deut.9.22","r":"Deut.9.22","rawR":"Deut.9.22","sourceRefs":[{"raw":"Deut.9.22","value":"Deut.9.22"}],"t":"ref","v":"Dt 9:22"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Taberah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Nm 11:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.11.3","rawQueryValue":"Num.11.3","sourceRefExact":"Num.11.3"},{"anchorText":"Dt 9:22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.9.22","rawQueryValue":"Deut.9.22","sourceRefExact":"Deut.9.22"}],"sourceItemFragmentSha256":"f49ec1940f607a5621fa793ab44fb96c6af77ae17c62e58d7e6c1206e0e1ef9c","sourceItemName":"Taberah","sourceItemOrder":7,"sourceMember":"Articles/T.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Taberah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Taberah","title":"Taberah","version":"v2-a101d843a2f0cd3fc0c6"}