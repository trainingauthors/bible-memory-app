{"content":[{"c":["MILCAH"],"sourceClass":"h1","t":"p"},{"c":["1. Daughter of Haran and half sister of Nahor who became Nahor’s wife (",{"href":"?bref=Gen.11.29","r":"Gen.11.29","rawR":"Gen.11.29","sourceRefs":[{"raw":"Gen.11.29","value":"Gen.11.29"}],"t":"ref","v":"Gn 11:29"},"). She bore Nahor eight sons (",{"href":"?bref=Gen.22.20-23","r":"Gen.22.20-23","rawR":"Gen.22.20-23","sourceRefs":[{"raw":"Gen.22.20-23","value":"Gen.22.20-23"}],"t":"ref","v":"22:20-23"},"). Through her son Bethuel she was the grandmother of Rebekah (",{"href":"?bref=Gen.24.15-47","r":"Gen.24.15-47","rawR":"Gen.24.15-47","sourceRefs":[{"raw":"Gen.24.15-47","value":"Gen.24.15-47"}],"t":"ref","v":"24:15-47"},")."],"sourceClass":"list","t":"p"},{"c":["2. One of the five daughters of Zelophehad. Because Zelophehad had no sons, his daughters petitioned Moses to allow them to receive their father’s inheritance in west Manasseh after their father’s death (",{"href":"?bref=Num.26.33","r":"Num.26.33","rawR":"Num.26.33","sourceRefs":[{"raw":"Num.26.33","value":"Num.26.33"}],"t":"ref","v":"Nm 26:33"},"; ",{"href":"?bref=Num.27.1-11","r":"Num.27.1-11","rawR":"Num.27.1-11","sourceRefs":[{"raw":"Num.27.1-11","value":"Num.27.1-11"}],"t":"ref","v":"27:1-11"},"; ",{"href":"?bref=Num.36.5-13","r":"Num.36.5-13","rawR":"Num.36.5-13","sourceRefs":[{"raw":"Num.36.5-13","value":"Num.36.5-13"}],"t":"ref","v":"36:5-13"},"; ",{"href":"?bref=Josh.17.3-4","r":"Josh.17.3-4","rawR":"Josh.17.3-4","sourceRefs":[{"raw":"Josh.17.3-4","value":"Josh.17.3-4"}],"t":"ref","v":"Jos 17:3-4"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Milcah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 11:29","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.11.29","rawQueryValue":"Gen.11.29","sourceRefExact":"Gen.11.29"},{"anchorText":"22:20-23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.22.20-23","rawQueryValue":"Gen.22.20-23","sourceRefExact":"Gen.22.20-23"},{"anchorText":"24:15-47","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.24.15-47","rawQueryValue":"Gen.24.15-47","sourceRefExact":"Gen.24.15-47"},{"anchorText":"Nm 26:33","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.26.33","rawQueryValue":"Num.26.33","sourceRefExact":"Num.26.33"},{"anchorText":"27:1-11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.27.1-11","rawQueryValue":"Num.27.1-11","sourceRefExact":"Num.27.1-11"},{"anchorText":"36:5-13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.36.5-13","rawQueryValue":"Num.36.5-13","sourceRefExact":"Num.36.5-13"},{"anchorText":"Jos 17:3-4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.17.3-4","rawQueryValue":"Josh.17.3-4","sourceRefExact":"Josh.17.3-4"}],"sourceItemFragmentSha256":"c38ba2a70223ac5d96fbd2c2f523e60b68e3bcc3c41ac23dd000e91666311a01","sourceItemName":"Milcah","sourceItemOrder":326,"sourceMember":"Articles/M.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Milcah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Milcah","title":"Milcah","version":"v2-a101d843a2f0cd3fc0c6"}