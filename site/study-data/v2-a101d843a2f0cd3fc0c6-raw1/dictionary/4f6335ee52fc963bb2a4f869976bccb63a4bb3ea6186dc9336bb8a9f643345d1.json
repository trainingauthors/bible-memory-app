{"content":[{"c":["JEHUCAL"],"sourceClass":"h1","t":"p"},{"c":["Son of Shelemiah who was sent by King Zedekiah to request Jeremiah’s prayers for Judah (",{"href":"?bref=Jer.37.3","r":"Jer.37.3","rawR":"Jer.37.3","sourceRefs":[{"raw":"Jer.37.3","value":"Jer.37.3"}],"t":"ref","v":"Jer 37:3"},"; ",{"href":"?bref=Jer.38.1","r":"Jer.38.1","rawR":"Jer.38.1","sourceRefs":[{"raw":"Jer.38.1","value":"Jer.38.1"}],"t":"ref","v":"38:1"},"). Later he tried to kill Jeremiah, who continued to prophesy the invasion of Jerusalem by the Babylonians, thereby undermining the confidence of the people and the army (",{"href":"?bref=Jer.38.1-6","r":"Jer.38.1-6","rawR":"Jer.38.1-6","sourceRefs":[{"raw":"Jer.38.1-6","value":"Jer.38.1-6"}],"t":"ref","v":"38:1-6"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Jehucal","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jer 37:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.37.3","rawQueryValue":"Jer.37.3","sourceRefExact":"Jer.37.3"},{"anchorText":"38:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.38.1","rawQueryValue":"Jer.38.1","sourceRefExact":"Jer.38.1"},{"anchorText":"38:1-6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.38.1-6","rawQueryValue":"Jer.38.1-6","sourceRefExact":"Jer.38.1-6"}],"sourceItemFragmentSha256":"294791bcb1771db8d593a21329bd77ed31b57f839d77298749665a39ce239dc3","sourceItemName":"Jehucal","sourceItemOrder":165,"sourceMember":"Articles/J.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Jehucal","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Jehucal","title":"Jehucal","version":"v2-a101d843a2f0cd3fc0c6"}