{"content":[{"c":["ALPHAEUS"],"sourceClass":"h1","t":"p"},{"c":["1. Father of James, one of the 12 apostles (",{"href":"?bref=Matt.10.3","r":"Matt.10.3","rawR":"Matt.10.3","sourceRefs":[{"raw":"Matt.10.3","value":"Matt.10.3"}],"t":"ref","v":"Mt 10:3"},"; ",{"href":"?bref=Mark.3.18","r":"Mark.3.18","rawR":"Mark.3.18","sourceRefs":[{"raw":"Mark.3.18","value":"Mark.3.18"}],"t":"ref","v":"Mk 3:18"},"; ",{"href":"?bref=Luke.6.15","r":"Luke.6.15","rawR":"Luke.6.15","sourceRefs":[{"raw":"Luke.6.15","value":"Luke.6.15"}],"t":"ref","v":"Lk 6:15"},"; ",{"href":"?bref=Acts.1.13","r":"Acts.1.13","rawR":"Acts.1.13","sourceRefs":[{"raw":"Acts.1.13","value":"Acts.1.13"}],"t":"ref","v":"Acts 1:13"},"), thought by some to be the same as Clopas of ",{"href":"?bref=John.19.25","r":"John.19.25","rawR":"John.19.25","sourceRefs":[{"raw":"John.19.25","value":"John.19.25"}],"t":"ref","v":"John 19:25"},"."],"sourceClass":"list","t":"p"},{"c":["2. Father of Levi, the tax collector (",{"href":"?bref=Mark.2.14","r":"Mark.2.14","rawR":"Mark.2.14","sourceRefs":[{"raw":"Mark.2.14","value":"Mark.2.14"}],"t":"ref","v":"Mk 2:14"},") who is also known in the Gospels as Matthew (",{"href":"?bref=Matt.9.9","r":"Matt.9.9","rawR":"Matt.9.9","sourceRefs":[{"raw":"Matt.9.9","value":"Matt.9.9"}],"t":"ref","v":"Mt 9:9"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Alphaeus","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Mt 10:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.10.3","rawQueryValue":"Matt.10.3","sourceRefExact":"Matt.10.3"},{"anchorText":"Mk 3:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mark.3.18","rawQueryValue":"Mark.3.18","sourceRefExact":"Mark.3.18"},{"anchorText":"Lk 6:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.6.15","rawQ