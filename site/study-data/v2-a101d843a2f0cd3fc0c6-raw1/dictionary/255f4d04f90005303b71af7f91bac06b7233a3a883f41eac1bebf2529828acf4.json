{"content":[{"c":["AMMISHADDAI"],"sourceClass":"h1","t":"p"},{"c":["Ahiezer’s father. Ahiezer was leader of Dan’s tribe when the Israelites were wandering in the Sinai wilderness after their escape from Egypt (",{"href":"?bref=Num.1.12","r":"Num.1.12","rawR":"Num.1.12","sourceRefs":[{"raw":"Num.1.12","value":"Num.1.12"}],"t":"ref","v":"Nm 1:12"},"; ",{"href":"?bref=Num.2.25","r":"Num.2.25","rawR":"Num.2.25","sourceRefs":[{"raw":"Num.2.25","value":"Num.2.25"}],"t":"ref","v":"2:25"},"; ",{"href":"?bref=Num.10.25","r":"Num.10.25","rawR":"Num.10.25","sourceRefs":[{"raw":"Num.10.25","value":"Num.10.25"}],"t":"ref","v":"10:25"},"). As leader he presented his tribe’s offering at the consecration of the tabernacle (",{"href":"?bref=Num.7.66,71","r":"Num.7.66,71","rawR":"Num.7.66,71","sourceRefs":[{"raw":"Num.7.66,71","value":"Num.7.66,71"}],"t":"ref","v":"Nm 7:66, 71"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Ammishaddai","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Nm 1:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.1.12","rawQueryValue":"Num.1.12","sourceRefExact":"Num.1.12"},{"anchorText":"2:25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.2.25","rawQueryValue":"Num.2.25","sourceRefExact":"Num.2.25"},{"anchorText":"10:25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.10.25","rawQueryValue":"Num.10.25","sourceRefExact":"Num.10.25"},{"anchorText":"Nm 7:66, 71","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.7.66,71","rawQueryValue":"Num.7.66,71","sourceRefExact":"Num.7.66,71"}],"sourceItemFragmentSha256":"272e305b3c4f5e6d6c56632730f4d75460c235343b6b135de86968ab58199ea6","sourceItemName":"Ammishaddai","sourceItemOrder":304,"sourceMember":"Articles/A.xml","supplementPointe