{"content":[{"c":["KESIL"],"sourceClass":"h1","t":"p"},{"c":["City situated along the borders of Edom in the Negev, allotted to Judah’s tribe for an inheritance (",{"href":"?bref=Josh.15.30","r":"Josh.15.30","rawR":"Josh.15.30","sourceRefs":[{"raw":"Josh.15.30","value":"Josh.15.30"}],"t":"ref","v":"Jos 15:30"},"). In parallel lists of towns Kesil is replaced by Bethul (",{"href":"?bref=Josh.19.4","r":"Josh.19.4","rawR":"Josh.19.4","sourceRefs":[{"raw":"Josh.19.4","value":"Josh.19.4"}],"t":"ref","v":"Jos 19:4"},"), Bethuel (",{"href":"?bref=1Chr.4.30","r":"1Chr.4.30","rawR":"1Chr.4.30","sourceRefs":[{"raw":"1Chr.4.30","value":"1Chr.4.30"}],"t":"ref","v":"1 Chr 4:30"},"), and perhaps Bethel—not to be confused with the Bethel north of Jerusalem (",{"href":"?bref=1Sam.30.27","r":"1Sam.30.27","rawR":"1Sam.30.27","sourceRefs":[{"raw":"1Sam.30.27","value":"1Sam.30.27"}],"t":"ref","v":"1 Sm 30:27"},"). Bethuel or Bethul is considered by many textual critics to be the original name, with Kesil as a later textual variant."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=BethuelBethulPlace_Article_TyndaleOpenBibleDictionary","id":"BethuelBethulPlace_Article_TyndaleOpenBibleDictionary","rawId":"BethuelBethulPlace_Article_TyndaleOpenBibleDictionary","t":"link","v":"Bethuel, Bethul (Place)"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Kesil","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 15:30","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.30","rawQueryValue":"Josh.15.30","sourceRefExact":"Josh.15.30"},{"anchorText":"Jos 19:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.19.4","rawQueryValue":"Josh.19.4","sourceRefExact":"Josh.19.4"},{"anchorText":"1 Chr 4:30","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.4.30","rawQueryValue":"1Chr.4.30","sourceRefExact":"1Chr.4.30"},{"anchorText":"1 Sm 30:27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.30.27","rawQueryValue":"1Sam.30.27","sourceRefExact":"1Sam.30.27"}],"sourceItemFragmentSha256":"a9cb7cc4c7859328f7fdce7f54cbc76d1e8fccf751aa6d5c6299f1310f7d1519","sourceItemName":"Kesil","sourceItemOrder":58,"sourceMember":"Articles/K.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Kesil","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Kesil","title":"Kesil","version":"v2-a101d843a2f0cd3fc0c6"}