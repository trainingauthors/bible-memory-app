{"content":[{"c":["IZRAHITE"],"sourceClass":"h1","t":"p"},{"c":["Designation given to Shamhuth, one of David’s 12 monthly captains, meaning a man of a family or town called Izra (",{"href":"?bref=1Chr.27.8","r":"1Chr.27.8","rawR":"1Chr.27.8","sourceRefs":[{"raw":"1Chr.27.8","value":"1Chr.27.8"}],"t":"ref","v":"1 Chr 27:8"},"). The word “Izrahite” is perhaps a corruption of “Zerahite,” a descendant of Zerah of Judah (",{"href":"?bref=1Chr.27.11","r":"1Chr.27.11","rawR":"1Chr.27.11","sourceRefs":[{"raw":"1Chr.27.11","value":"1Chr.27.11"}],"t":"ref","v":"1 Chr 27:11"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Izrahite","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 27:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.27.8","rawQueryValue":"1Chr.27.8","sourceRefExact":"1Chr.27.8"},{"anchorText":"1 Chr 27:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.27.11","rawQueryValue":"1Chr.27.11","sourceRefExact":"1Chr.27.11"}],"sourceItemFragmentSha256":"0c4d63c0340977eaf0e49e340eeb45b12b8f8e199f648856a2b63a56207aa1d7","sourceItemName":"Izrahite","sourceItemOrder":157,"sourceMember":"Articles/I.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Izrahite","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Izrahite","title":"Izrahite","version":"v2-a101d843a2f0cd3fc0c6"}