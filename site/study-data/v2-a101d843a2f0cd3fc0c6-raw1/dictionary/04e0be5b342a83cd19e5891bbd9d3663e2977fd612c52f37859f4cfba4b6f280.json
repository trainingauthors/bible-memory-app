{"content":[{"c":["ALEMA"],"sourceClass":"h1","t":"p"},{"c":["City in Gilead from which Judas Maccabeus liberated Jews who had been surrounded by hostile Gentiles (",{"href":"?bref=1Macc.5.24-35","r":"1Macc.5.24-35","rawR":"1Macc.5.24-35","sourceRefs":[{"raw":"1Macc.5.24-35","value":"1Macc.5.24-35"}],"t":"ref","v":"1 Macc 5:24-35"},"). Most authorities place it some 25 to 35 miles (40 to 55 kilometers) east of the Sea of Galilee, perhaps at modern Alma in Gilead. Helam, scene of a decisive victory by David, might be the same site (",{"href":"?bref=2Sam.10.16-17","r":"2Sam.10.16-17","rawR":"2Sam.10.16-17","sourceRefs":[{"raw":"2Sam.10.16-17","value":"2Sam.10.16-17"}],"t":"ref","v":"2 Sm 10:16-17"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Alema","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Macc 5:24-35","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Macc.5.24-35","rawQueryValue":"1Macc.5.24-35","sourceRefExact":"1Macc.5.24-35"},{"anchorText":"2 Sm 10:16-17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.10.16-17","rawQueryValue":"2Sam.10.16-17","sourceRefExact":"2Sam.10.16-17"}],"sourceItemFragmentSha256":"a72ff6f2bc941ca46f1d44958a4b0b8855e61f10689b693f3a91f0c070951821","sourceItemName":"Alema","sourceItemOrder":236,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Alema","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Alema","title":"Alema","version":"v2-a101d843a2f0cd3fc0c6"}