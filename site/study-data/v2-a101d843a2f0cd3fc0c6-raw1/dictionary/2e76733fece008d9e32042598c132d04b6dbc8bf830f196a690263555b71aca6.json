act":"Exod.22.29"},{"anchorText":"Dt 12:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.12.17","rawQueryValue":"Deut.12.17","sourceRefExact":"Deut.12.17"},{"anchorText":"Lv 8:26","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Lev.8.26","rawQueryValue":"Lev.8.26","sourceRefExact":"Lev.8.26"},{"anchorText":"Nm 7:19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.7.19","rawQueryValue":"Num.7.19","sourceRefExact":"Num.7.19"},{"anchorText":"Lv 24:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Lev.24.2","rawQueryValue":"Lev.24.2","sourceRefExact":"Lev.24.2"},{"anchorText":"Ex 29:40","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.29.40","rawQueryValue":"Exod.29.40","sourceRefExact":"Exod.29.40"},{"anchorText":"Lv 5:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Lev.5.11","rawQueryValue":"Lev.5.11","sourceRefExact":"Lev.5.11"},{"anchorText":"Nm 5:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.5.15","rawQueryValue":"Num.5.15","sourceRefExact":"Num.5.15"},{"anchorText":"Ex 27:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.27.20","rawQueryValue":"Exod.27.20","sourceRefExact":"Exod.27.20"},{"anchorText":"Jl 1:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Joel.1.10","rawQueryValue":"Joel.1.10","sourceRefExact":"Joel.1.10"}],"sourceItemFragmentSha256":"86899d6667da8c14fe737beeedf668459a7b767483d8934a7f9453fcb93fcd07","sourceItemName":"Oil","sourceItemOrder":30,"sourceMember":"Articles/O.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Oil","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Oil","title":"Oil","version":"v2-a101d843a2f0cd3fc0c6"}