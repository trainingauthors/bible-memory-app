n":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.12.7-8","rawQueryValue":"Rev.12.7-8","sourceRefExact":"Rev.12.7-8"}],"sourceItemFragmentSha256":"978d536317e0ba82ce6a549a0ac9fa4e9564811be91d26b30c63615a3f36a3bc","sourceItemName":"Michael","sourceItemOrder":303,"sourceMember":"Articles/M.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Michael","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Michael","title":"Michael","version":"v2-a101d843a2f0cd3fc0c6"}