{"content":[{"c":["SATRAP*"],"sourceClass":"h1","t":"p"},{"c":["Governor who held jurisdiction over a number of provinces within the king’s domain. This official represented the authority of the king in both civil and military matters, and supplied the means for maintaining the king’s sovereignty over the whole empire. Satraps were listed among the high-ranking officers of the Babylonian and Persian empires (",{"href":"?bref=Ezra.8.36","r":"Ezra.8.36","rawR":"Ezra.8.36","sourceRefs":[{"raw":"Ezra.8.36","value":"Ezra.8.36"}],"t":"ref","v":"Ezr 8:36"},"; ",{"href":"?bref=Esth.3.12","r":"Esth.3.12","rawR":"Esth.3.12","sourceRefs":[{"raw":"Esth.3.12","value":"Esth.3.12"}],"t":"ref","v":"Est 3:12"},"; ",{"href":"?bref=Esth.9.3","r":"Esth.9.3","rawR":"Esth.9.3","sourceRefs":[{"raw":"Esth.9.3","value":"Esth.9.3"}],"t":"ref","v":"9:3"},"; ",{"href":"?bref=Dan.6.1-7","r":"Dan.6.1-7","rawR":"Dan.6.1-7","sourceRefs":[{"raw":"Dan.6.1-7","value":"Dan.6.1-7"}],"t":"ref","v":"Dn 6:1-7"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Satrap","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ezr 8:36","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.8.36","rawQueryValue":"Ezra.8.36","sourceRefExact":"Ezra.8.36"},{"anchorText":"Est 3:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Esth.3.12","rawQueryValue":"Esth.3.12","sourceRefExact":"Esth.3.12"},{"anchorText":"9:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Esth.9.3","rawQueryValue":"Esth.9.3","sourceRefExact":"Esth.9.3"},{"anchorText":"Dn 6:1-7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Dan.6.1-7","rawQueryValue":"Dan.6.1-7","sourceRefExact":"Dan.6.1-7"}],"sourceItemFragmentSha256":"b43eef1d92329a74f95eb9ba2e0664996f999ce230ed95c8fecca62196df1da