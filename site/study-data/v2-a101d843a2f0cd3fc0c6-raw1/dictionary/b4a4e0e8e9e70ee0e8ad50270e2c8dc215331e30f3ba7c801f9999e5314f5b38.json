{"content":[{"c":["AGIA"],"sourceClass":"h1","t":"p"},{"c":["Jaddus’s wife, mentioned in the Apocrypha (",{"href":"?bref=1Esd.5.38-39","r":"1Esd.5.38-39","rawR":"1Esd.5.38-39","sourceRefs":[{"raw":"1Esd.5.38-39","value":"1Esd.5.38-39"}],"t":"ref","v":"1 Esd 5:38-39"},") as a descendant of Barzillai the Gileadite (",{"href":"?bref=2Sam.19.31-40","r":"2Sam.19.31-40","rawR":"2Sam.19.31-40","sourceRefs":[{"raw":"2Sam.19.31-40","value":"2Sam.19.31-40"}],"t":"ref","v":"2 Sm 19:31-40"},"). Her sons, who had assumed the priesthood, were excluded from serving as priests when the Jews returned from Babylon and demanded verification of priestly ancestry (",{"href":"?bref=Ezra.2.61-63","r":"Ezra.2.61-63","rawR":"Ezra.2.61-63","sourceRefs":[{"raw":"Ezra.2.61-63","value":"Ezra.2.61-63"}],"t":"ref","v":"Ezr 2:61-63"},"; ",{"href":"?bref=Neh.7.63-65","r":"Neh.7.63-65","rawR":"Neh.7.63-65","sourceRefs":[{"raw":"Neh.7.63-65","value":"Neh.7.63-65"}],"t":"ref","v":"Neh 7:63-65"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Agia","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Esd 5:38-39","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Esd.5.38-39","rawQueryValue":"1Esd.5.38-39","sourceRefExact":"1Esd.5.38-39"},{"anchorText":"2 Sm 19:31-40","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.19.31-40","rawQueryValue":"2Sam.19.31-40","sourceRefExact":"2Sam.19.31-40"},{"anchorText":"Ezr 2:61-63","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.2.61-63","rawQueryValue":"Ezra.2.61-63","sourceRefExact":"Ezra.2.61-63"},{"anchorText":"Neh 7:63-65","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.7.63-65","rawQueryValue":"Neh.7.63-65","sourceRefExact":"Neh.7.63-65"}],"sourceItemFragmentSha256":"025cfb091bc9aa91f7