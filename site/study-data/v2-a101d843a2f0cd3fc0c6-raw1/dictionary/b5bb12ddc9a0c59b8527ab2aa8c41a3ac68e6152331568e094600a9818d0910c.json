{"content":[{"c":["BAAL-SHALISHAH"],"sourceClass":"h1","t":"p"},{"c":["Home of a man who brought a sack of fresh grain and 20 barley loaves to Elisha at Gilgal. Elisha had his servant feed 100 young prophets with it and had some left over (",{"href":"?bref=2Kgs.4.42","r":"2Kgs.4.42","rawR":"2Kgs.4.42","sourceRefs":[{"raw":"2Kgs.4.42","value":"2Kgs.4.42"}],"t":"ref","v":"2 Kgs 4:42"},"). Baal-shalishah was probably located in a fertile area where early crops were raised."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"BaalShalishah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Kgs 4:42","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.4.42","rawQueryValue":"2Kgs.4.42","sourceRefExact":"2Kgs.4.42"}],"sourceItemFragmentSha256":"46d9ae260fab83da88fa115861af8b7e9bd08fd1712f523297930e2e520601da","sourceItemName":"BaalShalishah","sourceItemOrder":20,"sourceMember":"Articles/B.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"BaalShalishah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Baal-Shalishah","title":"Baal-Shalishah","version":"v2-a101d843a2f0cd3fc0c6"}