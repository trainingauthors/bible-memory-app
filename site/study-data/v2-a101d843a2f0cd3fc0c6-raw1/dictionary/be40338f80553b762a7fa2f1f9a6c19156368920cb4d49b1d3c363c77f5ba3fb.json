xact":"?bref=Matt.12.28","rawQueryValue":"Matt.12.28","sourceRefExact":"Matt.12.28"},{"anchorText":"Lk 4:18-19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.4.18-19","rawQueryValue":"Luke.4.18-19","sourceRefExact":"Luke.4.18-19"},{"anchorText":"Acts 10:38","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.10.38","rawQueryValue":"Acts.10.38","sourceRefExact":"Acts.10.38"},{"anchorText":"Mt 12:29","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.12.29","rawQueryValue":"Matt.12.29","sourceRefExact":"Matt.12.29"},{"anchorText":"Mk 3:27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mark.3.27","rawQueryValue":"Mark.3.27","sourceRefExact":"Mark.3.27"},{"anchorText":"Mt 18:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.18.18","rawQueryValue":"Matt.18.18","sourceRefExact":"Matt.18.18"},{"anchorText":"Mk 9:28","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mark.9.28","rawQueryValue":"Mark.9.28","sourceRefExact":"Mark.9.28"},{"anchorText":"Revelation 12:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.12.11","rawQueryValue":"Rev.12.11","sourceRefExact":"Rev.12.11"},{"anchorText":"Eph 6:10-17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Eph.6.10-17","rawQueryValue":"Eph.6.10-17","sourceRefExact":"Eph.6.10-17"},{"anchorText":"Eph 6:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Eph.6.17","rawQueryValue":"Eph.6.17","sourceRefExact":"Eph.6.17"},{"anchorText":"Heb 4:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Heb.4.12","rawQueryValue":"Heb.4.12","sourceRefExact":"Heb.4.12"},{"anchorText":"Eph 2:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Eph.2.6","rawQueryValue":"Eph.2.6","sourceRefExact":"Eph.2.6"},{"anchorText":"1 Jn 3:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Jn.3.8","rawQueryValue":"1Jn.3.8","sourceRefExact":"1Jn.3.8"},{"anchorText":"Heb 2:14-16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Heb.2.14-16","rawQueryValue":"Heb.2.14-16","sourceRefExact":"Heb.2.14-16"}],"sourceItemFragmentSha256":"920b6df2ff291b0f19f02e551fe363eda05771d653ac4840d1b49305747bf6ac","sourceItemName":"DemonPossession","sourceItemOrder":78,"sourceMember":"Articles/D.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"DemonPossession","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Demon-Possession","title":"Demon-Possession","version":"v2-a101d843a2f0cd3fc0c6"}