{"content":[{"c":["DABBESHETH"],"sourceClass":"h1","t":"p"},{"c":["Designation for a camel’s hump (",{"href":"?bref=Isa.30.6","r":"Isa.30.6","rawR":"Isa.30.6","sourceRefs":[{"raw":"Isa.30.6","value":"Isa.30.6"}],"t":"ref","v":"Is 30:6"},"). The name also refers to a town (“camel’s hump hill”) situated on the western border of the land allotted to Zebulun’s tribe for an inheritance (",{"href":"?bref=Josh.19.11","r":"Josh.19.11","rawR":"Josh.19.11","sourceRefs":[{"raw":"Josh.19.11","value":"Josh.19.11"}],"t":"ref","v":"Jos 19:11"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Dabbesheth","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Is 30:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.30.6","rawQueryValue":"Isa.30.6","sourceRefExact":"Isa.30.6"},{"anchorText":"Jos 19:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.19.11","rawQueryValue":"Josh.19.11","sourceRefExact":"Josh.19.11"}],"sourceItemFragmentSha256":"2fbe1fdb9ebcfcc51e0a7b73bd6827edbb0c12f0b4fad333147727aa2b68e915","sourceItemName":"Dabbesheth","sourceItemOrder":2,"sourceMember":"Articles/D.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Dabbesheth","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Dabbesheth","title":"Dabbesheth","version":"v2-a101d843a2f0cd3fc0c6"}