{"content":[{"c":["AZZUR"],"sourceClass":"h1","t":"p"},{"c":["1. Political leader who signed Ezra’s covenant of faithfulness to God with Nehemiah and others after the exile (",{"href":"?bref=Neh.10.17","r":"Neh.10.17","rawR":"Neh.10.17","sourceRefs":[{"raw":"Neh.10.17","value":"Neh.10.17"}],"t":"ref","v":"Neh 10:17"},")."],"sourceClass":"list","t":"p"},{"c":["2. Father of the false prophet Hananiah (",{"href":"?bref=Jer.28.1","r":"Jer.28.1","rawR":"Jer.28.1","sourceRefs":[{"raw":"Jer.28.1","value":"Jer.28.1"}],"t":"ref","v":"Jer 28:1"},")."],"sourceClass":"list","t":"p"},{"c":["3. Father of Jaazaniah, one of the prominent men of Jerusalem whom Ezekiel saw in a vision (",{"href":"?bref=Ezek.11.1","r":"Ezek.11.1","rawR":"Ezek.11.1","sourceRefs":[{"raw":"Ezek.11.1","value":"Ezek.11.1"}],"t":"ref","v":"Ez 11:1"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Azzur","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Neh 10:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.10.17","rawQueryValue":"Neh.10.17","sourceRefExact":"Neh.10.17"},{"anchorText":"Jer 28:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.28.1","rawQueryValue":"Jer.28.1","sourceRefExact":"Jer.28.1"},{"anchorText":"Ez 11:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.11.1","rawQueryValue":"Ezek.11.1","sourceRefExact":"Ezek.11.1"}],"sourceItemFragmentSha256":"822aca7ff6462bcc7b278dcc8a9ae94d1cb2f120f6b6b4314ca9fe5c4cd63b3c","sourceItemName":"Azzur","sourceItemOrder":666,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Azzur","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Azzur","title":"Azzur","version":"v2-a101d843a2f0cd3fc0c6"}