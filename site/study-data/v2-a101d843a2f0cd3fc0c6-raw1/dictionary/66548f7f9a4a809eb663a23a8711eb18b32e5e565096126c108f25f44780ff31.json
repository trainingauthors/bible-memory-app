Isa.19.1"},{"anchorText":"22:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.22.1","rawQueryValue":"Isa.22.1","sourceRefExact":"Isa.22.1"},{"anchorText":"15:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.15.1","rawQueryValue":"Isa.15.1","sourceRefExact":"Isa.15.1"},{"anchorText":"14:28","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.14.28","rawQueryValue":"Isa.14.28","sourceRefExact":"Isa.14.28"},{"anchorText":"23:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.23.1","rawQueryValue":"Isa.23.1","sourceRefExact":"Isa.23.1"},{"anchorText":"Na 1:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Nah.1.1","rawQueryValue":"Nah.1.1","sourceRefExact":"Nah.1.1"},{"anchorText":"Hb 1:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Hab.1.1","rawQueryValue":"Hab.1.1","sourceRefExact":"Hab.1.1"},{"anchorText":"Mal 1:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mal.1.1","rawQueryValue":"Mal.1.1","sourceRefExact":"Mal.1.1"},{"anchorText":"Lam 2:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Lam.2.14","rawQueryValue":"Lam.2.14","sourceRefExact":"Lam.2.14"}],"sourceItemFragmentSha256":"b4468e82e65002d4ab7e3017d25eefb86c67234384553d6ed7b1eb4d302316df","sourceItemName":"Oracle","sourceItemOrder":71,"sourceMember":"Articles/O.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Oracle","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Oracle","title":"Oracle","version":"v2-a101d843a2f0cd3fc0c6"}