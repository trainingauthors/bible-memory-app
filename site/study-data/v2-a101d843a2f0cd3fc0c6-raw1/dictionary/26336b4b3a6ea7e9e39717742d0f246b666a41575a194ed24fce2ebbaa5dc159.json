{"content":[{"c":["ESEK*"],"sourceClass":"h1","t":"p"},{"c":["Name Isaac gave to a well dug by his servants in the valley of Gerar (",{"href":"?bref=Gen.26.20","r":"Gen.26.20","rawR":"Gen.26.20","sourceRefs":[{"raw":"Gen.26.20","value":"Gen.26.20"}],"t":"ref","v":"Gn 26:20"},"; see ",{"c":["nlt"],"sourceClass":"sc","t":"span"}," mg). The name means “argument.” When the herdsmen of Gerar claimed it belonged to them, Isaac relinquished Esek and another well, called Sitnah, to induce the men of Gerar to allow him to live peacefully in the land."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Esek","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 26:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.26.20","rawQueryValue":"Gen.26.20","sourceRefExact":"Gen.26.20"}],"sourceItemFragmentSha256":"406b7f07a230ceab4efa73ffa3d74f6100f31feb47676d72574a5302c5829815","sourceItemName":"Esek","sourceItemOrder":234,"sourceMember":"Articles/E.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Esek","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Esek*","title":"Esek*","version":"v2-a101d843a2f0cd3fc0c6"}