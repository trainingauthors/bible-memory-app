{"content":[{"c":["MAMRE (P",{"c":["erson"],"sourceClass":"lc","t":"span"},")"],"sourceClass":"h1","t":"p"},{"c":["Owner of a parcel of land called “the plain of Mamre.” He was an Amorite and is recorded as having two brothers: Aner and Eshcol (",{"href":"?bref=Gen.14.13","r":"Gen.14.13","rawR":"Gen.14.13","sourceRefs":[{"raw":"Gen.14.13","value":"Gen.14.13"}],"t":"ref","v":"Gn 14:13"},"). These became confederates of Abraham when he fought to save his nephew Lot."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"MamrePerson","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 14:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.14.13","rawQueryValue":"Gen.14.13","sourceRefExact":"Gen.14.13"}],"sourceItemFragmentSha256":"d0bfa5905ec786295ecb8030a2e7542f0750f9861732dc70c6127f235a4463b0","sourceItemName":"MamrePerson","sourceItemOrder":104,"sourceMember":"Articles/M.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"MamrePerson","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Mamre (Person)","title":"Mamre (Person)","version":"v2-a101d843a2f0cd3fc0c6"}