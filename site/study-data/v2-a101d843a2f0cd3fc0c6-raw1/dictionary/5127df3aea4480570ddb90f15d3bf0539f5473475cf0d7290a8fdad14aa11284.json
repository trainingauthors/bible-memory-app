{"content":[{"c":["BOANERGES*"],"sourceClass":"h1","t":"p"},{"c":["Name meaning “sons of thunder” given by Jesus to James and John, Zebedee’s sons (",{"href":"?bref=Mark.3.17","r":"Mark.3.17","rawR":"Mark.3.17","sourceRefs":[{"raw":"Mark.3.17","value":"Mark.3.17"}],"t":"ref","v":"Mk 3:17"},"). Its derivation is uncertain. The name may have referred to the volatile personalities of the two brothers (",{"href":"?bref=Luke.9.54","r":"Luke.9.54","rawR":"Luke.9.54","sourceRefs":[{"raw":"Luke.9.54","value":"Luke.9.54"}],"t":"ref","v":"Lk 9:54"},"), to their possible revolutionary past as Zealots, or even to a “thundering” style of speech."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=JamesPerson_Article_TyndaleOpenBibleDictionary","id":"JamesPerson_Article_TyndaleOpenBibleDictionary","rawId":"JamesPerson_Article_TyndaleOpenBibleDictionary","t":"link","v":"James (Person)"},"; ",{"href":"?item=JohntheApostle_Article_TyndaleOpenBibleDictionary","id":"JohntheApostle_Article_TyndaleOpenBibleDictionary","rawId":"JohntheApostle_Article_TyndaleOpenBibleDictionary","t":"link","v":"John, The Apostle"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Boanerges","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Mk 3:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mark.3.17","rawQueryValue":"Mark.3.17","sourceRefExact":"Mark.3.17"},{"anchorText":"Lk 9:54","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.9.54","rawQueryValue":"Luke.9.54","sourceRefExact":"Luke.9.54"}],"sourceItemFragmentSha256":"d65b6881ee54bf3fc5955beef85fdedfd4797d1c781e7013835169aaa8b3aa97","sourceItemName":"Boanerges","sourceItemOrder":353,"sourceMember":"Articles/B.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Boanerges",