ourceAttributes":{"name":"Bloodguilt","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Bloodguilt*","title":"Bloodguilt*","version":"v2-a101d843a2f0cd3fc0c6"}