{"content":[{"c":["SEBAM"],"sourceClass":"h1","t":"p"},{"c":["City located on the pastoral tablelands of the Transjordan and desired by the sons of Gad and Reuben (",{"href":"?bref=Num.32.3","r":"Num.32.3","rawR":"Num.32.3","sourceRefs":[{"raw":"Num.32.3","value":"Num.32.3"}],"t":"ref","v":"Nm 32:3"},"). Reuben was apportioned this area (",{"href":"?bref=Josh.13.19","r":"Josh.13.19","rawR":"Josh.13.19","sourceRefs":[{"raw":"Josh.13.19","value":"Josh.13.19"}],"t":"ref","v":"Jos 13:19"},") but eventually lost it to the marauding Moabites. This city was known for its vineyards (",{"href":"?bref=Isa.16.8-9","r":"Isa.16.8-9","rawR":"Isa.16.8-9","sourceRefs":[{"raw":"Isa.16.8-9","value":"Isa.16.8-9"}],"t":"ref","v":"Is 16:8-9"},"; ",{"href":"?bref=Jer.48.32","r":"Jer.48.32","rawR":"Jer.48.32","sourceRefs":[{"raw":"Jer.48.32","value":"Jer.48.32"}],"t":"ref","v":"Jer 48:32"},"). Sebam is alternately called Sibmah in the Hebrew text (cf. ",{"href":"?bref=Num.32.38","r":"Num.32.38","rawR":"Num.32.38","sourceRefs":[{"raw":"Num.32.38","value":"Num.32.38"}],"t":"ref","v":"Nm 32:38"},"; ",{"href":"?bref=Josh.13.19","r":"Josh.13.19","rawR":"Josh.13.19","sourceRefs":[{"raw":"Josh.13.19","value":"Josh.13.19"}],"t":"ref","v":"Jos 13:19"},"; ",{"href":"?bref=Isa.16.8-9","r":"Isa.16.8-9","rawR":"Isa.16.8-9","sourceRefs":[{"raw":"Isa.16.8-9","value":"Isa.16.8-9"}],"t":"ref","v":"Is 16:8-9"},"; ",{"href":"?bref=Jer.48.32","r":"Jer.48.32","rawR":"Jer.48.32","sourceRefs":[{"raw":"Jer.48.32","value":"Jer.48.32"}],"t":"ref","v":"Jer 48:32"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Sebam","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Nm 32:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.32.3","rawQueryValue":"Num.32.3","sourceRefExact":"Num.32.3"},{"anchorText":"Jos 13:19","canonicalization":"deferred_to_dicti