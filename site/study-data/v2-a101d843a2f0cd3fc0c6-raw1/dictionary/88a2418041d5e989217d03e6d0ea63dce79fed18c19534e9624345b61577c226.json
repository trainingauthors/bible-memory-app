9.7,17,19","sourceRefExact":"Rev.9.7,17,19"},{"anchorText":"12:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.12.3","rawQueryValue":"Rev.12.3","sourceRefExact":"Rev.12.3"},{"anchorText":"Rom 12:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rom.12.20","rawQueryValue":"Rom.12.20","sourceRefExact":"Rom.12.20"},{"anchorText":"Mt 5:44","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.5.44","rawQueryValue":"Matt.5.44","sourceRefExact":"Matt.5.44"},{"anchorText":"Acts 21:24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.21.24","rawQueryValue":"Acts.21.24","sourceRefExact":"Acts.21.24"},{"anchorText":"Mt 8:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.8.20","rawQueryValue":"Matt.8.20","sourceRefExact":"Matt.8.20"},{"anchorText":"Lk 9:58","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.9.58","rawQueryValue":"Luke.9.58","sourceRefExact":"Luke.9.58"},{"anchorText":"1 Cor 11:3-16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Cor.11.3-16","rawQueryValue":"1Cor.11.3-16","sourceRefExact":"1Cor.11.3-16"},{"anchorText":"Eph 5:23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Eph.5.23","rawQueryValue":"Eph.5.23","sourceRefExact":"Eph.5.23"},{"anchorText":"Eph 1:21-22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Eph.1.21-22","rawQueryValue":"Eph.1.21-22","sourceRefExact":"Eph.1.21-22"},{"anchorText":"Col 2:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Col.2.10","rawQueryValue":"Col.2.10","sourceRefExact":"Col.2.10"},{"anchorText":"Eph 4:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Eph.4.15","rawQueryValue":"Eph.4.15","sourceRefExact":"Eph.4.15"},{"anchorT