{"content":[{"c":["AHIMAN"],"sourceClass":"h1","t":"p"},{"c":["1. One of Anak’s three sons. The Ahimanites were one of the Anakim clans living in Hebron when the 12 Israelite spies scouted the land of Canaan (",{"href":"?bref=Num.13.22","r":"Num.13.22","rawR":"Num.13.22","sourceRefs":[{"raw":"Num.13.22","value":"Num.13.22"}],"t":"ref","v":"Nm 13:22"},"; ",{"href":"?bref=Josh.15.13-14","r":"Josh.15.13-14","rawR":"Josh.15.13-14","sourceRefs":[{"raw":"Josh.15.13-14","value":"Josh.15.13-14"}],"t":"ref","v":"Jos 15:13-14"},"; ",{"href":"?bref=Judg.1.10","r":"Judg.1.10","rawR":"Judg.1.10","sourceRefs":[{"raw":"Judg.1.10","value":"Judg.1.10"}],"t":"ref","v":"Jgs 1:10"},")."],"sourceClass":"list","t":"p"},{"c":["2. Levite gatekeeper in postexilic Jerusalem (",{"href":"?bref=1Chr.9.17","r":"1Chr.9.17","rawR":"1Chr.9.17","sourceRefs":[{"raw":"1Chr.9.17","value":"1Chr.9.17"}],"t":"ref","v":"1 Chr 9:17"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Ahiman","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Nm 13:22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.13.22","rawQueryValue":"Num.13.22","sourceRefExact":"Num.13.22"},{"anchorText":"Jos 15:13-14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.13-14","rawQueryValue":"Josh.15.13-14","sourceRefExact":"Josh.15.13-14"},{"anchorText":"Jgs 1:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.1.10","rawQueryValue":"Judg.1.10","sourceRefExact":"Judg.1.10"},{"anchorText":"1 Chr 9:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.9.17","rawQueryValue":"1Chr.9.17","sourceRefExact":"1Chr.9.17"}],"sourceItemFragmentSha256":"5320bb71ae96561df89a4ed410a586858291e8af5e31300d590b57ea64697666","sourceItemName":"Ahiman","sourceItemOrder":189,"s