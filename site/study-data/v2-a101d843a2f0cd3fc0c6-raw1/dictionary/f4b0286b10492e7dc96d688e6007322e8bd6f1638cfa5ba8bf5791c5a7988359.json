{"content":[{"c":["APPEAL"],"sourceClass":"h1","t":"p"},{"c":["Legal term meaning to request a higher court review of a decision by a lower one. OT law made no provision for appeals. In the NT the apostle Paul appealed to Caesar for a hearing after his arrest in Jerusalem (",{"href":"?bref=Acts.25.11","r":"Acts.25.11","rawR":"Acts.25.11","sourceRefs":[{"raw":"Acts.25.11","value":"Acts.25.11"}],"t":"ref","v":"Acts 25:11"},"). Because he was a Roman citizen, Paul could have his case removed from the Jewish courts where he feared an unfair trial."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=CivilLawandJustice_Article_TyndaleOpenBibleDictionary","id":"CivilLawandJustice_Article_TyndaleOpenBibleDictionary","rawId":"CivilLawandJustice_Article_TyndaleOpenBibleDictionary","t":"link","v":"Civil Law and Justice"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Appeal","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Acts 25:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.25.11","rawQueryValue":"Acts.25.11","sourceRefExact":"Acts.25.11"}],"sourceItemFragmentSha256":"03aedff96f6ef4d6ae2a3be6b91c42c3ca305fb9abda5d572d8ce1c1925b93f8","sourceItemName":"Appeal","sourceItemOrder":414,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Appeal","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Appeal","title":"Appeal","version":"v2-a101d843a2f0cd3fc0c6"}