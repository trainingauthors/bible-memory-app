{"content":[{"c":["ANTI-LEBANON"],"sourceClass":"h1","t":"p"},{"c":["Mountain range (",{"href":"?bref=Jdt.1.7","r":"Jdt.1.7","rawR":"Jdt.1.7","sourceRefs":[{"raw":"Jdt.1.7","value":"Jdt.1.7"}],"t":"ref","v":"Jdt 1:7"},") stretching from Mt Hermon, its southern extremity, toward the north-northeast, running parallel to the Lebanon range west of it. Drainage from the two ranges provides most of the water for the Jordan River. The range was known in OT times as Sirion (",{"href":"?bref=Deut.3.9","r":"Deut.3.9","rawR":"Deut.3.9","sourceRefs":[{"raw":"Deut.3.9","value":"Deut.3.9"}],"t":"ref","v":"Dt 3:9"},"; ",{"href":"?bref=Deut.4.48","r":"Deut.4.48","rawR":"Deut.4.48","sourceRefs":[{"raw":"Deut.4.48","value":"Deut.4.48"}],"t":"ref","v":"4:48"},"; ",{"href":"?bref=Ps.29.6","r":"Ps.29.6","rawR":"Ps.29.6","sourceRefs":[{"raw":"Ps.29.6","value":"Ps.29.6"}],"t":"ref","v":"Ps 29:6"},") or Senir (",{"href":"?bref=1Chr.5.23","r":"1Chr.5.23","rawR":"1Chr.5.23","sourceRefs":[{"raw":"1Chr.5.23","value":"1Chr.5.23"}],"t":"ref","v":"1 Chr 5:23"},"; ",{"href":"?bref=Song.4.8","r":"Song.4.8","rawR":"Song.4.8","sourceRefs":[{"raw":"Song.4.8","value":"Song.4.8"}],"t":"ref","v":"Sg 4:8"},"; ",{"href":"?bref=Ezek.27.5","r":"Ezek.27.5","rawR":"Ezek.27.5","sourceRefs":[{"raw":"Ezek.27.5","value":"Ezek.27.5"}],"t":"ref","v":"Ez 27:5"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"AntiLebanon","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jdt 1:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jdt.1.7","rawQueryValue":"Jdt.1.7","sourceRefExact":"Jdt.1.7"},{"anchorText":"Dt 3:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.3.9","rawQueryValue":"Deut.3.9","sourceRefExact":"Deut.3.9"},{"anchorText":"4:48","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?