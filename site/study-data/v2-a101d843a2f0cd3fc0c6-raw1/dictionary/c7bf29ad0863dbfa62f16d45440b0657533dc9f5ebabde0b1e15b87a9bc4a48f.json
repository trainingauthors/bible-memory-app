{"content":[{"c":["AMBASSADOR"],"sourceClass":"h1","t":"p"},{"c":["Messenger or envoy officially representing a higher authority. In the OT, an ambassador was a messenger, envoy, or negotiator sent on a special, temporary mission as an official representative of the king, government, or authority who sent him. Examples include the ambassador of Pharaoh (",{"href":"?bref=Isa.30.4","r":"Isa.30.4","rawR":"Isa.30.4","sourceRefs":[{"raw":"Isa.30.4","value":"Isa.30.4"}],"t":"ref","v":"Is 30:4"},", ",{"c":["kjv"],"sourceClass":"sc","t":"span"},"), of the princes of Babylon (",{"href":"?bref=2Chr.32.31","r":"2Chr.32.31","rawR":"2Chr.32.31","sourceRefs":[{"raw":"2Chr.32.31","value":"2Chr.32.31"}],"t":"ref","v":"2 Chr 32:31"},"), and of Neco, king of Egypt (",{"href":"?bref=2Chr.35.21","r":"2Chr.35.21","rawR":"2Chr.35.21","sourceRefs":[{"raw":"2Chr.35.21","value":"2Chr.35.21"}],"t":"ref","v":"2 Chr 35:21"},"). In the letters of Paul, the apostle called himself an ambassador for Christ because he had an apostolic mission to convey the gospel of Christ to the Gentiles (",{"href":"?bref=2Cor.5.20","r":"2Cor.5.20","rawR":"2Cor.5.20","sourceRefs":[{"raw":"2Cor.5.20","value":"2Cor.5.20"}],"t":"ref","v":"2 Cor 5:20"},"; ",{"href":"?bref=Eph.6.20","r":"Eph.6.20","rawR":"Eph.6.20","sourceRefs":[{"raw":"Eph.6.20","value":"Eph.6.20"}],"t":"ref","v":"Eph 6:20"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Ambassador","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Is 30:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.30.4","rawQueryValue":"Isa.30.4","sourceRefExact":"Isa.30.4"},{"anchorText":"2 Chr 32:31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.32.31","rawQueryValue":"2Chr.32.31","sourceRefExact":"2Chr.32.31"},{"anchorText":"2 Chr 35:21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.35.21","rawQueryValue":"2Chr.35.21","sourceRefExact":"2Chr.35.21"},{"anchorText":"2 Cor 5:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Cor.5.20","rawQueryValue":"2Cor.5.20","sourceRefExact":"2Cor.5.20"},{"anchorText":"Eph 6:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Eph.6.20","rawQueryValue":"Eph.6.20","sourceRefExact":"Eph.6.20"}],"sourceItemFragmentSha256":"a0bfc98169210f2d9a0ad4352b1cd0d84bb667e536365c642d2d19b1875f0769","sourceItemName":"Ambassador","sourceItemOrder":288,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Ambassador","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Ambassador","title":"Ambassador","version":"v2-a101d843a2f0cd3fc0c6"}