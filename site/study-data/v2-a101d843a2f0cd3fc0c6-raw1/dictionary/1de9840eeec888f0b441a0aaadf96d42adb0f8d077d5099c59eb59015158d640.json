{"content":[{"c":["SACAR, SACHAR*"],"sourceClass":"h1","t":"p"},{"c":["1. Hararite and Ahiam’s father. Sacar was one of David’s mighty men (",{"href":"?bref=1Chr.11.35","r":"1Chr.11.35","rawR":"1Chr.11.35","sourceRefs":[{"raw":"1Chr.11.35","value":"1Chr.11.35"}],"t":"ref","v":"1 Chr 11:35"},"). In a parallel account he is alternately called Sharar the Hararite (",{"href":"?bref=2Sam.23.33","r":"2Sam.23.33","rawR":"2Sam.23.33","sourceRefs":[{"raw":"2Sam.23.33","value":"2Sam.23.33"}],"t":"ref","v":"2 Sm 23:33"},")."],"sourceClass":"list","t":"p"},{"c":["2. Korahite and one of Obed-edom’s eight sons. Sacar and his brothers were listed among the families of gatekeepers (",{"href":"?bref=1Chr.26.4","r":"1Chr.26.4","rawR":"1Chr.26.4","sourceRefs":[{"raw":"1Chr.26.4","value":"1Chr.26.4"}],"t":"ref","v":"1 Chr 26:4"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"SacarSachar","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 11:35","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.11.35","rawQueryValue":"1Chr.11.35","sourceRefExact":"1Chr.11.35"},{"anchorText":"2 Sm 23:33","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.23.33","rawQueryValue":"2Sam.23.33","sourceRefExact":"2Sam.23.33"},{"anchorText":"1 Chr 26:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.26.4","rawQueryValue":"1Chr.26.4","sourceRefExact":"1Chr.26.4"}],"sourceItemFragmentSha256":"de5e2bbca401f7979ad6753bdb4025e9f68c231cc131375ad9c6f5579bc07367","sourceItemName":"SacarSachar","sourceItemOrder":10,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"SacarSachar","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Sacar, Sachar*","title":"Sacar, Sachar*","version":"v2-a101d