{"content":[{"c":["METHUSELAH"],"sourceClass":"h1","t":"p"},{"c":["Son of Enoch, Lamech’s father, and the grandfather of Noah through Seth’s line (",{"href":"?bref=Gen.5.21-27","r":"Gen.5.21-27","rawR":"Gen.5.21-27","sourceRefs":[{"raw":"Gen.5.21-27","value":"Gen.5.21-27"}],"t":"ref","v":"Gn 5:21-27"},"; ",{"href":"?bref=1Chr.1.3","r":"1Chr.1.3","rawR":"1Chr.1.3","sourceRefs":[{"raw":"1Chr.1.3","value":"1Chr.1.3"}],"t":"ref","v":"1 Chr 1:3"},"). Living 969 years, Methuselah is the oldest recorded person in the Bible. His lineage is included in Luke’s genealogy of Christ (",{"href":"?bref=Luke.3.37","r":"Luke.3.37","rawR":"Luke.3.37","sourceRefs":[{"raw":"Luke.3.37","value":"Luke.3.37"}],"t":"ref","v":"Lk 3:37"},")."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=GenealogyofJesusChrist_Article_TyndaleOpenBibleDictionary","id":"GenealogyofJesusChrist_Article_TyndaleOpenBibleDictionary","rawId":"GenealogyofJesusChrist_Article_TyndaleOpenBibleDictionary","t":"link","v":"Genealogy of Jesus Christ"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Methuselah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 5:21-27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.5.21-27","rawQueryValue":"Gen.5.21-27","sourceRefExact":"Gen.5.21-27"},{"anchorText":"1 Chr 1:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.1.3","rawQueryValue":"1Chr.1.3","sourceRefExact":"1Chr.1.3"},{"anchorText":"Lk 3:37","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.3.37","rawQueryValue":"Luke.3.37","sourceRefExact":"Luke.3.37"}],"sourceItemFragmentSha256":"dd30b754a6e3170ae3f5f2abbec658f7161152b3d3c68eaaf979bac372c48aa8","sourceItemName":"Methuselah","sourceItemOrder":288,"sourceMember":"Articles/M.