{"content":[{"c":["HUNDRED, Tower of the"],"sourceClass":"h1","t":"p"},{"c":["Tower at the northernmost part of the Jerusalem wall (near where the wall crosses over the Tyropeon Valley). It stood west of the Sheep Gate near the Tower of Hananel (",{"href":"?bref=Neh.3.1","r":"Neh.3.1","rawR":"Neh.3.1","sourceRefs":[{"raw":"Neh.3.1","value":"Neh.3.1"}],"t":"ref","v":"Neh 3:1"},"; ",{"href":"?bref=Neh.12.39","r":"Neh.12.39","rawR":"Neh.12.39","sourceRefs":[{"raw":"Neh.12.39","value":"Neh.12.39"}],"t":"ref","v":"12:39"},"; ",{"c":["kjv"],"sourceClass":"sc","t":"span"}," “tower of Meah”). ",{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Jerusalem_Article_TyndaleOpenBibleDictionary","id":"Jerusalem_Article_TyndaleOpenBibleDictionary","rawId":"Jerusalem_Article_TyndaleOpenBibleDictionary","t":"link","v":"Jerusalem"},"."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"HundredTowerofthe","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Neh 3:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.3.1","rawQueryValue":"Neh.3.1","sourceRefExact":"Neh.3.1"},{"anchorText":"12:39","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.12.39","rawQueryValue":"Neh.12.39","sourceRefExact":"Neh.12.39"}],"sourceItemFragmentSha256":"28368b64f3b1e1e956a33e4886ba639aeccc64d3f0bffe3913552ff953455d58","sourceItemName":"HundredTowerofthe","sourceItemOrder":389,"sourceMember":"Articles/H.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"HundredTowerofthe","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Hundred, Tower of the","title":"Hundred, Tower of the","version":"v2-a101d843a2f0cd3fc0c6"}