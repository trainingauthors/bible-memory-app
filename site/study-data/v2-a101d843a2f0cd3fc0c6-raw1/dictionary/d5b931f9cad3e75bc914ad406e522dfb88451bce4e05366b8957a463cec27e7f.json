{"content":[{"c":["EUNICE"],"sourceClass":"h1","t":"p"},{"c":["Timothy’s mother, daughter of Lois (",{"href":"?bref=2Tim.1.5","r":"2Tim.1.5","rawR":"2Tim.1.5","sourceRefs":[{"raw":"2Tim.1.5","value":"2Tim.1.5"}],"t":"ref","v":"2 Tm 1:5"},"), and the wife of a pagan Greek. She was a Jewish Christian (",{"href":"?bref=Acts.16.1","r":"Acts.16.1","rawR":"Acts.16.1","sourceRefs":[{"raw":"Acts.16.1","value":"Acts.16.1"}],"t":"ref","v":"Acts 16:1"},"). She apparently taught her son the OT Scriptures “from childhood” (",{"href":"?bref=2Tim.3.15","r":"2Tim.3.15","rawR":"2Tim.3.15","sourceRefs":[{"raw":"2Tim.3.15","value":"2Tim.3.15"}],"t":"ref","v":"2 Tm 3:15"},") and was converted to Christianity during Paul’s first trip to her home in Lystra, previous to his visit mentioned in ",{"href":"?bref=Acts.16.1","r":"Acts.16.1","rawR":"Acts.16.1","sourceRefs":[{"raw":"Acts.16.1","value":"Acts.16.1"}],"t":"ref","v":"Acts 16:1"},"."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Eunice","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Tm 1:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Tim.1.5","rawQueryValue":"2Tim.1.5","sourceRefExact":"2Tim.1.5"},{"anchorText":"Acts 16:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.16.1","rawQueryValue":"Acts.16.1","sourceRefExact":"Acts.16.1"},{"anchorText":"2 Tm 3:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Tim.3.15","rawQueryValue":"2Tim.3.15","sourceRefExact":"2Tim.3.15"},{"anchorText":"Acts 16:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.16.1","rawQueryValue":"Acts.16.1","sourceRefExact":"Acts.16.1"}],"sourceItemFragmentSha256":"cc7443c6dafa3a635aa9f2452606decf3918d44ff7c1dd676de4b5d5c985a003","sourceItemName":"Eunice","sourceItemOrder":272,"sourceMember":"Articles/E.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Eunice","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Eunice","title":"Eunice","version":"v2-a101d843a2f0cd3fc0c6"}