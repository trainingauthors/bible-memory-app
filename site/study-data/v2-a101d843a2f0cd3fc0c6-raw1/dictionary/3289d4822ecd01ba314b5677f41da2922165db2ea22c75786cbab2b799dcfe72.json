canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rom.5.11","rawQueryValue":"Rom.5.11","sourceRefExact":"Rom.5.11"},{"anchorText":"Romans 5:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rom.5.3","rawQueryValue":"Rom.5.3","sourceRefExact":"Rom.5.3"},{"anchorText":"2 Cor 3:2-6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Cor.3.2-6","rawQueryValue":"2Cor.3.2-6","sourceRefExact":"2Cor.3.2-6"},{"anchorText":"10:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Cor.10.18","rawQueryValue":"2Cor.10.18","sourceRefExact":"2Cor.10.18"},{"anchorText":"12:5, 9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Cor.12.5,9","rawQueryValue":"2Cor.12.5,9","sourceRefExact":"2Cor.12.5,9"},{"anchorText":"7:4, 14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Cor.7.4,14","rawQueryValue":"2Cor.7.4,14","sourceRefExact":"2Cor.7.4,14"},{"anchorText":"8:24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Cor.8.24","rawQueryValue":"2Cor.8.24","sourceRefExact":"2Cor.8.24"},{"anchorText":"9:2-3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Cor.9.2-3","rawQueryValue":"2Cor.9.2-3","sourceRefExact":"2Cor.9.2-3"},{"anchorText":"2 Cor 12:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Cor.12.11","rawQueryValue":"2Cor.12.11","sourceRefExact":"2Cor.12.11"}],"sourceItemFragmentSha256":"a0fa6c7e8e2ed6a11009a9542faa2d8d0ffbe9c259ee08b1e8f31a71e0ff2fac","sourceItemName":"Boast","sourceItemOrder":355,"sourceMember":"Articles/B.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Boast","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Boast","title":"Boast","version":"v2-a101d843a2f0cd3fc0c6"}