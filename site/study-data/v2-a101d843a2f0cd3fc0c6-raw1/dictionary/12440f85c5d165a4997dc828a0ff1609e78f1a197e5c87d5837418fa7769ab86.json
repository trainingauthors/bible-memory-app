{"content":[{"c":["CUN"],"sourceClass":"h1","t":"p"},{"c":["Syrian city belonging to Hadadezer, king of Zobah. David raided Cun, taking away large quantities of bronze (",{"href":"?bref=1Chr.18.8","r":"1Chr.18.8","rawR":"1Chr.18.8","sourceRefs":[{"raw":"1Chr.18.8","value":"1Chr.18.8"}],"t":"ref","v":"1 Chr 18:8"},"). In a parallel account, Berothai may be the same place (",{"href":"?bref=2Sam.8.8","r":"2Sam.8.8","rawR":"2Sam.8.8","sourceRefs":[{"raw":"2Sam.8.8","value":"2Sam.8.8"}],"t":"ref","v":"2 Sm 8:8"},")."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=BerothahBerothai_Article_TyndaleOpenBibleDictionary","id":"BerothahBerothai_Article_TyndaleOpenBibleDictionary","rawId":"BerothahBerothai_Article_TyndaleOpenBibleDictionary","t":"link","v":"Berothah, Berothai"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Cun","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 18:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.18.8","rawQueryValue":"1Chr.18.8","sourceRefExact":"1Chr.18.8"},{"anchorText":"2 Sm 8:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.8.8","rawQueryValue":"2Sam.8.8","sourceRefExact":"2Sam.8.8"}],"sourceItemFragmentSha256":"6c8e9a6cdd74020f9d9d400d8aabb07344728fb26ad114c86a5429fe6b371e1d","sourceItemName":"Cun","sourceItemOrder":335,"sourceMember":"Articles/C.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Cun","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Cun","title":"Cun","version":"v2-a101d843a2f0cd3fc0c6"}