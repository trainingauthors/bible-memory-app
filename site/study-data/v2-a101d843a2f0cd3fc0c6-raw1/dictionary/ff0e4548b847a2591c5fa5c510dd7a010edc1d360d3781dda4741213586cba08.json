{"content":[{"c":["WAY, The"],"sourceClass":"h1","t":"p"},{"c":["One of the names applied to the early Christian community (",{"href":"?bref=Acts.9.2","r":"Acts.9.2","rawR":"Acts.9.2","sourceRefs":[{"raw":"Acts.9.2","value":"Acts.9.2"}],"t":"ref","v":"Acts 9:2"},"). It was apparently used by both the Jewish and the secular community and appeared in both positive and negative assessments of the church (",{"href":"?bref=Acts.19.9,23","r":"Acts.19.9,23","rawR":"Acts.19.9,23","sourceRefs":[{"raw":"Acts.19.9,23","value":"Acts.19.9,23"}],"t":"ref","v":"19:9, 23"},"; ",{"href":"?bref=Acts.22.4","r":"Acts.22.4","rawR":"Acts.22.4","sourceRefs":[{"raw":"Acts.22.4","value":"Acts.22.4"}],"t":"ref","v":"22:4"},"; ",{"href":"?bref=Acts.24.14,22","r":"Acts.24.14,22","rawR":"Acts.24.14,22","sourceRefs":[{"raw":"Acts.24.14,22","value":"Acts.24.14,22"}],"t":"ref","v":"24:14, 22"},"). Paul’s use of the term in his defense before Felix suggests that the name had at least quasiofficial acceptance (",{"href":"?bref=Acts.24.14,22","r":"Acts.24.14,22","rawR":"Acts.24.14,22","sourceRefs":[{"raw":"Acts.24.14,22","value":"Acts.24.14,22"}],"t":"ref","v":"24:14, 22"},"). Quite likely, the term came from Jesus’ own statement, “I am the way, the truth, and the life” (",{"href":"?bref=John.14.6","r":"John.14.6","rawR":"John.14.6","sourceRefs":[{"raw":"John.14.6","value":"John.14.6"}],"t":"ref","v":"Jn 14:6"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Waythe","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Acts 9:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.9.2","rawQueryValue":"Acts.9.2","sourceRefExact":"Acts.9.2"},{"anchorText":"19:9, 23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.19.9,23","rawQueryValue":"Acts.19.9,23","sourceRefExact":"Acts.19.9,23"},{"anchorText":"22:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.22.4","rawQueryValue":"Acts.22.4","sourceRefExact":"Acts.22.4"},{"anchorText":"24:14, 22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.24.14,22","rawQueryValue":"Acts.24.14,22","sourceRefExact":"Acts.24.14,22"},{"anchorText":"24:14, 22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.24.14,22","rawQueryValue":"Acts.24.14,22","sourceRefExact":"Acts.24.14,22"},{"anchorText":"Jn 14:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=John.14.6","rawQueryValue":"John.14.6","sourceRefExact":"John.14.6"}],"sourceItemFragmentSha256":"8196e10c0e9e802ecc783081341c0f391a40c83822a13f79f2689b87b1959c43","sourceItemName":"Waythe","sourceItemOrder":19,"sourceMember":"Articles/W.xml","supplementPointersNotIncludedAsContent":[{"name":"FollowersOfTheWay","src":"../Textboxes/Textboxes.xml"}]},"sourceAttributes":{"name":"Waythe","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Way, the","title":"Way, the","version":"v2-a101d843a2f0cd3fc0c6"}