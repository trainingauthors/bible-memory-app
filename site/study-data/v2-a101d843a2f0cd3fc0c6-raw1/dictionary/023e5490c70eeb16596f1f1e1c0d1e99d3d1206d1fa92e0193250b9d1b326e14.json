{"content":[{"c":["CAPITAL"],"sourceClass":"h1","t":"p"},{"c":["In architecture, the uppermost part of a pillar, often ornately fashioned. Capitals (",{"c":["kjv"],"sourceClass":"sc","t":"span"}," “chapiter”) topped the five pillars of the tabernacle during the wilderness wanderings of the people of Israel (",{"href":"?bref=Exod.36.38","r":"Exod.36.38","rawR":"Exod.36.38","sourceRefs":[{"raw":"Exod.36.38","value":"Exod.36.38"}],"t":"ref","v":"Ex 36:38"},"), as well as the pillars called Boaz and Jachin in King Solomon’s temple (",{"href":"?bref=1Kgs.7.16-22,40-42","r":"1Kgs.7.16-22,40-42","rawR":"1Kgs.7.16-22,40-42","sourceRefs":[{"raw":"1Kgs.7.16-22,40-42","value":"1Kgs.7.16-22,40-42"}],"t":"ref","v":"1 Kgs 7:16-22, 40-42"},")."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Architecture_Article_TyndaleOpenBibleDictionary","id":"Architecture_Article_TyndaleOpenBibleDictionary","rawId":"Architecture_Article_TyndaleOpenBibleDictionary","t":"link","v":"Architecture"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Capital","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ex 36:38","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.36.38","rawQueryValue":"Exod.36.38","sourceRefExact":"Exod.36.38"},{"anchorText":"1 Kgs 7:16-22, 40-42","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.7.16-22,40-42","rawQueryValue":"1Kgs.7.16-22,40-42","sourceRefExact":"1Kgs.7.16-22,40-42"}],"sourceItemFragmentSha256":"495f4bd310005c59285d39d0500ce7236000bab32ebcb23660e20d893e673cca","sourceItemName":"Capital","sourceItemOrder":46,"sourceMember":"Articles/C.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Capital","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Capital