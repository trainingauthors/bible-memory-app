{"content":[{"c":["EZRAHITE"],"sourceClass":"h1","t":"p"},{"c":["Word occurring only three times in the OT. Twice it is used as a title for Ethan (",{"href":"?bref=1Kgs.4.31","r":"1Kgs.4.31","rawR":"1Kgs.4.31","sourceRefs":[{"raw":"1Kgs.4.31","value":"1Kgs.4.31"}],"t":"ref","v":"1 Kgs 4:31"},"; ",{"href":"?bref=Ps.89.1","r":"Ps.89.1","rawR":"Ps.89.1","sourceRefs":[{"raw":"Ps.89.1","value":"Ps.89.1"}],"t":"ref","v":"Ps 89 title"},") and once as a name given to Heman (",{"href":"?bref=Ps.88.1","r":"Ps.88.1","rawR":"Ps.88.1","sourceRefs":[{"raw":"Ps.88.1","value":"Ps.88.1"}],"t":"ref","v":"Ps 88 title"},"). It is no longer thought to be a family name, but instead signifies a member of a pre-Israelite family."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Ezrahite","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Kgs 4:31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.4.31","rawQueryValue":"1Kgs.4.31","sourceRefExact":"1Kgs.4.31"},{"anchorText":"Ps 89 title","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ps.89.1","rawQueryValue":"Ps.89.1","sourceRefExact":"Ps.89.1"},{"anchorText":"Ps 88 title","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ps.88.1","rawQueryValue":"Ps.88.1","sourceRefExact":"Ps.88.1"}],"sourceItemFragmentSha256":"09fa67c9d10396497b350dc56751b00a79fa2fc1ea1ff77eaa2e6b1e74d88a74","sourceItemName":"Ezrahite","sourceItemOrder":315,"sourceMember":"Articles/E.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Ezrahite","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Ezrahite","title":"Ezrahite","version":"v2-a101d843a2f0cd3fc0c6"}