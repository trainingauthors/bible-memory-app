{"content":[{"c":["MINIAMIN"],"sourceClass":"h1","t":"p"},{"c":["1. Levite who assisted Kore, the son of Imnah, with the distribution of the “contribution reserved for the Lord” among the priests in the cities of Judah (",{"href":"?bref=2Chr.31.14-15","r":"2Chr.31.14-15","rawR":"2Chr.31.14-15","sourceRefs":[{"raw":"2Chr.31.14-15","value":"2Chr.31.14-15"}],"t":"ref","v":"2 Chr 31:14-15"},")."],"sourceClass":"list","t":"p"},{"c":["2. Head of a priestly house during the postexilic era (",{"href":"?bref=Neh.12.17","r":"Neh.12.17","rawR":"Neh.12.17","sourceRefs":[{"raw":"Neh.12.17","value":"Neh.12.17"}],"t":"ref","v":"Neh 12:17"},"). He was also called “Mijamin” (",{"href":"?bref=Neh.12.5","r":"Neh.12.5","rawR":"Neh.12.5","sourceRefs":[{"raw":"Neh.12.5","value":"Neh.12.5"}],"t":"ref","v":"12:5"},")."],"sourceClass":"list","t":"p"},{"c":["3. Participant in the dedication of the Jerusalem wall (",{"href":"?bref=Neh.12.41","r":"Neh.12.41","rawR":"Neh.12.41","sourceRefs":[{"raw":"Neh.12.41","value":"Neh.12.41"}],"t":"ref","v":"Neh 12:41"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Miniamin","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Chr 31:14-15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.31.14-15","rawQueryValue":"2Chr.31.14-15","sourceRefExact":"2Chr.31.14-15"},{"anchorText":"Neh 12:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.12.17","rawQueryValue":"Neh.12.17","sourceRefExact":"Neh.12.17"},{"anchorText":"12:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.12.5","rawQueryValue":"Neh.12.5","sourceRefExact":"Neh.12.5"},{"anchorText":"Neh 12:41","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.12.41","rawQueryValue":"Neh.12.41","sourceRefExact":"Neh.12.41"}],"source