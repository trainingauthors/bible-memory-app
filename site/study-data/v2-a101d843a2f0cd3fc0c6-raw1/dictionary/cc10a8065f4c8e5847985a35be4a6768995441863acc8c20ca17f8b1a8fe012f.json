{"content":[{"c":["MOSERAH, MOSEROTH"],"sourceClass":"h1","t":"p"},{"c":["Temporary camping place of the Israelites during their wilderness wanderings. It was positioned between Hashmonah and Bene-jaakan (",{"href":"?bref=Num.33.30-31","r":"Num.33.30-31","rawR":"Num.33.30-31","sourceRefs":[{"raw":"Num.33.30-31","value":"Num.33.30-31"}],"t":"ref","v":"Nm 33:30-31"},"). Later, Aaron died and was buried there (",{"href":"?bref=Deut.10.6","r":"Deut.10.6","rawR":"Deut.10.6","sourceRefs":[{"raw":"Deut.10.6","value":"Deut.10.6"}],"t":"ref","v":"Dt 10:6"},"). Moseroth is the plural form of Moserah."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"MoserahMoseroth","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Nm 33:30-31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.33.30-31","rawQueryValue":"Num.33.30-31","sourceRefExact":"Num.33.30-31"},{"anchorText":"Dt 10:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.10.6","rawQueryValue":"Deut.10.6","sourceRefExact":"Deut.10.6"}],"sourceItemFragmentSha256":"fbdb38ece9ed07d878c2a751e36ed1aaa5d3dcadcfbe1117e41480d5a64ed840","sourceItemName":"MoserahMoseroth","sourceItemOrder":403,"sourceMember":"Articles/M.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"MoserahMoseroth","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Moserah, Moseroth","title":"Moserah, Moseroth","version":"v2-a101d843a2f0cd3fc0c6"}