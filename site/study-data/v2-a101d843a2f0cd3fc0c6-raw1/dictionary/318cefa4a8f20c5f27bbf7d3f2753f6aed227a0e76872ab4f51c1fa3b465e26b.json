{"content":[{"c":["JOGBEHAH"],"sourceClass":"h1","t":"p"},{"c":["City in Gilead (Transjordan) built and fortified by Gad’s tribe (",{"href":"?bref=Num.32.35","r":"Num.32.35","rawR":"Num.32.35","sourceRefs":[{"raw":"Num.32.35","value":"Num.32.35"}],"t":"ref","v":"Nm 32:35"},"). During the period of the judges, Gideon, in his pursuit of the Midianites, circled to the east of Jogbehah in order to attack the unsuspecting camp of Midian at Karkor (",{"href":"?bref=Judg.8.11","r":"Judg.8.11","rawR":"Judg.8.11","sourceRefs":[{"raw":"Judg.8.11","value":"Judg.8.11"}],"t":"ref","v":"Jgs 8:11"},"). This ancient city is now identified with Khirbet el-Ajbeihat, seven miles (11.3 kilometers) northwest of Amman."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Jogbehah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Nm 32:35","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.32.35","rawQueryValue":"Num.32.35","sourceRefExact":"Num.32.35"},{"anchorText":"Jgs 8:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.8.11","rawQueryValue":"Judg.8.11","sourceRefExact":"Judg.8.11"}],"sourceItemFragmentSha256":"fdd2985cf870afbd92a9dcb09975fb4d4c34c4c5a75c0ca2646f1e030f8db490","sourceItemName":"Jogbehah","sourceItemOrder":274,"sourceMember":"Articles/J.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Jogbehah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Jogbehah","title":"Jogbehah","version":"v2-a101d843a2f0cd3fc0c6"}