{"content":[{"c":["BETH-PELET"],"sourceClass":"h1","t":"p"},{"c":["City assigned to Judah at the partitioning of the Promised Land (",{"href":"?bref=Josh.15.27","r":"Josh.15.27","rawR":"Josh.15.27","sourceRefs":[{"raw":"Josh.15.27","value":"Josh.15.27"}],"t":"ref","v":"Jos 15:27"},"). Later resettled by the people of Judah after the return from exile in Babylon (",{"href":"?bref=Neh.11.26","r":"Neh.11.26","rawR":"Neh.11.26","sourceRefs":[{"raw":"Neh.11.26","value":"Neh.11.26"}],"t":"ref","v":"Neh 11:26"},"), Beth-pelet was possibly the hometown of David’s warrior Helez the Paltite (",{"href":"?bref=2Sam.23.26","r":"2Sam.23.26","rawR":"2Sam.23.26","sourceRefs":[{"raw":"2Sam.23.26","value":"2Sam.23.26"}],"t":"ref","v":"2 Sm 23:26"},"; ",{"href":"?bref=1Chr.11.27","r":"1Chr.11.27","rawR":"1Chr.11.27","sourceRefs":[{"raw":"1Chr.11.27","value":"1Chr.11.27"}],"t":"ref","v":"1 Chr 11:27"},", “Pelonite”)."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"BethPelet","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 15:27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.27","rawQueryValue":"Josh.15.27","sourceRefExact":"Josh.15.27"},{"anchorText":"Neh 11:26","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.11.26","rawQueryValue":"Neh.11.26","sourceRefExact":"Neh.11.26"},{"anchorText":"2 Sm 23:26","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.23.26","rawQueryValue":"2Sam.23.26","sourceRefExact":"2Sam.23.26"},{"anchorText":"1 Chr 11:27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.11.27","rawQueryValue":"1Chr.11.27","sourceRefExact":"1Chr.11.27"}],"sourceItemFragmentSha256":"a115978b3d578ef7af2872529d1a3137270b6d2d88bdbc1f0b441cb9fdff51c1","sourceItemName":"BethPelet","sourceItemOrder":269