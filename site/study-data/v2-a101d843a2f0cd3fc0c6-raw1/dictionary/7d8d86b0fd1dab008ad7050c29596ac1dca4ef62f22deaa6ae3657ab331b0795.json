{"content":[{"c":["MASTER"],"sourceClass":"h1","t":"p"},{"c":["Word used to translate five different Hebrew words and seven different Greek terms with root meanings of owner (",{"href":"?bref=Isa.1.3","r":"Isa.1.3","rawR":"Isa.1.3","sourceRefs":[{"raw":"Isa.1.3","value":"Isa.1.3"}],"t":"ref","v":"Is 1:3"},"), elder (",{"href":"?bref=Dan.1.3","r":"Dan.1.3","rawR":"Dan.1.3","sourceRefs":[{"raw":"Dan.1.3","value":"Dan.1.3"}],"t":"ref","v":"Dn 1:3"},"), sovereign (",{"href":"?bref=1Pet.2.18","r":"1Pet.2.18","rawR":"1Pet.2.18","sourceRefs":[{"raw":"1Pet.2.18","value":"1Pet.2.18"}],"t":"ref","v":"1 Pt 2:18"},"), teacher (",{"href":"?bref=Luke.6.40","r":"Luke.6.40","rawR":"Luke.6.40","sourceRefs":[{"raw":"Luke.6.40","value":"Luke.6.40"}],"t":"ref","v":"Lk 6:40"},"), superintendent (",{"href":"?bref=Luke.5.5","r":"Luke.5.5","rawR":"Luke.5.5","sourceRefs":[{"raw":"Luke.5.5","value":"Luke.5.5"}],"t":"ref","v":"Lk 5:5"},"), lord (",{"href":"?bref=Gen.39.3","r":"Gen.39.3","rawR":"Gen.39.3","sourceRefs":[{"raw":"Gen.39.3","value":"Gen.39.3"}],"t":"ref","v":"Gn 39:3"},"), sir (",{"href":"?bref=Judg.19.11","r":"Judg.19.11","rawR":"Judg.19.11","sourceRefs":[{"raw":"Judg.19.11","value":"Judg.19.11"}],"t":"ref","v":"Jgs 19:11"},"), rabbi (",{"href":"?bref=Mark.9.5","r":"Mark.9.5","rawR":"Mark.9.5","sourceRefs":[{"raw":"Mark.9.5","value":"Mark.9.5"}],"t":"ref","v":"Mk 9:5"},"), and captain (",{"href":"?bref=Acts.27.11","r":"Acts.27.11","rawR":"Acts.27.11","sourceRefs":[{"raw":"Acts.27.11","value":"Acts.27.11"}],"t":"ref","v":"Acts 27:11"},"); often used to describe Jesus."],"sourceClass":"fl","t":"p"},{"c":["One of the Greek words, ",{"c":["kurios"],"sourceClass":"greek","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," has multiple meanings with important implications for interpretation. It variously means sir or mister (",{"href":"?bref=Luke.14.21","r":"Luke.14.21","rawR":"Luke.14.21","sourceRefs":[{"raw":"Luke.14.21","value":"Luke.14.21"}],"t":"ref","v":"Lk 14:21"},"), master (",{"href":"?bref=Matt.6.24","r":"Matt.6.24","rawR":"Matt.6.24","sourceRefs":[{"raw":"Matt.6.24","value":"Matt.6.24"}],"t":"ref","v":"Mt 6:24"},"), lord (",{"href":"?bref=Acts.25.26","r":"Acts.25.26","rawR":"Acts.25.26","sourceRefs":[{"raw":"Acts.25.26","value":"Acts.25.26"}],"t":"ref","v":"Acts 25:26"},"), and the Lord God (",{"href":"?bref=Eph.6.9","r":"Eph.6.9","rawR":"Eph.6.9","sourceRefs":[{"raw":"Eph.6.9","value":"Eph.6.9"}],"t":"ref","v":"Eph 6:9"},"). Usually the context clearly indicates the specific meaning intended."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Master","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Is 1:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.1.3","rawQueryValue":"Isa.1.3","sourceRefExact":"Isa.1.3"},{"anchorText":"Dn 1:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Dan.1.3","rawQueryValue":"Dan.1.3","sourceRefExact":"Dan.1.3"},{"anchorText":"1 Pt 2:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Pet.2.18","rawQueryValue":"1Pet.2.18","sourceRefExact":"1Pet.2.18"},{"anchorText":"Lk 6:40","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.6.40","rawQueryValue":"Luke.6.40","sourceRefExact":"Luke.6.40"},{"anchorText":"Lk 5:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.5.5","rawQueryValue":"Luke.5.5","sourceRefExact":"Luke.5.5"},{"anchorText":"Gn 39:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.39.3","rawQueryValue":"Gen.39.3","sourceRefExact":"Gen.39.3"},{"anchorText":"Jgs 19:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.19.11","rawQueryValue":"Judg.19.11","sourceRefExact":"Judg.19.11"},{"anchorText":"Mk 9:5","canonicali