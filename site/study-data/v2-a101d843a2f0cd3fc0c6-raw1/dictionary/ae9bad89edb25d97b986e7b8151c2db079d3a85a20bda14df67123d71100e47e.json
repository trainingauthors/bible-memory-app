{"content":[{"c":["SHEMA (P",{"c":["lace"],"sourceClass":"lc","t":"span"},")"],"sourceClass":"h1","t":"p"},{"c":["One of the 29 cities located near the border of Edom in the southern extremity of the land inherited by Judah, mentioned between the cities of Amam and Moladah (",{"href":"?bref=Josh.15.26","r":"Josh.15.26","rawR":"Josh.15.26","sourceRefs":[{"raw":"Josh.15.26","value":"Josh.15.26"}],"t":"ref","v":"Jos 15:26"},"). In the parallel list at ",{"href":"?bref=Josh.19.2","r":"Josh.19.2","rawR":"Josh.19.2","sourceRefs":[{"raw":"Josh.19.2","value":"Josh.19.2"}],"t":"ref","v":"Joshua 19:2"},", Sheba (the LXX has “Shema”) was one of 13 cities assigned to Simeon’s tribe within the southern portion of Judah’s inheritance. ",{"c":["See"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=ShebaPlace_Article_TyndaleOpenBibleDictionary","id":"ShebaPlace_Article_TyndaleOpenBibleDictionary","rawId":"ShebaPlace_Article_TyndaleOpenBibleDictionary","t":"link","v":"Sheba #1"},"."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"ShemaPlace","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 15:26","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.26","rawQueryValue":"Josh.15.26","sourceRefExact":"Josh.15.26"},{"anchorText":"Joshua 19:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.19.2","rawQueryValue":"Josh.19.2","sourceRefExact":"Josh.19.2"}],"sourceItemFragmentSha256":"5fb0183855e5de37439ff63c078f2ae57eb5fc471d6d446247b991c95b882838","sourceItemName":"ShemaPlace","sourceItemOrder":270,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"ShemaPlace","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Shema (Place)","title":"Shema (Place)","version":"v2-a101d843a2f0cd3fc0c6"}