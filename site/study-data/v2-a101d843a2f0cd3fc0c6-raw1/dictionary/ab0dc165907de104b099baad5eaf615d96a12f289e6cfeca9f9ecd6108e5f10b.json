{"content":[{"c":["GERUTH-KIMHAM"],"sourceClass":"h1","t":"p"},{"c":["Plot of land (meaning “the lodging place of Kimham”) near Bethlehem. Geruth-kimham possibly was given to Kimham for the service that his father, Barzillai the Gileadite, had rendered to King David (",{"href":"?bref=2Sam.19.31-40","r":"2Sam.19.31-40","rawR":"2Sam.19.31-40","sourceRefs":[{"raw":"2Sam.19.31-40","value":"2Sam.19.31-40"}],"t":"ref","v":"2 Sm 19:31-40"},"; ",{"href":"?bref=1Kgs.2.7","r":"1Kgs.2.7","rawR":"1Kgs.2.7","sourceRefs":[{"raw":"1Kgs.2.7","value":"1Kgs.2.7"}],"t":"ref","v":"1 Kgs 2:7"},"). After the fall of Jerusalem (586 ",{"c":["BC"],"sourceClass":"era","t":"span"},"), Geruth-kimham was the camp of Johanan son of Kareah and his men as they prepared to flee to Egypt (",{"href":"?bref=Jer.41.17","r":"Jer.41.17","rawR":"Jer.41.17","sourceRefs":[{"raw":"Jer.41.17","value":"Jer.41.17"}],"t":"ref","v":"Jer 41:17"},"). ",{"c":["See"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Kimham_Article_TyndaleOpenBibleDictionary","id":"Kimham_Article_TyndaleOpenBibleDictionary","rawId":"Kimham_Article_TyndaleOpenBibleDictionary","t":"link","v":"Kimham"},"."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"GeruthKimham","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Sm 19:31-40","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.19.31-40","rawQueryValue":"2Sam.19.31-40","sourceRefExact":"2Sam.19.31-40"},{"anchorText":"1 Kgs 2:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.2.7","rawQueryValue":"1Kgs.2.7","sourceRefExact":"1Kgs.2.7"},{"anchorText":"Jer 41:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.41.17","rawQueryValue":"Jer.41.17","sourceRefExact":"Jer.41.17"}],"sourceItemFragmentSha256":"0b8b9a0099a0ea6919eee2f1362549a9e6a8682332e96a