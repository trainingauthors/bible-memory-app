{"content":[{"c":["DEMAS"],"sourceClass":"h1","t":"p"},{"c":["One of Paul’s associates who was with him during one of his imprisonments. Little is known about Demas beyond the brief information given in the NT. Initially he supported Paul’s ministry and was mentioned in the salutations of Paul’s letters to the Colossians (",{"href":"?bref=Col.4.14","r":"Col.4.14","rawR":"Col.4.14","sourceRefs":[{"raw":"Col.4.14","value":"Col.4.14"}],"t":"ref","v":"Col 4:14"},") and to Philemon (",{"href":"?bref=Phlm.1.24","r":"Phlm.1.24","rawR":"Phlm.1.24","sourceRefs":[{"raw":"Phlm.1.24","value":"Phlm.1.24"}],"t":"ref","v":"Phlm 1:24"},"). However, in ",{"href":"?bref=2Tim.4.10","r":"2Tim.4.10","rawR":"2Tim.4.10","sourceRefs":[{"raw":"2Tim.4.10","value":"2Tim.4.10"}],"t":"ref","v":"2 Timothy 4:10"}," Paul writes that Demas deserted him because of his love for the present world."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Demas","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Col 4:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Col.4.14","rawQueryValue":"Col.4.14","sourceRefExact":"Col.4.14"},{"anchorText":"Phlm 1:24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Phlm.1.24","rawQueryValue":"Phlm.1.24","sourceRefExact":"Phlm.1.24"},{"anchorText":"2 Timothy 4:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Tim.4.10","rawQueryValue":"2Tim.4.10","sourceRefExact":"2Tim.4.10"}],"sourceItemFragmentSha256":"86b7a3c5df797e38ea9a18ca44d8d58052abbd5b90eff48021aca7ba093a4389","sourceItemName":"Demas","sourceItemOrder":75,"sourceMember":"Articles/D.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Demas","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Demas","title":"Demas","version":"v2-a1