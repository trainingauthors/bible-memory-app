{"content":[{"c":["SECUNDUS"],"sourceClass":"h1","t":"p"},{"c":["A Thessalonian believer; traveling companion of Aristarchus. Secundus accompanied Paul on his third missionary journey through Macedonia and Greece and awaited him at Troas in Asia Minor (",{"href":"?bref=Acts.20.4","r":"Acts.20.4","rawR":"Acts.20.4","sourceRefs":[{"raw":"Acts.20.4","value":"Acts.20.4"}],"t":"ref","v":"Acts 20:4"},"). It is not known whether Secundus remained at Troas or went with Paul on his final trip to Jerusalem."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Secundus","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Acts 20:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.20.4","rawQueryValue":"Acts.20.4","sourceRefExact":"Acts.20.4"}],"sourceItemFragmentSha256":"5f4eb6a60dd31e746ffd349fd6cf72d61fcc4c15675da2815a9ab3506d8dc34d","sourceItemName":"Secundus","sourceItemOrder":131,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Secundus","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Secundus","title":"Secundus","version":"v2-a101d843a2f0cd3fc0c6"}