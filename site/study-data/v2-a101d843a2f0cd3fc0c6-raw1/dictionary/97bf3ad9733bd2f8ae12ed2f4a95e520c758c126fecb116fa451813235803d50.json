ary_mapping_workstream","hrefExact":"?bref=Ps.115.1-118.29","rawQueryValue":"Ps.115.1-118.29","sourceRefExact":"Ps.115.1-118.29"},{"anchorText":"Revelation 19:1-6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.19.1-6","rawQueryValue":"Rev.19.1-6","sourceRefExact":"Rev.19.1-6"},{"anchorText":"Psalms 113","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ps.113.1-9","rawQueryValue":"Ps.113.1-9","sourceRefExact":"Ps.113.1-9"},{"anchorText":"114","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ps.114.1-8","rawQueryValue":"Ps.114.1-8","sourceRefExact":"Ps.114.1-8"},{"anchorText":"118","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ps.118.1-29","rawQueryValue":"Ps.118.1-29","sourceRefExact":"Ps.118.1-29"}],"sourceItemFragmentSha256":"d757ec707c03c44c54a45bcce4ead3b407acd40c2e6a9040e41c9203539be0a5","sourceItemName":"Hallelujah","sourceItemOrder":57,"sourceMember":"Articles/H.xml","supplementPointersNotIncludedAsContent":[{"name":"CalligraphyByTimothyRBotts","src":"../Pictures/Pictures.xml"}]},"sourceAttributes":{"name":"Hallelujah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Hallelujah","title":"Hallelujah","version":"v2-a101d843a2f0cd3fc0c6"}