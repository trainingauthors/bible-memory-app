{"content":[{"c":["RUFUS"],"sourceClass":"h1","t":"p"},{"c":["1. One of the sons of Simon of Cyrene (",{"href":"?bref=Mark.15.21","r":"Mark.15.21","rawR":"Mark.15.21","sourceRefs":[{"raw":"Mark.15.21","value":"Mark.15.21"}],"t":"ref","v":"Mk 15:21"},")."],"sourceClass":"list","t":"p"},{"c":["2. Christian to whom Paul sent greetings, adding a special endearing comment about his mother (",{"href":"?bref=Rom.16.13","r":"Rom.16.13","rawR":"Rom.16.13","sourceRefs":[{"raw":"Rom.16.13","value":"Rom.16.13"}],"t":"ref","v":"Rom 16:13"},"). He is perhaps the same as #1 above."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Rufus","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Mk 15:21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mark.15.21","rawQueryValue":"Mark.15.21","sourceRefExact":"Mark.15.21"},{"anchorText":"Rom 16:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rom.16.13","rawQueryValue":"Rom.16.13","sourceRefExact":"Rom.16.13"}],"sourceItemFragmentSha256":"202b6aaff4435109dae0d85108cfebad0ee7a03ce4b71d33a51287eb79912100","sourceItemName":"Rufus","sourceItemOrder":181,"sourceMember":"Articles/R.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Rufus","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Rufus","title":"Rufus","version":"v2-a101d843a2f0cd3fc0c6"}