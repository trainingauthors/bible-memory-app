"hrefExact":"?bref=Jer.22.3","rawQueryValue":"Jer.22.3","sourceRefExact":"Jer.22.3"},{"anchorText":"Zec 7:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Zech.7.10","rawQueryValue":"Zech.7.10","sourceRefExact":"Zech.7.10"},{"anchorText":"Jn 14:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=John.14.18","rawQueryValue":"John.14.18","sourceRefExact":"John.14.18"},{"anchorText":"Jas 1:27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jas.1.27","rawQueryValue":"Jas.1.27","sourceRefExact":"Jas.1.27"}],"sourceItemFragmentSha256":"8fcfc238716db12102e477fa57100de6ae9141297696b2c785c0241f7b2013ab","sourceItemName":"Orphan","sourceItemOrder":81,"sourceMember":"Articles/O.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Orphan","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Orphan","title":"Orphan","version":"v2-a101d843a2f0cd3fc0c6"}