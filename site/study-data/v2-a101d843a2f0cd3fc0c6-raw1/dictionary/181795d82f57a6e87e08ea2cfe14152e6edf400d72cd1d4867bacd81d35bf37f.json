":"Jer.13.14","sourceRefExact":"Jer.13.14"},{"anchorText":"21:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.21.7","rawQueryValue":"Jer.21.7","sourceRefExact":"Jer.21.7"},{"anchorText":"Hos 13:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Hos.13.14","rawQueryValue":"Hos.13.14","sourceRefExact":"Hos.13.14"},{"anchorText":"Dt 30:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.30.3","rawQueryValue":"Deut.30.3","sourceRefExact":"Deut.30.3"},{"anchorText":"Ps 135:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ps.135.14","rawQueryValue":"Ps.135.14","sourceRefExact":"Ps.135.14"},{"anchorText":"Is 14:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.14.1","rawQueryValue":"Isa.14.1","sourceRefExact":"Isa.14.1"},{"anchorText":"49:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.49.13","rawQueryValue":"Isa.49.13","sourceRefExact":"Isa.49.13"},{"anchorText":"54:7-8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.54.7-8","rawQueryValue":"Isa.54.7-8","sourceRefExact":"Isa.54.7-8"},{"anchorText":"Jer 12:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.12.15","rawQueryValue":"Jer.12.15","sourceRefExact":"Jer.12.15"},{"anchorText":"30:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.30.18","rawQueryValue":"Jer.30.18","sourceRefExact":"Jer.30.18"},{"anchorText":"Mi 7:19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mic.7.19","rawQueryValue":"Mic.7.19","sourceRefExact":"Mic.7.19"},{"anchorText":"Lk 10:33","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.10.33","rawQueryValue":"Luke.10.33","sourceRefExact":"Luke.10.33"},{"anchorText":"15:20","canonicaliza