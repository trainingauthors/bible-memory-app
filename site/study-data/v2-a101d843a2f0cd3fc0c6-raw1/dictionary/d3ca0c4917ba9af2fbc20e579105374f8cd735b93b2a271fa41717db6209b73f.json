{"content":[{"c":["GE-HARASHIM*"],"sourceClass":"h1","t":"p"},{"c":["Name for a richly wooded valley near Lod and Ono, settled by Joab from Judah’s tribe, whose posterity called the valley Ge-harashim, meaning “valley of craftsmen,” after their own trade (",{"href":"?bref=1Chr.4.14","r":"1Chr.4.14","rawR":"1Chr.4.14","sourceRefs":[{"raw":"1Chr.4.14","value":"1Chr.4.14"}],"t":"ref","v":"1 Chr 4:14"},", ",{"c":["nlt"],"sourceClass":"sc","t":"span"}," mg). In the fifth century ",{"c":["BC"],"sourceClass":"era","t":"span"}," the area was resettled by people from Benjamin’s tribe (",{"href":"?bref=Neh.11.35","r":"Neh.11.35","rawR":"Neh.11.35","sourceRefs":[{"raw":"Neh.11.35","value":"Neh.11.35"}],"t":"ref","v":"Neh 11:35"},", “valley of craftsmen“)."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"GeHarashim","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 4:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.4.14","rawQueryValue":"1Chr.4.14","sourceRefExact":"1Chr.4.14"},{"anchorText":"Neh 11:35","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.11.35","rawQueryValue":"Neh.11.35","sourceRefExact":"Neh.11.35"}],"sourceItemFragmentSha256":"9b91d7077404cdaa40c32140bb1a1054e0b157d7037d09d5ff94292310fda4ac","sourceItemName":"GeHarashim","sourceItemOrder":79,"sourceMember":"Articles/G.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"GeHarashim","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Ge-Harashim*","title":"Ge-Harashim*","version":"v2-a101d843a2f0cd3fc0c6"}