{"content":[{"c":["DEDAN (P",{"c":["erson"],"sourceClass":"lc","t":"span"},")"],"sourceClass":"h1","t":"p"},{"c":["1. Grandson of Cush in the list of Noah’s descendants. His father was Raamah, and his brother’s name was Sheba (",{"href":"?bref=Gen.10.7","r":"Gen.10.7","rawR":"Gen.10.7","sourceRefs":[{"raw":"Gen.10.7","value":"Gen.10.7"}],"t":"ref","v":"Gn 10:7"},"; ",{"href":"?bref=1Chr.1.9","r":"1Chr.1.9","rawR":"1Chr.1.9","sourceRefs":[{"raw":"1Chr.1.9","value":"1Chr.1.9"}],"t":"ref","v":"1 Chr 1:9"},")."],"sourceClass":"list","t":"p"},{"c":["2. Grandson of Abraham through Keturah (",{"href":"?bref=Gen.25.3","r":"Gen.25.3","rawR":"Gen.25.3","sourceRefs":[{"raw":"Gen.25.3","value":"Gen.25.3"}],"t":"ref","v":"Gn 25:3"},"). His father was Jokshan, his brother was Sheba, and his descendants were the Asshurim, Letushim, and Leummim."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"DedanPerson","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 10:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.10.7","rawQueryValue":"Gen.10.7","sourceRefExact":"Gen.10.7"},{"anchorText":"1 Chr 1:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.1.9","rawQueryValue":"1Chr.1.9","sourceRefExact":"1Chr.1.9"},{"anchorText":"Gn 25:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.25.3","rawQueryValue":"Gen.25.3","sourceRefExact":"Gen.25.3"}],"sourceItemFragmentSha256":"949711129d75a98836aaa14019b26b8fa895a16b33bd54dd34b5686a176f3189","sourceItemName":"DedanPerson","sourceItemOrder":62,"sourceMember":"Articles/D.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"DedanPerson","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Dedan (Person)","title":"Dedan (Person)","version":"v2-a101d843a2f