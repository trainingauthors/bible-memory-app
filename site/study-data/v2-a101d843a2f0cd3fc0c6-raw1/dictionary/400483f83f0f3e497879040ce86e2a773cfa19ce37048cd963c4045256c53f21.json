{"content":[{"c":["SHIMEATHITE"],"sourceClass":"h1","t":"p"},{"c":["One of three families of scribes living at Jabez in Judah. They were perhaps Kenites and descendants of Hammath (",{"href":"?bref=1Chr.2.55","r":"1Chr.2.55","rawR":"1Chr.2.55","sourceRefs":[{"raw":"1Chr.2.55","value":"1Chr.2.55"}],"t":"ref","v":"1 Chr 2:55"},"). Their history is not certain. The Shimeathites may be identified with one of the nomadic Kenite tribes that settled with the Amalekites in southern Palestine during Saul’s reign in Israel (1020–1000 ",{"c":["BC"],"sourceClass":"era","t":"span"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Shimeathite","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 2:55","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.2.55","rawQueryValue":"1Chr.2.55","sourceRefExact":"1Chr.2.55"}],"sourceItemFragmentSha256":"67f41dd7380fa52a04c77051d1fd6bea56e4a58313c00dd867dbbe6b59303019","sourceItemName":"Shimeathite","sourceItemOrder":329,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Shimeathite","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Shimeathite","title":"Shimeathite","version":"v2-a101d843a2f0cd3fc0c6"}