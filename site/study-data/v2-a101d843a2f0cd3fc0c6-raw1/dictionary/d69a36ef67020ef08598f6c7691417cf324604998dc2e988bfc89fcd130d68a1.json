{"content":[{"c":["ELON (P",{"c":["erson"],"sourceClass":"lc","t":"span"},")"],"sourceClass":"h1","t":"p"},{"c":["1. Hittite who was the father of Basemath (perhaps also called Adah, ",{"href":"?bref=Gen.36.2","r":"Gen.36.2","rawR":"Gen.36.2","sourceRefs":[{"raw":"Gen.36.2","value":"Gen.36.2"}],"t":"ref","v":"Gn 36:2"},"), one of Esau’s wives (",{"href":"?bref=Gen.26.34","r":"Gen.26.34","rawR":"Gen.26.34","sourceRefs":[{"raw":"Gen.26.34","value":"Gen.26.34"}],"t":"ref","v":"26:34"},")."],"sourceClass":"list","t":"p"},{"c":["2. Second of Zebulun’s three sons (",{"href":"?bref=Gen.46.14","r":"Gen.46.14","rawR":"Gen.46.14","sourceRefs":[{"raw":"Gen.46.14","value":"Gen.46.14"}],"t":"ref","v":"Gn 46:14"},") and the founder of the Elonite family (",{"href":"?bref=Num.26.26","r":"Num.26.26","rawR":"Num.26.26","sourceRefs":[{"raw":"Num.26.26","value":"Num.26.26"}],"t":"ref","v":"Nm 26:26"},")."],"sourceClass":"list","t":"p"},{"c":["3. Judge from Zebulun who judged Israel for 10 years. He was buried in Aijalon (",{"href":"?bref=Judg.12.11-12","r":"Judg.12.11-12","rawR":"Judg.12.11-12","sourceRefs":[{"raw":"Judg.12.11-12","value":"Judg.12.11-12"}],"t":"ref","v":"Jgs 12:11-12"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"ElonPerson","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 36:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.36.2","rawQueryValue":"Gen.36.2","sourceRefExact":"Gen.36.2"},{"anchorText":"26:34","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.26.34","rawQueryValue":"Gen.26.34","sourceRefExact":"Gen.26.34"},{"anchorText":"Gn 46:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.46.14","rawQueryValue":"Gen.46.14","sourceRefExact":"Gen.46.14"},{"anchorText":"Nm 26:26","canonicalization":"deferred_to_dicti