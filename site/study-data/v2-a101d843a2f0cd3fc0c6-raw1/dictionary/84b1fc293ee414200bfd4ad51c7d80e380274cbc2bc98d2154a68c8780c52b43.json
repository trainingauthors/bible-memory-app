{"content":[{"c":["TABERNACLES*, Feast of"],"sourceClass":"h1","t":"p"},{"c":["Also known as the Feast of Booths, Shelters, or Ingathering. It was one of the three great festivals of Israel, celebrating the completion of the agricultural year. The Jews built booths or tabernacles (temporary shelters) to commemorate their deliverance from Egypt by the hand of God (",{"href":"?bref=Lev.23.33-43","r":"Lev.23.33-43","rawR":"Lev.23.33-43","sourceRefs":[{"raw":"Lev.23.33-43","value":"Lev.23.33-43"}],"t":"ref","v":"Lv 23:33-43"},"). ",{"c":["See"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=FeastsandFestivalsofIsrael_Article_TyndaleOpenBibleDictionary","id":"FeastsandFestivalsofIsrael_Article_TyndaleOpenBibleDictionary","rawId":"FeastsandFestivalsofIsrael_Article_TyndaleOpenBibleDictionary","t":"link","v":"Feasts and Festivals of Israel"},"."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"TabernaclesFeastof","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Lv 23:33-43","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Lev.23.33-43","rawQueryValue":"Lev.23.33-43","sourceRefExact":"Lev.23.33-43"}],"sourceItemFragmentSha256":"e0649c008db5a96b1d4e18b60641192084fb0bf9543d8f6a540c3e1bedeb4d8c","sourceItemName":"TabernaclesFeastof","sourceItemOrder":9,"sourceMember":"Articles/T.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"TabernaclesFeastof","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Tabernacles*, Feast of","title":"Tabernacles*, Feast of","version":"v2-a101d843a2f0cd3fc0c6"}