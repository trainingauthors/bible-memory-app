{"content":[{"c":["SANSANNAH"],"sourceClass":"h1","t":"p"},{"c":["One of 29 cities at the southern extremity of the land inherited by the sons of Judah (",{"href":"?bref=Josh.15.31","r":"Josh.15.31","rawR":"Josh.15.31","sourceRefs":[{"raw":"Josh.15.31","value":"Josh.15.31"}],"t":"ref","v":"Jos 15:31"},"). It is possibly the same city as Hazar-susah mentioned in a parallel description of the territory allotted to Simeon within Judah’s inheritance (",{"href":"?bref=Josh.19.5","r":"Josh.19.5","rawR":"Josh.19.5","sourceRefs":[{"raw":"Josh.19.5","value":"Josh.19.5"}],"t":"ref","v":"19:5"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Sansannah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 15:31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.31","rawQueryValue":"Josh.15.31","sourceRefExact":"Josh.15.31"},{"anchorText":"19:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.19.5","rawQueryValue":"Josh.19.5","sourceRefExact":"Josh.19.5"}],"sourceItemFragmentSha256":"4564feae5caa7175a7aa7b5878cce13c067e8cceb977689fa3837b3e51e1f1a8","sourceItemName":"Sansannah","sourceItemOrder":59,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Sansannah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Sansannah","title":"Sansannah","version":"v2-a101d843a2f0cd3fc0c6"}