{"content":[{"c":["SUKKIIM*, SUKKIIMS*, SUKKITES"],"sourceClass":"h1","t":"p"},{"c":["A tribe who joined forces with King Shishak of Egypt and entered Palestine to wage war against King Rehoboam of Judah (930–913 ",{"c":["BC"],"sourceClass":"era","t":"span"},"). The Sukkites are mentioned with the Libyans and the Ethiopians (",{"href":"?bref=2Chr.12.3","r":"2Chr.12.3","rawR":"2Chr.12.3","sourceRefs":[{"raw":"2Chr.12.3","value":"2Chr.12.3"}],"t":"ref","v":"2 Chr 12:3"},"). They were probably a Libyan people."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"SukkiimSukkiimsSukkites","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Chr 12:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.12.3","rawQueryValue":"2Chr.12.3","sourceRefExact":"2Chr.12.3"}],"sourceItemFragmentSha256":"12efd399e5c3cf27976cb26b51ddd43844141044a461fbdb7f7a6e1b414981a5","sourceItemName":"SukkiimSukkiimsSukkites","sourceItemOrder":572,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"SukkiimSukkiimsSukkites","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Sukkiim*, Sukkiims*, Sukkites","title":"Sukkiim*, Sukkiims*, Sukkites","version":"v2-a101d843a2f0cd3fc0c6"}