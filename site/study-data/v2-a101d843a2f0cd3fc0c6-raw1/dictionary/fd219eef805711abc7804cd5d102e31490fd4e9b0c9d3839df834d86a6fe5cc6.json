{"content":[{"c":["LILY-WORK*"],"sourceClass":"h1","t":"p"},{"c":["Design of a lily or lotus used on ancient pillars, inspired by the large water lily found along the Nile. It appeared at the vestibule of Solomon’s temple (",{"href":"?bref=1Kgs.7.19-22","r":"1Kgs.7.19-22","rawR":"1Kgs.7.19-22","sourceRefs":[{"raw":"1Kgs.7.19-22","value":"1Kgs.7.19-22"}],"t":"ref","v":"1 Kgs 7:19-22"},"), around the brim of the basin (v ",{"href":"?bref=1Kgs.7.26","r":"1Kgs.7.26","rawR":"1Kgs.7.26","sourceRefs":[{"raw":"1Kgs.7.26","value":"1Kgs.7.26"}],"t":"ref","v":"26"},"), and in numerous artistic creations of the Assyrians, Persians, and other Near Eastern peoples."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=BronzeSea_Article_TyndaleOpenBibleDictionary","id":"BronzeSea_Article_TyndaleOpenBibleDictionary","rawId":"BronzeSea_Article_TyndaleOpenBibleDictionary","t":"link","v":"Bronze Sea"},"; ",{"href":"?item=Laver_Article_TyndaleOpenBibleDictionary","id":"Laver_Article_TyndaleOpenBibleDictionary","rawId":"Laver_Article_TyndaleOpenBibleDictionary","t":"link","v":"Laver"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"LilyWork","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Kgs 7:19-22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.7.19-22","rawQueryValue":"1Kgs.7.19-22","sourceRefExact":"1Kgs.7.19-22"},{"anchorText":"26","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.7.26","rawQueryValue":"1Kgs.7.26","sourceRefExact":"1Kgs.7.26"}],"sourceItemFragmentSha256":"6c61ea9040abfddc5712042345eefa264deec42c2de45d5f933772cdbb72ea2c","sourceItemName":"LilyWork","sourceItemOrder":102,"sourceMember":"Articles/L.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"LilyWork","product":"TyndaleOpenB