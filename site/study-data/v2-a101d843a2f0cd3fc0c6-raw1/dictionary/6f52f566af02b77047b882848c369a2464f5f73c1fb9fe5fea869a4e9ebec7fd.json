{"content":[{"c":["BETH-HOGLAH"],"sourceClass":"h1","t":"p"},{"c":["City allotted to Benjamin’s tribe (",{"href":"?bref=Josh.18.21","r":"Josh.18.21","rawR":"Josh.18.21","sourceRefs":[{"raw":"Josh.18.21","value":"Josh.18.21"}],"t":"ref","v":"Jos 18:21"},"). It was southeast of Jericho near the mouth of the Jordan River on the boundary line between the territories of Judah and Benjamin (",{"href":"?bref=Josh.15.6","r":"Josh.15.6","rawR":"Josh.15.6","sourceRefs":[{"raw":"Josh.15.6","value":"Josh.15.6"}],"t":"ref","v":"Jos 15:6"},"; ",{"href":"?bref=Josh.18.19","r":"Josh.18.19","rawR":"Josh.18.19","sourceRefs":[{"raw":"Josh.18.19","value":"Josh.18.19"}],"t":"ref","v":"18:19"},"). It is identified with modern Ain Hajlah."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"BethHoglah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 18:21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.18.21","rawQueryValue":"Josh.18.21","sourceRefExact":"Josh.18.21"},{"anchorText":"Jos 15:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.6","rawQueryValue":"Josh.15.6","sourceRefExact":"Josh.15.6"},{"anchorText":"18:19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.18.19","rawQueryValue":"Josh.18.19","sourceRefExact":"Josh.18.19"}],"sourceItemFragmentSha256":"b92c97d055d43b36afd9530fbd8daf313f5683325dfa17c98b92a3c9d488fc4d","sourceItemName":"BethHoglah","sourceItemOrder":255,"sourceMember":"Articles/B.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"BethHoglah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Beth-Hoglah","title":"Beth-Hoglah","version":"v2-a101d843a2f0cd3fc0c6"}