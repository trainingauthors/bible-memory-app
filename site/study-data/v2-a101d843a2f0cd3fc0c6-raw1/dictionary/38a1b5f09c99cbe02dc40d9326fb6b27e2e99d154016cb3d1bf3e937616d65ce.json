{"content":[{"c":["BETHUEL (P",{"c":["erson"],"sourceClass":"lc","t":"span"},")"],"sourceClass":"h1","t":"p"},{"c":["Youngest son of Abraham’s brother Nahor and his wife, Milcah. Bethuel was thus Abraham’s nephew (",{"href":"?bref=Gen.22.23","r":"Gen.22.23","rawR":"Gen.22.23","sourceRefs":[{"raw":"Gen.22.23","value":"Gen.22.23"}],"t":"ref","v":"Gn 22:23"},"). He was the father of Rebekah (",{"href":"?bref=Gen.24.15,24","r":"Gen.24.15,24","rawR":"Gen.24.15,24","sourceRefs":[{"raw":"Gen.24.15,24","value":"Gen.24.15,24"}],"t":"ref","v":"24:15, 24"},") and was referred to as an Aramean of Paddan-aram (",{"href":"?bref=Gen.25.20","r":"Gen.25.20","rawR":"Gen.25.20","sourceRefs":[{"raw":"Gen.25.20","value":"Gen.25.20"}],"t":"ref","v":"25:20"},"; ",{"href":"?bref=Gen.28.5","r":"Gen.28.5","rawR":"Gen.28.5","sourceRefs":[{"raw":"Gen.28.5","value":"Gen.28.5"}],"t":"ref","v":"28:5"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"BethuelPerson","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 22:23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.22.23","rawQueryValue":"Gen.22.23","sourceRefExact":"Gen.22.23"},{"anchorText":"24:15, 24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.24.15,24","rawQueryValue":"Gen.24.15,24","sourceRefExact":"Gen.24.15,24"},{"anchorText":"25:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.25.20","rawQueryValue":"Gen.25.20","sourceRefExact":"Gen.25.20"},{"anchorText":"28:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.28.5","rawQueryValue":"Gen.28.5","sourceRefExact":"Gen.28.5"}],"sourceItemFragmentSha256":"0cff9ae1aa3f7989d71ea48865fc0129dd6b0954c81ef23bc0599aa8e8c4625b","sourceItemName":"BethuelPerson","sourceItemOrder":282,"sourceMember":"Articles/B.xml