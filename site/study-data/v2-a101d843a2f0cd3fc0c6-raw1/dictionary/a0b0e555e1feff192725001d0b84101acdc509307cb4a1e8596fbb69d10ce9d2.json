{"content":[{"c":["LEHABIM*, LEHABITES"],"sourceClass":"h1","t":"p"},{"c":["One of several peoples associated with Egypt (",{"href":"?bref=Gen.10.13","r":"Gen.10.13","rawR":"Gen.10.13","sourceRefs":[{"raw":"Gen.10.13","value":"Gen.10.13"}],"t":"ref","v":"Gn 10:13"},"; ",{"href":"?bref=1Chr.1.11","r":"1Chr.1.11","rawR":"1Chr.1.11","sourceRefs":[{"raw":"1Chr.1.11","value":"1Chr.1.11"}],"t":"ref","v":"1 Chr 1:11"},"). The Lehabim are either an unidentified people near Egypt or—as many scholars hold, probably correctly—identical with the Lubim (Libyans). The latter are often seen in the Bible as fighting in alliance with Egypt (",{"href":"?bref=Dan.11.43","r":"Dan.11.43","rawR":"Dan.11.43","sourceRefs":[{"raw":"Dan.11.43","value":"Dan.11.43"}],"t":"ref","v":"Dn 11:43"},"; ",{"href":"?bref=Nah.3.9","r":"Nah.3.9","rawR":"Nah.3.9","sourceRefs":[{"raw":"Nah.3.9","value":"Nah.3.9"}],"t":"ref","v":"Na 3:9"},"), sometimes against Israel, as in the time of Rehoboam (",{"href":"?bref=2Chr.12.3","r":"2Chr.12.3","rawR":"2Chr.12.3","sourceRefs":[{"raw":"2Chr.12.3","value":"2Chr.12.3"}],"t":"ref","v":"2 Chr 12:3"},") and Asa (",{"href":"?bref=2Chr.16.8","r":"2Chr.16.8","rawR":"2Chr.16.8","sourceRefs":[{"raw":"2Chr.16.8","value":"2Chr.16.8"}],"t":"ref","v":"2 Chr 16:8"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"LehabimLehabites","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 10:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.10.13","rawQueryValue":"Gen.10.13","sourceRefExact":"Gen.10.13"},{"anchorText":"1 Chr 1:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.1.11","rawQueryValue":"1Chr.1.11","sourceRefExact":"1Chr.1.11"},{"anchorText":"Dn 11:43","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Dan.11.43","rawQueryValue":"Dan.11.43","sourceRefExact":"Dan.11.43"},{"anchorText":"Na 3:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Nah.3.9","rawQueryValue":"Nah.3.9","sourceRefExact":"Nah.3.9"},{"anchorText":"2 Chr 12:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.12.3","rawQueryValue":"2Chr.12.3","sourceRefExact":"2Chr.12.3"},{"anchorText":"2 Chr 16:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.16.8","rawQueryValue":"2Chr.16.8","sourceRefExact":"2Chr.16.8"}],"sourceItemFragmentSha256":"bb81a6c8a74d546575a8ea113bd7d486c19a58bed903f67744355fb4e9600329","sourceItemName":"LehabimLehabites","sourceItemOrder":64,"sourceMember":"Articles/L.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"LehabimLehabites","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Lehabim*, Lehabites","title":"Lehabim*, Lehabites","version":"v2-a101d843a2f0cd3fc0c6"}