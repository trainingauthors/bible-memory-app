{"content":[{"c":["JUSTUS"],"sourceClass":"h1","t":"p"},{"c":["1. Surname for Joseph Barsabbas (",{"href":"?bref=Acts.1.23","r":"Acts.1.23","rawR":"Acts.1.23","sourceRefs":[{"raw":"Acts.1.23","value":"Acts.1.23"}],"t":"ref","v":"Acts 1:23"},"). ",{"c":["See"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Joseph_Article_TyndaleOpenBibleDictionary","id":"Joseph_Article_TyndaleOpenBibleDictionary","rawId":"Joseph_Article_TyndaleOpenBibleDictionary","t":"link","v":"Joseph #12"},"."],"sourceClass":"list","t":"p"},{"c":["2. Godly Corinthian man (presumably a convert of Paul), who opened his home to Paul and the Christians after the Jewish synagogue was closed to Paul’s preaching (",{"href":"?bref=Acts.18.7","r":"Acts.18.7","rawR":"Acts.18.7","sourceRefs":[{"raw":"Acts.18.7","value":"Acts.18.7"}],"t":"ref","v":"Acts 18:7"},"). There is disagreement among the manuscripts as to the exact form of his name. Various readings are Justus or Titius Justus. He has also been identified as the Gaius of ",{"href":"?bref=Rom.16.23","r":"Rom.16.23","rawR":"Rom.16.23","sourceRefs":[{"raw":"Rom.16.23","value":"Rom.16.23"}],"t":"ref","v":"Romans 16:23"},"."],"sourceClass":"list","t":"p"},{"c":["3. Surname of a believer named Jesus, a Jewish Christian (",{"href":"?bref=Col.4.11","r":"Col.4.11","rawR":"Col.4.11","sourceRefs":[{"raw":"Col.4.11","value":"Col.4.11"}],"t":"ref","v":"Col 4:11"},"). ",{"c":["See"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Jesus_Article_TyndaleOpenBibleDictionary","id":"Jesus_Article_TyndaleOpenBibleDictionary","rawId":"Jesus_Article_TyndaleOpenBibleDictionary","t":"link","v":"Jesus #3"},"."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Justus","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Acts 1:23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.1.23","rawQueryValue":"Acts.1.23","sourceRefExact":"Acts.1.23"},{"anchorText":"Acts 18:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.18.7","rawQueryValue":"Acts.18.7","sourceRefExact":"Acts.18.7"},{"anchorText":"Romans 16:23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rom.16.23","rawQueryValue":"Rom.16.23","sourceRefExact":"Rom.16.23"},{"anchorText":"Col 4:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Col.4.11","rawQueryValue":"Col.4.11","sourceRefExact":"Col.4.11"}],"sourceItemFragmentSha256":"a1b7434ae13a1319d294fda0a6aa2140142c9c6716ebbded94cdd7b3c3d77774","sourceItemName":"Justus","sourceItemOrder":377,"sourceMember":"Articles/J.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Justus","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Justus","title":"Justus","version":"v2-a101d843a2f0cd3fc0c6"}