{"content":[{"c":["SUNDIAL"],"sourceClass":"h1","t":"p"},{"c":["Instrument used for telling time installed by King Ahaz of Judah (735–715 ",{"c":["BC"],"sourceClass":"era","t":"span"},") in the royal palace of Jerusalem. Some suggest that this time indicator was not a sundial but a stairway. The time of day was determined by the position of the shadow of some object cast on the stairs. At Isaiah’s command, the Lord miraculously caused the shadow to recede ten steps, divinely confirming to King Hezekiah of Judah (715–686 ",{"c":["BC"],"sourceClass":"era","t":"span"},") that he would recover from his illness, live 15 more years, and be delivered from the Assyrian threat (",{"href":"?bref=2Kgs.20.7-11","r":"2Kgs.20.7-11","rawR":"2Kgs.20.7-11","sourceRefs":[{"raw":"2Kgs.20.7-11","value":"2Kgs.20.7-11"}],"t":"ref","v":"2 Kgs 20:7-11"},"; ",{"href":"?bref=Isa.38.7-8","r":"Isa.38.7-8","rawR":"Isa.38.7-8","sourceRefs":[{"raw":"Isa.38.7-8","value":"Isa.38.7-8"}],"t":"ref","v":"Is 38:7-8"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Sundial","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Kgs 20:7-11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.20.7-11","rawQueryValue":"2Kgs.20.7-11","sourceRefExact":"2Kgs.20.7-11"},{"anchorText":"Is 38:7-8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.38.7-8","rawQueryValue":"Isa.38.7-8","sourceRefExact":"Isa.38.7-8"}],"sourceItemFragmentSha256":"158b6e477f6feaa223c6988d016f2a52f7a17f6d5af6afcb6505c38a800d786e","sourceItemName":"Sundial","sourceItemOrder":578,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Sundial","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Sundial","title":"Sundial","version":"v2-a101d843a2f0cd3fc0c6"}