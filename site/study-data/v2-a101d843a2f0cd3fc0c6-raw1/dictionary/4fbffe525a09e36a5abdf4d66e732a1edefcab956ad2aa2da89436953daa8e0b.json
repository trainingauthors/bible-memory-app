{"content":[{"c":["JAZER"],"sourceClass":"h1","t":"p"},{"c":["Town east of the Jordan River in southern Gilead, taken with its surrounding villages by the Israelites under Moses (",{"href":"?bref=Num.21.32","r":"Num.21.32","rawR":"Num.21.32","sourceRefs":[{"raw":"Num.21.32","value":"Num.21.32"}],"t":"ref","v":"Nm 21:32"},"). The tribes of Gad and Reuben asked for the lands of Jazer and Gilead. They had large flocks and herds and saw that the east side of the Jordan was fertile and best suited for livestock grazing (",{"href":"?bref=Num.32.1-5","r":"Num.32.1-5","rawR":"Num.32.1-5","sourceRefs":[{"raw":"Num.32.1-5","value":"Num.32.1-5"}],"t":"ref","v":"32:1-5"},"). They promised to build protection for their women and children, then go with the other tribes to fight in Canaan (vv ",{"href":"?bref=Num.32.6-27","r":"Num.32.6-27","rawR":"Num.32.6-27","sourceRefs":[{"raw":"Num.32.6-27","value":"Num.32.6-27"}],"t":"ref","v":"6-27"},"). Jazer became a border point marking the inheritance of Gad (",{"href":"?bref=Josh.13.25","r":"Josh.13.25","rawR":"Josh.13.25","sourceRefs":[{"raw":"Josh.13.25","value":"Josh.13.25"}],"t":"ref","v":"Jos 13:25"},") and was given to the Levites (",{"href":"?bref=Josh.21.39","r":"Josh.21.39","rawR":"Josh.21.39","sourceRefs":[{"raw":"Josh.21.39","value":"Josh.21.39"}],"t":"ref","v":"Jos 21:39"},"; ",{"href":"?bref=1Chr.6.81","r":"1Chr.6.81","rawR":"1Chr.6.81","sourceRefs":[{"raw":"1Chr.6.81","value":"1Chr.6.81"}],"t":"ref","v":"1 Chr 6:81"},"). When Joab was sent to number the people, he reached the city of Jazer in Gad (",{"href":"?bref=2Sam.24.5","r":"2Sam.24.5","rawR":"2Sam.24.5","sourceRefs":[{"raw":"2Sam.24.5","value":"2Sam.24.5"}],"t":"ref","v":"2 Sm 24:5"},"). This town was later recognized during a search for “capable men” under King David (",{"href":"?bref=1Chr.26.31","r":"1Chr.26.31","rawR":"1Chr.26.31","sourceRefs":[{"raw":"1Chr.26.31","value":"1Chr.26.31"}],"t":"ref","v":"1 Chr 26:31"},"). Just over 200 years later, however, it was occupied by Moab (",{"href":"?bref=Isa.16.6-9","r":"Isa.16.6-9","rawR":"Isa.16.6-9","sourceRefs":[{"raw":"Isa.16.6-9","value":"Isa.16.6-9"}],"t":"ref","v":"Is 16:6-9"},"; ",{"href":"?bref=Jer.48.32","r":"Jer.48.32","rawR":"Jer.48.32","sourceRefs":[{"raw":"Jer.48.32","value":"Jer.48.32"}],"t":"ref","v":"Jer 48:32"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Jazer","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Nm 21:32","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.21.32","rawQueryValue":"Num.21.32","sourceRefExact":"Num.21.32"},{"anchorText":"32:1-5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.32.1-5","rawQueryValue":"Num.32.1-5","sourceRefExact":"Num.32.1-5"},{"anchorText":"6-27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.32.6-27","rawQueryValue":"Num.32.6-27","sourceRefExact":"Num.32.6-27"},{"anchorText":"Jos 13:25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.13.25","rawQueryValue":"Josh.13.25","sourceRefExact":"Josh.13.25"},{"anchorText":"Jos 21:39","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.21.39","rawQueryValue":"Josh.21.39","sourceRefExact":"Josh.21.39"},{"anchorText":"1 Chr 6:81","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.6.81","rawQueryValue":"1Chr.6.81","sourceRefExact":"1Chr.6.81"},{"anchorText":"2 Sm 24:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.24.5","rawQueryValue":"2Sam.24.5","sourceRefExact":"2Sam.24.5"},{"anchorText":"1 Chr 26:31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.26.31","rawQueryValue":"1Chr.26.31","sourceRefExact":"1Chr.26.31"},{"anchorText":"Is 16:6-9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.16.6-9","rawQueryValue":"Isa.16.6-9","sourceRefExact":"Isa.16.6-9"},{"anchorText":"Jer 48:32","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.48.32","rawQueryValue":"Jer.48.32","sourceRefExact":"Jer.48.32"}],"sourceItemFragmentSha256":"3a8caa535a582e251ccfbcaacbdaf5487a193e3ef8676fc9edf96d8028b02524","sourceItemName":"Jazer","sourceItemOrder":115,"sourceMember":"Articles/J.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Jazer","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Jazer","title":"Jazer","version":"v2-a101d843a2f0cd3fc0c6"}