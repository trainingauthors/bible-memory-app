{"content":[{"c":["TIRAS"],"sourceClass":"h1","t":"p"},{"c":["Japheth’s seventh son listed in the “table of nations” (",{"href":"?bref=Gen.10.2","r":"Gen.10.2","rawR":"Gen.10.2","sourceRefs":[{"raw":"Gen.10.2","value":"Gen.10.2"}],"t":"ref","v":"Gn 10:2"},"; ",{"href":"?bref=1Chr.1.5","r":"1Chr.1.5","rawR":"1Chr.1.5","sourceRefs":[{"raw":"1Chr.1.5","value":"1Chr.1.5"}],"t":"ref","v":"1 Chr 1:5"},"). His descendants have been alternately linked to the Thracians, the Agathyrsi, the tribes of the Taurus mountain region, and the maritime Tyrrheni, but all of these identifications are purely speculative."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Tiras","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 10:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.10.2","rawQueryValue":"Gen.10.2","sourceRefExact":"Gen.10.2"},{"anchorText":"1 Chr 1:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.1.5","rawQueryValue":"1Chr.1.5","sourceRefExact":"1Chr.1.5"}],"sourceItemFragmentSha256":"b2529b35c1279723ff68a108f053bbe97ec31f82c02bbbf2d9eafb5d36124387","sourceItemName":"Tiras","sourceItemOrder":172,"sourceMember":"Articles/T.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Tiras","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Tiras","title":"Tiras","version":"v2-a101d843a2f0cd3fc0c6"}