{"content":[{"c":["JAIRUS"],"sourceClass":"h1","t":"p"},{"c":["Leader of the synagogue, perhaps at Capernaum. Jairus sought Jesus among the crowds and petitioned him to come and heal his critically ill daughter. While delayed by another healing, Jesus learned that Jairus’s daughter had died. Encouraging Jairus not to fear but to believe, Jesus went on to the leader’s house, dismissed the mourners, and brought the child back to life (",{"href":"?bref=Mark.5.22,35-42","r":"Mark.5.22,35-42","rawR":"Mark.5.22,35-42","sourceRefs":[{"raw":"Mark.5.22,35-42","value":"Mark.5.22,35-42"}],"t":"ref","v":"Mk 5:22, 35-42"},"; ",{"href":"?bref=Luke.8.41,49-55","r":"Luke.8.41,49-55","rawR":"Luke.8.41,49-55","sourceRefs":[{"raw":"Luke.8.41,49-55","value":"Luke.8.41,49-55"}],"t":"ref","v":"Lk 8:41, 49-55"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Jairus","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Mk 5:22, 35-42","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mark.5.22,35-42","rawQueryValue":"Mark.5.22,35-42","sourceRefExact":"Mark.5.22,35-42"},{"anchorText":"Lk 8:41, 49-55","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.8.41,49-55","rawQueryValue":"Luke.8.41,49-55","sourceRefExact":"Luke.8.41,49-55"}],"sourceItemFragmentSha256":"b42bafb3b4d1098415b71c19aaa3aacebf482fe73f83ba5ec100db6dd89d9729","sourceItemName":"Jairus","sourceItemOrder":61,"sourceMember":"Articles/J.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Jairus","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Jairus","title":"Jairus","version":"v2-a101d843a2f0cd3fc0c6"}