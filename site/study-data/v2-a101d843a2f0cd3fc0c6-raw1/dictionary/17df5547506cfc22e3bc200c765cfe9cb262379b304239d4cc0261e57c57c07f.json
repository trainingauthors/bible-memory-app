{"content":[{"c":["BETHUEL, BETHUL (P",{"c":["lace"],"sourceClass":"lc","t":"span"},")"],"sourceClass":"h1","t":"p"},{"c":["One of the cities allotted to Simeon’s tribe within Judah’s inheritance (",{"href":"?bref=1Chr.4.30","r":"1Chr.4.30","rawR":"1Chr.4.30","sourceRefs":[{"raw":"1Chr.4.30","value":"1Chr.4.30"}],"t":"ref","v":"1 Chr 4:30"},"). Bethuel is alternately called Bethul in ",{"href":"?bref=Josh.19.4","r":"Josh.19.4","rawR":"Josh.19.4","sourceRefs":[{"raw":"Josh.19.4","value":"Josh.19.4"}],"t":"ref","v":"Joshua 19:4"},", and is perhaps identifiable with Chesil (Kesil), a city assigned to Judah’s tribe (",{"href":"?bref=Josh.15.30","r":"Josh.15.30","rawR":"Josh.15.30","sourceRefs":[{"raw":"Josh.15.30","value":"Josh.15.30"}],"t":"ref","v":"Jos 15:30"},"), and with Bethel in the Negev to which David sent spoils (",{"href":"?bref=1Sam.30.27","r":"1Sam.30.27","rawR":"1Sam.30.27","sourceRefs":[{"raw":"1Sam.30.27","value":"1Sam.30.27"}],"t":"ref","v":"1 Sm 30:27"},"). ",{"c":["See"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Kesil_Article_TyndaleOpenBibleDictionary","id":"Kesil_Article_TyndaleOpenBibleDictionary","rawId":"Kesil_Article_TyndaleOpenBibleDictionary","t":"link","v":"Kesil"},"."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"BethuelBethulPlace","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 4:30","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.4.30","rawQueryValue":"1Chr.4.30","sourceRefExact":"1Chr.4.30"},{"anchorText":"Joshua 19:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.19.4","rawQueryValue":"Josh.19.4","sourceRefExact":"Josh.19.4"},{"anchorText":"Jos 15:30","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.30","rawQueryValue":"Josh.15.30","sourceRefExact":"Josh.15.30"},{"anchorT