{"content":[{"c":["INTERPRETER"],"sourceClass":"h1","t":"p"},{"c":["One who facilitates communication between people who speak different languages, or one who explains the meaning of dreams. Joseph pretended to need an interpreter to speak to his brothers (",{"href":"?bref=Gen.42.23","r":"Gen.42.23","rawR":"Gen.42.23","sourceRefs":[{"raw":"Gen.42.23","value":"Gen.42.23"}],"t":"ref","v":"Gn 42:23"},"). Also, dreams needed to be interpreted (",{"href":"?bref=Gen.40.8","r":"Gen.40.8","rawR":"Gen.40.8","sourceRefs":[{"raw":"Gen.40.8","value":"Gen.40.8"}],"t":"ref","v":"Gn 40:8"},"; ",{"href":"?bref=Gen.41.15-16","r":"Gen.41.15-16","rawR":"Gen.41.15-16","sourceRefs":[{"raw":"Gen.41.15-16","value":"Gen.41.15-16"}],"t":"ref","v":"41:15-16"},"; ",{"href":"?bref=Dan.2.1-49","r":"Dan.2.1-49","rawR":"Dan.2.1-49","sourceRefs":[{"raw":"Dan.2.1-49","value":"Dan.2.1-49"}],"t":"ref","v":"Dn 2"},"; ",{"href":"?bref=Dan.4.6-9,18-24","r":"Dan.4.6-9,18-24","rawR":"Dan.4.6-9,18-24","sourceRefs":[{"raw":"Dan.4.6-9,18-24","value":"Dan.4.6-9,18-24"}],"t":"ref","v":"4:6-9, 18-24"},"; ",{"href":"?bref=Dan.5.7-8,12-17","r":"Dan.5.7-8,12-17","rawR":"Dan.5.7-8,12-17","sourceRefs":[{"raw":"Dan.5.7-8,12-17","value":"Dan.5.7-8,12-17"}],"t":"ref","v":"5:7-8, 12-17"},"; ",{"href":"?bref=Dan.7.16","r":"Dan.7.16","rawR":"Dan.7.16","sourceRefs":[{"raw":"Dan.7.16","value":"Dan.7.16"}],"t":"ref","v":"7:16"},"). The interpreter was sometimes one who acted as an intermediary (",{"href":"?bref=Job.33.23","r":"Job.33.23","rawR":"Job.33.23","sourceRefs":[{"raw":"Job.33.23","value":"Job.33.23"}],"t":"ref","v":"Jb 33:23"},"). Ezra and Nehemiah functioned as interpreters or translators of the law of Moses when it was read to the Jews who had returned from exile (",{"href":"?bref=Neh.8.8-9","r":"Neh.8.8-9","rawR":"Neh.8.8-9","sourceRefs":[{"raw":"Neh.8.8-9","value":"Neh.8.8-9"}],"t":"ref","v":"Neh 8:8-9"},") and who must not have known Hebrew. In NT times the interpreter explained the utterances of those who spoke in tongues (",{"href":"?bref=1Cor.14.28","r":"1Cor.14.28","rawR":"1Cor.14.28","sourceRefs":[{"raw":"1Cor.14.28","value":"1Cor.14.28"}],"t":"ref","v":"1 Cor 14:28"},"), translated foreign languages (",{"href":"?bref=Acts.2.6","r":"Acts.2.6","rawR":"Acts.2.6","sourceRefs":[{"raw":"Acts.2.6","value":"Acts.2.6"}],"t":"ref","v":"Acts 2:6"},"), or expounded the Scriptures (",{"href":"?bref=Luke.24.27","r":"Luke.24.27","rawR":"Luke.24.27","sourceRefs":[{"raw":"Luke.24.27","value":"Luke.24.27"}],"t":"ref","v":"Lk 24:27"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Interpreter","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 42:23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.42.23","rawQueryValue":"Gen.42.23","sourceRefExact":"Gen.42.23"},{"anchorText":"Gn 40:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.40.8","rawQueryValue":"Gen.40.8","sourceRefExact":"Gen.40.8"},{"anchorText":"41:15-16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.41.15-16","rawQueryValue":"Gen.41.15-16","sourceRefExact":"Gen.41.15-16"},{"anchorText":"Dn 2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Dan.2.1-49","rawQueryValue":"Dan.2.1-49","sourceRefExact":"Dan.2.1-49"},{"anchorText":"4:6-9, 18-24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Dan.4.6-9,18-24","rawQueryValue":"Dan.4.6-9,18-24","sourceRefExact":"Dan.4.6-9,18-24"},{"anchorText":"5:7-8, 12-17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Dan.5.7-8,12-17","rawQueryValue":"Dan.5.7-8,12-17","sourceRefExact":"Dan.5.7-8,12-17"},{"anchorText":"7:16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Dan.7.16","rawQueryValue":"Dan.7.16","sourceRefExact":"Dan.7.16"},{"anchorText":"Jb 33:23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Job.33.23","rawQueryValue":"Job.33.23","sourceRefExact":"Job.33.23"},{"anchorText":"Neh 8:8-9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.8.8-9","rawQueryValue":"Neh.8.8-9","sourceRefExact":"Neh.8.8-9"},{"anchorText":"1 Cor 14:28","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Cor.14.28","rawQueryValue":"1Cor.14.28","sourceRefExact":"1Cor.14.28"},{"anchorText":"Acts 2:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.2.6","rawQueryValue":"Acts.2.6","sourceRefExact":"Acts.2.6"},{"anchorText":"Lk 24:27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.24.27","rawQueryValue":"Luke.24.27","sourceRefExact":"Luke.24.27"}],"sourceItemFragmentSha256":"1c937ac85e9d69f6fe386ebab73152930cd794bf5535e4f3a354177d0a0705b9","sourceItemName":"Interpreter","sourceItemOrder":68,"sourceMember":"Articles/I.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Interpreter","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Interpreter","title":"Interpreter","version":"v2-a101d843a2f0cd3fc0c6"}