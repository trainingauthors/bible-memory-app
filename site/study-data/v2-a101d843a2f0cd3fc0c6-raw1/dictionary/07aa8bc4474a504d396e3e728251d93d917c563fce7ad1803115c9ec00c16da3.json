{"content":[{"c":["ZOBAH"],"sourceClass":"h1","t":"p"},{"c":["Aramean nation suffering military defeat from Israel during the early kingdom period. King Saul defeated the kings of Zobah (",{"href":"?bref=1Sam.14.47","r":"1Sam.14.47","rawR":"1Sam.14.47","sourceRefs":[{"raw":"1Sam.14.47","value":"1Sam.14.47"}],"t":"ref","v":"1 Sm 14:47"},"). Soon after David became king of Israel, he defeated Hadadezer the son of Rehob, king of Zobah (",{"href":"?bref=2Sam.8.3-5,12","r":"2Sam.8.3-5,12","rawR":"2Sam.8.3-5,12","sourceRefs":[{"raw":"2Sam.8.3-5,12","value":"2Sam.8.3-5,12"}],"t":"ref","v":"2 Sm 8:3-5, 12"},"; ",{"href":"?bref=1Chr.18.3-10","r":"1Chr.18.3-10","rawR":"1Chr.18.3-10","sourceRefs":[{"raw":"1Chr.18.3-10","value":"1Chr.18.3-10"}],"t":"ref","v":"1 Chr 18:3-10"},"; ",{"href":"?bref=Ps.60.1","r":"Ps.60.1","rawR":"Ps.60.1","sourceRefs":[{"raw":"Ps.60.1","value":"Ps.60.1"}],"t":"ref","v":"Ps 60 title"},"). Later, the Ammonites hired 20,000 “Syrians of Zobah” for an anticipated attack by David’s forces. The coalition of Ammonites and hired mercenaries was defeated by soldiers led by Joab (",{"href":"?bref=2Sam.10.6-14","r":"2Sam.10.6-14","rawR":"2Sam.10.6-14","sourceRefs":[{"raw":"2Sam.10.6-14","value":"2Sam.10.6-14"}],"t":"ref","v":"2 Sm 10:6-14"},"). When Hadadezer’s army counterattacked, they were again defeated decisively by David (",{"href":"?bref=2Sam.10.15-19","r":"2Sam.10.15-19","rawR":"2Sam.10.15-19","sourceRefs":[{"raw":"2Sam.10.15-19","value":"2Sam.10.15-19"}],"t":"ref","v":"2 Sm 10:15-19"},"; ",{"href":"?bref=1Chr.19.16-19","r":"1Chr.19.16-19","rawR":"1Chr.19.16-19","sourceRefs":[{"raw":"1Chr.19.16-19","value":"1Chr.19.16-19"}],"t":"ref","v":"1 Chr 19:16-19"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Zobah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Sm 14:47","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.14.47","rawQueryValue":"1Sam.14.47","sourceRefExact":"1Sam.14.47"},{"anchorText":"2 Sm 8:3-5, 12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.8.3-5,12","rawQueryValue":"2Sam.8.3-5,12","sourceRefExact":"2Sam.8.3-5,12"},{"anchorText":"1 Chr 18:3-10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.18.3-10","rawQueryValue":"1Chr.18.3-10","sourceRefExact":"1Chr.18.3-10"},{"anchorText":"Ps 60 title","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ps.60.1","rawQueryValue":"Ps.60.1","sourceRefExact":"Ps.60.1"},{"anchorText":"2 Sm 10:6-14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.10.6-14","rawQueryValue":"2Sam.10.6-14","sourceRefExact":"2Sam.10.6-14"},{"anchorText":"2 Sm 10:15-19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.10.15-19","rawQueryValue":"2Sam.10.15-19","sourceRefExact":"2Sam.10.15-19"},{"anchorText":"1 Chr 19:16-19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.19.16-19","rawQueryValue":"1Chr.19.16-19","sourceRefExact":"1Chr.19.16-19"}],"sourceItemFragmentSha256":"7a2ba3bfc8c41757eca4a6197ec63ff976058581cff89286f0013ed891bdddb5","sourceItemName":"Zobah","sourceItemOrder":144,"sourceMember":"Articles/Z.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Zobah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Zobah","title":"Zobah","version":"v2-a101d843a2f0cd3fc0c6"}