{"content":[{"c":["SHEPHUPHAN"],"sourceClass":"h1","t":"p"},{"c":["Bela’s son from Benjamin’s tribe. Bela was the firstborn of Benjamin’s sons (",{"href":"?bref=1Chr.8.5","r":"1Chr.8.5","rawR":"1Chr.8.5","sourceRefs":[{"raw":"1Chr.8.5","value":"1Chr.8.5"}],"t":"ref","v":"1 Chr 8:5"},"). The exact position of Shephuphan in Benjamin’s genealogy is unclear, and he is perhaps identifiable with Shephupham (",{"href":"?bref=1Chr.7.12","r":"1Chr.7.12","rawR":"1Chr.7.12","sourceRefs":[{"raw":"1Chr.7.12","value":"1Chr.7.12"}],"t":"ref","v":"1 Chr 7:12"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Shephuphan","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 8:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.8.5","rawQueryValue":"1Chr.8.5","sourceRefExact":"1Chr.8.5"},{"anchorText":"1 Chr 7:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.7.12","rawQueryValue":"1Chr.7.12","sourceRefExact":"1Chr.7.12"}],"sourceItemFragmentSha256":"12e99039601fc49fd176ef6a7b49398a0d70e85d10a4172db461d83d53932325","sourceItemName":"Shephuphan","sourceItemOrder":295,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Shephuphan","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Shephuphan","title":"Shephuphan","version":"v2-a101d843a2f0cd3fc0c6"}