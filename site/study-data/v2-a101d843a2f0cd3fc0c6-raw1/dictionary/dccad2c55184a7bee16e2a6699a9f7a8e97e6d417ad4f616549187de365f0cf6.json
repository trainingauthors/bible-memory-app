{"content":[{"c":["ASHAN"],"sourceClass":"h1","t":"p"},{"c":["Town in the southwestern Judean foothills slightly northwest of Beersheba. Ashan first belonged to Judah’s tribe (",{"href":"?bref=Josh.15.42","r":"Josh.15.42","rawR":"Josh.15.42","sourceRefs":[{"raw":"Josh.15.42","value":"Josh.15.42"}],"t":"ref","v":"Jos 15:42"},"), then to Simeon’s (",{"href":"?bref=Josh.19.7","r":"Josh.19.7","rawR":"Josh.19.7","sourceRefs":[{"raw":"Josh.19.7","value":"Josh.19.7"}],"t":"ref","v":"Jos 19:7"},"), and finally to the Levites as a city of refuge (",{"href":"?bref=1Chr.6.59","r":"1Chr.6.59","rawR":"1Chr.6.59","sourceRefs":[{"raw":"1Chr.6.59","value":"1Chr.6.59"}],"t":"ref","v":"1 Chr 6:59"},"). David roamed there with his outlaw band (",{"href":"?bref=1Sam.30.30","r":"1Sam.30.30","rawR":"1Sam.30.30","sourceRefs":[{"raw":"1Sam.30.30","value":"1Sam.30.30"}],"t":"ref","v":"1 Sm 30:30"},"). The city of Ain mentioned in ",{"href":"?bref=Josh.21.16","r":"Josh.21.16","rawR":"Josh.21.16","sourceRefs":[{"raw":"Josh.21.16","value":"Josh.21.16"}],"t":"ref","v":"Joshua 21:16"}," probably refers to Ashan (this should not be confused with Ain in the northeast of Canaan, ",{"href":"?bref=Num.34.11","r":"Num.34.11","rawR":"Num.34.11","sourceRefs":[{"raw":"Num.34.11","value":"Num.34.11"}],"t":"ref","v":"Nm 34:11"},"). ",{"c":["See"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=CitiesofRefuge_Article_TyndaleOpenBibleDictionary","id":"CitiesofRefuge_Article_TyndaleOpenBibleDictionary","rawId":"CitiesofRefuge_Article_TyndaleOpenBibleDictionary","t":"link","v":"Cities of Refuge"},"."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Ashan","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 15:42","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.42","rawQueryValue":"Josh.15.42","sourceRefExact":"Josh.15.42"},{"anchorText":"Jos 19:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.19.7","rawQueryValue":"Josh.19.7","sourceRefExact":"Josh.19.7"},{"anchorText":"1 Chr 6:59","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.6.59","rawQueryValue":"1Chr.6.59","sourceRefExact":"1Chr.6.59"},{"anchorText":"1 Sm 30:30","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.30.30","rawQueryValue":"1Sam.30.30","sourceRefExact":"1Sam.30.30"},{"anchorText":"Joshua 21:16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.21.16","rawQueryValue":"Josh.21.16","sourceRefExact":"Josh.21.16"},{"anchorText":"Nm 34:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.34.11","rawQueryValue":"Num.34.11","sourceRefExact":"Num.34.11"}],"sourceItemFragmentSha256":"c4ab26625ed045aa272d44e0d2cfdba2b1825f00ec38dccadcd67404a66da520","sourceItemName":"Ashan","sourceItemOrder":531,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Ashan","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Ashan","title":"Ashan","version":"v2-a101d843a2f0cd3fc0c6"}