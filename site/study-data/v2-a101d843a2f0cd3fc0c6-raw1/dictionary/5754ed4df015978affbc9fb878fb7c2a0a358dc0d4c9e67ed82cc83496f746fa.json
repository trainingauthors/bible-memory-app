{"content":[{"c":["ONYCHA*"],"sourceClass":"h1","t":"p"},{"c":["One of the sweet spices used in the sacred incense of the tabernacle (",{"href":"?bref=Exod.30.34","r":"Exod.30.34","rawR":"Exod.30.34","sourceRefs":[{"raw":"Exod.30.34","value":"Exod.30.34"}],"t":"ref","v":"Ex 30:34"},"). Its identification is uncertain. Some suggest that onycha was derived from the shell of a certain mussel found in India that exuded a musklike fragrance when burned."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Onycha","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ex 30:34","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.30.34","rawQueryValue":"Exod.30.34","sourceRefExact":"Exod.30.34"}],"sourceItemFragmentSha256":"6704da08116c844dfe9a48144795a183365f45a47343d820c21a5bdb94966f3a","sourceItemName":"Onycha","sourceItemOrder":63,"sourceMember":"Articles/O.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Onycha","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Onycha*","title":"Onycha*","version":"v2-a101d843a2f0cd3fc0c6"}