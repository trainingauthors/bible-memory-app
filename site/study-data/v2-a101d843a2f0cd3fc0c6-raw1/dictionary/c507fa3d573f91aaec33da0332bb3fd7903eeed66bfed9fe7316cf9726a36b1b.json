{"content":[{"c":["ADORAIM"],"sourceClass":"h1","t":"p"},{"c":["City in the southern kingdom of Judah fortified by King Rehoboam (",{"href":"?bref=2Chr.11.9","r":"2Chr.11.9","rawR":"2Chr.11.9","sourceRefs":[{"raw":"2Chr.11.9","value":"2Chr.11.9"}],"t":"ref","v":"2 Chr 11:9"},"). Adoraim and Mareshah later became the two principal cities of Idumea. In ",{"href":"?bref=1Macc.13.20","r":"1Macc.13.20","rawR":"1Macc.13.20","sourceRefs":[{"raw":"1Macc.13.20","value":"1Macc.13.20"}],"t":"ref","v":"1 Maccabees 13:20"}," it is called Adora. The modern identification is Dura, south of Hebron."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Adoraim","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Chr 11:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.11.9","rawQueryValue":"2Chr.11.9","sourceRefExact":"2Chr.11.9"},{"anchorText":"1 Maccabees 13:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Macc.13.20","rawQueryValue":"1Macc.13.20","sourceRefExact":"1Macc.13.20"}],"sourceItemFragmentSha256":"9f2254fdfa28e4b1eba517b22db6faf0d294a8a7bf903f82cd688d1c585f1b88","sourceItemName":"Adoraim","sourceItemOrder":136,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Adoraim","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Adoraim","title":"Adoraim","version":"v2-a101d843a2f0cd3fc0c6"}