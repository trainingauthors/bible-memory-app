{"content":[{"c":["CENDEBEUS"],"sourceClass":"h1","t":"p"},{"c":["Commander-in-chief of the seacoast of Syria-Palestine about 138 ",{"c":["BC"],"sourceClass":"era","t":"span"}," under Antiochus VII (",{"href":"?bref=1Macc.15.38","r":"1Macc.15.38","rawR":"1Macc.15.38","sourceRefs":[{"raw":"1Macc.15.38","value":"1Macc.15.38"}],"t":"ref","v":"1 Macc 15:38"},"). Cendebeus was ordered to build a fortress at Kedron (probably the Gederah of ",{"href":"?bref=Josh.15.36","r":"Josh.15.36","rawR":"Josh.15.36","sourceRefs":[{"raw":"Josh.15.36","value":"Josh.15.36"}],"t":"ref","v":"Jos 15:36"},"), after which he transferred his headquarters to Jamnia and from there made raids into Judea (",{"href":"?bref=1Macc.15.39-40","r":"1Macc.15.39-40","rawR":"1Macc.15.39-40","sourceRefs":[{"raw":"1Macc.15.39-40","value":"1Macc.15.39-40"}],"t":"ref","v":"1 Macc 15:39-40"},"). Simon Maccabeus, unable to fight back because of his old age, dispatched his sons Judas and John Hyrcanus against Cendebeus with 20,000 soldiers and horsemen. Judas was wounded, but the Jews prevailed after slaying about 2,000 men. Cendebeus was pursued back to Kedron, and the Jews returned to Judea (",{"href":"?bref=1Macc.16.1-10","r":"1Macc.16.1-10","rawR":"1Macc.16.1-10","sourceRefs":[{"raw":"1Macc.16.1-10","value":"1Macc.16.1-10"}],"t":"ref","v":"16:1-10"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Cendebeus","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Macc 15:38","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Macc.15.38","rawQueryValue":"1Macc.15.38","sourceRefExact":"1Macc.15.38"},{"anchorText":"Jos 15:36","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.36","rawQueryValue":"Josh.15.36","sourceRefExact":"Josh.15.36"},{"anchorText":"1 Macc 15:39-40","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Macc.15.39-40","rawQueryValue":"1Macc.15.39-40","sourceRefExact":"1Macc.15.39-40"},{"anchorText":"16:1-10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Macc.16.1-10","rawQueryValue":"1Macc.16.1-10","sourceRefExact":"1Macc.16.1-10"}],"sourceItemFragmentSha256":"65ec6f060bf4992bf596fb2166ae240301a3e53946f0bd167211a25c42fca00e","sourceItemName":"Cendebeus","sourceItemOrder":82,"sourceMember":"Articles/C.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Cendebeus","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Cendebeus","title":"Cendebeus","version":"v2-a101d843a2f0cd3fc0c6"}