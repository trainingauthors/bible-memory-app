ation":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Heb.6.15","rawQueryValue":"Heb.6.15","sourceRefExact":"Heb.6.15"},{"anchorText":"11:39","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Heb.11.39","rawQueryValue":"Heb.11.39","sourceRefExact":"Heb.11.39"},{"anchorText":"Jas 5:7a","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jas.5.7","rawQueryValue":"Jas.5.7","sourceRefExact":"Jas.5.7"}],"sourceItemFragmentSha256":"68da06dea98497e5f8832140dcdfa4f17a1d2db8bd0224896cada4dac6aa14d0","sourceItemName":"Patience","sourceItemOrder":64,"sourceMember":"Articles/P.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Patience","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Patience","title":"Patience","version":"v2-a101d843a2f0cd3fc0c6"}