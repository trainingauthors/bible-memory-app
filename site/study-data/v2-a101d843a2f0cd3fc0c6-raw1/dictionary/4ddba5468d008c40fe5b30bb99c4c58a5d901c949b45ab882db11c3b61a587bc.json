{"content":[{"c":["ARELI, ARELITE"],"sourceClass":"h1","t":"p"},{"c":["One of Gad’s seven sons (",{"href":"?bref=Gen.46.16","r":"Gen.46.16","rawR":"Gen.46.16","sourceRefs":[{"raw":"Gen.46.16","value":"Gen.46.16"}],"t":"ref","v":"Gn 46:16"},"). After the plague of Baal-peor, Areli’s descendants, the Arelites, were numbered in Moses’ census in preparation for war with the Midianites (",{"href":"?bref=Num.25.6-18","r":"Num.25.6-18","rawR":"Num.25.6-18","sourceRefs":[{"raw":"Num.25.6-18","value":"Num.25.6-18"}],"t":"ref","v":"Nm 25:6-18"},"; ",{"href":"?bref=Num.26.17","r":"Num.26.17","rawR":"Num.26.17","sourceRefs":[{"raw":"Num.26.17","value":"Num.26.17"}],"t":"ref","v":"26:17"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"AreliArelite","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 46:16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.46.16","rawQueryValue":"Gen.46.16","sourceRefExact":"Gen.46.16"},{"anchorText":"Nm 25:6-18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.25.6-18","rawQueryValue":"Num.25.6-18","sourceRefExact":"Num.25.6-18"},{"anchorText":"26:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.26.17","rawQueryValue":"Num.26.17","sourceRefExact":"Num.26.17"}],"sourceItemFragmentSha256":"ae322c32d84269b36a47ec3eb9aa846ac52412d6d0396c963b54358c648a7f6a","sourceItemName":"AreliArelite","sourceItemOrder":467,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"AreliArelite","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Areli, Arelite","title":"Areli, Arelite","version":"v2-a101d843a2f0cd3fc0c6"}