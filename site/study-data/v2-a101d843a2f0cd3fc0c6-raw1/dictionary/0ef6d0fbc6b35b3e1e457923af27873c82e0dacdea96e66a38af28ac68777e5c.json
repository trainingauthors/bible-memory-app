{"content":[{"c":["MANAHATH (Place), MANAHATHITE"],"sourceClass":"h1","t":"p"},{"c":["Evidently a place in the Judean hills near the Benjamite border (",{"href":"?bref=1Chr.8.6","r":"1Chr.8.6","rawR":"1Chr.8.6","sourceRefs":[{"raw":"1Chr.8.6","value":"1Chr.8.6"}],"t":"ref","v":"1 Chr 8:6"},"). The Manahathites (",{"href":"?bref=1Chr.2.54","r":"1Chr.2.54","rawR":"1Chr.2.54","sourceRefs":[{"raw":"1Chr.2.54","value":"1Chr.2.54"}],"t":"ref","v":"1 Chr 2:54"},"), the people of Manahath, had connections with the Judean and Calebite clans in northern Judea. Its site is apparently that of Malha, three miles (4.8 kilometers) southwest of Jerusalem on the northern slope of the valley of Rephaim."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"ManahathPlaceManahathite","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 8:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.8.6","rawQueryValue":"1Chr.8.6","sourceRefExact":"1Chr.8.6"},{"anchorText":"1 Chr 2:54","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.2.54","rawQueryValue":"1Chr.2.54","sourceRefExact":"1Chr.2.54"}],"sourceItemFragmentSha256":"732ce62d698db91a5e8859a7591e0dafb06781a9058078cca4079056f7069e47","sourceItemName":"ManahathPlaceManahathite","sourceItemOrder":112,"sourceMember":"Articles/M.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"ManahathPlaceManahathite","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Manahath (Place), Manahathite","title":"Manahath (Place), Manahathite","version":"v2-a101d843a2f0cd3fc0c6"}