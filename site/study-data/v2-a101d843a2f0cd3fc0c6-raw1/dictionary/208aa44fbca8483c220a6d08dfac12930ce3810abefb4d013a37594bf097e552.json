{"content":[{"c":["LOGOS*"],"sourceClass":"h1","t":"p"},{"c":["English transliteration of a Greek term for “word.” The term is significant because in John’s writings it refers to Jesus. The prologue of John’s Gospel (",{"href":"?bref=John.1.1,14","r":"John.1.1,14","rawR":"John.1.1,14","sourceRefs":[{"raw":"John.1.1,14","value":"John.1.1,14"}],"t":"ref","v":"Jn 1:1, 14"},") and the beginning of 1 John (",{"href":"?bref=1Jn.1.1","r":"1Jn.1.1","rawR":"1Jn.1.1","sourceRefs":[{"raw":"1Jn.1.1","value":"1Jn.1.1"}],"t":"ref","v":"1 Jn 1:1"},") use ",{"c":["logos"],"sourceClass":"greek","t":"span"}," to show how Jesus can be God and yet be an expression of God in the world. The divine Word took on human form and became a historical personage. Logos is also the title of Christ in the vision of his divine glory (",{"href":"?bref=Rev.19.13","r":"Rev.19.13","rawR":"Rev.19.13","sourceRefs":[{"raw":"Rev.19.13","value":"Rev.19.13"}],"t":"ref","v":"Rv 19:13"},"). Writers outside the NT, such as Philo of Alexandria, used the term but with a different meaning."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=JohnGospelof_Article_TyndaleOpenBibleDictionary","id":"JohnGospelof_Article_TyndaleOpenBibleDictionary","rawId":"JohnGospelof_Article_TyndaleOpenBibleDictionary","t":"link","v":"John, Gospel of"},"; ",{"href":"?item=WordWordofGodWordsofGod_Article_TyndaleOpenBibleDictionary","id":"WordWordofGodWordsofGod_Article_TyndaleOpenBibleDictionary","rawId":"WordWordofGodWordsofGod_Article_TyndaleOpenBibleDictionary","t":"link","v":"Word, Word of God"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Logos","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jn 1:1, 14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=John.1.1,14","rawQueryValue":"John.1.1,14","sourceRefExact":"John.1.1,14"},{"anchorText":"1 Jn 1:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Jn.1.1","rawQueryValue":"1Jn.1.1","sourceRefExact":"1Jn.1.1"},{"anchorText":"Rv 19:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.19.13","rawQueryValue":"Rev.19.13","sourceRefExact":"Rev.19.13"}],"sourceItemFragmentSha256":"eca44266bffe8baf42c2b9a401b592b9a5c200732d0a7927f21f7c346cf2aec5","sourceItemName":"Logos","sourceItemOrder":119,"sourceMember":"Articles/L.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Logos","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Logos*","title":"Logos*","version":"v2-a101d843a2f0cd3fc0c6"}