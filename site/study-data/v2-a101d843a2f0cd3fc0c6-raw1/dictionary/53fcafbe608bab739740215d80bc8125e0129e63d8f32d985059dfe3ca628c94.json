n":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.19.1","rawQueryValue":"Isa.19.1","sourceRefExact":"Isa.19.1"},{"anchorText":"2 Sm 22:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.22.11","rawQueryValue":"2Sam.22.11","sourceRefExact":"2Sam.22.11"},{"anchorText":"Ps 18:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ps.18.10","rawQueryValue":"Ps.18.10","sourceRefExact":"Ps.18.10"},{"anchorText":"Ex 25:18-20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.25.18-20","rawQueryValue":"Exod.25.18-20","sourceRefExact":"Exod.25.18-20"},{"anchorText":"37:7-9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.37.7-9","rawQueryValue":"Exod.37.7-9","sourceRefExact":"Exod.37.7-9"},{"anchorText":"1 Kgs 7:29, 36","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.7.29,36","rawQueryValue":"1Kgs.7.29,36","sourceRefExact":"1Kgs.7.29,36"},{"anchorText":"Ez 41:17-20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.41.17-20","rawQueryValue":"Ezek.41.17-20","sourceRefExact":"Ezek.41.17-20"}],"sourceItemFragmentSha256":"73616df1c571b70a61f9c2c50d92d322b4ed20ef64dc06558439a4af18806ff2","sourceItemName":"CherubCherubim","sourceItemOrder":138,"sourceMember":"Articles/C.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"CherubCherubim","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Cherub*, Cherubim","title":"Cherub*, Cherubim","version":"v2-a101d843a2f0cd3fc0c6"}