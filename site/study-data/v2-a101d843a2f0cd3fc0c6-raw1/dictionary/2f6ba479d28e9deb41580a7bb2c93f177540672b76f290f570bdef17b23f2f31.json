ping_workstream","hrefExact":"?bref=Heb.11.31","rawQueryValue":"Heb.11.31","sourceRefExact":"Heb.11.31"},{"anchorText":"Jer 2:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.2.20","rawQueryValue":"Jer.2.20","sourceRefExact":"Jer.2.20"},{"anchorText":"Rv 17:1, 5, 15-16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.17.1,5,15-16","rawQueryValue":"Rev.17.1,5,15-16","sourceRefExact":"Rev.17.1,5,15-16"},{"anchorText":"19:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.19.2","rawQueryValue":"Rev.19.2","sourceRefExact":"Rev.19.2"},{"anchorText":"Jer 3:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.3.20","rawQueryValue":"Jer.3.20","sourceRefExact":"Jer.3.20"},{"anchorText":"Jgs 8:33","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.8.33","rawQueryValue":"Judg.8.33","sourceRefExact":"Judg.8.33"},{"anchorText":"Rv 17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.17.1-18","rawQueryValue":"Rev.17.1-18","sourceRefExact":"Rev.17.1-18"}],"sourceItemFragmentSha256":"6ad60d2df924bc28ce37456549819692f3398aafa87250da2d9162c88b414afb","sourceItemName":"ProstituteProstitution","sourceItemOrder":292,"sourceMember":"Articles/P.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"ProstituteProstitution","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Prostitute, Prostitution","title":"Prostitute, Prostitution","version":"v2-a101d843a2f0cd3fc0c6"}