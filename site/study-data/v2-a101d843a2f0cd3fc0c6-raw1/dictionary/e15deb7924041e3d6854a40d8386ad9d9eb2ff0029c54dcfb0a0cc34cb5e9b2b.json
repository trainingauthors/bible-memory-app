{"content":[{"c":["KEBAR"],"sourceClass":"h1","t":"p"},{"c":["Canal in Babylonia. The prophet Ezekiel, who was among the exiles from the southern kingdom of Judah, received visions from God while living in the area of the Kebar Canal (",{"href":"?bref=Ezek.1.1,3","r":"Ezek.1.1,3","rawR":"Ezek.1.1,3","sourceRefs":[{"raw":"Ezek.1.1,3","value":"Ezek.1.1,3"}],"t":"ref","v":"Ez 1:1, 3"},"; ",{"href":"?bref=Ezek.3.15,23","r":"Ezek.3.15,23","rawR":"Ezek.3.15,23","sourceRefs":[{"raw":"Ezek.3.15,23","value":"Ezek.3.15,23"}],"t":"ref","v":"3:15, 23"},"; ",{"href":"?bref=Ezek.10.15,20,22","r":"Ezek.10.15,20,22","rawR":"Ezek.10.15,20,22","sourceRefs":[{"raw":"Ezek.10.15,20,22","value":"Ezek.10.15,20,22"}],"t":"ref","v":"10:15, 20, 22"},"; ",{"href":"?bref=Ezek.43.3","r":"Ezek.43.3","rawR":"Ezek.43.3","sourceRefs":[{"raw":"Ezek.43.3","value":"Ezek.43.3"}],"t":"ref","v":"43:3"},"). Secular Babylonian texts refer to a ",{"c":["nar Kabaru"],"sourceClass":"ital","t":"span"}," that is believed to be the same canal."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Kebar","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ez 1:1, 3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.1.1,3","rawQueryValue":"Ezek.1.1,3","sourceRefExact":"Ezek.1.1,3"},{"anchorText":"3:15, 23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.3.15,23","rawQueryValue":"Ezek.3.15,23","sourceRefExact":"Ezek.3.15,23"},{"anchorText":"10:15, 20, 22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.10.15,20,22","rawQueryValue":"Ezek.10.15,20,22","sourceRefExact":"Ezek.10.15,20,22"},{"anchorText":"43:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.43.3","rawQueryValue":"Ezek.43.3","sourceRefExact":"Ezek.43.3"}],"sourceItemFragmentSha256":