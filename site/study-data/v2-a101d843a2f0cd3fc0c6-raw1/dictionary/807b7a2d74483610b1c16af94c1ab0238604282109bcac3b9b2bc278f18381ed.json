{"content":[{"c":["MELZAR*"],"sourceClass":"h1","t":"p"},{"c":["Steward responsible for the food given to Daniel (",{"href":"?bref=Dan.1.11,16","r":"Dan.1.11,16","rawR":"Dan.1.11,16","sourceRefs":[{"raw":"Dan.1.11,16","value":"Dan.1.11,16"}],"t":"ref","v":"Dn 1:11, 16"},"). The ",{"c":["kjv"],"sourceClass":"sc","t":"span"}," translates the word as a proper name, but the ",{"c":["rsv"],"sourceClass":"sc","t":"span"}," translates the word as a title. Most likely Melzar is a Hebraization of a Babylonian title."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Melzar","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Dn 1:11, 16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Dan.1.11,16","rawQueryValue":"Dan.1.11,16","sourceRefExact":"Dan.1.11,16"}],"sourceItemFragmentSha256":"ed1fab6b68127322bcafd8d319f87c81af2f42285b902a2dd1200f7bbb68d2a5","sourceItemName":"Melzar","sourceItemOrder":233,"sourceMember":"Articles/M.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Melzar","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Melzar*","title":"Melzar*","version":"v2-a101d843a2f0cd3fc0c6"}