{"content":[{"c":["GAASH"],"sourceClass":"h1","t":"p"},{"c":["1. Mountain about 20 miles (32.2 kilometers) southwest of Shechem. Joshua was buried at Timnath-serah (Timnath-heres) in the hill country of Ephraim, near Mt Gaash (",{"href":"?bref=Josh.24.30","r":"Josh.24.30","rawR":"Josh.24.30","sourceRefs":[{"raw":"Josh.24.30","value":"Josh.24.30"}],"t":"ref","v":"Jos 24:30"},"; ",{"href":"?bref=Judg.2.9","r":"Judg.2.9","rawR":"Judg.2.9","sourceRefs":[{"raw":"Judg.2.9","value":"Judg.2.9"}],"t":"ref","v":"Jgs 2:9"},")."],"sourceClass":"list","t":"p"},{"c":["2. Stream in the vicinity of the mountain, mentioned as the home of Hiddai (alternately Hurai), one of King David’s mighty soldiers (",{"href":"?bref=2Sam.23.30","r":"2Sam.23.30","rawR":"2Sam.23.30","sourceRefs":[{"raw":"2Sam.23.30","value":"2Sam.23.30"}],"t":"ref","v":"2 Sm 23:30"},"; ",{"href":"?bref=1Chr.11.32","r":"1Chr.11.32","rawR":"1Chr.11.32","sourceRefs":[{"raw":"1Chr.11.32","value":"1Chr.11.32"}],"t":"ref","v":"1 Chr 11:32"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Gaash","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 24:30","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.24.30","rawQueryValue":"Josh.24.30","sourceRefExact":"Josh.24.30"},{"anchorText":"Jgs 2:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.2.9","rawQueryValue":"Judg.2.9","sourceRefExact":"Judg.2.9"},{"anchorText":"2 Sm 23:30","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.23.30","rawQueryValue":"2Sam.23.30","sourceRefExact":"2Sam.23.30"},{"anchorText":"1 Chr 11:32","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.11.32","rawQueryValue":"1Chr.11.32","sourceRefExact":"1Chr.11.32"}],"sourceItemFragmentSha256":"7700e3cca38d188de479ff01ed59be