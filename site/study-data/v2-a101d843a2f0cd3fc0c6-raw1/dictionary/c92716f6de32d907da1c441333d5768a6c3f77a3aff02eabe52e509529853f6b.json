{"content":[{"c":["NAPHTALI (P",{"c":["erson"],"sourceClass":"lc","t":"span"},")"],"sourceClass":"h1","t":"p"},{"c":["One of Jacob’s 12 sons (",{"href":"?bref=Gen.35.25","r":"Gen.35.25","rawR":"Gen.35.25","sourceRefs":[{"raw":"Gen.35.25","value":"Gen.35.25"}],"t":"ref","v":"Gn 35:25"},"; ",{"href":"?bref=1Chr.2.2","r":"1Chr.2.2","rawR":"1Chr.2.2","sourceRefs":[{"raw":"1Chr.2.2","value":"1Chr.2.2"}],"t":"ref","v":"1 Chr 2:2"},"). He was the second of two sons borne to Jacob by Bilhah, Rachel’s maid. Overjoyed with giving Jacob another son, Rachel named the boy Naphtali, meaning “my wrestling,” for her conflict with Leah—“with mighty wrestlings I have wrestled with my sister, and have prevailed” (",{"href":"?bref=Gen.30.8","r":"Gen.30.8","rawR":"Gen.30.8","sourceRefs":[{"raw":"Gen.30.8","value":"Gen.30.8"}],"t":"ref","v":"Gn 30:8"},", ",{"c":["rsv"],"sourceClass":"sc","t":"span"},"). Naphtali eventually moved his family with Jacob to Egypt (",{"href":"?bref=Gen.46.24","r":"Gen.46.24","rawR":"Gen.46.24","sourceRefs":[{"raw":"Gen.46.24","value":"Gen.46.24"}],"t":"ref","v":"Gn 46:24"},"; ",{"href":"?bref=Exod.1.4","r":"Exod.1.4","rawR":"Exod.1.4","sourceRefs":[{"raw":"Exod.1.4","value":"Exod.1.4"}],"t":"ref","v":"Ex 1:4"},"). He fathered four sons (",{"href":"?bref=Num.26.50","r":"Num.26.50","rawR":"Num.26.50","sourceRefs":[{"raw":"Num.26.50","value":"Num.26.50"}],"t":"ref","v":"Nm 26:50"},"; ",{"href":"?bref=1Chr.7.13","r":"1Chr.7.13","rawR":"1Chr.7.13","sourceRefs":[{"raw":"1Chr.7.13","value":"1Chr.7.13"}],"t":"ref","v":"1 Chr 7:13"},") and founded one of the 12 tribes of Israel (",{"href":"?bref=Num.1.43","r":"Num.1.43","rawR":"Num.1.43","sourceRefs":[{"raw":"Num.1.43","value":"Num.1.43"}],"t":"ref","v":"Nm 1:43"},")."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=NaphtaliTribeof_Article_TyndaleOpenBibleDictionary","id":"NaphtaliTribeof_Article_TyndaleOpenBibleDictionary","rawId":"NaphtaliTribeof_Article_TyndaleOpenBibleDictionary","t":"link","v":"Naphtali, Tribe of"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"NaphtaliPerson","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 35:25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.35.25","rawQueryValue":"Gen.35.25","sourceRefExact":"Gen.35.25"},{"anchorText":"1 Chr 2:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.2.2","rawQueryValue":"1Chr.2.2","sourceRefExact":"1Chr.2.2"},{"anchorText":"Gn 30:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.30.8","rawQueryValue":"Gen.30.8","sourceRefExact":"Gen.30.8"},{"anchorText":"Gn 46:24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.46.24","rawQueryValue":"Gen.46.24","sourceRefExact":"Gen.46.24"},{"anchorText":"Ex 1:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.1.4","rawQueryValue":"Exod.1.4","sourceRefExact":"Exod.1.4"},{"anchorText":"Nm 26:50","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.26.50","rawQueryValue":"Num.26.50","sourceRefExact":"Num.26.50"},{"anchorText":"1 Chr 7:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.7.13","rawQueryValue":"1Chr.7.13","sourceRefExact":"1Chr.7.13"},{"anchorText":"Nm 1:43","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.1.43","rawQueryValue":"Num.1.43","sourceRefExact":"Num.1.43"}],"sourceItemFragmentSha256":"fbcecc165aa85d7735869710c65d30ea516ebe4a517f70772beb67dedd4c66c4","sourceItemName":"NaphtaliPerson","sourceItemOrder":47,"sourceMember":"Articles/N.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"NaphtaliPerson","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Naphtali (Person)","title":"Naphtali (Person)","version":"v2-a101d843a2f0cd3fc0c6"}