Zeph.3.10"},{"anchorText":"Job 28:19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Job.28.19","rawQueryValue":"Job.28.19","sourceRefExact":"Job.28.19"},{"anchorText":"Isaiah 45:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.45.14","rawQueryValue":"Isa.45.14","sourceRefExact":"Isa.45.14"},{"anchorText":"Ps 87:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ps.87.4","rawQueryValue":"Ps.87.4","sourceRefExact":"Ps.87.4"},{"anchorText":"Is 11:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.11.11","rawQueryValue":"Isa.11.11","sourceRefExact":"Isa.11.11"},{"anchorText":"Is 20:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.20.3","rawQueryValue":"Isa.20.3","sourceRefExact":"Isa.20.3"},{"anchorText":"Ez 30:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.30.4","rawQueryValue":"Ezek.30.4","sourceRefExact":"Ezek.30.4"},{"anchorText":"Zep 2:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Zeph.2.12","rawQueryValue":"Zeph.2.12","sourceRefExact":"Zeph.2.12"},{"anchorText":"Psalm 68:31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ps.68.31","rawQueryValue":"Ps.68.31","sourceRefExact":"Ps.68.31"},{"anchorText":"Isaiah 45:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.45.14","rawQueryValue":"Isa.45.14","sourceRefExact":"Isa.45.14"},{"anchorText":"Zephaniah 3:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Zeph.3.10","rawQueryValue":"Zeph.3.10","sourceRefExact":"Zeph.3.10"},{"anchorText":"Acts 8:27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.8.27","rawQueryValue":"Acts.8.27","sourceRefExact":"Acts.8.27"}],"sourceItemFragmentSha256":"daf0754cde293910c50