{"content":[{"c":["SALMON (P",{"c":["erson"],"sourceClass":"lc","t":"span"},")"],"sourceClass":"h1","t":"p"},{"c":["Nahshon’s son and an ancestor of David from Judah’s tribe (",{"href":"?bref=1Chr.2.11","r":"1Chr.2.11","rawR":"1Chr.2.11","sourceRefs":[{"raw":"1Chr.2.11","value":"1Chr.2.11"}],"t":"ref","v":"1 Chr 2:11"},"). Salmon fathered Boaz by Rahab (",{"href":"?bref=Ruth.4.20-21","r":"Ruth.4.20-21","rawR":"Ruth.4.20-21","sourceRefs":[{"raw":"Ruth.4.20-21","value":"Ruth.4.20-21"}],"t":"ref","v":"Ru 4:20-21"},") and is listed in Matthew’s genealogy as a forefather of Jesus Christ (",{"href":"?bref=Matt.1.4-5","r":"Matt.1.4-5","rawR":"Matt.1.4-5","sourceRefs":[{"raw":"Matt.1.4-5","value":"Matt.1.4-5"}],"t":"ref","v":"Mt 1:4-5"},"); in the Greek his name is spelled Sala in Luke’s genealogy (",{"href":"?bref=Luke.3.32","r":"Luke.3.32","rawR":"Luke.3.32","sourceRefs":[{"raw":"Luke.3.32","value":"Luke.3.32"}],"t":"ref","v":"Lk 3:32"},")."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=GenealogyofJesusChrist_Article_TyndaleOpenBibleDictionary","id":"GenealogyofJesusChrist_Article_TyndaleOpenBibleDictionary","rawId":"GenealogyofJesusChrist_Article_TyndaleOpenBibleDictionary","t":"link","v":"Genealogy of Jesus Christ"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"SalmonPerson","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 2:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.2.11","rawQueryValue":"1Chr.2.11","sourceRefExact":"1Chr.2.11"},{"anchorText":"Ru 4:20-21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ruth.4.20-21","rawQueryValue":"Ruth.4.20-21","sourceRefExact":"Ruth.4.20-21"},{"anchorText":"Mt 1:4-5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.1.4-5","rawQueryValue":"Matt.1.4-5","sourceRefExact":"Matt.1.4-5"},{"anchorText":"Lk 3:32","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.3.32","rawQueryValue":"Luke.3.32","sourceRefExact":"Luke.3.32"}],"sourceItemFragmentSha256":"56567b6c0b0fdddc261c7ca920f2339650cd144758efb80594b8ef09f4d18e91","sourceItemName":"SalmonPerson","sourceItemOrder":33,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"SalmonPerson","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Salmon (Person)","title":"Salmon (Person)","version":"v2-a101d843a2f0cd3fc0c6"}