{"content":[{"c":["HOPHNI"],"sourceClass":"h1","t":"p"},{"c":["Brother of Phinehas, with whom he served as a priest at Shiloh (",{"href":"?bref=1Sam.1.3","r":"1Sam.1.3","rawR":"1Sam.1.3","sourceRefs":[{"raw":"1Sam.1.3","value":"1Sam.1.3"}],"t":"ref","v":"1 Sm 1:3"},"). He was an evil man who flouted the sacrificial rituals (",{"href":"?bref=1Sam.2.12-17","r":"1Sam.2.12-17","rawR":"1Sam.2.12-17","sourceRefs":[{"raw":"1Sam.2.12-17","value":"1Sam.2.12-17"}],"t":"ref","v":"2:12-17"},") and behaved immorally (v ",{"href":"?bref=1Sam.2.22","r":"1Sam.2.22","rawR":"1Sam.2.22","sourceRefs":[{"raw":"1Sam.2.22","value":"1Sam.2.22"}],"t":"ref","v":"22"},"). Condemned by God, Hophni died during a Philistine attack on Shiloh and its sanctuary (",{"href":"?bref=1Sam.4.11","r":"1Sam.4.11","rawR":"1Sam.4.11","sourceRefs":[{"raw":"1Sam.4.11","value":"1Sam.4.11"}],"t":"ref","v":"4:11"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Hophni","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Sm 1:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.1.3","rawQueryValue":"1Sam.1.3","sourceRefExact":"1Sam.1.3"},{"anchorText":"2:12-17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.2.12-17","rawQueryValue":"1Sam.2.12-17","sourceRefExact":"1Sam.2.12-17"},{"anchorText":"22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.2.22","rawQueryValue":"1Sam.2.22","sourceRefExact":"1Sam.2.22"},{"anchorText":"4:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.4.11","rawQueryValue":"1Sam.4.11","sourceRefExact":"1Sam.4.11"}],"sourceItemFragmentSha256":"fc115b5be94d38ad0373675de6e988bceafa50079ced061c8fca89beb36c79f9","sourceItemName":"Hophni","sourceItemOrder":341,"sourceMember":"Articles/H.xml","supplementPointersNo