{"content":[{"c":["HEBRON (P",{"c":["erson"],"sourceClass":"lc","t":"span"},")"],"sourceClass":"h1","t":"p"},{"c":["1. Third of Kohath’s four sons, Hebron was a descendant of Levi (",{"href":"?bref=Exod.6.18","r":"Exod.6.18","rawR":"Exod.6.18","sourceRefs":[{"raw":"Exod.6.18","value":"Exod.6.18"}],"t":"ref","v":"Ex 6:18"},"; ",{"href":"?bref=Num.3.19","r":"Num.3.19","rawR":"Num.3.19","sourceRefs":[{"raw":"Num.3.19","value":"Num.3.19"}],"t":"ref","v":"Nm 3:19"},"; ",{"href":"?bref=1Chr.6.2,18","r":"1Chr.6.2,18","rawR":"1Chr.6.2,18","sourceRefs":[{"raw":"1Chr.6.2,18","value":"1Chr.6.2,18"}],"t":"ref","v":"1 Chr 6:2, 18"},"; ",{"href":"?bref=1Chr.23.12","r":"1Chr.23.12","rawR":"1Chr.23.12","sourceRefs":[{"raw":"1Chr.23.12","value":"1Chr.23.12"}],"t":"ref","v":"23:12"},"). Hebron’s sons were Jeriah, Amariah, Jahaziel, and Jekameam (",{"href":"?bref=1Chr.23.19","r":"1Chr.23.19","rawR":"1Chr.23.19","sourceRefs":[{"raw":"1Chr.23.19","value":"1Chr.23.19"}],"t":"ref","v":"1 Chr 23:19"},"). Hebron’s descendants were called the Hebronites. They are mentioned in a census taken in the plains of Moab (",{"href":"?bref=Num.26.58","r":"Num.26.58","rawR":"Num.26.58","sourceRefs":[{"raw":"Num.26.58","value":"Num.26.58"}],"t":"ref","v":"Nm 26:58"},"). The Hebronites are mentioned in connection with the transfer of the ark to Jerusalem in David’s time (",{"href":"?bref=1Chr.15.9","r":"1Chr.15.9","rawR":"1Chr.15.9","sourceRefs":[{"raw":"1Chr.15.9","value":"1Chr.15.9"}],"t":"ref","v":"1 Chr 15:9"},"; ",{"href":"?bref=1Chr.26.23,30-31","r":"1Chr.26.23,30-31","rawR":"1Chr.26.23,30-31","sourceRefs":[{"raw":"1Chr.26.23,30-31","value":"1Chr.26.23,30-31"}],"t":"ref","v":"26:23, 30-31"},")."],"sourceClass":"list","t":"p"},{"c":["2. Mareshah’s son and Korah’s father (",{"href":"?bref=1Chr.2.42-43","r":"1Chr.2.42-43","rawR":"1Chr.2.42-43","sourceRefs":[{"raw":"1Chr.2.42-43","value":"1Chr.2.42-43"}],"t":"ref","v":"1 Chr 2:42-43"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"HebronPerson","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ex 6:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.6.18","rawQueryValue":"Exod.6.18","sourceRefExact":"Exod.6.18"},{"anchorText":"Nm 3:19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.3.19","rawQueryValue":"Num.3.19","sourceRefExact":"Num.3.19"},{"anchorText":"1 Chr 6:2, 18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.6.2,18","rawQueryValue":"1Chr.6.2,18","sourceRefExact":"1Chr.6.2,18"},{"anchorText":"23:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.23.12","rawQueryValue":"1Chr.23.12","sourceRefExact":"1Chr.23.12"},{"anchorText":"1 Chr 23:19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.23.19","rawQueryValue":"1Chr.23.19","sourceRefExact":"1Chr.23.19"},{"anchorText":"Nm 26:58","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.26.58","rawQueryValue":"Num.26.58","sourceRefExact":"Num.26.58"},{"anchorText":"1 Chr 15:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.15.9","rawQueryValue":"1Chr.15.9","sourceRefExact":"1Chr.15.9"},{"anchorText":"26:23, 30-31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.26.23,30-31","rawQueryValue":"1Chr.26.23,30-31","sourceRefExact":"1Chr.26.23,30-31"},{"anchorText":"1 Chr 2:42-43","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.2.42-43","rawQueryValue":"1Chr.2.42-43","sourceRefExact":"1Chr.2.42-43"}],"sourceItemFragmentSha256":"cb502633f56fa2d6c6fd85ad18768621be5ebf677720855d135fc137b1ba15f1","sourceItemName":"HebronPerson","sourceItemOrder":206,"sourceMember":"Articles/H.xml","supplementPointe