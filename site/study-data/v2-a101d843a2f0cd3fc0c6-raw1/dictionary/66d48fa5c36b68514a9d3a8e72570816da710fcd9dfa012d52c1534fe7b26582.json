ization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Esd.7.36","rawQueryValue":"2Esd.7.36","sourceRefExact":"2Esd.7.36"},{"anchorText":"Is 30:33","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.30.33","rawQueryValue":"Isa.30.33","sourceRefExact":"Isa.30.33"},{"anchorText":"66:24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.66.24","rawQueryValue":"Isa.66.24","sourceRefExact":"Isa.66.24"},{"anchorText":"Dn 7:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Dan.7.10","rawQueryValue":"Dan.7.10","sourceRefExact":"Dan.7.10"},{"anchorText":"Mt 5:22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.5.22","rawQueryValue":"Matt.5.22","sourceRefExact":"Matt.5.22"},{"anchorText":"10:28","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.10.28","rawQueryValue":"Matt.10.28","sourceRefExact":"Matt.10.28"},{"anchorText":"18:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.18.9","rawQueryValue":"Matt.18.9","sourceRefExact":"Matt.18.9"},{"anchorText":"Mk 9:43","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mark.9.43","rawQueryValue":"Mark.9.43","sourceRefExact":"Mark.9.43"},{"anchorText":"Mt 13:42, 50","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.13.42,50","rawQueryValue":"Matt.13.42,50","sourceRefExact":"Matt.13.42,50"},{"anchorText":"Rv 20:14-15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.20.14-15","rawQueryValue":"Rev.20.14-15","sourceRefExact":"Rev.20.14-15"},{"anchorText":"Mt 23:15, 33","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.23.15,33","rawQueryValue":"Matt.23.15,33","sourceRefExact":"Matt.23.15,33"},{"anchorText":"Mt 25:41","canonicalization":"deferred_to_dictionary_