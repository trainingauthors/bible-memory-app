{"content":[{"c":["SARAPH"],"sourceClass":"h1","t":"p"},{"c":["Shelah’s son from Judah’s tribe. Saraph ruled in Moab and later returned to Lehem. “Lehem” may refer either to his own countrymen or to a geographical location. The reading of the Hebrew text is unclear (",{"href":"?bref=1Chr.4.22","r":"1Chr.4.22","rawR":"1Chr.4.22","sourceRefs":[{"raw":"1Chr.4.22","value":"1Chr.4.22"}],"t":"ref","v":"1 Chr 4:22"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Saraph","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 4:22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.4.22","rawQueryValue":"1Chr.4.22","sourceRefExact":"1Chr.4.22"}],"sourceItemFragmentSha256":"5354c47cdf87828d74c1dab6225e5bfdef183c36e6fa582c4f09b057cac9047a","sourceItemName":"Saraph","sourceItemOrder":67,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Saraph","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Saraph","title":"Saraph","version":"v2-a101d843a2f0cd3fc0c6"}