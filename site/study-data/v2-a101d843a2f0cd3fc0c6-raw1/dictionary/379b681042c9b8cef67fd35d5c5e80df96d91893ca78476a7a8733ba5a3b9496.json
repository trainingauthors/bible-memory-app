{"content":[{"c":["ABDA"],"sourceClass":"h1","t":"p"},{"c":["1. Adoniram’s father. Adoniram was superintendent of public works under King Solomon (",{"href":"?bref=1Kgs.4.6","r":"1Kgs.4.6","rawR":"1Kgs.4.6","sourceRefs":[{"raw":"1Kgs.4.6","value":"1Kgs.4.6"}],"t":"ref","v":"1 Kgs 4:6"},")."],"sourceClass":"list","t":"p"},{"c":["2. Shammua’s son, who was a Levite leader in Jerusalem after the exile (",{"href":"?bref=Neh.11.17","r":"Neh.11.17","rawR":"Neh.11.17","sourceRefs":[{"raw":"Neh.11.17","value":"Neh.11.17"}],"t":"ref","v":"Neh 11:17"},"). The same father and son are elsewhere identified as Shemaiah and Obadiah (",{"href":"?bref=1Chr.9.16","r":"1Chr.9.16","rawR":"1Chr.9.16","sourceRefs":[{"raw":"1Chr.9.16","value":"1Chr.9.16"}],"t":"ref","v":"1 Chr 9:16"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Abda","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Kgs 4:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.4.6","rawQueryValue":"1Kgs.4.6","sourceRefExact":"1Kgs.4.6"},{"anchorText":"Neh 11:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.11.17","rawQueryValue":"Neh.11.17","sourceRefExact":"Neh.11.17"},{"anchorText":"1 Chr 9:16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.9.16","rawQueryValue":"1Chr.9.16","sourceRefExact":"1Chr.9.16"}],"sourceItemFragmentSha256":"31e14d14f9d1345fe1656593c11edf40c97ecdb9fac8469a23e88802eaedc551","sourceItemName":"Abda","sourceItemOrder":10,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Abda","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Abda","title":"Abda","version":"v2-a101d843a2f0cd3fc0c6"}