{"content":[{"c":["BAALIS"],"sourceClass":"h1","t":"p"},{"c":["Ammonite king who arranged for the murder of Gedaliah, governor of the “remnant” left behind after Nebuchadnezzar’s capture of Jerusalem and deportation of its inhabitants (",{"href":"?bref=Jer.40.14","r":"Jer.40.14","rawR":"Jer.40.14","sourceRefs":[{"raw":"Jer.40.14","value":"Jer.40.14"}],"t":"ref","v":"Jer 40:14"},"). Although warned by a guerrilla leader, Johanan, Gedaliah refused to take heed and was killed (",{"href":"?bref=Jer.41.1-3","r":"Jer.41.1-3","rawR":"Jer.41.1-3","sourceRefs":[{"raw":"Jer.41.1-3","value":"Jer.41.1-3"}],"t":"ref","v":"Jer 41:1-3"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Baalis","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jer 40:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.40.14","rawQueryValue":"Jer.40.14","sourceRefExact":"Jer.40.14"},{"anchorText":"Jer 41:1-3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.41.1-3","rawQueryValue":"Jer.41.1-3","sourceRefExact":"Jer.41.1-3"}],"sourceItemFragmentSha256":"751820482a2a5af706cf8278faa1d8a3bd2deddd7322c853b1222f7d325d1044","sourceItemName":"Baalis","sourceItemOrder":15,"sourceMember":"Articles/B.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Baalis","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Baalis","title":"Baalis","version":"v2-a101d843a2f0cd3fc0c6"}