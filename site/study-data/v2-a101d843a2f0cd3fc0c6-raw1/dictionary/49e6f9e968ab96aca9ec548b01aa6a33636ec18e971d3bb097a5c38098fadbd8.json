{"content":[{"c":["PLEIADES"],"sourceClass":"h1","t":"p"},{"c":["Name of a constellation in the eastern sky composed of six bright and many other less visible stars. Telescopic photography has captured the appearance of these stars as being strung together by currents of matter. Job is asked a question that reflects this phenomenon: “Can you hold back the movements of the stars? Are you able to restrain the Pleiades or Orion?” (",{"href":"?bref=Job.38.31","r":"Job.38.31","rawR":"Job.38.31","sourceRefs":[{"raw":"Job.38.31","value":"Job.38.31"}],"t":"ref","v":"Jb 38:31"},", ",{"c":["nlt"],"sourceClass":"sc","t":"span"},")."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Orion_Article_TyndaleOpenBibleDictionary","id":"Orion_Article_TyndaleOpenBibleDictionary","rawId":"Orion_Article_TyndaleOpenBibleDictionary","t":"link","v":"Orion"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Pleiades","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jb 38:31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Job.38.31","rawQueryValue":"Job.38.31","sourceRefExact":"Job.38.31"}],"sourceItemFragmentSha256":"3a247361e7513797f6b8732491e5d7ebc22fee4ddef7edd64a027b35ae9d4898","sourceItemName":"Pleiades","sourceItemOrder":219,"sourceMember":"Articles/P.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Pleiades","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Pleiades","title":"Pleiades","version":"v2-a101d843a2f0cd3fc0c6"}