{"content":[{"c":["NEBUZARADAN"],"sourceClass":"h1","t":"p"},{"c":["Chief Babylonian official and captain of the bodyguard during Nebuchadnezzar’s reign (605–562 ",{"c":["BC"],"sourceClass":"era","t":"span"},"). Nebuzaradan was one of the officials whom Nebuchadnezzar authorized to oversee Jerusalem and Judah and the deportations of Jewish exiles to Babylon (",{"href":"?bref=2Kgs.25.8-20","r":"2Kgs.25.8-20","rawR":"2Kgs.25.8-20","sourceRefs":[{"raw":"2Kgs.25.8-20","value":"2Kgs.25.8-20"}],"t":"ref","v":"2 Kgs 25:8-20"},"; ",{"href":"?bref=Jer.39.9-10","r":"Jer.39.9-10","rawR":"Jer.39.9-10","sourceRefs":[{"raw":"Jer.39.9-10","value":"Jer.39.9-10"}],"t":"ref","v":"Jer 39:9-10"},"; ",{"href":"?bref=Jer.52.12-30","r":"Jer.52.12-30","rawR":"Jer.52.12-30","sourceRefs":[{"raw":"Jer.52.12-30","value":"Jer.52.12-30"}],"t":"ref","v":"52:12-30"},"). On the king’s orders, he appointed Gedaliah governor of Judah and Jeremiah’s guardian (",{"href":"?bref=Jer.39.11-13","r":"Jer.39.11-13","rawR":"Jer.39.11-13","sourceRefs":[{"raw":"Jer.39.11-13","value":"Jer.39.11-13"}],"t":"ref","v":"Jer 39:11-13"},"; ",{"href":"?bref=Jer.41.10","r":"Jer.41.10","rawR":"Jer.41.10","sourceRefs":[{"raw":"Jer.41.10","value":"Jer.41.10"}],"t":"ref","v":"41:10"},"; ",{"href":"?bref=Jer.43.6","r":"Jer.43.6","rawR":"Jer.43.6","sourceRefs":[{"raw":"Jer.43.6","value":"Jer.43.6"}],"t":"ref","v":"43:6"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Nebuzaradan","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Kgs 25:8-20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.25.8-20","rawQueryValue":"2Kgs.25.8-20","sourceRefExact":"2Kgs.25.8-20"},{"anchorText":"Jer 39:9-10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.39.9-10","rawQueryValue":"Jer.39.9-10","sourceRefExact":"Jer.39.9-10"},{"anchorText":"52:12-30","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.52.12-30","rawQueryValue":"Jer.52.12-30","sourceRefExact":"Jer.52.12-30"},{"anchorText":"Jer 39:11-13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.39.11-13","rawQueryValue":"Jer.39.11-13","sourceRefExact":"Jer.39.11-13"},{"anchorText":"41:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.41.10","rawQueryValue":"Jer.41.10","sourceRefExact":"Jer.41.10"},{"anchorText":"43:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.43.6","rawQueryValue":"Jer.43.6","sourceRefExact":"Jer.43.6"}],"sourceItemFragmentSha256":"a7382487e5262ee9a340bca527fcfbefe8ddf7bf315cd86987c087fcd96da733","sourceItemName":"Nebuzaradan","sourceItemOrder":77,"sourceMember":"Articles/N.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Nebuzaradan","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Nebuzaradan","title":"Nebuzaradan","version":"v2-a101d843a2f0cd3fc0c6"}