{"content":[{"c":["SENAAH"],"sourceClass":"h1","t":"p"},{"c":["Father of a family of Israelites who returned with Zerubbabel to Palestine following the exile (",{"href":"?bref=Ezra.2.35","r":"Ezra.2.35","rawR":"Ezra.2.35","sourceRefs":[{"raw":"Ezra.2.35","value":"Ezra.2.35"}],"t":"ref","v":"Ezr 2:35"},"; ",{"href":"?bref=Neh.7.38","r":"Neh.7.38","rawR":"Neh.7.38","sourceRefs":[{"raw":"Neh.7.38","value":"Neh.7.38"}],"t":"ref","v":"Neh 7:38"},"). They helped Nehemiah rebuild part of the Jerusalem wall (",{"href":"?bref=Neh.3.3","r":"Neh.3.3","rawR":"Neh.3.3","sourceRefs":[{"raw":"Neh.3.3","value":"Neh.3.3"}],"t":"ref","v":"Neh 3:3"},"; Hassenaah is an alternate spelling for Senaah). Hassenuah is a possible variant for Senaah (",{"href":"?bref=1Chr.9.7","r":"1Chr.9.7","rawR":"1Chr.9.7","sourceRefs":[{"raw":"1Chr.9.7","value":"1Chr.9.7"}],"t":"ref","v":"1 Chr 9:7"},"; ",{"href":"?bref=Neh.11.9","r":"Neh.11.9","rawR":"Neh.11.9","sourceRefs":[{"raw":"Neh.11.9","value":"Neh.11.9"}],"t":"ref","v":"Neh 11:9"},", where ",{"c":["kjv"],"sourceClass":"sc","t":"span"}," reads “Senuah”)."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Hassenuah_Article_TyndaleOpenBibleDictionary","id":"Hassenuah_Article_TyndaleOpenBibleDictionary","rawId":"Hassenuah_Article_TyndaleOpenBibleDictionary","t":"link","v":"Hassenuah"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Senaah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ezr 2:35","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.2.35","rawQueryValue":"Ezra.2.35","sourceRefExact":"Ezra.2.35"},{"anchorText":"Neh 7:38","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.7.38","rawQueryValue":"Neh.7.38","sourceRefExact":"Neh.7.38"},{"anchorText":"Neh 3:3","canonicalization":"deferred