{"content":[{"c":["ELISHUA"],"sourceClass":"h1","t":"p"},{"c":["One of the 13 children fathered by David during his reign in Jerusalem (",{"href":"?bref=2Sam.5.15","r":"2Sam.5.15","rawR":"2Sam.5.15","sourceRefs":[{"raw":"2Sam.5.15","value":"2Sam.5.15"}],"t":"ref","v":"2 Sm 5:15"},"; ",{"href":"?bref=1Chr.14.5","r":"1Chr.14.5","rawR":"1Chr.14.5","sourceRefs":[{"raw":"1Chr.14.5","value":"1Chr.14.5"}],"t":"ref","v":"1 Chr 14:5"},"). In the parallel passage of ",{"href":"?bref=1Chr.3.6","r":"1Chr.3.6","rawR":"1Chr.3.6","sourceRefs":[{"raw":"1Chr.3.6","value":"1Chr.3.6"}],"t":"ref","v":"1 Chronicles 3:6"},", the name Elishama appears in Elishua’s place in most Hebrew manuscripts."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Elishua","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Sm 5:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.5.15","rawQueryValue":"2Sam.5.15","sourceRefExact":"2Sam.5.15"},{"anchorText":"1 Chr 14:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.14.5","rawQueryValue":"1Chr.14.5","sourceRefExact":"1Chr.14.5"},{"anchorText":"1 Chronicles 3:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.3.6","rawQueryValue":"1Chr.3.6","sourceRefExact":"1Chr.3.6"}],"sourceItemFragmentSha256":"792b497ce86af5da33e20abf18c4e709595cb95da5ca2925d8671da366e5fda2","sourceItemName":"Elishua","sourceItemOrder":118,"sourceMember":"Articles/E.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Elishua","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Elishua","title":"Elishua","version":"v2-a101d843a2f0cd3fc0c6"}