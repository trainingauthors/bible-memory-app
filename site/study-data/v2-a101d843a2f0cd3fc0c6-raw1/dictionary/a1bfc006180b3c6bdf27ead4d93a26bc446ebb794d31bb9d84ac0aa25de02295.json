{"content":[{"c":["TABEAL*, TABEEL"],"sourceClass":"h1","t":"p"},{"c":["1. Ruler in Samaria who, with his associates, wrote a letter to King Artaxerxes I of Persia (464–424 ",{"c":["BC"],"sourceClass":"era","t":"span"},") protesting Zerubbabel’s rebuilding of the Jerusalem wall (",{"href":"?bref=Ezra.4.7","r":"Ezra.4.7","rawR":"Ezra.4.7","sourceRefs":[{"raw":"Ezra.4.7","value":"Ezra.4.7"}],"t":"ref","v":"Ezr 4:7"},")."],"sourceClass":"list","t":"p"},{"c":["2. Father of the man whom King Pekah of Israel and King Rezin of Syria wanted to put on the throne of Jerusalem after they conquered it and subdued Ahaz, king of Judah (735–715 ",{"c":["BC"],"sourceClass":"era","t":"span"},"; ",{"href":"?bref=Isa.7.6","r":"Isa.7.6","rawR":"Isa.7.6","sourceRefs":[{"raw":"Isa.7.6","value":"Isa.7.6"}],"t":"ref","v":"Is 7:6"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"TabealTabeel","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ezr 4:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.4.7","rawQueryValue":"Ezra.4.7","sourceRefExact":"Ezra.4.7"},{"anchorText":"Is 7:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.7.6","rawQueryValue":"Isa.7.6","sourceRefExact":"Isa.7.6"}],"sourceItemFragmentSha256":"8e7434f603e8c801e9f7b9de6502008e4ad57a3e208b9a714b2684c6265465c8","sourceItemName":"TabealTabeel","sourceItemOrder":6,"sourceMember":"Articles/T.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"TabealTabeel","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Tabeal*, Tabeel","title":"Tabeal*, Tabeel","version":"v2-a101d843a2f0cd3fc0c6"}