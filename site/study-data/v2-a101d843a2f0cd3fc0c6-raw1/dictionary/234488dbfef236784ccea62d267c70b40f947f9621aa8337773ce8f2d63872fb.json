rawQueryValue":"Mic.6.15","sourceRefExact":"Mic.6.15"},{"anchorText":"2 Sm 14:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.14.2","rawQueryValue":"2Sam.14.2","sourceRefExact":"2Sam.14.2"},{"anchorText":"Dn 10:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Dan.10.3","rawQueryValue":"Dan.10.3","sourceRefExact":"Dan.10.3"},{"anchorText":"Mt 6:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.6.17","rawQueryValue":"Matt.6.17","sourceRefExact":"Matt.6.17"},{"anchorText":"Jas 5:14-16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jas.5.14-16","rawQueryValue":"Jas.5.14-16","sourceRefExact":"Jas.5.14-16"},{"anchorText":"Mk 6:12-13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mark.6.12-13","rawQueryValue":"Mark.6.12-13","sourceRefExact":"Mark.6.12-13"}],"sourceItemFragmentSha256":"7e451bf73a881620d786b5500d08ba0df199fd35ffe197fe665e96f4905694e6","sourceItemName":"Anoint","sourceItemOrder":364,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Anoint","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Anoint","title":"Anoint","version":"v2-a101d843a2f0cd3fc0c6"}