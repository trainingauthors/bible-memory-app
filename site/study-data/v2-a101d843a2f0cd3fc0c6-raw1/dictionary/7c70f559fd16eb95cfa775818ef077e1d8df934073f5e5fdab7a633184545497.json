{"content":[{"c":["BETH-MARCABOTH"],"sourceClass":"h1","t":"p"},{"c":["City in Judah’s territory given to the tribe of Simeon (",{"href":"?bref=Josh.19.5","r":"Josh.19.5","rawR":"Josh.19.5","sourceRefs":[{"raw":"Josh.19.5","value":"Josh.19.5"}],"t":"ref","v":"Jos 19:5"},"; ",{"href":"?bref=1Chr.4.31","r":"1Chr.4.31","rawR":"1Chr.4.31","sourceRefs":[{"raw":"1Chr.4.31","value":"1Chr.4.31"}],"t":"ref","v":"1 Chr 4:31"},"), possibly the same as Madmannah (",{"href":"?bref=Josh.15.31","r":"Josh.15.31","rawR":"Josh.15.31","sourceRefs":[{"raw":"Josh.15.31","value":"Josh.15.31"}],"t":"ref","v":"Jos 15:31"},"). The name Beth-marcaboth means “house of chariots,” and consequently some have seen a link to the chariot cities of Solomon (",{"href":"?bref=1Kgs.9.19","r":"1Kgs.9.19","rawR":"1Kgs.9.19","sourceRefs":[{"raw":"1Kgs.9.19","value":"1Kgs.9.19"}],"t":"ref","v":"1 Kgs 9:19"},"; ",{"href":"?bref=1Kgs.10.26","r":"1Kgs.10.26","rawR":"1Kgs.10.26","sourceRefs":[{"raw":"1Kgs.10.26","value":"1Kgs.10.26"}],"t":"ref","v":"10:26"},"). Its location is unknown unless it can be identified with Madmannah."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"BethMarcaboth","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 19:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.19.5","rawQueryValue":"Josh.19.5","sourceRefExact":"Josh.19.5"},{"anchorText":"1 Chr 4:31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.4.31","rawQueryValue":"1Chr.4.31","sourceRefExact":"1Chr.4.31"},{"anchorText":"Jos 15:31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.31","rawQueryValue":"Josh.15.31","sourceRefExact":"Josh.15.31"},{"anchorText":"1 Kgs 9:19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.9.19","rawQueryValue":"1Kgs.9.19","sourceRefExact":"1Kgs.9.19"},{"anchorText":"10:26","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.10.26","rawQueryValue":"1Kgs.10.26","sourceRefExact":"1Kgs.10.26"}],"sourceItemFragmentSha256":"c76f023622a92bc05f8b75c1289797b3fb81a3c3a353bdb9c1de6c9bebb7cccb","sourceItemName":"BethMarcaboth","sourceItemOrder":263,"sourceMember":"Articles/B.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"BethMarcaboth","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Beth-Marcaboth","title":"Beth-Marcaboth","version":"v2-a101d843a2f0cd3fc0c6"}