{"content":[{"c":["RAISIN CAKE"],"sourceClass":"h1","t":"p"},{"c":["Culinary delicacy of ancient peoples (",{"href":"?bref=Isa.16.7","r":"Isa.16.7","rawR":"Isa.16.7","sourceRefs":[{"raw":"Isa.16.7","value":"Isa.16.7"}],"t":"ref","v":"Is 16:7"},"). The cakes resisted deterioration and thus were useful for soldiers and travelers (",{"href":"?bref=2Sam.6.19","r":"2Sam.6.19","rawR":"2Sam.6.19","sourceRefs":[{"raw":"2Sam.6.19","value":"2Sam.6.19"}],"t":"ref","v":"2 Sm 6:19"},"). They were used as cultic offerings (",{"href":"?bref=Hos.3.1","r":"Hos.3.1","rawR":"Hos.3.1","sourceRefs":[{"raw":"Hos.3.1","value":"Hos.3.1"}],"t":"ref","v":"Hos 3:1"},") and sometimes served as aphrodisiacs (",{"href":"?bref=Song.2.5","r":"Song.2.5","rawR":"Song.2.5","sourceRefs":[{"raw":"Song.2.5","value":"Song.2.5"}],"t":"ref","v":"Sg 2:5"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"RaisinCake","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Is 16:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.16.7","rawQueryValue":"Isa.16.7","sourceRefExact":"Isa.16.7"},{"anchorText":"2 Sm 6:19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.6.19","rawQueryValue":"2Sam.6.19","sourceRefExact":"2Sam.6.19"},{"anchorText":"Hos 3:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Hos.3.1","rawQueryValue":"Hos.3.1","sourceRefExact":"Hos.3.1"},{"anchorText":"Sg 2:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Song.2.5","rawQueryValue":"Song.2.5","sourceRefExact":"Song.2.5"}],"sourceItemFragmentSha256":"4f640bd24657373e913137e96647896d547ec13c5e3d3ad865066b374afffd9f","sourceItemName":"RaisinCake","sourceItemOrder":28,"sourceMember":"Articles/R.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Raisi