{"content":[{"c":["BAHARUM*, BAHARUMITE*, BAHURIM "],"sourceClass":"h1","t":"p"},{"c":["Village in Benjamin’s territory on the old road connecting Jericho and Jerusalem, east of the Mt of Olives. Bahurim was located at the site of the present Ras et-Temim. Palti parted from his wife, Michal, there at Abner’s command when Michal was being returned to King David (",{"href":"?bref=2Sam.3.16","r":"2Sam.3.16","rawR":"2Sam.3.16","sourceRefs":[{"raw":"2Sam.3.16","value":"2Sam.3.16"}],"t":"ref","v":"2 Sm 3:16"},"). At Bahurim, Shimei cursed David and threw stones at him and his servants (",{"href":"?bref=2Sam.16.5","r":"2Sam.16.5","rawR":"2Sam.16.5","sourceRefs":[{"raw":"2Sam.16.5","value":"2Sam.16.5"}],"t":"ref","v":"2 Sm 16:5"},"; ",{"href":"?bref=2Sam.19.16","r":"2Sam.19.16","rawR":"2Sam.19.16","sourceRefs":[{"raw":"2Sam.19.16","value":"2Sam.19.16"}],"t":"ref","v":"19:16"},"; ",{"href":"?bref=1Kgs.2.8","r":"1Kgs.2.8","rawR":"1Kgs.2.8","sourceRefs":[{"raw":"1Kgs.2.8","value":"1Kgs.2.8"}],"t":"ref","v":"1 Kgs 2:8"},"). Jonathan and Ahimaaz, spying for David, were hidden from Absalom’s soldiers in a well there (",{"href":"?bref=2Sam.17.18","r":"2Sam.17.18","rawR":"2Sam.17.18","sourceRefs":[{"raw":"2Sam.17.18","value":"2Sam.17.18"}],"t":"ref","v":"2 Sm 17:18"},"). One of David’s mighty men, Azmaveth, came from Bahurim (",{"href":"?bref=2Sam.23.31","r":"2Sam.23.31","rawR":"2Sam.23.31","sourceRefs":[{"raw":"2Sam.23.31","value":"2Sam.23.31"}],"t":"ref","v":"2 Sm 23:31"},"; ",{"href":"?bref=1Chr.11.33","r":"1Chr.11.33","rawR":"1Chr.11.33","sourceRefs":[{"raw":"1Chr.11.33","value":"1Chr.11.33"}],"t":"ref","v":"1 Chr 11:33"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"BaharumBaharumiteBahurim","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Sm 3:16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.3.16","rawQueryValue":"2Sam.3.16","sourceRefExact":"2Sam.3.16"},{"anchorText":"2 Sm 16:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.16.5","rawQueryValue":"2Sam.16.5","sourceRefExact":"2Sam.16.5"},{"anchorText":"19:16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.19.16","rawQueryValue":"2Sam.19.16","sourceRefExact":"2Sam.19.16"},{"anchorText":"1 Kgs 2:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.2.8","rawQueryValue":"1Kgs.2.8","sourceRefExact":"1Kgs.2.8"},{"anchorText":"2 Sm 17:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.17.18","rawQueryValue":"2Sam.17.18","sourceRefExact":"2Sam.17.18"},{"anchorText":"2 Sm 23:31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.23.31","rawQueryValue":"2Sam.23.31","sourceRefExact":"2Sam.23.31"},{"anchorText":"1 Chr 11:33","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.11.33","rawQueryValue":"1Chr.11.33","sourceRefExact":"1Chr.11.33"}],"sourceItemFragmentSha256":"1aa66d63bb1f6bfb9c85d2733f0b18594d269c89c5ee995b54a2209e78541bbc","sourceItemName":"BaharumBaharumiteBahurim","sourceItemOrder":42,"sourceMember":"Articles/B.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"BaharumBaharumiteBahurim","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Baharum*, Baharumite*, Bahurim","title":"Baharum*, Baharumite*, Bahurim","version":"v2-a101d843a2f0cd3fc0c6"}