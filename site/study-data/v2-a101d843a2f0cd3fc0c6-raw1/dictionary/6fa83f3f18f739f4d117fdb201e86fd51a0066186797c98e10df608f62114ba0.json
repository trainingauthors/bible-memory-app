{"content":[{"c":["TRIBUNE*"],"sourceClass":"h1","t":"p"},{"c":["Roman military official who served as the commander of a cohort (1,000 men). In NT usage it designated the commander of the Roman garrison in Jerusalem (e.g., ",{"href":"?bref=Acts.21.31","r":"Acts.21.31","rawR":"Acts.21.31","sourceRefs":[{"raw":"Acts.21.31","value":"Acts.21.31"}],"t":"ref","v":"Acts 21:31"},"; ",{"href":"?bref=Acts.22.24","r":"Acts.22.24","rawR":"Acts.22.24","sourceRefs":[{"raw":"Acts.22.24","value":"Acts.22.24"}],"t":"ref","v":"22:24"},"; ",{"href":"?bref=Acts.23.10","r":"Acts.23.10","rawR":"Acts.23.10","sourceRefs":[{"raw":"Acts.23.10","value":"Acts.23.10"}],"t":"ref","v":"23:10"},"; ",{"href":"?bref=Acts.24.22","r":"Acts.24.22","rawR":"Acts.24.22","sourceRefs":[{"raw":"Acts.24.22","value":"Acts.24.22"}],"t":"ref","v":"24:22"},"). Paul was placed under the tribune’s protection after his arrest in Jerusalem (",{"href":"?bref=Acts.21.33","r":"Acts.21.33","rawR":"Acts.21.33","sourceRefs":[{"raw":"Acts.21.33","value":"Acts.21.33"}],"t":"ref","v":"21:33"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Tribune","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Acts 21:31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.21.31","rawQueryValue":"Acts.21.31","sourceRefExact":"Acts.21.31"},{"anchorText":"22:24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.22.24","rawQueryValue":"Acts.22.24","sourceRefExact":"Acts.22.24"},{"anchorText":"23:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.23.10","rawQueryValue":"Acts.23.10","sourceRefExact":"Acts.23.10"},{"anchorText":"24:22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.24.22","rawQueryValue":"Acts.24.22","sourceRefExact":"Acts.24.22"},{"anchorText":"