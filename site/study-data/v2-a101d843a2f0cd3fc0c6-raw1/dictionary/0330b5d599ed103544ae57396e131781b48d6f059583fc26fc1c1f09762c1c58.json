{"content":[{"c":["BETH-ZUR"],"sourceClass":"h1","t":"p"},{"c":["Hill town of Judah in the mountains north of Hebron (",{"href":"?bref=Josh.15.58","r":"Josh.15.58","rawR":"Josh.15.58","sourceRefs":[{"raw":"Josh.15.58","value":"Josh.15.58"}],"t":"ref","v":"Jos 15:58"},"). Beth-zur was settled by Maon, one of Caleb’s descendants (",{"href":"?bref=1Chr.2.45","r":"1Chr.2.45","rawR":"1Chr.2.45","sourceRefs":[{"raw":"1Chr.2.45","value":"1Chr.2.45"}],"t":"ref","v":"1 Chr 2:45"},"), and was one of the natural strongholds of Judah. It was fortified by King Rehoboam of the southern kingdom in the 10th century ",{"c":["BC"],"sourceClass":"era","t":"span"},", even though it had begun to decline in importance (",{"href":"?bref=2Chr.11.7","r":"2Chr.11.7","rawR":"2Chr.11.7","sourceRefs":[{"raw":"2Chr.11.7","value":"2Chr.11.7"}],"t":"ref","v":"2 Chr 11:7"},"). It served as an administrative center during the time of Nehemiah (",{"href":"?bref=Neh.3.16","r":"Neh.3.16","rawR":"Neh.3.16","sourceRefs":[{"raw":"Neh.3.16","value":"Neh.3.16"}],"t":"ref","v":"Neh 3:16"},"). In the Maccabean period it was known by the Greek name Bethsura. Judas Maccabeus defeated Syrian general Lysias there (",{"href":"?bref=1Macc.4.29,61","r":"1Macc.4.29,61","rawR":"1Macc.4.29,61","sourceRefs":[{"raw":"1Macc.4.29,61","value":"1Macc.4.29,61"}],"t":"ref","v":"1 Macc 4:29, 61"},") and lost the town a few years later. After recapturing Beth-zur from the Syrians, Simon Maccabeus strengthened it in 140 ",{"c":["BC"],"sourceClass":"era","t":"span"},", making it one of the most important fortresses on the border between Judah and Idumea (",{"href":"?bref=1Macc.11.65-66","r":"1Macc.11.65-66","rawR":"1Macc.11.65-66","sourceRefs":[{"raw":"1Macc.11.65-66","value":"1Macc.11.65-66"}],"t":"ref","v":"11:65-66"},"; ",{"href":"?bref=1Macc.14.33","r":"1Macc.14.33","rawR":"1Macc.14.33","sourceRefs":[{"raw":"1Macc.14.33","value":"1Macc.14.33"}],"t":"ref","v":"14:33"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"BethZur","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 15:58","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.58","rawQueryValue":"Josh.15.58","sourceRefExact":"Josh.15.58"},{"anchorText":"1 Chr 2:45","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.2.45","rawQueryValue":"1Chr.2.45","sourceRefExact":"1Chr.2.45"},{"anchorText":"2 Chr 11:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.11.7","rawQueryValue":"2Chr.11.7","sourceRefExact":"2Chr.11.7"},{"anchorText":"Neh 3:16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.3.16","rawQueryValue":"Neh.3.16","sourceRefExact":"Neh.3.16"},{"anchorText":"1 Macc 4:29, 61","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Macc.4.29,61","rawQueryValue":"1Macc.4.29,61","sourceRefExact":"1Macc.4.29,61"},{"anchorText":"11:65-66","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Macc.11.65-66","rawQueryValue":"1Macc.11.65-66","sourceRefExact":"1Macc.11.65-66"},{"anchorText":"14:33","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Macc.14.33","rawQueryValue":"1Macc.14.33","sourceRefExact":"1Macc.14.33"}],"sourceItemFragmentSha256":"9c6a40b87610409ce39b88d3e3906a44551299a8814f5fc44a3c7266f0e78cf0","sourceItemName":"BethZur","sourceItemOrder":288,"sourceMember":"Articles/B.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"BethZur","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Beth-Zur","title":"Beth-Zur","version":"v2-a101d843a2f0cd3fc0c6"}