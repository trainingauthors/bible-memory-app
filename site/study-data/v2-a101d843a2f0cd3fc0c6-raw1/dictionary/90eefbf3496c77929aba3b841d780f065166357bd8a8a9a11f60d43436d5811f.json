{"content":[{"c":["ELIZAPHAN"],"sourceClass":"h1","t":"p"},{"c":["1. Kohathite Levite and Uzziel’s son (",{"href":"?bref=Num.3.29-30","r":"Num.3.29-30","rawR":"Num.3.29-30","sourceRefs":[{"raw":"Num.3.29-30","value":"Num.3.29-30"}],"t":"ref","v":"Nm 3:29-30"},"), who assisted in removing the bodies of Nadab and Abihu from the camp (",{"href":"?bref=Lev.10.4","r":"Lev.10.4","rawR":"Lev.10.4","sourceRefs":[{"raw":"Lev.10.4","value":"Lev.10.4"}],"t":"ref","v":"Lv 10:4"},"). Elizaphan’s descendants were responsible for caring for the ark, the table, the lampstand, and vessels of the sanctuary (cf. ",{"href":"?bref=1Chr.15.8","r":"1Chr.15.8","rawR":"1Chr.15.8","sourceRefs":[{"raw":"1Chr.15.8","value":"1Chr.15.8"}],"t":"ref","v":"1 Chr 15:8"},"; ",{"href":"?bref=2Chr.29.13","r":"2Chr.29.13","rawR":"2Chr.29.13","sourceRefs":[{"raw":"2Chr.29.13","value":"2Chr.29.13"}],"t":"ref","v":"2 Chr 29:13"},"). His name is alternately spelled Elzaphan (",{"href":"?bref=Exod.6.22","r":"Exod.6.22","rawR":"Exod.6.22","sourceRefs":[{"raw":"Exod.6.22","value":"Exod.6.22"}],"t":"ref","v":"Ex 6:22"},"; ",{"href":"?bref=Lev.10.4","r":"Lev.10.4","rawR":"Lev.10.4","sourceRefs":[{"raw":"Lev.10.4","value":"Lev.10.4"}],"t":"ref","v":"Lv 10:4"},")."],"sourceClass":"list","t":"p"},{"c":["2. Parnach’s son and a leader from Zebulun’s tribe, who helped Eleazar and Joshua divide the Canaanite territory west of the Jordan among the 9½ tribes (",{"href":"?bref=Num.34.25","r":"Num.34.25","rawR":"Num.34.25","sourceRefs":[{"raw":"Num.34.25","value":"Num.34.25"}],"t":"ref","v":"Nm 34:25"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Elizaphan","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Nm 3:29-30","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.3.29-30","rawQueryValue":"Num.3.29-30","sourceRefExact":"Num.3.29-30"},{"anchorText":"Lv 10:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Lev.10.4","rawQueryValue":"Lev.10.4","sourceRefExact":"Lev.10.4"},{"anchorText":"1 Chr 15:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.15.8","rawQueryValue":"1Chr.15.8","sourceRefExact":"1Chr.15.8"},{"anchorText":"2 Chr 29:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.29.13","rawQueryValue":"2Chr.29.13","sourceRefExact":"2Chr.29.13"},{"anchorText":"Ex 6:22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.6.22","rawQueryValue":"Exod.6.22","sourceRefExact":"Exod.6.22"},{"anchorText":"Lv 10:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Lev.10.4","rawQueryValue":"Lev.10.4","sourceRefExact":"Lev.10.4"},{"anchorText":"Nm 34:25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.34.25","rawQueryValue":"Num.34.25","sourceRefExact":"Num.34.25"}],"sourceItemFragmentSha256":"1d8ad69f458f2e1347fb9a4783ae49d7f39d52077afd5601f8b4dc838bafc551","sourceItemName":"Elizaphan","sourceItemOrder":121,"sourceMember":"Articles/E.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Elizaphan","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Elizaphan","title":"Elizaphan","version":"v2-a101d843a2f0cd3fc0c6"}