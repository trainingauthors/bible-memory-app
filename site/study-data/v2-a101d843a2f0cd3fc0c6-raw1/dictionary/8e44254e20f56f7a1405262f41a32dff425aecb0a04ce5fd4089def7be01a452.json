{"content":[{"c":["SHUTHELAH"],"sourceClass":"h1","t":"p"},{"c":["1. Ephraim’s son, the brother of Beker and Tahan, and the father of Eran and Bered. He founded the Shuthelahite family and was an ancestor of Joshua the son of Nun (",{"href":"?bref=Num.26.35","r":"Num.26.35","rawR":"Num.26.35","sourceRefs":[{"raw":"Num.26.35","value":"Num.26.35"}],"t":"ref","v":"Nm 26:35"},"; ",{"href":"?bref=1Chr.7.20,27","r":"1Chr.7.20,27","rawR":"1Chr.7.20,27","sourceRefs":[{"raw":"1Chr.7.20,27","value":"1Chr.7.20,27"}],"t":"ref","v":"1 Chr 7:20, 27"},")."],"sourceClass":"list","t":"p"},{"c":["2. Zabad’s son from Ephraim’s tribe (",{"href":"?bref=1Chr.7.21","r":"1Chr.7.21","rawR":"1Chr.7.21","sourceRefs":[{"raw":"1Chr.7.21","value":"1Chr.7.21"}],"t":"ref","v":"1 Chr 7:21"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Shuthelah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Nm 26:35","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.26.35","rawQueryValue":"Num.26.35","sourceRefExact":"Num.26.35"},{"anchorText":"1 Chr 7:20, 27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.7.20,27","rawQueryValue":"1Chr.7.20,27","sourceRefExact":"1Chr.7.20,27"},{"anchorText":"1 Chr 7:21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.7.21","rawQueryValue":"1Chr.7.21","sourceRefExact":"1Chr.7.21"}],"sourceItemFragmentSha256":"0c2095abbca10fec99d95f31155b865844e7f23c12392579e0a7e4d4e58aa0a8","sourceItemName":"Shuthelah","sourceItemOrder":394,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Shuthelah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Shuthelah","title":"Shuthelah","version":"v2-a101d843a2f0cd3fc0c6"}