{"content":[{"c":["SHIMSHAI"],"sourceClass":"h1","t":"p"},{"c":["Persian government official whose territory included Palestine. With another official (Rehum), he wrote a letter to Artaxerxes opposing the rebuilding of the temple by the Jews returned from exile (",{"href":"?bref=Ezra.4.8-9","r":"Ezra.4.8-9","rawR":"Ezra.4.8-9","sourceRefs":[{"raw":"Ezra.4.8-9","value":"Ezra.4.8-9"}],"t":"ref","v":"Ezr 4:8-9"},"). He succeeded in halting the rebuilding project."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Shimshai","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ezr 4:8-9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.4.8-9","rawQueryValue":"Ezra.4.8-9","sourceRefExact":"Ezra.4.8-9"}],"sourceItemFragmentSha256":"2576ea67f6c8231ba1c555364a93ee5a0238c6db45e3ece3495c1d329b0074b4","sourceItemName":"Shimshai","sourceItemOrder":345,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Shimshai","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Shimshai","title":"Shimshai","version":"v2-a101d843a2f0cd3fc0c6"}