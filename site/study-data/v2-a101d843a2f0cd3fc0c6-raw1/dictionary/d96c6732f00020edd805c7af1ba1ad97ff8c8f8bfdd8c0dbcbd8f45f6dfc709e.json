{"content":[{"c":["APPHIA"],"sourceClass":"h1","t":"p"},{"c":["Christian woman in Colosse, possibly the wife or sister of Philemon. The apostle Paul greeted her in his letter to Philemon (v ",{"href":"?bref=Phlm.1.2","r":"Phlm.1.2","rawR":"Phlm.1.2","sourceRefs":[{"raw":"Phlm.1.2","value":"Phlm.1.2"}],"t":"ref","v":"2"},"). According to tradition, she was martyred during Nero’s persecution. On the saints’ calendar of the Greek Orthodox Church, she is honored on November 22."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Apphia","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Phlm.1.2","rawQueryValue":"Phlm.1.2","sourceRefExact":"Phlm.1.2"}],"sourceItemFragmentSha256":"2ad15358f83411e354b6490169b4f4c0659b68d6533c97d27be5bff686ee00d6","sourceItemName":"Apphia","sourceItemOrder":416,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Apphia","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Apphia","title":"Apphia","version":"v2-a101d843a2f0cd3fc0c6"}