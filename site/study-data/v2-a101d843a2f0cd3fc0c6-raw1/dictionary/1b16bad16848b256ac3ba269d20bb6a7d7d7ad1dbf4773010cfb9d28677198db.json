{"content":[{"c":["RHODA"],"sourceClass":"h1","t":"p"},{"c":["Maid in the home of Mary the mother of John Mark in Jerusalem. Rhoda reported to those in the house that Peter was standing outside the door. Since they were unaware of his release from prison, the others at first did not believe her report (",{"href":"?bref=Acts.12.13-15","r":"Acts.12.13-15","rawR":"Acts.12.13-15","sourceRefs":[{"raw":"Acts.12.13-15","value":"Acts.12.13-15"}],"t":"ref","v":"Acts 12:13-15"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Rhoda","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Acts 12:13-15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.12.13-15","rawQueryValue":"Acts.12.13-15","sourceRefExact":"Acts.12.13-15"}],"sourceItemFragmentSha256":"20fb4fac112048ea570bdcc220ce8f1ee6cb107703f49b2dd1c2679ab9f626c4","sourceItemName":"Rhoda","sourceItemOrder":141,"sourceMember":"Articles/R.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Rhoda","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Rhoda","title":"Rhoda","version":"v2-a101d843a2f0cd3fc0c6"}