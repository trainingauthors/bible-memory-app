{"content":[{"c":["JOAH"],"sourceClass":"h1","t":"p"},{"c":["1. Asaph’s son and a court official under King Hezekiah (",{"href":"?bref=2Kgs.18.18,26","r":"2Kgs.18.18,26","rawR":"2Kgs.18.18,26","sourceRefs":[{"raw":"2Kgs.18.18,26","value":"2Kgs.18.18,26"}],"t":"ref","v":"2 Kgs 18:18, 26"},"; ",{"href":"?bref=Isa.36.3,11,22","r":"Isa.36.3,11,22","rawR":"Isa.36.3,11,22","sourceRefs":[{"raw":"Isa.36.3,11,22","value":"Isa.36.3,11,22"}],"t":"ref","v":"Is 36:3, 11, 22"},"). He was one of the officers sent by Hezekiah to deal with the Assyrians during the siege of Jerusalem."],"sourceClass":"list","t":"p"},{"c":["2. Zimmah’s son from Levi’s tribe (",{"href":"?bref=1Chr.6.21","r":"1Chr.6.21","rawR":"1Chr.6.21","sourceRefs":[{"raw":"1Chr.6.21","value":"1Chr.6.21"}],"t":"ref","v":"1 Chr 6:21"},")."],"sourceClass":"list","t":"p"},{"c":["3. Levite, Obed-edom’s son and a gatekeeper of the sanctuary in David’s time (",{"href":"?bref=1Chr.26.4","r":"1Chr.26.4","rawR":"1Chr.26.4","sourceRefs":[{"raw":"1Chr.26.4","value":"1Chr.26.4"}],"t":"ref","v":"1 Chr 26:4"},")."],"sourceClass":"list","t":"p"},{"c":["4. Joahaz’s son and a recorder under King Josiah; he was one of the deputies overseeing the temple repairs (",{"href":"?bref=2Chr.34.8","r":"2Chr.34.8","rawR":"2Chr.34.8","sourceRefs":[{"raw":"2Chr.34.8","value":"2Chr.34.8"}],"t":"ref","v":"2 Chr 34:8"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Joah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Kgs 18:18, 26","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.18.18,26","rawQueryValue":"2Kgs.18.18,26","sourceRefExact":"2Kgs.18.18,26"},{"anchorText":"Is 36:3, 11, 22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.36.3,11,22","rawQueryValue":"Isa.36.3,11,22","sourceRefExact":"Isa.36.3,11,22"},{"anchorText":"1 Chr 6:2