{"content":[{"c":["EBED"],"sourceClass":"h1","t":"p"},{"c":["1. Gaal’s father (",{"href":"?bref=Judg.9.26-35","r":"Judg.9.26-35","rawR":"Judg.9.26-35","sourceRefs":[{"raw":"Judg.9.26-35","value":"Judg.9.26-35"}],"t":"ref","v":"Jgs 9:26-35"},"). Gaal led the men of Shechem in an unsuccessful revolt against Abimelech, judge of Israel."],"sourceClass":"list","t":"p"},{"c":["2. Adin’s descendant and son of Jonathan. Ebed was the head of a family that returned to Judah with Ezra after the exile (",{"href":"?bref=Ezra.8.6","r":"Ezra.8.6","rawR":"Ezra.8.6","sourceRefs":[{"raw":"Ezra.8.6","value":"Ezra.8.6"}],"t":"ref","v":"Ezr 8:6"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Ebed","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jgs 9:26-35","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.9.26-35","rawQueryValue":"Judg.9.26-35","sourceRefExact":"Judg.9.26-35"},{"anchorText":"Ezr 8:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.8.6","rawQueryValue":"Ezra.8.6","sourceRefExact":"Ezra.8.6"}],"sourceItemFragmentSha256":"f2cd68e93ba71f04fb44d7e2cae06d8f699fc661cccd93f9d95ddf02cf77854c","sourceItemName":"Ebed","sourceItemOrder":14,"sourceMember":"Articles/E.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Ebed","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Ebed","title":"Ebed","version":"v2-a101d843a2f0cd3fc0c6"}