{"content":[{"c":["HATTUSH"],"sourceClass":"h1","t":"p"},{"c":["1. Shemaiah’s son and a descendant of David (",{"href":"?bref=1Chr.3.22","r":"1Chr.3.22","rawR":"1Chr.3.22","sourceRefs":[{"raw":"1Chr.3.22","value":"1Chr.3.22"}],"t":"ref","v":"1 Chr 3:22"},"). Hattush returned from the Babylonian exile with Ezra (",{"href":"?bref=Ezra.8.3","r":"Ezra.8.3","rawR":"Ezra.8.3","sourceRefs":[{"raw":"Ezra.8.3","value":"Ezra.8.3"}],"t":"ref","v":"Ezr 8:3"},")."],"sourceClass":"list","t":"p"},{"c":["2. Son of Hashabneiah, who helped Nehemiah rebuild the walls of Jerusalem (",{"href":"?bref=Neh.3.10","r":"Neh.3.10","rawR":"Neh.3.10","sourceRefs":[{"raw":"Neh.3.10","value":"Neh.3.10"}],"t":"ref","v":"Neh 3:10"},")."],"sourceClass":"list","t":"p"},{"c":["3. Priest who returned from Babylon with Zerubbabel (",{"href":"?bref=Neh.12.2","r":"Neh.12.2","rawR":"Neh.12.2","sourceRefs":[{"raw":"Neh.12.2","value":"Neh.12.2"}],"t":"ref","v":"Neh 12:2"},"). One of his descendants signed Ezra’s covenant of faithfulness to God (",{"href":"?bref=Neh.10.4","r":"Neh.10.4","rawR":"Neh.10.4","sourceRefs":[{"raw":"Neh.10.4","value":"Neh.10.4"}],"t":"ref","v":"Neh 10:4"},"). His name is omitted from ",{"href":"?bref=Neh.12.14","r":"Neh.12.14","rawR":"Neh.12.14","sourceRefs":[{"raw":"Neh.12.14","value":"Neh.12.14"}],"t":"ref","v":"Nehemiah 12:14"}," through scribal error."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Hattush","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 3:22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.3.22","rawQueryValue":"1Chr.3.22","sourceRefExact":"1Chr.3.22"},{"anchorText":"Ezr 8:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.8.3","rawQueryValue":"Ezra.8.3","sourceRefExact":"Ezra.8.3"},{"anchorText":"Neh 3:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.3.10","rawQueryValue":"Neh.3.10","sourceRefExact":"Neh.3.10"},{"anchorText":"Neh 12:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.12.2","rawQueryValue":"Neh.12.2","sourceRefExact":"Neh.12.2"},{"anchorText":"Neh 10:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.10.4","rawQueryValue":"Neh.10.4","sourceRefExact":"Neh.10.4"},{"anchorText":"Nehemiah 12:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.12.14","rawQueryValue":"Neh.12.14","sourceRefExact":"Neh.12.14"}],"sourceItemFragmentSha256":"6aa2014bb25e6cc0b0618de22e0f5ea24acfe27b3e42dd666bb6edc126ae86ef","sourceItemName":"Hattush","sourceItemOrder":163,"sourceMember":"Articles/H.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Hattush","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Hattush","title":"Hattush","version":"v2-a101d843a2f0cd3fc0c6"}