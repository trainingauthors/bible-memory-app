{"content":[{"c":["NEBO (P",{"c":["erson"],"sourceClass":"lc","t":"span"},")"],"sourceClass":"h1","t":"p"},{"c":["Forefather of 52 descendants who returned with Zerubbabel to Judah following the exile (",{"href":"?bref=Ezra.2.29","r":"Ezra.2.29","rawR":"Ezra.2.29","sourceRefs":[{"raw":"Ezra.2.29","value":"Ezra.2.29"}],"t":"ref","v":"Ezr 2:29"},"; ",{"href":"?bref=Neh.7.33","r":"Neh.7.33","rawR":"Neh.7.33","sourceRefs":[{"raw":"Neh.7.33","value":"Neh.7.33"}],"t":"ref","v":"Neh 7:33"},"), 7 of whom were encouraged by Ezra to divorce their foreign wives (",{"href":"?bref=Ezra.10.43","r":"Ezra.10.43","rawR":"Ezra.10.43","sourceRefs":[{"raw":"Ezra.10.43","value":"Ezra.10.43"}],"t":"ref","v":"Ezr 10:43"},"). Some suggest that Nebo refers to a town in Benjamin’s tribe from which some inhabitants went into exile to Babylon."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"NeboPerson","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ezr 2:29","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.2.29","rawQueryValue":"Ezra.2.29","sourceRefExact":"Ezra.2.29"},{"anchorText":"Neh 7:33","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.7.33","rawQueryValue":"Neh.7.33","sourceRefExact":"Neh.7.33"},{"anchorText":"Ezr 10:43","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.10.43","rawQueryValue":"Ezra.10.43","sourceRefExact":"Ezra.10.43"}],"sourceItemFragmentSha256":"0a0740ca8e7ebc5d89fd45884c985047cf709f5bb4e453361dc8efeda21a8e09","sourceItemName":"NeboPerson","sourceItemOrder":72,"sourceMember":"Articles/N.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"NeboPerson","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Nebo (Person)","title":"Nebo (Person)","version":"v2-a101d843a2f0cd3fc0c6"