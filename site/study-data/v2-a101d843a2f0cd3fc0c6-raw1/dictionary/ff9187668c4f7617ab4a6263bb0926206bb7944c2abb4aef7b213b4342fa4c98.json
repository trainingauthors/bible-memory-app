{"content":[{"c":["PAROSH"],"sourceClass":"h1","t":"p"},{"c":["Head of a family who returned to Jerusalem with Zerubbabel after the Babylonian exile (",{"href":"?bref=Ezra.2.3","r":"Ezra.2.3","rawR":"Ezra.2.3","sourceRefs":[{"raw":"Ezra.2.3","value":"Ezra.2.3"}],"t":"ref","v":"Ezr 2:3"},"; ",{"href":"?bref=Neh.7.8","r":"Neh.7.8","rawR":"Neh.7.8","sourceRefs":[{"raw":"Neh.7.8","value":"Neh.7.8"}],"t":"ref","v":"Neh 7:8"},"). One of his descendants, Pedaiah, participated in rebuilding the Jerusalem wall (",{"href":"?bref=Neh.3.25","r":"Neh.3.25","rawR":"Neh.3.25","sourceRefs":[{"raw":"Neh.3.25","value":"Neh.3.25"}],"t":"ref","v":"Neh 3:25"},"); other descendants are mentioned as having taken foreign wives (",{"href":"?bref=Ezra.10.25","r":"Ezra.10.25","rawR":"Ezra.10.25","sourceRefs":[{"raw":"Ezra.10.25","value":"Ezra.10.25"}],"t":"ref","v":"Ezr 10:25"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Parosh","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ezr 2:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.2.3","rawQueryValue":"Ezra.2.3","sourceRefExact":"Ezra.2.3"},{"anchorText":"Neh 7:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.7.8","rawQueryValue":"Neh.7.8","sourceRefExact":"Neh.7.8"},{"anchorText":"Neh 3:25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.3.25","rawQueryValue":"Neh.3.25","sourceRefExact":"Neh.3.25"},{"anchorText":"Ezr 10:25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.10.25","rawQueryValue":"Ezra.10.25","sourceRefExact":"Ezra.10.25"}],"sourceItemFragmentSha256":"2488f71c41a8177e579ef2401472f3195040e9b6747e8dc84b80ff9697359112","sourceItemName":"Parosh","sourceItemOrder":44,"sourceMember":"Articles/P.xml","supplementPointersNotIncludedAsContent":[]