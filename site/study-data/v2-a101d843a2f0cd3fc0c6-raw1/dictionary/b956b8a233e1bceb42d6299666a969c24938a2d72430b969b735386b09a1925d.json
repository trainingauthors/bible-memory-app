{"content":[{"c":["ANATH"],"sourceClass":"h1","t":"p"},{"c":["1. Parent of Shamgar, one of the judges of Israel (",{"href":"?bref=Judg.3.31","r":"Judg.3.31","rawR":"Judg.3.31","sourceRefs":[{"raw":"Judg.3.31","value":"Judg.3.31"}],"t":"ref","v":"Jgs 3:31"},"; ",{"href":"?bref=Judg.5.6","r":"Judg.5.6","rawR":"Judg.5.6","sourceRefs":[{"raw":"Judg.5.6","value":"Judg.5.6"}],"t":"ref","v":"5:6"},"). Since the name Anath is feminine, it is likely that Anath was Shamgar’s mother."],"sourceClass":"list","t":"p"},{"c":["2. Canaanite goddess of fertility. ",{"c":["See"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=CanaaniteDeitiesandReligion_Article_TyndaleOpenBibleDictionary","id":"CanaaniteDeitiesandReligion_Article_TyndaleOpenBibleDictionary","rawId":"CanaaniteDeitiesandReligion_Article_TyndaleOpenBibleDictionary","t":"link","v":"Canaanite Deities and Religion"},"."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Anath","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jgs 3:31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.3.31","rawQueryValue":"Judg.3.31","sourceRefExact":"Judg.3.31"},{"anchorText":"5:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.5.6","rawQueryValue":"Judg.5.6","sourceRefExact":"Judg.5.6"}],"sourceItemFragmentSha256":"de8536832f8f53ced7efca57a58cd0def747e271293375037d47eb337dd67b48","sourceItemName":"Anath","sourceItemOrder":337,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Anath","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Anath","title":"Anath","version":"v2-a101d843a2f0cd3fc0c6"}