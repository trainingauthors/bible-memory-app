{"content":[{"c":["KADMIEL"],"sourceClass":"h1","t":"p"},{"c":["Head of a Levite family who returned from the exile with Zerubbabel (",{"href":"?bref=Ezra.2.40","r":"Ezra.2.40","rawR":"Ezra.2.40","sourceRefs":[{"raw":"Ezra.2.40","value":"Ezra.2.40"}],"t":"ref","v":"Ezr 2:40"},"; ",{"href":"?bref=Neh.7.43","r":"Neh.7.43","rawR":"Neh.7.43","sourceRefs":[{"raw":"Neh.7.43","value":"Neh.7.43"}],"t":"ref","v":"Neh 7:43"},"; ",{"href":"?bref=Neh.12.8","r":"Neh.12.8","rawR":"Neh.12.8","sourceRefs":[{"raw":"Neh.12.8","value":"Neh.12.8"}],"t":"ref","v":"12:8"},"). His name appears in the list of those who supervised the temple rebuilding project (",{"href":"?bref=Ezra.3.9","r":"Ezra.3.9","rawR":"Ezra.3.9","sourceRefs":[{"raw":"Ezra.3.9","value":"Ezra.3.9"}],"t":"ref","v":"Ezr 3:9"},"), participated in sealing the covenant (",{"href":"?bref=Neh.10.9","r":"Neh.10.9","rawR":"Neh.10.9","sourceRefs":[{"raw":"Neh.10.9","value":"Neh.10.9"}],"t":"ref","v":"Neh 10:9"},"), and were prominent in the praise service (",{"href":"?bref=Neh.9.4-5","r":"Neh.9.4-5","rawR":"Neh.9.4-5","sourceRefs":[{"raw":"Neh.9.4-5","value":"Neh.9.4-5"}],"t":"ref","v":"9:4-5"},"; ",{"href":"?bref=Neh.12.24","r":"Neh.12.24","rawR":"Neh.12.24","sourceRefs":[{"raw":"Neh.12.24","value":"Neh.12.24"}],"t":"ref","v":"12:24"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Kadmiel","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ezr 2:40","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.2.40","rawQueryValue":"Ezra.2.40","sourceRefExact":"Ezra.2.40"},{"anchorText":"Neh 7:43","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.7.43","rawQueryValue":"Neh.7.43","sourceRefExact":"Neh.7.43"},{"anchorText":"12:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.12.8","rawQueryValue":"