{"content":[{"c":["ASRIEL, ASRIELITE"],"sourceClass":"h1","t":"p"},{"c":["Manasseh’s son (",{"href":"?bref=1Chr.7.14","r":"1Chr.7.14","rawR":"1Chr.7.14","sourceRefs":[{"raw":"1Chr.7.14","value":"1Chr.7.14"}],"t":"ref","v":"1 Chr 7:14"},"). His descendants, the Asrielites, were included in Moses’ census in the wilderness (",{"href":"?bref=Num.26.31","r":"Num.26.31","rawR":"Num.26.31","sourceRefs":[{"raw":"Num.26.31","value":"Num.26.31"}],"t":"ref","v":"Nm 26:31"},") and were later given a portion of the land allotted to Manasseh’s tribe (",{"href":"?bref=Josh.17.2","r":"Josh.17.2","rawR":"Josh.17.2","sourceRefs":[{"raw":"Josh.17.2","value":"Josh.17.2"}],"t":"ref","v":"Jos 17:2"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"AsrielAsrielite","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 7:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.7.14","rawQueryValue":"1Chr.7.14","sourceRefExact":"1Chr.7.14"},{"anchorText":"Nm 26:31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.26.31","rawQueryValue":"Num.26.31","sourceRefExact":"Num.26.31"},{"anchorText":"Jos 17:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.17.2","rawQueryValue":"Josh.17.2","sourceRefExact":"Josh.17.2"}],"sourceItemFragmentSha256":"82366566290b840712197f44c6979c9c915f2b48c8847533549d853582842e0e","sourceItemName":"AsrielAsrielite","sourceItemOrder":571,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"AsrielAsrielite","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Asriel, Asrielite","title":"Asriel, Asrielite","version":"v2-a101d843a2f0cd3fc0c6"}