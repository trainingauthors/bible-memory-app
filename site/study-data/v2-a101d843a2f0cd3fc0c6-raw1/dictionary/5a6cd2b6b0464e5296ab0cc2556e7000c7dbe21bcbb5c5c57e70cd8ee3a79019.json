eam","hrefExact":"?bref=1Sam.15.17-31","rawQueryValue":"1Sam.15.17-31","sourceRefExact":"1Sam.15.17-31"},{"anchorText":"2 Sm 19:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.19.15","rawQueryValue":"2Sam.19.15","sourceRefExact":"2Sam.19.15"},{"anchorText":"Hos 4:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Hos.4.15","rawQueryValue":"Hos.4.15","sourceRefExact":"Hos.4.15"},{"anchorText":"9:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Hos.9.15","rawQueryValue":"Hos.9.15","sourceRefExact":"Hos.9.15"},{"anchorText":"12:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Hos.12.11","rawQueryValue":"Hos.12.11","sourceRefExact":"Hos.12.11"},{"anchorText":"Am 4:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Amos.4.4","rawQueryValue":"Amos.4.4","sourceRefExact":"Amos.4.4"},{"anchorText":"5:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Amos.5.5","rawQueryValue":"Amos.5.5","sourceRefExact":"Amos.5.5"},{"anchorText":"Joshua 4:19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.4.19","rawQueryValue":"Josh.4.19","sourceRefExact":"Josh.4.19"},{"anchorText":"Dt 11:30","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.11.30","rawQueryValue":"Deut.11.30","sourceRefExact":"Deut.11.30"},{"anchorText":"Joshua 12:23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.12.23","rawQueryValue":"Josh.12.23","sourceRefExact":"Josh.12.23"},{"anchorText":"Jos 15:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.7","rawQueryValue":"Josh.15.7","sourceRefExact":"Josh.15.7"},{"anchorText":"Joshua 18:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.18.17","rawQueryValue":"Josh.18.17","sourceRefExact":"Josh.18.17"},{"anchorText":"2 Kgs 2:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.2.1","rawQueryValue":"2Kgs.2.1","sourceRefExact":"2Kgs.2.1"},{"anchorText":"4:38","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.4.38","rawQueryValue":"2Kgs.4.38","sourceRefExact":"2Kgs.4.38"}],"sourceItemFragmentSha256":"1afd5143d46526b286addf00ea30b1bd1e8d0a2818c969361dd431b795056d01","sourceItemName":"Gilgal","sourceItemOrder":144,"sourceMember":"Articles/G.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Gilgal","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Gilgal","title":"Gilgal","version":"v2-a101d843a2f0cd3fc0c6"}