{"content":[{"c":["LOIS"],"sourceClass":"h1","t":"p"},{"c":["Maternal grandmother of Timothy (",{"href":"?bref=2Tim.1.5","r":"2Tim.1.5","rawR":"2Tim.1.5","sourceRefs":[{"raw":"2Tim.1.5","value":"2Tim.1.5"}],"t":"ref","v":"2 Tm 1:5"},"), whose family, including Timothy’s mother, Eunice, lived at Lystra (",{"href":"?bref=Acts.16.1","r":"Acts.16.1","rawR":"Acts.16.1","sourceRefs":[{"raw":"Acts.16.1","value":"Acts.16.1"}],"t":"ref","v":"Acts 16:1"},"). Lois was a deeply committed Jew who probably converted to Christianity during Paul’s first missionary trip (ch ",{"href":"?bref=Acts.14.1-28","r":"Acts.14.1-28","rawR":"Acts.14.1-28","sourceRefs":[{"raw":"Acts.14.1-28","value":"Acts.14.1-28"}],"t":"ref","v":"14"},"). Paul comments that Timothy shared the faith of his grandmother and mother."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Lois","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Tm 1:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Tim.1.5","rawQueryValue":"2Tim.1.5","sourceRefExact":"2Tim.1.5"},{"anchorText":"Acts 16:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.16.1","rawQueryValue":"Acts.16.1","sourceRefExact":"Acts.16.1"},{"anchorText":"14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.14.1-28","rawQueryValue":"Acts.14.1-28","sourceRefExact":"Acts.14.1-28"}],"sourceItemFragmentSha256":"7050308a46d8800ee941f44be8dc886475ed327e374349f0ed936496503c11ee","sourceItemName":"Lois","sourceItemOrder":121,"sourceMember":"Articles/L.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Lois","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Lois","title":"Lois","version":"v2-a101d843a2f0cd3fc0c6"}