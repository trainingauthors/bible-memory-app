{"content":[{"c":["RABSARIS*"],"sourceClass":"h1","t":"p"},{"c":["Title of a high-ranking Assyrian and Babylonian court official, usually a eunuch and sometimes supervisor of the royal harem. A rabsaris was part of the Assyrian delegation (",{"href":"?bref=2Kgs.18.17","r":"2Kgs.18.17","rawR":"2Kgs.18.17","sourceRefs":[{"raw":"2Kgs.18.17","value":"2Kgs.18.17"}],"t":"ref","v":"2 Kgs 18:17"},"), a judge at the gate (",{"href":"?bref=Jer.39.3","r":"Jer.39.3","rawR":"Jer.39.3","sourceRefs":[{"raw":"Jer.39.3","value":"Jer.39.3"}],"t":"ref","v":"Jer 39:3"},"), the official who released Jeremiah from prison (v ",{"href":"?bref=Jer.39.13","r":"Jer.39.13","rawR":"Jer.39.13","sourceRefs":[{"raw":"Jer.39.13","value":"Jer.39.13"}],"t":"ref","v":"13"},"), and one of Nebuchadnezzar’s officials (",{"href":"?bref=Dan.1.3,7","r":"Dan.1.3,7","rawR":"Dan.1.3,7","sourceRefs":[{"raw":"Dan.1.3,7","value":"Dan.1.3,7"}],"t":"ref","v":"Dn 1:3, 7"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Rabsaris","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Kgs 18:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.18.17","rawQueryValue":"2Kgs.18.17","sourceRefExact":"2Kgs.18.17"},{"anchorText":"Jer 39:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.39.3","rawQueryValue":"Jer.39.3","sourceRefExact":"Jer.39.3"},{"anchorText":"13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.39.13","rawQueryValue":"Jer.39.13","sourceRefExact":"Jer.39.13"},{"anchorText":"Dn 1:3, 7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Dan.1.3,7","rawQueryValue":"Dan.1.3,7","sourceRefExact":"Dan.1.3,7"}],"sourceItemFragmentSha256":"05e620ababcdbd7d0a885ab553a9cc3d034071b44a4b5076d27ca850486f0aa9","sourceItemName":"Rabsaris","sourceItemO