{"content":[{"c":["ELIHOREPH"],"sourceClass":"h1","t":"p"},{"c":["Prominent official in the time of Solomon (",{"href":"?bref=1Kgs.4.3","r":"1Kgs.4.3","rawR":"1Kgs.4.3","sourceRefs":[{"raw":"1Kgs.4.3","value":"1Kgs.4.3"}],"t":"ref","v":"1 Kgs 4:3"},") who, with his brother Ahijah, was a royal secretary. Attempts to regard Elihoreph as the title of an official and not a personal name find no support in the Hebrew text."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Elihoreph","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Kgs 4:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.4.3","rawQueryValue":"1Kgs.4.3","sourceRefExact":"1Kgs.4.3"}],"sourceItemFragmentSha256":"1bb7af326e51e37939591ef05e4a432afe4735781e2cb2045876375aeca14609","sourceItemName":"Elihoreph","sourceItemOrder":100,"sourceMember":"Articles/E.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Elihoreph","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Elihoreph","title":"Elihoreph","version":"v2-a101d843a2f0cd3fc0c6"}