{"content":[{"c":["OUTCAST"],"sourceClass":"h1","t":"p"},{"c":["English translation of two related Hebrew terms whose primary meanings are to push away, banish, or cast out. In five of seven passages the term refers to exiles from Israel who are to be regathered by the Lord (",{"href":"?bref=Ps.147.2","r":"Ps.147.2","rawR":"Ps.147.2","sourceRefs":[{"raw":"Ps.147.2","value":"Ps.147.2"}],"t":"ref","v":"Ps 147:2"},"; ",{"href":"?bref=Isa.11.12","r":"Isa.11.12","rawR":"Isa.11.12","sourceRefs":[{"raw":"Isa.11.12","value":"Isa.11.12"}],"t":"ref","v":"Is 11:12"},"; ",{"href":"?bref=Isa.27.13","r":"Isa.27.13","rawR":"Isa.27.13","sourceRefs":[{"raw":"Isa.27.13","value":"Isa.27.13"}],"t":"ref","v":"27:13"},"; ",{"href":"?bref=Isa.56.8","r":"Isa.56.8","rawR":"Isa.56.8","sourceRefs":[{"raw":"Isa.56.8","value":"Isa.56.8"}],"t":"ref","v":"56:8"},"; ",{"href":"?bref=Jer.30.17","r":"Jer.30.17","rawR":"Jer.30.17","sourceRefs":[{"raw":"Jer.30.17","value":"Jer.30.17"}],"t":"ref","v":"Jer 30:17"},"). In two other passages it refers to fugitives from Moab (",{"href":"?bref=Isa.16.3-4","r":"Isa.16.3-4","rawR":"Isa.16.3-4","sourceRefs":[{"raw":"Isa.16.3-4","value":"Isa.16.3-4"}],"t":"ref","v":"Is 16:3-4"},") and from Elam (",{"href":"?bref=Jer.49.36","r":"Jer.49.36","rawR":"Jer.49.36","sourceRefs":[{"raw":"Jer.49.36","value":"Jer.49.36"}],"t":"ref","v":"Jer 49:36"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Outcast","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ps 147:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ps.147.2","rawQueryValue":"Ps.147.2","sourceRefExact":"Ps.147.2"},{"anchorText":"Is 11:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.11.12","rawQueryValue":"Isa.11.12","sourceRefExact":"Isa.11.12"},{"anchorText":"27:13","canonicalization":"deferred_to_dictio