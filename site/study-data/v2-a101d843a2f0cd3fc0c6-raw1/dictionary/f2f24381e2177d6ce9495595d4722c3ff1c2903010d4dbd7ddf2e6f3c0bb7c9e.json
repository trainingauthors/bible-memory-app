{"content":[{"c":["ANTIPATRIS"],"sourceClass":"h1","t":"p"},{"c":["City some 26 miles (41.8 kilometers) south of Caesarea rebuilt by Herod the Great in 9 ",{"c":["BC"],"sourceClass":"era","t":"span"}," in honor of his father, Antipater. Before its rebuilding, it was known as Aphek. Paul passed through Antipatris under Roman guard on his way from Jerusalem to Caesarea (",{"href":"?bref=Acts.23.31","r":"Acts.23.31","rawR":"Acts.23.31","sourceRefs":[{"raw":"Acts.23.31","value":"Acts.23.31"}],"t":"ref","v":"Acts 23:31"},"). Antipatris served as a Roman military relay station and marked the border between Judea and Samaria."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Aphek_Article_TyndaleOpenBibleDictionary","id":"Aphek_Article_TyndaleOpenBibleDictionary","rawId":"Aphek_Article_TyndaleOpenBibleDictionary","t":"link","v":"Aphek"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Antipatris","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Acts 23:31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.23.31","rawQueryValue":"Acts.23.31","sourceRefExact":"Acts.23.31"}],"sourceItemFragmentSha256":"3eb893d5e97d6eb569bb9710a44455b084d24fff708167fe596670b5d6cf1b84","sourceItemName":"Antipatris","sourceItemOrder":384,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Antipatris","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Antipatris","title":"Antipatris","version":"v2-a101d843a2f0cd3fc0c6"}