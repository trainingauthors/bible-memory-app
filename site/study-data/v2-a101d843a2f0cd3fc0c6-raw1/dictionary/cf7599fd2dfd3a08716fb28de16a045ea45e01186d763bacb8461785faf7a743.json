{"content":[{"c":["ANAB"],"sourceClass":"h1","t":"p"},{"c":["Town in the hill country of Hebron inhabited by giant warriors. After Joshua eliminated the giants (",{"href":"?bref=Josh.11.21","r":"Josh.11.21","rawR":"Josh.11.21","sourceRefs":[{"raw":"Josh.11.21","value":"Josh.11.21"}],"t":"ref","v":"Jos 11:21"},"), Anab was allotted to Judah’s tribe (",{"href":"?bref=Josh.15.50","r":"Josh.15.50","rawR":"Josh.15.50","sourceRefs":[{"raw":"Josh.15.50","value":"Josh.15.50"}],"t":"ref","v":"Jos 15:50"},"). Today Anab is known as Khirbet ‘Anab el-Kebireh."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Anab","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 11:21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.11.21","rawQueryValue":"Josh.11.21","sourceRefExact":"Josh.11.21"},{"anchorText":"Jos 15:50","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.50","rawQueryValue":"Josh.15.50","sourceRefExact":"Josh.15.50"}],"sourceItemFragmentSha256":"7b1894e2c279e0b10f00ae4819d3fe209dff6cc1f6b1366720cf1bb33ee5a092","sourceItemName":"Anab","sourceItemOrder":323,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Anab","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Anab","title":"Anab","version":"v2-a101d843a2f0cd3fc0c6"}