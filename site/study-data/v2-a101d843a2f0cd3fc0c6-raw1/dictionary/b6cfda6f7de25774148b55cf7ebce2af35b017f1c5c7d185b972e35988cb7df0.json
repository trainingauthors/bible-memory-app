stream","hrefExact":"?bref=Jer.7.31","rawQueryValue":"Jer.7.31","sourceRefExact":"Jer.7.31"},{"anchorText":"Second Chronicles 33:11-16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.33.11-16","rawQueryValue":"2Chr.33.11-16","sourceRefExact":"2Chr.33.11-16"},{"anchorText":"2 Kgs 21:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.21.18","rawQueryValue":"2Kgs.21.18","sourceRefExact":"2Kgs.21.18"},{"anchorText":"2 Chr 24:16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.24.16","rawQueryValue":"2Chr.24.16","sourceRefExact":"2Chr.24.16"},{"anchorText":"32:33","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.32.33","rawQueryValue":"2Chr.32.33","sourceRefExact":"2Chr.32.33"},{"anchorText":"2 Kgs 23:4-14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.23.4-14","rawQueryValue":"2Kgs.23.4-14","sourceRefExact":"2Kgs.23.4-14"},{"anchorText":"26-27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.23.26-27","rawQueryValue":"2Kgs.23.26-27","sourceRefExact":"2Kgs.23.26-27"},{"anchorText":"Ezr 10:30","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.10.30","rawQueryValue":"Ezra.10.30","sourceRefExact":"Ezra.10.30"},{"anchorText":"Ezr 10:33","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.10.33","rawQueryValue":"Ezra.10.33","sourceRefExact":"Ezra.10.33"}],"sourceItemFragmentSha256":"d98c8febcca6d16ad03ba82ee0b31c49d7bcbd5e5d3fc46f52018f8d0f16ef4f","sourceItemName":"ManassehPerson","sourceItemOrder":113,"sourceMember":"Articles/M.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"ManassehPerson","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Manasseh (Person)","title":"Manasseh (Person)","version":"v2-a101d843a2f0cd3fc0c6"}