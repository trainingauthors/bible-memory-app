{"content":[{"c":["HADID"],"sourceClass":"h1","t":"p"},{"c":["City in Benjamin (",{"href":"?bref=Neh.11.31-35","r":"Neh.11.31-35","rawR":"Neh.11.31-35","sourceRefs":[{"raw":"Neh.11.31-35","value":"Neh.11.31-35"}],"t":"ref","v":"Neh 11:31-35"},") mentioned with Lod and Ono (",{"href":"?bref=Ezra.2.33","r":"Ezra.2.33","rawR":"Ezra.2.33","sourceRefs":[{"raw":"Ezra.2.33","value":"Ezra.2.33"}],"t":"ref","v":"Ezr 2:33"},"; ",{"href":"?bref=Neh.7.37","r":"Neh.7.37","rawR":"Neh.7.37","sourceRefs":[{"raw":"Neh.7.37","value":"Neh.7.37"}],"t":"ref","v":"Neh 7:37"},") as the home of over 720 Benjamites returning from the Babylonian captivity (",{"href":"?bref=Neh.11.34","r":"Neh.11.34","rawR":"Neh.11.34","sourceRefs":[{"raw":"Neh.11.34","value":"Neh.11.34"}],"t":"ref","v":"Neh 11:34"},"). In ",{"href":"?bref=1Macc.12.38","r":"1Macc.12.38","rawR":"1Macc.12.38","sourceRefs":[{"raw":"1Macc.12.38","value":"1Macc.12.38"}],"t":"ref","v":"1 Maccabees 12:38"}," and ",{"href":"?bref=1Macc.13.13","r":"1Macc.13.13","rawR":"1Macc.13.13","sourceRefs":[{"raw":"1Macc.13.13","value":"1Macc.13.13"}],"t":"ref","v":"13:13"}," the place is identified with Adida, which was fortified by Simon Maccabeus and later by Vespasian. A more likely suggestion identifies it with the modern site of el-Haditheth, about three to four miles (4.8 to 6.4 kilometers) northeast of Lydda."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Hadid","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Neh 11:31-35","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.11.31-35","rawQueryValue":"Neh.11.31-35","sourceRefExact":"Neh.11.31-35"},{"anchorText":"Ezr 2:33","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.2.33","rawQueryValue":"Ezra.2.33","sourceRefExact":"Ezra.2.33"},{"anchorText":"Neh 7:37","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.7.37","rawQueryValue":"Neh.7.37","sourceRefExact":"Neh.7.37"},{"anchorText":"Neh 11:34","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.11.34","rawQueryValue":"Neh.11.34","sourceRefExact":"Neh.11.34"},{"anchorText":"1 Maccabees 12:38","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Macc.12.38","rawQueryValue":"1Macc.12.38","sourceRefExact":"1Macc.12.38"},{"anchorText":"13:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Macc.13.13","rawQueryValue":"1Macc.13.13","sourceRefExact":"1Macc.13.13"}],"sourceItemFragmentSha256":"4f106ecd16aaded08a827de9fd122aece2e18f092e2e1c2355807762efd39977","sourceItemName":"Hadid","sourceItemOrder":22,"sourceMember":"Articles/H.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Hadid","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Hadid","title":"Hadid","version":"v2-a101d843a2f0cd3fc0c6"}