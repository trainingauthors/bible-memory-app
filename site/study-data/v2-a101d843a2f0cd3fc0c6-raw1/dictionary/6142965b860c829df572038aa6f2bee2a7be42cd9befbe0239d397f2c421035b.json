{"content":[{"c":["CHAMBERLAIN*"],"sourceClass":"h1","t":"p"},{"c":["Originally, a royal official in charge of the private quarters of the king. They sometimes had other significant tasks and had great influence with those in authority (",{"href":"?bref=Acts.12.20","r":"Acts.12.20","rawR":"Acts.12.20","sourceRefs":[{"raw":"Acts.12.20","value":"Acts.12.20"}],"t":"ref","v":"Acts 12:20"},"). The chamberlain Erastus (",{"href":"?bref=Rom.16.23","r":"Rom.16.23","rawR":"Rom.16.23","sourceRefs":[{"raw":"Rom.16.23","value":"Rom.16.23"}],"t":"ref","v":"Rom 16:23"},", ",{"c":["kjv"],"sourceClass":"sc","t":"span"},") was actually the city treasurer. Nathan-melech the chamberlain (",{"href":"?bref=2Kgs.23.11","r":"2Kgs.23.11","rawR":"2Kgs.23.11","sourceRefs":[{"raw":"2Kgs.23.11","value":"2Kgs.23.11"}],"t":"ref","v":"2 Kgs 23:11"},") was a court official at the time of Josiah. The Persian kings used eunuchs as chamberlains (",{"href":"?bref=Esth.1.10,12,15","r":"Esth.1.10,12,15","rawR":"Esth.1.10,12,15","sourceRefs":[{"raw":"Esth.1.10,12,15","value":"Esth.1.10,12,15"}],"t":"ref","v":"Est 1:10, 12, 15"},"; ",{"href":"?bref=Esth.2.3,14-15","r":"Esth.2.3,14-15","rawR":"Esth.2.3,14-15","sourceRefs":[{"raw":"Esth.2.3,14-15","value":"Esth.2.3,14-15"}],"t":"ref","v":"2:3, 14-15"},"; ",{"href":"?bref=Esth.4.4-5","r":"Esth.4.4-5","rawR":"Esth.4.4-5","sourceRefs":[{"raw":"Esth.4.4-5","value":"Esth.4.4-5"}],"t":"ref","v":"4:4-5"},"; ",{"href":"?bref=Esth.6.2,14","r":"Esth.6.2,14","rawR":"Esth.6.2,14","sourceRefs":[{"raw":"Esth.6.2,14","value":"Esth.6.2,14"}],"t":"ref","v":"6:2, 14"},"; ",{"href":"?bref=Esth.7.9","r":"Esth.7.9","rawR":"Esth.7.9","sourceRefs":[{"raw":"Esth.7.9","value":"Esth.7.9"}],"t":"ref","v":"7:9"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Chamberlain","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Acts 12:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.12.20","rawQueryValue":"Acts.12.20","sourceRefExact":"Acts.12.20"},{"anchorText":"Rom 16:23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rom.16.23","rawQueryValue":"Rom.16.23","sourceRefExact":"Rom.16.23"},{"anchorText":"2 Kgs 23:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.23.11","rawQueryValue":"2Kgs.23.11","sourceRefExact":"2Kgs.23.11"},{"anchorText":"Est 1:10, 12, 15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Esth.1.10,12,15","rawQueryValue":"Esth.1.10,12,15","sourceRefExact":"Esth.1.10,12,15"},{"anchorText":"2:3, 14-15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Esth.2.3,14-15","rawQueryValue":"Esth.2.3,14-15","sourceRefExact":"Esth.2.3,14-15"},{"anchorText":"4:4-5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Esth.4.4-5","rawQueryValue":"Esth.4.4-5","sourceRefExact":"Esth.4.4-5"},{"anchorText":"6:2, 14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Esth.6.2,14","rawQueryValue":"Esth.6.2,14","sourceRefExact":"Esth.6.2,14"},{"anchorText":"7:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Esth.7.9","rawQueryValue":"Esth.7.9","sourceRefExact":"Esth.7.9"}],"sourceItemFragmentSha256":"5af9301b9cfd4a10bc970d75733718ccc10cc137da91966713a035662f162b15","sourceItemName":"Chamberlain","sourceItemOrder":98,"sourceMember":"Articles/C.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Chamberlain","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Chamberlain*","title":"Chamberlain*","version":"v2-a101d843a2f0cd3fc0c6"}