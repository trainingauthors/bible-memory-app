{"content":[{"c":["HAGGITH"],"sourceClass":"h1","t":"p"},{"c":["One of David’s wives and the mother of Adonijah (",{"href":"?bref=2Sam.3.4","r":"2Sam.3.4","rawR":"2Sam.3.4","sourceRefs":[{"raw":"2Sam.3.4","value":"2Sam.3.4"}],"t":"ref","v":"2 Sm 3:4"},"; ",{"href":"?bref=1Kgs.1.5,11","r":"1Kgs.1.5,11","rawR":"1Kgs.1.5,11","sourceRefs":[{"raw":"1Kgs.1.5,11","value":"1Kgs.1.5,11"}],"t":"ref","v":"1 Kgs 1:5, 11"},"; ",{"href":"?bref=1Kgs.2.13","r":"1Kgs.2.13","rawR":"1Kgs.2.13","sourceRefs":[{"raw":"1Kgs.2.13","value":"1Kgs.2.13"}],"t":"ref","v":"2:13"},"; ",{"href":"?bref=1Chr.3.2","r":"1Chr.3.2","rawR":"1Chr.3.2","sourceRefs":[{"raw":"1Chr.3.2","value":"1Chr.3.2"}],"t":"ref","v":"1 Chr 3:2"},"). She gave birth to Adonijah in Hebron while David maintained his capital there. In 2 Samuel she and her son are fourth in the list of David’s wives and sons."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Haggith","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Sm 3:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.3.4","rawQueryValue":"2Sam.3.4","sourceRefExact":"2Sam.3.4"},{"anchorText":"1 Kgs 1:5, 11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.1.5,11","rawQueryValue":"1Kgs.1.5,11","sourceRefExact":"1Kgs.1.5,11"},{"anchorText":"2:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.2.13","rawQueryValue":"1Kgs.2.13","sourceRefExact":"1Kgs.2.13"},{"anchorText":"1 Chr 3:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.3.2","rawQueryValue":"1Chr.3.2","sourceRefExact":"1Chr.3.2"}],"sourceItemFragmentSha256":"30d402f111027751d460fc0e7af7236459d4f47fc4402e97ee937b61bdf5df3b","sourceItemName":"Haggith","sourceItemOrder":39,"sourceMember":"Articles/H.xml","supplementPointersNotIncludedAsCont