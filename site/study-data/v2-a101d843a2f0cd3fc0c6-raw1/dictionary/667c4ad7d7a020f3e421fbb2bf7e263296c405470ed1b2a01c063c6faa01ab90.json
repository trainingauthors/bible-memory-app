{"content":[{"c":["ADIDA"],"sourceClass":"h1","t":"p"},{"c":["Town fortified by Simon Maccabeus (",{"href":"?bref=1Macc.12.38","r":"1Macc.12.38","rawR":"1Macc.12.38","sourceRefs":[{"raw":"1Macc.12.38","value":"1Macc.12.38"}],"t":"ref","v":"1 Macc 12:38"},"; ",{"href":"?bref=1Macc.13.13","r":"1Macc.13.13","rawR":"1Macc.13.13","sourceRefs":[{"raw":"1Macc.13.13","value":"1Macc.13.13"}],"t":"ref","v":"13:13"},"). Adida was in the foothills of southern Judea four miles (6.4 kilometers) east of Lydda between the Mediterranean coastal plain and the central highlands. It was probably identical with Hadid (",{"href":"?bref=Neh.11.34","r":"Neh.11.34","rawR":"Neh.11.34","sourceRefs":[{"raw":"Neh.11.34","value":"Neh.11.34"}],"t":"ref","v":"Neh 11:34"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Adida","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Macc 12:38","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Macc.12.38","rawQueryValue":"1Macc.12.38","sourceRefExact":"1Macc.12.38"},{"anchorText":"13:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Macc.13.13","rawQueryValue":"1Macc.13.13","sourceRefExact":"1Macc.13.13"},{"anchorText":"Neh 11:34","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.11.34","rawQueryValue":"Neh.11.34","sourceRefExact":"Neh.11.34"}],"sourceItemFragmentSha256":"fb8ad39b6aac6bec308c0c384ba074081de7476fd951557d4fbb2b7cc57e8035","sourceItemName":"Adida","sourceItemOrder":117,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Adida","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Adida","title":"Adida","version":"v2-a101d843a2f0cd3fc0c6"}