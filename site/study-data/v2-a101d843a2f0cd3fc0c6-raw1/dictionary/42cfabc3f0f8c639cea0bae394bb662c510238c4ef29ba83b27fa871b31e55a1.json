{"content":[{"c":["ARIOCH"],"sourceClass":"h1","t":"p"},{"c":["1. King of Ellasar, who with three other kings captured five cities and took a number of prisoners, including Abraham’s nephew Lot (",{"href":"?bref=Gen.14.1-16","r":"Gen.14.1-16","rawR":"Gen.14.1-16","sourceRefs":[{"raw":"Gen.14.1-16","value":"Gen.14.1-16"}],"t":"ref","v":"Gn 14:1-16"},")."],"sourceClass":"list","t":"p"},{"c":["2. Nebuchadnezzar’s captain of the guard (",{"c":["kjv"],"sourceClass":"sc","t":"span"},") or chief executioner, who took Daniel to the Babylonian king to interpret his dream (",{"href":"?bref=Dan.2.14-25","r":"Dan.2.14-25","rawR":"Dan.2.14-25","sourceRefs":[{"raw":"Dan.2.14-25","value":"Dan.2.14-25"}],"t":"ref","v":"Dn 2:14-25"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Arioch","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 14:1-16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.14.1-16","rawQueryValue":"Gen.14.1-16","sourceRefExact":"Gen.14.1-16"},{"anchorText":"Dn 2:14-25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Dan.2.14-25","rawQueryValue":"Dan.2.14-25","sourceRefExact":"Dan.2.14-25"}],"sourceItemFragmentSha256":"b1af1ed2daf8f3d1be373afc5e7ee1f731640ec8487ca78a5afb5077e3b3440c","sourceItemName":"Arioch","sourceItemOrder":480,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Arioch","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Arioch","title":"Arioch","version":"v2-a101d843a2f0cd3fc0c6"}