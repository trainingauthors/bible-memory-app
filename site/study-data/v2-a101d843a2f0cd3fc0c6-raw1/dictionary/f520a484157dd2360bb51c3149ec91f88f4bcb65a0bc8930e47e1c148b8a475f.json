{"content":[{"c":["METHEG-AMMAH*"],"sourceClass":"h1","t":"p"},{"c":["Place (whose name means “Bridle of the Mother City”) conquered by David (",{"href":"?bref=2Sam.8.1","r":"2Sam.8.1","rawR":"2Sam.8.1","sourceRefs":[{"raw":"2Sam.8.1","value":"2Sam.8.1"}],"t":"ref","v":"2 Sm 8:1"},", ",{"c":["nlt"],"sourceClass":"sc","t":"span"}," mg). Most likely it refers to the Philistine capital, Gath (",{"href":"?bref=1Chr.18.1","r":"1Chr.18.1","rawR":"1Chr.18.1","sourceRefs":[{"raw":"1Chr.18.1","value":"1Chr.18.1"}],"t":"ref","v":"1 Chr 18:1"},"). The capital city was often referred to as the “mother” city, and surrounding cities as “daughters”; the “bridle” represented control or authority."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"MethegAmmah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Sm 8:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.8.1","rawQueryValue":"2Sam.8.1","sourceRefExact":"2Sam.8.1"},{"anchorText":"1 Chr 18:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.18.1","rawQueryValue":"1Chr.18.1","sourceRefExact":"1Chr.18.1"}],"sourceItemFragmentSha256":"d0c2faa7c5876d5cdc833a8d275fc1b2fbd132c21d95210f313340d61e00ebd7","sourceItemName":"MethegAmmah","sourceItemOrder":286,"sourceMember":"Articles/M.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"MethegAmmah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Metheg-Ammah*","title":"Metheg-Ammah*","version":"v2-a101d843a2f0cd3fc0c6"}