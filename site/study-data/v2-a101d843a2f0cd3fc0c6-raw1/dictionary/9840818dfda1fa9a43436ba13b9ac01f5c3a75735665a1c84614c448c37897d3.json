tent":[]},"sourceAttributes":{"name":"JeshuaPerson","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Jeshua (Person)","title":"Jeshua (Person)","version":"v2-a101d843a2f0cd3fc0c6"}