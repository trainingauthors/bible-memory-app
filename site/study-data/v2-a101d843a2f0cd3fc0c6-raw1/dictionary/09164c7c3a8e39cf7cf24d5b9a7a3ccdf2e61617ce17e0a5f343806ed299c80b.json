{"content":[{"c":["EBED-MELECH"],"sourceClass":"h1","t":"p"},{"c":["Ethiopian eunuch in King Zedekiah’s court. He secured the king’s permission to rescue the prophet Jeremiah out of a cistern where he had been thrown to die (",{"href":"?bref=Jer.38.6-13","r":"Jer.38.6-13","rawR":"Jer.38.6-13","sourceRefs":[{"raw":"Jer.38.6-13","value":"Jer.38.6-13"}],"t":"ref","v":"Jer 38:6-13"},"). For this righteous act, Ebed-melech was promised God’s safety at the fall of Jerusalem (",{"href":"?bref=Jer.39.16","r":"Jer.39.16","rawR":"Jer.39.16","sourceRefs":[{"raw":"Jer.39.16","value":"Jer.39.16"}],"t":"ref","v":"39:16"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"EbedMelech","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jer 38:6-13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.38.6-13","rawQueryValue":"Jer.38.6-13","sourceRefExact":"Jer.38.6-13"},{"anchorText":"39:16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.39.16","rawQueryValue":"Jer.39.16","sourceRefExact":"Jer.39.16"}],"sourceItemFragmentSha256":"74b8f7ad38400a2448a79068d673387efbb351aefca8c12756a26455f6cd0f10","sourceItemName":"EbedMelech","sourceItemOrder":15,"sourceMember":"Articles/E.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"EbedMelech","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Ebed-Melech","title":"Ebed-Melech","version":"v2-a101d843a2f0cd3fc0c6"}