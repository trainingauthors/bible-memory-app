{"content":[{"c":["KEPHIRAH"],"sourceClass":"h1","t":"p"},{"c":["Hivite city included in a treaty with Joshua that the Gibeonites secured by deception (",{"href":"?bref=Josh.9.17","r":"Josh.9.17","rawR":"Josh.9.17","sourceRefs":[{"raw":"Josh.9.17","value":"Josh.9.17"}],"t":"ref","v":"Jos 9:17"},"). When the Israelites conquered the land of Canaan, Kephirah became the property of Benjamin’s tribe (",{"href":"?bref=Josh.18.26","r":"Josh.18.26","rawR":"Josh.18.26","sourceRefs":[{"raw":"Josh.18.26","value":"Josh.18.26"}],"t":"ref","v":"18:26"},"). Many inhabitants of this city came back to Judea with the repatriates after the exile (",{"href":"?bref=Ezra.2.25","r":"Ezra.2.25","rawR":"Ezra.2.25","sourceRefs":[{"raw":"Ezra.2.25","value":"Ezra.2.25"}],"t":"ref","v":"Ezr 2:25"},"; ",{"href":"?bref=Neh.7.29","r":"Neh.7.29","rawR":"Neh.7.29","sourceRefs":[{"raw":"Neh.7.29","value":"Neh.7.29"}],"t":"ref","v":"Neh 7:29"},"). The site is now identified as Khirbet Kefireh, located southwest of ancient Gibeon."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Kephirah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 9:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.9.17","rawQueryValue":"Josh.9.17","sourceRefExact":"Josh.9.17"},{"anchorText":"18:26","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.18.26","rawQueryValue":"Josh.18.26","sourceRefExact":"Josh.18.26"},{"anchorText":"Ezr 2:25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.2.25","rawQueryValue":"Ezra.2.25","sourceRefExact":"Ezra.2.25"},{"anchorText":"Neh 7:29","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.7.29","rawQueryValue":"Neh.7.29","sourceRefExact":"Neh.7.29"}],"sourceItemFragmentSha256":"24b6fa3fab1f5df43e8d5cc1afb730935955ddd3efd70c99dd34c32168d8ecd6","sourceItemName":"Kephirah","sourceItemOrder":46,"sourceMember":"Articles/K.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Kephirah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Kephirah","title":"Kephirah","version":"v2-a101d843a2f0cd3fc0c6"}