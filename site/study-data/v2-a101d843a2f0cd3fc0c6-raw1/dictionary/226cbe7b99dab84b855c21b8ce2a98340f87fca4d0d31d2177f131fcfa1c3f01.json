{"content":[{"c":["CARPUS"],"sourceClass":"h1","t":"p"},{"c":["Man with whom the apostle Paul left his cloak at Troas. Paul instructed Timothy to bring it when he came to see him in prison (",{"href":"?bref=2Tim.4.13","r":"2Tim.4.13","rawR":"2Tim.4.13","sourceRefs":[{"raw":"2Tim.4.13","value":"2Tim.4.13"}],"t":"ref","v":"2 Tm 4:13"},"). Carpus was possibly one of Paul’s converts. According to tradition, Carpus became bishop of Berytus at Thrace."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Carpus","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Tm 4:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Tim.4.13","rawQueryValue":"2Tim.4.13","sourceRefExact":"2Tim.4.13"}],"sourceItemFragmentSha256":"5cae3aa9fe03f17736199bced25b3e3186b9ab32d31480f8876d1eda287da4cb","sourceItemName":"Carpus","sourceItemOrder":64,"sourceMember":"Articles/C.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Carpus","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Carpus","title":"Carpus","version":"v2-a101d843a2f0cd3fc0c6"}