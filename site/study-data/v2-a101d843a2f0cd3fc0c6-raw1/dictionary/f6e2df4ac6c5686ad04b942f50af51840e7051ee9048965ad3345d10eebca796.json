{"content":[{"c":["ARCHEVITES*"],"sourceClass":"h1","t":"p"},{"c":["KJV translation for the inhabitants of Erech (Uruk) in southern Babylonia who were transported to Samaria by Asnappar, the Assyrian King Ashurbanipal (",{"href":"?bref=Ezra.4.9-10","r":"Ezra.4.9-10","rawR":"Ezra.4.9-10","sourceRefs":[{"raw":"Ezra.4.9-10","value":"Ezra.4.9-10"}],"t":"ref","v":"Ezr 4:9-10"},"). The Archevites were among the local residents who wrote to Artaxerxes of Persia, opposing the rebuilding of Jerusalem by the Jews who had returned from exile (",{"href":"?bref=Ezra.4.7-16","r":"Ezra.4.7-16","rawR":"Ezra.4.7-16","sourceRefs":[{"raw":"Ezra.4.7-16","value":"Ezra.4.7-16"}],"t":"ref","v":"Ezr 4:7-16"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Archevites","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ezr 4:9-10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.4.9-10","rawQueryValue":"Ezra.4.9-10","sourceRefExact":"Ezra.4.9-10"},{"anchorText":"Ezr 4:7-16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.4.7-16","rawQueryValue":"Ezra.4.7-16","sourceRefExact":"Ezra.4.7-16"}],"sourceItemFragmentSha256":"97514eefd8d9741e95564ae9ca152ac57da51154c2ada25c504a85bc754ef6ac","sourceItemName":"Archevites","sourceItemOrder":459,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Archevites","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Archevites*","title":"Archevites*","version":"v2-a101d843a2f0cd3fc0c6"}