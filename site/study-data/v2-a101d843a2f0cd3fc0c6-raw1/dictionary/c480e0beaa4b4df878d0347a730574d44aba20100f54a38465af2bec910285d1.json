nicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.36.1-43","rawQueryValue":"Gen.36.1-43","sourceRefExact":"Gen.36.1-43"},{"anchorText":"Gn 37:27-28, 36","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.37.27-28,36","rawQueryValue":"Gen.37.27-28,36","sourceRefExact":"Gen.37.27-28,36"},{"anchorText":"Gn 36:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.36.2","rawQueryValue":"Gen.36.2","sourceRefExact":"Gen.36.2"},{"anchorText":"Gn 34:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.34.2","rawQueryValue":"Gen.34.2","sourceRefExact":"Gen.34.2"},{"anchorText":"Jos 9:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.9.7","rawQueryValue":"Josh.9.7","sourceRefExact":"Josh.9.7"},{"anchorText":"Jgs 3:3-8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.3.3-8","rawQueryValue":"Judg.3.3-8","sourceRefExact":"Judg.3.3-8"},{"anchorText":"2 Sm 24:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.24.7","rawQueryValue":"2Sam.24.7","sourceRefExact":"2Sam.24.7"},{"anchorText":"1 Kgs 9:20-21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.9.20-21","rawQueryValue":"1Kgs.9.20-21","sourceRefExact":"1Kgs.9.20-21"},{"anchorText":"2 Chr 8:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.8.7","rawQueryValue":"2Chr.8.7","sourceRefExact":"2Chr.8.7"}],"sourceItemFragmentSha256":"5a44106056acb2d45ed7b7997489a9a5c24410561b33d39a116df84f88c7768d","sourceItemName":"Hivites","sourceItemOrder":308,"sourceMember":"Articles/H.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Hivites","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Hivites","title":"Hivites","version":"v2-a101d843a2f0cd3fc0c6"}