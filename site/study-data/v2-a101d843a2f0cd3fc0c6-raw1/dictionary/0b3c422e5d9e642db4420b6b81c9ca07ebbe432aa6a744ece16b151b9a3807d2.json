{"content":[{"c":["GATEKEEPERS"],"sourceClass":"h1","t":"p"},{"c":["Those who guarded gates of the cities and doors of palaces, temples, and other large buildings. Their task was to admit or reject visitors (",{"href":"?bref=2Kgs.7.10-11","r":"2Kgs.7.10-11","rawR":"2Kgs.7.10-11","sourceRefs":[{"raw":"2Kgs.7.10-11","value":"2Kgs.7.10-11"}],"t":"ref","v":"2 Kgs 7:10-11"},"; ",{"href":"?bref=2Kgs.11.4-9","r":"2Kgs.11.4-9","rawR":"2Kgs.11.4-9","sourceRefs":[{"raw":"2Kgs.11.4-9","value":"2Kgs.11.4-9"}],"t":"ref","v":"11:4-9"},"). In the Bible these men are variously named as gatekeepers, porters, doorkeepers, and guards."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Gatekeepers","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Kgs 7:10-11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.7.10-11","rawQueryValue":"2Kgs.7.10-11","sourceRefExact":"2Kgs.7.10-11"},{"anchorText":"11:4-9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.11.4-9","rawQueryValue":"2Kgs.11.4-9","sourceRefExact":"2Kgs.11.4-9"}],"sourceItemFragmentSha256":"2ced26d381689299ad7d230b50c8ed0b5bab12f00824e49c7305f56747a963a2","sourceItemName":"Gatekeepers","sourceItemOrder":51,"sourceMember":"Articles/G.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Gatekeepers","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Gatekeepers","title":"Gatekeepers","version":"v2-a101d843a2f0cd3fc0c6"}