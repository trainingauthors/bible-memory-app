{"content":[{"c":["ERAN"],"sourceClass":"h1","t":"p"},{"c":["Grandson of Ephraim and the oldest son of Shuthelah (",{"href":"?bref=Num.26.36","r":"Num.26.36","rawR":"Num.26.36","sourceRefs":[{"raw":"Num.26.36","value":"Num.26.36"}],"t":"ref","v":"Nm 26:36"},"), from whom came the Eranite family. In ",{"href":"?bref=1Chr.7.20","r":"1Chr.7.20","rawR":"1Chr.7.20","sourceRefs":[{"raw":"1Chr.7.20","value":"1Chr.7.20"}],"t":"ref","v":"1 Chronicles 7:20"},", Eran was replaced by Eleadah, which may be a copyist’s error."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Eran","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Nm 26:36","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.26.36","rawQueryValue":"Num.26.36","sourceRefExact":"Num.26.36"},{"anchorText":"1 Chronicles 7:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.7.20","rawQueryValue":"1Chr.7.20","sourceRefExact":"1Chr.7.20"}],"sourceItemFragmentSha256":"efa16b1856e4eec84f081041fcd7c78297ee62d7093a9faed5d4b7dcd081f6eb","sourceItemName":"Eran","sourceItemOrder":223,"sourceMember":"Articles/E.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Eran","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Eran","title":"Eran","version":"v2-a101d843a2f0cd3fc0c6"}