{"content":[{"c":["ANAIAH"],"sourceClass":"h1","t":"p"},{"c":["1. Priest and assistant of Ezra who explained to the people passages from the law read by Ezra (",{"href":"?bref=Neh.8.4","r":"Neh.8.4","rawR":"Neh.8.4","sourceRefs":[{"raw":"Neh.8.4","value":"Neh.8.4"}],"t":"ref","v":"Neh 8:4"},")."],"sourceClass":"list","t":"p"},{"c":["2. Political leader who signed Ezra’s covenant of faithfulness to God with Nehemiah and others after the exile (",{"href":"?bref=Neh.10.22","r":"Neh.10.22","rawR":"Neh.10.22","sourceRefs":[{"raw":"Neh.10.22","value":"Neh.10.22"}],"t":"ref","v":"Neh 10:22"},"). He is perhaps identical with #1 above."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Anaiah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Neh 8:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.8.4","rawQueryValue":"Neh.8.4","sourceRefExact":"Neh.8.4"},{"anchorText":"Neh 10:22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.10.22","rawQueryValue":"Neh.10.22","sourceRefExact":"Neh.10.22"}],"sourceItemFragmentSha256":"efe5c69d98ebe661b9193a9c8819d599fbbf9a7ec4c4390e07c45a3073c7dd5f","sourceItemName":"Anaiah","sourceItemOrder":327,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Anaiah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Anaiah","title":"Anaiah","version":"v2-a101d843a2f0cd3fc0c6"}