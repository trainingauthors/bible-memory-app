{"content":[{"c":["HENA"],"sourceClass":"h1","t":"p"},{"c":["One of the six cities that the rabshakeh boasted fell before the armies of Sennacherib, in spite of their gods (",{"href":"?bref=2Kgs.18.34","r":"2Kgs.18.34","rawR":"2Kgs.18.34","sourceRefs":[{"raw":"2Kgs.18.34","value":"2Kgs.18.34"}],"t":"ref","v":"2 Kgs 18:34"},"). Rabshakeh hoped the example of these cities would strike fear in King Hezekiah’s heart and make him doubt the Lord’s deliverance as the same hordes surrounded Jerusalem. The kings of the five other cities are mentioned along with Hena again in ",{"href":"?bref=2Kgs.19.13","r":"2Kgs.19.13","rawR":"2Kgs.19.13","sourceRefs":[{"raw":"2Kgs.19.13","value":"2Kgs.19.13"}],"t":"ref","v":"2 Kings 19:13"}," and ",{"href":"?bref=Isa.37.13","r":"Isa.37.13","rawR":"Isa.37.13","sourceRefs":[{"raw":"Isa.37.13","value":"Isa.37.13"}],"t":"ref","v":"Isaiah 37:13"},"."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Hena","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Kgs 18:34","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.18.34","rawQueryValue":"2Kgs.18.34","sourceRefExact":"2Kgs.18.34"},{"anchorText":"2 Kings 19:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.19.13","rawQueryValue":"2Kgs.19.13","sourceRefExact":"2Kgs.19.13"},{"anchorText":"Isaiah 37:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.37.13","rawQueryValue":"Isa.37.13","sourceRefExact":"Isa.37.13"}],"sourceItemFragmentSha256":"8ecb0f68f882491ede8c5bce68b740900e3f7c905eff55ee15dffa5a9c90ae7e","sourceItemName":"Hena","sourceItemOrder":247,"sourceMember":"Articles/H.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Hena","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Hena","title":"Hena","version":"v2-a101d843a2f0cd3fc0c6"}