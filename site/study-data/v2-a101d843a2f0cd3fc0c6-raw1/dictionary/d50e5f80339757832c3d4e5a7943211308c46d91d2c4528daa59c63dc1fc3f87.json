{"content":[{"c":["ZIBEON"],"sourceClass":"h1","t":"p"},{"c":["Ancestor of Oholibamah, the Canaanite wife of Esau (",{"href":"?bref=Gen.36.2,14","r":"Gen.36.2,14","rawR":"Gen.36.2,14","sourceRefs":[{"raw":"Gen.36.2,14","value":"Gen.36.2,14"}],"t":"ref","v":"Gn 36:2, 14"},"). He is listed as a Hivite in ",{"href":"?bref=Gen.36.2","r":"Gen.36.2","rawR":"Gen.36.2","sourceRefs":[{"raw":"Gen.36.2","value":"Gen.36.2"}],"t":"ref","v":"Genesis 36:2"}," but is probably the same as Zibeon the son of Seir the Horite (",{"href":"?bref=Gen.36.20,29","r":"Gen.36.20,29","rawR":"Gen.36.20,29","sourceRefs":[{"raw":"Gen.36.20,29","value":"Gen.36.20,29"}],"t":"ref","v":"Gn 36:20, 29"},"; ",{"href":"?bref=1Chr.1.38","r":"1Chr.1.38","rawR":"1Chr.1.38","sourceRefs":[{"raw":"1Chr.1.38","value":"1Chr.1.38"}],"t":"ref","v":"1 Chr 1:38"},"). Possibly “Hivite” designated his tribal affiliation, while “Horite” indicated the fact that he dwelt in caves. It is also possible that “Hivite” is a transmission error in ",{"href":"?bref=Gen.36.2","r":"Gen.36.2","rawR":"Gen.36.2","sourceRefs":[{"raw":"Gen.36.2","value":"Gen.36.2"}],"t":"ref","v":"Genesis 36:2"},"."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Zibeon","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 36:2, 14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.36.2,14","rawQueryValue":"Gen.36.2,14","sourceRefExact":"Gen.36.2,14"},{"anchorText":"Genesis 36:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.36.2","rawQueryValue":"Gen.36.2","sourceRefExact":"Gen.36.2"},{"anchorText":"Gn 36:20, 29","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.36.20,29","rawQueryValue":"Gen.36.20,29","sourceRefExact":"Gen.36.20,29"},{"anchorText":"1 Chr 1:38","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.1.38","rawQueryValue":"1Chr.1.38","sourceRefExact":"1Chr.1.38"},{"anchorText":"Genesis 36:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.36.2","rawQueryValue":"Gen.36.2","sourceRefExact":"Gen.36.2"}],"sourceItemFragmentSha256":"ae11eb29d8bdadb29caf91955350c3fc04687b9054b7c6c1cbbdb1380c03a17b","sourceItemName":"Zibeon","sourceItemOrder":104,"sourceMember":"Articles/Z.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Zibeon","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Zibeon","title":"Zibeon","version":"v2-a101d843a2f0cd3fc0c6"}