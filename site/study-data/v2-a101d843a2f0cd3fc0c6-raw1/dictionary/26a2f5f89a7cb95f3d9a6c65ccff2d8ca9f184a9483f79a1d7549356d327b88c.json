{"content":[{"c":["SHEPHI*, SHEPHO"],"sourceClass":"h1","t":"p"},{"c":["One of Shobal’s five sons and a descendant of Seir the Horite. Shepho is listed in the genealogy of Abraham through Esau’s contact with the nation (",{"href":"?bref=Gen.36.23","r":"Gen.36.23","rawR":"Gen.36.23","sourceRefs":[{"raw":"Gen.36.23","value":"Gen.36.23"}],"t":"ref","v":"Gn 36:23"},"); his name is alternately spelled Shephi (",{"href":"?bref=1Chr.1.40","r":"1Chr.1.40","rawR":"1Chr.1.40","sourceRefs":[{"raw":"1Chr.1.40","value":"1Chr.1.40"}],"t":"ref","v":"1 Chr 1:40"},"; see ",{"c":["nlt"],"sourceClass":"sc","t":"span"}," mg)."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"ShephiShepho","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 36:23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.36.23","rawQueryValue":"Gen.36.23","sourceRefExact":"Gen.36.23"},{"anchorText":"1 Chr 1:40","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.1.40","rawQueryValue":"1Chr.1.40","sourceRefExact":"1Chr.1.40"}],"sourceItemFragmentSha256":"33ba8a8a3a96ba4bdc9b2419a790b3f55cc35d461c1a5ad83a2586ba1cf9647f","sourceItemName":"ShephiShepho","sourceItemOrder":293,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"ShephiShepho","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Shephi*, Shepho","title":"Shephi*, Shepho","version":"v2-a101d843a2f0cd3fc0c6"}