{"content":[{"c":["OBOTH"],"sourceClass":"h1","t":"p"},{"c":["Temporary camping place of the Israelites during their wilderness wanderings, mentioned between Punon and Iye-abarim (",{"href":"?bref=Num.21.10-11","r":"Num.21.10-11","rawR":"Num.21.10-11","sourceRefs":[{"raw":"Num.21.10-11","value":"Num.21.10-11"}],"t":"ref","v":"Nm 21:10-11"},"; ",{"href":"?bref=Num.33.43-44","r":"Num.33.43-44","rawR":"Num.33.43-44","sourceRefs":[{"raw":"Num.33.43-44","value":"Num.33.43-44"}],"t":"ref","v":"33:43-44"},"). Although its exact location is uncertain, some have attempted to identify it with ‘Ain el-Weiba, 33 miles (53.1 kilometers) south of the Dead Sea in the Arabah Valley. ",{"c":["See"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=WildernessWanderings_Article_TyndaleOpenBibleDictionary","id":"WildernessWanderings_Article_TyndaleOpenBibleDictionary","rawId":"WildernessWanderings_Article_TyndaleOpenBibleDictionary","t":"link","v":"Wilderness Wanderings"},"."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Oboth","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Nm 21:10-11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.21.10-11","rawQueryValue":"Num.21.10-11","sourceRefExact":"Num.21.10-11"},{"anchorText":"33:43-44","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.33.43-44","rawQueryValue":"Num.33.43-44","sourceRefExact":"Num.33.43-44"}],"sourceItemFragmentSha256":"760c465d3ce30b3cb9dea9b859e8654c5e581b74b42db928d591e832f0f495e7","sourceItemName":"Oboth","sourceItemOrder":17,"sourceMember":"Articles/O.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Oboth","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Oboth","title":"Oboth","version":"v2-a101d843a2f0cd3fc0c6"}