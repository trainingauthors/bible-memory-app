{"content":[{"c":["JUTTAH"],"sourceClass":"h1","t":"p"},{"c":["One of the cities of refuge assigned to Aaron’s descendants (",{"href":"?bref=Josh.21.16","r":"Josh.21.16","rawR":"Josh.21.16","sourceRefs":[{"raw":"Josh.21.16","value":"Josh.21.16"}],"t":"ref","v":"Jos 21:16"},"). It was in the hill country of Judah’s territory and in the district of Maon (",{"href":"?bref=Josh.15.55","r":"Josh.15.55","rawR":"Josh.15.55","sourceRefs":[{"raw":"Josh.15.55","value":"Josh.15.55"}],"t":"ref","v":"15:55"},"). It has been identified with modern Yatta, about five and a half miles (8.8 kilometers) southwest of Hebron."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=CitiesofRefuge_Article_TyndaleOpenBibleDictionary","id":"CitiesofRefuge_Article_TyndaleOpenBibleDictionary","rawId":"CitiesofRefuge_Article_TyndaleOpenBibleDictionary","t":"link","v":"Cities of Refuge"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Juttah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 21:16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.21.16","rawQueryValue":"Josh.21.16","sourceRefExact":"Josh.21.16"},{"anchorText":"15:55","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.55","rawQueryValue":"Josh.15.55","sourceRefExact":"Josh.15.55"}],"sourceItemFragmentSha256":"67402c3377dbbfaf80ef2498addcc0f8397b8deab499a83605b0784a1006473b","sourceItemName":"Juttah","sourceItemOrder":378,"sourceMember":"Articles/J.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Juttah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Juttah","title":"Juttah","version":"v2-a101d843a2f0cd3fc0c6"}