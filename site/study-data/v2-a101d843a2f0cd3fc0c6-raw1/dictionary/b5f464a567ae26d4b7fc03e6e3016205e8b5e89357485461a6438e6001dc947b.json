{"content":[{"c":["NEARIAH"],"sourceClass":"h1","t":"p"},{"c":["1. One of Shemaiah’s six sons and a descendant of David (",{"href":"?bref=1Chr.3.22-23","r":"1Chr.3.22-23","rawR":"1Chr.3.22-23","sourceRefs":[{"raw":"1Chr.3.22-23","value":"1Chr.3.22-23"}],"t":"ref","v":"1 Chr 3:22-23"},")."],"sourceClass":"list","t":"p"},{"c":["2. Captain of 500 men of Simeon’s tribe who went to Mt Seir, where they destroyed the remnant of the Amalekites and settled their own people in Hezekiah’s time (",{"href":"?bref=1Chr.4.42","r":"1Chr.4.42","rawR":"1Chr.4.42","sourceRefs":[{"raw":"1Chr.4.42","value":"1Chr.4.42"}],"t":"ref","v":"1 Chr 4:42"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Neariah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 3:22-23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.3.22-23","rawQueryValue":"1Chr.3.22-23","sourceRefExact":"1Chr.3.22-23"},{"anchorText":"1 Chr 4:42","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.4.42","rawQueryValue":"1Chr.4.42","sourceRefExact":"1Chr.4.42"}],"sourceItemFragmentSha256":"0b35b91386fcea22b89805b9be779d682a9bb984eca2d30544ebf0e017e7b6a2","sourceItemName":"Neariah","sourceItemOrder":66,"sourceMember":"Articles/N.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Neariah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Neariah","title":"Neariah","version":"v2-a101d843a2f0cd3fc0c6"}