{"content":[{"c":["KEDEMOTH"],"sourceClass":"h1","t":"p"},{"c":["City east of the Jordan, probably located on the upper course of the Arnon River. From the wilderness of Kedemoth, Moses sent messengers to Sihon, king of Heshbon, asking permission to pass peaceably through his land (",{"href":"?bref=Deut.2.26","r":"Deut.2.26","rawR":"Deut.2.26","sourceRefs":[{"raw":"Deut.2.26","value":"Deut.2.26"}],"t":"ref","v":"Dt 2:26"},"). In the division of the land, Kedemoth was given to Reuben’s tribe (",{"href":"?bref=Josh.13.18","r":"Josh.13.18","rawR":"Josh.13.18","sourceRefs":[{"raw":"Josh.13.18","value":"Josh.13.18"}],"t":"ref","v":"Jos 13:18"},") and then set aside as one of the Levitical cities for the Merarites (",{"href":"?bref=Josh.21.37","r":"Josh.21.37","rawR":"Josh.21.37","sourceRefs":[{"raw":"Josh.21.37","value":"Josh.21.37"}],"t":"ref","v":"Jos 21:37"},"; ",{"href":"?bref=1Chr.6.79","r":"1Chr.6.79","rawR":"1Chr.6.79","sourceRefs":[{"raw":"1Chr.6.79","value":"1Chr.6.79"}],"t":"ref","v":"1 Chr 6:79"},")."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=LeviticalCities_Article_TyndaleOpenBibleDictionary","id":"LeviticalCities_Article_TyndaleOpenBibleDictionary","rawId":"LeviticalCities_Article_TyndaleOpenBibleDictionary","t":"link","v":"Levitical Cities"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Kedemoth","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Dt 2:26","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.2.26","rawQueryValue":"Deut.2.26","sourceRefExact":"Deut.2.26"},{"anchorText":"Jos 13:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.13.18","rawQueryValue":"Josh.13.18","sourceRefExact":"Josh.13.18"},{"anchorText":"Jos 21:37","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.21.37","rawQueryValue":"Josh.21.37","sourceRefExact":"Josh.21.37"},{"anchorText":"1 Chr 6:79","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.6.79","rawQueryValue":"1Chr.6.79","sourceRefExact":"1Chr.6.79"}],"sourceItemFragmentSha256":"77b245016639ca438c8a0b6c2e96972d3a0d192b606af9edb02353f288916cd4","sourceItemName":"Kedemoth","sourceItemOrder":23,"sourceMember":"Articles/K.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Kedemoth","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Kedemoth","title":"Kedemoth","version":"v2-a101d843a2f0cd3fc0c6"}