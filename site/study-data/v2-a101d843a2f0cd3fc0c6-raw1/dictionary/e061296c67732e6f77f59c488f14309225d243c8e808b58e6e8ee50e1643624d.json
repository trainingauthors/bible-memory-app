{"content":[{"c":["EN-SHEMESH"],"sourceClass":"h1","t":"p"},{"c":["Place mentioned only in ",{"href":"?bref=Josh.15.7","r":"Josh.15.7","rawR":"Josh.15.7","sourceRefs":[{"raw":"Josh.15.7","value":"Josh.15.7"}],"t":"ref","v":"Joshua 15:7"}," and ",{"href":"?bref=Josh.18.17","r":"Josh.18.17","rawR":"Josh.18.17","sourceRefs":[{"raw":"Josh.18.17","value":"Josh.18.17"}],"t":"ref","v":"18:17"}," as a boundary marker between Judah’s northern border and Benjamin’s southern border. The usual identification is with ’Ain el-Hod, about three miles (4.8 kilometers) east of Jerusalem on the road to Jericho. On the basis of a tradition that the apostles drank there, it is sometimes referred to as the Spring of the Apostles."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"EnShemesh","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Joshua 15:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.7","rawQueryValue":"Josh.15.7","sourceRefExact":"Josh.15.7"},{"anchorText":"18:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.18.17","rawQueryValue":"Josh.18.17","sourceRefExact":"Josh.18.17"}],"sourceItemFragmentSha256":"240789b4b2fde1ee2fafb3ff60b4506fa234e71292f5182c2e57dd303a6bfd9f","sourceItemName":"EnShemesh","sourceItemOrder":184,"sourceMember":"Articles/E.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"EnShemesh","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"En-Shemesh","title":"En-Shemesh","version":"v2-a101d843a2f0cd3fc0c6"}