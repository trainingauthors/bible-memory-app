{"content":[{"c":["NOBAH (P",{"c":["lace"],"sourceClass":"lc","t":"span"},")"],"sourceClass":"h1","t":"p"},{"c":["1. Town east of the Jordan, previously named Kenath, allotted to Nobah the Manassite for an inheritance, at which time he called it Nobah after his own name (",{"href":"?bref=Num.32.42","r":"Num.32.42","rawR":"Num.32.42","sourceRefs":[{"raw":"Num.32.42","value":"Num.32.42"}],"t":"ref","v":"Nm 32:42"},"). Nobah is perhaps also identifiable with Kanatha, the easternmost city of the Decapolis during the Roman era."],"sourceClass":"list","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Decapolis_Article_TyndaleOpenBibleDictionary","id":"Decapolis_Article_TyndaleOpenBibleDictionary","rawId":"Decapolis_Article_TyndaleOpenBibleDictionary","t":"link","v":"Decapolis"},"; ",{"href":"?item=Kanatha_Article_TyndaleOpenBibleDictionary","id":"Kanatha_Article_TyndaleOpenBibleDictionary","rawId":"Kanatha_Article_TyndaleOpenBibleDictionary","t":"link","v":"Kanatha"},"."],"sourceClass":"list-text","t":"p"},{"c":["2. Place near the Gadite town of Jogbehah east of the Jordan, near which Gideon ambushed the Midianites (",{"href":"?bref=Judg.8.11","r":"Judg.8.11","rawR":"Judg.8.11","sourceRefs":[{"raw":"Judg.8.11","value":"Judg.8.11"}],"t":"ref","v":"Jgs 8:11"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"NobahPlace","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Nm 32:42","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.32.42","rawQueryValue":"Num.32.42","sourceRefExact":"Num.32.42"},{"anchorText":"Jgs 8:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.8.11","rawQueryValue":"Judg.8.11","sourceRefExact":"Judg.8.11"}],"sourceItemFragmentSha256":"9bc1c877e2e1120590a13def95c56dd41db3435a9da9cf04ade7992ce8388ebe","sourceItemName":"NobahPlace","sourceItemOrder":161,"sourceMember":"Articles/N.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"NobahPlace","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Nobah (Place)","title":"Nobah (Place)","version":"v2-a101d843a2f0cd3fc0c6"}