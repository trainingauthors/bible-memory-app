{"content":[{"c":["TEBAH (P",{"c":["lace"],"sourceClass":"lc","t":"span"},")"],"sourceClass":"h1","t":"p"},{"c":["City of King Hadadezer from which David received a large quantity of bronze as booty (",{"href":"?bref=2Sam.8.8","r":"2Sam.8.8","rawR":"2Sam.8.8","sourceRefs":[{"raw":"2Sam.8.8","value":"2Sam.8.8"}],"t":"ref","v":"2 Sm 8:8"},"; ",{"href":"?bref=1Chr.18.8","r":"1Chr.18.8","rawR":"1Chr.18.8","sourceRefs":[{"raw":"1Chr.18.8","value":"1Chr.18.8"}],"t":"ref","v":"1 Chr 18:8"},"). Hadadezer was the king of Zobah, which is located in the region of Hamath in Syria, so the location of Tebah was likely in that region."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"TebahPlace","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Sm 8:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.8.8","rawQueryValue":"2Sam.8.8","sourceRefExact":"2Sam.8.8"},{"anchorText":"1 Chr 18:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.18.8","rawQueryValue":"1Chr.18.8","sourceRefExact":"1Chr.18.8"}],"sourceItemFragmentSha256":"2c1b6c32680c37bf18f38d63750cd156543d4903f0503c7d8852505e9c373401","sourceItemName":"TebahPlace","sourceItemOrder":71,"sourceMember":"Articles/T.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"TebahPlace","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Tebah (Place)","title":"Tebah (Place)","version":"v2-a101d843a2f0cd3fc0c6"}