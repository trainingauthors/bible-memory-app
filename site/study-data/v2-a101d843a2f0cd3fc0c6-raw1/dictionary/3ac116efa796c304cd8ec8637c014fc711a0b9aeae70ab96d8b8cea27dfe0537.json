{"content":[{"c":["BEULAH*"],"sourceClass":"h1","t":"p"},{"c":["Hebrew word used once in the ",{"c":["kjv"],"sourceClass":"sc","t":"span"}," as a proper name for Jerusalem, denoting a promised blessing for the people of God (",{"href":"?bref=Isa.62.4","r":"Isa.62.4","rawR":"Isa.62.4","sourceRefs":[{"raw":"Isa.62.4","value":"Isa.62.4"}],"t":"ref","v":"Is 62:4"},"). The word means “married” and was used symbolically by the prophet Isaiah to describe what God’s special relationship would be to his restored people. The same theme recurs in NT references to the “Bride of Christ.”"],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=BrideofChrist_Article_TyndaleOpenBibleDictionary","id":"BrideofChrist_Article_TyndaleOpenBibleDictionary","rawId":"BrideofChrist_Article_TyndaleOpenBibleDictionary","t":"link","v":"Bride of Christ"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Beulah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Is 62:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.62.4","rawQueryValue":"Isa.62.4","sourceRefExact":"Isa.62.4"}],"sourceItemFragmentSha256":"40152a285c0e40b068c592adad3bb01b7e24680f7547d30c60ac0ba4f2c4cfbc","sourceItemName":"Beulah","sourceItemOrder":292,"sourceMember":"Articles/B.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Beulah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Beulah*","title":"Beulah*","version":"v2-a101d843a2f0cd3fc0c6"}