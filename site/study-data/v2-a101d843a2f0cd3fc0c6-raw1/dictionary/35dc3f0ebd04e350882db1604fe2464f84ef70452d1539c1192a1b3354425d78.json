{"content":[{"c":["BARAK"],"sourceClass":"h1","t":"p"},{"c":["Son of Abinoam of Kedesh in Naphtali (",{"href":"?bref=Judg.4.6","r":"Judg.4.6","rawR":"Judg.4.6","sourceRefs":[{"raw":"Judg.4.6","value":"Judg.4.6"}],"t":"ref","v":"Jgs 4:6"},"; ",{"href":"?bref=Judg.5.1","r":"Judg.5.1","rawR":"Judg.5.1","sourceRefs":[{"raw":"Judg.5.1","value":"Judg.5.1"}],"t":"ref","v":"5:1"},") and an associate of the prophetess Deborah. Barak led an army of Israel that defeated the forces of Jabin, king of the Canaanites (",{"href":"?bref=Judg.4.1-24","r":"Judg.4.1-24","rawR":"Judg.4.1-24","sourceRefs":[{"raw":"Judg.4.1-24","value":"Judg.4.1-24"}],"t":"ref","v":"Jgs 4"},"). Barak is one of the heroes of faith listed in the NT (",{"href":"?bref=Heb.11.32","r":"Heb.11.32","rawR":"Heb.11.32","sourceRefs":[{"raw":"Heb.11.32","value":"Heb.11.32"}],"t":"ref","v":"Heb 11:32"},"). ",{"c":["See"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Deborah_Article_TyndaleOpenBibleDictionary","id":"Deborah_Article_TyndaleOpenBibleDictionary","rawId":"Deborah_Article_TyndaleOpenBibleDictionary","t":"link","v":"Deborah #2"},"; ",{"href":"?item=JudgesBookof_Article_TyndaleOpenBibleDictionary","id":"JudgesBookof_Article_TyndaleOpenBibleDictionary","rawId":"JudgesBookof_Article_TyndaleOpenBibleDictionary","t":"link","v":"Judges, Book of"},"."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Barak","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jgs 4:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.4.6","rawQueryValue":"Judg.4.6","sourceRefExact":"Judg.4.6"},{"anchorText":"5:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.5.1","rawQueryValue":"Judg.5.1","sourceRefExact":"Judg.5.1"},{"anchorText":"Jgs 4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.4.