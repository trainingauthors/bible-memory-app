{"content":[{"c":["ADRAMYTTIUM"],"sourceClass":"h1","t":"p"},{"c":["Ancient port city in Asia Minor. En route to Rome as a prisoner, Paul embarked on a ship having Adramyttium as its home port (",{"href":"?bref=Acts.27.2","r":"Acts.27.2","rawR":"Acts.27.2","sourceRefs":[{"raw":"Acts.27.2","value":"Acts.27.2"}],"t":"ref","v":"Acts 27:2"},"). Today Adramyttium is the Turkish city of Edremit. Coins found in the area indicate that Adramyttium may have been a center for the worship of Castor and Pollux (twin sons of the pagan god, Zeus)."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Adramyttium","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Acts 27:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.27.2","rawQueryValue":"Acts.27.2","sourceRefExact":"Acts.27.2"}],"sourceItemFragmentSha256":"a529fdc3aeb3c0388395afd0437cda5f39ca3b808e82a27e692b3cc349c1d764","sourceItemName":"Adramyttium","sourceItemOrder":139,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Adramyttium","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Adramyttium","title":"Adramyttium","version":"v2-a101d843a2f0cd3fc0c6"}