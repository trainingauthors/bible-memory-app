ream","hrefExact":"?bref=1Sam.15.9","rawQueryValue":"1Sam.15.9","sourceRefExact":"1Sam.15.9"},{"anchorText":"15:10-31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.15.10-31","rawQueryValue":"1Sam.15.10-31","sourceRefExact":"1Sam.15.10-31"},{"anchorText":"15:32-35","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.15.32-35","rawQueryValue":"1Sam.15.32-35","sourceRefExact":"1Sam.15.32-35"},{"anchorText":"27:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.27.8","rawQueryValue":"1Sam.27.8","sourceRefExact":"1Sam.27.8"},{"anchorText":"30:1-20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.30.1-20","rawQueryValue":"1Sam.30.1-20","sourceRefExact":"1Sam.30.1-20"},{"anchorText":"2 Sm 1:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.1.1","rawQueryValue":"2Sam.1.1","sourceRefExact":"2Sam.1.1"},{"anchorText":"2 Sm 8:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.8.12","rawQueryValue":"2Sam.8.12","sourceRefExact":"2Sam.8.12"},{"anchorText":"1 Chr 18:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.18.11","rawQueryValue":"1Chr.18.11","sourceRefExact":"1Chr.18.11"},{"anchorText":"Ps 83:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ps.83.7","rawQueryValue":"Ps.83.7","sourceRefExact":"Ps.83.7"},{"anchorText":"1 Chr 4:41-43","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.4.41-43","rawQueryValue":"1Chr.4.41-43","sourceRefExact":"1Chr.4.41-43"}],"sourceItemFragmentSha256":"bdbf51054725af7973d2fc5141830bfe7bb089587712b7382931f5e1a6a8678e","sourceItemName":"AmalekAmalekites","sourceItemOrder":276,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"AmalekAmalekites","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Amalek, Amalekites","title":"Amalek, Amalekites","version":"v2-a101d843a2f0cd3fc0c6"}