{"content":[{"c":["TEMAN (P",{"c":["lace"],"sourceClass":"lc","t":"span"},")"],"sourceClass":"h1","t":"p"},{"c":["In the prophetic writings, Teman seems to have been considered the principal city of Edom and is often used as a poetic parallel for the entire land of Edom (",{"href":"?bref=Jer.49.7,20","r":"Jer.49.7,20","rawR":"Jer.49.7,20","sourceRefs":[{"raw":"Jer.49.7,20","value":"Jer.49.7,20"}],"t":"ref","v":"Jer 49:7, 20"},"; ",{"href":"?bref=Amos.1.12","r":"Amos.1.12","rawR":"Amos.1.12","sourceRefs":[{"raw":"Amos.1.12","value":"Amos.1.12"}],"t":"ref","v":"Am 1:12"},"; ",{"href":"?bref=Obad.1.9","r":"Obad.1.9","rawR":"Obad.1.9","sourceRefs":[{"raw":"Obad.1.9","value":"Obad.1.9"}],"t":"ref","v":"Ob 1:9"},"). Since Teman means “south,” it is likely that Teman was located in the far south of Edom; however, its precise location remains unknown. The residents of Teman were evidently well known for their wisdom (",{"href":"?bref=Jer.49.7","r":"Jer.49.7","rawR":"Jer.49.7","sourceRefs":[{"raw":"Jer.49.7","value":"Jer.49.7"}],"t":"ref","v":"Jer 49:7"},"; ",{"href":"?bref=Obad.1.9","r":"Obad.1.9","rawR":"Obad.1.9","sourceRefs":[{"raw":"Obad.1.9","value":"Obad.1.9"}],"t":"ref","v":"Ob 1:9"},"). This reputation may well derive from Eliphaz the Temanite, who was one of Job’s counselors (",{"href":"?bref=Job.2.11,4","r":"Job.2.11,4","rawR":"Job.2.11,4","sourceRefs":[{"raw":"Job.2.11,4","value":"Job.2.11,4"}],"t":"ref","v":"Jb 2:11, 4:1"},"; ",{"href":"?bref=Job.15.1","r":"Job.15.1","rawR":"Job.15.1","sourceRefs":[{"raw":"Job.15.1","value":"Job.15.1"}],"t":"ref","v":"15:1"},"; ",{"href":"?bref=Job.22.1","r":"Job.22.1","rawR":"Job.22.1","sourceRefs":[{"raw":"Job.22.1","value":"Job.22.1"}],"t":"ref","v":"22:1"},"; ",{"href":"?bref=Job.42.7-9","r":"Job.42.7-9","rawR":"Job.42.7-9","sourceRefs":[{"raw":"Job.42.7-9","value":"Job.42.7-9"}],"t":"ref","v":"42:7-9"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"TemanPlace","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jer 49:7, 20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.49.7,20","rawQueryValue":"Jer.49.7,20","sourceRefExact":"Jer.49.7,20"},{"anchorText":"Am 1:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Amos.1.12","rawQueryValue":"Amos.1.12","sourceRefExact":"Amos.1.12"},{"anchorText":"Ob 1:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Obad.1.9","rawQueryValue":"Obad.1.9","sourceRefExact":"Obad.1.9"},{"anchorText":"Jer 49:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.49.7","rawQueryValue":"Jer.49.7","sourceRefExact":"Jer.49.7"},{"anchorText":"Ob 1:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Obad.1.9","rawQueryValue":"Obad.1.9","sourceRefExact":"Obad.1.9"},{"anchorText":"Jb 2:11, 4:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Job.2.11,4","rawQueryValue":"Job.2.11,4","sourceRefExact":"Job.2.11,4"},{"anchorText":"15:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Job.15.1","rawQueryValue":"Job.15.1","sourceRefExact":"Job.15.1"},{"anchorText":"22:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Job.22.1","rawQueryValue":"Job.22.1","sourceRefExact":"Job.22.1"},{"anchorText":"42:7-9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Job.42.7-9","rawQueryValue":"Job.42.7-9","sourceRefExact":"Job.42.7-9"}],"sourceItemFragmentSha256":"0d31eb124badcce875a742f5b178d873f9b72cee05c0fa721990bd9907646265","sourceItemName":"TemanPlace","sourceItemOrder":92,"sourceMember":"Articles/T.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"TemanPlace","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Teman (Place)","title":"Teman (Place)","version":"v2-a101d843a2f0cd3fc0c6"}