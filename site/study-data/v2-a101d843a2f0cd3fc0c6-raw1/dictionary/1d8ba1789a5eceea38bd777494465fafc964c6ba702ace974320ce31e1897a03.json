{"content":[{"c":["DISHON"],"sourceClass":"h1","t":"p"},{"c":["1. Seir’s fifth son and a Horite leader in Edom (",{"href":"?bref=Gen.36.21","r":"Gen.36.21","rawR":"Gen.36.21","sourceRefs":[{"raw":"Gen.36.21","value":"Gen.36.21"}],"t":"ref","v":"Gn 36:21"},"; ",{"href":"?bref=1Chr.1.38","r":"1Chr.1.38","rawR":"1Chr.1.38","sourceRefs":[{"raw":"1Chr.1.38","value":"1Chr.1.38"}],"t":"ref","v":"1 Chr 1:38"},"), whose people were eventually displaced by the Edomites."],"sourceClass":"list","t":"p"},{"c":["2. Grandson of Seir and son of Anah, a Horite leader. This Dishon was also the brother of Oholibamah, Esau’s wife (",{"href":"?bref=Gen.36.25","r":"Gen.36.25","rawR":"Gen.36.25","sourceRefs":[{"raw":"Gen.36.25","value":"Gen.36.25"}],"t":"ref","v":"Gn 36:25"},"; ",{"href":"?bref=1Chr.1.41","r":"1Chr.1.41","rawR":"1Chr.1.41","sourceRefs":[{"raw":"1Chr.1.41","value":"1Chr.1.41"}],"t":"ref","v":"1 Chr 1:41"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Dishon","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 36:21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.36.21","rawQueryValue":"Gen.36.21","sourceRefExact":"Gen.36.21"},{"anchorText":"1 Chr 1:38","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.1.38","rawQueryValue":"1Chr.1.38","sourceRefExact":"1Chr.1.38"},{"anchorText":"Gn 36:25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.36.25","rawQueryValue":"Gen.36.25","sourceRefExact":"Gen.36.25"},{"anchorText":"1 Chr 1:41","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.1.41","rawQueryValue":"1Chr.1.41","sourceRefExact":"1Chr.1.41"}],"sourceItemFragmentSha256":"4e5830db89d39ce854e6368ceb68770fbf70169734033d14d08bd08bb8648090","sourceItemName":"Dishon","sourceItemOrder":132,"sourceMem