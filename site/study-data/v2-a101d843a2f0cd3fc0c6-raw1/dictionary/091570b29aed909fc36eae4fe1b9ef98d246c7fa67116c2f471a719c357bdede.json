{"content":[{"c":["SARID"],"sourceClass":"h1","t":"p"},{"c":["Town located in the region of Zebulun near its southern border, situated between Maralah to the west and Kisloth-tabor to the east (",{"href":"?bref=Josh.19.10,12","r":"Josh.19.10,12","rawR":"Josh.19.10,12","sourceRefs":[{"raw":"Josh.19.10,12","value":"Josh.19.10,12"}],"t":"ref","v":"Jos 19:10, 12"},"). Some suggest that this town is the same as Tell Shadud, a town near the valley of Jezreel."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Sarid","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 19:10, 12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.19.10,12","rawQueryValue":"Josh.19.10,12","sourceRefExact":"Josh.19.10,12"}],"sourceItemFragmentSha256":"0d759334533873af5df4f6cf18ab3db94db79da734d29d191f2bc26b6bf5369d","sourceItemName":"Sarid","sourceItemOrder":75,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Sarid","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Sarid","title":"Sarid","version":"v2-a101d843a2f0cd3fc0c6"}