xact":"Rom.13.9-10"},{"anchorText":"Heb 13:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Heb.13.4","rawQueryValue":"Heb.13.4","sourceRefExact":"Heb.13.4"},{"anchorText":"Lv 20:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Lev.20.10","rawQueryValue":"Lev.20.10","sourceRefExact":"Lev.20.10"},{"anchorText":"Dt 22:22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.22.22","rawQueryValue":"Deut.22.22","sourceRefExact":"Deut.22.22"},{"anchorText":"Dt 22:23-27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.22.23-27","rawQueryValue":"Deut.22.23-27","sourceRefExact":"Deut.22.23-27"},{"anchorText":"22:24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.22.24","rawQueryValue":"Deut.22.24","sourceRefExact":"Deut.22.24"},{"anchorText":"Nm 5:11-31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.5.11-31","rawQueryValue":"Num.5.11-31","sourceRefExact":"Num.5.11-31"},{"anchorText":"Is 54:5-8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.54.5-8","rawQueryValue":"Isa.54.5-8","sourceRefExact":"Isa.54.5-8"},{"anchorText":"Rv 21:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.21.2","rawQueryValue":"Rev.21.2","sourceRefExact":"Rev.21.2"},{"anchorText":"Jer 5:7-8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.5.7-8","rawQueryValue":"Jer.5.7-8","sourceRefExact":"Jer.5.7-8"},{"anchorText":"13:22-27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.13.22-27","rawQueryValue":"Jer.13.22-27","sourceRefExact":"Jer.13.22-27"},{"anchorText":"Ez 23:37","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.23.37","rawQueryValue":"Ezek.23.37","sourceRefExact":"Ezek.23.37"},{"anchorText":"Mt 12:39","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.12.39","rawQueryValue":"Matt.12.39","sourceRefExact":"Matt.12.39"},{"anchorText":"16:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.16.4","rawQueryValue":"Matt.16.4","sourceRefExact":"Matt.16.4"},{"anchorText":"Mk 8:38","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mark.8.38","rawQueryValue":"Mark.8.38","sourceRefExact":"Mark.8.38"},{"anchorText":"Jas 4:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jas.4.4","rawQueryValue":"Jas.4.4","sourceRefExact":"Jas.4.4"},{"anchorText":"Hos 2:2-6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Hos.2.2-6","rawQueryValue":"Hos.2.2-6","sourceRefExact":"Hos.2.2-6"},{"anchorText":"3:1-5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Hos.3.1-5","rawQueryValue":"Hos.3.1-5","sourceRefExact":"Hos.3.1-5"},{"anchorText":"Jer 3:1-14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.3.1-14","rawQueryValue":"Jer.3.1-14","sourceRefExact":"Jer.3.1-14"},{"anchorText":"Ez 16:1-63","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.16.1-63","rawQueryValue":"Ezek.16.1-63","sourceRefExact":"Ezek.16.1-63"}],"sourceItemFragmentSha256":"d33ca3e4318d287e5a21ae7470dc358aeb9eaff27f73359da201ff6f2e98e3cd","sourceItemName":"Adultery","sourceItemOrder":144,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Adultery","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Adultery","title":"Adultery","version":"v2-a101d843a2f0cd3fc0c6"}