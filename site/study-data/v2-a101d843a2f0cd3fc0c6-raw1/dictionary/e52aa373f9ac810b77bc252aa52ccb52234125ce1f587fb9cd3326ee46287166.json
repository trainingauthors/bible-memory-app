{"content":[{"c":["NODAB*, NODABITES"],"sourceClass":"h1","t":"p"},{"c":["Forefather of an Arabian tribe that joined forces with the Hagarites to fight against the tribes of Israel who were living east of the Jordan (",{"href":"?bref=1Chr.5.19","r":"1Chr.5.19","rawR":"1Chr.5.19","sourceRefs":[{"raw":"1Chr.5.19","value":"1Chr.5.19"}],"t":"ref","v":"1 Chr 5:19"},"). Though not included in the list of Ishmael’s sons (cf. ",{"href":"?bref=Gen.25.13-15","r":"Gen.25.13-15","rawR":"Gen.25.13-15","sourceRefs":[{"raw":"Gen.25.13-15","value":"Gen.25.13-15"}],"t":"ref","v":"Gn 25:13-15"},"), he was perhaps a distant relation."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"NodabNodabites","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 5:19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.5.19","rawQueryValue":"1Chr.5.19","sourceRefExact":"1Chr.5.19"},{"anchorText":"Gn 25:13-15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.25.13-15","rawQueryValue":"Gen.25.13-15","sourceRefExact":"Gen.25.13-15"}],"sourceItemFragmentSha256":"db442be063e31b4ed7380506cc82254293f4ab9849ce812a2cfd1720502540d8","sourceItemName":"NodabNodabites","sourceItemOrder":163,"sourceMember":"Articles/N.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"NodabNodabites","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Nodab*, Nodabites","title":"Nodab*, Nodabites","version":"v2-a101d843a2f0cd3fc0c6"}