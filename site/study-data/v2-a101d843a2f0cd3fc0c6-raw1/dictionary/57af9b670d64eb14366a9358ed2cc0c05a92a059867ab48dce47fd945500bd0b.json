{"content":[{"c":["MARKET, MARKETPLACE"],"sourceClass":"h1","t":"p"},{"c":["Place for the buying and selling of goods in antiquity. Generally, the marketplaces of the ancient Near East would be much like the open air bazaars one can still see in any city throughout Israel, Greece, and Turkey."],"sourceClass":"fl","t":"p"},{"c":["The marketplace of NT times known as the ",{"c":["agora"],"sourceClass":"greek","t":"span"}," was a place for buying and selling goods (",{"href":"?bref=Mark.7.4","r":"Mark.7.4","rawR":"Mark.7.4","sourceRefs":[{"raw":"Mark.7.4","value":"Mark.7.4"}],"t":"ref","v":"Mk 7:4"},"); a place for children to play (",{"href":"?bref=Matt.11.16","r":"Matt.11.16","rawR":"Matt.11.16","sourceRefs":[{"raw":"Matt.11.16","value":"Matt.11.16"}],"t":"ref","v":"Mt 11:16"},"; ",{"href":"?bref=Luke.7.32","r":"Luke.7.32","rawR":"Luke.7.32","sourceRefs":[{"raw":"Luke.7.32","value":"Luke.7.32"}],"t":"ref","v":"Lk 7:32"},"); a place for idlers and for men seeking work (",{"href":"?bref=Matt.20.3","r":"Matt.20.3","rawR":"Matt.20.3","sourceRefs":[{"raw":"Matt.20.3","value":"Matt.20.3"}],"t":"ref","v":"Mt 20:3"},"); a place where public events, including healings, occurred (",{"href":"?bref=Mark.6.56","r":"Mark.6.56","rawR":"Mark.6.56","sourceRefs":[{"raw":"Mark.6.56","value":"Mark.6.56"}],"t":"ref","v":"Mk 6:56"},"); the center of public life and debate (",{"href":"?bref=Acts.17.17","r":"Acts.17.17","rawR":"Acts.17.17","sourceRefs":[{"raw":"Acts.17.17","value":"Acts.17.17"}],"t":"ref","v":"Acts 17:17"},"); and a place where trials were held (",{"href":"?bref=Acts.16.19","r":"Acts.16.19","rawR":"Acts.16.19","sourceRefs":[{"raw":"Acts.16.19","value":"Acts.16.19"}],"t":"ref","v":"16:19"},")."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"MarketMarketplace","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Mk 7:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mark.7.4","rawQueryValue":"Mark.7.4","sourceRefExact":"Mark.7.4"},{"anchorText":"Mt 11:16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.11.16","rawQueryValue":"Matt.11.16","sourceRefExact":"Matt.11.16"},{"anchorText":"Lk 7:32","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.7.32","rawQueryValue":"Luke.7.32","sourceRefExact":"Luke.7.32"},{"anchorText":"Mt 20:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.20.3","rawQueryValue":"Matt.20.3","sourceRefExact":"Matt.20.3"},{"anchorText":"Mk 6:56","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mark.6.56","rawQueryValue":"Mark.6.56","sourceRefExact":"Mark.6.56"},{"anchorText":"Acts 17:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.17.17","rawQueryValue":"Acts.17.17","sourceRefExact":"Acts.17.17"},{"anchorText":"16:19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.16.19","rawQueryValue":"Acts.16.19","sourceRefExact":"Acts.16.19"}],"sourceItemFragmentSha256":"f59ff28e6ba75a43a9e02cf337cef6737c64c9b2c0f0e61ee3667a5ed095ba43","sourceItemName":"MarketMarketplace","sourceItemOrder":144,"sourceMember":"Articles/M.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"MarketMarketplace","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Market, Marketplace","title":"Market, Marketplace","version":"v2-a101d843a2f0cd3fc0c6"}