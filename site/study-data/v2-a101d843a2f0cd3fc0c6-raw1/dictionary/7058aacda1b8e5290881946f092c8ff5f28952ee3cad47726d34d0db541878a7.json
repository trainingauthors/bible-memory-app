{"content":[{"c":["ETHAM"],"sourceClass":"h1","t":"p"},{"c":["First encampment of the Hebrews after leaving Succoth (",{"href":"?bref=Exod.13.20","r":"Exod.13.20","rawR":"Exod.13.20","sourceRefs":[{"raw":"Exod.13.20","value":"Exod.13.20"}],"t":"ref","v":"Ex 13:20"},"), perhaps located on the border of the wilderness of Shur (",{"href":"?bref=Exod.15.22","r":"Exod.15.22","rawR":"Exod.15.22","sourceRefs":[{"raw":"Exod.15.22","value":"Exod.15.22"}],"t":"ref","v":"Ex 15:22"},"; ",{"href":"?bref=Num.33.6-8","r":"Num.33.6-8","rawR":"Num.33.6-8","sourceRefs":[{"raw":"Num.33.6-8","value":"Num.33.6-8"}],"t":"ref","v":"Nm 33:6-8"},"). The suggestion that it was an Egyptian fortress is improbable."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Etham","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ex 13:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.13.20","rawQueryValue":"Exod.13.20","sourceRefExact":"Exod.13.20"},{"anchorText":"Ex 15:22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.15.22","rawQueryValue":"Exod.15.22","sourceRefExact":"Exod.15.22"},{"anchorText":"Nm 33:6-8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.33.6-8","rawQueryValue":"Num.33.6-8","sourceRefExact":"Num.33.6-8"}],"sourceItemFragmentSha256":"f0451769edd3f54eecdf1563f26a1919357485b9d30650d5ddca0011bd57cc8e","sourceItemName":"Etham","sourceItemOrder":258,"sourceMember":"Articles/E.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Etham","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Etham","title":"Etham","version":"v2-a101d843a2f0cd3fc0c6"}