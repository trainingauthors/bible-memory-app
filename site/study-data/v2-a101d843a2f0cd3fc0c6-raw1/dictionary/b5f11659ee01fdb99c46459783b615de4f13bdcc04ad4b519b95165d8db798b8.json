{"content":[{"c":["MAHLI"],"sourceClass":"h1","t":"p"},{"c":["1. Merari’s son and Levi’s grandson (",{"href":"?bref=Exod.6.19","r":"Exod.6.19","rawR":"Exod.6.19","sourceRefs":[{"raw":"Exod.6.19","value":"Exod.6.19"}],"t":"ref","v":"Ex 6:19"},"; ",{"href":"?bref=Num.3.20","r":"Num.3.20","rawR":"Num.3.20","sourceRefs":[{"raw":"Num.3.20","value":"Num.3.20"}],"t":"ref","v":"Nm 3:20"},"; ",{"href":"?bref=1Chr.6.19,29","r":"1Chr.6.19,29","rawR":"1Chr.6.19,29","sourceRefs":[{"raw":"1Chr.6.19,29","value":"1Chr.6.19,29"}],"t":"ref","v":"1 Chr 6:19, 29"},"; ",{"href":"?bref=1Chr.23.21","r":"1Chr.23.21","rawR":"1Chr.23.21","sourceRefs":[{"raw":"1Chr.23.21","value":"1Chr.23.21"}],"t":"ref","v":"23:21"},"; ",{"href":"?bref=1Chr.24.26-28","r":"1Chr.24.26-28","rawR":"1Chr.24.26-28","sourceRefs":[{"raw":"1Chr.24.26-28","value":"1Chr.24.26-28"}],"t":"ref","v":"24:26-28"},"; ",{"href":"?bref=Ezra.8.18","r":"Ezra.8.18","rawR":"Ezra.8.18","sourceRefs":[{"raw":"Ezra.8.18","value":"Ezra.8.18"}],"t":"ref","v":"Ezr 8:18"},"), and the founder of the Mahlite family (",{"href":"?bref=Num.3.33","r":"Num.3.33","rawR":"Num.3.33","sourceRefs":[{"raw":"Num.3.33","value":"Num.3.33"}],"t":"ref","v":"Nm 3:33"},"; ",{"href":"?bref=Num.26.58","r":"Num.26.58","rawR":"Num.26.58","sourceRefs":[{"raw":"Num.26.58","value":"Num.26.58"}],"t":"ref","v":"26:58"},"). The Mahlites, along with the other families of Merari, were appointed to carry the frames of the tabernacle and the pillars of the court (",{"href":"?bref=Num.4.29-33","r":"Num.4.29-33","rawR":"Num.4.29-33","sourceRefs":[{"raw":"Num.4.29-33","value":"Num.4.29-33"}],"t":"ref","v":"Nm 4:29-33"},")."],"sourceClass":"list","t":"p"},{"c":["2. Mushi’s son and the nephew of #1 above (",{"href":"?bref=1Chr.6.47","r":"1Chr.6.47","rawR":"1Chr.6.47","sourceRefs":[{"raw":"1Chr.6.47","value":"1Chr.6.47"}],"t":"ref","v":"1 Chr 6:47"},"; ",{"href":"?bref=1Chr.23.23","r":"1Chr.23.23","rawR":"1Chr.23.23","sourceRefs":[{"raw":"1Chr.23.23","value":"1Chr.23.23"}],"t":"ref","v":"23:23"},"; ",{"href":"?bref=1Chr.24.30","r":"1Chr.24.30","rawR":"1Chr.24.30","sourceRefs":[{"raw":"1Chr.24.30","value":"1Chr.24.30"}],"t":"ref","v":"24:30"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Mahli","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ex 6:19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.6.19","rawQueryValue":"Exod.6.19","sourceRefExact":"Exod.6.19"},{"anchorText":"Nm 3:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.3.20","rawQueryValue":"Num.3.20","sourceRefExact":"Num.3.20"},{"anchorText":"1 Chr 6:19, 29","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.6.19,29","rawQueryValue":"1Chr.6.19,29","sourceRefExact":"1Chr.6.19,29"},{"anchorText":"23:21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.23.21","rawQueryValue":"1Chr.23.21","sourceRefExact":"1Chr.23.21"},{"anchorText":"24:26-28","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.24.26-28","rawQueryValue":"1Chr.24.26-28","sourceRefExact":"1Chr.24.26-28"},{"anchorText":"Ezr 8:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.8.18","rawQueryValue":"Ezra.8.18","sourceRefExact":"Ezra.8.18"},{"anchorText":"Nm 3:33","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.3.33","rawQueryValue":"Num.3.33","sourceRefExact":"Num.3.33"},{"anchorText":"26:58","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.26.58","rawQueryValue":"Num.26.58","sourceRefExact":"Num.26.58"},{"anchorText":"Nm 4:29-33","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.4.29-33","rawQueryValue":"Num.4.29-33","sourceRefExact":"Num.4.29-33"},