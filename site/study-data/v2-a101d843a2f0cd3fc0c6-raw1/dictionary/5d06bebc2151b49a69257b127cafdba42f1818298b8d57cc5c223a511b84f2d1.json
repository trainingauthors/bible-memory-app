{"content":[{"c":["HONEY"],"sourceClass":"h1","t":"p"},{"c":["Sweet syrup produced by bees (",{"href":"?bref=Judg.14.8","r":"Judg.14.8","rawR":"Judg.14.8","sourceRefs":[{"raw":"Judg.14.8","value":"Judg.14.8"}],"t":"ref","v":"Jgs 14:8"},"), either wild (",{"href":"?bref=1Sam.14.25-26","r":"1Sam.14.25-26","rawR":"1Sam.14.25-26","sourceRefs":[{"raw":"1Sam.14.25-26","value":"1Sam.14.25-26"}],"t":"ref","v":"1 Sm 14:25-26"},") or domesticated (apparently so in ",{"href":"?bref=2Chr.31.5","r":"2Chr.31.5","rawR":"2Chr.31.5","sourceRefs":[{"raw":"2Chr.31.5","value":"2Chr.31.5"}],"t":"ref","v":"2 Chr 31:5"},"). Sometimes, however, it may refer to thick grape syrup (as in Arabic) or date syrup (as described by Josephus). Honey was considered one of life’s necessities (",{"href":"?bref=Ecclus.39.26","r":"Ecclus.39.26","rawR":"Ecclus.39.26","sourceRefs":[{"raw":"Ecclus.39.26","value":"Ecclus.39.26"}],"t":"ref","v":"Ecclus 39:26"},"); one must not, however, eat too much (",{"href":"?bref=Pr.25.16,27","r":"Pr.25.16,27","rawR":"Pr.25.16,27","sourceRefs":[{"raw":"Pr.25.16,27","value":"Pr.25.16,27"}],"t":"ref","v":"Prv 25:16, 27"},"). It was part of the diet of John the Baptist (",{"href":"?bref=Mark.1.6","r":"Mark.1.6","rawR":"Mark.1.6","sourceRefs":[{"raw":"Mark.1.6","value":"Mark.1.6"}],"t":"ref","v":"Mk 1:6"},") and of Immanuel (",{"href":"?bref=Isa.7.15","r":"Isa.7.15","rawR":"Isa.7.15","sourceRefs":[{"raw":"Isa.7.15","value":"Isa.7.15"}],"t":"ref","v":"Is 7:15"},"). Its exclusion, along with leaven, from grain offerings (",{"href":"?bref=Lev.2.11","r":"Lev.2.11","rawR":"Lev.2.11","sourceRefs":[{"raw":"Lev.2.11","value":"Lev.2.11"}],"t":"ref","v":"Lv 2:11"},") is undoubtedly because it is susceptible to fermentation. Its sweetness became a familiar metaphor (",{"href":"?bref=Judg.14.18","r":"Judg.14.18","rawR":"Judg.14.18","sourceRefs":[{"raw":"Judg.14.18","value":"Judg.14.18"}],"t":"ref","v":"Jgs 14:18"},"; ",{"href":"?bref=Ps.19.10","r":"Ps.19.10","rawR":"Ps.19.10","sourceRefs":[{"raw":"Ps.19.10","value":"Ps.19.10"}],"t":"ref","v":"Ps 19:10"},"; ",{"href":"?bref=Rev.10.9-10","r":"Rev.10.9-10","rawR":"Rev.10.9-10","sourceRefs":[{"raw":"Rev.10.9-10","value":"Rev.10.9-10"}],"t":"ref","v":"Rv 10:9-10"},")."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=FoodandFoodPreparation_Article_TyndaleOpenBibleDictionary","id":"FoodandFoodPreparation_Article_TyndaleOpenBibleDictionary","rawId":"FoodandFoodPreparation_Article_TyndaleOpenBibleDictionary","t":"link","v":"Food and Food Preparation"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Honey","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jgs 14:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.14.8","rawQueryValue":"Judg.14.8","sourceRefExact":"Judg.14.8"},{"anchorText":"1 Sm 14:25-26","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.14.25-26","rawQueryValue":"1Sam.14.25-26","sourceRefExact":"1Sam.14.25-26"},{"anchorText":"2 Chr 31:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.31.5","rawQueryValue":"2Chr.31.5","sourceRefExact":"2Chr.31.5"},{"anchorText":"Ecclus 39:26","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ecclus.39.26","rawQueryValue":"Ecclus.39.26","sourceRefExact":"Ecclus.39.26"},{"anchorText":"Prv 25:16, 27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Pr.25.16,27","rawQueryValue":"Pr.25.16,27","sourceRefExact":"Pr.25.16,27"},{"anchorText":"Mk 1:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mark.1.6","rawQueryValue":"Mark.1.6","sourceRefExact":"Mark.1.6"},{"anchorText":"Is 7:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.7.15","rawQueryValue":"Isa.7.15","sourceRefExact":"Isa.7.15"},{"anchorText":"Lv 2:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Lev.2.11","rawQueryValue":"Lev.2.11","sourceRefExact":"Lev.2.11"},{"anchorText":"Jgs 14:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.14.18","rawQueryValue":"Judg.14.18","sourceRefExact":"Judg.14.18"},{"anchorText":"Ps 19:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ps.19.10","rawQueryValue":"Ps.19.10","sourceRefExact":"Ps.19.10"},{"anchorText":"Rv 10:9-10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.10.9-10","rawQueryValue":"Rev.10.9-10","sourceRefExact":"Rev.10.9-10"}],"sourceItemFragmentSha256":"7c3909ad001306afc8572017e0a764727314774a4028389243f1e1a41cb5f7a1","sourceItemName":"Honey","sourceItemOrder":337,"sourceMember":"Articles/H.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Honey","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Honey","title":"Honey","version":"v2-a101d843a2f0cd3fc0c6"}