{"content":[{"c":["ISHMAIAH"],"sourceClass":"h1","t":"p"},{"c":["1. Warrior from Benjamin’s tribe who joined David at Ziklag in his struggle against King Saul. Ishmaiah was one of David’s ambidextrous archers and slingers (",{"href":"?bref=1Chr.12.4","r":"1Chr.12.4","rawR":"1Chr.12.4","sourceRefs":[{"raw":"1Chr.12.4","value":"1Chr.12.4"}],"t":"ref","v":"1 Chr 12:4"},")."],"sourceClass":"list","t":"p"},{"c":["2. Obadiah’s son, a chief officer in Zebulun’s tribe in David’s time (",{"href":"?bref=1Chr.27.19","r":"1Chr.27.19","rawR":"1Chr.27.19","sourceRefs":[{"raw":"1Chr.27.19","value":"1Chr.27.19"}],"t":"ref","v":"1 Chr 27:19"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Ishmaiah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 12:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.12.4","rawQueryValue":"1Chr.12.4","sourceRefExact":"1Chr.12.4"},{"anchorText":"1 Chr 27:19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.27.19","rawQueryValue":"1Chr.27.19","sourceRefExact":"1Chr.27.19"}],"sourceItemFragmentSha256":"f5cb6ecfc2a36d41a14ae9d783089ecf09a65181c5ccac1d5ab45b40764e3d9b","sourceItemName":"Ishmaiah","sourceItemOrder":104,"sourceMember":"Articles/I.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Ishmaiah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Ishmaiah","title":"Ishmaiah","version":"v2-a101d843a2f0cd3fc0c6"}