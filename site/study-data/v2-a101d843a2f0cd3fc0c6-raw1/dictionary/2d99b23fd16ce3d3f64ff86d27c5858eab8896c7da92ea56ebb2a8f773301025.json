{"content":[{"c":["POTTAGE*"],"sourceClass":"h1","t":"p"},{"c":["Red-colored vegetable stew commonly served in the OT (",{"href":"?bref=Hagg.2.12","r":"Hagg.2.12","rawR":"Hagg.2.12","sourceRefs":[{"raw":"Hagg.2.12","value":"Hagg.2.12"}],"t":"ref","v":"Hg 2:12"},"). Pottage was made of lentils, herbs, onions, and sometimes meat. Its aroma proved strong enough to shift a birthright from Esau to Jacob (",{"href":"?bref=Gen.25.29-34","r":"Gen.25.29-34","rawR":"Gen.25.29-34","sourceRefs":[{"raw":"Gen.25.29-34","value":"Gen.25.29-34"}],"t":"ref","v":"Gn 25:29-34"},"). Elisha’s disciples relished its nourishment (",{"href":"?bref=2Kgs.4.38-41","r":"2Kgs.4.38-41","rawR":"2Kgs.4.38-41","sourceRefs":[{"raw":"2Kgs.4.38-41","value":"2Kgs.4.38-41"}],"t":"ref","v":"2 Kgs 4:38-41"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Pottage","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Hg 2:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Hagg.2.12","rawQueryValue":"Hagg.2.12","sourceRefExact":"Hagg.2.12"},{"anchorText":"Gn 25:29-34","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.25.29-34","rawQueryValue":"Gen.25.29-34","sourceRefExact":"Gen.25.29-34"},{"anchorText":"2 Kgs 4:38-41","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.4.38-41","rawQueryValue":"2Kgs.4.38-41","sourceRefExact":"2Kgs.4.38-41"}],"sourceItemFragmentSha256":"20bf58f192c32bd294b4e224e0fdec2a537f272297e8cefa2c9531f9d2cfa19f","sourceItemName":"Pottage","sourceItemOrder":250,"sourceMember":"Articles/P.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Pottage","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Pottage*","title":"Pottage*","version":"v2-a101d843a2f0cd3fc0c6"}