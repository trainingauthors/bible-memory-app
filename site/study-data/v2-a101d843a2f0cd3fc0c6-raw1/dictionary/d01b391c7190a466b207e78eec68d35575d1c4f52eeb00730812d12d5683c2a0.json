,{"anchorText":"1 Pt 2:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Pet.2.9","rawQueryValue":"1Pet.2.9","sourceRefExact":"1Pet.2.9"},{"anchorText":"1 Jn 2:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Jn.2.8","rawQueryValue":"1Jn.2.8","sourceRefExact":"1Jn.2.8"},{"anchorText":"Rv 21:23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.21.23","rawQueryValue":"Rev.21.23","sourceRefExact":"Rev.21.23"},{"anchorText":"Is 9:1-2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.9.1-2","rawQueryValue":"Isa.9.1-2","sourceRefExact":"Isa.9.1-2"},{"anchorText":"Mt 4:15-16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.4.15-16","rawQueryValue":"Matt.4.15-16","sourceRefExact":"Matt.4.15-16"},{"anchorText":"Rv 2:28","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.2.28","rawQueryValue":"Rev.2.28","sourceRefExact":"Rev.2.28"}],"sourceItemFragmentSha256":"f321ecffdc9d33321f8f65f9b8fdf24b62cd181e882ac628c533d74bbd877323","sourceItemName":"MorningStar","sourceItemOrder":401,"sourceMember":"Articles/M.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"MorningStar","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Morning Star","title":"Morning Star","version":"v2-a101d843a2f0cd3fc0c6"}