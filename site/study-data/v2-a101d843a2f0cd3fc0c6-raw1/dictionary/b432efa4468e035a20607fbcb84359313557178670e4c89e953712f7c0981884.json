ion":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.17.1","rawQueryValue":"1Kgs.17.1","sourceRefExact":"1Kgs.17.1"},{"anchorText":"2 Sm 21:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.21.1","rawQueryValue":"2Sam.21.1","sourceRefExact":"2Sam.21.1"},{"anchorText":"Jer 14:12, 15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.14.12,15","rawQueryValue":"Jer.14.12,15","sourceRefExact":"Jer.14.12,15"},{"anchorText":"Mk 13:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mark.13.8","rawQueryValue":"Mark.13.8","sourceRefExact":"Mark.13.8"},{"anchorText":"Rv 18:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.18.8","rawQueryValue":"Rev.18.8","sourceRefExact":"Rev.18.8"}],"sourceItemFragmentSha256":"72ff99c6670d1be1926e1a3d7d28b4e29929598d0029cfd8a41bc163905ec378","sourceItemName":"Famine","sourceItemOrder":10,"sourceMember":"Articles/F.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Famine","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Famine","title":"Famine","version":"v2-a101d843a2f0cd3fc0c6"}