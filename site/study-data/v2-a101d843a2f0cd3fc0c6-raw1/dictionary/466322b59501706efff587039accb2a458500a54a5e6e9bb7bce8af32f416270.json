yValue":"1Chr.5.26-27","sourceRefExact":"1Chr.5.26-27"},{"anchorText":"Jer 49:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.49.1","rawQueryValue":"Jer.49.1","sourceRefExact":"Jer.49.1"},{"anchorText":"Ez 48:1, 27-28, 34","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.48.1,27-28,34","rawQueryValue":"Ezek.48.1,27-28,34","sourceRefExact":"Ezek.48.1,27-28,34"},{"anchorText":"Rv 7:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.7.5","rawQueryValue":"Rev.7.5","sourceRefExact":"Rev.7.5"}],"sourceItemFragmentSha256":"2ad9426c2c57995eb7157ae0b92fddc11fba6cdc588bf23967b84456ab2dabf8","sourceItemName":"GadTribeof","sourceItemOrder":12,"sourceMember":"Articles/G.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"GadTribeof","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Gad, Tribe of","title":"Gad, Tribe of","version":"v2-a101d843a2f0cd3fc0c6"}