-28","sourceRefExact":"Ezek.1.4-28"},{"anchorText":"10:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.10.1","rawQueryValue":"Ezek.10.1","sourceRefExact":"Ezek.10.1"},{"anchorText":"7:9-10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Dan.7.9-10","rawQueryValue":"Dan.7.9-10","sourceRefExact":"Dan.7.9-10"},{"anchorText":"Revelation 4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.4.1-11","rawQueryValue":"Rev.4.1-11","sourceRefExact":"Rev.4.1-11"},{"anchorText":"Ps 11:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ps.11.4","rawQueryValue":"Ps.11.4","sourceRefExact":"Ps.11.4"},{"anchorText":"Mt 5:34","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.5.34","rawQueryValue":"Matt.5.34","sourceRefExact":"Matt.5.34"},{"anchorText":"Jer 3:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.3.17","rawQueryValue":"Jer.3.17","sourceRefExact":"Jer.3.17"},{"anchorText":"Ez 43:6-7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.43.6-7","rawQueryValue":"Ezek.43.6-7","sourceRefExact":"Ezek.43.6-7"},{"anchorText":"Jer 14:21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.14.21","rawQueryValue":"Jer.14.21","sourceRefExact":"Jer.14.21"},{"anchorText":"Is 9:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.9.7","rawQueryValue":"Isa.9.7","sourceRefExact":"Isa.9.7"},{"anchorText":"Jer 17:25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.17.25","rawQueryValue":"Jer.17.25","sourceRefExact":"Jer.17.25"},{"anchorText":"Lk 1:32","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.1.32","rawQueryValue":"Luke.1.32","sourceRefExact":"Luke.1.32"},{"anchorText":"Acts 2:30","canonic