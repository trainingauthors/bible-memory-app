{"content":[{"c":["POTSHERD*"],"sourceClass":"h1","t":"p"},{"c":["Piece of broken pottery used in OT times to carry hot coals or to dip water. Potsherds were also used as lids for storage containers or cooking kettles, as a medium for written communication, or to add grit to waterproofing compounds. The symbolic importance of sherds is clear in ",{"href":"?bref=Ps.22.15","r":"Ps.22.15","rawR":"Ps.22.15","sourceRefs":[{"raw":"Ps.22.15","value":"Ps.22.15"}],"t":"ref","v":"Psalm 22:15"},", ",{"href":"?bref=Isa.30.14","r":"Isa.30.14","rawR":"Isa.30.14","sourceRefs":[{"raw":"Isa.30.14","value":"Isa.30.14"}],"t":"ref","v":"Isaiah 30:14"},", ",{"href":"?bref=Isa.45.9","r":"Isa.45.9","rawR":"Isa.45.9","sourceRefs":[{"raw":"Isa.45.9","value":"Isa.45.9"}],"t":"ref","v":"45:9"},", and ",{"href":"?bref=Ezek.23.34","r":"Ezek.23.34","rawR":"Ezek.23.34","sourceRefs":[{"raw":"Ezek.23.34","value":"Ezek.23.34"}],"t":"ref","v":"Ezekiel 23:34"},"."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Pottery_Article_TyndaleOpenBibleDictionary","id":"Pottery_Article_TyndaleOpenBibleDictionary","rawId":"Pottery_Article_TyndaleOpenBibleDictionary","t":"link","v":"Pottery"},"; ",{"href":"?item=Writing_Article_TyndaleOpenBibleDictionary","id":"Writing_Article_TyndaleOpenBibleDictionary","rawId":"Writing_Article_TyndaleOpenBibleDictionary","t":"link","v":"Writing (Potsherds)"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Potsherd","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Psalm 22:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ps.22.15","rawQueryValue":"Ps.22.15","sourceRefExact":"Ps.22.15"},{"anchorText":"Isaiah 30:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.30.14","rawQueryValue":"Isa.30.14","sourceRefExact":"Isa.30