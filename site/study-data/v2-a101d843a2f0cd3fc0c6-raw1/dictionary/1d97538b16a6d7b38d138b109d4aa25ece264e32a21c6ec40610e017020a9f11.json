{"content":[{"c":["MAROTH"],"sourceClass":"h1","t":"p"},{"c":["City in Palestine, mentioned only by Micah (",{"href":"?bref=Mic.1.12","r":"Mic.1.12","rawR":"Mic.1.12","sourceRefs":[{"raw":"Mic.1.12","value":"Mic.1.12"}],"t":"ref","v":"Mi 1:12"},"). It may be the same as the Maarath in ",{"href":"?bref=Josh.15.59","r":"Josh.15.59","rawR":"Josh.15.59","sourceRefs":[{"raw":"Josh.15.59","value":"Josh.15.59"}],"t":"ref","v":"Joshua 15:59"},"; if so, it would be an ancient Canaanite city, part of the inheritance of Judah’s tribe."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Maroth","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Mi 1:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mic.1.12","rawQueryValue":"Mic.1.12","sourceRefExact":"Mic.1.12"},{"anchorText":"Joshua 15:59","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.59","rawQueryValue":"Josh.15.59","sourceRefExact":"Josh.15.59"}],"sourceItemFragmentSha256":"fb3c04fc1dc394c7aef2775fcf850596662d55c90985237c663a96c316d6d257","sourceItemName":"Maroth","sourceItemOrder":146,"sourceMember":"Articles/M.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Maroth","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Maroth","title":"Maroth","version":"v2-a101d843a2f0cd3fc0c6"}