{"content":[{"c":["RABSHAKEH*"],"sourceClass":"h1","t":"p"},{"c":["High Assyrian official, originally a cupbearer or chamberlain, but later a powerful palace official. The rabshakeh was the emissary of Sennacherib, who insultingly demanded that Hezekiah and Jerusalem abandon their reliance on both Egypt and God and surrender to Assyria. Hezekiah refused; the rabshakeh returned to find his king at war against Libnah (",{"href":"?bref=2Kgs.18.17-37","r":"2Kgs.18.17-37","rawR":"2Kgs.18.17-37","sourceRefs":[{"raw":"2Kgs.18.17-37","value":"2Kgs.18.17-37"}],"t":"ref","v":"2 Kgs 18:17-37"},"; ",{"href":"?bref=2Kgs.19.4,8","r":"2Kgs.19.4,8","rawR":"2Kgs.19.4,8","sourceRefs":[{"raw":"2Kgs.19.4,8","value":"2Kgs.19.4,8"}],"t":"ref","v":"19:4, 8"},"; ",{"href":"?bref=Isa.36.2-22","r":"Isa.36.2-22","rawR":"Isa.36.2-22","sourceRefs":[{"raw":"Isa.36.2-22","value":"Isa.36.2-22"}],"t":"ref","v":"Is 36:2-22"},"; ",{"href":"?bref=Isa.37.4,8","r":"Isa.37.4,8","rawR":"Isa.37.4,8","sourceRefs":[{"raw":"Isa.37.4,8","value":"Isa.37.4,8"}],"t":"ref","v":"37:4, 8"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Rabshakeh","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Kgs 18:17-37","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.18.17-37","rawQueryValue":"2Kgs.18.17-37","sourceRefExact":"2Kgs.18.17-37"},{"anchorText":"19:4, 8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.19.4,8","rawQueryValue":"2Kgs.19.4,8","sourceRefExact":"2Kgs.19.4,8"},{"anchorText":"Is 36:2-22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.36.2-22","rawQueryValue":"Isa.36.2-22","sourceRefExact":"Isa.36.2-22"},{"anchorText":"37:4, 8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.37.4,8","rawQueryValue":"Isa.37.4,8","sourceRef