{"content":[{"c":["GIBBETHON"],"sourceClass":"h1","t":"p"},{"c":["City in the western part of central Palestine. It was located in the territory of Dan (",{"href":"?bref=Josh.19.44","r":"Josh.19.44","rawR":"Josh.19.44","sourceRefs":[{"raw":"Josh.19.44","value":"Josh.19.44"}],"t":"ref","v":"Jos 19:44"},") and allotted to the Levite clan of Kohath (",{"href":"?bref=Josh.21.23","r":"Josh.21.23","rawR":"Josh.21.23","sourceRefs":[{"raw":"Josh.21.23","value":"Josh.21.23"}],"t":"ref","v":"21:23"},"). Baasha killed King Nadab at Gibbethon when Israel was taking the city from the Philistines (",{"href":"?bref=1Kgs.15.27","r":"1Kgs.15.27","rawR":"1Kgs.15.27","sourceRefs":[{"raw":"1Kgs.15.27","value":"1Kgs.15.27"}],"t":"ref","v":"1 Kgs 15:27"},"). About 26 years later, Omri was proclaimed king at Gibbethon (",{"href":"?bref=1Kgs.16.17","r":"1Kgs.16.17","rawR":"1Kgs.16.17","sourceRefs":[{"raw":"1Kgs.16.17","value":"1Kgs.16.17"}],"t":"ref","v":"16:17"},")."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=LeviticalCities_Article_TyndaleOpenBibleDictionary","id":"LeviticalCities_Article_TyndaleOpenBibleDictionary","rawId":"LeviticalCities_Article_TyndaleOpenBibleDictionary","t":"link","v":"Levitical Cities"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Gibbethon","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 19:44","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.19.44","rawQueryValue":"Josh.19.44","sourceRefExact":"Josh.19.44"},{"anchorText":"21:23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.21.23","rawQueryValue":"Josh.21.23","sourceRefExact":"Josh.21.23"},{"anchorText":"1 Kgs 15:27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.15.27","rawQueryValue":"1Kgs.15.27","sourceRefExact":"1Kgs.15.27"},{"anchorText":"16:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.16.17","rawQueryValue":"1Kgs.16.17","sourceRefExact":"1Kgs.16.17"}],"sourceItemFragmentSha256":"8e927112afd42d0e3ee676da0a388adb8e4076cc50fa7464476ce33425c1b598","sourceItemName":"Gibbethon","sourceItemOrder":121,"sourceMember":"Articles/G.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Gibbethon","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Gibbethon","title":"Gibbethon","version":"v2-a101d843a2f0cd3fc0c6"}