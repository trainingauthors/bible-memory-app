{"content":[{"c":["ZELOPHEHAD"],"sourceClass":"h1","t":"p"},{"c":["Hepher’s son from Manasseh’s tribe. He fathered five daughters but no sons (",{"href":"?bref=Num.26.33","r":"Num.26.33","rawR":"Num.26.33","sourceRefs":[{"raw":"Num.26.33","value":"Num.26.33"}],"t":"ref","v":"Nm 26:33"},"). Because Zelophehad had no sons, his daughters petitioned Moses to give them their father’s inheritance (",{"href":"?bref=Num.27.1","r":"Num.27.1","rawR":"Num.27.1","sourceRefs":[{"raw":"Num.27.1","value":"Num.27.1"}],"t":"ref","v":"27:1"},"). Moses’ subsequent ruling provided that daughters should receive the inheritance in such cases, providing that they marry within their tribe so that the tribal allotments would remain constant (",{"href":"?bref=Num.27.7","r":"Num.27.7","rawR":"Num.27.7","sourceRefs":[{"raw":"Num.27.7","value":"Num.27.7"}],"t":"ref","v":"Nm 27:7"},"; ",{"href":"?bref=Num.36.2","r":"Num.36.2","rawR":"Num.36.2","sourceRefs":[{"raw":"Num.36.2","value":"Num.36.2"}],"t":"ref","v":"36:2"},"; ",{"href":"?bref=Josh.17.3","r":"Josh.17.3","rawR":"Josh.17.3","sourceRefs":[{"raw":"Josh.17.3","value":"Josh.17.3"}],"t":"ref","v":"Jos 17:3"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Zelophehad","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Nm 26:33","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.26.33","rawQueryValue":"Num.26.33","sourceRefExact":"Num.26.33"},{"anchorText":"27:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.27.1","rawQueryValue":"Num.27.1","sourceRefExact":"Num.27.1"},{"anchorText":"Nm 27:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.27.7","rawQueryValue":"Num.27.7","sourceRefExact":"Num.27.7"},{"anchorText":"36:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.36.2","rawQueryValue":"Num.36.2","sourceRefExact":"Num.36.2"},{"anchorText":"Jos 17:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.17.3","rawQueryValue":"Josh.17.3","sourceRefExact":"Josh.17.3"}],"sourceItemFragmentSha256":"5a818ef2d6c29094956c092586ab1304af6565ed98eebb136ea41fff5c3f3c23","sourceItemName":"Zelophehad","sourceItemOrder":67,"sourceMember":"Articles/Z.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Zelophehad","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Zelophehad","title":"Zelophehad","version":"v2-a101d843a2f0cd3fc0c6"}