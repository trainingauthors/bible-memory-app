{"content":[{"c":["JOSHAPHAT"],"sourceClass":"h1","t":"p"},{"c":["1. Mithnite (",{"c":["nlt"],"sourceClass":"sc","t":"span"}," “from Mithna”) and one of David’s mighty men (",{"href":"?bref=1Chr.11.43","r":"1Chr.11.43","rawR":"1Chr.11.43","sourceRefs":[{"raw":"1Chr.11.43","value":"1Chr.11.43"}],"t":"ref","v":"1 Chr 11:43"},")."],"sourceClass":"list","t":"p"},{"c":["2. One of the seven priests assigned to blow a trumpet before the ark of God in the procession led by David when the ark was brought to Jerusalem (",{"href":"?bref=1Chr.15.24","r":"1Chr.15.24","rawR":"1Chr.15.24","sourceRefs":[{"raw":"1Chr.15.24","value":"1Chr.15.24"}],"t":"ref","v":"1 Chr 15:24"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Joshaphat","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 11:43","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.11.43","rawQueryValue":"1Chr.11.43","sourceRefExact":"1Chr.11.43"},{"anchorText":"1 Chr 15:24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.15.24","rawQueryValue":"1Chr.15.24","sourceRefExact":"1Chr.15.24"}],"sourceItemFragmentSha256":"4b92261615b975fc5d2ea1a4e69d00cb5dde73e1a7039b103b466b5ddf9068c7","sourceItemName":"Joshaphat","sourceItemOrder":324,"sourceMember":"Articles/J.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Joshaphat","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Joshaphat","title":"Joshaphat","version":"v2-a101d843a2f0cd3fc0c6"}