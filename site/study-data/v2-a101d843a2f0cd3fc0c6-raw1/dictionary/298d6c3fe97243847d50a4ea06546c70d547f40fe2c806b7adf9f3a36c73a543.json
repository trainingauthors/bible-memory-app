":"Ezek.29.17","sourceRefExact":"Ezek.29.17"},{"anchorText":"33–48","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.33.1-48.35","rawQueryValue":"Ezek.33.1-48.35","sourceRefExact":"Ezek.33.1-48.35"},{"anchorText":"32:1, 17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.32.1,17","rawQueryValue":"Ezek.32.1,17","sourceRefExact":"Ezek.32.1,17"},{"anchorText":"33:21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.33.21","rawQueryValue":"Ezek.33.21","sourceRefExact":"Ezek.33.21"},{"anchorText":"40:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.40.1","rawQueryValue":"Ezek.40.1","sourceRefExact":"Ezek.40.1"},{"anchorText":"33:21-22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.33.21-22","rawQueryValue":"Ezek.33.21-22","sourceRefExact":"Ezek.33.21-22"},{"anchorText":"2:8–3:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.2.8-3.3","rawQueryValue":"Ezek.2.8-3.3","sourceRefExact":"Ezek.2.8-3.3"},{"anchorText":"4:1-8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.4.1-8","rawQueryValue":"Ezek.4.1-8","sourceRefExact":"Ezek.4.1-8"},{"anchorText":"5:1-17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.5.1-17","rawQueryValue":"Ezek.5.1-17","sourceRefExact":"Ezek.5.1-17"}],"sourceItemFragmentSha256":"4648d98ee4266178cdc6bb723d90c2ce01bf630d676070d251b861611f318dd6","sourceItemName":"EzekielPerson","sourceItemOrder":305,"sourceMember":"Articles/E.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"EzekielPerson","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Ezekiel (Person)","title":"Ezekiel (Person)","version":"v2-a101d843a2f0cd3fc0c6"}