{"content":[{"c":["JOEZER"],"sourceClass":"h1","t":"p"},{"c":["Warrior who joined David at Ziklag in his struggle against King Saul. He was one of David’s ambidextrous archers and slingers (",{"href":"?bref=1Chr.12.6","r":"1Chr.12.6","rawR":"1Chr.12.6","sourceRefs":[{"raw":"1Chr.12.6","value":"1Chr.12.6"}],"t":"ref","v":"1 Chr 12:6"},"). He was called a Korahite, which probably refers to his place of origin."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Joezer","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 12:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.12.6","rawQueryValue":"1Chr.12.6","sourceRefExact":"1Chr.12.6"}],"sourceItemFragmentSha256":"116668cb63fc647fb9ee1dab195a7253d382d0a065cadba43ab8127d4c3fae79","sourceItemName":"Joezer","sourceItemOrder":273,"sourceMember":"Articles/J.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Joezer","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Joezer","title":"Joezer","version":"v2-a101d843a2f0cd3fc0c6"}