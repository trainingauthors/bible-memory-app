{"content":[{"c":["SHIMRON (P",{"c":["lace"],"sourceClass":"lc","t":"span"},")"],"sourceClass":"h1","t":"p"},{"c":["Canaanite town whose king joined the confederacy of King Jabin of Hazor in unsuccessful resistance to the Israelites under Joshua (",{"href":"?bref=Josh.11.1","r":"Josh.11.1","rawR":"Josh.11.1","sourceRefs":[{"raw":"Josh.11.1","value":"Josh.11.1"}],"t":"ref","v":"Jos 11:1"},"). Its site is uncertain, though it was in Zebulun’s territory (",{"href":"?bref=Josh.19.15-16","r":"Josh.19.15-16","rawR":"Josh.19.15-16","sourceRefs":[{"raw":"Josh.19.15-16","value":"Josh.19.15-16"}],"t":"ref","v":"19:15-16"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"ShimronPlace","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 11:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.11.1","rawQueryValue":"Josh.11.1","sourceRefExact":"Josh.11.1"},{"anchorText":"19:15-16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.19.15-16","rawQueryValue":"Josh.19.15-16","sourceRefExact":"Josh.19.15-16"}],"sourceItemFragmentSha256":"850740b6020ea6efea87bf2e6fd1dfdbde20f5c1d0aeaf0c7d824eae4c33e2bf","sourceItemName":"ShimronPlace","sourceItemOrder":342,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"ShimronPlace","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Shimron (Place)","title":"Shimron (Place)","version":"v2-a101d843a2f0cd3fc0c6"}