{"content":[{"c":["AGABUS"],"sourceClass":"h1","t":"p"},{"c":["Prophet of NT times who made two predictions referred to in the book of Acts. His prophecy of a severe famine was fulfilled in the time of Claudius (",{"href":"?bref=Acts.11.27-28","r":"Acts.11.27-28","rawR":"Acts.11.27-28","sourceRefs":[{"raw":"Acts.11.27-28","value":"Acts.11.27-28"}],"t":"ref","v":"Acts 11:27-28"},"). He also predicted that Paul would be turned over to the Gentiles by the Jews in Jerusalem if he went there (",{"href":"?bref=Acts.21.10-11","r":"Acts.21.10-11","rawR":"Acts.21.10-11","sourceRefs":[{"raw":"Acts.21.10-11","value":"Acts.21.10-11"}],"t":"ref","v":"Acts 21:10-11"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Agabus","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Acts 11:27-28","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.11.27-28","rawQueryValue":"Acts.11.27-28","sourceRefExact":"Acts.11.27-28"},{"anchorText":"Acts 21:10-11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.21.10-11","rawQueryValue":"Acts.21.10-11","sourceRefExact":"Acts.21.10-11"}],"sourceItemFragmentSha256":"e2b5036ab2dd2272008ac5da3a8f1d074a00e9cc6c4dba9da12c2074d714111e","sourceItemName":"Agabus","sourceItemOrder":155,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Agabus","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Agabus","title":"Agabus","version":"v2-a101d843a2f0cd3fc0c6"}