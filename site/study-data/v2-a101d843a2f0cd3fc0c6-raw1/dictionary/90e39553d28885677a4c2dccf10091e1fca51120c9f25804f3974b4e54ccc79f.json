{"content":[{"c":["NAHALAL"],"sourceClass":"h1","t":"p"},{"c":["City in Zebulun’s territory (",{"href":"?bref=Josh.19.15","r":"Josh.19.15","rawR":"Josh.19.15","sourceRefs":[{"raw":"Josh.19.15","value":"Josh.19.15"}],"t":"ref","v":"Jos 19:15"},"), given to the Levites for an inheritance (",{"href":"?bref=Josh.21.35","r":"Josh.21.35","rawR":"Josh.21.35","sourceRefs":[{"raw":"Josh.21.35","value":"Josh.21.35"}],"t":"ref","v":"21:35"},"). Zebulun’s tribe was unable to drive the Canaanites from the city, so they forced them into hard labor (",{"href":"?bref=Judg.1.30","r":"Judg.1.30","rawR":"Judg.1.30","sourceRefs":[{"raw":"Judg.1.30","value":"Judg.1.30"}],"t":"ref","v":"Jgs 1:30"},", “Nahalol”). The exact location of the city is unknown. Some possible locations include Tell el-Beida, south of modern Nahalal, and Tell en-Nahl, north of the Kishon River and near the southern end of the plain of Acco, near modern Nahalal."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=LeviticalCities_Article_TyndaleOpenBibleDictionary","id":"LeviticalCities_Article_TyndaleOpenBibleDictionary","rawId":"LeviticalCities_Article_TyndaleOpenBibleDictionary","t":"link","v":"Levitical Cities"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Nahalal","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 19:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.19.15","rawQueryValue":"Josh.19.15","sourceRefExact":"Josh.19.15"},{"anchorText":"21:35","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.21.35","rawQueryValue":"Josh.21.35","sourceRefExact":"Josh.21.35"},{"anchorText":"Jgs 1:30","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.1.30","rawQueryValue":"Judg.1.30","sourceRefExact":"Judg.1.30"}],"sourceItemFragmentSha256":"5caf727ee043d4bed31458554754fcb1f2c814da803f15e7f613d9b837d51d59","sourceItemName":"Nahalal","sourceItemOrder":23,"sourceMember":"Articles/N.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Nahalal","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Nahalal","title":"Nahalal","version":"v2-a101d843a2f0cd3fc0c6"}