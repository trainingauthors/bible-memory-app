{"content":[{"c":["GIBBAR"],"sourceClass":"h1","t":"p"},{"c":["Forefather of a family that returned to Jerusalem with Zerubbabel (",{"href":"?bref=Ezra.2.20","r":"Ezra.2.20","rawR":"Ezra.2.20","sourceRefs":[{"raw":"Ezra.2.20","value":"Ezra.2.20"}],"t":"ref","v":"Ezr 2:20"},"). The parallel list in ",{"href":"?bref=Neh.7.25","r":"Neh.7.25","rawR":"Neh.7.25","sourceRefs":[{"raw":"Neh.7.25","value":"Neh.7.25"}],"t":"ref","v":"Nehemiah 7:25"}," reads “sons of Gibeon,” suggesting that “Gibbar” may be a textual corruption. Some support for this view lies in the fact that ",{"href":"?bref=Ezra.2.21","r":"Ezra.2.21","rawR":"Ezra.2.21","sourceRefs":[{"raw":"Ezra.2.21","value":"Ezra.2.21"}],"t":"ref","v":"Ezra 2:21"}," begins listing descendants by their home city rather than by family."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Gibbar","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ezr 2:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.2.20","rawQueryValue":"Ezra.2.20","sourceRefExact":"Ezra.2.20"},{"anchorText":"Nehemiah 7:25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.7.25","rawQueryValue":"Neh.7.25","sourceRefExact":"Neh.7.25"},{"anchorText":"Ezra 2:21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.2.21","rawQueryValue":"Ezra.2.21","sourceRefExact":"Ezra.2.21"}],"sourceItemFragmentSha256":"96c66b8d57d828e97333fd074255e2aa027b0427e4e5e65da4b0b70912e5536a","sourceItemName":"Gibbar","sourceItemOrder":120,"sourceMember":"Articles/G.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Gibbar","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Gibbar","title":"Gibbar","version":"v2-a101d843a2f0cd3fc0c6"}