{"content":[{"c":["ETHNARCH"],"sourceClass":"h1","t":"p"},{"c":["Title given to one who rules by the authority of another country. Ethnarch was a position below a king but above a tetrarch or governor. Three ethnarchs who ruled in Palestine were Simon, during the Maccabean period (",{"href":"?bref=1Macc.14.47","r":"1Macc.14.47","rawR":"1Macc.14.47","sourceRefs":[{"raw":"1Macc.14.47","value":"1Macc.14.47"}],"t":"ref","v":"1 Macc 14:47"},"), Archelaus in the time of Jesus (",{"href":"?bref=Matt.2.22","r":"Matt.2.22","rawR":"Matt.2.22","sourceRefs":[{"raw":"Matt.2.22","value":"Matt.2.22"}],"t":"ref","v":"Mt 2:22"},"), and one in Damascus during the life of the apostle Paul (",{"href":"?bref=2Cor.11.32","r":"2Cor.11.32","rawR":"2Cor.11.32","sourceRefs":[{"raw":"2Cor.11.32","value":"2Cor.11.32"}],"t":"ref","v":"2 Cor 11:32"},", ",{"c":["nasb"],"sourceClass":"sc","t":"span"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Ethnarch","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Macc 14:47","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Macc.14.47","rawQueryValue":"1Macc.14.47","sourceRefExact":"1Macc.14.47"},{"anchorText":"Mt 2:22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.2.22","rawQueryValue":"Matt.2.22","sourceRefExact":"Matt.2.22"},{"anchorText":"2 Cor 11:32","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Cor.11.32","rawQueryValue":"2Cor.11.32","sourceRefExact":"2Cor.11.32"}],"sourceItemFragmentSha256":"029610b10a1dd9982671ea3033f9c3143853e5807770252d51a3bc8bb943e204","sourceItemName":"Ethnarch","sourceItemOrder":266,"sourceMember":"Articles/E.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Ethnarch","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Ethnarc