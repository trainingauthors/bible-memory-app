{"content":[{"c":["SHEREBIAH"],"sourceClass":"h1","t":"p"},{"c":["1. Levite, a descendant of Mahli. Sherebiah, described as a man of understanding, was sent as a priest for the temple at Jerusalem following the exile (",{"href":"?bref=Ezra.8.18","r":"Ezra.8.18","rawR":"Ezra.8.18","sourceRefs":[{"raw":"Ezra.8.18","value":"Ezra.8.18"}],"t":"ref","v":"Ezr 8:18"},"; ",{"href":"?bref=Neh.12.8","r":"Neh.12.8","rawR":"Neh.12.8","sourceRefs":[{"raw":"Neh.12.8","value":"Neh.12.8"}],"t":"ref","v":"Neh 12:8"},"). During the return journey, he was one of 12 chief priests appointed to guard the silver, gold, and vessels presented for temple use (",{"href":"?bref=Ezra.8.24","r":"Ezra.8.24","rawR":"Ezra.8.24","sourceRefs":[{"raw":"Ezra.8.24","value":"Ezra.8.24"}],"t":"ref","v":"Ezr 8:24"},")."],"sourceClass":"list","t":"p"},{"c":["2. One who helped the people understand the law read by Ezra (",{"href":"?bref=Neh.8.7","r":"Neh.8.7","rawR":"Neh.8.7","sourceRefs":[{"raw":"Neh.8.7","value":"Neh.8.7"}],"t":"ref","v":"Neh 8:7"},"), and among the Levites who stood on the stairs leading the praise service (",{"href":"?bref=Neh.9.4-5","r":"Neh.9.4-5","rawR":"Neh.9.4-5","sourceRefs":[{"raw":"Neh.9.4-5","value":"Neh.9.4-5"}],"t":"ref","v":"9:4-5"},")."],"sourceClass":"list","t":"p"},{"c":["3. One of the leaders of the Levites who led the songs of praise and thanksgiving (",{"href":"?bref=Neh.12.24","r":"Neh.12.24","rawR":"Neh.12.24","sourceRefs":[{"raw":"Neh.12.24","value":"Neh.12.24"}],"t":"ref","v":"Neh 12:24"},")."],"sourceClass":"list","t":"p"},{"c":["It is possible that the above references refer to the same person."],"sourceClass":"sp","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Sherebiah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ezr 8:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.8.18","rawQueryValue":"Ezra.8.18","sourceRefExact":"Ezra.8.18"},{"anchorText":"Neh 12:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.12.8","rawQueryValue":"Neh.12.8","sourceRefExact":"Neh.12.8"},{"anchorText":"Ezr 8:24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.8.24","rawQueryValue":"Ezra.8.24","sourceRefExact":"Ezra.8.24"},{"anchorText":"Neh 8:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.8.7","rawQueryValue":"Neh.8.7","sourceRefExact":"Neh.8.7"},{"anchorText":"9:4-5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.9.4-5","rawQueryValue":"Neh.9.4-5","sourceRefExact":"Neh.9.4-5"},{"anchorText":"Neh 12:24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.12.24","rawQueryValue":"Neh.12.24","sourceRefExact":"Neh.12.24"}],"sourceItemFragmentSha256":"e2efcb9518d0ba4fe2d771bf53095a0ac9b186e96d96e5d91e773c20f5b156f1","sourceItemName":"Sherebiah","sourceItemOrder":297,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Sherebiah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Sherebiah","title":"Sherebiah","version":"v2-a101d843a2f0cd3fc0c6"}