{"content":[{"c":["DISH"],"sourceClass":"h1","t":"p"},{"c":["A vessel, usually made of baked clay or metal, used in everyday life and in religious ceremony. Dishes were used to serve or preserve food (",{"href":"?bref=Judg.5.25","r":"Judg.5.25","rawR":"Judg.5.25","sourceRefs":[{"raw":"Judg.5.25","value":"Judg.5.25"}],"t":"ref","v":"Jgs 5:25"},"; ",{"href":"?bref=Matt.26.23","r":"Matt.26.23","rawR":"Matt.26.23","sourceRefs":[{"raw":"Matt.26.23","value":"Matt.26.23"}],"t":"ref","v":"Mt 26:23"},"; ",{"href":"?bref=Mark.14.20","r":"Mark.14.20","rawR":"Mark.14.20","sourceRefs":[{"raw":"Mark.14.20","value":"Mark.14.20"}],"t":"ref","v":"Mk 14:20"},"). They had to be wiped and left to dry (",{"href":"?bref=2Kgs.21.13","r":"2Kgs.21.13","rawR":"2Kgs.21.13","sourceRefs":[{"raw":"2Kgs.21.13","value":"2Kgs.21.13"}],"t":"ref","v":"2 Kgs 21:13"},"), but later the Pharisees added a ritual cleansing as well (",{"href":"?bref=Matt.23.25-26","r":"Matt.23.25-26","rawR":"Matt.23.25-26","sourceRefs":[{"raw":"Matt.23.25-26","value":"Matt.23.25-26"}],"t":"ref","v":"Mt 23:25-26"},"; ",{"href":"?bref=Luke.11.39","r":"Luke.11.39","rawR":"Luke.11.39","sourceRefs":[{"raw":"Luke.11.39","value":"Luke.11.39"}],"t":"ref","v":"Lk 11:39"},"). Dishes were used in connection with the meal offering (",{"href":"?bref=Num.7.13","r":"Num.7.13","rawR":"Num.7.13","sourceRefs":[{"raw":"Num.7.13","value":"Num.7.13"}],"t":"ref","v":"Nm 7:13"},") and with the table of showbread for worship in the OT tabernacle and temple (",{"href":"?bref=Exod.25.29","r":"Exod.25.29","rawR":"Exod.25.29","sourceRefs":[{"raw":"Exod.25.29","value":"Exod.25.29"}],"t":"ref","v":"Ex 25:29"},"; ",{"href":"?bref=Exod.37.16","r":"Exod.37.16","rawR":"Exod.37.16","sourceRefs":[{"raw":"Exod.37.16","value":"Exod.37.16"}],"t":"ref","v":"37:16"},"; ",{"href":"?bref=Num.4.7","r":"Num.4.7","rawR":"Num.4.7","sourceRefs":[{"raw":"Num.4.7","value":"Num.4.7"}],"t":"ref","v":"Nm 4:7"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Dish","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jgs 5:25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.5.25","rawQueryValue":"Judg.5.25","sourceRefExact":"Judg.5.25"},{"anchorText":"Mt 26:23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.26.23","rawQueryValue":"Matt.26.23","sourceRefExact":"Matt.26.23"},{"anchorText":"Mk 14:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mark.14.20","rawQueryValue":"Mark.14.20","sourceRefExact":"Mark.14.20"},{"anchorText":"2 Kgs 21:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.21.13","rawQueryValue":"2Kgs.21.13","sourceRefExact":"2Kgs.21.13"},{"anchorText":"Mt 23:25-26","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.23.25-26","rawQueryValue":"Matt.23.25-26","sourceRefExact":"Matt.23.25-26"},{"anchorText":"Lk 11:39","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.11.39","rawQueryValue":"Luke.11.39","sourceRefExact":"Luke.11.39"},{"anchorText":"Nm 7:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.7.13","rawQueryValue":"Num.7.13","sourceRefExact":"Num.7.13"},{"anchorText":"Ex 25:29","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.25.29","rawQueryValue":"Exod.25.29","sourceRefExact":"Exod.25.29"},{"anchorText":"37:16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.37.16","rawQueryValue":"Exod.37.16","sourceRefExact":"Exod.37.16"},{"anchorText":"Nm 4:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.4.7","rawQueryValue":"Num.4.7","sourceRefExact":"Num.4.7"}],"sourceItemFragmentSha256":"022012cfa2977149e8144e145b15c9b21