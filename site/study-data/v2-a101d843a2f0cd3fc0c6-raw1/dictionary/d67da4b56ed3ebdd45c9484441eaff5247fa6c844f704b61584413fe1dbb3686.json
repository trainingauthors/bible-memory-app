{"content":[{"c":["ADRIEL"],"sourceClass":"h1","t":"p"},{"c":["Barzillai’s son, to whom Saul gave his daughter Merab in marriage, although she had been promised to David (",{"href":"?bref=1Sam.18.19","r":"1Sam.18.19","rawR":"1Sam.18.19","sourceRefs":[{"raw":"1Sam.18.19","value":"1Sam.18.19"}],"t":"ref","v":"1 Sm 18:19"},"). King David later handed over Adriel’s five sons to the Gibeonites to execute in vengeance against Saul’s family (",{"href":"?bref=2Sam.21.1-9","r":"2Sam.21.1-9","rawR":"2Sam.21.1-9","sourceRefs":[{"raw":"2Sam.21.1-9","value":"2Sam.21.1-9"}],"t":"ref","v":"2 Sm 21:1-9"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Adriel","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Sm 18:19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.18.19","rawQueryValue":"1Sam.18.19","sourceRefExact":"1Sam.18.19"},{"anchorText":"2 Sm 21:1-9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.21.1-9","rawQueryValue":"2Sam.21.1-9","sourceRefExact":"2Sam.21.1-9"}],"sourceItemFragmentSha256":"50d9abba1e7a5c474bcc8f2012ed7605a7fffd85d0d686c7cadb40e53901a4ca","sourceItemName":"Adriel","sourceItemOrder":141,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Adriel","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Adriel","title":"Adriel","version":"v2-a101d843a2f0cd3fc0c6"}