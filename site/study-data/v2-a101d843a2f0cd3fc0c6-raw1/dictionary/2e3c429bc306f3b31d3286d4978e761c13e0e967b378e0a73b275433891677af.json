{"content":[{"c":["SHOMER"],"sourceClass":"h1","t":"p"},{"c":["1. Father (",{"href":"?bref=2Kgs.12.21","r":"2Kgs.12.21","rawR":"2Kgs.12.21","sourceRefs":[{"raw":"2Kgs.12.21","value":"2Kgs.12.21"}],"t":"ref","v":"2 Kgs 12:21"},"), or perhaps the Moabite mother (",{"href":"?bref=2Chr.24.26","r":"2Chr.24.26","rawR":"2Chr.24.26","sourceRefs":[{"raw":"2Chr.24.26","value":"2Chr.24.26"}],"t":"ref","v":"2 Chr 24:26"},"), of Jehozabad, a royal servant, who, with Jozacar, conspired against and murdered Joash, king of Judah. Shimrith is the feminine form of Shomer. ",{"c":["See"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Shimrith_Article_TyndaleOpenBibleDictionary","id":"Shimrith_Article_TyndaleOpenBibleDictionary","rawId":"Shimrith_Article_TyndaleOpenBibleDictionary","t":"link","v":"Shimrith"},"."],"sourceClass":"list","t":"p"},{"c":["2. Alternate name for Shemer, Heber’s son, in ",{"href":"?bref=1Chr.7.34","r":"1Chr.7.34","rawR":"1Chr.7.34","sourceRefs":[{"raw":"1Chr.7.34","value":"1Chr.7.34"}],"t":"ref","v":"1 Chronicles 7:34"},". ",{"c":["See"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Shemer_Article_TyndaleOpenBibleDictionary","id":"Shemer_Article_TyndaleOpenBibleDictionary","rawId":"Shemer_Article_TyndaleOpenBibleDictionary","t":"link","v":"Shemer #3"},"."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Shomer","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Kgs 12:21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.12.21","rawQueryValue":"2Kgs.12.21","sourceRefExact":"2Kgs.12.21"},{"anchorText":"2 Chr 24:26","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.24.26","rawQueryValue":"2Chr.24.26","sourceRefExact":"2Chr.24.26"},{"anchorText":"1 Chronicles 7:34","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.7