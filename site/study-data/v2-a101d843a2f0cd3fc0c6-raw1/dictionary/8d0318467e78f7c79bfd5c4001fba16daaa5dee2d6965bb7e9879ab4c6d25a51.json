=1Chr.16.42","rawQueryValue":"1Chr.16.42","sourceRefExact":"1Chr.16.42"},{"anchorText":"Deuteronomy 33:8-11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.33.8-11","rawQueryValue":"Deut.33.8-11","sourceRefExact":"Deut.33.8-11"},{"anchorText":"2 Chr 17:7-9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.17.7-9","rawQueryValue":"2Chr.17.7-9","sourceRefExact":"2Chr.17.7-9"},{"anchorText":"Jgs 17:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.17.13","rawQueryValue":"Judg.17.13","sourceRefExact":"Judg.17.13"},{"anchorText":"Jeremiah 33:20-26","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.33.20-26","rawQueryValue":"Jer.33.20-26","sourceRefExact":"Jer.33.20-26"},{"anchorText":"Malachi 3:3-4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mal.3.3-4","rawQueryValue":"Mal.3.3-4","sourceRefExact":"Mal.3.3-4"},{"anchorText":"Ezr 2:36-42","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.2.36-42","rawQueryValue":"Ezra.2.36-42","sourceRefExact":"Ezra.2.36-42"},{"anchorText":"Acts 4:36","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.4.36","rawQueryValue":"Acts.4.36","sourceRefExact":"Acts.4.36"}],"sourceItemFragmentSha256":"03b5ffe9deb70c2cb779114d0a2c7edc3381abac234ff75515a4a88d25218625","sourceItemName":"LeviTribeof","sourceItemOrder":77,"sourceMember":"Articles/L.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"LeviTribeof","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Levi, Tribe of","title":"Levi, Tribe of","version":"v2-a101d843a2f0cd3fc0c6"}