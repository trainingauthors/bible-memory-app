n":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.2.1-7","rawQueryValue":"2Sam.2.1-7","sourceRefExact":"2Sam.2.1-7"},{"anchorText":"2 Sm 2:8-9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.2.8-9","rawQueryValue":"2Sam.2.8-9","sourceRefExact":"2Sam.2.8-9"},{"anchorText":"8:11-12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.8.11-12","rawQueryValue":"2Sam.8.11-12","sourceRefExact":"2Sam.8.11-12"},{"anchorText":"10:1-19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.10.1-19","rawQueryValue":"2Sam.10.1-19","sourceRefExact":"2Sam.10.1-19"},{"anchorText":"15–17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.15.1-17.29","rawQueryValue":"2Sam.15.1-17.29","sourceRefExact":"2Sam.15.1-17.29"},{"anchorText":"18–19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.18.1-19.43","rawQueryValue":"2Sam.18.1-19.43","sourceRefExact":"2Sam.18.1-19.43"},{"anchorText":"1 Kgs 20:23-43","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.20.23-43","rawQueryValue":"1Kgs.20.23-43","sourceRefExact":"1Kgs.20.23-43"},{"anchorText":"22:1-4, 29-40","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.22.1-4,29-40","rawQueryValue":"1Kgs.22.1-4,29-40","sourceRefExact":"1Kgs.22.1-4,29-40"},{"anchorText":"2 Kgs 13:22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.13.22","rawQueryValue":"2Kgs.13.22","sourceRefExact":"2Kgs.13.22"},{"anchorText":"Am 1:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Amos.1.3","rawQueryValue":"Amos.1.3","sourceRefExact":"Amos.1.3"},{"anchorText":"2 Kgs 15:27-31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.15.27-31","rawQueryValue":"2Kgs.15.27-31","sourceRefExact":"2