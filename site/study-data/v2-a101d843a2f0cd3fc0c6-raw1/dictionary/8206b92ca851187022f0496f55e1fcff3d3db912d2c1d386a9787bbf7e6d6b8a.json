{"content":[{"c":["AHI"],"sourceClass":"h1","t":"p"},{"c":["1. Abdiel’s son, a clan leader in Gad’s tribe (",{"href":"?bref=1Chr.5.15","r":"1Chr.5.15","rawR":"1Chr.5.15","sourceRefs":[{"raw":"1Chr.5.15","value":"1Chr.5.15"}],"t":"ref","v":"1 Chr 5:15"},")."],"sourceClass":"list","t":"p"},{"c":["2. Shemer’s brother and therefore a member of Asher’s tribe (",{"href":"?bref=1Chr.7.34","r":"1Chr.7.34","rawR":"1Chr.7.34","sourceRefs":[{"raw":"1Chr.7.34","value":"1Chr.7.34"}],"t":"ref","v":"1 Chr 7:34"},"). The word “Ahi” in this verse, however, is probably not a name and should be translated “brother,” as in most modern translations."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Ahi","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 5:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.5.15","rawQueryValue":"1Chr.5.15","sourceRefExact":"1Chr.5.15"},{"anchorText":"1 Chr 7:34","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.7.34","rawQueryValue":"1Chr.7.34","sourceRefExact":"1Chr.7.34"}],"sourceItemFragmentSha256":"c2bbf5b1e44e832d297d1082878e4cedefd7977d75d0f7dcfe40eb932f277c45","sourceItemName":"Ahi","sourceItemOrder":179,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Ahi","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Ahi","title":"Ahi","version":"v2-a101d843a2f0cd3fc0c6"}