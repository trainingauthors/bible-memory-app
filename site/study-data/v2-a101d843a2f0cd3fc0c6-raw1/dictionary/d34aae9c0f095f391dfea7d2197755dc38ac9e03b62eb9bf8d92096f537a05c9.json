{"content":[{"c":["DERBE"],"sourceClass":"h1","t":"p"},{"c":["A city of the Roman province of Asia located in the district of Lycaonia (",{"href":"?bref=Acts.14.6","r":"Acts.14.6","rawR":"Acts.14.6","sourceRefs":[{"raw":"Acts.14.6","value":"Acts.14.6"}],"t":"ref","v":"Acts 14:6"},") in the province of Galatia. Derbe was the last city on Paul’s first missionary journey (v ",{"href":"?bref=Acts.14.20","r":"Acts.14.20","rawR":"Acts.14.20","sourceRefs":[{"raw":"Acts.14.20","value":"Acts.14.20"}],"t":"ref","v":"20"},"), the first city on his second journey (",{"href":"?bref=Acts.16.1","r":"Acts.16.1","rawR":"Acts.16.1","sourceRefs":[{"raw":"Acts.16.1","value":"Acts.16.1"}],"t":"ref","v":"16:1"},"), and likely one city he revisited on his third journey (",{"href":"?bref=Acts.18.23","r":"Acts.18.23","rawR":"Acts.18.23","sourceRefs":[{"raw":"Acts.18.23","value":"Acts.18.23"}],"t":"ref","v":"18:23"},"). Gaius, one of Paul’s missionary companions on his third journey, was from Derbe (",{"href":"?bref=Acts.20.4","r":"Acts.20.4","rawR":"Acts.20.4","sourceRefs":[{"raw":"Acts.20.4","value":"Acts.20.4"}],"t":"ref","v":"20:4"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Derbe","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Acts 14:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.14.6","rawQueryValue":"Acts.14.6","sourceRefExact":"Acts.14.6"},{"anchorText":"20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.14.20","rawQueryValue":"Acts.14.20","sourceRefExact":"Acts.14.20"},{"anchorText":"16:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.16.1","rawQueryValue":"Acts.16.1","sourceRefExact":"Acts.16.1"},{"anchorText":"18:23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.18.23","rawQueryValue":"Acts.18.23","sourceRefExact":"Acts.18.23"},{"anchorText":"20:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.20.4","rawQueryValue":"Acts.20.4","sourceRefExact":"Acts.20.4"}],"sourceItemFragmentSha256":"3cbd42bbad004b3afade36dcd3a5890c2bc0d7bd0cdc90426f46cfeff9b1d306","sourceItemName":"Derbe","sourceItemOrder":82,"sourceMember":"Articles/D.xml","supplementPointersNotIncludedAsContent":[{"name":"Derbe","src":"../Maps/Maps.xml"}]},"sourceAttributes":{"name":"Derbe","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Derbe","title":"Derbe","version":"v2-a101d843a2f0cd3fc0c6"}