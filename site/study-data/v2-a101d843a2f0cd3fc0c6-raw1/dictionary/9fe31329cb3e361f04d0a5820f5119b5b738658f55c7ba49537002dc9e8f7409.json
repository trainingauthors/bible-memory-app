.16","rawQueryValue":"2Sam.15.16","sourceRefExact":"2Sam.15.16"},{"anchorText":"1 Kgs 11:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.11.3","rawQueryValue":"1Kgs.11.3","sourceRefExact":"1Kgs.11.3"},{"anchorText":"2 Chr 11:21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.11.21","rawQueryValue":"2Chr.11.21","sourceRefExact":"2Chr.11.21"},{"anchorText":"Est 2:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Esth.2.14","rawQueryValue":"Esth.2.14","sourceRefExact":"Esth.2.14"},{"anchorText":"Dn 5:2-3, 23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Dan.5.2-3,23","rawQueryValue":"Dan.5.2-3,23","sourceRefExact":"Dan.5.2-3,23"},{"anchorText":"Eccl 2:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Eccl.2.8","rawQueryValue":"Eccl.2.8","sourceRefExact":"Eccl.2.8"},{"anchorText":"Mt 19:1-9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.19.1-9","rawQueryValue":"Matt.19.1-9","sourceRefExact":"Matt.19.1-9"}],"sourceItemFragmentSha256":"27e938b476b2310660713bd89a04a55ca2e6fc620acfdd2c486b27ac7ac424fc","sourceItemName":"ConcubinageConcubines","sourceItemOrder":252,"sourceMember":"Articles/C.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"ConcubinageConcubines","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Concubinage*, Concubines","title":"Concubinage*, Concubines","version":"v2-a101d843a2f0cd3fc0c6"}