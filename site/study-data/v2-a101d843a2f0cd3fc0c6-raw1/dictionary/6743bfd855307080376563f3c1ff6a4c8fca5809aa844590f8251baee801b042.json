{"content":[{"c":["ITTAI"],"sourceClass":"h1","t":"p"},{"c":["1. Philistine from Gath who, with 600 other Gittites, remained loyal to David and accompanied him on his flight from Absalom (",{"href":"?bref=2Sam.15.18-22","r":"2Sam.15.18-22","rawR":"2Sam.15.18-22","sourceRefs":[{"raw":"2Sam.15.18-22","value":"2Sam.15.18-22"}],"t":"ref","v":"2 Sm 15:18-22"},"). Ittai commanded a third of David’s army in the battle against Absalom’s forces (",{"href":"?bref=2Sam.18.2,5","r":"2Sam.18.2,5","rawR":"2Sam.18.2,5","sourceRefs":[{"raw":"2Sam.18.2,5","value":"2Sam.18.2,5"}],"t":"ref","v":"18:2, 5"},")."],"sourceClass":"list","t":"p"},{"c":["2. Benjamite warrior among David’s mighty men (",{"href":"?bref=2Sam.23.29","r":"2Sam.23.29","rawR":"2Sam.23.29","sourceRefs":[{"raw":"2Sam.23.29","value":"2Sam.23.29"}],"t":"ref","v":"2 Sm 23:29"},"; ",{"href":"?bref=1Chr.11.31","r":"1Chr.11.31","rawR":"1Chr.11.31","sourceRefs":[{"raw":"1Chr.11.31","value":"1Chr.11.31"}],"t":"ref","v":"1 Chr 11:31"},", “Ithai”)."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Ittai","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Sm 15:18-22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.15.18-22","rawQueryValue":"2Sam.15.18-22","sourceRefExact":"2Sam.15.18-22"},{"anchorText":"18:2, 5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.18.2,5","rawQueryValue":"2Sam.18.2,5","sourceRefExact":"2Sam.18.2,5"},{"anchorText":"2 Sm 23:29","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.23.29","rawQueryValue":"2Sam.23.29","sourceRefExact":"2Sam.23.29"},{"anchorText":"1 Chr 11:31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.11.31","rawQueryValue":"1Chr.11.31","sourceRefExact":"1Chr.11.31"}],"sourceItemFragmentSha256":"042f4d8a7