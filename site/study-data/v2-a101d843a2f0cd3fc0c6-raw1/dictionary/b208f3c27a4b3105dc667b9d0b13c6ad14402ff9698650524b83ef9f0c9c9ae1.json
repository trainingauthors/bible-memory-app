{"content":[{"c":["MESHA (P",{"c":["lace"],"sourceClass":"lc","t":"span"},")"],"sourceClass":"h1","t":"p"},{"c":["Place in southern Arabia defining the western boundary of the territory in which the descendants of Joktan settled (",{"href":"?bref=Gen.10.30","r":"Gen.10.30","rawR":"Gen.10.30","sourceRefs":[{"raw":"Gen.10.30","value":"Gen.10.30"}],"t":"ref","v":"Gn 10:30"},"). Its location is unknown. Some suggest that Mesha was a seaport town situated along the eastern shores of the Red Sea in the vicinity of what is modern Yemen; others place it along the Persian Gulf’s northwestern banks near the region of Mesene."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"MeshaPlace","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 10:30","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.10.30","rawQueryValue":"Gen.10.30","sourceRefExact":"Gen.10.30"}],"sourceItemFragmentSha256":"bb82436575f0a726a5e7b0790c0b4e5c6196b0f059298bbf8ce3815807229782","sourceItemName":"MeshaPlace","sourceItemOrder":271,"sourceMember":"Articles/M.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"MeshaPlace","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Mesha (Place)","title":"Mesha (Place)","version":"v2-a101d843a2f0cd3fc0c6"}