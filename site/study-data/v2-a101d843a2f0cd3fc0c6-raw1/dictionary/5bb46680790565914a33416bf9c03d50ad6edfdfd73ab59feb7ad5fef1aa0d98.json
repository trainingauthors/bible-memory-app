{"content":[{"c":["AZBUK"],"sourceClass":"h1","t":"p"},{"c":["Father of the Nehemiah who was ruler of half the Beth-zur district (",{"href":"?bref=Neh.3.16","r":"Neh.3.16","rawR":"Neh.3.16","sourceRefs":[{"raw":"Neh.3.16","value":"Neh.3.16"}],"t":"ref","v":"Neh 3:16"},"). Azbuk’s son assisted the more famous Nehemiah, the governor (",{"href":"?bref=Neh.10.1","r":"Neh.10.1","rawR":"Neh.10.1","sourceRefs":[{"raw":"Neh.10.1","value":"Neh.10.1"}],"t":"ref","v":"Neh 10:1"},"), in rebuilding the wall of Jerusalem."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Azbuk","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Neh 3:16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.3.16","rawQueryValue":"Neh.3.16","sourceRefExact":"Neh.3.16"},{"anchorText":"Neh 10:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.10.1","rawQueryValue":"Neh.10.1","sourceRefExact":"Neh.10.1"}],"sourceItemFragmentSha256":"f5b5d1ec0d88fb74f85a3bca53ec838436026b127cdbed84aa9d4488f9a28600","sourceItemName":"Azbuk","sourceItemOrder":647,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Azbuk","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Azbuk","title":"Azbuk","version":"v2-a101d843a2f0cd3fc0c6"}