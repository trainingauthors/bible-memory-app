{"content":[{"c":["KIMHAM"],"sourceClass":"h1","t":"p"},{"c":["Son of Barzillai (according to Josephus), a very wealthy man who supplied David and his men with food while they were in Mahanaim during their flight from Absalom (",{"href":"?bref=2Sam.19.32","r":"2Sam.19.32","rawR":"2Sam.19.32","sourceRefs":[{"raw":"2Sam.19.32","value":"2Sam.19.32"}],"t":"ref","v":"2 Sm 19:32"},"). David offered to take Barzillai back to Jerusalem with him, but Barzillai declined and suggested that David show kindness to Kimham instead (vv ",{"href":"?bref=2Sam.19.37-40","r":"2Sam.19.37-40","rawR":"2Sam.19.37-40","sourceRefs":[{"raw":"2Sam.19.37-40","value":"2Sam.19.37-40"}],"t":"ref","v":"37-40"},"). David accepted the proposal and ordered his son and successor, Solomon, to grant Kimham a pension at the palace (",{"href":"?bref=1Kgs.2.7","r":"1Kgs.2.7","rawR":"1Kgs.2.7","sourceRefs":[{"raw":"1Kgs.2.7","value":"1Kgs.2.7"}],"t":"ref","v":"1 Kgs 2:7"},"). His name is reflected centuries later in Geruth-kimham, a place near Bethlehem where the people Johanan had rescued from Ishmael stayed, intending to go to Egypt later (",{"href":"?bref=Jer.41.17","r":"Jer.41.17","rawR":"Jer.41.17","sourceRefs":[{"raw":"Jer.41.17","value":"Jer.41.17"}],"t":"ref","v":"Jer 41:17"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Kimham","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Sm 19:32","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.19.32","rawQueryValue":"2Sam.19.32","sourceRefExact":"2Sam.19.32"},{"anchorText":"37-40","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.19.37-40","rawQueryValue":"2Sam.19.37-40","sourceRefExact":"2Sam.19.37-40"},{"anchorText":"1 Kgs 2:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.2.7","rawQueryValue":"1Kgs.2.7","sourceRefExact":"1Kgs.2.7"},{"anchorText":"Jer 41:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.41.17","rawQueryValue":"Jer.41.17","sourceRefExact":"Jer.41.17"}],"sourceItemFragmentSha256":"f62de4975b850e67c5f1270038aa266f2473007f1b4a4fe9d50546f3ed61e9b6","sourceItemName":"Kimham","sourceItemOrder":77,"sourceMember":"Articles/K.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Kimham","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Kimham","title":"Kimham","version":"v2-a101d843a2f0cd3fc0c6"}