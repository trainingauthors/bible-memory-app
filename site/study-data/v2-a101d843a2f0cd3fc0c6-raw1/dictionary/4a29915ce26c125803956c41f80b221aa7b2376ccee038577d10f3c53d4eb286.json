{"content":[{"c":["JATTIR"],"sourceClass":"h1","t":"p"},{"c":["Town in the hill country of Judah given to the Levites (",{"href":"?bref=Josh.15.48","r":"Josh.15.48","rawR":"Josh.15.48","sourceRefs":[{"raw":"Josh.15.48","value":"Josh.15.48"}],"t":"ref","v":"Jos 15:48"},"; ",{"href":"?bref=Josh.21.14","r":"Josh.21.14","rawR":"Josh.21.14","sourceRefs":[{"raw":"Josh.21.14","value":"Josh.21.14"}],"t":"ref","v":"21:14"},"; ",{"href":"?bref=1Chr.6.57","r":"1Chr.6.57","rawR":"1Chr.6.57","sourceRefs":[{"raw":"1Chr.6.57","value":"1Chr.6.57"}],"t":"ref","v":"1 Chr 6:57"},"). David sent spoils from his victory over the Amalekites to Jattir (",{"href":"?bref=1Sam.30.27","r":"1Sam.30.27","rawR":"1Sam.30.27","sourceRefs":[{"raw":"1Sam.30.27","value":"1Sam.30.27"}],"t":"ref","v":"1 Sm 30:27"},"). It is identified with modern Khirbet ‘Attir, 13 miles (21 kilometers) southeast of Hebron."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Jattir","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 15:48","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.48","rawQueryValue":"Josh.15.48","sourceRefExact":"Josh.15.48"},{"anchorText":"21:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.21.14","rawQueryValue":"Josh.21.14","sourceRefExact":"Josh.21.14"},{"anchorText":"1 Chr 6:57","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.6.57","rawQueryValue":"1Chr.6.57","sourceRefExact":"1Chr.6.57"},{"anchorText":"1 Sm 30:27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.30.27","rawQueryValue":"1Sam.30.27","sourceRefExact":"1Sam.30.27"}],"sourceItemFragmentSha256":"6e5f28e8c058cd6cb5bf40463c3931a1937301018539ec76782d74c86f29d2b0","sourceItemName":"Jattir","sourceItemOrder":111,"sourceMember":"Articles/J.xml","suppl