{"content":[{"c":["BASILISK*"],"sourceClass":"h1","t":"p"},{"c":["Word used to translate a particular Hebrew word in two passages of some editions of the ",{"c":["kjv"],"sourceClass":"sc","t":"span"}," (",{"href":"?bref=Pr.23.32","r":"Pr.23.32","rawR":"Pr.23.32","sourceRefs":[{"raw":"Pr.23.32","value":"Pr.23.32"}],"t":"ref","v":"Prv 23:32"},"; ",{"href":"?bref=Isa.14.29","r":"Isa.14.29","rawR":"Isa.14.29","sourceRefs":[{"raw":"Isa.14.29","value":"Isa.14.29"}],"t":"ref","v":"Is 14:29"},"). “Basilisk” refers to a kind of lizard and is a mistranslation. It has been corrected to read “adder” or “viper” in later ",{"c":["kjv"],"sourceClass":"sc","t":"span"}," printings and in more recent translations."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Basilisk","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Prv 23:32","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Pr.23.32","rawQueryValue":"Pr.23.32","sourceRefExact":"Pr.23.32"},{"anchorText":"Is 14:29","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.14.29","rawQueryValue":"Isa.14.29","sourceRefExact":"Isa.14.29"}],"sourceItemFragmentSha256":"8ea26579a1472249539a77668f713c95eca11a40b491122c356f27d8c056241a","sourceItemName":"Basilisk","sourceItemOrder":100,"sourceMember":"Articles/B.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Basilisk","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Basilisk*","title":"Basilisk*","version":"v2-a101d843a2f0cd3fc0c6"}