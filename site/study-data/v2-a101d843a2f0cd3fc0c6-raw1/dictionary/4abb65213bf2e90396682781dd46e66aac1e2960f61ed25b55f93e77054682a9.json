{"content":[{"c":["ELISHEBA"],"sourceClass":"h1","t":"p"},{"c":["Wife of Aaron (",{"href":"?bref=Exod.6.23","r":"Exod.6.23","rawR":"Exod.6.23","sourceRefs":[{"raw":"Exod.6.23","value":"Exod.6.23"}],"t":"ref","v":"Ex 6:23"},"), who bore him Nadab, Abihu, Eleazar, and Ithamar. Her father was Amminadab and her brother was Nahshon, the leader of Judah (",{"href":"?bref=Num.1.7","r":"Num.1.7","rawR":"Num.1.7","sourceRefs":[{"raw":"Num.1.7","value":"Num.1.7"}],"t":"ref","v":"Nm 1:7"},"; ",{"href":"?bref=Num.2.3","r":"Num.2.3","rawR":"Num.2.3","sourceRefs":[{"raw":"Num.2.3","value":"Num.2.3"}],"t":"ref","v":"2:3"},"), the tribe to which Elisheba also belonged. After Aaron died (",{"href":"?bref=Num.20.28","r":"Num.20.28","rawR":"Num.20.28","sourceRefs":[{"raw":"Num.20.28","value":"Num.20.28"}],"t":"ref","v":"Nm 20:28"},"), Moses invested Eleazar, Elisheba’s third son, with the office of chief priest."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Elisheba","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ex 6:23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.6.23","rawQueryValue":"Exod.6.23","sourceRefExact":"Exod.6.23"},{"anchorText":"Nm 1:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.1.7","rawQueryValue":"Num.1.7","sourceRefExact":"Num.1.7"},{"anchorText":"2:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.2.3","rawQueryValue":"Num.2.3","sourceRefExact":"Num.2.3"},{"anchorText":"Nm 20:28","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.20.28","rawQueryValue":"Num.20.28","sourceRefExact":"Num.20.28"}],"sourceItemFragmentSha256":"947b0cc249ba7330b8560ab8aa237256a10f30bafa81e63a3170622f9594ea2a","sourceItemName":"Elisheba","sourceItemOrder":117,"sourceMember":"Articles/E.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Elisheba","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Elisheba","title":"Elisheba","version":"v2-a101d843a2f0cd3fc0c6"}