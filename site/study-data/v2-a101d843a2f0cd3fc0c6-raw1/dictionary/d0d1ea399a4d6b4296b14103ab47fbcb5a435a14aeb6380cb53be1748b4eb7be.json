{"content":[{"c":["CALNEH"],"sourceClass":"h1","t":"p"},{"c":["1. City in Babylon (",{"href":"?bref=Gen.10.10","r":"Gen.10.10","rawR":"Gen.10.10","sourceRefs":[{"raw":"Gen.10.10","value":"Gen.10.10"}],"t":"ref","v":"Gn 10:10"},")."],"sourceClass":"list","t":"p"},{"c":["2. City identified as Kullani (Kullan Koy), about 20 miles (32.2 kilometers) north of Aleppo in northern Syria. This northern identification is hinted at in ",{"href":"?bref=Isa.10.9","r":"Isa.10.9","rawR":"Isa.10.9","sourceRefs":[{"raw":"Isa.10.9","value":"Isa.10.9"}],"t":"ref","v":"Isaiah 10:9"},", where Calno is associated with Carchemish, some 50 miles (80.5 kilometers) to the northeast, as well as in the context of ",{"href":"?bref=Amos.6.2","r":"Amos.6.2","rawR":"Amos.6.2","sourceRefs":[{"raw":"Amos.6.2","value":"Amos.6.2"}],"t":"ref","v":"Amos 6:2"}," (note the north-to-south progression—Calneh, Hamath, Gath). Canneh in ",{"href":"?bref=Ezek.27.23","r":"Ezek.27.23","rawR":"Ezek.27.23","sourceRefs":[{"raw":"Ezek.27.23","value":"Ezek.27.23"}],"t":"ref","v":"Ezekiel 27:23"}," seems to refer to the same general location and is perhaps to be linked with Calneh. Kullani was captured by Tiglath-pileser II, king of Assyria, about 741 ",{"c":["BC"],"sourceClass":"era","t":"span"},"."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Calneh","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 10:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.10.10","rawQueryValue":"Gen.10.10","sourceRefExact":"Gen.10.10"},{"anchorText":"Isaiah 10:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.10.9","rawQueryValue":"Isa.10.9","sourceRefExact":"Isa.10.9"},{"anchorText":"Amos 6:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Amos.6.2","rawQueryValue":"Amos.6.2","sourceRefExact":"Amos.6.2"},{"anchorText":"Ezekiel 27:23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.27.23","rawQueryValue":"Ezek.27.23","sourceRefExact":"Ezek.27.23"}],"sourceItemFragmentSha256":"6b5bd90d2064b2927996cb021e6e5629ab245587102866d0e5f24f79283d6f58","sourceItemName":"Calneh","sourceItemOrder":24,"sourceMember":"Articles/C.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Calneh","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Calneh","title":"Calneh","version":"v2-a101d843a2f0cd3fc0c6"}