{"content":[{"c":["SOAP"],"sourceClass":"h1","t":"p"},{"c":["Cleansing agent extracted from a number of alkali-bearing plants. The alkali was gathered from the ashes of the burned plants and formed into a detergent. Saltwort, soapwort, and glasswort were alkali-bearing plants indigenous to western Asia and known to the ancient Hebrews. Soap was used primarily for cleansing purposes. In ",{"href":"?bref=Jer.2.22","r":"Jer.2.22","rawR":"Jer.2.22","sourceRefs":[{"raw":"Jer.2.22","value":"Jer.2.22"}],"t":"ref","v":"Jeremiah 2:22"}," soap is used to clean the body, and in ",{"href":"?bref=Mal.3.2","r":"Mal.3.2","rawR":"Mal.3.2","sourceRefs":[{"raw":"Mal.3.2","value":"Mal.3.2"}],"t":"ref","v":"Malachi 3:2"},", to wash clothes."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Soap","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jeremiah 2:22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.2.22","rawQueryValue":"Jer.2.22","sourceRefExact":"Jer.2.22"},{"anchorText":"Malachi 3:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mal.3.2","rawQueryValue":"Mal.3.2","sourceRefExact":"Mal.3.2"}],"sourceItemFragmentSha256":"5423aabd1d7328d8c9007e49d29a5e5916cb686146577814047838f784d977b7","sourceItemName":"Soap","sourceItemOrder":476,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Soap","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Soap","title":"Soap","version":"v2-a101d843a2f0cd3fc0c6"}