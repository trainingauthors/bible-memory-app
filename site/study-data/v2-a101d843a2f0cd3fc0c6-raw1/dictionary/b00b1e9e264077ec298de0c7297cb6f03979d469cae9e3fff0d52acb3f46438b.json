{"content":[{"c":["RAAMA*, RAAMAH"],"sourceClass":"h1","t":"p"},{"c":["One of Cush’s five sons and a descendant of Ham’s line. He was the father of Sheba and Dedan (",{"href":"?bref=Gen.10.7","r":"Gen.10.7","rawR":"Gen.10.7","sourceRefs":[{"raw":"Gen.10.7","value":"Gen.10.7"}],"t":"ref","v":"Gn 10:7"},"; ",{"href":"?bref=1Chr.1.9","r":"1Chr.1.9","rawR":"1Chr.1.9","sourceRefs":[{"raw":"1Chr.1.9","value":"1Chr.1.9"}],"t":"ref","v":"1 Chr 1:9"},"). ",{"href":"?bref=Ezek.27.22","r":"Ezek.27.22","rawR":"Ezek.27.22","sourceRefs":[{"raw":"Ezek.27.22","value":"Ezek.27.22"}],"t":"ref","v":"Ezekiel 27:22"}," mentions the people of Sheba and Raamah trading spices and precious stones with the merchants of Tyre. Raamah’s name was later given to a town perhaps identifiable with Ma’in in southwest Arabia."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"RaamaRaamah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 10:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.10.7","rawQueryValue":"Gen.10.7","sourceRefExact":"Gen.10.7"},{"anchorText":"1 Chr 1:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.1.9","rawQueryValue":"1Chr.1.9","sourceRefExact":"1Chr.1.9"},{"anchorText":"Ezekiel 27:22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.27.22","rawQueryValue":"Ezek.27.22","sourceRefExact":"Ezek.27.22"}],"sourceItemFragmentSha256":"e005b3a2c7085fc5caca310b8ecc5825f187f077efabf0696df7320c55eaa81e","sourceItemName":"RaamaRaamah","sourceItemOrder":1,"sourceMember":"Articles/R.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"RaamaRaamah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Raama*, Raamah","title":"Raama*, Raamah","version":"v2-a101d843a2f0cd3fc0c6"}