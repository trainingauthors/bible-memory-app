{"content":[{"c":["CABUL"],"sourceClass":"h1","t":"p"},{"c":["1. Asherite town near Mt Carmel on the border between Israel and Tyre (",{"href":"?bref=Josh.19.27","r":"Josh.19.27","rawR":"Josh.19.27","sourceRefs":[{"raw":"Josh.19.27","value":"Josh.19.27"}],"t":"ref","v":"Jos 19:27"},")."],"sourceClass":"list","t":"p"},{"c":["2. Territory given to Hiram, king of Tyre, by Solomon in exchange for a gift of 120 talents (9,000 pounds, 4 metric tons) of gold for completion of the temple. Hiram, not impressed with this northern Galilean province (",{"href":"?bref=1Kgs.9.13-14","r":"1Kgs.9.13-14","rawR":"1Kgs.9.13-14","sourceRefs":[{"raw":"1Kgs.9.13-14","value":"1Kgs.9.13-14"}],"t":"ref","v":"1 Kgs 9:13-14"},"), later returned it to Solomon (",{"href":"?bref=2Chr.8.2","r":"2Chr.8.2","rawR":"2Chr.8.2","sourceRefs":[{"raw":"2Chr.8.2","value":"2Chr.8.2"}],"t":"ref","v":"2 Chr 8:2"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Cabul","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 19:27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.19.27","rawQueryValue":"Josh.19.27","sourceRefExact":"Josh.19.27"},{"anchorText":"1 Kgs 9:13-14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.9.13-14","rawQueryValue":"1Kgs.9.13-14","sourceRefExact":"1Kgs.9.13-14"},{"anchorText":"2 Chr 8:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.8.2","rawQueryValue":"2Chr.8.2","sourceRefExact":"2Chr.8.2"}],"sourceItemFragmentSha256":"24c8207274e530ae118ba5661206a6d206961a7e4ddb9e3d887453362f5e7302","sourceItemName":"Cabul","sourceItemOrder":3,"sourceMember":"Articles/C.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Cabul","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Cabul","title"