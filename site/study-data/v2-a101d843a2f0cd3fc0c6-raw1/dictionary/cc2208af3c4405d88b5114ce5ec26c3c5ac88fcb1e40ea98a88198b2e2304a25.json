{"content":[{"c":["SHOBACH"],"sourceClass":"h1","t":"p"},{"c":["Commander of the army of Hadadezer, king of Zobah, who led the Ammonite-Syrian campaign against Israel. David’s army killed Shobach and so completely destroyed his forces that the Ammonite-Syrian alliance was broken, and the kingdoms that were tributary to Hadadezer became subject to David (",{"href":"?bref=2Sam.10.16-18","r":"2Sam.10.16-18","rawR":"2Sam.10.16-18","sourceRefs":[{"raw":"2Sam.10.16-18","value":"2Sam.10.16-18"}],"t":"ref","v":"2 Sm 10:16-18"},"). He is also called Shophach in ",{"href":"?bref=1Chr.19.16-18","r":"1Chr.19.16-18","rawR":"1Chr.19.16-18","sourceRefs":[{"raw":"1Chr.19.16-18","value":"1Chr.19.16-18"}],"t":"ref","v":"1 Chronicles 19:16-18"},"."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Shobach","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Sm 10:16-18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.10.16-18","rawQueryValue":"2Sam.10.16-18","sourceRefExact":"2Sam.10.16-18"},{"anchorText":"1 Chronicles 19:16-18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.19.16-18","rawQueryValue":"1Chr.19.16-18","sourceRefExact":"1Chr.19.16-18"}],"sourceItemFragmentSha256":"f1cc0072015842778007b3a552ae66b8b9c730e95f0456f3f08f233b1b9d6ec5","sourceItemName":"Shobach","sourceItemOrder":363,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Shobach","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Shobach","title":"Shobach","version":"v2-a101d843a2f0cd3fc0c6"}