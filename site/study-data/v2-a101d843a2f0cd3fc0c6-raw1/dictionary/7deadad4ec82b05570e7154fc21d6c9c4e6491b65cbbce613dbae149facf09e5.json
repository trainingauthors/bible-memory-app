{"content":[{"c":["LUCIUS"],"sourceClass":"h1","t":"p"},{"c":["1. Man from Cyrene, listed among the prophets and teachers in Antioch (",{"href":"?bref=Acts.13.1","r":"Acts.13.1","rawR":"Acts.13.1","sourceRefs":[{"raw":"Acts.13.1","value":"Acts.13.1"}],"t":"ref","v":"Acts 13:1"},"). He may have been among the Jewish Christians from Cyprus and Cyrene who preached to the Gentiles in Antioch in the face of persecution (",{"href":"?bref=Acts.11.19-21","r":"Acts.11.19-21","rawR":"Acts.11.19-21","sourceRefs":[{"raw":"Acts.11.19-21","value":"Acts.11.19-21"}],"t":"ref","v":"11:19-21"},"). Various attempts have been made to identify him with Luke, the author of Acts, or with the Lucius of ",{"href":"?bref=Rom.16.21","r":"Rom.16.21","rawR":"Rom.16.21","sourceRefs":[{"raw":"Rom.16.21","value":"Rom.16.21"}],"t":"ref","v":"Romans 16:21"},", but these have been unsuccessful."],"sourceClass":"list","t":"p"},{"c":["2. Jewish believer (cf. ",{"href":"?bref=Rom.9.3","r":"Rom.9.3","rawR":"Rom.9.3","sourceRefs":[{"raw":"Rom.9.3","value":"Rom.9.3"}],"t":"ref","v":"Rom 9:3"},") and one of the companions of Paul who sent greetings to those in Rome (",{"href":"?bref=Rom.16.21","r":"Rom.16.21","rawR":"Rom.16.21","sourceRefs":[{"raw":"Rom.16.21","value":"Rom.16.21"}],"t":"ref","v":"16:21"},"). This casts doubt on Origen’s identification of this Lucius with the Luke of the Gospel and Acts, who was most likely a Gentile (",{"href":"?bref=Col.4.12-14","r":"Col.4.12-14","rawR":"Col.4.12-14","sourceRefs":[{"raw":"Col.4.12-14","value":"Col.4.12-14"}],"t":"ref","v":"Col 4:12-14"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Lucius","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Acts 13:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.13.1","rawQueryValue":"Acts.13.1","sourceRefExact":"Acts.13.1"},{"anchorText":"11:19-21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.11.19-21","rawQueryValue":"Acts.11.19-21","sourceRefExact":"Acts.11.19-21"},{"anchorText":"Romans 16:21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rom.16.21","rawQueryValue":"Rom.16.21","sourceRefExact":"Rom.16.21"},{"anchorText":"Rom 9:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rom.9.3","rawQueryValue":"Rom.9.3","sourceRefExact":"Rom.9.3"},{"anchorText":"16:21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rom.16.21","rawQueryValue":"Rom.16.21","sourceRefExact":"Rom.16.21"},{"anchorText":"Col 4:12-14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Col.4.12-14","rawQueryValue":"Col.4.12-14","sourceRefExact":"Col.4.12-14"}],"sourceItemFragmentSha256":"ae3acd587006338fc036a65aaa00c2114c3af3d1d5ecf35ca74f85576aabe9ba","sourceItemName":"Lucius","sourceItemOrder":138,"sourceMember":"Articles/L.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Lucius","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Lucius","title":"Lucius","version":"v2-a101d843a2f0cd3fc0c6"}