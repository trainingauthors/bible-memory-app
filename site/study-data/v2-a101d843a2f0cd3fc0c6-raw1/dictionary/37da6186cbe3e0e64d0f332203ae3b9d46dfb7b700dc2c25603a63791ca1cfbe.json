{"content":[{"c":["RAZOR"],"sourceClass":"h1","t":"p"},{"c":["A sharp tool used for shaving off the beard or hair (",{"href":"?bref=Num.8.7","r":"Num.8.7","rawR":"Num.8.7","sourceRefs":[{"raw":"Num.8.7","value":"Num.8.7"}],"t":"ref","v":"Nm 8:7"},"; ",{"href":"?bref=Ezek.5.1","r":"Ezek.5.1","rawR":"Ezek.5.1","sourceRefs":[{"raw":"Ezek.5.1","value":"Ezek.5.1"}],"t":"ref","v":"Ez 5:1"},"). Use of the razor was proscribed for those under the Nazirite vow (",{"href":"?bref=Num.6.5","r":"Num.6.5","rawR":"Num.6.5","sourceRefs":[{"raw":"Num.6.5","value":"Num.6.5"}],"t":"ref","v":"Nm 6:5"},"; ",{"href":"?bref=1Sam.1.11","r":"1Sam.1.11","rawR":"1Sam.1.11","sourceRefs":[{"raw":"1Sam.1.11","value":"1Sam.1.11"}],"t":"ref","v":"1 Sm 1:11"},"). The instrument played a central role in Samson’s life (",{"href":"?bref=Judg.13.5","r":"Judg.13.5","rawR":"Judg.13.5","sourceRefs":[{"raw":"Judg.13.5","value":"Judg.13.5"}],"t":"ref","v":"Jgs 13:5"},"; ",{"href":"?bref=Judg.16.17","r":"Judg.16.17","rawR":"Judg.16.17","sourceRefs":[{"raw":"Judg.16.17","value":"Judg.16.17"}],"t":"ref","v":"16:17"},")."],"sourceClass":"fl","t":"p"},{"c":["The razor is a simile for a slanderous tongue (",{"href":"?bref=Ps.52.2","r":"Ps.52.2","rawR":"Ps.52.2","sourceRefs":[{"raw":"Ps.52.2","value":"Ps.52.2"}],"t":"ref","v":"Ps 52:2"},") and a metaphor for judgment (",{"href":"?bref=Isa.7.20","r":"Isa.7.20","rawR":"Isa.7.20","sourceRefs":[{"raw":"Isa.7.20","value":"Isa.7.20"}],"t":"ref","v":"Is 7:20"},")."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Razor","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Nm 8:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.8.7","rawQueryValue":"Num.8.7","sourceRefExact":"Num.8.7"},{"anchorText":"Ez 5:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.5.1","rawQueryValue":"Ezek.5.1","sourceRefExact":"Ezek.5.1"},{"anchorText":"Nm 6:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.6.5","rawQueryValue":"Num.6.5","sourceRefExact":"Num.6.5"},{"anchorText":"1 Sm 1:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.1.11","rawQueryValue":"1Sam.1.11","sourceRefExact":"1Sam.1.11"},{"anchorText":"Jgs 13:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.13.5","rawQueryValue":"Judg.13.5","sourceRefExact":"Judg.13.5"},{"anchorText":"16:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.16.17","rawQueryValue":"Judg.16.17","sourceRefExact":"Judg.16.17"},{"anchorText":"Ps 52:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ps.52.2","rawQueryValue":"Ps.52.2","sourceRefExact":"Ps.52.2"},{"anchorText":"Is 7:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.7.20","rawQueryValue":"Isa.7.20","sourceRefExact":"Isa.7.20"}],"sourceItemFragmentSha256":"08052b23d6282c9899094fe230386e421142c84c39c745a39b173e63a5d00f3b","sourceItemName":"Razor","sourceItemOrder":67,"sourceMember":"Articles/R.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Razor","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Razor","title":"Razor","version":"v2-a101d843a2f0cd3fc0c6"}