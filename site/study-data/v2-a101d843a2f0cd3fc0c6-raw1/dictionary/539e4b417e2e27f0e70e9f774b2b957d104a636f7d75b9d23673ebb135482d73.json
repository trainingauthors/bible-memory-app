calization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.23.9","rawQueryValue":"2Sam.23.9","sourceRefExact":"2Sam.23.9"},{"anchorText":"1 Chr 11:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.11.12","rawQueryValue":"1Chr.11.12","sourceRefExact":"1Chr.11.12"},{"anchorText":"1 Chr 23:21-22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.23.21-22","rawQueryValue":"1Chr.23.21-22","sourceRefExact":"1Chr.23.21-22"},{"anchorText":"24:28","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.24.28","rawQueryValue":"1Chr.24.28","sourceRefExact":"1Chr.24.28"},{"anchorText":"Ezr 8:33","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.8.33","rawQueryValue":"Ezra.8.33","sourceRefExact":"Ezra.8.33"},{"anchorText":"Ezr 10:25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.10.25","rawQueryValue":"Ezra.10.25","sourceRefExact":"Ezra.10.25"},{"anchorText":"Neh 12:42","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.12.42","rawQueryValue":"Neh.12.42","sourceRefExact":"Neh.12.42"},{"anchorText":"Mt 1:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.1.15","rawQueryValue":"Matt.1.15","sourceRefExact":"Matt.1.15"}],"sourceItemFragmentSha256":"d0c41bf176b3216b1678ef5104502120f62ecb2b6128d7386d81dfe589da65d7","sourceItemName":"Eleazar","sourceItemOrder":70,"sourceMember":"Articles/E.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Eleazar","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Eleazar","title":"Eleazar","version":"v2-a101d843a2f0cd3fc0c6"}