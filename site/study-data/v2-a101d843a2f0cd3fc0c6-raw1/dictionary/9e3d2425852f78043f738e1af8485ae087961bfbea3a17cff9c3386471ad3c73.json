{"content":[{"c":["ALPHA AND OMEGA"],"sourceClass":"h1","t":"p"},{"c":["Phrase used as a title in the NT for both God (",{"href":"?bref=Rev.1.8","r":"Rev.1.8","rawR":"Rev.1.8","sourceRefs":[{"raw":"Rev.1.8","value":"Rev.1.8"}],"t":"ref","v":"Rv 1:8"},"; ",{"href":"?bref=Rev.21.6","r":"Rev.21.6","rawR":"Rev.21.6","sourceRefs":[{"raw":"Rev.21.6","value":"Rev.21.6"}],"t":"ref","v":"21:6"},") and Jesus Christ (",{"href":"?bref=Rev.22.13","r":"Rev.22.13","rawR":"Rev.22.13","sourceRefs":[{"raw":"Rev.22.13","value":"Rev.22.13"}],"t":"ref","v":"Rv 22:13"},"). The English equivalent is “the A and the Z.” Similar epithets are “the beginning and the end” (",{"href":"?bref=Rev.21.6","r":"Rev.21.6","rawR":"Rev.21.6","sourceRefs":[{"raw":"Rev.21.6","value":"Rev.21.6"}],"t":"ref","v":"Rv 21:6"},"; ",{"href":"?bref=Rev.22.13","r":"Rev.22.13","rawR":"Rev.22.13","sourceRefs":[{"raw":"Rev.22.13","value":"Rev.22.13"}],"t":"ref","v":"22:13"},") and “the first and the last” (",{"href":"?bref=Rev.1.17","r":"Rev.1.17","rawR":"Rev.1.17","sourceRefs":[{"raw":"Rev.1.17","value":"Rev.1.17"}],"t":"ref","v":"Rv 1:17"},"; ",{"href":"?bref=Rev.2.8","r":"Rev.2.8","rawR":"Rev.2.8","sourceRefs":[{"raw":"Rev.2.8","value":"Rev.2.8"}],"t":"ref","v":"2:8"},"; ",{"href":"?bref=Rev.22.13","r":"Rev.22.13","rawR":"Rev.22.13","sourceRefs":[{"raw":"Rev.22.13","value":"Rev.22.13"}],"t":"ref","v":"22:13"},")."],"sourceClass":"fl","t":"p"},{"c":["Such affirmations, which have their counterpart in the OT (see ",{"href":"?bref=Isa.41.4","r":"Isa.41.4","rawR":"Isa.41.4","sourceRefs":[{"raw":"Isa.41.4","value":"Isa.41.4"}],"t":"ref","v":"Is 41:4"},"; ",{"href":"?bref=Isa.44.6","r":"Isa.44.6","rawR":"Isa.44.6","sourceRefs":[{"raw":"Isa.44.6","value":"Isa.44.6"}],"t":"ref","v":"44:6"},"; ",{"href":"?bref=Isa.48.12","r":"Isa.48.12","rawR":"Isa.48.12","sourceRefs":[{"raw":"Isa.48.12","value":"Isa.48.12"}],"t":"ref","v":"48:12"},"), stress the unique and faithful sovereignty of God and his Son, Jesus. They serve as reminders to the Christian reader that the creation of the universe and the end of all human history are both under control of the living God. ",{"c":["See"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=GodNamesof_Article_TyndaleOpenBibleDictionary","id":"GodNamesof_Article_TyndaleOpenBibleDictionary","rawId":"GodNamesof_Article_TyndaleOpenBibleDictionary","t":"link","v":"God, Names of"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"AlphaandOmega","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Rv 1:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.1.8","rawQueryValue":"Rev.1.8","sourceRefExact":"Rev.1.8"},{"anchorText":"21:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.21.6","rawQueryValue":"Rev.21.6","sourceRefExact":"Rev.21.6"},{"anchorText":"Rv 22:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.22.13","rawQueryValue":"Rev.22.13","sourceRefExact":"Rev.22.13"},{"anchorText":"Rv 21:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.21.6","rawQueryValue":"Rev.21.6","sourceRefExact":"Rev.21.6"},{"anchorText":"22:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.22.13","rawQueryValue":"Rev.22.13","sourceRefExact":"Rev.22.13"},{"anchorText":"Rv 1:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.1.17","rawQueryValue":"Rev.1.17","sourceRefExact":"Rev.1.17"},{"anchorText":"2:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.2.8","rawQueryValue":"Rev.2.8","sourceRefExact":"Rev.2.8"},{"anchorText":"22:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.22.13","rawQueryValue":"Rev.22.13","sourceRefExact":"Rev.22.13"},{"anchorText":"Is 41:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.41.4","rawQueryValue":"Isa.41.4","sourceRefExact":"Isa.41.4"},{"anchorText":"44:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.44.6","rawQueryValue":"Isa.44.6","sourceRefExact":"Isa.44.6"},{"anchorText":"48:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Isa.48.12","rawQueryValue":"Isa.48.12","sourceRefExact":"Isa.48.12"}],"sourceItemFragmentSha256":"8dff70005d5b108bc44452fdaabf9fad8571ba179596e9e49225988493cdd4de","sourceItemName":"AlphaandOmega","sourceItemOrder":267,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[{"name":"AlphaAndOmegaInGreek","src":"../Pictures/Pictures.xml"}]},"sourceAttributes":{"name":"AlphaandOmega","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Alpha and Omega","title":"Alpha and Omega","version":"v2-a101d843a2f0cd3fc0c6"}