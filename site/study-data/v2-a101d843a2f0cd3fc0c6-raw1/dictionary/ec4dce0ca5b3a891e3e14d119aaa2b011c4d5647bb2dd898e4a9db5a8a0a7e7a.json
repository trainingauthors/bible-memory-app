{"content":[{"c":["TELAIM"],"sourceClass":"h1","t":"p"},{"c":["Place where Saul organized Israel’s army in preparation for war with the Amalekites (",{"href":"?bref=1Sam.15.4","r":"1Sam.15.4","rawR":"1Sam.15.4","sourceRefs":[{"raw":"1Sam.15.4","value":"1Sam.15.4"}],"t":"ref","v":"1 Sm 15:4"},"). Telaim is perhaps identifiable with Telem, a city situated near Edom’s border in the southern extremity of the territory allotted to Judah’s tribe for an inheritance (",{"href":"?bref=Josh.15.24","r":"Josh.15.24","rawR":"Josh.15.24","sourceRefs":[{"raw":"Josh.15.24","value":"Josh.15.24"}],"t":"ref","v":"Jos 15:24"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Telaim","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Sm 15:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.15.4","rawQueryValue":"1Sam.15.4","sourceRefExact":"1Sam.15.4"},{"anchorText":"Jos 15:24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.24","rawQueryValue":"Josh.15.24","sourceRefExact":"Josh.15.24"}],"sourceItemFragmentSha256":"b55ed6a0e5ef1efb21f41d37c508eb1be9b9296f71d6653f248d176cf3052719","sourceItemName":"Telaim","sourceItemOrder":81,"sourceMember":"Articles/T.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Telaim","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Telaim","title":"Telaim","version":"v2-a101d843a2f0cd3fc0c6"}