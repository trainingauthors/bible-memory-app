{"content":[{"c":["MAACAH, MAACHAH* (P",{"c":["lace"],"sourceClass":"lc","t":"span"},")"],"sourceClass":"h1","t":"p"},{"c":["Small kingdom in northern Transjordan alternately named Aram-Maacah in ",{"href":"?bref=1Chr.19.6","r":"1Chr.19.6","rawR":"1Chr.19.6","sourceRefs":[{"raw":"1Chr.19.6","value":"1Chr.19.6"}],"t":"ref","v":"1 Chronicles 19:6"}," (",{"c":["kjv"],"sourceClass":"sc","t":"span"}," “Syria-maachah”). According to ",{"href":"?bref=Josh.13.11","r":"Josh.13.11","rawR":"Josh.13.11","sourceRefs":[{"raw":"Josh.13.11","value":"Josh.13.11"}],"t":"ref","v":"Joshua 13:11"},", the states of Geshur and Maacah were between Gilead and Mt Hermon and they bordered the kingdom of Og, ruler of Bashan (",{"href":"?bref=Josh.12.4-5","r":"Josh.12.4-5","rawR":"Josh.12.4-5","sourceRefs":[{"raw":"Josh.12.4-5","value":"Josh.12.4-5"}],"t":"ref","v":"Jos 12:4-5"},"). Its people were reckoned as descendants of Nahor (",{"href":"?bref=Gen.22.24","r":"Gen.22.24","rawR":"Gen.22.24","sourceRefs":[{"raw":"Gen.22.24","value":"Gen.22.24"}],"t":"ref","v":"Gn 22:24"},") and were the southernmost of the Nahorite tribes."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=AramPerson_Article_TyndaleOpenBibleDictionary","id":"AramPerson_Article_TyndaleOpenBibleDictionary","rawId":"AramPerson_Article_TyndaleOpenBibleDictionary","t":"link","v":"Aram (Person) #2"},"; ",{"href":"?item=AramPlace_Article_TyndaleOpenBibleDictionary","id":"AramPlace_Article_TyndaleOpenBibleDictionary","rawId":"AramPlace_Article_TyndaleOpenBibleDictionary","t":"link","v":"Aram (Place)"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"MaacahMaachahPlace","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chronicles 19:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.19.6","rawQueryValue":"1Chr.19.6","sourceRefExact":"1Chr.19.6"},{"anchorText":"Joshua 13:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.13.11","rawQueryValue":"Josh.13.11","sourceRefExact":"Josh.13.11"},{"anchorText":"Jos 12:4-5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.12.4-5","rawQueryValue":"Josh.12.4-5","sourceRefExact":"Josh.12.4-5"},{"anchorText":"Gn 22:24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.22.24","rawQueryValue":"Gen.22.24","sourceRefExact":"Gen.22.24"}],"sourceItemFragmentSha256":"54555fb953310f499137f49a88b0ceac6bbae00b665c460cf9115e5e5a0f4870","sourceItemName":"MaacahMaachahPlace","sourceItemOrder":2,"sourceMember":"Articles/M.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"MaacahMaachahPlace","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Maacah, Maachah* (Place)","title":"Maacah, Maachah* (Place)","version":"v2-a101d843a2f0cd3fc0c6"}