{"content":[{"c":["BETH-ANATH"],"sourceClass":"h1","t":"p"},{"c":["Town assigned to Naphtali’s tribe (",{"href":"?bref=Josh.19.38","r":"Josh.19.38","rawR":"Josh.19.38","sourceRefs":[{"raw":"Josh.19.38","value":"Josh.19.38"}],"t":"ref","v":"Jos 19:38"},") from which the tribe failed to drive out the original inhabitants (",{"href":"?bref=Judg.1.33","r":"Judg.1.33","rawR":"Judg.1.33","sourceRefs":[{"raw":"Judg.1.33","value":"Judg.1.33"}],"t":"ref","v":"Jgs 1:33"},"). The Israelites, who often made slaves of the remaining Canaanite people, were in many cases eventually corrupted by their pagan religious practices."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"BethAnath","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 19:38","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.19.38","rawQueryValue":"Josh.19.38","sourceRefExact":"Josh.19.38"},{"anchorText":"Jgs 1:33","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.1.33","rawQueryValue":"Judg.1.33","sourceRefExact":"Judg.1.33"}],"sourceItemFragmentSha256":"a5fa5bd8bb81f4c0185afbb159e73e2d935daa3f8c2581187321241df8a18214","sourceItemName":"BethAnath","sourceItemOrder":225,"sourceMember":"Articles/B.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"BethAnath","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Beth-Anath","title":"Beth-Anath","version":"v2-a101d843a2f0cd3fc0c6"}