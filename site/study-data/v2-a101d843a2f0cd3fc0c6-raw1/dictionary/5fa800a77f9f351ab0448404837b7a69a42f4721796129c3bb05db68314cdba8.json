{"content":[{"c":["BETH-HAKKEREM"],"sourceClass":"h1","t":"p"},{"c":["Town in the hilly area between Jerusalem and Bethlehem. The prophet Jeremiah referred to signal fires set at Beth-hakkerem to warn of invasion from the north (",{"href":"?bref=Jer.6.1","r":"Jer.6.1","rawR":"Jer.6.1","sourceRefs":[{"raw":"Jer.6.1","value":"Jer.6.1"}],"t":"ref","v":"Jer 6:1"},"). Malchijah is mentioned as a political leader in Beth-hakkerem in Nehemiah’s time (",{"href":"?bref=Neh.3.14","r":"Neh.3.14","rawR":"Neh.3.14","sourceRefs":[{"raw":"Neh.3.14","value":"Neh.3.14"}],"t":"ref","v":"Neh 3:14"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"BethHakkerem","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jer 6:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.6.1","rawQueryValue":"Jer.6.1","sourceRefExact":"Jer.6.1"},{"anchorText":"Neh 3:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.3.14","rawQueryValue":"Neh.3.14","sourceRefExact":"Neh.3.14"}],"sourceItemFragmentSha256":"bbf26e921227f4277a061e90c8ffbff4d42be040f3977226532d45cbbb590b17","sourceItemName":"BethHakkerem","sourceItemOrder":253,"sourceMember":"Articles/B.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"BethHakkerem","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Beth-Hakkerem","title":"Beth-Hakkerem","version":"v2-a101d843a2f0cd3fc0c6"}