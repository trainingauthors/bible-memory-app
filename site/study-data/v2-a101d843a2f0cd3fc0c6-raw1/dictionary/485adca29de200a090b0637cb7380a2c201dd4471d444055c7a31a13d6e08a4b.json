{"content":[{"c":["HANANI"],"sourceClass":"h1","t":"p"},{"c":[" 1. Seer who rebuked King Asa for giving treasure to Ben-hadad of Syria to persuade him to attack Israel. Hanani was imprisoned for his preaching (",{"href":"?bref=2Chr.16.1-10","r":"2Chr.16.1-10","rawR":"2Chr.16.1-10","sourceRefs":[{"raw":"2Chr.16.1-10","value":"2Chr.16.1-10"}],"t":"ref","v":"2 Chr 16:1-10"},"). Hanani was the father of the prophet Jehu, who made protests against Baasha, king of Israel (",{"href":"?bref=1Kgs.16.1-7","r":"1Kgs.16.1-7","rawR":"1Kgs.16.1-7","sourceRefs":[{"raw":"1Kgs.16.1-7","value":"1Kgs.16.1-7"}],"t":"ref","v":"1 Kgs 16:1-7"},"), and Jehoshaphat, king of Judah (",{"href":"?bref=2Chr.19.2","r":"2Chr.19.2","rawR":"2Chr.19.2","sourceRefs":[{"raw":"2Chr.19.2","value":"2Chr.19.2"}],"t":"ref","v":"2 Chr 19:2"},")."],"sourceClass":"list","t":"p"},{"c":[" 2. Heman’s son, David’s seer, and a musician in the temple (",{"href":"?bref=1Chr.25.4,25","r":"1Chr.25.4,25","rawR":"1Chr.25.4,25","sourceRefs":[{"raw":"1Chr.25.4,25","value":"1Chr.25.4,25"}],"t":"ref","v":"1 Chr 25:4, 25"},")."],"sourceClass":"list","t":"p"},{"c":[" 3. Priest who obeyed Ezra’s exhortation to divorce his pagan wife after returning from exile (",{"href":"?bref=Ezra.10.20","r":"Ezra.10.20","rawR":"Ezra.10.20","sourceRefs":[{"raw":"Ezra.10.20","value":"Ezra.10.20"}],"t":"ref","v":"Ezr 10:20"},")."],"sourceClass":"list","t":"p"},{"c":[" 4. Brother of Nehemiah who induced him to act on behalf of the Jews when he reported the state of Jerusalem and Judah (",{"href":"?bref=Neh.1.2","r":"Neh.1.2","rawR":"Neh.1.2","sourceRefs":[{"raw":"Neh.1.2","value":"Neh.1.2"}],"t":"ref","v":"Neh 1:2"},"). Hanani was later given responsibility for the city of Jerusalem (",{"href":"?bref=Neh.7.2","r":"Neh.7.2","rawR":"Neh.7.2","sourceRefs":[{"raw":"Neh.7.2","value":"Neh.7.2"}],"t":"ref","v":"7:2"},")."],"sourceClass":"list","t":"p"},{"c":[" 5. Priest and musician who participated in the dedication of the rebuilt walls of Jerusalem (",{"href":"?bref=Neh.12.36","r":"Neh.12.36","rawR":"Neh.12.36","sourceRefs":[{"raw":"Neh.12.36","value":"Neh.12.36"}],"t":"ref","v":"Neh 12:36"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Hanani","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Chr 16:1-10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.16.1-10","rawQueryValue":"2Chr.16.1-10","sourceRefExact":"2Chr.16.1-10"},{"anchorText":"1 Kgs 16:1-7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.16.1-7","rawQueryValue":"1Kgs.16.1-7","sourceRefExact":"1Kgs.16.1-7"},{"anchorText":"2 Chr 19:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.19.2","rawQueryValue":"2Chr.19.2","sourceRefExact":"2Chr.19.2"},{"anchorText":"1 Chr 25:4, 25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.25.4,25","rawQueryValue":"1Chr.25.4,25","sourceRefExact":"1Chr.25.4,25"},{"anchorText":"Ezr 10:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.10.20","rawQueryValue":"Ezra.10.20","sourceRefExact":"Ezra.10.20"},{"anchorText":"Neh 1:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.1.2","rawQueryValue":"Neh.1.2","sourceRefExact":"Neh.1.2"},{"anchorText":"7:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.7.2","rawQueryValue":"Neh.7.2","sourceRefExact":"Neh.7.2"},{"anchorText":"Neh 12:36","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.12.36","rawQueryValue":"Neh.12.36","sourceRefExact":"Neh.12.36"}],"sourceItemFragmentSha256":"99eaa5fd6e354b101603044775670468b60be7a23bd087c58b43c3921c2ff084","sourceItemName":"Hanani","sourceItemOrder":85,"sourceMember":"Articles/H.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Hanani","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Hanani","title":"Hanani","version":"v2-a101d843a2f0cd3fc0c6"}