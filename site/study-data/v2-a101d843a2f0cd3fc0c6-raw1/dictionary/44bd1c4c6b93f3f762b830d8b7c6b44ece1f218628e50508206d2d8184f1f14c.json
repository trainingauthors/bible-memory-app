{"content":[{"c":["TIRZAH (P",{"c":["erson"],"sourceClass":"lc","t":"span"},")"],"sourceClass":"h1","t":"p"},{"c":["One of the daughters of Zelophehad of Manasseh’s tribe (",{"href":"?bref=Num.26.33","r":"Num.26.33","rawR":"Num.26.33","sourceRefs":[{"raw":"Num.26.33","value":"Num.26.33"}],"t":"ref","v":"Nm 26:33"},"). Since her father had no sons, she and her sisters asked for and received their father’s inheritance (",{"href":"?bref=Num.27.1","r":"Num.27.1","rawR":"Num.27.1","sourceRefs":[{"raw":"Num.27.1","value":"Num.27.1"}],"t":"ref","v":"Nm 27:1"},"; ",{"href":"?bref=Josh.17.3","r":"Josh.17.3","rawR":"Josh.17.3","sourceRefs":[{"raw":"Josh.17.3","value":"Josh.17.3"}],"t":"ref","v":"Jos 17:3"},"). This prompted the making of a new law concerning inheritance rights with the stipulation that daughters who obtained their families’ inheritance must marry within the tribe (",{"href":"?bref=Num.36.11","r":"Num.36.11","rawR":"Num.36.11","sourceRefs":[{"raw":"Num.36.11","value":"Num.36.11"}],"t":"ref","v":"Nm 36:11"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"TirzahPerson","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Nm 26:33","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.26.33","rawQueryValue":"Num.26.33","sourceRefExact":"Num.26.33"},{"anchorText":"Nm 27:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.27.1","rawQueryValue":"Num.27.1","sourceRefExact":"Num.27.1"},{"anchorText":"Jos 17:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.17.3","rawQueryValue":"Josh.17.3","sourceRefExact":"Josh.17.3"},{"anchorText":"Nm 36:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.36.11","rawQueryValue":"Num.36.11","sourceRefExact":"Num.36.11"}],"sourceItemFragmentSha256":"874dd2f1ae221fbec056529802501012c4e10cb3af6112ad568c5c9369686800","sourceItemName":"TirzahPerson","sourceItemOrder":178,"sourceMember":"Articles/T.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"TirzahPerson","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Tirzah (Person)","title":"Tirzah (Person)","version":"v2-a101d843a2f0cd3fc0c6"}