ionary_mapping_workstream","hrefExact":"?bref=Deut.4.11-12","rawQueryValue":"Deut.4.11-12","sourceRefExact":"Deut.4.11-12"},{"anchorText":"5:22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.5.22","rawQueryValue":"Deut.5.22","sourceRefExact":"Deut.5.22"},{"anchorText":"Ex 16:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.16.10","rawQueryValue":"Exod.16.10","sourceRefExact":"Exod.16.10"},{"anchorText":"Nm 14:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.14.10","rawQueryValue":"Num.14.10","sourceRefExact":"Num.14.10"},{"anchorText":"16:42-43","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.16.42-43","rawQueryValue":"Num.16.42-43","sourceRefExact":"Num.16.42-43"},{"anchorText":"Nm 12:1-15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.12.1-15","rawQueryValue":"Num.12.1-15","sourceRefExact":"Num.12.1-15"},{"anchorText":"Ex 33:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.33.9","rawQueryValue":"Exod.33.9","sourceRefExact":"Exod.33.9"},{"anchorText":"Dt 31:14-29","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.31.14-29","rawQueryValue":"Deut.31.14-29","sourceRefExact":"Deut.31.14-29"},{"anchorText":"Ez 1:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.1.4","rawQueryValue":"Ezek.1.4","sourceRefExact":"Ezek.1.4"},{"anchorText":"5-28","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.1.5-28","rawQueryValue":"Ezek.1.5-28","sourceRefExact":"Ezek.1.5-28"},{"anchorText":"10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.10.1-22","rawQueryValue":"Ezek.10.1-22","sourceRefExact":"Ezek.10.1-22"},{"anchorText":"43","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezek.43.1-27","rawQueryValue":"Ezek.43.1-27","sourceRefExact":"Ezek.43.1-27"},{"anchorText":"Dn 7:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Dan.7.13","rawQueryValue":"Dan.7.13","sourceRefExact":"Dan.7.13"},{"anchorText":"Mt 17:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.17.5","rawQueryValue":"Matt.17.5","sourceRefExact":"Matt.17.5"},{"anchorText":"Mk 9:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mark.9.7","rawQueryValue":"Mark.9.7","sourceRefExact":"Mark.9.7"},{"anchorText":"Lk 9:34","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.9.34","rawQueryValue":"Luke.9.34","sourceRefExact":"Luke.9.34"},{"anchorText":"Acts 1:9-11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.1.9-11","rawQueryValue":"Acts.1.9-11","sourceRefExact":"Acts.1.9-11"},{"anchorText":"Mt 24:30","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.24.30","rawQueryValue":"Matt.24.30","sourceRefExact":"Matt.24.30"},{"anchorText":"Mk 13:26","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mark.13.26","rawQueryValue":"Mark.13.26","sourceRefExact":"Mark.13.26"},{"anchorText":"Lk 21:27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.21.27","rawQueryValue":"Luke.21.27","sourceRefExact":"Luke.21.27"},{"anchorText":"Rv 1:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.1.7","rawQueryValue":"Rev.1.7","sourceRefExact":"Rev.1.7"}],"sourceItemFragmentSha256":"fce996bf9edd8719a53d84f8a8639ecb40ca136f0f64232058075347296ec841","sourceItemName":"PillarofFireandCloud","sourceItemOrder":193,"sourceMember":"Articles/P.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"PillarofFireandCloud","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Pillar of Fire and Cloud","title":"Pillar of Fire and Cloud","version":"v2-a101d843a2f0cd3fc0c6"}