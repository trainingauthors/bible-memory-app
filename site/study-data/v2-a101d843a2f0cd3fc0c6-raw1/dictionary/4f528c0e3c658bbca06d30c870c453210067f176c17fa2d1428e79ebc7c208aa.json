eryValue":"2Sam.3.4","sourceRefExact":"2Sam.3.4"},{"anchorText":"Jn 1:47","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=John.1.47","rawQueryValue":"John.1.47","sourceRefExact":"John.1.47"},{"anchorText":"Gn 2:19-20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.2.19-20","rawQueryValue":"Gen.2.19-20","sourceRefExact":"Gen.2.19-20"},{"anchorText":"Ex 33:12, 17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.33.12,17","rawQueryValue":"Exod.33.12,17","sourceRefExact":"Exod.33.12,17"},{"anchorText":"Gn 41:45","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.41.45","rawQueryValue":"Gen.41.45","sourceRefExact":"Gen.41.45"},{"anchorText":"2 Kgs 23:34","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.23.34","rawQueryValue":"2Kgs.23.34","sourceRefExact":"2Kgs.23.34"},{"anchorText":"Dn 1:6-7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Dan.1.6-7","rawQueryValue":"Dan.1.6-7","sourceRefExact":"Dan.1.6-7"},{"anchorText":"Gn 17:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.17.15","rawQueryValue":"Gen.17.15","sourceRefExact":"Gen.17.15"},{"anchorText":"Gn 17:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.17.5","rawQueryValue":"Gen.17.5","sourceRefExact":"Gen.17.5"},{"anchorText":"Gn 32:27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.32.27","rawQueryValue":"Gen.32.27","sourceRefExact":"Gen.32.27"},{"anchorText":"Hos 12:3-4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Hos.12.3-4","rawQueryValue":"Hos.12.3-4","sourceRefExact":"Hos.12.3-4"},{"anchorText":"Jn 1:42","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=John.1.42","rawQueryValue":"John.1.42","sourceRefExact":"John.1.42"},{"anchorText":"Dn 1:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Dan.1.7","rawQueryValue":"Dan.1.7","sourceRefExact":"Dan.1.7"}],"sourceItemFragmentSha256":"2a9da003452c41b4268085dbeecaae5bbe82c4b77d97fb0734b405295db9a2e2","sourceItemName":"NamesSignificanceof","sourceItemOrder":41,"sourceMember":"Articles/N.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"NamesSignificanceof","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Names, Significance of","title":"Names, Significance of","version":"v2-a101d843a2f0cd3fc0c6"}