6.13-14"},{"anchorText":"Ezr 7:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.7.1","rawQueryValue":"Ezra.7.1","sourceRefExact":"Ezra.7.1"},{"anchorText":"2 Esd 1:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Esd.1.1","rawQueryValue":"2Esd.1.1","sourceRefExact":"2Esd.1.1"},{"anchorText":"1 Chr 6:36","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.6.36","rawQueryValue":"1Chr.6.36","sourceRefExact":"1Chr.6.36"},{"anchorText":"1 Chr 9:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.9.11","rawQueryValue":"1Chr.9.11","sourceRefExact":"1Chr.9.11"},{"anchorText":"Neh 11:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.11.11","rawQueryValue":"Neh.11.11","sourceRefExact":"Neh.11.11"},{"anchorText":"2 Chr 15:1-15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.15.1-15","rawQueryValue":"2Chr.15.1-15","sourceRefExact":"2Chr.15.1-15"},{"anchorText":"2 Chr 21:1-4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.21.1-4","rawQueryValue":"2Chr.21.1-4","sourceRefExact":"2Chr.21.1-4"},{"anchorText":"2 Chr 22:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.22.6","rawQueryValue":"2Chr.22.6","sourceRefExact":"2Chr.22.6"},{"anchorText":"2 Chr 23:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.23.1","rawQueryValue":"2Chr.23.1","sourceRefExact":"2Chr.23.1"},{"anchorText":"2 Chr 23:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.23.1","rawQueryValue":"2Chr.23.1","sourceRefExact":"2Chr.23.1"},{"anchorText":"2 Chr 26:16-21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.26.16-21","rawQueryValue":"2Chr.26.16-21","sourceRefExact":"2Chr.26.16-21"},{"anchorText":"2 Chr 28:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.28.12","rawQueryValue":"2Chr.28.12","sourceRefExact":"2Chr.28.12"},{"anchorText":"2 Chr 29:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.29.12","rawQueryValue":"2Chr.29.12","sourceRefExact":"2Chr.29.12"},{"anchorText":"2 Chr 29:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.29.12","rawQueryValue":"2Chr.29.12","sourceRefExact":"2Chr.29.12"},{"anchorText":"2 Chr 31:10, 13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.31.10,13","rawQueryValue":"2Chr.31.10,13","sourceRefExact":"2Chr.31.10,13"},{"anchorText":"Neh 3:23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.3.23","rawQueryValue":"Neh.3.23","sourceRefExact":"Neh.3.23"},{"anchorText":"Neh 7:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.7.7","rawQueryValue":"Neh.7.7","sourceRefExact":"Neh.7.7"},{"anchorText":"Ezr 2:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.2.2","rawQueryValue":"Ezra.2.2","sourceRefExact":"Ezra.2.2"},{"anchorText":"Neh 8:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.8.7","rawQueryValue":"Neh.8.7","sourceRefExact":"Neh.8.7"},{"anchorText":"Neh 10:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.10.2","rawQueryValue":"Neh.10.2","sourceRefExact":"Neh.10.2"},{"anchorText":"Neh 12:33","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.12.33","rawQueryValue":"Neh.12.33","sourceRefExact":"Neh.12.33"},{"anchorText":"Jeremiah 42:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.42.1","rawQueryValue":"Jer.42.1","sourceRefExact":"Jer.42.1"},{"anchorText":"43:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jer.43.2","rawQueryValue":"Jer.43.2","sourceRefExact":"Jer.43.2"},{"anchorText":"Dn 1:6-7, 11, 19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Dan.1.6-7,11,19","rawQueryValue":"Dan.1.6-7,11,19","sourceRefExact":"Dan.1.6-7,11,19"},{"anchorText":"2:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Dan.2.17","rawQueryValue":"Dan.2.17","sourceRefExact":"Dan.2.17"}],"sourceItemFragmentSha256":"7fcf7dbe4a9d3dbde0f37b8b3b044bfe218ad64d87d4ae8df3e53fb4499f562e","sourceItemName":"Azariah","sourceItemOrder":641,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Azariah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Azariah","title":"Azariah","version":"v2-a101d843a2f0cd3fc0c6"}