{"content":[{"c":["WATCH"],"sourceClass":"h1","t":"p"},{"c":["Time unit for the division of the night in both the OT and NT. During the OT period, the night was divided into three military watches. The beginning or evening watch ran from sunset to roughly 10:00 ",{"c":["pm"],"sourceClass":"sc","t":"span"}," (",{"href":"?bref=Lam.2.19","r":"Lam.2.19","rawR":"Lam.2.19","sourceRefs":[{"raw":"Lam.2.19","value":"Lam.2.19"}],"t":"ref","v":"Lam 2:19"},"); the middle or night watch was from 10:00 ",{"c":["pm"],"sourceClass":"sc","t":"span"}," to 2:00 ",{"c":["am"],"sourceClass":"sc","t":"span"}," (",{"href":"?bref=Judg.7.19","r":"Judg.7.19","rawR":"Judg.7.19","sourceRefs":[{"raw":"Judg.7.19","value":"Judg.7.19"}],"t":"ref","v":"Jgs 7:19"},"); and the morning watch was from approximately 2:00 ",{"c":["am"],"sourceClass":"sc","t":"span"}," until sunrise (",{"href":"?bref=Exod.14.24","r":"Exod.14.24","rawR":"Exod.14.24","sourceRefs":[{"raw":"Exod.14.24","value":"Exod.14.24"}],"t":"ref","v":"Ex 14:24"},"; ",{"href":"?bref=1Sam.11.11","r":"1Sam.11.11","rawR":"1Sam.11.11","sourceRefs":[{"raw":"1Sam.11.11","value":"1Sam.11.11"}],"t":"ref","v":"1 Sm 11:11"},"). During the Roman period, the number of watches was increased from three to four. These were either described by number (first, second, etc.) or as evening, midnight, cock-crowing, and morning (",{"href":"?bref=Matt.14.25","r":"Matt.14.25","rawR":"Matt.14.25","sourceRefs":[{"raw":"Matt.14.25","value":"Matt.14.25"}],"t":"ref","v":"Mt 14:25"},"; ",{"href":"?bref=Mark.6.48","r":"Mark.6.48","rawR":"Mark.6.48","sourceRefs":[{"raw":"Mark.6.48","value":"Mark.6.48"}],"t":"ref","v":"Mk 6:48"},"). The respective watches ended at roughly 9:00 ",{"c":["pm"],"sourceClass":"sc","t":"span"},", midnight, 3:00 ",{"c":["am"],"sourceClass":"sc","t":"span"},", and 6:00 ",{"c":["am"],"sourceClass":"sc","t":"span"},". ",{"c":["See"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Night_Article_TyndaleOpenBibleDictionary","id":"Night_Article_TyndaleOpenBibleDictionary","rawId":"Night_Article_TyndaleOpenBibleDictionary","t":"link","v":"Night"},"."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Watch","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Lam 2:19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Lam.2.19","rawQueryValue":"Lam.2.19","sourceRefExact":"Lam.2.19"},{"anchorText":"Jgs 7:19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.7.19","rawQueryValue":"Judg.7.19","sourceRefExact":"Judg.7.19"},{"anchorText":"Ex 14:24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.14.24","rawQueryValue":"Exod.14.24","sourceRefExact":"Exod.14.24"},{"anchorText":"1 Sm 11:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.11.11","rawQueryValue":"1Sam.11.11","sourceRefExact":"1Sam.11.11"},{"anchorText":"Mt 14:25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.14.25","rawQueryValue":"Matt.14.25","sourceRefExact":"Matt.14.25"},{"anchorText":"Mk 6:48","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mark.6.48","rawQueryValue":"Mark.6.48","sourceRefExact":"Mark.6.48"}],"sourceItemFragmentSha256":"89771fc1bcfe3ec26173d15afc2e938409de2868c52f85a1020ddae7d9bf2306","sourceItemName":"Watch","sourceItemOrder":10,"sourceMember":"Articles/W.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Watch","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Watch","title":"Watch","version":"v2-a101d843a2f0cd3fc0c6"}