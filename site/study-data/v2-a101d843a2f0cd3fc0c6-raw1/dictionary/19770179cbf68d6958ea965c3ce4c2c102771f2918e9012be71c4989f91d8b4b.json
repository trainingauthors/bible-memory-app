{"content":[{"c":["ABRON"],"sourceClass":"h1","t":"p"},{"c":["Brook or wadi mentioned in the book of Judith, located on the route of attack of Nebuchadnezzar’s general, Holofernes (",{"href":"?bref=Jdt.2.24","r":"Jdt.2.24","rawR":"Jdt.2.24","sourceRefs":[{"raw":"Jdt.2.24","value":"Jdt.2.24"}],"t":"ref","v":"2:24"},"). Some early commentators identified it with the biblical Jabbok (",{"href":"?bref=Num.21.24","r":"Num.21.24","rawR":"Num.21.24","sourceRefs":[{"raw":"Num.21.24","value":"Num.21.24"}],"t":"ref","v":"Nm 21:24"},"). Others called it the Cherbon, possibly through a misreading of Habor (",{"href":"?bref=2Kgs.17.6","r":"2Kgs.17.6","rawR":"2Kgs.17.6","sourceRefs":[{"raw":"2Kgs.17.6","value":"2Kgs.17.6"}],"t":"ref","v":"2 Kgs 17:6"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Abron","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2:24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Jdt.2.24","rawQueryValue":"Jdt.2.24","sourceRefExact":"Jdt.2.24"},{"anchorText":"Nm 21:24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.21.24","rawQueryValue":"Num.21.24","sourceRefExact":"Num.21.24"},{"anchorText":"2 Kgs 17:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.17.6","rawQueryValue":"2Kgs.17.6","sourceRefExact":"2Kgs.17.6"}],"sourceItemFragmentSha256":"dafc0ea6f43cbc3550cf693fe5e16b74a8041975d4a48a0685cc0369cd655a0d","sourceItemName":"Abron","sourceItemOrder":63,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Abron","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Abron","title":"Abron","version":"v2-a101d843a2f0cd3fc0c6"}