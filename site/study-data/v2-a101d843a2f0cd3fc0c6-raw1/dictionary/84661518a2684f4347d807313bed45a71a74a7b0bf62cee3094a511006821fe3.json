efExact":"?bref=Josh.22.13,30-32","rawQueryValue":"Josh.22.13,30-32","sourceRefExact":"Josh.22.13,30-32"},{"anchorText":"Jgs 20:28","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.20.28","rawQueryValue":"Judg.20.28","sourceRefExact":"Judg.20.28"},{"anchorText":"Ezr 7:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.7.5","rawQueryValue":"Ezra.7.5","sourceRefExact":"Ezra.7.5"},{"anchorText":"8:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.8.2","rawQueryValue":"Ezra.8.2","sourceRefExact":"Ezra.8.2"},{"anchorText":"1 Sm 1:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.1.3","rawQueryValue":"1Sam.1.3","sourceRefExact":"1Sam.1.3"},{"anchorText":"2:12-17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.2.12-17","rawQueryValue":"1Sam.2.12-17","sourceRefExact":"1Sam.2.12-17"},{"anchorText":"22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.2.22","rawQueryValue":"1Sam.2.22","sourceRefExact":"1Sam.2.22"},{"anchorText":"25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.2.25","rawQueryValue":"1Sam.2.25","sourceRefExact":"1Sam.2.25"},{"anchorText":"34","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.2.34","rawQueryValue":"1Sam.2.34","sourceRefExact":"1Sam.2.34"},{"anchorText":"4:11, 17-19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.4.11,17-19","rawQueryValue":"1Sam.4.11,17-19","sourceRefExact":"1Sam.4.11,17-19"},{"anchorText":"14:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.14.3","rawQueryValue":"1Sam.14.3","sourceRefExact":"1Sam.14.3"},{"anchorText":"Ezr 8:33","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.8.33","rawQueryValue":"Ezr