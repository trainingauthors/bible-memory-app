t":"2Chr.34.12"},{"anchorText":"Ezr 8:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.8.9","rawQueryValue":"Ezra.8.9","sourceRefExact":"Ezra.8.9"},{"anchorText":"Neh 10:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.10.5","rawQueryValue":"Neh.10.5","sourceRefExact":"Neh.10.5"},{"anchorText":"Neh 12:25-26","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.12.25-26","rawQueryValue":"Neh.12.25-26","sourceRefExact":"Neh.12.25-26"},{"anchorText":"Ob 1:11-14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Obad.1.11-14","rawQueryValue":"Obad.1.11-14","sourceRefExact":"Obad.1.11-14"},{"anchorText":"2-10, 15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Obad.1.2-10,15","rawQueryValue":"Obad.1.2-10,15","sourceRefExact":"Obad.1.2-10,15"}],"sourceItemFragmentSha256":"9d5e1b1e025b5c5a29c396e26a4968a1f662c51ff8f64824d30c75f605719a2c","sourceItemName":"ObadiahPerson","sourceItemOrder":9,"sourceMember":"Articles/O.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"ObadiahPerson","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Obadiah (Person)","title":"Obadiah (Person)","version":"v2-a101d843a2f0cd3fc0c6"}