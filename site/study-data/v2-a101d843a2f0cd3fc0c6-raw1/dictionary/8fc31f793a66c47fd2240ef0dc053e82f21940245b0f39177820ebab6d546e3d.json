"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Job.19.25-26","rawQueryValue":"Job.19.25-26","sourceRefExact":"Job.19.25-26"},{"anchorText":"1 Sm 28:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.28.11","rawQueryValue":"1Sam.28.11","sourceRefExact":"1Sam.28.11"},{"anchorText":"Dt 18:9-11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.18.9-11","rawQueryValue":"Deut.18.9-11","sourceRefExact":"Deut.18.9-11"},{"anchorText":"1 Sm 28:3, 9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.28.3,9","rawQueryValue":"1Sam.28.3,9","sourceRefExact":"1Sam.28.3,9"}],"sourceItemFragmentSha256":"f3120ab6f3987e1c6d245dde23f8152d13f28bf06bd7e52a734d28523e62e307","sourceItemName":"Sheol","sourceItemOrder":285,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Sheol","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Sheol*","title":"Sheol*","version":"v2-a101d843a2f0cd3fc0c6"}