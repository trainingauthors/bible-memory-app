{"content":[{"c":["SHEBUEL"],"sourceClass":"h1","t":"p"},{"c":["1. Gershon’s son and Moses’ grandson from Levi’s tribe (",{"href":"?bref=1Chr.23.15-16","r":"1Chr.23.15-16","rawR":"1Chr.23.15-16","sourceRefs":[{"raw":"1Chr.23.15-16","value":"1Chr.23.15-16"}],"t":"ref","v":"1 Chr 23:15-16"},"); father of Jehdeiah (",{"href":"?bref=1Chr.24.20","r":"1Chr.24.20","rawR":"1Chr.24.20","sourceRefs":[{"raw":"1Chr.24.20","value":"1Chr.24.20"}],"t":"ref","v":"24:20"},", “Shubael”). He was the chief officer in charge of the treasuries (",{"href":"?bref=1Chr.26.24","r":"1Chr.26.24","rawR":"1Chr.26.24","sourceRefs":[{"raw":"1Chr.26.24","value":"1Chr.26.24"}],"t":"ref","v":"26:24"},")."],"sourceClass":"list","t":"p"},{"c":["2. Levite, Heman’s son and a musician in the tabernacle (",{"href":"?bref=1Chr.25.4,20","r":"1Chr.25.4,20","rawR":"1Chr.25.4,20","sourceRefs":[{"raw":"1Chr.25.4,20","value":"1Chr.25.4,20"}],"t":"ref","v":"1 Chr 25:4, 20"},", “Shubael”)."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Shebuel","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 23:15-16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.23.15-16","rawQueryValue":"1Chr.23.15-16","sourceRefExact":"1Chr.23.15-16"},{"anchorText":"24:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.24.20","rawQueryValue":"1Chr.24.20","sourceRefExact":"1Chr.24.20"},{"anchorText":"26:24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.26.24","rawQueryValue":"1Chr.26.24","sourceRefExact":"1Chr.26.24"},{"anchorText":"1 Chr 25:4, 20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.25.4,20","rawQueryValue":"1Chr.25.4,20","sourceRefExact":"1Chr.25.4,20"}],"sourceItemFragmentSha256":"6f0885214433d282c09c6be00083658f1d467d3b9d603ae901196c5