{"content":[{"c":["JANOAH"],"sourceClass":"h1","t":"p"},{"c":["1. City defining the eastern border of Ephraim’s territory, located southeast of Shechem and northeast of Shiloh (",{"href":"?bref=Josh.16.6-7","r":"Josh.16.6-7","rawR":"Josh.16.6-7","sourceRefs":[{"raw":"Josh.16.6-7","value":"Josh.16.6-7"}],"t":"ref","v":"Jos 16:6-7"},"). It has been identified with modern Khirbet Yanun."],"sourceClass":"list","t":"p"},{"c":["2. Town (modern Yanuh) of Naphtali’s tribe captured by Tiglath-pileser, king of Assyria, during the reign of King Pekah of Israel in 732 ",{"c":["BC"],"sourceClass":"era","t":"span"}," (",{"href":"?bref=2Kgs.15.29","r":"2Kgs.15.29","rawR":"2Kgs.15.29","sourceRefs":[{"raw":"2Kgs.15.29","value":"2Kgs.15.29"}],"t":"ref","v":"2 Kgs 15:29"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Janoah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 16:6-7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.16.6-7","rawQueryValue":"Josh.16.6-7","sourceRefExact":"Josh.16.6-7"},{"anchorText":"2 Kgs 15:29","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.15.29","rawQueryValue":"2Kgs.15.29","sourceRefExact":"2Kgs.15.29"}],"sourceItemFragmentSha256":"0042bcb84815ddb8312a0560564726d04e5574aad349594c8b567b49063d885e","sourceItemName":"Janoah","sourceItemOrder":82,"sourceMember":"Articles/J.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Janoah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Janoah","title":"Janoah","version":"v2-a101d843a2f0cd3fc0c6"}