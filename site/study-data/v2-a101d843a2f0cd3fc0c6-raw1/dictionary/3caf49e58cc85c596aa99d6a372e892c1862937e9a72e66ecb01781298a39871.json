{"content":[{"c":["IBZAN"],"sourceClass":"h1","t":"p"},{"c":["Judge who ruled over Israel, or part of it, for seven years (",{"href":"?bref=Judg.12.8-10","r":"Judg.12.8-10","rawR":"Judg.12.8-10","sourceRefs":[{"raw":"Judg.12.8-10","value":"Judg.12.8-10"}],"t":"ref","v":"Jgs 12:8-10"},"). Ibzan was a native of Bethlehem, probably of Zebulun, and was buried in his place of birth. Jewish tradition identified Ibzan with Boaz and consequently understood his native city to be Bethlehem in Judah. Ibzan had 30 sons and 30 daughters and was a man of wealth and high social standing."],"sourceClass":"fl","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=JudgesBookof_Article_TyndaleOpenBibleDictionary","id":"JudgesBookof_Article_TyndaleOpenBibleDictionary","rawId":"JudgesBookof_Article_TyndaleOpenBibleDictionary","t":"link","v":"Judges, Book of"},"."],"sourceClass":"","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Ibzan","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jgs 12:8-10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.12.8-10","rawQueryValue":"Judg.12.8-10","sourceRefExact":"Judg.12.8-10"}],"sourceItemFragmentSha256":"19bbe7c23cc885278631566f20ba525514ffaafa0cf9a330c761896e35d320c6","sourceItemName":"Ibzan","sourceItemOrder":10,"sourceMember":"Articles/I.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Ibzan","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Ibzan","title":"Ibzan","version":"v2-a101d843a2f0cd3fc0c6"}