"sourceRefExact":"1Sam.1.1"},{"anchorText":"2 Kgs 8:29","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Kgs.8.29","rawQueryValue":"2Kgs.8.29","sourceRefExact":"2Kgs.8.29"},{"anchorText":"2 Chr 22:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Chr.22.6","rawQueryValue":"2Chr.22.6","sourceRefExact":"2Chr.22.6"}],"sourceItemFragmentSha256":"7c23a394265114ee41a233ba3d7b15b519c94200c61830160807942c250de097","sourceItemName":"Ramah","sourceItemOrder":35,"sourceMember":"Articles/R.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Ramah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Ramah","title":"Ramah","version":"v2-a101d843a2f0cd3fc0c6"}