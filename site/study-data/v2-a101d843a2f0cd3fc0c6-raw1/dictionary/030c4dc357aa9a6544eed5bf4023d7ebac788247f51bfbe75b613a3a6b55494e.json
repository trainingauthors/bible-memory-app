{"content":[{"c":["MYRA"],"sourceClass":"h1","t":"p"},{"c":["Port city on the southern coast of Asia Minor in the province of Lycia, identified with the modern Demre in Turkey. According to ",{"href":"?bref=Acts.27.5-6","r":"Acts.27.5-6","rawR":"Acts.27.5-6","sourceRefs":[{"raw":"Acts.27.5-6","value":"Acts.27.5-6"}],"t":"ref","v":"Acts 27:5-6"},", Paul and his military escort briefly stopped here to change ships on their journey to Rome, where Paul was to stand trial."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Myra","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Acts 27:5-6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.27.5-6","rawQueryValue":"Acts.27.5-6","sourceRefExact":"Acts.27.5-6"}],"sourceItemFragmentSha256":"cf043d342af8957fee737f3f055de31ab0d3fddbc627164247cfa5880955df85","sourceItemName":"Myra","sourceItemOrder":445,"sourceMember":"Articles/M.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Myra","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Myra","title":"Myra","version":"v2-a101d843a2f0cd3fc0c6"}