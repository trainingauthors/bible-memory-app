{"content":[{"c":["ONESIPHORUS"],"sourceClass":"h1","t":"p"},{"c":["Christian who took care of Paul during his confinement in Ephesus. After Paul’s transfer to Rome, Onesiphorus eagerly sought him out and ministered to him there (",{"href":"?bref=2Tim.1.16","r":"2Tim.1.16","rawR":"2Tim.1.16","sourceRefs":[{"raw":"2Tim.1.16","value":"2Tim.1.16"}],"t":"ref","v":"2 Tm 1:16"},"). In the salutation of his Second Letter to Timothy, Paul sent greetings to Onesiphorus and his household (",{"href":"?bref=2Tim.4.19","r":"2Tim.4.19","rawR":"2Tim.4.19","sourceRefs":[{"raw":"2Tim.4.19","value":"2Tim.4.19"}],"t":"ref","v":"4:19"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Onesiphorus","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"2 Tm 1:16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Tim.1.16","rawQueryValue":"2Tim.1.16","sourceRefExact":"2Tim.1.16"},{"anchorText":"4:19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Tim.4.19","rawQueryValue":"2Tim.4.19","sourceRefExact":"2Tim.4.19"}],"sourceItemFragmentSha256":"2a96bee85492283c39b1c7ab52fbea270ff4cb835a7dc1d7bf07ae11be014c7d","sourceItemName":"Onesiphorus","sourceItemOrder":58,"sourceMember":"Articles/O.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Onesiphorus","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Onesiphorus","title":"Onesiphorus","version":"v2-a101d843a2f0cd3fc0c6"}