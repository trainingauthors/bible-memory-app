{"content":[{"c":["BEN-ABINADAB"],"sourceClass":"h1","t":"p"},{"c":["One of 12 officers appointed to requisition food for King Solomon’s household. His administrative district comprised the area around Naphath-dor, the coastal city south of Mt Carmel (",{"href":"?bref=1Kgs.4.11","r":"1Kgs.4.11","rawR":"1Kgs.4.11","sourceRefs":[{"raw":"1Kgs.4.11","value":"1Kgs.4.11"}],"t":"ref","v":"1 Kgs 4:11"},"). The name means “son of Abinadab” and probably indicates that Ben-abinadab was the son of Solomon’s uncle Abinadab (",{"href":"?bref=1Sam.16.8","r":"1Sam.16.8","rawR":"1Sam.16.8","sourceRefs":[{"raw":"1Sam.16.8","value":"1Sam.16.8"}],"t":"ref","v":"1 Sm 16:8"},"; ",{"href":"?bref=1Chr.2.13","r":"1Chr.2.13","rawR":"1Chr.2.13","sourceRefs":[{"raw":"1Chr.2.13","value":"1Chr.2.13"}],"t":"ref","v":"1 Chr 2:13"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"BenAbinadab","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Kgs 4:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.4.11","rawQueryValue":"1Kgs.4.11","sourceRefExact":"1Kgs.4.11"},{"anchorText":"1 Sm 16:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.16.8","rawQueryValue":"1Sam.16.8","sourceRefExact":"1Sam.16.8"},{"anchorText":"1 Chr 2:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.2.13","rawQueryValue":"1Chr.2.13","sourceRefExact":"1Chr.2.13"}],"sourceItemFragmentSha256":"a5cec13e362670dab8c0525cf40412f8ebef41124f06ac401bb76237e2777e91","sourceItemName":"BenAbinadab","sourceItemOrder":173,"sourceMember":"Articles/B.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"BenAbinadab","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Ben-Abinadab","title":"Ben-Abinadab","version":"v2-a101d843a2f0cd3fc0c6"}