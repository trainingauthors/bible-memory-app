{"content":[{"c":["ASHBEL, ASHBELITE"],"sourceClass":"h1","t":"p"},{"c":["Benjamin’s son who emigrated to Egypt with his grandfather Jacob (",{"href":"?bref=Gen.46.21","r":"Gen.46.21","rawR":"Gen.46.21","sourceRefs":[{"raw":"Gen.46.21","value":"Gen.46.21"}],"t":"ref","v":"Gn 46:21"},"; ",{"href":"?bref=1Chr.8.1","r":"1Chr.8.1","rawR":"1Chr.8.1","sourceRefs":[{"raw":"1Chr.8.1","value":"1Chr.8.1"}],"t":"ref","v":"1 Chr 8:1"},"). The Ashbelites, his descendants, were included in Moses’ census in the wilderness (",{"href":"?bref=Num.26.38","r":"Num.26.38","rawR":"Num.26.38","sourceRefs":[{"raw":"Num.26.38","value":"Num.26.38"}],"t":"ref","v":"Nm 26:38"},"). Ashbel is elsewhere called Jediael (",{"href":"?bref=1Chr.7.6","r":"1Chr.7.6","rawR":"1Chr.7.6","sourceRefs":[{"raw":"1Chr.7.6","value":"1Chr.7.6"}],"t":"ref","v":"1 Chr 7:6"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"AshbelAshbelite","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 46:21","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.46.21","rawQueryValue":"Gen.46.21","sourceRefExact":"Gen.46.21"},{"anchorText":"1 Chr 8:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.8.1","rawQueryValue":"1Chr.8.1","sourceRefExact":"1Chr.8.1"},{"anchorText":"Nm 26:38","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.26.38","rawQueryValue":"Num.26.38","sourceRefExact":"Num.26.38"},{"anchorText":"1 Chr 7:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.7.6","rawQueryValue":"1Chr.7.6","sourceRefExact":"1Chr.7.6"}],"sourceItemFragmentSha256":"5c0ee9973f9ddef61888f40eb68db3fb2072f7668d1a7cd8fc62aedcbc3b970d","sourceItemName":"AshbelAshbelite","sourceItemOrder":534,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]}