{"content":[{"c":["ADDAN"],"sourceClass":"h1","t":"p"},{"c":["Persian city from which Israelite exiles returned with Ezra to Jerusalem (",{"href":"?bref=Ezra.2.59","r":"Ezra.2.59","rawR":"Ezra.2.59","sourceRefs":[{"raw":"Ezra.2.59","value":"Ezra.2.59"}],"t":"ref","v":"Ezr 2:59"},"), probably named after a Babylonian god called Addu. The exiles returning from this city were unable to give evidence of their Jewish descent, having lost their genealogical credentials. Also spelled Addon (",{"href":"?bref=Neh.7.61","r":"Neh.7.61","rawR":"Neh.7.61","sourceRefs":[{"raw":"Neh.7.61","value":"Neh.7.61"}],"t":"ref","v":"Neh 7:61"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Addan","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ezr 2:59","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.2.59","rawQueryValue":"Ezra.2.59","sourceRefExact":"Ezra.2.59"},{"anchorText":"Neh 7:61","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.7.61","rawQueryValue":"Neh.7.61","sourceRefExact":"Neh.7.61"}],"sourceItemFragmentSha256":"5c09c177c60086039f0711af64d2f63fe1f936ef9e461cd682cac8c08e385f8d","sourceItemName":"Addan","sourceItemOrder":109,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Addan","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Addan","title":"Addan","version":"v2-a101d843a2f0cd3fc0c6"}