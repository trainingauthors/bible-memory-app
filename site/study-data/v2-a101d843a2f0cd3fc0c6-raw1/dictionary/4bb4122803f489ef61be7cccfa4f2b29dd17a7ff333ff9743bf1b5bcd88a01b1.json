{"content":[{"c":["SECACAH"],"sourceClass":"h1","t":"p"},{"c":["One of six cities situated in the wilderness region immediately west of the Dead Sea in the valley of Achor and included in the territory allotted to Judah, mentioned between Middin and Nibshan (",{"href":"?bref=Josh.15.61","r":"Josh.15.61","rawR":"Josh.15.61","sourceRefs":[{"raw":"Josh.15.61","value":"Josh.15.61"}],"t":"ref","v":"Jos 15:61"},"). Its location is perhaps three miles (4.8 kilometers) southwest of Khirbet Qumran at the modern town of Khirbet es-Samrah."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Secacah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 15:61","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.61","rawQueryValue":"Josh.15.61","sourceRefExact":"Josh.15.61"}],"sourceItemFragmentSha256":"0971e2f8b27569d1b465c00824cd0b688c1e9132344bca83ace8b7e0b5491b0e","sourceItemName":"Secacah","sourceItemOrder":123,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Secacah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Secacah","title":"Secacah","version":"v2-a101d843a2f0cd3fc0c6"}