15.1-37","sourceRefExact":"2Sam.15.1-37"},{"anchorText":"18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.18.1-33","rawQueryValue":"2Sam.18.1-33","sourceRefExact":"2Sam.18.1-33"},{"anchorText":"18:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.18.5","rawQueryValue":"2Sam.18.5","sourceRefExact":"2Sam.18.5"},{"anchorText":"10-17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.18.10-17","rawQueryValue":"2Sam.18.10-17","sourceRefExact":"2Sam.18.10-17"},{"anchorText":"19:5-7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.19.5-7","rawQueryValue":"2Sam.19.5-7","sourceRefExact":"2Sam.19.5-7"},{"anchorText":"13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.19.13","rawQueryValue":"2Sam.19.13","sourceRefExact":"2Sam.19.13"},{"anchorText":"20:8-10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.20.8-10","rawQueryValue":"2Sam.20.8-10","sourceRefExact":"2Sam.20.8-10"},{"anchorText":"2 Sm 20:23, 24:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.20.23,24","rawQueryValue":"2Sam.20.23,24","sourceRefExact":"2Sam.20.23,24"},{"anchorText":"1 Kgs 1:19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.1.19","rawQueryValue":"1Kgs.1.19","sourceRefExact":"1Kgs.1.19"},{"anchorText":"1 Kgs 1:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.1.7","rawQueryValue":"1Kgs.1.7","sourceRefExact":"1Kgs.1.7"},{"anchorText":"2:5-9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.2.5-9","rawQueryValue":"1Kgs.2.5-9","sourceRefExact":"1Kgs.2.5-9"},{"anchorText":"23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.2.23","rawQueryValue":"1Kgs.2.23","sourceRefExact":"1Kgs.2.23"},{"anchorText":"26","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.2.26","rawQueryValue":"1Kgs.2.26","sourceRefExact":"1Kgs.2.26"},{"anchorText":"28","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.2.28","rawQueryValue":"1Kgs.2.28","sourceRefExact":"1Kgs.2.28"},{"anchorText":"28-35","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.2.28-35","rawQueryValue":"1Kgs.2.28-35","sourceRefExact":"1Kgs.2.28-35"},{"anchorText":"1 Chronicles 2:54","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.2.54","rawQueryValue":"1Chr.2.54","sourceRefExact":"1Chr.2.54"},{"anchorText":"1 Chr 4:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.4.14","rawQueryValue":"1Chr.4.14","sourceRefExact":"1Chr.4.14"},{"anchorText":"Ezr 2:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.2.6","rawQueryValue":"Ezra.2.6","sourceRefExact":"Ezra.2.6"},{"anchorText":"Neh 7:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.7.11","rawQueryValue":"Neh.7.11","sourceRefExact":"Neh.7.11"},{"anchorText":"Ezr 8:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.8.9","rawQueryValue":"Ezra.8.9","sourceRefExact":"Ezra.8.9"}],"sourceItemFragmentSha256":"2c7292226da4273c7b8b6b9bb91568e247959e60981289b2f9fa2d02fc4791f0","sourceItemName":"Joab","sourceItemOrder":256,"sourceMember":"Articles/J.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Joab","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Joab","title":"Joab","version":"v2-a101d843a2f0cd3fc0c6"}