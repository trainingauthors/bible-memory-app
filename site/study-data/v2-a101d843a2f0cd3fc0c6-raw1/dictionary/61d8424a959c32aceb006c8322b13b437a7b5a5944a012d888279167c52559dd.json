{"content":[{"c":["EPHRATH (P",{"c":["lace"],"sourceClass":"lc","t":"span"},")"],"sourceClass":"h1","t":"p"},{"c":["1. Town in the Judean hill country later named Bethlehem. It was on the road to Ephrath that Rachel died while giving birth to Benjamin (",{"href":"?bref=Gen.35.16-19","r":"Gen.35.16-19","rawR":"Gen.35.16-19","sourceRefs":[{"raw":"Gen.35.16-19","value":"Gen.35.16-19"}],"t":"ref","v":"Gn 35:16-19"},"). This town was the home of Naomi’s family, who identified themselves as Ephrathites (",{"href":"?bref=Ruth.1.2","r":"Ruth.1.2","rawR":"Ruth.1.2","sourceRefs":[{"raw":"Ruth.1.2","value":"Ruth.1.2"}],"t":"ref","v":"Ru 1:2"},"). Ephrath was the dwelling place of Ruth and Boaz (",{"href":"?bref=Ruth.4.11","r":"Ruth.4.11","rawR":"Ruth.4.11","sourceRefs":[{"raw":"Ruth.4.11","value":"Ruth.4.11"}],"t":"ref","v":"Ru 4:11"},"), the childhood home of David (",{"href":"?bref=1Sam.17.12","r":"1Sam.17.12","rawR":"1Sam.17.12","sourceRefs":[{"raw":"1Sam.17.12","value":"1Sam.17.12"}],"t":"ref","v":"1 Sm 17:12"},"), and the announced birthplace of the Messiah (",{"href":"?bref=Mic.5.2","r":"Mic.5.2","rawR":"Mic.5.2","sourceRefs":[{"raw":"Mic.5.2","value":"Mic.5.2"}],"t":"ref","v":"Mi 5:2"},")."],"sourceClass":"list","t":"p"},{"c":[{"c":["See also"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Bethlehem_Article_TyndaleOpenBibleDictionary","id":"Bethlehem_Article_TyndaleOpenBibleDictionary","rawId":"Bethlehem_Article_TyndaleOpenBibleDictionary","t":"link","v":"Bethlehem #1"},"."],"sourceClass":"sp","t":"p"},{"c":["2. District in which the city of Kiriath-jearim was situated and where the ark of the covenant was kept (",{"href":"?bref=Ps.132.6","r":"Ps.132.6","rawR":"Ps.132.6","sourceRefs":[{"raw":"Ps.132.6","value":"Ps.132.6"}],"t":"ref","v":"Ps 132:6"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"EphrathPlace","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 35:16-19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.35.16-19","rawQueryValue":"Gen.35.16-19","sourceRefExact":"Gen.35.16-19"},{"anchorText":"Ru 1:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ruth.1.2","rawQueryValue":"Ruth.1.2","sourceRefExact":"Ruth.1.2"},{"anchorText":"Ru 4:11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ruth.4.11","rawQueryValue":"Ruth.4.11","sourceRefExact":"Ruth.4.11"},{"anchorText":"1 Sm 17:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Sam.17.12","rawQueryValue":"1Sam.17.12","sourceRefExact":"1Sam.17.12"},{"anchorText":"Mi 5:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mic.5.2","rawQueryValue":"Mic.5.2","sourceRefExact":"Mic.5.2"},{"anchorText":"Ps 132:6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ps.132.6","rawQueryValue":"Ps.132.6","sourceRefExact":"Ps.132.6"}],"sourceItemFragmentSha256":"5a87306fc4e02cf9cd677e392de9d4407d8b5985d64e197ee72e67597c7e160b","sourceItemName":"EphrathPlace","sourceItemOrder":211,"sourceMember":"Articles/E.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"EphrathPlace","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Ephrath (Place)","title":"Ephrath (Place)","version":"v2-a101d843a2f0cd3fc0c6"}