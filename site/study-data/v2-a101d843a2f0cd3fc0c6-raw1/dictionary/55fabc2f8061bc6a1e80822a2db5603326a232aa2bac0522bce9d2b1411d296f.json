{"content":[{"c":["ATAROTH"],"sourceClass":"h1","t":"p"},{"c":["1. Town in the mountainous region east of the Jordan River. Ataroth was rebuilt by Gad’s tribe (",{"href":"?bref=Num.32.3,33-36","r":"Num.32.3,33-36","rawR":"Num.32.3,33-36","sourceRefs":[{"raw":"Num.32.3,33-36","value":"Num.32.3,33-36"}],"t":"ref","v":"Nm 32:3, 33-36"},"). It was mentioned on the famous Moabite Stone by King Mesha, who said he brought back the “altar of David” from Ataroth. This Ataroth is probably modern Khirbet Attarus."],"sourceClass":"list","t":"p"},{"c":["2. Town on the southern border of Ephraim’s allotment (",{"href":"?bref=Josh.16.2","r":"Josh.16.2","rawR":"Josh.16.2","sourceRefs":[{"raw":"Josh.16.2","value":"Josh.16.2"}],"t":"ref","v":"Jos 16:2"},"), possibly the same as Ataroth-addar (",{"href":"?bref=Josh.16.5","r":"Josh.16.5","rawR":"Josh.16.5","sourceRefs":[{"raw":"Josh.16.5","value":"Josh.16.5"}],"t":"ref","v":"Jos 16:5"},"; ",{"href":"?bref=Josh.18.13","r":"Josh.18.13","rawR":"Josh.18.13","sourceRefs":[{"raw":"Josh.18.13","value":"Josh.18.13"}],"t":"ref","v":"18:13"},")."],"sourceClass":"list","t":"p"},{"c":["3. Town in the Jordan Valley on the northeast border of Ephraim’s allotment (",{"href":"?bref=Josh.16.7","r":"Josh.16.7","rawR":"Josh.16.7","sourceRefs":[{"raw":"Josh.16.7","value":"Josh.16.7"}],"t":"ref","v":"Jos 16:7"},")."],"sourceClass":"list","t":"p"},{"c":["4. Town in Judah near Bethlehem belonging to the family of Joab, Salma’s son (",{"href":"?bref=1Chr.2.54","r":"1Chr.2.54","rawR":"1Chr.2.54","sourceRefs":[{"raw":"1Chr.2.54","value":"1Chr.2.54"}],"t":"ref","v":"1 Chr 2:54"},", ",{"c":["kjv"],"sourceClass":"sc","t":"span"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Ataroth","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Nm 32:3, 33-36","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.32.3,33-36","rawQueryValue":"Num.32.3,33-36","sourceRefExact":"Num.32.3,33-36"},{"anchorText":"Jos 16:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.16.2","rawQueryValue":"Josh.16.2","sourceRefExact":"Josh.16.2"},{"anchorText":"Jos 16:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.16.5","rawQueryValue":"Josh.16.5","sourceRefExact":"Josh.16.5"},{"anchorText":"18:13","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.18.13","rawQueryValue":"Josh.18.13","sourceRefExact":"Josh.18.13"},{"anchorText":"Jos 16:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.16.7","rawQueryValue":"Josh.16.7","sourceRefExact":"Josh.16.7"},{"anchorText":"1 Chr 2:54","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.2.54","rawQueryValue":"1Chr.2.54","sourceRefExact":"1Chr.2.54"}],"sourceItemFragmentSha256":"697ca87b8132d3c731aa5fcbcdd8ba4783c0a59d95fcc624935db0695bd521f6","sourceItemName":"Ataroth","sourceItemOrder":595,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Ataroth","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Ataroth","title":"Ataroth","version":"v2-a101d843a2f0cd3fc0c6"}