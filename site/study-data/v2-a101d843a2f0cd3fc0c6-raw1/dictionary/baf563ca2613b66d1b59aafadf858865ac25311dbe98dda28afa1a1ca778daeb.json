{"content":[{"c":["ERASTUS"],"sourceClass":"h1","t":"p"},{"c":["Name mentioned three times in the NT. Whether only one individual is being referred to cannot be ascertained, although in each case Erastus is an associate of Paul’s. The three instances are (1) a helper of Paul sent with Timothy into Macedonia (",{"href":"?bref=Acts.19.22","r":"Acts.19.22","rawR":"Acts.19.22","sourceRefs":[{"raw":"Acts.19.22","value":"Acts.19.22"}],"t":"ref","v":"Acts 19:22"},"); (2) the city treasurer of Corinth (a steward of financial affairs, possibly a slave or freedman of some wealth and an important man in the Corinthian community), who sends greetings with Paul to the church in Rome (",{"href":"?bref=Rom.16.23","r":"Rom.16.23","rawR":"Rom.16.23","sourceRefs":[{"raw":"Rom.16.23","value":"Rom.16.23"}],"t":"ref","v":"Rom 16:23"},"); and (3) a friend of Paul’s who stayed at Corinth (",{"href":"?bref=2Tim.4.20","r":"2Tim.4.20","rawR":"2Tim.4.20","sourceRefs":[{"raw":"2Tim.4.20","value":"2Tim.4.20"}],"t":"ref","v":"2 Tm 4:20"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Erastus","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Acts 19:22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Acts.19.22","rawQueryValue":"Acts.19.22","sourceRefExact":"Acts.19.22"},{"anchorText":"Rom 16:23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rom.16.23","rawQueryValue":"Rom.16.23","sourceRefExact":"Rom.16.23"},{"anchorText":"2 Tm 4:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Tim.4.20","rawQueryValue":"2Tim.4.20","sourceRefExact":"2Tim.4.20"}],"sourceItemFragmentSha256":"75b9c3ab118d821b1f040372d53cdd190efe8d10c3030c03d01c15553c019260","sourceItemName":"Erastus","sourceItemOrder":224,"sourceMember":"Articles/E.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Erastus","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Erastus","title":"Erastus","version":"v2-a101d843a2f0cd3fc0c6"}