{"content":[{"c":["MAON (Person), MAONITE"],"sourceClass":"h1","t":"p"},{"c":["Son of Shammai, and Bethzur’s father (",{"href":"?bref=1Chr.2.45","r":"1Chr.2.45","rawR":"1Chr.2.45","sourceRefs":[{"raw":"1Chr.2.45","value":"1Chr.2.45"}],"t":"ref","v":"1 Chr 2:45"},"). He was either the founding father of the people of Bethzur and/or the founder of the city. His descendants are perhaps the Maonites of ",{"href":"?bref=Judg.10.12","r":"Judg.10.12","rawR":"Judg.10.12","sourceRefs":[{"raw":"Judg.10.12","value":"Judg.10.12"}],"t":"ref","v":"Judges 10:12"},"."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"MaonPersonMaonite","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 2:45","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.2.45","rawQueryValue":"1Chr.2.45","sourceRefExact":"1Chr.2.45"},{"anchorText":"Judges 10:12","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.10.12","rawQueryValue":"Judg.10.12","sourceRefExact":"Judg.10.12"}],"sourceItemFragmentSha256":"fa8bb4a2b0de6ad6dd37dcf827824dd6b86f271419215e4e7ab42bca7de851ce","sourceItemName":"MaonPersonMaonite","sourceItemOrder":126,"sourceMember":"Articles/M.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"MaonPersonMaonite","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Maon (Person), Maonite","title":"Maon (Person), Maonite","version":"v2-a101d843a2f0cd3fc0c6"}