{"content":[{"c":["SNARE"],"sourceClass":"h1","t":"p"},{"c":["Literally, a trap used for entangling birds or others mammals; figuratively, anything that entangles or impedes another person. The word is often used in the Scriptures in the figurative sense to describe anything that ensnares people in sin (see ",{"href":"?bref=Deut.7.25","r":"Deut.7.25","rawR":"Deut.7.25","sourceRefs":[{"raw":"Deut.7.25","value":"Deut.7.25"}],"t":"ref","v":"Dt 7:25"},"; ",{"href":"?bref=Eccl.7.26","r":"Eccl.7.26","rawR":"Eccl.7.26","sourceRefs":[{"raw":"Eccl.7.26","value":"Eccl.7.26"}],"t":"ref","v":"Eccl 7:26"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Snare","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Dt 7:25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Deut.7.25","rawQueryValue":"Deut.7.25","sourceRefExact":"Deut.7.25"},{"anchorText":"Eccl 7:26","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Eccl.7.26","rawQueryValue":"Eccl.7.26","sourceRefExact":"Eccl.7.26"}],"sourceItemFragmentSha256":"04d22a8b4ca3c32c17420ac97a3529a43818fa83692d427561c4e78e664f61a7","sourceItemName":"Snare","sourceItemOrder":474,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Snare","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Snare","title":"Snare","version":"v2-a101d843a2f0cd3fc0c6"}