yValue":"Matt.13.3-9","sourceRefExact":"Matt.13.3-9"},{"anchorText":"Mk 4:1-20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mark.4.1-20","rawQueryValue":"Mark.4.1-20","sourceRefExact":"Mark.4.1-20"},{"anchorText":"Lk 8:4-15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Luke.8.4-15","rawQueryValue":"Luke.8.4-15","sourceRefExact":"Luke.8.4-15"},{"anchorText":"Mk 4:15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mark.4.15","rawQueryValue":"Mark.4.15","sourceRefExact":"Mark.4.15"},{"anchorText":"17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mark.4.17","rawQueryValue":"Mark.4.17","sourceRefExact":"Mark.4.17"},{"anchorText":"19","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Mark.4.19","rawQueryValue":"Mark.4.19","sourceRefExact":"Mark.4.19"},{"anchorText":"Gn 3:1-5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.3.1-5","rawQueryValue":"Gen.3.1-5","sourceRefExact":"Gen.3.1-5"},{"anchorText":"2 Pt 2:4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Pet.2.4","rawQueryValue":"2Pet.2.4","sourceRefExact":"2Pet.2.4"},{"anchorText":"Mt 25:41","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Matt.25.41","rawQueryValue":"Matt.25.41","sourceRefExact":"Matt.25.41"},{"anchorText":"Rv 20:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.20.10","rawQueryValue":"Rev.20.10","sourceRefExact":"Rev.20.10"},{"anchorText":"12-15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Rev.20.12-15","rawQueryValue":"Rev.20.12-15","sourceRefExact":"Rev.20.12-15"}],"sourceItemFragmentSha256":"09d1726dd4ab95e7c1781430e8af8d1e0edd4be44b43ce8a58a7745856c69cb4","sourceItemName":"Demon","sourceItemOrder":77,"sourceMember":"Articles/D.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Demon","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Demon","title":"Demon","version":"v2-a101d843a2f0cd3fc0c6"}