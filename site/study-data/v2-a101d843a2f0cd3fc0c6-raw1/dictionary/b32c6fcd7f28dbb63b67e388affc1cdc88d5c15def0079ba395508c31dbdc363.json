{"content":[{"c":["JOZADAK*"],"sourceClass":"h1","t":"p"},{"c":["Seraiah’s son and one of the exiles transported by Nebuchadnezzar to Babylonia (",{"href":"?bref=1Chr.6.14-15","r":"1Chr.6.14-15","rawR":"1Chr.6.14-15","sourceRefs":[{"raw":"1Chr.6.14-15","value":"1Chr.6.14-15"}],"t":"ref","v":"1 Chr 6:14-15"},"). He was the father of Jeshua (also called Joshua), the high priest in postexilic Jerusalem during the days of Zerubbabel (",{"href":"?bref=Ezra.3.2,8","r":"Ezra.3.2,8","rawR":"Ezra.3.2,8","sourceRefs":[{"raw":"Ezra.3.2,8","value":"Ezra.3.2,8"}],"t":"ref","v":"Ezr 3:2, 8"},"; ",{"href":"?bref=Ezra.5.2","r":"Ezra.5.2","rawR":"Ezra.5.2","sourceRefs":[{"raw":"Ezra.5.2","value":"Ezra.5.2"}],"t":"ref","v":"5:2"},"; ",{"href":"?bref=Ezra.10.18","r":"Ezra.10.18","rawR":"Ezra.10.18","sourceRefs":[{"raw":"Ezra.10.18","value":"Ezra.10.18"}],"t":"ref","v":"10:18"},"; ",{"href":"?bref=Neh.12.26","r":"Neh.12.26","rawR":"Neh.12.26","sourceRefs":[{"raw":"Neh.12.26","value":"Neh.12.26"}],"t":"ref","v":"Neh 12:26"},"; ",{"href":"?bref=Hagg.1.1-14","r":"Hagg.1.1-14","rawR":"Hagg.1.1-14","sourceRefs":[{"raw":"Hagg.1.1-14","value":"Hagg.1.1-14"}],"t":"ref","v":"Hg 1:1-14"},"; ",{"href":"?bref=Hagg.2.2-4","r":"Hagg.2.2-4","rawR":"Hagg.2.2-4","sourceRefs":[{"raw":"Hagg.2.2-4","value":"Hagg.2.2-4"}],"t":"ref","v":"2:2-4"},"; ",{"href":"?bref=Zech.6.11","r":"Zech.6.11","rawR":"Zech.6.11","sourceRefs":[{"raw":"Zech.6.11","value":"Zech.6.11"}],"t":"ref","v":"Zec 6:11"},"). Jozadak is alternately called Jehozadak."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Jozadak","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 6:14-15","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.6.14-15","rawQueryValue":"1Chr.6.14-15","sourceRefExact":"1Chr.6.14-15"},{"anchorText":"Ezr 3:2, 8","canonicalization":"deferred_to_dictionary_