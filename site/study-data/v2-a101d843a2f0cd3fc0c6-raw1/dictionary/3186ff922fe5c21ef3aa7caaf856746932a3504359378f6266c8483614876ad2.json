{"content":[{"c":["ITHAMAR"],"sourceClass":"h1","t":"p"},{"c":["Aaron’s fourth and youngest son, who served as a priest to the tribes of Israel during the wilderness period (",{"href":"?bref=Exod.6.23","r":"Exod.6.23","rawR":"Exod.6.23","sourceRefs":[{"raw":"Exod.6.23","value":"Exod.6.23"}],"t":"ref","v":"Ex 6:23"},"; ",{"href":"?bref=Num.3.2-4","r":"Num.3.2-4","rawR":"Num.3.2-4","sourceRefs":[{"raw":"Num.3.2-4","value":"Num.3.2-4"}],"t":"ref","v":"Nm 3:2-4"},"; ",{"href":"?bref=Num.26.60","r":"Num.26.60","rawR":"Num.26.60","sourceRefs":[{"raw":"Num.26.60","value":"Num.26.60"}],"t":"ref","v":"26:60"},"; ",{"href":"?bref=1Chr.6.3","r":"1Chr.6.3","rawR":"1Chr.6.3","sourceRefs":[{"raw":"1Chr.6.3","value":"1Chr.6.3"}],"t":"ref","v":"1 Chr 6:3"},"; ",{"href":"?bref=1Chr.24.2","r":"1Chr.24.2","rawR":"1Chr.24.2","sourceRefs":[{"raw":"1Chr.24.2","value":"1Chr.24.2"}],"t":"ref","v":"24:2"},"). After the death of two of his brothers, he was given the special duty of overseeing the moving of the tabernacle (",{"href":"?bref=Num.4.28,33","r":"Num.4.28,33","rawR":"Num.4.28,33","sourceRefs":[{"raw":"Num.4.28,33","value":"Num.4.28,33"}],"t":"ref","v":"Nm 4:28, 33"},"; ",{"href":"?bref=Num.7.8","r":"Num.7.8","rawR":"Num.7.8","sourceRefs":[{"raw":"Num.7.8","value":"Num.7.8"}],"t":"ref","v":"7:8"},"). During David’s reign, the descendants of Ithamar and Eleazar were organized as the formal temple priesthood (",{"href":"?bref=1Chr.24.3-6","r":"1Chr.24.3-6","rawR":"1Chr.24.3-6","sourceRefs":[{"raw":"1Chr.24.3-6","value":"1Chr.24.3-6"}],"t":"ref","v":"1 Chr 24:3-6"},"). Later, some of his descendants returned with Ezra from Babylon (",{"href":"?bref=Ezra.8.2","r":"Ezra.8.2","rawR":"Ezra.8.2","sourceRefs":[{"raw":"Ezra.8.2","value":"Ezra.8.2"}],"t":"ref","v":"Ezr 8:2"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Ithamar","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ex 6:23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.6.23","rawQueryValue":"Exod.6.23","sourceRefExact":"Exod.6.23"},{"anchorText":"Nm 3:2-4","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.3.2-4","rawQueryValue":"Num.3.2-4","sourceRefExact":"Num.3.2-4"},{"anchorText":"26:60","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.26.60","rawQueryValue":"Num.26.60","sourceRefExact":"Num.26.60"},{"anchorText":"1 Chr 6:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.6.3","rawQueryValue":"1Chr.6.3","sourceRefExact":"1Chr.6.3"},{"anchorText":"24:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.24.2","rawQueryValue":"1Chr.24.2","sourceRefExact":"1Chr.24.2"},{"anchorText":"Nm 4:28, 33","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.4.28,33","rawQueryValue":"Num.4.28,33","sourceRefExact":"Num.4.28,33"},{"anchorText":"7:8","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.7.8","rawQueryValue":"Num.7.8","sourceRefExact":"Num.7.8"},{"anchorText":"1 Chr 24:3-6","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.24.3-6","rawQueryValue":"1Chr.24.3-6","sourceRefExact":"1Chr.24.3-6"},{"anchorText":"Ezr 8:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.8.2","rawQueryValue":"Ezra.8.2","sourceRefExact":"Ezra.8.2"}],"sourceItemFragmentSha256":"b52fd7d8c28c43c79979feacdecdca44fb21446f5d2543ac7dae294901d4dc16","sourceItemName":"Ithamar","sourceItemOrder":136,"sourceMember":"Articles/I.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Ithamar","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Ithamar","title":"Ithamar","version":"v2-a101d843a2f0cd3fc0c6"}