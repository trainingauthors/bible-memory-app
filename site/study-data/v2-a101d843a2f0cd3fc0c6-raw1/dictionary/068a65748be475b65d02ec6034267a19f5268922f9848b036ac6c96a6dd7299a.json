{"content":[{"c":["TAHATH (P",{"c":["erson"],"sourceClass":"lc","t":"span"},")"],"sourceClass":"h1","t":"p"},{"c":["1. Son of Assir and a descendant of Levi through Kohath’s line. He was an ancestor of Heman, one of David’s musicians, and the father of Uriel and Zephaniah (",{"href":"?bref=1Chr.6.24,37","r":"1Chr.6.24,37","rawR":"1Chr.6.24,37","sourceRefs":[{"raw":"1Chr.6.24,37","value":"1Chr.6.24,37"}],"t":"ref","v":"1 Chr 6:24, 37"},")."],"sourceClass":"list","t":"p"},{"c":["2. Ephraimite, the son of Bered and the father of Eleadah (",{"href":"?bref=1Chr.7.20","r":"1Chr.7.20","rawR":"1Chr.7.20","sourceRefs":[{"raw":"1Chr.7.20","value":"1Chr.7.20"}],"t":"ref","v":"1 Chr 7:20"},")."],"sourceClass":"list","t":"p"},{"c":["3. Ephraimite, the son of Eleadah and the father of Zabad (",{"href":"?bref=1Chr.7.20","r":"1Chr.7.20","rawR":"1Chr.7.20","sourceRefs":[{"raw":"1Chr.7.20","value":"1Chr.7.20"}],"t":"ref","v":"1 Chr 7:20"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"TahathPerson","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Chr 6:24, 37","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.6.24,37","rawQueryValue":"1Chr.6.24,37","sourceRefExact":"1Chr.6.24,37"},{"anchorText":"1 Chr 7:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.7.20","rawQueryValue":"1Chr.7.20","sourceRefExact":"1Chr.7.20"},{"anchorText":"1 Chr 7:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.7.20","rawQueryValue":"1Chr.7.20","sourceRefExact":"1Chr.7.20"}],"sourceItemFragmentSha256":"3a6b9ada09a9d58d1eafe61b3b8b7f875ccebd6babb5bd81109c12065e5b357e","sourceItemName":"TahathPerson","sourceItemOrder":26,"sourceMember":"Articles/T.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"TahathPerson","product":"Tyndale