{"content":[{"c":["ZABUD"],"sourceClass":"h1","t":"p"},{"c":["Priest in Solomon’s court and the “king’s friend” (",{"href":"?bref=1Kgs.4.5","r":"1Kgs.4.5","rawR":"1Kgs.4.5","sourceRefs":[{"raw":"1Kgs.4.5","value":"1Kgs.4.5"}],"t":"ref","v":"1 Kgs 4:5"},"). The phrase “king’s friend” may be an official title given to one of the king’s advisers. Hushai the Archite had a similar title in David’s court (",{"href":"?bref=2Sam.15.37","r":"2Sam.15.37","rawR":"2Sam.15.37","sourceRefs":[{"raw":"2Sam.15.37","value":"2Sam.15.37"}],"t":"ref","v":"2 Sm 15:37"},"; ",{"href":"?bref=2Sam.16.16","r":"2Sam.16.16","rawR":"2Sam.16.16","sourceRefs":[{"raw":"2Sam.16.16","value":"2Sam.16.16"}],"t":"ref","v":"16:16"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Zabud","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Kgs 4:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.4.5","rawQueryValue":"1Kgs.4.5","sourceRefExact":"1Kgs.4.5"},{"anchorText":"2 Sm 15:37","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.15.37","rawQueryValue":"2Sam.15.37","sourceRefExact":"2Sam.15.37"},{"anchorText":"16:16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.16.16","rawQueryValue":"2Sam.16.16","sourceRefExact":"2Sam.16.16"}],"sourceItemFragmentSha256":"dfb9c5cc1ba39367f8758b89664e33ad0f171bf97824b19b065ea84a7cc55b16","sourceItemName":"Zabud","sourceItemOrder":10,"sourceMember":"Articles/Z.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Zabud","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Zabud","title":"Zabud","version":"v2-a101d843a2f0cd3fc0c6"}