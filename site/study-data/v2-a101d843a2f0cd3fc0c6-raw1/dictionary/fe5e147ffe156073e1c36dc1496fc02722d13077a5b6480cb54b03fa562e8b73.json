{"content":[{"c":["BE-ESHTERAH"],"sourceClass":"h1","t":"p"},{"c":["City of the half-tribe of Manasseh given to the Levitical family of Gershonites in the partitioning of the Promised Land (",{"href":"?bref=Josh.21.27","r":"Josh.21.27","rawR":"Josh.21.27","sourceRefs":[{"raw":"Josh.21.27","value":"Josh.21.27"}],"t":"ref","v":"Jos 21:27"},"). The spelling is a shortened form for Beth-ashtaroth (“house or place of Ashtaroth”). It seems to be the same as the city of Ashtaroth found in a similar passage (",{"href":"?bref=1Chr.6.71","r":"1Chr.6.71","rawR":"1Chr.6.71","sourceRefs":[{"raw":"1Chr.6.71","value":"1Chr.6.71"}],"t":"ref","v":"1 Chr 6:71"},"). ",{"c":["See"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=AshtarothAshterathite_Article_TyndaleOpenBibleDictionary","id":"AshtarothAshterathite_Article_TyndaleOpenBibleDictionary","rawId":"AshtarothAshterathite_Article_TyndaleOpenBibleDictionary","t":"link","v":"Ashtaroth, Ashterathite"},"; ",{"href":"?item=LeviticalCities_Article_TyndaleOpenBibleDictionary","id":"LeviticalCities_Article_TyndaleOpenBibleDictionary","rawId":"LeviticalCities_Article_TyndaleOpenBibleDictionary","t":"link","v":"Levitical Cities"},"."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"BeEshterah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 21:27","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.21.27","rawQueryValue":"Josh.21.27","sourceRefExact":"Josh.21.27"},{"anchorText":"1 Chr 6:71","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.6.71","rawQueryValue":"1Chr.6.71","sourceRefExact":"1Chr.6.71"}],"sourceItemFragmentSha256":"3f98a1e5a57dc5dc750c251061880966737de5be0866435bdba2ea551493b1ad","sourceItemName":"BeEshterah","sourceItemOrder":149,"sourceMember":"Articles/B.xml","supplementPointersNotIncludedAsContent":[]},"sourceAtt