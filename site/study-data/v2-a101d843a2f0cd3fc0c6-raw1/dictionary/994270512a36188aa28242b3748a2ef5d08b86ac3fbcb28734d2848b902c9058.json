{"content":[{"c":["ACHAICUS"],"sourceClass":"h1","t":"p"},{"c":["Early Christian convert in Corinth. Achaicus, Stephanas, and Fortunatus were visiting Paul in Ephesus when he wrote 1 Corinthians (",{"href":"?bref=1Cor.16.17","r":"1Cor.16.17","rawR":"1Cor.16.17","sourceRefs":[{"raw":"1Cor.16.17","value":"1Cor.16.17"}],"t":"ref","v":"1 Cor 16:17"},"). It was probably Achaicus and his companions who brought Paul a letter from the Corinthian church (",{"href":"?bref=1Cor.7.1","r":"1Cor.7.1","rawR":"1Cor.7.1","sourceRefs":[{"raw":"1Cor.7.1","value":"1Cor.7.1"}],"t":"ref","v":"1 Cor 7:1"},") and returned with Paul’s reply."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Achaicus","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"1 Cor 16:17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Cor.16.17","rawQueryValue":"1Cor.16.17","sourceRefExact":"1Cor.16.17"},{"anchorText":"1 Cor 7:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Cor.7.1","rawQueryValue":"1Cor.7.1","sourceRefExact":"1Cor.7.1"}],"sourceItemFragmentSha256":"8793cea139b7aa20a7174da1f89b0ae7dcc9379ad0035b5f1f1f9cfc37c2281b","sourceItemName":"Achaicus","sourceItemOrder":75,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Achaicus","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Achaicus","title":"Achaicus","version":"v2-a101d843a2f0cd3fc0c6"}