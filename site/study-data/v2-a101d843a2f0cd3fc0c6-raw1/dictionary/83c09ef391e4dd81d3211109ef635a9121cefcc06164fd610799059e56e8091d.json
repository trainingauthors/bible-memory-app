{"content":[{"c":["TIRSHATHA*"],"sourceClass":"h1","t":"p"},{"c":["KJV translation of a Hebrew word designating a title of authority with the connotation of “governor.” It is appended to Zerubbabel’s name (",{"href":"?bref=Ezra.2.63","r":"Ezra.2.63","rawR":"Ezra.2.63","sourceRefs":[{"raw":"Ezra.2.63","value":"Ezra.2.63"}],"t":"ref","v":"Ezr 2:63"},") and Nehemiah’s name (",{"href":"?bref=Neh.8.9","r":"Neh.8.9","rawR":"Neh.8.9","sourceRefs":[{"raw":"Neh.8.9","value":"Neh.8.9"}],"t":"ref","v":"Neh 8:9"},"; ",{"href":"?bref=Neh.10.1","r":"Neh.10.1","rawR":"Neh.10.1","sourceRefs":[{"raw":"Neh.10.1","value":"Neh.10.1"}],"t":"ref","v":"10:1"},"), both of whom held the office in Jerusalem during the postexilic period."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Tirshatha","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ezr 2:63","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.2.63","rawQueryValue":"Ezra.2.63","sourceRefExact":"Ezra.2.63"},{"anchorText":"Neh 8:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.8.9","rawQueryValue":"Neh.8.9","sourceRefExact":"Neh.8.9"},{"anchorText":"10:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.10.1","rawQueryValue":"Neh.10.1","sourceRefExact":"Neh.10.1"}],"sourceItemFragmentSha256":"25415edc8fbfbf667d0112f7f01ce2e89c3fe93563fd63aed285e2f1fe61c976","sourceItemName":"Tirshatha","sourceItemOrder":177,"sourceMember":"Articles/T.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Tirshatha","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Tirshatha*","title":"Tirshatha*","version":"v2-a101d843a2f0cd3fc0c6"}