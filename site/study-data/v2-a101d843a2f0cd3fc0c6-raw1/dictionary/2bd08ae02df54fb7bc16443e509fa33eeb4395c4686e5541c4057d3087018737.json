{"content":[{"c":["KINAH"],"sourceClass":"h1","t":"p"},{"c":["Town in the Negev of Judah (",{"href":"?bref=Josh.15.22","r":"Josh.15.22","rawR":"Josh.15.22","sourceRefs":[{"raw":"Josh.15.22","value":"Josh.15.22"}],"t":"ref","v":"Jos 15:22"},"), perhaps named after the Kenites who lived in the area (",{"href":"?bref=Judg.1.16","r":"Judg.1.16","rawR":"Judg.1.16","sourceRefs":[{"raw":"Judg.1.16","value":"Judg.1.16"}],"t":"ref","v":"Jgs 1:16"},"). According to a letter discovered at Arad, troops were sent from Kinah to reinforce Ramoth-negev against an Edomite attack. The ancient name is preserved in Wadi el-Qeini, in the eastern Negev."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Kinah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Jos 15:22","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.15.22","rawQueryValue":"Josh.15.22","sourceRefExact":"Josh.15.22"},{"anchorText":"Jgs 1:16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Judg.1.16","rawQueryValue":"Judg.1.16","sourceRefExact":"Judg.1.16"}],"sourceItemFragmentSha256":"3d9bb55810f988f2f4affe7a15bef3835c8accc179b4fd884a9601a47b7b8456","sourceItemName":"Kinah","sourceItemOrder":78,"sourceMember":"Articles/K.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Kinah","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Kinah","title":"Kinah","version":"v2-a101d843a2f0cd3fc0c6"}