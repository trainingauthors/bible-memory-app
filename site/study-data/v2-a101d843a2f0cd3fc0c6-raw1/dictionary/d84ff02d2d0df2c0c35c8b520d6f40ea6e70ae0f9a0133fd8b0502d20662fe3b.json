{"content":[{"c":["AMAW*"],"sourceClass":"h1","t":"p"},{"c":["Region near the Euphrates River that included the city of Pethor, to which King Balak of Moab sent messengers in search of the soothsayer Balaam (",{"href":"?bref=Num.22.5","r":"Num.22.5","rawR":"Num.22.5","sourceRefs":[{"raw":"Num.22.5","value":"Num.22.5"}],"t":"ref","v":"Nm 22:5"},"). The name Amaw appears in the Idrimi Inscription (1450 ",{"c":["BC"],"sourceClass":"era","t":"span"},") and on the tomb of Qen-amun, who served under Amenophis II of Egypt in the latter part of the 15th century ",{"c":["BC"],"sourceClass":"era","t":"span"},"."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Amaw","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Nm 22:5","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.22.5","rawQueryValue":"Num.22.5","sourceRefExact":"Num.22.5"}],"sourceItemFragmentSha256":"311f0f9f8dcf2790490d0e148066b4c2163de449ecb0e24eecebf344e2243b54","sourceItemName":"Amaw","sourceItemOrder":286,"sourceMember":"Articles/A.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Amaw","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Amaw*","title":"Amaw*","version":"v2-a101d843a2f0cd3fc0c6"}