{"content":[{"c":["AMMINADAB"],"sourceClass":"h1","t":"p"},{"c":["1. Father of Elisheba, who was Aaron’s wife (",{"href":"?bref=Exod.6.23","r":"Exod.6.23","rawR":"Exod.6.23","sourceRefs":[{"raw":"Exod.6.23","value":"Exod.6.23"}],"t":"ref","v":"Ex 6:23"},"). Amminadab was also the father of Nahshon, Judah’s tribal leader in the wilderness (",{"href":"?bref=Num.1.7","r":"Num.1.7","rawR":"Num.1.7","sourceRefs":[{"raw":"Num.1.7","value":"Num.1.7"}],"t":"ref","v":"Nm 1:7"},"; ",{"href":"?bref=Num.2.3","r":"Num.2.3","rawR":"Num.2.3","sourceRefs":[{"raw":"Num.2.3","value":"Num.2.3"}],"t":"ref","v":"2:3"},"; ",{"href":"?bref=Num.7.12,17","r":"Num.7.12,17","rawR":"Num.7.12,17","sourceRefs":[{"raw":"Num.7.12,17","value":"Num.7.12,17"}],"t":"ref","v":"7:12, 17"},"; ",{"href":"?bref=Num.10.14","r":"Num.10.14","rawR":"Num.10.14","sourceRefs":[{"raw":"Num.10.14","value":"Num.10.14"}],"t":"ref","v":"10:14"},"; ",{"href":"?bref=1Chr.2.10","r":"1Chr.2.10","rawR":"1Chr.2.10","sourceRefs":[{"raw":"1Chr.2.10","value":"1Chr.2.10"}],"t":"ref","v":"1 Chr 2:10"},"). Amminadab is listed in the genealogy of David (",{"href":"?bref=Ruth.4.18-22","r":"Ruth.4.18-22","rawR":"Ruth.4.18-22","sourceRefs":[{"raw":"Ruth.4.18-22","value":"Ruth.4.18-22"}],"t":"ref","v":"Ru 4:18-22"},") and later in the genealogy of Jesus Christ (",{"href":"?bref=Matt.1.4","r":"Matt.1.4","rawR":"Matt.1.4","sourceRefs":[{"raw":"Matt.1.4","value":"Matt.1.4"}],"t":"ref","v":"Mt 1:4"},"; ",{"href":"?bref=Luke.3.33","r":"Luke.3.33","rawR":"Luke.3.33","sourceRefs":[{"raw":"Luke.3.33","value":"Luke.3.33"}],"t":"ref","v":"Lk 3:33"},"). ",{"c":["See"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=GenealogyofJesusChrist_Article_TyndaleOpenBibleDictionary","id":"GenealogyofJesusChrist_Article_TyndaleOpenBibleDictionary","rawId":"GenealogyofJesusChrist_Article_TyndaleOpenBibleDictionary","t":"link","v":"Genealogy of Jesus Christ"},"."],"sourceClass":"list","t":"p"},{"c":["2. Alternate name for Izhar, one of Kohath’s sons (",{"href":"?bref=1Chr.6.22","r":"1Chr.6.22","rawR":"1Chr.6.22","sourceRefs":[{"raw":"1Chr.6.22","value":"1Chr.6.22"}],"t":"ref","v":"1 Chr 6:22"},"). ",{"c":["See"],"sourceClass":"ital","t":"span"}," ",{"href":"?item=Izhar_Article_TyndaleOpenBibleDictionary","id":"Izhar_Article_TyndaleOpenBibleDictionary","rawId":"Izhar_Article_TyndaleOpenBibleDictionary","t":"link","v":"Izhar #1"},"."],"sourceClass":"list","t":"p"},{"c":["3. Levite contemporary of King David who helped bring the ark of the Lord to Jerusalem (",{"href":"?bref=1Chr.15.1-4,10-11","r":"1Chr.15.1-4,10-11","rawR":"1Chr.15.1-4,10-11","sourceRefs":[{"raw":"1Chr.15.1-4,10-11","value":"1Chr.15.1-4,10-11"}],"t":"ref","v":"1 Chr 15:1-4, 10-11"},")."],"sourceClass":"list","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Amminadab","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Ex 6:23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.6.23","rawQueryValue":"Exod.6.23","sourceRefExact":"Exod.6.23"},{"anchorText":"Nm 1:7","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.1.7","rawQueryValue":"Num.1.7","sourceRefExact":"Num.1.7"},{"anchorText":"2:3","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.2.3","rawQueryValue":"Num.2.3","sourceRefExact":"Num.2.3"},{"anchorText":"7:12, 17","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.7.12,17","rawQueryValue":"Num.7.12,17","sourceRefExact":"Num.7.12,17"},{"anchorText":"10:14","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.10.14","rawQueryValue":"Num.10.14","sourceRefExact":"Num.10.14"},{"anchorText":"1 Chr 2:10","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Chr.2.10","rawQueryValue":"1Chr.2.10","sourceRefExact":"1Chr.2.10"},{"anchorText":"Ru 4:18