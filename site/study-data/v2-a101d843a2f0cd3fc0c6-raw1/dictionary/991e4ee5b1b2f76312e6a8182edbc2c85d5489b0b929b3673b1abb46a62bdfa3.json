:"?bref=Gen.16.2-4","rawQueryValue":"Gen.16.2-4","sourceRefExact":"Gen.16.2-4"},{"anchorText":"Ex 21:7-11","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Exod.21.7-11","rawQueryValue":"Exod.21.7-11","sourceRefExact":"Exod.21.7-11"},{"anchorText":"2 Sm 12:31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=2Sam.12.31","rawQueryValue":"2Sam.12.31","sourceRefExact":"2Sam.12.31"},{"anchorText":"1 Kgs 9:15, 21-23","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.9.15,21-23","rawQueryValue":"1Kgs.9.15,21-23","sourceRefExact":"1Kgs.9.15,21-23"},{"anchorText":"1 Kgs 5:13-18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Kgs.5.13-18","rawQueryValue":"1Kgs.5.13-18","sourceRefExact":"1Kgs.5.13-18"},{"anchorText":"Nm 31:28-30, 47","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Num.31.28-30,47","rawQueryValue":"Num.31.28-30,47","sourceRefExact":"Num.31.28-30,47"},{"anchorText":"Jos 9:23-25","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Josh.9.23-25","rawQueryValue":"Josh.9.23-25","sourceRefExact":"Josh.9.23-25"},{"anchorText":"Ezr 2:58","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.2.58","rawQueryValue":"Ezra.2.58","sourceRefExact":"Ezra.2.58"},{"anchorText":"8:20","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Ezra.8.20","rawQueryValue":"Ezra.8.20","sourceRefExact":"Ezra.8.20"},{"anchorText":"Neh 3:26, 31","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Neh.3.26,31","rawQueryValue":"Neh.3.26,31","sourceRefExact":"Neh.3.26,31"},{"anchorText":"Eph 6:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Eph.6.9","rawQueryValue":"Eph.6.9","sourceRefExact":"Eph.6.9"},{"anchorText":"Col 4:1","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Col.4.1","rawQueryValue":"Col.4.1","sourceRefExact":"Col.4.1"},{"anchorText":"1 Tm 6:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=1Tim.6.2","rawQueryValue":"1Tim.6.2","sourceRefExact":"1Tim.6.2"},{"anchorText":"Phlm 1:16","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Phlm.1.16","rawQueryValue":"Phlm.1.16","sourceRefExact":"Phlm.1.16"}],"sourceItemFragmentSha256":"c60b0ea1ebe8a8d5bf51c82f0b1978f90e7509687f272b54e2329f15fde141f1","sourceItemName":"SlaveSlavery","sourceItemOrder":465,"sourceMember":"Articles/S.xml","supplementPointersNotIncludedAsContent":[{"name":"SlaveANameAdoptedByChristianServants","src":"../Textboxes/Textboxes.xml"}]},"sourceAttributes":{"name":"SlaveSlavery","product":"TyndaleOpenBibleDictionary","typename":"Article"},"sourceTitleExact":"Slave, Slavery","title":"Slave, Slavery","version":"v2-a101d843a2f0cd3fc0c6"}