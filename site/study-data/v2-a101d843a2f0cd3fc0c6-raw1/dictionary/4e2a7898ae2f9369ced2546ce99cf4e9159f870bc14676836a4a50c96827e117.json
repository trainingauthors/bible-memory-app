{"content":[{"c":["ZILPAH"],"sourceClass":"h1","t":"p"},{"c":["Mother of Jacob’s sons Gad and Asher. Laban had given her to his daughter Leah as a handmaid (",{"href":"?bref=Gen.29.24","r":"Gen.29.24","rawR":"Gen.29.24","sourceRefs":[{"raw":"Gen.29.24","value":"Gen.29.24"}],"t":"ref","v":"Gn 29:24"},"; ",{"href":"?bref=Gen.46.18","r":"Gen.46.18","rawR":"Gen.46.18","sourceRefs":[{"raw":"Gen.46.18","value":"Gen.46.18"}],"t":"ref","v":"46:18"},"). Later, at Leah’s insistence, she became Jacob’s concubine for the purpose of bearing sons (",{"href":"?bref=Gen.30.9","r":"Gen.30.9","rawR":"Gen.30.9","sourceRefs":[{"raw":"Gen.30.9","value":"Gen.30.9"}],"t":"ref","v":"30:9"},"; ",{"href":"?bref=Gen.37.2","r":"Gen.37.2","rawR":"Gen.37.2","sourceRefs":[{"raw":"Gen.37.2","value":"Gen.37.2"}],"t":"ref","v":"37:2"},")."],"sourceClass":"fl","t":"p"}],"format":"bsb-study-dictionary-v2","id":"Zilpah","provenance":{"archiveSha256":"10758ea00dbea7540f9337e43e59c8e4000295c1261e3426bab6f31c31dcff5b","release":"1.6","sourceCitationReferences":[{"anchorText":"Gn 29:24","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.29.24","rawQueryValue":"Gen.29.24","sourceRefExact":"Gen.29.24"},{"anchorText":"46:18","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.46.18","rawQueryValue":"Gen.46.18","sourceRefExact":"Gen.46.18"},{"anchorText":"30:9","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.30.9","rawQueryValue":"Gen.30.9","sourceRefExact":"Gen.30.9"},{"anchorText":"37:2","canonicalization":"deferred_to_dictionary_mapping_workstream","hrefExact":"?bref=Gen.37.2","rawQueryValue":"Gen.37.2","sourceRefExact":"Gen.37.2"}],"sourceItemFragmentSha256":"71d8b3b9ffc62c81ab2d81fdc9bc858995b555f345b44104d63a31b5761a6a20","sourceItemName":"Zilpah","sourceItemOrder":117,"sourceMember":"Articles/Z.xml","supplementPointersNotIncludedAsContent":[]},"sourceAttributes":{"name":"Zilpah","product":"TyndaleO