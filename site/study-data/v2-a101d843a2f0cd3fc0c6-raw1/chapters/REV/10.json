14","sourceRefs":[{"raw":"Rev.11.14","value":"Rev.11.14"}],"t":"ref","v":"11:14"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Rev.10.1-11.14","refs":[{"book":"REV","endChapter":11,"endVerse":14,"startChapter":10,"startVerse":1}],"sourceAttributes":{"name":"Rev.10.1-11.14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"REV","sourceChapterCoverage":[10,11],"sourceItemFragmentSha256":"23534fd5ae9a6f4237526eec29c7d9a757feff6a716413cb038fe00f61b38fb9","sourceItemName":"Rev.10.1-11.14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16707,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"REV","canonicalOSIS":"Rev","method":"official_book_intro_ref_title","sourceOSIS":"Rev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Rev.10.1-11.14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Rev.10.1-11.14","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Rev.10.1","r":"Rev.10.1","rawR":"Rev.10.1","sourceRefs":[{"raw":"Rev.10.1","value":"Rev.10.1"}],"t":"ref","v":"10:1"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["another mighty angel"],"sourceClass":"sn-excerpt","t":"span"}," (see ",{"href":"?bref=Rev.5.2","r":"Rev.5.2","rawR":"Rev.5.2","sourceRefs":[{"raw":"Rev.5.2","value":"Rev.5.2"}],"t":"ref","v":"5:2"},"; ",{"href":"?bref=Rev.7.2","r":"Rev.7.2","rawR":"Rev.7.2","sourceRefs":[{"raw":"Rev.7.2","value":"Rev.7.2"}],"t":"ref","v":"7:2"},"; cp. ",{"href":"?bref=Rev.1.12-16","r":"Rev.1.12-16","rawR":"Rev.1.12-16","sourceRefs":[{"raw":"Rev.1.12-16","value":"Rev.1.12-16"}],"t":"ref","v":"1:12-16"},"): This angel appears similar to the huge bronze Colossus that stood as a symbol of human power in the harbor of Rhodes for several decades before it was toppled by an earthquake in the late 200s ",{"c":["BC"],"sourceClass":"era","t":"span"},". The statue still lay broken at the time that John wrote Revelation. It was about 100 feet tall and represented the sun god, Helios. The angel was ",{"c":["surrounded by a cloud"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," suggesting that he dwarfed the Rhodes statue and, by implication, all idols. The ",{"c":["rainbow over his head"],"sourceClass":"sn-excerpt","t":"span"}," is a reminder that the enthroned God is encircled by a rainbow (",{"href":"?bref=Rev.4.3","r":"Rev.4.3","rawR":"Rev.4.3","sourceRefs":[{"raw":"Rev.4.3","value":"Rev.4.3"}],"t":"ref","v":"4:3"},"), a biblical symbol of God’s covenant with humanity (",{"href":"?bref=Gen.9.8-17","r":"Gen.9.8-17","rawR":"Gen.9.8-17","sourceRefs":[{"raw":"Gen.9.8-17","value":"Gen.9.8-17"}],"t":"ref","v":"Gen 9:8-17"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Rev.10.1","refs":[{"book":"REV","endChapter":10,"endVerse":1,"startChapter":10,"startVerse":1}],"sourceAttributes":{"name":"Rev.10.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"REV","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"55191ee9fc8816f70add0223f021c50f4202aa64346594160b49d1889456f008","sourceItemName":"Rev.10.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16708,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"REV","canonicalOSIS":"Rev","method":"official_book_intro_ref_title","sourceOSIS":"Rev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Rev.10.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Rev.10.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Rev.10.2-3","r":"Rev.10.2-3","rawR":"Rev.10.2-3","sourceRefs":[{"raw":"Rev.10.2-3","value":"Rev.10.2-3"}],"t":"ref","v":"10:2-3"}],"sourceClass":"sn-ref","t":"span"}," Although the ",{"c":["scroll"],"sourceClass":"sn-excerpt","t":"span"}," is ",{"c":["small"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," it is not unimportant. It reveals a small yet critical part of God’s purposes in events still to come before eternity begins. • ",{"c":["he gave a great shout:"],"sourceClass":"sn-excerpt","t":"span"}," Cp. ",{"href":"?bref=Job.37.2-5","r":"Job.37.2-5","rawR":"Job.37.2-5","sourceRefs":[{"raw":"Job.37.2-5","value":"Job.37.2-5"}],"t":"ref","v":"Job 37:2-5"},"; ",{"href":"?bref=Ps.18.13","r":"Ps.18.13","rawR":"Ps.18.13","sourceRefs":[{"raw":"Ps.18.13","value":"Ps.18.13"}],"t":"ref","v":"Ps 18:13"},"; ",{"href":"?bref=Ps.29.3-4","r":"Ps.29.3-4","rawR":"Ps.29.3-4","sourceRefs":[{"raw":"Ps.29.3-4","value":"Ps.29.3-4"}],"t":"ref","v":"29:3-4"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Rev.10.2-3","refs":[{"book":"REV","endChapter":10,"endVerse":3,"startChapter":10,"startVerse":2}],"sourceAttributes":{"name":"Rev.10.2-3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"REV","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"fcccd3cceb784367cb370467abc8baa10630d9418f2afba89efcdf0a382347dd","sourceItemName":"Rev.10.2-3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16709,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"REV","canonicalOSIS":"Rev","method":"official_book_intro_ref_title","sourceOSIS":"Rev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Rev.10.2-3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Rev.10.2-3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Rev.10.4","r":"Rev.10.4","rawR":"Rev.10.4","sourceRefs":[{"raw":"Rev.10.4","value":"Rev.10.4"}],"t":"ref","v":"10:4"}],"sourceClass":"sn-ref","t":"span"}," Revelation reveals God’s intentions in the world without eliminating the mystery of God’s ways. The martyrs did not receive an immediate answer to their cries (",{"href":"?bref=Rev.6.10","r":"Rev.6.10","rawR":"Rev.6.10","sourceRefs":[{"raw":"Rev.6.10","value":"Rev.6.10"}],"t":"ref","v":"6:10"},"), the meaning of the seventh seal is cloaked in silence (",{"href":"?bref=Rev.8.1","r":"Rev.8.1","rawR":"Rev.8.1","sourceRefs":[{"raw":"Rev.8.1","value":"Rev.8.1"}],"t":"ref","v":"8:1"},"), and here ",{"c":["the seven thunders"],"sourceClass":"sn-excerpt","t":"span"}," are kept ",{"c":["secret"],"sourceClass":"sn-excerpt","t":"span"}," (cp. ",{"href":"?bref=Dan.12.9","r":"Dan.12.9","rawR":"Dan.12.9","sourceRefs":[{"raw":"Dan.12.9","value":"Dan.12.9"}],"t":"ref","v":"Dan 12:9"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Rev.10.4","refs":[{"book":"REV","endChapter":10,"endVerse":4,"startChapter":10,"startVerse":4}],"sourceAttributes":{"name":"Rev.10.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"REV","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"2a23f2f38a456e6dc2e8c1ea83b00e8f7a462f8441656389f5e83f5f82dc161d","sourceItemName":"Rev.10.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16710,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"REV","canonicalOSIS":"Rev","method":"official_book_intro_ref_title","sourceOSIS":"Rev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Rev.10.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Rev.10.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Rev.10.5-6","r":"Rev.10.5-6","rawR":"Rev.10.5-6","sourceRefs":[{"raw":"Rev.10.5-6","value":"Rev.10.5-6"}],"t":"ref","v":"10:5-6"}],"sourceClass":"sn-ref","t":"span"}," While raising one’s ",{"c":["right hand"],"sourceClass":"sn-excerpt","t":"span"}," is common in taking ",{"c":["an oath"],"sourceClass":"sn-excerpt","t":"span"}," today, it is rare in biblical literature (cp. ",{"href":"?bref=Gen.14.22","r":"Gen.14.22","rawR":"Gen.14.22","sourceRefs":[{"raw":"Gen.14.22","value":"Gen.14.22"}],"t":"ref","v":"Gen 14:22"},"; ",{"href":"?bref=Gen.24.9","r":"Gen.24.9","rawR":"Gen.24.9","sourceRefs":[{"raw":"Gen.24.9","value":"Gen.24.9"}],"t":"ref","v":"24:9"},"; ",{"href":"?bref=Dan.12.7","r":"Dan.12.7","rawR":"Dan.12.7","sourceRefs":[{"raw":"Dan.12.7","value":"Dan.12.7"}],"t":"ref","v":"Dan 12:7"},"). • When making an oath, Jews were very careful not to swear lightly by God’s ",{"c":["name"],"sourceClass":"sn-excerpt","t":"span"}," (see ",{"href":"?bref=Exod.20.7","r":"Exod.20.7","rawR":"Exod.20.7","sourceRefs":[{"raw":"Exod.20.7","value":"Exod.20.7"}],"t":"ref","v":"Exod 20:7"},"). Jesus also rebuked insincere oath-taking (see ",{"href":"?bref=Matt.5.33-37","r":"Matt.5.33-37","rawR":"Matt.5.33-37","sourceRefs":[{"raw":"Matt.5.33-37","value":"Matt.5.33-37"}],"t":"ref","v":"Matt 5:33-37"},"; ",{"href":"?bref=Matt.23.16-22","r":"Matt.23.16-22","rawR":"Matt.23.16-22","sourceRefs":[{"raw":"Matt.23.16-22","value":"Matt.23.16-22"}],"t":"ref","v":"23:16-22"},"). When God swore an oath, he did so in his own name as the highest possible point of reference (see ",{"href":"?bref=Gen.22.16","r":"Gen.22.16","rawR":"Gen.22.16","sourceRefs":[{"raw":"Gen.22.16","value":"Gen.22.16"}],"t":"ref","v":"Gen 22:16"},"; ",{"href":"?bref=Ps.89.35-36","r":"Ps.89.35-36","rawR":"Ps.89.35-36","sourceRefs":[{"raw":"Ps.89.35-36","value":"Ps.89.35-36"}],"t":"ref","v":"Ps 89:35-36"},"; ",{"href":"?bref=Jer.22.5","r":"Jer.22.5","rawR":"Jer.22.5","sourceRefs":[{"raw":"Jer.22.5","value":"Jer.22.5"}],"t":"ref","v":"Jer 22:5"},"; ",{"href":"?bref=Heb.6.13-18","r":"Heb.6.13-18","rawR":"Heb.6.13-18","sourceRefs":[{"raw":"Heb.6.13-18","value":"Heb.6.13-18"}],"t":"ref","v":"Heb 6:13-18"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Rev.10.5-6","refs":[{"book":"REV","endChapter":10,"endVerse":6,"startChapter":10,"startVerse":5}],"sourceAttributes":{"name":"Rev.10.5-6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"REV","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"fa6481d1000c0582d49d0bf3deffe4c391de6bf56b549367eff5c0e6e4ea366a","sourceItemName":"Rev.10.5-6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16711,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"REV","canonicalOSIS":"Rev","method":"official_book_intro_ref_title","sourceOSIS":"Rev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Rev.10.5-6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Rev.10.5-6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Rev.10.7","r":"Rev.10.7","rawR":"Rev.10.7","sourceRefs":[{"raw":"Rev.10.7","value":"Rev.10.7"}],"t":"ref","v":"10:7"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["angel blows his trumpet:"],"sourceClass":"sn-excerpt","t":"span"}," See ",{"href":"?bref=1Cor.15.51-54","r":"1Cor.15.51-54","rawR":"1Cor.15.51-54","sourceRefs":[{"raw":"1Cor.15.51-54","value":"1Cor.15.51-54"}],"t":"ref","v":"1 Cor 15:51-54"},"; ",{"href":"?bref=1Thes.4.16","r":"1Thes.4.16","rawR":"1Thes.4.16","sourceRefs":[{"raw":"1Thes.4.16","value":"1Thes.4.16"}],"t":"ref","v":"1 Thes 4:16"},". • ",{"c":["God’s mysterious plan"],"sourceClass":"sn-excerpt","t":"span"}," for the world is no surprise; ",{"c":["the prophets"],"sourceClass":"sn-excerpt","t":"span"}," who served God in the past warned that the day of the Lord would come (see ",{"href":"?bref=Joel.2.1-3","r":"Joel.2.1-3","rawR":"Joel.2.1-3","sourceRefs":[{"raw":"Joel.2.1-3","value":"Joel.2.1-3"}],"t":"ref","v":"Joel 2:1-3"},", ",{"href":"?bref=Joel.2.10-11","r":"Joel.2.10-11","rawR":"Joel.2.10-11","sourceRefs":[{"raw":"Joel.2.10-11","value":"Joel.2.10-11"}],"t":"ref","v":"10-11"},"; ",{"href":"?bref=Amos.5.18-20","r":"Amos.5.18-20","rawR":"Amos.5.18-20","sourceRefs":[{"raw":"Amos.5.18-20","value":"Amos.5.18-20"}],"t":"ref","v":"Amos 5:18-20"},"; ",{"href":"?bref=Zeph.1.14-18","r":"Zeph.1.14-18","rawR":"Zeph.1.14-18","sourceRefs":[{"raw":"Zeph.1.14-18","value":"Zeph.1.14-18"}],"t":"ref","v":"Zeph 1:14-18"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Rev.10.7","refs":[{"book":"REV","endChapter":10,"endVerse":7,"startChapter":10,"startVerse":7}],"sourceAttributes":{"name":"Rev.10.7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"REV","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"71a0777b33f87ac06e474bd7faa6f078ccb6dff122b103fc59f52fbcf4ed4e65","sourceItemName":"Rev.10.7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16712,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"REV","canonicalOSIS":"Rev","method":"official_book_intro_ref_title","sourceOSIS":"Rev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Rev.10.7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Rev.10.7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Rev.10.8-10","r":"Rev.10.8-10","rawR":"Rev.10.8-10","sourceRefs":[{"raw":"Rev.10.8-10","value":"Rev.10.8-10"}],"t":"ref","v":"10:8-10"}],"sourceClass":"sn-ref","t":"span"}," As in Ezekiel’s experience, the ",{"c":["scroll"],"sourceClass":"sn-excerpt","t":"span"}," tasted ",{"c":["sweet"],"sourceClass":"sn-excerpt","t":"span"}," in the ",{"c":["mouth"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=Ezek.3.1-3","r":"Ezek.3.1-3","rawR":"Ezek.3.1-3","sourceRefs":[{"raw":"Ezek.3.1-3","value":"Ezek.3.1-3"}],"t":"ref","v":"Ezek 3:1-3"},"; see ",{"href":"?bref=Jer.15.16","r":"Jer.15.16","rawR":"Jer.15.16","sourceRefs":[{"raw":"Jer.15.16","value":"Jer.15.16"}],"t":"ref","v":"Jer 15:16"},"; see also ",{"href":"?bref=Ps.19.10","r":"Ps.19.10","rawR":"Ps.19.10","sourceRefs":[{"raw":"Ps.19.10","value":"Ps.19.10"}],"t":"ref","v":"Pss 19:10"},"; ",{"href":"?bref=Ps.119.103","r":"Ps.119.103","rawR":"Ps.119.103","sourceRefs":[{"raw":"Ps.119.103","value":"Ps.119.103"}],"t":"ref","v":"119:103"},"). The experiences yet to come for God’s people would be sweet, including the victory of God’s plan and the vindication of his people. John’s ",{"c":["sour"],"sourceClass":"sn-excerpt","t":"span"}," ",{"c":[". . ."],"sourceClass":"ital","t":"span"},{"c":[" stomach"],"sourceClass":"sn-excerpt","t":"span"}," resembles the effects of Ezekiel’s hard message for Israel (",{"href":"?bref=Ezek.3.8-9","r":"Ezek.3.8-9","rawR":"Ezek.3.8-9","sourceRefs":[{"raw":"Ezek.3.8-9","value":"Ezek.3.8-9"}],"t":"ref","v":"Ezek 3:8-9"},"). The process of bringing God’s plan to fruition involves hardship."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Rev.10.8-10","refs":[{"book":"REV","endChapter":10,"endVerse":10,"startChapter":10,"startVerse":8}],"sourceAttributes":{"name":"Rev.10.8-10","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"REV","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"d26a549b8c5f9b2475e1e554e835e760640ea1340f639bdebf8ad285cb27d9ae","sourceItemName":"Rev.10.8-10","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16713,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"REV","canonicalOSIS":"Rev","method":"official_book_intro_ref_title","sourceOSIS":"Rev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Rev.10.8-10","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Rev.10.8-10","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Rev.10.11","r":"Rev.10.11","rawR":"Rev.10.11","sourceRefs":[{"raw":"Rev.10.11","value":"Rev.10.11"}],"t":"ref","v":"10:11"}],"sourceClass":"sn-ref","t":"span"}," Unlike Ezekiel, who prophesied for Israel alone, John ",{"c":["must prophesy"],"sourceClass":"sn-excerpt","t":"span"}," ",{"c":[". . ."],"sourceClass":"ital","t":"span"},{"c":[" about"],"sourceClass":"sn-excerpt","t":"span"}," (or ",{"c":["against"],"sourceClass":"ital","t":"span"},") all the people of the world. There is debate whether “about” or “against” is the best translation; “about” allows for both promise and judgment (see both in ",{"href":"?bref=Rev.21.24-27","r":"Rev.21.24-27","rawR":"Rev.21.24-27","sourceRefs":[{"raw":"Rev.21.24-27","value":"Rev.21.24-27"}],"t":"ref","v":"21:24-27"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Rev.10.11","refs":[{"book":"REV","endChapter":10,"endVerse":11,"startChapter":10,"startVerse":11}],"sourceAttributes":{"name":"Rev.10.11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"REV","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"14c52767e160f2980c07c3e976a69ad1405ecb8affdfd9673a20864d4db4db1a","sourceItemName":"Rev.10.11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16714,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"REV","canonicalOSIS":"Rev","method":"official_book_intro_ref_title","sourceOSIS":"Rev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Rev.10.11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Rev.10.11","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}