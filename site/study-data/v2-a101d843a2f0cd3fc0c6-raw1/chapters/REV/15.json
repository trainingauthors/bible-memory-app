id":"Rev.6.1-16.21_StudyNote_Filament","rawId":"Rev.6.1-16.21_StudyNote_Filament","t":"link","v":"study note on 6:1–16:21"},") is introduced with a vision of God’s victorious people singing a hymn of praise (",{"href":"?bref=Rev.15.2-4","r":"Rev.15.2-4","rawR":"Rev.15.2-4","sourceRefs":[{"raw":"Rev.15.2-4","value":"Rev.15.2-4"}],"t":"ref","v":"15:2-4"},"). Then a scene of the Temple is presented (",{"href":"?bref=Rev.15.5-8","r":"Rev.15.5-8","rawR":"Rev.15.5-8","sourceRefs":[{"raw":"Rev.15.5-8","value":"Rev.15.5-8"}],"t":"ref","v":"15:5-8"},"), from which angels emerge bearing the bowls of God’s judgment upon the earth (",{"href":"?bref=Rev.16.1-21","r":"Rev.16.1-21","rawR":"Rev.16.1-21","sourceRefs":[{"raw":"Rev.16.1-21","value":"Rev.16.1-21"}],"t":"ref","v":"16:1-21"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Rev.15.1-16.21","refs":[{"book":"REV","endChapter":15,"endVerse":8,"startChapter":15,"startVerse":1}],"sourceAttributes":{"name":"Rev.15.1-16.21","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"REV","sourceChapterCoverage":[15],"sourceItemFragmentSha256":"29bfb6fc00ba44d7180c65435c5cb2dcdcf5d38ae248d8111b7c7a44b070726d","sourceItemName":"Rev.15.1-16.21","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16782,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"REV","canonicalOSIS":"Rev","method":"official_book_intro_ref_title","sourceOSIS":"Rev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Rev.15.1-8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Rev.15.1-16.21","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Rev.15.1","r":"Rev.15.1","rawR":"Rev.15.1","sourceRefs":[{"raw":"Rev.15.1","value":"Rev.15.1"}],"t":"ref","v":"15:1"}],"sourceClass":"sn-ref","t":"span"}," This cycle of ",{"c":["seven last plagues"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=Rev.15.1-16.21","r":"Rev.15.1-16.21","rawR":"Rev.15.1-16.21","sourceRefs":[{"raw":"Rev.15.1-16.21","value":"Rev.15.1-16.21"}],"t":"ref","v":"15:1–16:21"},") brings ",{"c":["God’s wrath"],"sourceClass":"sn-excerpt","t":"span"}," against his enemies ",{"c":["to completion"],"sourceClass":"sn-excerpt","t":"span"}," (see ",{"href":"?bref=Rev.16.17","r":"Rev.16.17","rawR":"Rev.16.17","sourceRefs":[{"raw":"Rev.16.17","value":"Rev.16.17"}],"t":"ref","v":"16:17"},"; ",{"href":"?bref=Amos.1.1-2.16","r":"Amos.1.1-2.16","rawR":"Amos.1.1-2.16","sourceRefs":[{"raw":"Amos.1.1-2.16","value":"Amos.1.1-2.16"}],"t":"ref","v":"Amos 1–2"},"; ",{"href":"?bref=Rom.1.18-2.16","r":"Rom.1.18-2.16","rawR":"Rom.1.18-2.16","sourceRefs":[{"raw":"Rom.1.18-2.16","value":"Rom.1.18-2.16"}],"t":"ref","v":"Rom 1:18–2:16"},"). Revelation returns later to the subjects of God’s wrath (",{"href":"?bref=Rev.19.15-21","r":"Rev.19.15-21","rawR":"Rev.19.15-21","sourceRefs":[{"raw":"Rev.19.15-21","value":"Rev.19.15-21"}],"t":"ref","v":"Rev 19:15-21"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Rev.15.1","refs":[{"book":"REV","endChapter":15,"endVerse":1,"startChapter":15,"startVerse":1}],"sourceAttributes":{"name":"Rev.15.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"REV","sourceChapterCoverage":[15],"sourceItemFragmentSha256":"6fd346f56d13e89b6175b4cdee531ceb25e6438882f2fdbe91416453930e4447","sourceItemName":"Rev.15.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16783,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"REV","canonicalOSIS":"Rev","method":"official_book_intro_ref_title","sourceOSIS":"Rev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Rev.15.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Rev.15.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Rev.15.2","r":"Rev.15.2","rawR":"Rev.15.2","sourceRefs":[{"raw":"Rev.15.2","value":"Rev.15.2"}],"t":"ref","v":"15:2"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["glass sea mixed with fire"],"sourceClass":"sn-excerpt","t":"span"}," symbolizes victory through testing. Those ",{"c":["who had been victorious over the beast"],"sourceClass":"sn-excerpt","t":"span"}," (see ",{"href":"?bref=Rev.13.1-8","r":"Rev.13.1-8","rawR":"Rev.13.1-8","sourceRefs":[{"raw":"Rev.13.1-8","value":"Rev.13.1-8"}],"t":"ref","v":"13:1-8"},", ",{"href":"?bref=Rev.13.15-18","r":"Rev.13.15-18","rawR":"Rev.13.15-18","sourceRefs":[{"raw":"Rev.13.15-18","value":"Rev.13.15-18"}],"t":"ref","v":"15-18"},") hold ",{"c":["harps"],"sourceClass":"sn-excerpt","t":"span"}," that represent ultimate peace. Their place ",{"c":["on"],"sourceClass":"sn-excerpt","t":"span"}," the ",{"c":["glass sea"],"sourceClass":"ital","t":"span"}," (cp. ",{"href":"?bref=Rev.4.6","r":"Rev.4.6","rawR":"Rev.4.6","sourceRefs":[{"raw":"Rev.4.6","value":"Rev.4.6"}],"t":"ref","v":"4:6"},") symbolizes their endurance in the ",{"c":["fire"],"sourceClass":"ital","t":"span"}," of persecution (cp. ",{"href":"?bref=Ps.66.12","r":"Ps.66.12","rawR":"Ps.66.12","sourceRefs":[{"raw":"Ps.66.12","value":"Ps.66.12"}],"t":"ref","v":"Ps 66:12"},"; ",{"href":"?bref=Isa.43.2","r":"Isa.43.2","rawR":"Isa.43.2","sourceRefs":[{"raw":"Isa.43.2","value":"Isa.43.2"}],"t":"ref","v":"Isa 43:2"},"; ",{"href":"?bref=Dan.3.8-30","r":"Dan.3.8-30","rawR":"Dan.3.8-30","sourceRefs":[{"raw":"Dan.3.8-30","value":"Dan.3.8-30"}],"t":"ref","v":"Dan 3:8-30"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Rev.15.2","refs":[{"book":"REV","endChapter":15,"endVerse":2,"startChapter":15,"startVerse":2}],"sourceAttributes":{"name":"Rev.15.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"REV","sourceChapterCoverage":[15],"sourceItemFragmentSha256":"0d34029e3817b2394886c8d51b8f39c75e38638de5e9fa2db6c1367e73943f3b","sourceItemName":"Rev.15.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16784,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"REV","canonicalOSIS":"Rev","method":"official_book_intro_ref_title","sourceOSIS":"Rev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Rev.15.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Rev.15.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Rev.15.3-4","r":"Rev.15.3-4","rawR":"Rev.15.3-4","sourceRefs":[{"raw":"Rev.15.3-4","value":"Rev.15.3-4"}],"t":"ref","v":"15:3-4"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["song of Moses"],"sourceClass":"sn-excerpt","t":"span"}," and ",{"c":["the Lamb"],"sourceClass":"sn-excerpt","t":"span"}," signifies that God’s will is united in the old and new covenants."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Rev.15.3-4","refs":[{"book":"REV","endChapter":15,"endVerse":4,"startChapter":15,"startVerse":3}],"sourceAttributes":{"name":"Rev.15.3-4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"REV","sourceChapterCoverage":[15],"sourceItemFragmentSha256":"a1ed3d350485b0d610ff55644c25b53599a8fa8d7bd6820fcc542c886fe87f0b","sourceItemName":"Rev.15.3-4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16785,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"REV","canonicalOSIS":"Rev","method":"official_book_intro_ref_title","sourceOSIS":"Rev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Rev.15.3-4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Rev.15.3-4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Rev.15.3","r":"Rev.15.3","rawR":"Rev.15.3","sourceRefs":[{"raw":"Rev.15.3","value":"Rev.15.3"}],"t":"ref","v":"15:3"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["Lord God, the"],"sourceClass":"sn-excerpt","t":"span"}," ",{"c":["Almighty"],"sourceClass":"sn-excerpt","t":"span"}," (see also ",{"href":"?bref=Rev.1.8","r":"Rev.1.8","rawR":"Rev.1.8","sourceRefs":[{"raw":"Rev.1.8","value":"Rev.1.8"}],"t":"ref","v":"1:8"},"; ",{"href":"?bref=Rev.4.8","r":"Rev.4.8","rawR":"Rev.4.8","sourceRefs":[{"raw":"Rev.4.8","value":"Rev.4.8"}],"t":"ref","v":"4:8"},"; ",{"href":"?bref=Rev.11.17","r":"Rev.11.17","rawR":"Rev.11.17","sourceRefs":[{"raw":"Rev.11.17","value":"Rev.11.17"}],"t":"ref","v":"11:17"},"; ",{"href":"?bref=Rev.16.7","r":"Rev.16.7","rawR":"Rev.16.7","sourceRefs":[{"raw":"Rev.16.7","value":"Rev.16.7"}],"t":"ref","v":"16:7"},"; ",{"href":"?bref=Rev.19.6","r":"Rev.19.6","rawR":"Rev.19.6","sourceRefs":[{"raw":"Rev.19.6","value":"Rev.19.6"}],"t":"ref","v":"19:6"},"; ",{"href":"?bref=Rev.21.22","r":"Rev.21.22","rawR":"Rev.21.22","sourceRefs":[{"raw":"Rev.21.22","value":"Rev.21.22"}],"t":"ref","v":"21:22"},"): For persecuted Christians, the message that God is all-powerful provides great comfort and security. • The truth that God is also ",{"c":["just and true"],"sourceClass":"sn-excerpt","t":"span"}," is the foundation of human integrity in the midst of a confused, unjust, and dishonest world. • God is the supreme, universal ",{"c":["King of the nations"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," not a localized deity attached to one nation or to a human monarch with limited authority."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Rev.15.3","refs":[{"book":"REV","endChapter":15,"endVerse":3,"startChapter":15,"startVerse":3}],"sourceAttributes":{"name":"Rev.15.3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"REV","sourceChapterCoverage":[15],"sourceItemFragmentSha256":"fca43160599fa5db68e44af102bb9be338192f9ed88603c043bc9d48bd8ff79e","sourceItemName":"Rev.15.3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16786,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"REV","canonicalOSIS":"Rev","method":"official_book_intro_ref_title","sourceOSIS":"Rev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Rev.15.3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Rev.15.3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Rev.15.4","r":"Rev.15.4","rawR":"Rev.15.4","sourceRefs":[{"raw":"Rev.15.4","value":"Rev.15.4"}],"t":"ref","v":"15:4"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Who will not fear"],"sourceClass":"sn-excerpt","t":"span"}," . . . ",{"c":["and glorify your name?"],"sourceClass":"sn-excerpt","t":"span"}," This rhetorical question (cp. ",{"href":"?bref=Jer.10.7","r":"Jer.10.7","rawR":"Jer.10.7","sourceRefs":[{"raw":"Jer.10.7","value":"Jer.10.7"}],"t":"ref","v":"Jer 10:7"},") assumes that only a fool would fail to do so (cp. ",{"href":"?bref=Rev.14.7","r":"Rev.14.7","rawR":"Rev.14.7","sourceRefs":[{"raw":"Rev.14.7","value":"Rev.14.7"}],"t":"ref","v":"Rev 14:7"},"; ",{"href":"?bref=Rev.16.9","r":"Rev.16.9","rawR":"Rev.16.9","sourceRefs":[{"raw":"Rev.16.9","value":"Rev.16.9"}],"t":"ref","v":"16:9"},"; see ",{"href":"?bref=Ps.14.1","r":"Ps.14.1","rawR":"Ps.14.1","sourceRefs":[{"raw":"Ps.14.1","value":"Ps.14.1"}],"t":"ref","v":"Pss 14:1"},"; ",{"href":"?bref=Ps.53.1","r":"Ps.53.1","rawR":"Ps.53.1","sourceRefs":[{"raw":"Ps.53.1","value":"Ps.53.1"}],"t":"ref","v":"53:1"},"). • God ",{"c":["alone"],"sourceClass":"sn-excerpt","t":"span"}," is ",{"c":["holy:"],"sourceClass":"sn-excerpt","t":"span"}," See ",{"href":"?bref=Rev.16.5","r":"Rev.16.5","rawR":"Rev.16.5","sourceRefs":[{"raw":"Rev.16.5","value":"Rev.16.5"}],"t":"ref","v":"Rev 16:5"},"; ",{"href":"?bref=Lev.11.44","r":"Lev.11.44","rawR":"Lev.11.44","sourceRefs":[{"raw":"Lev.11.44","value":"Lev.11.44"}],"t":"ref","v":"Lev 11:44"},"; ",{"href":"?bref=1Pet.1.16","r":"1Pet.1.16","rawR":"1Pet.1.16","sourceRefs":[{"raw":"1Pet.1.16","value":"1Pet.1.16"}],"t":"ref","v":"1 Pet 1:16"},". God’s holiness is the basis for our worship and salvation. • ",{"c":["All nations will . . . worship:"],"sourceClass":"sn-excerpt","t":"span"}," Some will be forced to acknowledge God (cp. ",{"href":"?bref=Phil.2.10-11","r":"Phil.2.10-11","rawR":"Phil.2.10-11","sourceRefs":[{"raw":"Phil.2.10-11","value":"Phil.2.10-11"}],"t":"ref","v":"Phil 2:10-11"},"), but all will recognize that God’s ",{"c":["deeds"],"sourceClass":"sn-excerpt","t":"span"}," and judgments ",{"c":["have been revealed"],"sourceClass":"sn-excerpt","t":"span"}," and are ",{"c":["righteous"],"sourceClass":"sn-excerpt","t":"span"}," and just."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Rev.15.4","refs":[{"book":"REV","endChapter":15,"endVerse":4,"startChapter":15,"startVerse":4}],"sourceAttributes":{"name":"Rev.15.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"REV","sourceChapterCoverage":[15],"sourceItemFragmentSha256":"678b8556cb1ba9f58f310d50461d079339d80c9e7509400d38602f7d40da9026","sourceItemName":"Rev.15.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16787,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"REV","canonicalOSIS":"Rev","method":"official_book_intro_ref_title","sourceOSIS":"Rev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Rev.15.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Rev.15.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Rev.15.5-6","r":"Rev.15.5-6","rawR":"Rev.15.5-6","sourceRefs":[{"raw":"Rev.15.5-6","value":"Rev.15.5-6"}],"t":"ref","v":"15:5-6"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["God’s Tabernacle"],"sourceClass":"sn-excerpt","t":"span"}," implies God’s presence (see ",{"href":"?bref=John.1.14","r":"John.1.14","rawR":"John.1.14","sourceRefs":[{"raw":"John.1.14","value":"John.1.14"}],"t":"ref","v":"John 1:14"},"); even the plagues have their source in God’s presence. Christ’s sacrifice (",{"href":"?bref=Matt.27.51","r":"Matt.27.51","rawR":"Matt.27.51","sourceRefs":[{"raw":"Matt.27.51","value":"Matt.27.51"}],"t":"ref","v":"Matt 27:51"},"; ",{"href":"?bref=Mark.15.38","r":"Mark.15.38","rawR":"Mark.15.38","sourceRefs":[{"raw":"Mark.15.38","value":"Mark.15.38"}],"t":"ref","v":"Mark 15:38"},"; ",{"href":"?bref=Heb.6.19-20","r":"Heb.6.19-20","rawR":"Heb.6.19-20","sourceRefs":[{"raw":"Heb.6.19-20","value":"Heb.6.19-20"}],"t":"ref","v":"Heb 6:19-20"},"; ",{"href":"?bref=Heb.10.19-20","r":"Heb.10.19-20","rawR":"Heb.10.19-20","sourceRefs":[{"raw":"Heb.10.19-20","value":"Heb.10.19-20"}],"t":"ref","v":"10:19-20"},") removed the veil between God and humanity (see ",{"href":"?bref=Exod.26.31-35","r":"Exod.26.31-35","rawR":"Exod.26.31-35","sourceRefs":[{"raw":"Exod.26.31-35","value":"Exod.26.31-35"}],"t":"ref","v":"Exod 26:31-35"},"; ",{"href":"?bref=Lev.16.1-34","r":"Lev.16.1-34","rawR":"Lev.16.1-34","sourceRefs":[{"raw":"Lev.16.1-34","value":"Lev.16.1-34"}],"t":"ref","v":"Lev 16"},"). Now those who do not belong to Christ experience the full force of God’s presence (see ",{"href":"?bref=Rev.20.11-15","r":"Rev.20.11-15","rawR":"Rev.20.11-15","sourceRefs":[{"raw":"Rev.20.11-15","value":"Rev.20.11-15"}],"t":"ref","v":"Rev 20:11-15"},"; ",{"href":"?bref=Isa.13.4-12","r":"Isa.13.4-12","rawR":"Isa.13.4-12","sourceRefs":[{"raw":"Isa.13.4-12","value":"Isa.13.4-12"}],"t":"ref","v":"Isa 13:4-12"},"; ",{"href":"?bref=Zeph.2.1-3","r":"Zeph.2.1-3","rawR":"Zeph.2.1-3","sourceRefs":[{"raw":"Zeph.2.1-3","value":"Zeph.2.1-3"}],"t":"ref","v":"Zeph 2:1-3"},"; ",{"href":"?bref=Mal.3.2-3","r":"Mal.3.2-3","rawR":"Mal.3.2-3","sourceRefs":[{"raw":"Mal.3.2-3","value":"Mal.3.2-3"}],"t":"ref","v":"Mal 3:2-3"},"). • ",{"c":["white linen:"],"sourceClass":"sn-excerpt","t":"span"}," Linen, a symbol of purity, was also worn by the priests when performing their duties (see ",{"href":"?bref=Exod.28.39-43","r":"Exod.28.39-43","rawR":"Exod.28.39-43","sourceRefs":[{"raw":"Exod.28.39-43","value":"Exod.28.39-43"}],"t":"ref","v":"Exod 28:39-43"},"; ",{"href":"?bref=Lev.16.4","r":"Lev.16.4","rawR":"Lev.16.4","sourceRefs":[{"raw":"Lev.16.4","value":"Lev.16.4"}],"t":"ref","v":"Lev 16:4"},", ",{"href":"?bref=Lev.16.23","r":"Lev.16.23","rawR":"Lev.16.23","sourceRefs":[{"raw":"Lev.16.23","value":"Lev.16.23"}],"t":"ref","v":"23"},"; see also ",{"href":"?bref=Ezek.9.2-3","r":"Ezek.9.2-3","rawR":"Ezek.9.2-3","sourceRefs":[{"raw":"Ezek.9.2-3","value":"Ezek.9.2-3"}],"t":"ref","v":"Ezek 9:2-3"},"; ",{"href":"?bref=Dan.12.6-7","r":"Dan.12.6-7","rawR":"Dan.12.6-7","sourceRefs":[{"raw":"Dan.12.6-7","value":"Dan.12.6-7"}],"t":"ref","v":"Dan 12:6-7"},"). The function of these angels is not intercession; they are agents of judgment. The linen therefore represents the purity and justice of God’s judgment. • The ",{"c":["gold sashes across their chests"],"sourceClass":"sn-excerpt","t":"span"}," probably symbolize their divine mission as ministers of justice on God’s behalf (cp. ",{"href":"?bref=Rev.1.13","r":"Rev.1.13","rawR":"Rev.1.13","sourceRefs":[{"raw":"Rev.1.13","value":"Rev.1.13"}],"t":"ref","v":"Rev 1:13"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Rev.15.5-6","refs":[{"book":"REV","endChapter":15,"endVerse":6,"startChapter":15,"startVerse":5}],"sourceAttributes":{"name":"Rev.15.5-6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"REV","sourceChapterCoverage":[15],"sourceItemFragmentSha256":"21b1189ef14b8a39b5280051b8d529056dd619570ed402db3ac02de17ca72ffb","sourceItemName":"Rev.15.5-6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16788,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"REV","canonicalOSIS":"Rev","method":"official_book_intro_ref_title","sourceOSIS":"Rev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Rev.15.5-6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Rev.15.5-6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Rev.15.7","r":"Rev.15.7","rawR":"Rev.15.7","sourceRefs":[{"raw":"Rev.15.7","value":"Rev.15.7"}],"t":"ref","v":"15:7"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["the four living beings:"],"sourceClass":"sn-excerpt","t":"span"}," See ",{"href":"?bref=Rev.4.6-8","r":"Rev.4.6-8","rawR":"Rev.4.6-8","sourceRefs":[{"raw":"Rev.4.6-8","value":"Rev.4.6-8"}],"t":"ref","v":"4:6-8"},". • ",{"c":["a gold bowl:"],"sourceClass":"sn-excerpt","t":"span"}," These bowls are probably like the offering pans that were used in ancient worship (see ",{"href":"?bref=Exod.37.16","r":"Exod.37.16","rawR":"Exod.37.16","sourceRefs":[{"raw":"Exod.37.16","value":"Exod.37.16"}],"t":"ref","v":"Exod 37:16"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Rev.15.7","refs":[{"book":"REV","endChapter":15,"endVerse":7,"startChapter":15,"startVerse":7}],"sourceAttributes":{"name":"Rev.15.7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"REV","sourceChapterCoverage":[15],"sourceItemFragmentSha256":"028979c71b2e76e2bb82ea70b59a30741966f3f2978f72f2212c100cf78a8ff6","sourceItemName":"Rev.15.7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16789,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"REV","canonicalOSIS":"Rev","method":"official_book_intro_ref_title","sourceOSIS":"Rev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Rev.15.7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Rev.15.7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Rev.15.8","r":"Rev.15.8","rawR":"Rev.15.8","sourceRefs":[{"raw":"Rev.15.8","value":"Rev.15.8"}],"t":"ref","v":"15:8"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["The Temple was filled with smoke"],"sourceClass":"sn-excerpt","t":"span"}," as a symbol of ",{"c":["God’s glory and power"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=Isa.6.4","r":"Isa.6.4","rawR":"Isa.6.4","sourceRefs":[{"raw":"Isa.6.4","value":"Isa.6.4"}],"t":"ref","v":"Isa 6:4"},"; see ",{"href":"?bref=Exod.19.16-18","r":"Exod.19.16-18","rawR":"Exod.19.16-18","sourceRefs":[{"raw":"Exod.19.16-18","value":"Exod.19.16-18"}],"t":"ref","v":"Exod 19:16-18"},"; ",{"href":"?bref=Exod.40.34-35","r":"Exod.40.34-35","rawR":"Exod.40.34-35","sourceRefs":[{"raw":"Exod.40.34-35","value":"Exod.40.34-35"}],"t":"ref","v":"40:34-35"},"; ",{"href":"?bref=1Kgs.8.10-13","r":"1Kgs.8.10-13","rawR":"1Kgs.8.10-13","sourceRefs":[{"raw":"1Kgs.8.10-13","value":"1Kgs.8.10-13"}],"t":"ref","v":"1 Kgs 8:10-13"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Rev.15.8","refs":[{"book":"REV","endChapter":15,"endVerse":8,"startChapter":15,"startVerse":8}],"sourceAttributes":{"name":"Rev.15.8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"REV","sourceChapterCoverage":[15],"sourceItemFragmentSha256":"467495ed4bf68089b039b625cc782e46187437687d66cf0d9dbbfa8492dd04bf","sourceItemName":"Rev.15.8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16790,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"REV","canonicalOSIS":"Rev","method":"official_book_intro_ref_title","sourceOSIS":"Rev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Rev.15.8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Rev.15.8","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}