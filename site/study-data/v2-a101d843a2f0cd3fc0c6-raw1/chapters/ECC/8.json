3-14","passages":[{"book":"PSA","chapter":73,"verses":[13,14]}]},{"label":"Mal 3:15","passages":[{"book":"MAL","chapter":3,"verses":[15]}]}],"verse":14},{"anchor":"So I commended","refs":["Eccl 2:24","Eccl 3:12-13,22","Eccl 5:18","Eccl 9:7-9","1 Tim 4:3-4","1 Tim 6:17"],"sourceRowNumber":31645,"targets":[{"label":"Eccl 2:24","passages":[{"book":"ECC","chapter":2,"verses":[24]}]},{"label":"Eccl 3:12-13,22","passages":[{"book":"ECC","chapter":3,"verses":[12,13,22]}]},{"label":"Eccl 5:18","passages":[{"book":"ECC","chapter":5,"verses":[18]}]},{"label":"Eccl 9:7-9","passages":[{"book":"ECC","chapter":9,"verses":[7,8,9]}]},{"label":"1 Tim 4:3-4","passages":[{"book":"1TI","chapter":4,"verses":[3,4]}]},{"label":"1 Tim 6:17","passages":[{"book":"1TI","chapter":6,"verses":[17]}]}],"verse":15},{"anchor":"When I","refs":["Eccl 8:9","Eccl 8:7","Eccl 7:25"],"sourceRowNumber":31646,"targets":[{"label":"Eccl 8:9","passages":[{"book":"ECC","chapter":8,"verses":[9]}]},{"label":"Eccl 8:7","passages":[{"book":"ECC","chapter":8,"verses":[7]}]},{"label":"Eccl 7:25","passages":[{"book":"ECC","chapter":7,"verses":[25]}]}],"verse":16},{"anchor":"though his eyes do not see sleep","refs":["Eccl 2:23","Eccl 4:8","Eccl 5:12","Gen 31:40","Ps 127:2"],"sourceRowNumber":31647,"targets":[{"label":"Eccl 2:23","passages":[{"book":"ECC","chapter":2,"verses":[23]}]},{"label":"Eccl 4:8","passages":[{"book":"ECC","chapter":4,"verses":[8]}]},{"label":"Eccl 5:12","passages":[{"book":"ECC","chapter":5,"verses":[12]}]},{"label":"Gen 31:40","passages":[{"book":"GEN","chapter":31,"verses":[40]}]},{"label":"Ps 127:2","passages":[{"book":"PSA","chapter":127,"verses":[2]}]}],"verse":16},{"anchor":"a man is unable to comprehend","refs":["Eccl 3:11","Eccl 7:23-24","Eccl 11:5","Job 5:9","Job 11:7-9","Ps 40:5","Ps 73:16","Ps 104:24","Prov 30:3-4","Isa 40:28","Rom 11:33"],"sourceRowNumber":31648,"targets":[{"label":"Eccl 3:11","passages":[{"book":"ECC","chapter":3,"verses":[11]}]},{"label":"Eccl 7:23-24","passages":[{"book":"ECC","chapter":7,"verses":[23,24]}]},{"label":"Eccl 11:5","passages":[{"book":"ECC","chapter":11,"verses":[5]}]},{"label":"Job 5:9","passages":[{"book":"JOB","chapter":5,"verses":[9]}]},{"label":"Job 11:7-9","passages":[{"book":"JOB","chapter":11,"verses":[7,8,9]}]},{"label":"Ps 40:5","passages":[{"book":"PSA","chapter":40,"verses":[5]}]},{"label":"Ps 73:16","passages":[{"book":"PSA","chapter":73,"verses":[16]}]},{"label":"Ps 104:24","passages":[{"book":"PSA","chapter":104,"verses":[24]}]},{"label":"Prov 30:3-4","passages":[{"book":"PRO","chapter":30,"verses":[3,4]}]},{"label":"Isa 40:28","passages":[{"book":"ISA","chapter":40,"verses":[28]}]},{"label":"Rom 11:33","passages":[{"book":"ROM","chapter":11,"verses":[33]}]}],"verse":17}],"dictionaryArticles":{"EcclesiastesBookof":{"file":"dictionary/1edad5b05801da0d1228eaf8dd84efeca5e25d294b555d61fa9e778a6149c8da.json","title":"Ecclesiastes, Book of"},"WordWordofGodWordsofGod":{"file":"dictionary/90b8c6d9b0885a5722588a705ee349c9cf27c6a9cdb5d69193e7c82e34987599.json","title":"Word, Word of God, Words of God"}},"dictionaryRelated":[{"id":"EcclesiastesBookof","title":"Ecclesiastes, Book of"},{"id":"WordWordofGodWordsofGod","title":"Word, Word of God, Words of God"}],"dictionaryWords":[],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":["All Is “Vapor”"],"sourceClass":"theme-title","t":"h"},{"c":["A key word in Ecclesiastes is the Hebrew term ",{"c":["hebel"],"sourceClass":"hebrew","t":"span"}," (“vapor,” often translated “meaningless”). This word expresses the core of the Teacher’s judgment concerning life in this world."],"sourceClass":"theme-body-fl","t":"p"},{"c":["At its root, ",{"c":["hebel"],"sourceClass":"hebrew","t":"span"}," means physical “breath” or “vapor.” ",{"c":["Hebel"],"sourceClass":"hebrew","t":"span"}," is used seventy-eight times in the Old Testament, but in only three instances is the physical meaning clearly intended (",{"href":"?bref=Ps.62.9","r":"Ps.62.9","rawR":"Ps.62.9","sourceRefs":[{"raw":"Ps.62.9","value":"Ps.62.9"}],"t":"ref","v":"Ps 62:9"},"; ",{"href":"?bref=Pr.21.6","r":"Pr.21.6","rawR":"Pr.21.6","sourceRefs":[{"raw":"Pr.21.6","value":"Pr.21.6"}],"t":"ref","v":"Prov 21:6"},"; ",{"href":"?bref=Isa.57.13","r":"Isa.57.13","rawR":"Isa.57.13","sourceRefs":[{"raw":"Isa.57.13","value":"Isa.57.13"}],"t":"ref","v":"Isa 57:13"},"). In the other seventy-five instances, the word is used metaphorically to describe what is incomprehensible, futile, meaningless, false, transitory, or insubstantial. The term is often used to describe the insubstantiality, unreality, and worthlessness of false gods (",{"href":"?bref=Deut.32.21","r":"Deut.32.21","rawR":"Deut.32.21","sourceRefs":[{"raw":"Deut.32.21","value":"Deut.32.21"}],"t":"ref","v":"Deut 32:21"},"; ",{"href":"?bref=2Kgs.17.15","r":"2Kgs.17.15","rawR":"2Kgs.17.15","sourceRefs":[{"raw":"2Kgs.17.15","value":"2Kgs.17.15"}],"t":"ref","v":"2 Kgs 17:15"},"). In this sense, ",{"c":["hebel"],"sourceClass":"hebrew","t":"span"}," is the opposite of “glory”—the substantial, weighty, and lasting presence of God. Sometimes the word ",{"c":["hebel"],"sourceClass":"hebrew","t":"span"}," stands for the way life is fleeting and momentary, like vapor (",{"href":"?bref=Job.7.16","r":"Job.7.16","rawR":"Job.7.16","sourceRefs":[{"raw":"Job.7.16","value":"Job.7.16"}],"t":"ref","v":"Job 7:16"},"; ",{"href":"?bref=Ps.144.4","r":"Ps.144.4","rawR":"Ps.144.4","sourceRefs":[{"raw":"Ps.144.4","value":"Ps.144.4"}],"t":"ref","v":"Ps 144:4"},"). In other cases, it refers to the meaninglessness and frustration of life (",{"href":"?bref=Ps.78.33","r":"Ps.78.33","rawR":"Ps.78.33","sourceRefs":[{"raw":"Ps.78.33","value":"Ps.78.33"}],"t":"ref","v":"Pss 78:33"},"; ",{"href":"?bref=Ps.94.11","r":"Ps.94.11","rawR":"Ps.94.11","sourceRefs":[{"raw":"Ps.94.11","value":"Ps.94.11"}],"t":"ref","v":"94:11"},"; ",{"href":"?bref=Isa.49.4","r":"Isa.49.4","rawR":"Isa.49.4","sourceRefs":[{"raw":"Isa.49.4","value":"Isa.49.4"}],"t":"ref","v":"Isa 49:4"},")."],"sourceClass":"theme-body","t":"p"},{"c":["There is a long tradition of understanding ",{"c":["hebel"],"sourceClass":"hebrew","t":"span"}," in Ecclesiastes as meaning “vanity,” not in the sense of thinking too highly of oneself, but in the sense of experiencing life as futile and without purpose or meaning. The ancient Greek translation of the Old Testament used the word ",{"c":["mataiotēs"],"sourceClass":"greek","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," which means “emptiness” or “futility.” The Latin Vulgate then translated ",{"c":["hebel"],"sourceClass":"hebrew","t":"span"}," with the Latin word ",{"c":["vanitas"],"sourceClass":"latin","t":"span"},", which means “purposelessness, pointlessness, hollowness, worthlessness.” From the Vulgate comes the long-standing tradition of translating the word as “vanity” in English. Most translators today understand the word ",{"c":["hebel"],"sourceClass":"hebrew","t":"span"}," in this sense: Life on earth has no apparent purpose or meaning, and all that we do is futile."],"sourceClass":"theme-body","t":"p"},{"c":["Some translators, however, understand ",{"c":["hebel"],"sourceClass":"hebrew","t":"span"}," in Ecclesiastes to be referring primarily to the transitory impermanence of life. Vapor has no permanence or weight. This translation leads to a different understanding of Ecclesiastes: Life is not so much meaningless and futile as it is impermanent and fleeting. Many phrases in Ecclesiastes allude to the fleeting nature of human life and its efforts. In the New Testament, a similar thought can be found in ",{"href":"?bref=Jas.4.13-15","r":"Jas.4.13-15","rawR":"Jas.4.13-15","sourceRefs":[{"raw":"Jas.4.13-15","value":"Jas.4.13-15"}],"t":"ref","v":"James 4:13-15"},". The understanding of ",{"c":["hebel"],"sourceClass":"hebrew","t":"span"}," as “impermanence” in Ecclesiastes has merit in explaining the book coherently; it is, however, a minority view among scholars."],"sourceClass":"theme-body","t":"p"},{"c":["The NLT translates ",{"c":["hebel"],"sourceClass":"hebrew","t":"span"}," in Ecclesiastes as “meaningless.” However, while reading Ecclesiastes, it is helpful to keep in mind the root of the word (“breath” or “vapor”) that stands behind the metaphors."],"sourceClass":"theme-body","t":"p"},{"c":["The brevity, frustration, and apparent meaninglessness of life can be depressing. This discouragement should motivate us toward working more wisely and diligently and enjoying life while we can. We have all observed the apparent absurdity of life’s tragedies, such as the success of a wicked fool or unchecked injustice. But these things come into proportion when we remember God’s sovereignty, because “God will judge us for everything we do, including every secret thing, whether good or bad” (",{"href":"?bref=Eccl.12.14","r":"Eccl.12.14","rawR":"Eccl.12.14","sourceRefs":[{"raw":"Eccl.12.14","value":"Eccl.12.14"}],"t":"ref","v":"Eccl 12:14"},")."],"sourceClass":"theme-body","t":"p"},{"c":["Passages for Further Study"],"sourceClass":"theme-refs-title","t":"h"},{"c":[{"href":"?bref=Deut.32.21","r":"Deut.32.21","rawR":"Deut.32.21","sourceRefs":[{"raw":"Deut.32.21","value":"Deut.32.21"}],"t":"ref","v":"Deut 32:21"},"; ",{"href":"?bref=2Kgs.17.15","r":"2Kgs.17.15","rawR":"2Kgs.17.15","sourceRefs":[{"raw":"2Kgs.17.15","value":"2Kgs.17.15"}],"t":"ref","v":"2 Kgs 17:15"},"; ",{"href":"?bref=Job.7.16","r":"Job.7.16","rawR":"Job.7.16","sourceRefs":[{"raw":"Job.7.16","value":"Job.7.16"}],"t":"ref","v":"Job 7:16"},"; ",{"href":"?bref=Ps.62.9","r":"Ps.62.9","rawR":"Ps.62.9","sourceRefs":[{"raw":"Ps.62.9","value":"Ps.62.9"}],"t":"ref","v":"Pss 62:9"},"; ",{"href":"?bref=Ps.78.33","r":"Ps.78.33","rawR":"Ps.78.33","sourceRefs":[{"raw":"Ps.78.33","value":"Ps.78.33"}],"t":"ref","v":"78:33"},"; ",{"href":"?bref=Ps.94.11","r":"Ps.94.11","rawR":"Ps.94.11","sourceRefs":[{"raw":"Ps.94.11","value":"Ps.94.11"}],"t":"ref","v":"94:11"},"; ",{"href":"?bref=Ps.144.4","r":"Ps.144.4","rawR":"Ps.144.4","sourceRefs":[{"raw":"Ps.144.4","value":"Ps.144.4"}],"t":"ref","v":"144:4"},"; ",{"href":"?bref=Pr.21.6","r":"Pr.21.6","rawR":"Pr.21.6","sourceRefs":[{"raw":"Pr.21.6","value":"Pr.21.6"}],"t":"ref","v":"Prov 21:6"},"; ",{"href":"?bref=Eccl.1.2","r":"Eccl.1.2","rawR":"Eccl.1.2","sourceRefs":[{"raw":"Eccl.1.2","value":"Eccl.1.2"}],"t":"ref","v":"Eccl 1:2"},"; ",{"href":"?bref=Isa.30.7","r":"Isa.30.7","rawR":"Isa.30.7","sourceRefs":[{"raw":"Isa.30.7","value":"Isa.30.7"}],"t":"ref","v":"Isa 30:7"},"; ",{"href":"?bref=Isa.49.4","r":"Isa.49.4","rawR":"Isa.49.4","sourceRefs":[{"raw":"Isa.49.4","value":"Isa.49.4"}],"t":"ref","v":"49:4"},"; ",{"href":"?bref=Isa.57.13","r":"Isa.57.13","rawR":"Isa.57.13","sourceRefs":[{"raw":"Isa.57.13","value":"Isa.57.13"}],"t":"ref","v":"57:13"}],"sourceClass":"theme-refs","t":"p"}],"id":"ThemeNote:AllIsVapor","refs":[{"book":"ECC","endChapter":9,"endVerse":12,"startChapter":1,"startVerse":2}],"sourceAttributes":{"name":"AllIsVapor","product":"TyndaleOpenStudyNotes","typename":"ThemeNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[1,2,3,4,5,6,7,8,9],"sourceItemFragmentSha256":"8e44b49b8362e87e4c68edc1d9dd9f34067c57242bf842b4cc95d531232e695c","sourceItemName":"AllIsVapor","sourceMember":"Tyndale Open Study Notes/ThemeNotes.xml","sourceOrder":135,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.1.2-9.12","sourceRelease":"1.25","sourceTitleExact":"All Is “Vapor”","supplementPointersNotIncludedAsContent":[],"title":"All Is “Vapor”","type":"ThemeNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.8.1","r":"Eccl.8.1","rawR":"Eccl.8.1","sourceRefs":[{"raw":"Eccl.8.1","value":"Eccl.8.1"}],"t":"ref","v":"8:1"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["softening its harshness:"],"sourceClass":"sn-excerpt","t":"span"}," Anxiety, anger, sorrow, and frustration can harden one’s face, but the enjoyment of life and wisdom will lighten it."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.8.1","refs":[{"book":"ECC","endChapter":8,"endVerse":1,"startChapter":8,"startVerse":1}],"sourceAttributes":{"name":"Eccl.8.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"bf295f87cf992e80d40d417abe6c6d1b350c647d4e57eaa49a28e272d4790fff","sourceItemName":"Eccl.8.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8052,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.8.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.8.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.8.2","r":"Eccl.8.2","rawR":"Eccl.8.2","sourceRefs":[{"raw":"Eccl.8.2","value":"Eccl.8.2"}],"t":"ref","v":"8:2"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["since you vowed to God that you would:"],"sourceClass":"sn-excerpt","t":"span"}," Cp. ",{"href":"?bref=Eccl.5.2-6","r":"Eccl.5.2-6","rawR":"Eccl.5.2-6","sourceRefs":[{"raw":"Eccl.5.2-6","value":"Eccl.5.2-6"}],"t":"ref","v":"5:2-6"},"; ",{"href":"?bref=1Kgs.2.41-43","r":"1Kgs.2.41-43","rawR":"1Kgs.2.41-43","sourceRefs":[{"raw":"1Kgs.2.41-43","value":"1Kgs.2.41-43"}],"t":"ref","v":"1 Kgs 2:41-43"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.8.2","refs":[{"book":"ECC","endChapter":8,"endVerse":2,"startChapter":8,"startVerse":2}],"sourceAttributes":{"name":"Eccl.8.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"1e47149234f3923a1b993dadf36f68f379baae40de10eaa17f27faabac7a1307","sourceItemName":"Eccl.8.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8053,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.8.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.8.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.8.3-4","r":"Eccl.8.3-4","rawR":"Eccl.8.3-4","sourceRefs":[{"raw":"Eccl.8.3-4","value":"Eccl.8.3-4"}],"t":"ref","v":"8:3-4"}],"sourceClass":"sn-ref","t":"span"}," Plotting against the ",{"c":["king"],"sourceClass":"sn-excerpt","t":"span"}," is futile because he has ",{"c":["great power"],"sourceClass":"sn-excerpt","t":"span"}," and can ",{"c":["do whatever he wants"],"sourceClass":"sn-excerpt","t":"span"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.8.3-4","refs":[{"book":"ECC","endChapter":8,"endVerse":4,"startChapter":8,"startVerse":3}],"sourceAttributes":{"name":"Eccl.8.3-4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"d4d3c9cac97ebd73789aa3fdbf63a124401e8902bb3e7e1e77a659991b94c45e","sourceItemName":"Eccl.8.3-4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8054,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.8.3-4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.8.3-4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.8.6","r":"Eccl.8.6","rawR":"Eccl.8.6","sourceRefs":[{"raw":"Eccl.8.6","value":"Eccl.8.6"}],"t":"ref","v":"8:6"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["there is a time . . . for everything:"],"sourceClass":"sn-excerpt","t":"span"}," Those who are wise will be ready when an opportune time appears (see ",{"href":"?bref=Eccl.3.1-8","r":"Eccl.3.1-8","rawR":"Eccl.3.1-8","sourceRefs":[{"raw":"Eccl.3.1-8","value":"Eccl.3.1-8"}],"t":"ref","v":"3:1-8"},"; ",{"href":"?bref=Eph.5.16","r":"Eph.5.16","rawR":"Eph.5.16","sourceRefs":[{"raw":"Eph.5.16","value":"Eph.5.16"}],"t":"ref","v":"Eph 5:16"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.8.6","refs":[{"book":"ECC","endChapter":8,"endVerse":6,"startChapter":8,"startVerse":6}],"sourceAttributes":{"name":"Eccl.8.6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"5a31bd3816db38c7b7616580c7f93afcacb79f1379f9310a658d961af5c557a4","sourceItemName":"Eccl.8.6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8055,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.8.6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.8.6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.8.7-8","r":"Eccl.8.7-8","rawR":"Eccl.8.7-8","sourceRefs":[{"raw":"Eccl.8.7-8","value":"Eccl.8.7-8"}],"t":"ref","v":"8:7-8"}],"sourceClass":"sn-ref","t":"span"}," Since our strength, goodness, and wisdom cannot forestall calamity, turning to ",{"c":["wickedness"],"sourceClass":"sn-excerpt","t":"span"}," would ",{"c":["certainly"],"sourceClass":"sn-excerpt","t":"span"}," be futile."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.8.7-8","refs":[{"book":"ECC","endChapter":8,"endVerse":8,"startChapter":8,"startVerse":7}],"sourceAttributes":{"name":"Eccl.8.7-8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"fb33552ec63c019a2e144574b6ca4ad736e2bea421776a98fccdea8073dcf5c4","sourceItemName":"Eccl.8.7-8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8056,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.8.7-8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.8.7-8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.8.9-11","r":"Eccl.8.9-11","rawR":"Eccl.8.9-11","sourceRefs":[{"raw":"Eccl.8.9-11","value":"Eccl.8.9-11"}],"t":"ref","v":"8:9-11"}],"sourceClass":"sn-ref","t":"span"}," In this world, injustice often prevails. The apparent success of the ",{"c":["wicked"],"sourceClass":"sn-excerpt","t":"span"}," can be frustrating."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.8.9-11","refs":[{"book":"ECC","endChapter":8,"endVerse":11,"startChapter":8,"startVerse":9}],"sourceAttributes":{"name":"Eccl.8.9-11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"6ab2116d700b5824b8b65df167b06c361d006c473f7f39b38e5b4fed49ba74eb","sourceItemName":"Eccl.8.9-11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8057,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.8.9-11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.8.9-11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.8.12-13","r":"Eccl.8.12-13","rawR":"Eccl.8.12-13","sourceRefs":[{"raw":"Eccl.8.12-13","value":"Eccl.8.12-13"}],"t":"ref","v":"8:12-13"}],"sourceClass":"sn-ref","t":"span"}," Injustice is momentary and does not upset God’s plans for justice (",{"href":"?bref=Eccl.3.16-17","r":"Eccl.3.16-17","rawR":"Eccl.3.16-17","sourceRefs":[{"raw":"Eccl.3.16-17","value":"Eccl.3.16-17"}],"t":"ref","v":"3:16-17"},"; ",{"href":"?bref=Eccl.12.14","r":"Eccl.12.14","rawR":"Eccl.12.14","sourceRefs":[{"raw":"Eccl.12.14","value":"Eccl.12.14"}],"t":"ref","v":"12:14"},"). In reality, wickedness does not pay."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.8.12-13","refs":[{"book":"ECC","endChapter":8,"endVerse":13,"startChapter":8,"startVerse":12}],"sourceAttributes":{"name":"Eccl.8.12-13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"dcbee42250f95971a7ead823d0e7b38e7f4a18f5ff066e433ff013cc2656bcad","sourceItemName":"Eccl.8.12-13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8058,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.8.12-13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.8.12-13","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.8.15","r":"Eccl.8.15","rawR":"Eccl.8.15","sourceRefs":[{"raw":"Eccl.8.15","value":"Eccl.8.15"}],"t":"ref","v":"8:15"}],"sourceClass":"sn-ref","t":"span"}," The Teacher’s conclusion is familiar (",{"href":"?bref=Eccl.2.24-25","r":"Eccl.2.24-25","rawR":"Eccl.2.24-25","sourceRefs":[{"raw":"Eccl.2.24-25","value":"Eccl.2.24-25"}],"t":"ref","v":"2:24-25"},"; ",{"href":"?bref=Eccl.3.12-13","r":"Eccl.3.12-13","rawR":"Eccl.3.12-13","sourceRefs":[{"raw":"Eccl.3.12-13","value":"Eccl.3.12-13"}],"t":"ref","v":"3:12-13"},", ",{"href":"?bref=Eccl.3.22","r":"Eccl.3.22","rawR":"Eccl.3.22","sourceRefs":[{"raw":"Eccl.3.22","value":"Eccl.3.22"}],"t":"ref","v":"22"},"; ",{"href":"?bref=Eccl.5.18-20","r":"Eccl.5.18-20","rawR":"Eccl.5.18-20","sourceRefs":[{"raw":"Eccl.5.18-20","value":"Eccl.5.18-20"}],"t":"ref","v":"5:18-20"},"; ",{"href":"?bref=Eccl.6.9","r":"Eccl.6.9","rawR":"Eccl.6.9","sourceRefs":[{"raw":"Eccl.6.9","value":"Eccl.6.9"}],"t":"ref","v":"6:9"},"). In spite of tragedies and hard labor, we can enjoy life and be happy. • In Hebrew, the word translated ",{"c":["having fun"],"sourceClass":"sn-excerpt","t":"span"}," means finding enjoyment in our daily activities, not pursuing pleasure or entertainment for its own sake."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.8.15","refs":[{"book":"ECC","endChapter":8,"endVerse":15,"startChapter":8,"startVerse":15}],"sourceAttributes":{"name":"Eccl.8.15","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"8a99af979edcda5fd0eb6625ffb8363613d6e283ce87b3b34512a28f11a45c1e","sourceItemName":"Eccl.8.15","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8059,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.8.15","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.8.15","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.8.16-9.12","r":"Eccl.8.16-9.12","rawR":"Eccl.8.16-9.12","sourceRefs":[{"raw":"Eccl.8.16-9.12","value":"Eccl.8.16-9.12"}],"t":"ref","v":"8:16–9:12"}],"sourceClass":"sn-ref","t":"span"}," Another generalization from lifelong observation is that death appears to be meaningless. Why do some die and others live longer? God’s sovereign decision in this matter is unpredictable (",{"href":"?bref=Eccl.7.13-14","r":"Eccl.7.13-14","rawR":"Eccl.7.13-14","sourceRefs":[{"raw":"Eccl.7.13-14","value":"Eccl.7.13-14"}],"t":"ref","v":"7:13-14"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.8.16-9.12","refs":[{"book":"ECC","endChapter":9,"endVerse":12,"startChapter":8,"startVerse":16}],"sourceAttributes":{"name":"Eccl.8.16-9.12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[8,9],"sourceItemFragmentSha256":"bc0776bad4104a4dc6ad18cccf6ee1dc3389613c4fdae4defd4bff3dd824cbf5","sourceItemName":"Eccl.8.16-9.12","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8060,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.8.16-9.12","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.8.16-9.12","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.8.16-17","r":"Eccl.8.16-17","rawR":"Eccl.8.16-17","sourceRefs":[{"raw":"Eccl.8.16-17","value":"Eccl.8.16-17"}],"t":"ref","v":"8:16-17"}],"sourceClass":"sn-ref","t":"span"}," A person could spend night and day looking for the answers to every question, but the reasons for ",{"c":["everything"],"sourceClass":"sn-excerpt","t":"span"}," will not be apparent. God’s justice, for example, is sometimes mysterious."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.8.16-17","refs":[{"book":"ECC","endChapter":8,"endVerse":17,"startChapter":8,"startVerse":16}],"sourceAttributes":{"name":"Eccl.8.16-17","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"8e82dc6e08ab7d6880be6735fd7728c1eb4e9d9586e300183a42544628c300a9","sourceItemName":"Eccl.8.16-17","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8061,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.8.16-17","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.8.16-17","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}