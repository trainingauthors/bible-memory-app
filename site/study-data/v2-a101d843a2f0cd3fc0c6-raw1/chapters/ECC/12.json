ses":[29]}]},{"label":"Acts 17:30-31","passages":[{"book":"ACT","chapter":17,"verses":[30,31]}]},{"label":"Rom 2:16","passages":[{"book":"ROM","chapter":2,"verses":[16]}]},{"label":"Rom 14:10-12","passages":[{"book":"ROM","chapter":14,"verses":[10,11,12]}]},{"label":"1 Cor 4:5","passages":[{"book":"1CO","chapter":4,"verses":[5]}]},{"label":"2 Cor 5:10","passages":[{"book":"2CO","chapter":5,"verses":[10]}]},{"label":"Rev 20:11-15","passages":[{"book":"REV","chapter":20,"verses":[11,12,13,14,15]}]}],"verse":14}],"dictionaryArticles":{"AdamPerson":{"file":"dictionary/264bc01dd34458f0a38567b551fa352164e1e7ce6210605accf9faeb76a7e413.json","title":"Adam (Person)"},"Age":{"file":"dictionary/6041f3ce18b492a0c52cd3c158a8b0f91badd705326817b7e35b68825df1a3c8.json","title":"Age"},"EcclesiastesBookof":{"file":"dictionary/1edad5b05801da0d1228eaf8dd84efeca5e25d294b555d61fa9e778a6149c8da.json","title":"Ecclesiastes, Book of"},"LordsSupperthe":{"file":"dictionary/36619bc8711e0ddd73d934164233b738eaea6a46062561a04b35d0429fb59ab2.json","title":"Lord’s Supper, the"},"Plants":{"file":"dictionary/4577249ac9b7773d00fd8bc627ee1383687474dfdb93b77f98c93d99e4ce0612.json","title":"Plants"},"WisdomLiterature":{"file":"dictionary/60bfca9559688f5416772ffa946be9b716b746bcc70e530673ed00ad7da5af62.json","title":"Wisdom Literature*"}},"dictionaryRelated":[{"id":"AdamPerson","title":"Adam (Person)"},{"id":"Age","title":"Age"},{"id":"EcclesiastesBookof","title":"Ecclesiastes, Book of"},{"id":"LordsSupperthe","title":"Lord’s Supper, the"},{"id":"Plants","title":"Plants"},{"id":"WisdomLiterature","title":"Wisdom Literature*"}],"dictionaryWords":[],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":["Remember Him"],"sourceClass":"theme-title","t":"h"},{"c":["God rescued the Israelites from slavery in Egypt and made them his own people. Yet God knew that in spite of these striking realities, his people would be prone to forget him (",{"href":"?bref=Deut.31.16-21","r":"Deut.31.16-21","rawR":"Deut.31.16-21","sourceRefs":[{"raw":"Deut.31.16-21","value":"Deut.31.16-21"}],"t":"ref","v":"Deut 31:16-21"},"). Moses cautioned the people who were about to enter the Promised Land to never forget what the Lord had done for them (",{"href":"?bref=Deut.8.1-20","r":"Deut.8.1-20","rawR":"Deut.8.1-20","sourceRefs":[{"raw":"Deut.8.1-20","value":"Deut.8.1-20"}],"t":"ref","v":"Deut 8:1-20"},"). Sure enough the people of Israel forgot the Lord, which ultimately led to their exile from the land God had given them (see ",{"href":"?bref=2Kgs.17.5-23","r":"2Kgs.17.5-23","rawR":"2Kgs.17.5-23","sourceRefs":[{"raw":"2Kgs.17.5-23","value":"2Kgs.17.5-23"}],"t":"ref","v":"2 Kgs 17:5-23"},"; see also ",{"href":"?bref=Jer.2.32","r":"Jer.2.32","rawR":"Jer.2.32","sourceRefs":[{"raw":"Jer.2.32","value":"Jer.2.32"}],"t":"ref","v":"Jer 2:32"},")."],"sourceClass":"theme-body-fl","t":"p"},{"c":["The Teacher in Ecclesiastes likewise pointed to the importance of remembering the Lord. After reflecting throughout the book on the temporality and futility of numerous aspects of life, the Teacher concludes his observations by admonishing his readers to remember the one who is not fleeting (",{"href":"?bref=Eccl.12.1-7","r":"Eccl.12.1-7","rawR":"Eccl.12.1-7","sourceRefs":[{"raw":"Eccl.12.1-7","value":"Eccl.12.1-7"}],"t":"ref","v":"Eccl 12:1-7"},"). No one is able to remain young forever; aging and death are a universal part of life. As such, the Teacher encourages people to focus on God while they are young—before it’s too late. God will hold each of us accountable for all that we do (",{"href":"?bref=Eccl.12.13-14","r":"Eccl.12.13-14","rawR":"Eccl.12.13-14","sourceRefs":[{"raw":"Eccl.12.13-14","value":"Eccl.12.13-14"}],"t":"ref","v":"Eccl 12:13-14"},"); how we live in the present must be informed by the reality of his future judgment."],"sourceClass":"theme-body","t":"p"},{"c":["Passages for Further Study"],"sourceClass":"theme-refs-title","t":"h"},{"c":[{"href":"?bref=Deut.8.1-20","r":"Deut.8.1-20","rawR":"Deut.8.1-20","sourceRefs":[{"raw":"Deut.8.1-20","value":"Deut.8.1-20"}],"t":"ref","v":"Deut 8:1-20"},"; ",{"href":"?bref=Eccl.12.1-7","r":"Eccl.12.1-7","rawR":"Eccl.12.1-7","sourceRefs":[{"raw":"Eccl.12.1-7","value":"Eccl.12.1-7"}],"t":"ref","v":"Eccl 12:1-7"},", ",{"href":"?bref=Eccl.12.13-14","r":"Eccl.12.13-14","rawR":"Eccl.12.13-14","sourceRefs":[{"raw":"Eccl.12.13-14","value":"Eccl.12.13-14"}],"t":"ref","v":"13-14"},"; ",{"href":"?bref=1Cor.3.12-14","r":"1Cor.3.12-14","rawR":"1Cor.3.12-14","sourceRefs":[{"raw":"1Cor.3.12-14","value":"1Cor.3.12-14"}],"t":"ref","v":"1 Cor 3:12-14"}],"sourceClass":"theme-refs","t":"p"}],"id":"ThemeNote:RememberHim","refs":[{"book":"ECC","endChapter":12,"endVerse":7,"startChapter":12,"startVerse":1}],"sourceAttributes":{"name":"RememberHim","product":"TyndaleOpenStudyNotes","typename":"ThemeNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[12],"sourceItemFragmentSha256":"43801b71e0e16a37985a9d47a2b46bfa66f0f344286e8cf5568657b476274e54","sourceItemName":"RememberHim","sourceMember":"Tyndale Open Study Notes/ThemeNotes.xml","sourceOrder":137,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.12.1-7","sourceRelease":"1.25","sourceTitleExact":"Remember Him","supplementPointersNotIncludedAsContent":[],"title":"Remember Him","type":"ThemeNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.12.1-7","r":"Eccl.12.1-7","rawR":"Eccl.12.1-7","sourceRefs":[{"raw":"Eccl.12.1-7","value":"Eccl.12.1-7"}],"t":"ref","v":"12:1-7"}],"sourceClass":"sn-ref","t":"span"}," This beautiful prose poem, which uses many metaphors in Hebrew, describes the torturous deterioration of aging (in continuation of ",{"href":"?bref=Eccl.11.7-10","r":"Eccl.11.7-10","rawR":"Eccl.11.7-10","sourceRefs":[{"raw":"Eccl.11.7-10","value":"Eccl.11.7-10"}],"t":"ref","v":"11:7-10"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.12.1-7","refs":[{"book":"ECC","endChapter":12,"endVerse":7,"startChapter":12,"startVerse":1}],"sourceAttributes":{"name":"Eccl.12.1-7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[12],"sourceItemFragmentSha256":"a7bd346c1d5751e227c711ecf63cf8a0adc945c87087b0cad0b3d8cf6588674a","sourceItemName":"Eccl.12.1-7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8092,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.12.1-7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.12.1-7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.12.1-2","r":"Eccl.12.1-2","rawR":"Eccl.12.1-2","sourceRefs":[{"raw":"Eccl.12.1-2","value":"Eccl.12.1-2"}],"t":"ref","v":"12:1-2"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Don’t . . . forget your Creator:"],"sourceClass":"sn-excerpt","t":"span"}," Reverence for God can give wisdom (",{"href":"?bref=Pr.1.7","r":"Pr.1.7","rawR":"Pr.1.7","sourceRefs":[{"raw":"Pr.1.7","value":"Pr.1.7"}],"t":"ref","v":"Prov 1:7"},") and guidance as to what will be beneficial in this life and pleasing to God at the judgment (",{"href":"?bref=Eccl.12.13-14","r":"Eccl.12.13-14","rawR":"Eccl.12.13-14","sourceRefs":[{"raw":"Eccl.12.13-14","value":"Eccl.12.13-14"}],"t":"ref","v":"Eccl 12:13-14"},"). It is better to ",{"c":["remember"],"sourceClass":"sn-excerpt","t":"span"}," God when young, when wisdom can make a real difference in life’s results."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.12.1-2","refs":[{"book":"ECC","endChapter":12,"endVerse":2,"startChapter":12,"startVerse":1}],"sourceAttributes":{"name":"Eccl.12.1-2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[12],"sourceItemFragmentSha256":"074cb7d8af9a999030c64770e51636edb916469f303a93a92031762537026c9a","sourceItemName":"Eccl.12.1-2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8093,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.12.1-2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.12.1-2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.12.3","r":"Eccl.12.3","rawR":"Eccl.12.3","sourceRefs":[{"raw":"Eccl.12.3","value":"Eccl.12.3"}],"t":"ref","v":"12:3"}],"sourceClass":"sn-ref","t":"span"}," The NLT translates the Hebrew metaphors (",{"c":["guards . . . strong men . . . servants . . . women"],"sourceClass":"sn-excerpt","t":"span"},") and also provides an interpretation of these poetic elements (",{"c":["legs . . . shoulders . . . teeth . . . eyes"],"sourceClass":"sn-excerpt","t":"span"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.12.3","refs":[{"book":"ECC","endChapter":12,"endVerse":3,"startChapter":12,"startVerse":3}],"sourceAttributes":{"name":"Eccl.12.3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[12],"sourceItemFragmentSha256":"9e2a3082817c1797724f5f1d89174713b5e6a14ed1ca52def8d19b844138a12c","sourceItemName":"Eccl.12.3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8094,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.12.3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.12.3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.12.5","r":"Eccl.12.5","rawR":"Eccl.12.5","sourceRefs":[{"raw":"Eccl.12.5","value":"Eccl.12.5"}],"t":"ref","v":"12:5"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["caperberry"],"sourceClass":"sn-excerpt","t":"span"}," was well known in the ancient Near East as an aphrodisiac."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.12.5","refs":[{"book":"ECC","endChapter":12,"endVerse":5,"startChapter":12,"startVerse":5}],"sourceAttributes":{"name":"Eccl.12.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[12],"sourceItemFragmentSha256":"9a99048b90a0da9a3378bb0eaeb4f5ed07c9cc81feae2ec32c0b436e6119fe0b","sourceItemName":"Eccl.12.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8095,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.12.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.12.5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.12.6","r":"Eccl.12.6","rawR":"Eccl.12.6","sourceRefs":[{"raw":"Eccl.12.6","value":"Eccl.12.6"}],"t":"ref","v":"12:6"}],"sourceClass":"sn-ref","t":"span"},"  The ",{"c":["silver cord"],"sourceClass":"sn-excerpt","t":"span"}," and the ",{"c":["golden bowl"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," like human life, are very valuable. • The body is like a common earthen ",{"c":["jar"],"sourceClass":"sn-excerpt","t":"span"}," that is fragile and soon broken (cp. ",{"href":"?bref=Isa.29.16","r":"Isa.29.16","rawR":"Isa.29.16","sourceRefs":[{"raw":"Isa.29.16","value":"Isa.29.16"}],"t":"ref","v":"Isa 29:16"},"; ",{"href":"?bref=Jer.19.1","r":"Jer.19.1","rawR":"Jer.19.1","sourceRefs":[{"raw":"Jer.19.1","value":"Jer.19.1"}],"t":"ref","v":"Jer 19:1"},", ",{"href":"?bref=Jer.19.10-11","r":"Jer.19.10-11","rawR":"Jer.19.10-11","sourceRefs":[{"raw":"Jer.19.10-11","value":"Jer.19.10-11"}],"t":"ref","v":"10-11"},"; ",{"href":"?bref=Jer.22.28","r":"Jer.22.28","rawR":"Jer.22.28","sourceRefs":[{"raw":"Jer.22.28","value":"Jer.22.28"}],"t":"ref","v":"22:28"},"; ",{"href":"?bref=2Cor.4.7","r":"2Cor.4.7","rawR":"2Cor.4.7","sourceRefs":[{"raw":"2Cor.4.7","value":"2Cor.4.7"}],"t":"ref","v":"2 Cor 4:7"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.12.6","refs":[{"book":"ECC","endChapter":12,"endVerse":6,"startChapter":12,"startVerse":6}],"sourceAttributes":{"name":"Eccl.12.6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[12],"sourceItemFragmentSha256":"819ca6fe72ac585512f8b0dcfc6bb703245e28dcfe45da3479cf44f05659e1d5","sourceItemName":"Eccl.12.6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8096,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.12.6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.12.6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.12.7","r":"Eccl.12.7","rawR":"Eccl.12.7","sourceRefs":[{"raw":"Eccl.12.7","value":"Eccl.12.7"}],"t":"ref","v":"12:7"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["the dust will return to the earth:"],"sourceClass":"sn-excerpt","t":"span"}," See ",{"href":"?bref=Gen.2.7","r":"Gen.2.7","rawR":"Gen.2.7","sourceRefs":[{"raw":"Gen.2.7","value":"Gen.2.7"}],"t":"ref","v":"Gen 2:7"},"; ",{"href":"?bref=Gen.3.19","r":"Gen.3.19","rawR":"Gen.3.19","sourceRefs":[{"raw":"Gen.3.19","value":"Gen.3.19"}],"t":"ref","v":"3:19"},". • That ",{"c":["the spirit will return to God who gave it"],"sourceClass":"sn-excerpt","t":"span"}," hints at belief in an afterlife (cp. ",{"href":"?bref=Eccl.3.21","r":"Eccl.3.21","rawR":"Eccl.3.21","sourceRefs":[{"raw":"Eccl.3.21","value":"Eccl.3.21"}],"t":"ref","v":"Eccl 3:21"},"; see “",{"href":"?item=TheAfterlife_ThemeNote_Filament","id":"TheAfterlife_ThemeNote_Filament","rawId":"TheAfterlife_ThemeNote_Filament","t":"link","v":"The Afterlife"},"” Theme Note)."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.12.7","refs":[{"book":"ECC","endChapter":12,"endVerse":7,"startChapter":12,"startVerse":7}],"sourceAttributes":{"name":"Eccl.12.7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[12],"sourceItemFragmentSha256":"715b2d8c2fbca4e3227599f8eda0a85637f3857e8ace6f1cdc5116a53f42234e","sourceItemName":"Eccl.12.7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8097,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.12.7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.12.7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.12.8","r":"Eccl.12.8","rawR":"Eccl.12.8","sourceRefs":[{"raw":"Eccl.12.8","value":"Eccl.12.8"}],"t":"ref","v":"12:8"}],"sourceClass":"sn-ref","t":"span"}," This nearly verbatim repetition of ",{"href":"?bref=Eccl.1.2","r":"Eccl.1.2","rawR":"Eccl.1.2","sourceRefs":[{"raw":"Eccl.1.2","value":"Eccl.1.2"}],"t":"ref","v":"1:2"}," sums up the Teacher’s conclusion."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.12.8","refs":[{"book":"ECC","endChapter":12,"endVerse":8,"startChapter":12,"startVerse":8}],"sourceAttributes":{"name":"Eccl.12.8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[12],"sourceItemFragmentSha256":"43857619add6ff8bda77ce7d884a026f009917085db6796b79a7bbc9745ec701","sourceItemName":"Eccl.12.8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8098,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.12.8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.12.8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.12.9-14","r":"Eccl.12.9-14","rawR":"Eccl.12.9-14","sourceRefs":[{"raw":"Eccl.12.9-14","value":"Eccl.12.9-14"}],"t":"ref","v":"12:9-14"}],"sourceClass":"sn-ref","t":"span"}," This coda by the editor (see “Author and Recipients” in the ",{"href":"?item=Eccl_BookIntro_Filament","id":"Eccl_BookIntro_Filament","rawId":"Eccl_BookIntro_Filament","t":"link","v":"Book Introduction"},") expresses the editor’s respect for the Teacher, exhorts readers to apply his teaching, and gives the editor’s own conclusion from studying the Teacher (",{"href":"?bref=Eccl.12.13-14","r":"Eccl.12.13-14","rawR":"Eccl.12.13-14","sourceRefs":[{"raw":"Eccl.12.13-14","value":"Eccl.12.13-14"}],"t":"ref","v":"12:13-14"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.12.9-14","refs":[{"book":"ECC","endChapter":12,"endVerse":14,"startChapter":12,"startVerse":9}],"sourceAttributes":{"name":"Eccl.12.9-14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[12],"sourceItemFragmentSha256":"6235050298f46a6e49e6ea0dcf1b47e0e99a0c0d256d6cd1ec7935777bc0128b","sourceItemName":"Eccl.12.9-14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8099,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.12.9-14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.12.9-14","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.12.9","r":"Eccl.12.9","rawR":"Eccl.12.9","sourceRefs":[{"raw":"Eccl.12.9","value":"Eccl.12.9"}],"t":"ref","v":"12:9"}],"sourceClass":"sn-ref","t":"span"}," Even as king (",{"href":"?bref=Eccl.1.1","r":"Eccl.1.1","rawR":"Eccl.1.1","sourceRefs":[{"raw":"Eccl.1.1","value":"Eccl.1.1"}],"t":"ref","v":"1:1"},"), the Teacher found time to study wisdom. He collected and arranged proverbs (see also ",{"href":"?bref=1Kgs.4.29-34","r":"1Kgs.4.29-34","rawR":"1Kgs.4.29-34","sourceRefs":[{"raw":"1Kgs.4.29-34","value":"1Kgs.4.29-34"}],"t":"ref","v":"1 Kgs 4:29-34"},"; ",{"href":"?bref=Pr.1.1","r":"Pr.1.1","rawR":"Pr.1.1","sourceRefs":[{"raw":"Pr.1.1","value":"Pr.1.1"}],"t":"ref","v":"Prov 1:1"},"; ",{"href":"?bref=Pr.10.1","r":"Pr.10.1","rawR":"Pr.10.1","sourceRefs":[{"raw":"Pr.10.1","value":"Pr.10.1"}],"t":"ref","v":"10:1"},"; ",{"href":"?bref=Pr.25.1","r":"Pr.25.1","rawR":"Pr.25.1","sourceRefs":[{"raw":"Pr.25.1","value":"Pr.25.1"}],"t":"ref","v":"25:1"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.12.9","refs":[{"book":"ECC","endChapter":12,"endVerse":9,"startChapter":12,"startVerse":9}],"sourceAttributes":{"name":"Eccl.12.9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[12],"sourceItemFragmentSha256":"a43e4dae30bb39e9ca82578255c1b113c07d8b93f0d32a3901a88b5be30ecd86","sourceItemName":"Eccl.12.9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8100,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.12.9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.12.9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.12.11","r":"Eccl.12.11","rawR":"Eccl.12.11","sourceRefs":[{"raw":"Eccl.12.11","value":"Eccl.12.11"}],"t":"ref","v":"12:11"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["cattle prods . . . nail-studded stick:"],"sourceClass":"sn-excerpt","t":"span"}," Painful lessons are sometimes required to direct us into paths that we would rather not take. • ",{"c":["a shepherd:"],"sourceClass":"sn-excerpt","t":"span"}," This word is possibly an allusion to God as the shepherd of his people (",{"href":"?bref=Ps.23.1","r":"Ps.23.1","rawR":"Ps.23.1","sourceRefs":[{"raw":"Ps.23.1","value":"Ps.23.1"}],"t":"ref","v":"Ps 23:1"},"; ",{"href":"?bref=Isa.40.11","r":"Isa.40.11","rawR":"Isa.40.11","sourceRefs":[{"raw":"Isa.40.11","value":"Isa.40.11"}],"t":"ref","v":"Isa 40:11"},"). The sentence might also just be comparing ",{"c":["the words of the wise"],"sourceClass":"sn-excerpt","t":"span"}," to the work that any shepherd does in taking care of his flock."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.12.11","refs":[{"book":"ECC","endChapter":12,"endVerse":11,"startChapter":12,"startVerse":11}],"sourceAttributes":{"name":"Eccl.12.11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[12],"sourceItemFragmentSha256":"c24cf7a8a4787fa9fd9c9eb072a5b70aa20d18e647c31c0abd4ee87702aa913b","sourceItemName":"Eccl.12.11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8101,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.12.11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.12.11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.12.12","r":"Eccl.12.12","rawR":"Eccl.12.12","sourceRefs":[{"raw":"Eccl.12.12","value":"Eccl.12.12"}],"t":"ref","v":"12:12"}],"sourceClass":"sn-ref","t":"span"}," A moderate approach to writing and studying wisdom leaves enough time to apply it and enjoy its fruits."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.12.12","refs":[{"book":"ECC","endChapter":12,"endVerse":12,"startChapter":12,"startVerse":12}],"sourceAttributes":{"name":"Eccl.12.12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[12],"sourceItemFragmentSha256":"c6248455df12c57d4d036e2110461328d8916e6fc4be1dd9cbb4800fb74e289d","sourceItemName":"Eccl.12.12","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8102,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.12.12","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.12.12","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.12.13-14","r":"Eccl.12.13-14","rawR":"Eccl.12.13-14","sourceRefs":[{"raw":"Eccl.12.13-14","value":"Eccl.12.13-14"}],"t":"ref","v":"12:13-14"}],"sourceClass":"sn-ref","t":"span"}," The editor’s ",{"c":["conclusion"],"sourceClass":"sn-excerpt","t":"span"}," from studying the Teacher’s work is to ",{"c":["fear God"],"sourceClass":"sn-excerpt","t":"span"}," (see ",{"href":"?bref=Eccl.3.14","r":"Eccl.3.14","rawR":"Eccl.3.14","sourceRefs":[{"raw":"Eccl.3.14","value":"Eccl.3.14"}],"t":"ref","v":"3:14"},"; ",{"href":"?bref=Eccl.5.7","r":"Eccl.5.7","rawR":"Eccl.5.7","sourceRefs":[{"raw":"Eccl.5.7","value":"Eccl.5.7"}],"t":"ref","v":"5:7"},"; ",{"href":"?bref=Eccl.7.18","r":"Eccl.7.18","rawR":"Eccl.7.18","sourceRefs":[{"raw":"Eccl.7.18","value":"Eccl.7.18"}],"t":"ref","v":"7:18"},"; ",{"href":"?bref=Eccl.8.12-13","r":"Eccl.8.12-13","rawR":"Eccl.8.12-13","sourceRefs":[{"raw":"Eccl.8.12-13","value":"Eccl.8.12-13"}],"t":"ref","v":"8:12-13"},"), which includes the need to ",{"c":["obey his commands"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," because everything we do will be judged (see ",{"href":"?bref=Eccl.11.9","r":"Eccl.11.9","rawR":"Eccl.11.9","sourceRefs":[{"raw":"Eccl.11.9","value":"Eccl.11.9"}],"t":"ref","v":"11:9"},"; ",{"href":"?bref=2Cor.5.10","r":"2Cor.5.10","rawR":"2Cor.5.10","sourceRefs":[{"raw":"2Cor.5.10","value":"2Cor.5.10"}],"t":"ref","v":"2 Cor 5:10"},"; ",{"href":"?bref=Heb.9.27","r":"Heb.9.27","rawR":"Heb.9.27","sourceRefs":[{"raw":"Heb.9.27","value":"Heb.9.27"}],"t":"ref","v":"Heb 9:27"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.12.13-14","refs":[{"book":"ECC","endChapter":12,"endVerse":14,"startChapter":12,"startVerse":13}],"sourceAttributes":{"name":"Eccl.12.13-14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[12],"sourceItemFragmentSha256":"32bbe4ca6296fa98f61de287828986d38467e467347249762bfd19fba35ed3d0","sourceItemName":"Eccl.12.13-14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8103,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canon