ourceRefs":[{"raw":"Eccl.9.18-10.1","value":"Eccl.9.18-10.1"}],"t":"ref","v":"9:18–10:1"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["one sinner can destroy . . . a little foolishness spoils:"],"sourceClass":"sn-excerpt","t":"span"}," Sin and foolishness can undo a lot of good in a very short time."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.9.18-10.1","refs":[{"book":"ECC","endChapter":10,"endVerse":1,"startChapter":9,"startVerse":18}],"sourceAttributes":{"name":"Eccl.9.18-10.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[9,10],"sourceItemFragmentSha256":"c9a42beff2f5d7c4f15260ebc2cbbb80da9dc575df63015e8325b26a4fac7d5f","sourceItemName":"Eccl.9.18-10.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8070,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.9.18-10.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.9.18-10.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.10.2-3","r":"Eccl.10.2-3","rawR":"Eccl.10.2-3","sourceRefs":[{"raw":"Eccl.10.2-3","value":"Eccl.10.2-3"}],"t":"ref","v":"10:2-3"}],"sourceClass":"sn-ref","t":"span"}," These two proverbs show the stupidity of ",{"c":["fools"],"sourceClass":"sn-excerpt","t":"span"},". They choose wrongly, and everything they do shows that they are foolish."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.10.2-3","refs":[{"book":"ECC","endChapter":10,"endVerse":3,"startChapter":10,"startVerse":2}],"sourceAttributes":{"name":"Eccl.10.2-3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"2e275fc6cedd35eed96c38e4a8af8de1124028a25c8c9b650abb0cfb955f8ee7","sourceItemName":"Eccl.10.2-3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8071,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.10.2-3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.10.2-3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.10.4","r":"Eccl.10.4","rawR":"Eccl.10.4","sourceRefs":[{"raw":"Eccl.10.4","value":"Eccl.10.4"}],"t":"ref","v":"10:4"}],"sourceClass":"sn-ref","t":"span"}," A ",{"c":["boss"],"sourceClass":"sn-excerpt","t":"span"}," can be anyone in authority."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.10.4","refs":[{"book":"ECC","endChapter":10,"endVerse":4,"startChapter":10,"startVerse":4}],"sourceAttributes":{"name":"Eccl.10.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"e685e1108dfd4b97f3d7a2d29ca54aa774adff9762dcc8d18b2d7685bfb91f23","sourceItemName":"Eccl.10.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8072,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.10.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.10.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.10.5-7","r":"Eccl.10.5-7","rawR":"Eccl.10.5-7","sourceRefs":[{"raw":"Eccl.10.5-7","value":"Eccl.10.5-7"}],"t":"ref","v":"10:5-7"}],"sourceClass":"sn-ref","t":"span"}," The unjust and destructive delegation of ",{"c":["authority"],"sourceClass":"sn-excerpt","t":"span"}," to those incapable of using it wisely is a ",{"c":["grave mistake"],"sourceClass":"sn-excerpt","t":"span"},". Favoritism, nepotism, extortion, and bribery can place the most reckless fools in the most powerful positions."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.10.5-7","refs":[{"book":"ECC","endChapter":10,"endVerse":7,"startChapter":10,"startVerse":5}],"sourceAttributes":{"name":"Eccl.10.5-7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"435c0844f335b56ef34fb25cae022fd58c7d45edd8559cc27a10e1719add9558","sourceItemName":"Eccl.10.5-7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8073,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.10.5-7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.10.5-7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.10.7","r":"Eccl.10.7","rawR":"Eccl.10.7","sourceRefs":[{"raw":"Eccl.10.7","value":"Eccl.10.7"}],"t":"ref","v":"10:7"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["servants riding . . . princes walking:"],"sourceClass":"sn-excerpt","t":"span"}," Cp. ",{"href":"?bref=Pr.19.10","r":"Pr.19.10","rawR":"Pr.19.10","sourceRefs":[{"raw":"Pr.19.10","value":"Pr.19.10"}],"t":"ref","v":"Prov 19:10"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.10.7","refs":[{"book":"ECC","endChapter":10,"endVerse":7,"startChapter":10,"startVerse":7}],"sourceAttributes":{"name":"Eccl.10.7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"7013065cc985ec08792f63bd0a69564854a94cb412846a6b250cef32e1fb0509","sourceItemName":"Eccl.10.7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8074,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.10.7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.10.7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.10.8-9","r":"Eccl.10.8-9","rawR":"Eccl.10.8-9","sourceRefs":[{"raw":"Eccl.10.8-9","value":"Eccl.10.8-9"}],"t":"ref","v":"10:8-9"}],"sourceClass":"sn-ref","t":"span"}," Every activity requires wisdom. Wisdom is evident in the safety precautions taken by those engaged in every profession, yet there is always a degree of risk."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.10.8-9","refs":[{"book":"ECC","endChapter":10,"endVerse":9,"startChapter":10,"startVerse":8}],"sourceAttributes":{"name":"Eccl.10.8-9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"56ef7e060e5d2fa2c36eb0831088d50c2dda842c6e8246134a611dc261960b2e","sourceItemName":"Eccl.10.8-9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8075,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.10.8-9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.10.8-9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.10.10","r":"Eccl.10.10","rawR":"Eccl.10.10","sourceRefs":[{"raw":"Eccl.10.10","value":"Eccl.10.10"}],"t":"ref","v":"10:10"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["wisdom . . . helps you succeed:"],"sourceClass":"sn-excerpt","t":"span"}," In all occupations, there are tools that must be kept in good order to be most efficient. Simply sharpening the blade of ",{"c":["a dull ax"],"sourceClass":"sn-excerpt","t":"span"}," can be a significant act of wisdom for those whose livelihood depends on it."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.10.10","refs":[{"book":"ECC","endChapter":10,"endVerse":10,"startChapter":10,"startVerse":10}],"sourceAttributes":{"name":"Eccl.10.10","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"2280615a7e19502d84774cccc39e834179179203c1ebd7e007b1d1429f9913ef","sourceItemName":"Eccl.10.10","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8076,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.10.10","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.10.10","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.10.11","r":"Eccl.10.11","rawR":"Eccl.10.11","sourceRefs":[{"raw":"Eccl.10.11","value":"Eccl.10.11"}],"t":"ref","v":"10:11"}],"sourceClass":"sn-ref","t":"span"}," One purpose of charming a ",{"c":["snake"],"sourceClass":"sn-excerpt","t":"span"}," is to keep it from biting, but a ",{"c":["snake charmer"],"sourceClass":"sn-excerpt","t":"span"}," risks being bitten before it is charmed. Some occupations are so hazardous that the wise do not engage in them at all."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.10.11","refs":[{"book":"ECC","endChapter":10,"endVerse":11,"startChapter":10,"startVerse":11}],"sourceAttributes":{"name":"Eccl.10.11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"21ac82cca0686aff1b53fca2f9ae7b7bc66a700899175176aad2d97cd4337755","sourceItemName":"Eccl.10.11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8077,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.10.11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.10.11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.10.12","r":"Eccl.10.12","rawR":"Eccl.10.12","sourceRefs":[{"raw":"Eccl.10.12","value":"Eccl.10.12"}],"t":"ref","v":"10:12"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Fools are destroyed by"],"sourceClass":"sn-excerpt","t":"span"}," such things as foolish promises, getting caught in false testimony, and making the wrong people angry (see ",{"href":"?bref=Eccl.5.6","r":"Eccl.5.6","rawR":"Eccl.5.6","sourceRefs":[{"raw":"Eccl.5.6","value":"Eccl.5.6"}],"t":"ref","v":"5:6"},"; ",{"href":"?bref=Pr.17.20","r":"Pr.17.20","rawR":"Pr.17.20","sourceRefs":[{"raw":"Pr.17.20","value":"Pr.17.20"}],"t":"ref","v":"Prov 17:20"},"; ",{"href":"?bref=Pr.18.6-7","r":"Pr.18.6-7","rawR":"Pr.18.6-7","sourceRefs":[{"raw":"Pr.18.6-7","value":"Pr.18.6-7"}],"t":"ref","v":"18:6-7"},"; ",{"href":"?bref=Pr.19.5","r":"Pr.19.5","rawR":"Pr.19.5","sourceRefs":[{"raw":"Pr.19.5","value":"Pr.19.5"}],"t":"ref","v":"19:5"},", ",{"href":"?bref=Pr.19.9","r":"Pr.19.9","rawR":"Pr.19.9","sourceRefs":[{"raw":"Pr.19.9","value":"Pr.19.9"}],"t":"ref","v":"9"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.10.12","refs":[{"book":"ECC","endChapter":10,"endVerse":12,"startChapter":10,"startVerse":12}],"sourceAt