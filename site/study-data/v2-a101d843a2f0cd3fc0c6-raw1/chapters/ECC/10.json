t","t":"p"}],"id":"StudyNote:Eccl.10.14","refs":[{"book":"ECC","endChapter":10,"endVerse":14,"startChapter":10,"startVerse":14}],"sourceAttributes":{"name":"Eccl.10.14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"c12616c90cff705d14f853cb5a4fd4636fcf447799ea32a90d51041b4dc1efc4","sourceItemName":"Eccl.10.14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8079,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.10.14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.10.14","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.10.15-20","r":"Eccl.10.15-20","rawR":"Eccl.10.15-20","sourceRefs":[{"raw":"Eccl.10.15-20","value":"Eccl.10.15-20"}],"t":"ref","v":"10:15-20"}],"sourceClass":"sn-ref","t":"span"}," The audience for this speech might have been an assembly of government workers. How should one rule when power and wealth invite a lack of accountability?"],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.10.15-20","refs":[{"book":"ECC","endChapter":10,"endVerse":20,"startChapter":10,"startVerse":15}],"sourceAttributes":{"name":"Eccl.10.15-20","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"94e7a8d21bd377656bcf035beda8f5d51bfbc52f67481e5b5e3ceed404a73b44","sourceItemName":"Eccl.10.15-20","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8080,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sour