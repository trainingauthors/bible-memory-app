rs"],"sourceClass":"sn-excerpt","t":"span"}," take their leisure only after the work is finished, not ",{"c":["in the morning"],"sourceClass":"sn-excerpt","t":"span"}," before work has even started. Lazy leaders weaken a society or organization."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.10.16-17","refs":[{"book":"ECC","endChapter":10,"endVerse":17,"startChapter":10,"startVerse":16}],"sourceAttributes":{"name":"Eccl.10.16-17","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"99de72f7021804b746444299ac35649ddfdd46062e112471a6902dc6fe09243f","sourceItemName":"Eccl.10.16-17","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8082,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.10.16-17","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.10.16-17","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.10.18","r":"Eccl.10.18","rawR":"Eccl.10.18","sourceRefs":[{"raw":"Eccl.10.18","value":"Eccl.10.18"}],"t":"ref","v":"10:18"}],"sourceClass":"sn-ref","t":"span"}," Delay in repairing a ",{"c":["roof"],"sourceClass":"sn-excerpt","t":"span"}," leads to drooping rafters and eventually to the ruin of the home (see ",{"href":"?bref=Pr.12.27","r":"Pr.12.27","rawR":"Pr.12.27","sourceRefs":[{"raw":"Pr.12.27","value":"Pr.12.27"}],"t":"ref","v":"Prov 12:27"},"; ",{"href":"?bref=Pr.20.4","r":"Pr.20.4","rawR":"Pr.20.4","sourceRefs":[{"raw":"Pr.20.4","value":"Pr.20.4"}],"t":"ref","v":"20:4"},"). Corruption in government has a similar effect (",{"href":"?bref=Eccl.10.15-16","r":"Eccl.10.15-16","rawR":"Eccl.10.15-16","sourceRefs":[{"raw":"Eccl.10.15-16","value":"Eccl.10.15-16"}],"