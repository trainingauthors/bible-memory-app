{"book":"ECC","chapter":6,"crossrefs":[{"anchor":"There is another evil I have seen under the sun, and it weighs heavily upon mankind:","refs":["Eccl 5:13"],"sourceRowNumber":31520,"targets":[{"label":"Eccl 5:13","passages":[{"book":"ECC","chapter":5,"verses":[13]}]}],"verse":1},{"anchor":"a man","refs":["Eccl 5:19","1 Kgs 3:13","1 Chr 29:25,28","2 Chr 1:11","Dan 5:18"],"sourceRowNumber":31521,"targets":[{"label":"Eccl 5:19","passages":[{"book":"ECC","chapter":5,"verses":[19]}]},{"label":"1 Kgs 3:13","passages":[{"book":"1KI","chapter":3,"verses":[13]}]},{"label":"1 Chr 29:25,28","passages":[{"book":"1CH","chapter":29,"verses":[25,28]}]},{"label":"2 Chr 1:11","passages":[{"book":"2CH","chapter":1,"verses":[11]}]},{"label":"Dan 5:18","passages":[{"book":"DAN","chapter":5,"verses":[18]}]}],"verse":2},{"anchor":"so that he lacks nothing his heart desires","refs":["Eccl 2:4-10","Deut 8:7-10","Judg 18:10","Job 21:9-15","Ps 17:14","Ps 73:7","Luke 12:19-20"],"sourceRowNumber":31522,"targets":[{"label":"Eccl 2:4-10","passages":[{"book":"ECC","chapter":2,"verses":[4,5,6,7,8,9,10]}]},{"label":"Deut 8:7-10","passages":[{"book":"DEU","chapter":8,"verses":[7,8,9,10]}]},{"label":"Judg 18:10","passages":[{"book":"JDG","chapter":18,"verses":[10]}]},{"label":"Job 21:9-15","passages":[{"book":"JOB","chapter":21,"verses":[9,10,11,12,13,14,15]}]},{"label":"Ps 17:14","passages":[{"book":"PSA","chapter":17,"verses":[14]}]},{"label":"Ps 73:7","passages":[{"book":"PSA","chapter":73,"verses":[7]}]},{"label":"Luke 12:19-20","passages":[{"book":"LUK","chapter":12,"verses":[19,20]}]}],"verse":2},{"anchor":"Instead, a stranger will enjoy them","refs":["Deut 28:33,43","Ps 39:6","Lam 5:2","Hos 7:9"],"sourceRowNumber":31523,"targets":[{"label":"Deut 28:33,43","passages":[{"book":"DEU","chapter":28,"verses":[33,43]}]},{"label":"Ps 39:6","passages":[{"book":"PSA","chapter":39,"verses":[6]}]},{"label":"Lam 5:2","passages":[{"book":"LAM","chapter":5,"verses":[2]}]},{"label":"Hos 7:9","passages":[{"boo