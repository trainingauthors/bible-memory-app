9:6","Ps 82:6-7","Ps 103:15"],"sourceRowNumber":31542,"targets":[{"label":"Gen 3:9,17-19","passages":[{"book":"GEN","chapter":3,"verses":[9,17,18,19]}]},{"label":"Job 14:1-4","passages":[{"book":"JOB","chapter":14,"verses":[1,2,3,4]}]},{"label":"Ps 39:6","passages":[{"book":"PSA","chapter":39,"verses":[6]}]},{"label":"Ps 82:6-7","passages":[{"book":"PSA","chapter":82,"verses":[6,7]}]},{"label":"Ps 103:15","passages":[{"book":"PSA","chapter":103,"verses":[15]}]}],"verse":10},{"anchor":"but he cannot contend with one stronger than he","refs":["Job 9:3-4,32","Job 33:13","Job 40:2","Isa 45:9-10","Jer 49:19","Rom 9:19-20"],"sourceRowNumber":31543,"targets":[{"label":"Job 9:3-4,32","passages":[{"book":"JOB","chapter":9,"verses":[3,4,32]}]},{"label":"Job 33:13","passages":[{"book":"JOB","chapter":33,"verses":[13]}]},{"label":"Job 40:2","passages":[{"book":"JOB","chapter":40,"verses":[2]}]},{"label":"Isa 45:9-10","passages":[{"book":"ISA","chapter":45,"verses":[9,10]}]},{"label":"Jer 49:19","passages":[{"book":"JER","chapter":49,"verses":[19]}]},{"label":"Rom 9:19-20","passages":[{"book":"ROM","chapter":9,"verses":[19,20]}]}],"verse":10},{"anchor":"For the more words, the more futility—and how does that profit anyone?","refs":["Eccl 1:6-9,17-18","Eccl 2:3-11","Eccl 3:19","Eccl 4:1-4,8,16","Eccl 5:7","Ps 73:6","Hos 12:1"],"sourceRowNumber":31544,"targets":[{"label":"Eccl 1:6-9,17-18","passages":[{"book":"ECC","chapter":1,"verses":[6,7,8,9,17,18]}]},{"label":"Eccl 2:3-11","passages":[{"book":"ECC","chapter":2,"verses":[3,4,5,6,7,8,9,10,11]}]},{"label":"Eccl 3:19","passages":[{"book":"ECC","chapter":3,"verses":[19]}]},{"label":"Eccl 4:1-4,8,16","passages":[{"book":"ECC","chapter":4,"verses":[1,2,3,4,8,16]}]},{"label":"Eccl 5:7","passages":[{"book":"ECC","chapter":5,"verses":[7]}]},{"label":"Ps 73:6","passages":[{"book":"PSA","chapter":73,"verses":[6]}]},{"label":"Hos 12:1","passages":[{"book":"HOS","chapter":12,"verses":[1]}]}],"verse":11},{"anchor":"For who knows what is good for a man","refs":["Eccl 2:3","Eccl 12:13","Ps 4:6","Ps 16:5","Ps 17:15","Ps 47:4","Lam 3:24-27","Mic 6:8"],"sourceRowNumber":31545,"targets":[{"label":"Eccl 2:3","passages":[{"book":"ECC","chapter":2,"verses":[3]}]},{"label":"Eccl 12:13","passages":[{"book":"ECC","chapter":12,"verses":[13]}]},{"label":"Ps 4:6","passages":[{"book":"PSA","chapter":4,"verses":[6]}]},{"label":"Ps 16:5","passages":[{"book":"PSA","chapter":16,"verses":[5]}]},{"label":"Ps 17:15","passages":[{"book":"PSA","chapter":17,"verses":[15]}]},{"label":"Ps 47:4","passages":[{"book":"PSA","chapter":47,"verses":[4]}]},{"label":"Lam 3:24-27","passages":[{"book":"LAM","chapter":3,"verses":[24,25,26,27]}]},{"label":"Mic 6:8","passages":[{"book":"MIC","chapter":6,"verses":[8]}]}],"verse":12},{"anchor":"few days in which he passes through his fleeting life like a shadow","refs":["Eccl 8:13","Eccl 9:6","1 Chr 29:15","Job 8:9","Job 14:2","Ps 39:5-6","Ps 89:47","Ps 90:10-12","Ps 102:11","Ps 109:23","Ps 144:4","Jas 4:14"],"sourceRowNumber":31546,"targets":[{"label":"Eccl 8:13","passages":[{"book":"ECC","chapter":8,"verses":[13]}]},{"label":"Eccl 9:6","passages":[{"book":"ECC","chapter":9,"verses":[6]}]},{"label":"1 Chr 29:15","passages":[{"book":"1CH","chapter":29,"verses":[15]}]},{"label":"Job 8:9","passages":[{"book":"JOB","chapter":8,"verses":[9]}]},{"label":"Job 14:2","passages":[{"book":"JOB","chapter":14,"verses":[2]}]},{"label":"Ps 39:5-6","passages":[{"book":"PSA","chapter":39,"verses":[5,6]}]},{"label":"Ps 89:47","passages":[{"book":"PSA","chapter":89,"verses":[47]}]},{"label":"Ps 90:10-12","passages":[{"book":"PSA","chapter":90,"verses":[10,11,12]}]},{"label":"Ps 102:11","passages":[{"book":"PSA","chapter":102,"verses":[11]}]},{"label":"Ps 109:23","passages":[{"book":"PSA","chapter":109,"verses":[23]}]},{"label":"Ps 144:4","passages":[{"book":"PSA","chapter":144,"verses":[4]}]},{"label":"Jas 4:14","passages":[{"book":"JAS","chapter":4,"verses":[14]}]}],"verse":12},{"anchor":"Who can tell a man what will come after him under the sun?","refs":["Eccl 3:22","Eccl 8:7","Job 14:21"],"sourceRowNumber":31547,"targets":[{"label":"Eccl 3:22","passages":[{"book":"ECC","chapter":3,"verses":[22]}]},{"label":"Eccl 8:7","passages":[{"book":"ECC","chapter":8,"verses":[7]}]},{"label":"Job 14:21","passages":[{"book":"JOB","chapter":14,"verses":[21]}]}],"verse":12}],"dictionaryArticles":{"Darkness":{"file":"dictionary/7a2a21d678e2a91067227a016f324c445a481adc7390dad30248ad05ace41bf1.json","title":"Darkness"},"EcclesiastesBookof":{"file":"dictionary/1edad5b05801da0d1228eaf8dd84efeca5e25d294b555d61fa9e778a6149c8da.json","title":"Ecclesiastes, Book of"}},"dictionaryRelated":[{"id":"EcclesiastesBookof","title":"Ecclesiastes, Book of"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"darkness","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":34,"href":"?bref=Eccl.6.4","rawReference":"Eccl.6.4"}],"ruleId":"Darkness::Darkness::source_verse_citation","sourceHeadwordId":"Darkness"},"text":"For a stillborn child enters in futility and departs in darkness, and his name is shrouded in obscurity.","verse":4}],"id":"Darkness","label":"darkness","matchReviews":[{"ruleId":"Darkness::Darkness::source_verse_citation","scope":"source_verse_citation","senseReview":"Reviewed original headword and source sense. This substantive word is admitted only where the original article explicitly cites the exact occurrence verse; ambiguous homographs and known context mismatches are separately excluded. This is selective contextual evidence, not an automatic rule for every same-spelling word.","sourceHeadwordId":"Darkness","term":"Darkness"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Darkness","sourceTitle":"Darkness"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":["All Is “Vapor”"],"sourceClass":"theme-title","t":"h"},{"c":["A key word in Ecclesiastes is the Hebrew term ",{"c":["hebel"],"sourceClass":"hebrew","t":"span"}," (“vapor,” often translated “meaningless”). This word expresses the core of the Teacher’s judgment concerning life in this world."],"sourceClass":"theme-body-fl","t":"p"},{"c":["At its root, ",{"c":["hebel"],"sourceClass":"hebrew","t":"span"}," means physical “breath” or “vapor.” ",{"c":["Hebel"],"sourceClass":"hebrew","t":"span"}," is used seventy-eight times in the Old Testament, but in only three instances is the physical meaning clearly intended (",{"href":"?bref=Ps.62.9","r":"Ps.62.9","rawR":"Ps.62.9","sourceRefs":[{"raw":"Ps.62.9","value":"Ps.62.9"}],"t":"ref","v":"Ps 62:9"},"; ",{"href":"?bref=Pr.21.6","r":"Pr.21.6","rawR":"Pr.21.6","sourceRefs":[{"raw":"Pr.21.6","value":"Pr.21.6"}],"t":"ref","v":"Prov 21:6"},"; ",{"href":"?bref=Isa.57.13","r":"Isa.57.13","rawR":"Isa.57.13","sourceRefs":[{"raw":"Isa.57.13","value":"Isa.57.13"}],"t":"ref","v":"Isa 57:13"},"). In the other seventy-five instances, the word is used metaphorically to describe what is incomprehensible, futile, meaningless, false, transitory, or insubstantial. The term is often used to describe the insubstantiality, unreality, and worthlessness of false gods (",{"href":"?bref=Deut.32.21","r":"Deut.32.21","rawR":"Deut.32.21","sourceRefs":[{"raw":"Deut.32.21","value":"Deut.32.21"}],"t":"ref","v":"Deut 32:21"},"; ",{"href":"?bref=2Kgs.17.15","r":"2Kgs.17.15","rawR":"2Kgs.17.15","sourceRefs":[{"raw":"2Kgs.17.15","value":"2Kgs.17.15"}],"t":"ref","v":"2 Kgs 17:15"},"). In this sense, ",{"c":["hebel"],"sourceClass":"hebrew","t":"span"}," is the opposite of “glory”—the substantial, weighty, and lasting presence of God. Sometimes the word ",{"c":["hebel"],"sourceClass":"hebrew","t":"span"}," stands for the way life is fleeting and momentary, like vapor (",{"href":"?bref=Job.7.16","r":"Job.7.16","rawR":"Job.7.16","sourceRefs":[{"raw":"Job.7.16","value":"Job.7.16"}],"t":"ref","v":"Job 7:16"},"; ",{"href":"?bref=Ps.144.4","r":"Ps.144.4","rawR":"Ps.144.4","sourceRefs":[{"raw":"Ps.144.4","value":"Ps.144.4"}],"t":"ref","v":"Ps 144:4"},"). In other cases, it refers to the meaninglessness and frustration of life (",{"href":"?bref=Ps.78.33","r":"Ps.78.33","rawR":"Ps.78.33","sourceRefs":[{"raw":"Ps.78.33","value":"Ps.78.33"}],"t":"ref","v":"Pss 78:33"},"; ",{"href":"?bref=Ps.94.11","r":"Ps.94.11","rawR":"Ps.94.11","sourceRefs":[{"raw":"Ps.94.11","value":"Ps.94.11"}],"t":"ref","v":"94:11"},"; ",{"href":"?bref=Isa.49.4","r":"Isa.49.4","rawR":"Isa.49.4","sourceRefs":[{"raw":"Isa.49.4","value":"Isa.49.4"}],"t":"ref","v":"Isa 49:4"},")."],"sourceClass":"theme-body","t":"p"},{"c":["There is a long tradition of understanding ",{"c":["hebel"],"sourceClass":"hebrew","t":"span"}," in Ecclesiastes as meaning “vanity,” not in the sense of thinking too highly of oneself, but in the sense of experiencing life as futile and without purpose or meaning. The ancient Greek translation of the Old Testament used the word ",{"c":["mataiotēs"],"sourceClass":"greek","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," which means “emptiness” or “futility.” The Latin Vulgate then translated ",{"c":["hebel"],"sourceClass":"hebrew","t":"span"}," with the Latin word ",{"c":["vanitas"],"sourceClass":"latin","t":"span"},", which means “purposelessness, pointlessness, hollowness, worthlessness.” From the Vulgate comes the long-standing tradition of translating the word as “vanity” in English. Most translators today understand the word ",{"c":["hebel"],"sourceClass":"hebrew","t":"span"}," in this sense: Life on earth has no apparent purpose or meaning, and all that we do is futile."],"sourceClass":"theme-body","t":"p"},{"c":["Some translators, however, understand ",{"c":["hebel"],"sourceClass":"hebrew","t":"span"}," in Ecclesiastes to be referring primarily to the transitory impermanence of life. Vapor has no permanence or weight. This translation leads to a different understanding of Ecclesiastes: Life is not so much meaningless and futile as it is impermanent and fleeting. Many phrases in Ecclesiastes allude to the fleeting nature of human life and its efforts. In the New Testament, a similar thought can be found in ",{"href":"?bref=Jas.4.13-15","r":"Jas.4.13-15","rawR":"Jas.4.13-15","sourceRefs":[{"raw":"Jas.4.13-15","value":"Jas.4.13-15"}],"t":"ref","v":"James 4:13-15"},". The understanding of ",{"c":["hebel"],"sourceClass":"hebrew","t":"span"}," as “impermanence” in Ecclesiastes has merit in explaining the book coherently; it is, however, a minority view among scholars."],"sourceClass":"theme-body","t":"p"},{"c":["The NLT translates ",{"c":["hebel"],"sourceClass":"hebrew","t":"span"}," in Ecclesiastes as “meaningless.” However, while reading Ecclesiastes, it is helpful to keep in mind the root of the word (“breath” or “vapor”) that stands behind the metaphors."],"sourceClass":"theme-body","t":"p"},{"c":["The brevity, frustration, and apparent meaninglessness of life can be depressing. This discouragement should motivate us toward working more wisely and diligently and enjoying life while we can. We have all observed the apparent absurdity of life’s tragedies, such as the success of a wicked fool or unchecked injustice. But these things come into proportion when we remember God’s sovereignty, because “God will judge us for everything we do, including every secret thing, whether good or bad” (",{"href":"?bref=Eccl.12.14","r":"Eccl.12.14","rawR":"Eccl.12.14","sourceRefs":[{"raw":"Eccl.12.14","value":"Eccl.12.14"}],"t":"ref","v":"Eccl 12:14"},")."],"sourceClass":"theme-body","t":"p"},{"c":["Passages for Further Study"],"sourceClass":"theme-refs-title","t":"h"},{"c":[{"href":"?bref=Deut.32.21","r":"Deut.32.21","rawR":"Deut.32.21","sourceRefs":[{"raw":"Deut.32.21","value":"Deut.32.21"}],"t":"ref","v":"Deut 32:21"},"; ",{"href":"?bref=2Kgs.17.15","r":"2Kgs.17.15","rawR":"2Kgs.17.15","sourceRefs":[{"raw":"2Kgs.17.15","value":"2Kgs.17.15"}],"t":"ref","v":"2 Kgs 17:15"},"; ",{"href":"?bref=Job.7.16","r":"Job.7.16","rawR":"Job.7.16","sourceRefs":[{"raw":"Job.7.16","value":"Job.7.16"}],"t":"ref","v":"Job 7:16"},"; ",{"href":"?bref=Ps.62.9","r":"Ps.62.9","rawR":"Ps.62.9","sourceRefs":[{"raw":"Ps.62.9","value":"Ps.62.9"}],"t":"ref","v":"Pss 62:9"},"; ",{"href":"?bref=Ps.78.33","r":"Ps.78.33","rawR":"Ps.78.33","sourceRefs":[{"raw":"Ps.78.33","value":"Ps.78.33"}],"t":"ref","v":"78:33"},"; ",{"href":"?bref=Ps.94.11","r":"Ps.94.11","rawR":"Ps.94.11","sourceRefs":[{"raw":"Ps.94.11","value":"Ps.94.11"}],"t":"ref","v":"94:11"},"; ",{"href":"?bref=Ps.144.4","r":"Ps.144.4","rawR":"Ps.144.4","sourceRefs":[{"raw":"Ps.144.4","value":"Ps.144.4"}],"t":"ref","v":"144:4"},"; ",{"href":"?bref=Pr.21.6","r":"Pr.21.6","rawR":"Pr.21.6","sourceRefs":[{"raw":"Pr.21.6","value":"Pr.21.6"}],"t":"ref","v":"Prov 21:6"},"; ",{"href":"?bref=Eccl.1.2","r":"Eccl.1.2","rawR":"Eccl.1.2","sourceRefs":[{"raw":"Eccl.1.2","value":"Eccl.1.2"}],"t":"ref","v":"Eccl 1:2"},"; ",{"href":"?bref=Isa.30.7","r":"Isa.30.7","rawR":"Isa.30.7","sourceRefs":[{"raw":"Isa.30.7","value":"Isa.30.7"}],"t":"ref","v":"Isa 30:7"},"; ",{"href":"?bref=Isa.49.4","r":"Isa.49.4","rawR":"Isa.49.4","sourceRefs":[{"raw":"Isa.49.4","value":"Isa.49.4"}],"t":"ref","v":"49:4"},"; ",{"href":"?bref=Isa.57.13","r":"Isa.57.13","rawR":"Isa.57.13","sourceRefs":[{"raw":"Isa.57.13","value":"Isa.57.13"}],"t":"ref","v":"57:13"}],"sourceClass":"theme-refs","t":"p"}],"id":"ThemeNote:AllIsVapor","refs":[{"book":"ECC","endChapter":9,"endVerse":12,"startChapter":1,"startVerse":2}],"sourceAttributes":{"name":"AllIsVapor","product":"TyndaleOpenStudyNotes","typename":"ThemeNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[1,2,3,4,5,6,7,8,9],"sourceItemFragmentSha256":"8e44b49b8362e87e4c68edc1d9dd9f34067c57242bf842b4cc95d531232e695c","sourceItemName":"AllIsVapor","sourceMember":"Tyndale Open Study Notes/ThemeNotes.xml","sourceOrder":135,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.1.2-9.12","sourceRelease":"1.25","sourceTitleExact":"All Is “Vapor”","supplementPointersNotIncludedAsContent":[],"title":"All Is “Vapor”","type":"ThemeNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.6.1-2","r":"Eccl.6.1-2","rawR":"Eccl.6.1-2","sourceRefs":[{"raw":"Eccl.6.1-2","value":"Eccl.6.1-2"}],"t":"ref","v":"6:1-2"}],"sourceClass":"sn-ref","t":"span"}," This “unfortunate man” parable resembles ",{"href":"?bref=Eccl.4.7-8","r":"Eccl.4.7-8","rawR":"Eccl.4.7-8","sourceRefs":[{"raw":"Eccl.4.7-8","value":"Eccl.4.7-8"}],"t":"ref","v":"4:7-8"}," and ",{"href":"?bref=Eccl.5.13-17","r":"Eccl.5.13-17","rawR":"Eccl.5.13-17","sourceRefs":[{"raw":"Eccl.5.13-17","value":"Eccl.5.13-17"}],"t":"ref","v":"5:13-17"},". It is ",{"c":["a sickening tragedy"],"sourceClass":"sn-excerpt","t":"span"}," when someone succeeds but then cannot ",{"c":["enjoy these things"],"sourceClass":"sn-excerpt","t":"span"},". Such a person has missed out on the only available benefit of success."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.6.1-2","refs":[{"book":"ECC","endChapter":6,"endVerse":2,"startChapter":6,"startVerse":1}],"sourceAttributes":{"name":"Eccl.6.1-2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[6],"sourceItemFragmentSha256":"8aa77e94de115777ca7dfc920ce043328d6ad5deec0bdd1131bcbb55562971d0","sourceItemName":"Eccl.6.1-2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8025,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.6.1-2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.6.1-2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.6.3-6","r":"Eccl.6.3-6","rawR":"Eccl.6.3-6","sourceRefs":[{"raw":"Eccl.6.3-6","value":"Eccl.6.3-6"}],"t":"ref","v":"6:3-6"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["a hundred children and . . . be very old:"],"sourceClass":"sn-excerpt","t":"span"}," Such honors as virility and old age amount to nothing if life is not enjoyable or does not end well (",{"c":["a decent burial"],"sourceClass":"sn-excerpt","t":"span"},"). The ",{"c":["darkness"],"sourceClass":"sn-excerpt","t":"span"}," of being ",{"c":["born dead"],"sourceClass":"sn-excerpt","t":"span"}," is preferable to a discontented life."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.6.3-6","refs":[{"book":"ECC","endChapter":6,"endVerse":6,"startChapter":6,"startVerse":3}],"sourceAttributes":{"name":"Eccl.6.3-6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[6],"sourceItemFragmentSha256":"7e6b2565bf8f166888d8e80484294f2e0cb03869257533fc2a81a075049e22c7","sourceItemName":"Eccl.6.3-6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8026,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.6.3-6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.6.3-6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.6.7","r":"Eccl.6.7","rawR":"Eccl.6.7","sourceRefs":[{"raw":"Eccl.6.7","value":"Eccl.6.7"}],"t":"ref","v":"6:7"}],"sourceClass":"sn-ref","t":"span"}," People never seem to be satisfied with what they have, no matter how much it is (cp. ",{"href":"?bref=Eccl.5.10","r":"Eccl.5.10","rawR":"Eccl.5.10","sourceRefs":[{"raw":"Eccl.5.10","value":"Eccl.5.10"}],"t":"ref","v":"5:10"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.6.7","refs":[{"book":"ECC","endChapter":6,"endVerse":7,"startChapter":6,"startVerse":7}],"sourceAttributes":{"name":"Eccl.6.7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[6],"sourceItemFragmentSha256":"e8057b93c5b7e3af0755a095a564af2c4a96b24d29010558c23ff5fffd6e2fa0","sourceItemName":"Eccl.6.7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8027,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.6.7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.6.7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.6.8-9","r":"Eccl.6.8-9","rawR":"Eccl.6.8-9","sourceRefs":[{"raw":"Eccl.6.8-9","value":"Eccl.6.8-9"}],"t":"ref","v":"6:8-9"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["are wise people really better off . . . being wise?"],"sourceClass":"sn-excerpt","t":"span"}," Yes, as long as they ",{"c":["enjoy"],"sourceClass":"sn-excerpt","t":"span"}," and are content with what the Lord has provided."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.6.8-9","refs":[{"book":"ECC","endChapter":6,"endVerse":9,"startChapter":6,"startVerse":8}],"sourceAttributes":{"name":"Eccl.6.8-9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[6],"sourceItemFragmentSha256":"baf5e5d7b3d4cd68df0fb65f0083eaf647e2b75c9289c10bbf17ecd59bae75e5","sourceItemName":"Eccl.6.8-9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8028,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.6.8-9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.6.8-9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.6.10-7.22","r":"Eccl.6.10-7.22","rawR":"Eccl.6.10-7.22","sourceRefs":[{"raw":"Eccl.6.10-7.22","value":"Eccl.6.10-7.22"}],"t":"ref","v":"6:10–7:22"}],"sourceClass":"sn-ref","t":"span"}," God’s sovereign rule over ",{"c":["everything"],"sourceClass":"sn-excerpt","t":"span"}," is sobering, but it is ultimately a source of hope."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.6.10-7.22","refs":[{"book":"ECC","endChapter":7,"endVerse":22,"startChapter":6,"startVerse":10}],"sourceAttributes":{"name":"Eccl.6.10-7.22","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[6,7],"sourceItemFragmentSha256":"517eeaa46978563e16d5adc2c0d19f4530a34b81ef418becfe054336c0ea8135","sourceItemName":"Eccl.6.10-7.22","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8029,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.6.10-7.22","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.6.10-7.22","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.6.10","r":"Eccl.6.10","rawR":"Eccl.6.10","sourceRefs":[{"raw":"Eccl.6.10","value":"Eccl.6.10"}],"t":"ref","v":"6:10"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Everything has already been decided:"],"sourceClass":"sn-excerpt","t":"span"}," Cp. ",{"href":"?bref=Rom.8.29","r":"Rom.8.29","rawR":"Rom.8.29","sourceRefs":[{"raw":"Rom.8.29","value":"Rom.8.29"}],"t":"ref","v":"Rom 8:29"},"; ",{"href":"?bref=Eph.1.5","r":"Eph.1.5","rawR":"Eph.1.5","sourceRefs":[{"raw":"Eph.1.5","value":"Eph.1.5"}],"t":"ref","v":"Eph 1:5"},", ",{"href":"?bref=Eph.1.11","r":"Eph.1.11","rawR":"Eph.1.11","sourceRefs":[{"raw":"Eph.1.11","value":"Eph.1.11"}],"t":"ref","v":"11"},". • ",{"c":["It was known long ago what each person would be:"],"sourceClass":"sn-excerpt","t":"span"}," Cp. ",{"href":"?bref=Ps.139.15-16","r":"Ps.139.15-16","rawR":"Ps.139.15-16","sourceRefs":[{"raw":"Ps.139.15-16","value":"Ps.139.15-16"}],"t":"ref","v":"Ps 139:15-16"},". • ",{"c":["no use arguing with God about your destiny:"],"sourceClass":"sn-excerpt","t":"span"}," Cp. ",{"href":"?bref=Rom.9.20-24","r":"Rom.9.20-24","rawR":"Rom.9.20-24","sourceRefs":[{"raw":"Rom.9.20-24","value":"Rom.9.20-24"}],"t":"ref","v":"Rom 9:20-24"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.6.10","refs":[{"book":"ECC","endChapter":6,"endVerse":10,"startChapter":6,"startVerse":10}],"sourceAttributes":{"name":"Eccl.6.10","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[6],"sourceItemFragmentSha256":"669781800ce44342a3c83644d794edec08ef6c5c07284e825fc7dd25d554e602","sourceItemName":"Eccl.6.10","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8030,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.6.10","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.6.10","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.6.11","r":"Eccl.6.11","rawR":"Eccl.6.11","sourceRefs":[{"raw":"Eccl.6.11","value":"Eccl.6.11"}],"t":"ref","v":"6:11"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["more words . . . the less they mean:"],"sourceClass":"sn-excerpt","t":"span"}," Cp. ",{"href":"?bref=Pr.10.19","r":"Pr.10.19","rawR":"Pr.10.19","sourceRefs":[{"raw":"Pr.10.19","value":"Pr.10.19"}],"t":"ref","v":"Prov 10:19"},"; ",{"href":"?bref=Pr.17.28","r":"Pr.17.28","rawR":"Pr.17.28","sourceRefs":[{"raw":"Pr.17.28","value":"Pr.17.28"}],"t":"ref","v":"17:28"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.6.11","refs":[{"book":"ECC","endChapter":6,"endVerse":11,"startChapter":6,"startVerse":11}],"sourceAttributes":{"name":"Eccl.6.11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[6],"sourceItemFragmentSha256":"5fda073494a00bddb4fb212dbfad33c0014ec5e4c61f225d4aaf684553d504b0","sourceItemName":"Eccl.6.11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8031,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.6.11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.6.11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Eccl.6.12","r":"Eccl.6.12","rawR":"Eccl.6.12","sourceRefs":[{"raw":"Eccl.6.12","value":"Eccl.6.12"}],"t":"ref","v":"6:12"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["who knows? Who can tell?"],"sourceClass":"sn-excerpt","t":"span"}," These questions have already been answered. Our ",{"c":["days can best be spent"],"sourceClass":"sn-excerpt","t":"span"}," in wise living and in enjoying our work and God’s gifts (",{"href":"?bref=Eccl.2.13-14","r":"Eccl.2.13-14","rawR":"Eccl.2.13-14","sourceRefs":[{"raw":"Eccl.2.13-14","value":"Eccl.2.13-14"}],"t":"ref","v":"2:13-14"},", ",{"href":"?bref=Eccl.2.24","r":"Eccl.2.24","rawR":"Eccl.2.24","sourceRefs":[{"raw":"Eccl.2.24","value":"Eccl.2.24"}],"t":"ref","v":"24"},"; ",{"href":"?bref=Eccl.3.22","r":"Eccl.3.22","rawR":"Eccl.3.22","sourceRefs":[{"raw":"Eccl.3.22","value":"Eccl.3.22"}],"t":"ref","v":"3:22"},"; ",{"href":"?bref=Eccl.5.18","r":"Eccl.5.18","rawR":"Eccl.5.18","sourceRefs":[{"raw":"Eccl.5.18","value":"Eccl.5.18"}],"t":"ref","v":"5:18"},"). ",{"c":["What will happen on this earth"],"sourceClass":"sn-excerpt","t":"span"}," is what has already happened (",{"href":"?bref=Eccl.1.9","r":"Eccl.1.9","rawR":"Eccl.1.9","sourceRefs":[{"raw":"Eccl.1.9","value":"Eccl.1.9"}],"t":"ref","v":"1:9"},", ",{"href":"?bref=Eccl.1.10","r":"Eccl.1.10","rawR":"Eccl.1.10","sourceRefs":[{"raw":"Eccl.1.10","value":"Eccl.1.10"}],"t":"ref","v":"10"},"; ",{"href":"?bref=Eccl.3.15","r":"Eccl.3.15","rawR":"Eccl.3.15","sourceRefs":[{"raw":"Eccl.3.15","value":"Eccl.3.15"}],"t":"ref","v":"3:15"},"). • ",{"c":["like a shadow:"],"sourceClass":"sn-excerpt","t":"span"}," Cp. ",{"href":"?bref=Ps.39.4-6","r":"Ps.39.4-6","rawR":"Ps.39.4-6","sourceRefs":[{"raw":"Ps.39.4-6","value":"Ps.39.4-6"}],"t":"ref","v":"Pss 39:4-6"},"; ",{"href":"?bref=Ps.90.3-6","r":"Ps.90.3-6","rawR":"Ps.90.3-6","sourceRefs":[{"raw":"Ps.90.3-6","value":"Ps.90.3-6"}],"t":"ref","v":"90:3-6"},", ",{"href":"?bref=Ps.90.10-12","r":"Ps.90.10-12","rawR":"Ps.90.10-12","sourceRefs":[{"raw":"Ps.90.10-12","value":"Ps.90.10-12"}],"t":"ref","v":"10-12"},"; ",{"href":"?bref=Ps.109.23","r":"Ps.109.23","rawR":"Ps.109.23","sourceRefs":[{"raw":"Ps.109.23","value":"Ps.109.23"}],"t":"ref","v":"109:23"},"; ",{"href":"?bref=Ps.144.4","r":"Ps.144.4","rawR":"Ps.144.4","sourceRefs":[{"raw":"Ps.144.4","value":"Ps.144.4"}],"t":"ref","v":"144:4"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Eccl.6.12","refs":[{"book":"ECC","endChapter":6,"endVerse":12,"startChapter":6,"startVerse":12}],"sourceAttributes":{"name":"Eccl.6.12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ECC","sourceChapterCoverage":[6],"sourceItemFragmentSha256":"9b810f895b2a49c3f9cb7db024bdad4f6ecbd689905e26efa006169584c0d732","sourceItemName":"Eccl.6.12","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8032,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ECC","canonicalOSIS":"Eccl","method":"official_book_intro_ref_title","sourceOSIS":"Eccl"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Eccl.6.12","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Eccl.6.12","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}