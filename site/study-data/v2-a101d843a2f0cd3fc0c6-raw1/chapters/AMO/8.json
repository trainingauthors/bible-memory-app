errupted by the dialogue with Amaziah."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Amos.8.1","refs":[{"book":"AMO","endChapter":8,"endVerse":1,"startChapter":8,"startVerse":1}],"sourceAttributes":{"name":"Amos.8.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"AMO","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"acf966fffd671f408037e148c41cf4fd4a8ff0b83a3194cba19817aa32fc4d20","sourceItemName":"Amos.8.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11170,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"AMO","canonicalOSIS":"Amos","method":"official_book_intro_ref_title","sourceOSIS":"Amos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Amos.8.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Amos.8.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Amos.8.2","r":"Amos.8.2","rawR":"Amos.8.2","sourceRefs":[{"raw":"Amos.8.2","value":"Amos.8.2"}],"t":"ref","v":"8:2"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["ripe for punishment"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["the end has come"],"sourceClass":"ital","t":"span"},"): Amos makes a play on words between ",{"c":["ripe fruit"],"sourceClass":"sn-excerpt","t":"span"}," (Hebrew ",{"c":["qayits"],"sourceClass":"hebrew","t":"span"},") and ",{"c":["the end has come"],"sourceClass":"ital","t":"span"}," (Hebrew ",{"c":["ba’ haqqets"],"sourceClass":"hebrew","t":"span"},"). The end had come for God’s people, Israel, because they were ripe fruit, ready to be harvested in judgment."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Amos.8.2","refs":[{"book":"AMO","endChapter":8,"endVerse":2,"startChapter":8,"startVerse":2}],"sourceAttributes":{"name":"Amos.8.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"AMO","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"77ff4ef2ae5f7cb7b5b40b529f745a24e68e400a464854b75433507090604862","sourceItemName":"Amos.8.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11171,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"AMO","canonicalOSIS":"Amos","method":"official_book_intro_ref_title","sourceOSIS":"Amos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Amos.8.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Amos.8.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Amos.8.4-14","r":"Amos.8.4-14","rawR":"Amos.8.4-14","sourceRefs":[{"raw":"Amos.8.4-14","value":"Amos.8.4-14"}],"t":"ref","v":"8:4-14"}],"sourceClass":"sn-ref","t":"span"}," This section expands the indictments and judgments listed earlier (read with ",{"href":"?bref=Amos.2.6-6.14","r":"Amos.2.6-6.14","rawR":"Amos.2.6-6.14","sourceRefs":[{"raw":"Amos.2.6-6.14","value":"Amos.2.6-6.14"}],"t":"ref","v":"2:6–6:14"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Amos.8.4-14","refs":[{"book":"AMO","endChapter":8,"endVerse":14,"startChapter":8,"startVerse":4}],"sourceAttributes":{"name":"Amos.8.4-14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"AMO","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"a1cfd5140bb06b9e36e0382ec943ee59e6fbcc50fd912349f3e619246f0f6326","sourceItemName":"Amos.8.4-14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11172,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"AMO","canonicalOSIS":"Amos","method":"official_book_intro_ref_title","sourceOSIS":"Amos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Amos.8.4-14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Amos.8.4-14","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Amos.8.5","r":"Amos.8.5","rawR":"Amos.8.5","sourceRefs":[{"raw":"Amos.8.5","value":"Amos.8.5"}],"t":"ref","v":"8:5"}],"sourceClass":"sn-ref","t":"span"}," Work was explicitly forbidden on the ",{"c":["Sabbath day"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=Exod.20.9-10","r":"Exod.20.9-10","rawR":"Exod.20.9-10","sourceRefs":[{"raw":"Exod.20.9-10","value":"Exod.20.9-10"}],"t":"ref","v":"Exod 20:9-10"},"); Amos implies that shops were closed during pagan new-moon ",{"c":["religious festivals"],"sourceClass":"sn-excerpt","t":"span"}," as well. • Merchants were ",{"c":["cheating"],"sourceClass":"sn-excerpt","t":"span"}," their customers by measuring grain with small ephahs and cheating their suppliers by using heavy shekels on the scales. This practice was forbidden by God’s law (",{"href":"?bref=Lev.19.35-36","r":"Lev.19.35-36","rawR":"Lev.19.35-36","sourceRefs":[{"raw":"Lev.19.35-36","value":"Lev.19.35-36"}],"t":"ref","v":"Lev 19:35-36"},"; ",{"href":"?bref=Deut.25.13-16","r":"Deut.25.13-16","rawR":"Deut.25.13-16","sourceRefs":[{"raw":"Deut.25.13-16","value":"Deut.25.13-16"}],"t":"ref","v":"Deut 25:13-16"},"; see ",{"href":"?bref=Pr.11.1","r":"Pr.11.1","rawR":"Pr.11.1","sourceRefs":[{"raw":"Pr.11.1","value":"Pr.11.1"}],"t":"ref","v":"Prov 11:1"},"; ",{"href":"?bref=Pr.16.11","r":"Pr.16.11","rawR":"Pr.16.11","sourceRefs":[{"raw":"Pr.16.11","value":"Pr.16.11"}],"t":"ref","v":"16:11"},"; ",{"href":"?bref=Pr.20.10","r":"Pr.20.10","rawR":"Pr.20.10","sourceRefs":[{"raw":"Pr.20.10","value":"Pr.20.10"}],"t":"ref","v":"20:10"},", ",{"href":"?bref=Pr.20.23","r":"Pr.20.23","rawR":"Pr.20.23","sourceRefs":[{"raw":"Pr.20.23","value":"Pr.20.23"}],"t":"ref","v":"23"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Amos.8.5","refs":[{"book":"AMO","endChapter":8,"endVerse":5,"startChapter":8,"startVerse":5}],"sourceAttributes":{"name":"Amos.8.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"AMO","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"0dd466fb7a564d5c3c7b9a8c4dee8d5d8b929696f8cd71129751aa8125a97f10","sourceItemName":"Amos.8.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11173,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"AMO","canonicalOSIS":"Amos","method":"official_book_intro_ref_title","sourceOSIS":"Amos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Amos.8.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Amos.8.5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Amos.8.7","r":"Amos.8.7","rawR":"Amos.8.7","sourceRefs":[{"raw":"Amos.8.7","value":"Amos.8.7"}],"t":"ref","v":"8:7"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["the Pride of Israel:"],"sourceClass":"sn-excerpt","t":"span"}," The same Hebrew phrase alludes in ",{"href":"?bref=Amos.6.8","r":"Amos.6.8","rawR":"Amos.6.8","sourceRefs":[{"raw":"Amos.6.8","value":"Amos.6.8"}],"t":"ref","v":"6:8"}," to Israel’s arrogance. Here, the phrase is probably a name for God, who is the legitimate object of Israel’s pride. Elsewhere (",{"href":"?bref=Ps.47.4","r":"Ps.47.4","rawR":"Ps.47.4","sourceRefs":[{"raw":"Ps.47.4","value":"Ps.47.4"}],"t":"ref","v":"Ps 47:4"},"; ",{"href":"?bref=Nah.2.2","r":"Nah.2.2","rawR":"Nah.2.2","sourceRefs":[{"raw":"Nah.2.2","value":"Nah.2.2"}],"t":"ref","v":"Nah 2:2"},"), this phrase refers to the Promised Land under a king from David’s line (cp. ",{"href":"?bref=Jer.13.9","r":"Jer.13.9","rawR":"Jer.13.9","sourceRefs":[{"raw":"Jer.13.9","value":"Jer.13.9"}],"t":"ref","v":"Jer 13:9"},"; ",{"href":"?bref=Ezek.32.12","r":"Ezek.32.12","rawR":"Ezek.32.12","sourceRefs":[{"raw":"Ezek.32.12","value":"Ezek.32.12"}],"t":"ref","v":"Ezek 32:12"},"). If the phrase here means the land, it would spotlight Israel’s perverse pride in its national and geographic identity."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Amos.8.7","refs":[{"book":"AMO","endChapter":8,"endVerse":7,"startChapter":8,"startVerse":7}],"sourceAttributes":{"name":"Amos.8.7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"AMO","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"2c13de70f62003c65a1c30bd8131972a6f4bb42804eab5f256705fe311ed6de2","sourceItemName":"Amos.8.7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11174,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"AMO","canonicalOSIS":"Amos","method":"official_book_intro_ref_title","sourceOSIS":"Amos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Amos.8.7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Amos.8.7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Amos.8.9","r":"Amos.8.9","rawR":"Amos.8.9","sourceRefs":[{"raw":"Amos.8.9","value":"Amos.8.9"}],"t":"ref","v":"8:9"}],"sourceClass":"sn-ref","t":"span"}," The day of the Lord would invert the cosmos. Jeremiah used similar imagery to describe the desecration of Judah as the Babylonian armies approached (",{"href":"?bref=Jer.4.23","r":"Jer.4.23","rawR":"Jer.4.23","sourceRefs":[{"raw":"Jer.4.23","value":"Jer.4.23"}],"t":"ref","v":"Jer 4:23"},"; see also ",{"href":"?bref=Isa.13.10","r":"Isa.13.10","rawR":"Isa.13.10","sourceRefs":[{"raw":"Isa.13.10","value":"Isa.13.10"}],"t":"ref","v":"Isa 13:10"},"; ",{"href":"?bref=Isa.34.4","r":"Isa.34.4","rawR":"Isa.34.4","sourceRefs":[{"raw":"Isa.34.4","value":"Isa.34.4"}],"t":"ref","v":"34:4"},"; ",{"href":"?bref=Isa.50.3","r":"Isa.50.3","rawR":"Isa.50.3","sourceRefs":[{"raw":"Isa.50.3","value":"Isa.50.3"}],"t":"ref","v":"50:3"},"; ",{"href":"?bref=Ezek.32.7-8","r":"Ezek.32.7-8","rawR":"Ezek.32.7-8","sourceRefs":[{"raw":"Ezek.32.7-8","value":"Ezek.32.7-8"}],"t":"ref","v":"Ezek 32:7-8"},"; ",{"href":"?bref=Joel.2.10","r":"Joel.2.10","rawR":"Joel.2.10","sourceRefs":[{"raw":"Joel.2.10","value":"Joel.2.10"}],"t":"ref","v":"Joel 2:10"},", ",{"href":"?bref=Joel.2.31","r":"Joel.2.31","rawR":"Joel.2.31","sourceRefs":[{"raw":"Joel.2.31","value":"Joel.2.31"}],"t":"ref","v":"31"},"; ",{"href":"?bref=Mic.3.6","r":"Mic.3.6","rawR":"Mic.3.6","sourceRefs":[{"raw":"Mic.3.6","value":"Mic.3.6"}],"t":"ref","v":"Mic 3:6"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Amos.8.9","refs":[{"book":"AMO","endChapter":8,"endVerse":9,"startChapter":8,"startVerse":9}],"sourceAttributes":{"name":"Amos.8.9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"AMO","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"0d6f20f71424a4cd9b6894c0cb57a7c966a958c9994cfc07b8a1e1cd11736db4","sourceItemName":"Amos.8.9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11175,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"AMO","canonicalOSIS":"Amos","method":"official_book_intro_ref_title","sourceOSIS":"Amos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Amos.8.9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Amos.8.9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Amos.8.11-14","r":"Amos.8.11-14","rawR":"Amos.8.11-14","sourceRefs":[{"raw":"Amos.8.11-14","value":"Amos.8.11-14"}],"t":"ref","v":"8:11-14"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["famine . . . of hearing the words of the"],"sourceClass":"sn-excerpt","t":"span"}," ",{"c":["Lord"],"sourceClass":"sn-excerpt-divine-name","t":"span"},{"c":[":"],"sourceClass":"sn-excerpt","t":"span"}," God sent prophets to Israel to speak his words directly to them, but Israel commanded the prophets not to prophesy (",{"href":"?bref=Amos.2.11-12","r":"Amos.2.11-12","rawR":"Amos.2.11-12","sourceRefs":[{"raw":"Amos.2.11-12","value":"Amos.2.11-12"}],"t":"ref","v":"2:11-12"},"). Now they had what they wanted, but it was a silence more terrible than his roar and thunder: God became distant (see ",{"href":"?bref=Ezek.7.26","r":"Ezek.7.26","rawR":"Ezek.7.26","sourceRefs":[{"raw":"Ezek.7.26","value":"Ezek.7.26"}],"t":"ref","v":"Ezek 7:26"},"; ",{"href":"?bref=Ezek.20.3","r":"Ezek.20.3","rawR":"Ezek.20.3","sourceRefs":[{"raw":"Ezek.20.3","value":"Ezek.20.3"}],"t":"ref","v":"20:3"},"; ",{"href":"?bref=Mic.3.4","r":"Mic.3.4","rawR":"Mic.3.4","sourceRefs":[{"raw":"Mic.3.4","value":"Mic.3.4"}],"t":"ref","v":"Mic 3:4"},", ",{"href":"?bref=Mic.3.7","r":"Mic.3.7","rawR":"Mic.3.7","sourceRefs":[{"raw":"Mic.3.7","value":"Mic.3.7"}],"t":"ref","v":"7"},"). The time for speaking was over; the time of judgment had come."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Amos.8.11-14","refs":[{"book":"AMO","endChapter":8,"endVerse":14,"startChapter":8,"startVerse":11}],"sourceAttributes":{"name":"Amos.8.11-14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"AMO","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"e6ea124543f94a39f145175ec0cc1b85129c244c729687ea36c634deeeae6fb7","sourceItemName":"Amos.8.11-14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11176,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"AMO","canonicalOSIS":"Amos","method":"official_book_intro_ref_title","sourceOSIS":"Amos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Amos.8.11-14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Amos.8.11-14","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Amos.8.12","r":"Amos.8.12","rawR":"Amos.8.12","sourceRefs":[{"raw":"Amos.8.12","value":"Amos.8.12"}],"t":"ref","v":"8:12"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["from border to border: "],"sourceClass":"sn-excerpt","t":"span"},"The natural boundaries of Israel were ",{"c":["from sea to sea:"],"sourceClass":"sn-excerpt","t":"span"}," the Mediterranean Sea on the west and the Dead Sea on the east. The other borders are simply called the ",{"c":["north"],"sourceClass":"ital","t":"span"}," and the ",{"c":["east"],"sourceClass":"ital","t":"span"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Amos.8.12","refs":[{"book":"AMO","endChapter":8,"endVerse":12,"startChapter":8,"startVerse":12}],"sourceAttributes":{"name":"Amos.8.12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"AMO","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"48586f97b930f87af2d792353e40bf0dd42795f212a02356cfe1f58100bac6cc","sourceItemName":"Amos.8.12","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11177,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"AMO","canonicalOSIS":"Amos","method":"official_book_intro_ref_title","sourceOSIS":"Amos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Amos.8.12","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Amos.8.12","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Amos.8.14","r":"Amos.8.14","rawR":"Amos.8.14","sourceRefs":[{"raw":"Amos.8.14","value":"Amos.8.14"}],"t":"ref","v":"8:14"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["god of Dan"],"sourceClass":"sn-excerpt","t":"span"}," refers to the northern shrine of the gold calf established by Jeroboam I (see ",{"href":"?bref=1Kgs.12.28-29","r":"1Kgs.12.28-29","rawR":"1Kgs.12.28-29","sourceRefs":[{"raw":"1Kgs.12.28-29","value":"1Kgs.12.28-29"}],"t":"ref","v":"1 Kgs 12:28-29"},"; ",{"href":"?bref=2Kgs.10.29","r":"2Kgs.10.29","rawR":"2Kgs.10.29","sourceRefs":[{"raw":"2Kgs.10.29","value":"2Kgs.10.29"}],"t":"ref","v":"2 Kgs 10:29"},"). • ",{"c":["the god of Beersheba:"],"sourceClass":"sn-excerpt","t":"span"}," Evidently Beersheba had become a center of worship in the southern kingdom. Archaeologists have found the remains of a horned altar in the ruins of Beersheba."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Amos.8.14","refs":[{"book":"AMO","endChapter":8,"endVerse":14,"startChapter":8,"startVerse":14}],"sourceAttributes":{"name":"Amos.8.14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"AMO","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"6fb770b6e34533b162fc48d94e7f306a9f915e91fc7c6730ccc4e2751e4b1c65","sourceItemName":"Amos.8.14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11178,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"AMO","canonicalOSIS":"Amos","method":"official_book_intro_ref_title","sourceOSIS":"Amos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Amos.8.14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Amos.8.14","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}