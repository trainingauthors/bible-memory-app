al","sourceRefsExact":"Hos.11.12-12.14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.11.12-12.14","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.12.1","r":"Hos.12.1","rawR":"Hos.12.1","sourceRefs":[{"raw":"Hos.12.1","value":"Hos.12.1"}],"t":"ref","v":"12:1"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["alliance with Assyria:"],"sourceClass":"sn-excerpt","t":"span"}," In order to save his land, Hoshea became a vassal of King Shalmaneser of Assyria (",{"href":"?bref=2Kgs.17.3","r":"2Kgs.17.3","rawR":"2Kgs.17.3","sourceRefs":[{"raw":"2Kgs.17.3","value":"2Kgs.17.3"}],"t":"ref","v":"2 Kgs 17:3"},"). Hoshea soon rebelled against Shalmaneser by withholding tribute and turned to King So of ",{"c":["Egypt"],"sourceClass":"sn-excerpt","t":"span"}," for ",{"c":["support"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=2Kgs.17.4","r":"2Kgs.17.4","rawR":"2Kgs.17.4","sourceRefs":[{"raw":"2Kgs.17.4","value":"2Kgs.17.4"}],"t":"ref","v":"2 Kgs 17:4"},"). • ",{"c":["east wind:"],"sourceClass":"sn-excerpt","t":"span"}," See ",{"href":"?item=Job.38.24-27_StudyNote_Filament","id":"Job.38.24-27_StudyNote_Filament","rawId":"Job.38.24-27_StudyNote_Filament","t":"link","v":"study note on Job 38:24-27"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.12.1","refs":[{"book":"HOS","endChapter":12,"endVerse":1,"startChapter":12,"startVerse":1}],"sourceAttributes":{"name":"Hos.12.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[12],"sourceItemFragmentSha256":"e546d92ec2a32b4c0e105311a1f1ff7d6727ba7bc19ea7d8dafcef77a9e5daba","sourceItemName":"Hos.12.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10968,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.12.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.12.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.12.3","r":"Hos.12.3","rawR":"Hos.12.3","sourceRefs":[{"raw":"Hos.12.3","value":"Hos.12.3"}],"t":"ref","v":"12:3"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Jacob struggled with his brother"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["he supplanted his brother"],"sourceClass":"ital","t":"span"},"): This verb (Hebrew ",{"c":["‘aqab"],"sourceClass":"hebrew","t":"span"},") forms the root of Jacob’s name. Even before he was born, Jacob acted out the meaning of his name by supplanting his brother Esau (",{"href":"?bref=Gen.25.26","r":"Gen.25.26","rawR":"Gen.25.26","sourceRefs":[{"raw":"Gen.25.26","value":"Gen.25.26"}],"t":"ref","v":"Gen 25:26"},"). • As an adult, Jacob ",{"c":["even fought with God"],"sourceClass":"sn-excerpt","t":"span"}," (see ",{"href":"?bref=Gen.32.22-30","r":"Gen.32.22-30","rawR":"Gen.32.22-30","sourceRefs":[{"raw":"Gen.32.22-30","value":"Gen.32.22-30"}],"t":"ref","v":"Gen 32:22-30"},") and was renamed “Israel,” meaning “God fights.”"],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.12.3","refs":[{"book":"HOS","endChapter":12,"endVerse":3,"startChapter":12,"startVerse":3}],"sourceAttributes":{"name":"Hos.12.3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[12],"sourceItemFragmentSha256":"cd2e994e2e00490bbb0ed3b180fb192fd375508ad49c5326d1b29c7f42a5b09a","sourceItemName":"Hos.12.3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10969,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.12.3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.12.3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.12.4","r":"Hos.12.4","rawR":"Hos.12.4","sourceRefs":[{"raw":"Hos.12.4","value":"Hos.12.4"}],"t":"ref","v":"12:4"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["at Bethel he met God:"],"sourceClass":"sn-excerpt","t":"span"}," See ",{"href":"?bref=Gen.28.11-22","r":"Gen.28.11-22","rawR":"Gen.28.11-22","sourceRefs":[{"raw":"Gen.28.11-22","value":"Gen.28.11-22"}],"t":"ref","v":"Gen 28:11-22"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.12.4","refs":[{"book":"HOS","endChapter":12,"endVerse":4,"startChapter":12,"startVerse":4}],"sourceAttributes":{"name":"Hos.12.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[12],"sourceItemFragmentSha256":"f072ffd1980e6a4ef9d378c93541cf8a9e9292fe009ef5abeb3513eeead89aab","sourceItemName":"Hos.12.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10970,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.12.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.12.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.12.6","r":"Hos.12.6","rawR":"Hos.12.6","sourceRefs":[{"raw":"Hos.12.6","value":"Hos.12.6"}],"t":"ref","v":"12:6"}],"sourceClass":"sn-ref","t":"span"}," The Lord admonished Israel to live no longer as Jacob did, but to return to God and ",{"c":["act with love and justice"],"sourceClass":"sn-excerpt","t":"span"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.12.6","refs":[{"book":"HOS","endChapter":12,"endVerse":6,"startChapter":12,"startVerse":6}],"sourceAttributes":{"name":"Hos.12.6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[12],"sourceItemFragmentSha256":"a1e5df33aee17b46f421e8f72c300becbf1161fb20157fc87ac1642c7cfb9312","sourceItemName":"Hos.12.6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10971,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.12.6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.12.6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.12.7-8","r":"Hos.12.7-8","rawR":"Hos.12.7-8","sourceRefs":[{"raw":"Hos.12.7-8","value":"Hos.12.7-8"}],"t":"ref","v":"12:7-8"}],"sourceClass":"sn-ref","t":"span"}," During the reign of Jeroboam II (793–753 ",{"c":["BC"],"sourceClass":"era","t":"span"},"), Israelite ",{"c":["merchants"],"sourceClass":"sn-excerpt","t":"span"}," became fabulously wealthy, often by using deceitful business practices like ",{"c":["dishonest scales"],"sourceClass":"sn-excerpt","t":"span"}," (see ",{"href":"?bref=Amos.8.5-6","r":"Amos.8.5-6","rawR":"Amos.8.5-6","sourceRefs":[{"raw":"Amos.8.5-6","value":"Amos.8.5-6"}],"t":"ref","v":"Amos 8:5-6"},"). • The Hebrew term translated ",{"c":["merchants"],"sourceClass":"sn-excerpt","t":"span"}," is ",{"c":["kena‘an"],"sourceClass":"hebrew","t":"span"}," (“Canaan”). Canaanite traders were notorious in the ancient world for their crafty dealings. The Israelites had imitated their pagan neighbors not only in religion but also in commerce."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.12.7-8","refs":[{"book":"HOS","endChapter":12,"endVerse":8,"startChapter":12,"startVerse":7}],"sourceAttributes":{"name":"Hos.12.7-8","p