chingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"They will walk after the LORD; He will roar like a lion. When He roars, His children will come trembling from the west.","verse":10},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"They will come trembling like birds from Egypt and like doves from the land of Assyria. Then I will settle them in their homes, declares the LORD.","verse":11}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"love","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":8,"href":"?bref=Hos.11.1-4","rawReference":"Hos.11.1-4"}],"ruleId":"Love::Love::source_verse_citation","sourceHeadwordId":"Love"},"text":"I led them with cords of kindness, with ropes of love; I lifted the yoke from their necks and bent down to feed them.","verse":4}],"id":"Love","label":"love","matchReviews":[{"ruleId":"Love::Love::source_verse_citation","scope":"source_verse_citation","senseReview":"Reviewed original headword and source sense. This substantive word is admitted only where the original article explicitly cites the exact occurrence verse; ambiguous homographs and known context mismatches are separately excluded. This is selective contextual evidence, not an automatic rule for every same-spelling word.","sourceHeadwordId":"Love","term":"Love"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Love","sourceTitle":"Love"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.11.1-11","r":"Hos.11.1-11","rawR":"Hos.11.1-11","sourceRefs":[{"raw":"Hos.11.1-11","value":"Hos.11.1-11"}],"t":"ref","v":"11:1-11"}],"sourceClass":"sn-ref","t":"span"}," God agonized over Israel’s unfaithfulness. Despite all he had done, Israel had become a rebel. Justice required severe punishment, but the final sentence for Israel would be determined by God’s tender compassion for his people, not by an abstract principle."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.11.1-11","refs":[{"book":"HOS","endChapter":11,"endVerse":11,"startChapter":11,"startVerse":1}],"sourceAttributes":{"name":"Hos.11.1-11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[11],"sourceItemFragmentSha256":"5de6683bf7d7f337a03abcad55fadeb3d187b8f2b5f46e48be5babb0b3483776","sourceItemName":"Hos.11.1-11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10959,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.11.1-11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.11.1-11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.11.1","r":"Hos.11.1","rawR":"Hos.11.1","sourceRefs":[{"raw":"Hos.11.1","value":"Hos.11.1"}],"t":"ref","v":"11:1"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["my son:"],"sourceClass":"sn-excerpt","t":"span"}," The Lord adopted Israel when he delivered him ",{"c":["out of Egypt"],"sourceClass":"sn-excerpt","t":"span"},". This verse is quoted in reference to Jesus in ",{"href":"?bref=Matt.2.15","r":"Matt.2.15","rawR":"Matt.2.15","sourceRefs":[{"raw":"Matt.2.15","value":"Matt.2.15"}],"t":"ref","v":"Matt 2:15"}," (see ",{"href":"?item=Matt.4.1-11_StudyNote_Filament","id":"Matt.4.1-11_StudyNote_Filament","rawId":"Matt.4.1-11_StudyNote_Filament","t":"link","v":"study note on Matt 4:1-11"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.11.1","refs":[{"book":"HOS","endChapter":11,"endVerse":1,"startChapter":11,"startVerse":1}],"sourceAttributes":{"name":"Hos.11.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[11],"sourceItemFragmentSha256":"49705ded9c77854e2b56bb07e68f64757b35bfb052014244ced50a259079949c","sourceItemName":"Hos.11.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10960,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.11.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.11.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.11.2","r":"Hos.11.2","rawR":"Hos.11.2","sourceRefs":[{"raw":"Hos.11.2","value":"Hos.11.2"}],"t":"ref","v":"11:2"}],"sourceClass":"sn-ref","t":"span"}," In spite of God’s love, Israel had become a rebellious child, ",{"c":["offering sacrifices to . . . Baal"],"sourceClass":"sn-excerpt","t":"span"},". The penalty for a rebellious son was death (",{"href":"?bref=Deut.21.18-21","r":"Deut.21.18-21","rawR":"Deut.21.18-21","sourceRefs":[{"raw":"Deut.21.18-21","value":"Deut.21.18-21"}],"t":"ref","v":"Deut 21:18-21"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.11.2","refs":[{"book":"HOS","endChapter":11,"endVerse":2,"startChapter":11,"startVerse":2}],"sourceAttributes":{"name":"Hos.11.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[11],"sourceItemFragmentSha256":"87662d9f4bc9dce72ddfd184fc0695686eb30aebc61ff247158fd71f50f5bc9b","sourceItemName":"Hos.11.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10961,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.11.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.11.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.11.3-4","r":"Hos.11.3-4","rawR":"Hos.11.3-4","sourceRefs":[{"raw":"Hos.11.3-4","value":"Hos.11.3-4"}],"t":"ref","v":"11:3-4"}],"sourceClass":"sn-ref","t":"span"}," God’s nurture of the infant Israel was marked by ",{"c":["kindness and love"],"sourceClass":"sn-excerpt","t":"span"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.11.3-4","refs":[{"book":"HOS","endChapter":11,"endVerse":4,"startChapter":11,"startVerse":3}],"sourceAttributes":{"name":"Hos.11.3-4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[11],"sourceItemFragmentSha256":"bb6f704312db4ae9620a3cb28564c5aa1e39194491ad328e250cd3ff0ca509f1","sourceItemName":"Hos.11.3-4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10962,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.11.3-4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.11.3-4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.11.5-7","r":"Hos.11.5-7","rawR":"Hos.11.5-7","sourceRefs":[{"raw":"Hos.11.5-7","value":"Hos.11.5-7"}],"t":"ref","v":"11:5-7"}],"sourceClass":"sn-ref","t":"span"}," Because the Israelites had refused to return to the Lord, ",{"c":["they"],"sourceClass":"sn-excerpt","t":"span"}," would ",{"c":["return to Egypt and . . . serve Assyria"],"sourceClass":"sn-excerpt","t":"span"},". Their past bondage in Egypt was a symbol for their coming exile in Assyria."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.11.5-7","refs":[{"book":"HOS","endChapter":11,"endVerse":7,"startChapter":11,"startVerse":5}],"sourceAttributes":{"name":"Hos.11.5-7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[11],"sourceItemFragmentSha256":"523b67867f16eb1ff92306e68ff5b0ae5aaf96e3611c1a14785455ff6df6b843","sourceItemName":"Hos.11.5-7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10963,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.11.5-7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.11.5-7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.11.8","r":"Hos.11.8","rawR":"Hos.11.8","sourceRefs":[{"raw":"Hos.11.8","value":"Hos.11.8"}],"t":"ref","v":"11:8"}],"sourceClass":"sn-ref","t":"span"}," Though justice demanded Israel’s death, the Lord recoiled at the thought of giving Israel up, of letting them go, of destroying his son. • ",{"c":["Admah"],"sourceClass":"sn-excerpt","t":"span"}," and ",{"c":["Zeboiim"],"sourceClass":"sn-excerpt","t":"span"}," were cities near Sodom and Gomorrah that God totally destroyed (",{"href":"?bref=Deut.29.23","r":"Deut.29.23","rawR":"Deut.29.23","sourceRefs":[{"raw":"Deut.29.23","value":"Deut.29.23"}],"t":"ref","v":"Deut 29:23"},"). • In Hebrew thought, the ",{"c":["heart"],"sourceClass":"sn-excerpt","t":"span"}," is the center of the intellect and the will."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.11.8","refs":[{"book":"HOS","endChapter":11,"endVerse":8,"startChapter":11,"startVerse":8}],"sourceAttributes":{"name":"Hos.11.8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[11],"sourceItemFragmentSha256":"b346d12cfc376fa9199417f259a8108633897f37962ee4dda25dc4de14adb1e5","sourceItemName":"Hos.11.8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10964,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.11.8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.11.8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.11.9","r":"Hos.11.9","rawR":"Hos.11.9","sourceRefs":[{"raw":"Hos.11.9","value":"Hos.11.9"}],"t":"ref","v":"11:9"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["No:"],"sourceClass":"sn-excerpt","t":"span"}," The Lord alone would determine Israel’s fate. God repeated the words ",{"c":["I will not"],"sourceClass":"sn-excerpt","t":"span"}," three times, emphasizing his decision not to ",{"c":["completely destroy"],"sourceClass":"sn-excerpt","t":"span"}," his people. • The reason for the divine decision is, ",{"c":["I am the Holy One living among you"],"sourceClass":"sn-excerpt","t":"span"},". God’s holiness distinguishes him from every created thing (see “",{"href":"?item=GodsAbsoluteHoliness_ThemeNote_Filament","id":"GodsAbsoluteHoliness_ThemeNote_Filament","rawId":"GodsAbsoluteHoliness_ThemeNote_Filament","t":"link","v":"God’s Absolute Holiness"},"” Theme Note). An offended ",{"c":["mortal"],"sourceClass":"sn-excerpt","t":"span"}," might very well destroy a rebel out of pique and spite. The Holy One does not operate out of those motives."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.11.9","refs":[{"book":"HOS","endChapter":11,"endVerse":9,"startChapter":11,"startVerse":9}],"sourceAttributes":{"name":"Hos.11.9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[11],"sourceItemFragmentSha256":"8d4463033e8113723dc13b30e8b57549b9edb8edd894b98404f55de37f4e8cb8","sourceItemName":"Hos.11.9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10965,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.11.9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.11.9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.11.10-11","r":"Hos.11.10-11","rawR":"Hos.11.10-11","sourceRefs":[{"raw":"Hos.11.10-11","value":"Hos.11.10-11"}],"t":"ref","v":"11:10-11"}],"sourceClass":"sn-ref","t":"span"}," Israel’s sin would not have the final word; God, in his holy love, would ",{"c":["roar like a lion"],"sourceClass":"sn-excerpt","t":"span"}," (see ",{"href":"?bref=Amos.1.2","r":"Amos.1.2","rawR":"Amos.1.2","sourceRefs":[{"raw":"Amos.1.2","value":"Amos.1.2"}],"t":"ref","v":"Amos 1:2"},"; ",{"href":"?bref=Amos.3.8","r":"Amos.3.8","rawR":"Amos.3.8","sourceRefs":[{"raw":"Amos.3.8","value":"Amos.3.8"}],"t":"ref","v":"3:8"},") to call his people ",{"c":["home"],"sourceClass":"sn-excerpt","t":"span"}," from exile."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.11.10-11","refs":[{"book":"HOS","endChapter":11,"endVerse":11,"startChapter":11,"startVerse":10}],"sourceAttributes":{"name":"Hos.11.10-11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[11],"sourceItemFragmentSha256":"7a8929e6e81168c46bd70343dd465a4f72d6130c6bcc372cd953a2e5179c63ee","sourceItemName":"Hos.11.10-11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10966,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.11.10-11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.11.10-11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.11.12-12.14","r":"Hos.11.12-12.14","rawR":"Hos.11.12-12.14","sourceRefs":[{"raw":"Hos.11.12-12.14","value":"Hos.11.12-12.14"}],"t":"ref","v":"11:12–12:14"}],"sourceClass":"sn-ref","t":"span"}," Israel had perpetrated ",{"c":["lies and deceit"],"sourceClass":"sn-excerpt","t":"span"}," since the time of Jacob."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.11.12-12.14","refs":[{"book":"HOS","endChapter":12,"endVerse":14,"startChapter":11,"startVerse":12}],"sourceAttributes":{"name":"Hos.11.12-12.14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[11,12],"sourceItemFragmentSha256":"f0f43cec24e6e73383d09fc79d0faa3b2741ae1f429a134f1c5ebac785eba682","sourceItemName":"Hos.11.12-12.14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10967,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.11.12-12.14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.11.12-12.14","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}