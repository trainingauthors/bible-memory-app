[{"raw":"Josh.24.26-27","value":"Josh.24.26-27"}],"t":"ref","v":"Josh 24:26-27"},"), but God prohibited the Israelites from using them in worship as the Canaanites did (",{"href":"?bref=Exod.23.24","r":"Exod.23.24","rawR":"Exod.23.24","sourceRefs":[{"raw":"Exod.23.24","value":"Exod.23.24"}],"t":"ref","v":"Exod 23:24"},"; ",{"href":"?bref=Deut.16.22","r":"Deut.16.22","rawR":"Deut.16.22","sourceRefs":[{"raw":"Deut.16.22","value":"Deut.16.22"}],"t":"ref","v":"Deut 16:22"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.10.1","refs":[{"book":"HOS","endChapter":10,"endVerse":1,"startChapter":10,"startVerse":1}],"sourceAttributes":{"name":"Hos.10.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"4d253eb95a55f74a21e587f368880a10c9a5ef29b61ef8bfdf7b31bee7123366","sourceItemName":"Hos.10.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10950,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.10.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.10.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.10.3","r":"Hos.10.3","rawR":"Hos.10.3","sourceRefs":[{"raw":"Hos.10.3","value":"Hos.10.3"}],"t":"ref","v":"10:3"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["We have no king:"],"sourceClass":"sn-excerpt","t":"span"}," Some interpreters see these words as an acknowledgement, after the destruction of Israel, that they had been punished and the monarchy had come to an end because they ",{"c":["didn’t fear the"],"sourceClass":"sn-excerpt","t":"span"}," ",{"c":["Lord"],"sourceClass":"sn-excerpt-divine-name","t":"span"},". Others regard this as the Israelites’ arrogan