","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.10.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.10.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.10.5-6","r":"Hos.10.5-6","rawR":"Hos.10.5-6","sourceRefs":[{"raw":"Hos.10.5-6","value":"Hos.10.5-6"}],"t":"ref","v":"10:5-6"}],"sourceClass":"sn-ref","t":"span"}," Israel’s gold ",{"c":["calf idol"],"sourceClass":"sn-excerpt","t":"span"}," (see ",{"href":"?bref=Hos.8.5-6","r":"Hos.8.5-6","rawR":"Hos.8.5-6","sourceRefs":[{"raw":"Hos.8.5-6","value":"Hos.8.5-6"}],"t":"ref","v":"8:5-6"},") would become a prize of war for the invading Assyrians."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.10.5-6","refs":[{"book":"HOS","endChapter":10,"endVerse":6,"startChapter":10,"startVerse":5}],"sourceAttributes":{"name":"Hos.10.5-6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"87398a85f1bc34a18e6a9bc2473e2bb46073964fda8cc078d2f03e0765a808ae","sourceItemName":"Hos.10.5-6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10953,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.10.5-6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.10.5-6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.10.8","r":"Hos.10.8","rawR":"Hos.10.8","sourceRefs":[{"raw":"Hos.10.8","value":"Hos.10.8"}],"t":"ref","v":"10:8"}],"sourceClass":"sn-ref","t":"span"}," The only response of Israelites who survived the coming catastrophe would be to implore the mountains and hills, ",{"c":["“Bury us! . . . Fall on us!”"],"sourceClass":"sn-excerpt","t":"span"}],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.10.8","refs":[{"book":"HOS","endChapter":10,"endVerse":8,"startChapter":10,"startVerse":8}],"sourceAttributes":{"name":"Hos.10.8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"46bcdfb3d8679f86fb7d2307b8da2e2f33ae9b635803d8cb3c89366fffe5a1fe","sourceItemName":"Hos.10.8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10954,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.10.8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.10.8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.10.9-10","r":"Hos.10.9-10","rawR":"Hos.10.9-10","sourceRefs":[{"raw":"Hos.10.9-10","value":"Hos.10.9-10"}],"t":"ref","v":"10:9-10"}],"sourceClass":"sn-ref","t":"span"}," The horrible events at ",{"c":["Gibeah"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=Judg.19.1-21.25","r":"Judg.19.1-21.25","rawR":"Judg.19.1-21.25","sourceRefs":[{"raw":"Judg.19.1-21.25","value":"Judg.19.1-21.25"}],"t":"ref","v":"Judg 19–21"},") set the pattern of sin for the people of the northern kingdom of Israel (see ",{"href":"?bref=Hos.9.9","r":"Hos.9.9","rawR":"Hos.9.9","sourceRefs":[{"raw":"Hos.9.9","value":"Hos.9.9"}],"t":"ref","v":"Hos 9:9"},"). God’s punishment was that they would be overwhelmingly defeated in war, just as in the time of the judges (see ",{"href":"?bref=Judg.2.10-15","r":"Judg.2.10-15","rawR":"Judg.2.10-15","sourceRefs":[{"raw":"Judg.2.10-15","value":"Judg.2.10-15"}],"t":"ref","v":"Judg 2:10-15"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.10.9-10","refs":[{"book":"HOS","endChapter":10,"endVerse":10,"startChapter":10,"startVerse":9}],"sourceAttributes":{"name":"Hos.10.9-10","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"e5fe2cffc8b2671e3c0c06bff19185ece75f8d7152ee3ac86d6cd529a6621bb9","sourceItemName":"Hos.10.9-10","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10955,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.10.9-10","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.10.9-10","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.10.11","r":"Hos.10.11","rawR":"Hos.10.11","sourceRefs":[{"raw":"Hos.10.11","value":"Hos.10.11"}],"t":"ref","v":"10:11"}],"sourceClass":"sn-ref","t":"span"}," Because ",{"c":["Israel"],"sourceClass":"sn-excerpt","t":"span"}," was not faithful to the covenant, the Lord placed on her ",{"c":["a heavy yoke"],"sourceClass":"sn-excerpt","t":"span"},"—the divine correction required to bring her back to him."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.10.11","refs":[{"book":"HOS","endChapter":10,"endVerse":11,"startChapter":10,"startVerse":11}],"sourceAttributes":{"name":"Hos.10.11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"68f5139a38f6a936f7f8ca3c1d01cdae660c244b3f94466d05a1127fcf888a09","sourceItemName":"Hos.10.11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10956,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.10.11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.10.11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.10.12","r":"Hos.10.12","rawR":"Hos.10.12","sourceRefs":[{"raw":"Hos.10.12","value":"Hos.10.12"}],"t":"ref","v":"10:12"}],"sourceClass":"sn-ref","t":"span"}," Using metaphors from agriculture, God set forth his requirements for his people and a promise of blessing if they did what he commanded (see ",{"href":"?bref=Hos.6.6","r":"Hos.6.6","rawR":"Hos.6.6","sourceRefs":[{"raw":"Hos.6.6","value":"Hos.6.6"}],"t":"ref","v":"6:6"},"; ",{"href":"?bref=Hos.8.7","r":"Hos.8.7","rawR":"Hos.8.7","sourceRefs":[{"raw":"Hos.8.7","value":"Hos.8.7"}],"t":"ref","v":"8:7"},"). Even as Hosea announced God’s judgment, he offered Israel the chance to repent and receive God’s blessing."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.10.12","refs":[{"book":"HOS","endChapter":10,"endVerse":12,"startChapter":10,"startVerse":12}],"sourceAttributes":{"name":"Hos.10.12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"befb3eecd448ddfbfeebb1c881e83ca84ff03f907e9358b77b6c93a24cf2db35","sourceItemName":"Hos.10.12","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10957,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.10.12","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.10.12","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.10.14","r":"Hos.10.14","rawR":"Hos.10.14","sourceRefs":[{"raw":"Hos.10.14","value":"Hos.10.14"}],"t":"ref","v":"10:14"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["When Shalman destroyed Beth-arbel:"],"sourceClass":"sn-excerpt","t":"span"}," This event is not mentioned elsewhere in the Bible or in other available sources, but it was evidently well known to Hosea’s audience."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.10.14","refs":[{"book":"HOS","endChapter":10,"endVerse":14,"startChapter":10,"startVerse":14}],"sourceAttributes":{"name":"Hos.10.14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"617694701fc18c8d4eb18ab84bcab5d7cf2bd5d9fcdf5f59c7fc876dd478fb4d","sourceItemName":"Hos.10.14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10958,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.10.14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.10.14","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}