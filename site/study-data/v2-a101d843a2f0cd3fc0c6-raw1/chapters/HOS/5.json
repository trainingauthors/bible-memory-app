human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.5.1","r":"Hos.5.1","rawR":"Hos.5.1","sourceRefs":[{"raw":"Hos.5.1","value":"Hos.5.1"}],"t":"ref","v":"5:1"}],"sourceClass":"sn-ref","t":"span"}," Hosea again condemns the religious and political ",{"c":["leaders of Israel"],"sourceClass":"sn-excerpt","t":"span"},". They ",{"c":["have led the people into"],"sourceClass":"sn-excerpt","t":"span"}," idolatry as hunters trap wild animals in ",{"c":["a snare"],"sourceClass":"sn-excerpt","t":"span"},". • The specific sins at ",{"c":["Mizpah and Tabor"],"sourceClass":"sn-excerpt","t":"span"}," are not known."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.5.1","refs":[{"book":"HOS","endChapter":5,"endVerse":1,"startChapter":5,"startVerse":1}],"sourceAttributes":{"name":"Hos.5.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[5],"sourceItemFragmentSha256":"8296b8f29ca5f715fc3bbcec353a1a12b0f354b3db5d5c19fa3d15638b7c5403","sourceItemName":"Hos.5.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10897,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.5.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.5.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.5.2","r":"Hos.5.2","rawR":"Hos.5.2","sourceRefs":[{"raw":"Hos.5.2","value":"Hos.5.2"}],"t":"ref","v":"5:2"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["I will settle with you:"],"sourceClass":"sn-excerpt","t":"span"}," God’s judgment (Hebrew ",{"c":["musar"],"sourceClass":"hebrew","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," “discipline”) would inevitably fall upon Israel’s leaders. God did not judge Israel simply to punish them, but to correct them so that his people would return to him."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.5.2","refs":[{"book":"HOS","endChapter":5,"endVerse":2,"startChapter":5,"startVerse":2}],"sourceAttributes":{"name":"Hos.5.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[5],"sourceItemFragmentSha256":"149244b5f82f01fbf9f44296df7ec88271f699d1e916075e06e0f73691b57f18","sourceItemName":"Hos.5.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10898,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.5.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.5.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.5.3","r":"Hos.5.3","rawR":"Hos.5.3","sourceRefs":[{"raw":"Hos.5.3","value":"Hos.5.3"}],"t":"ref","v":"5:3"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["you are utterly defiled:"],"sourceClass":"sn-excerpt","t":"span"}," The word translated ",{"c":["defiled"],"sourceClass":"ital","t":"span"}," is used frequently in the Pentateuch to describe ritual uncleanness, a physical condition that disqualified a person from worshiping God in the Temple (",{"href":"?bref=Lev.11.1-15.33","r":"Lev.11.1-15.33","rawR":"Lev.11.1-15.33","sourceRefs":[{"raw":"Lev.11.1-15.33","value":"Lev.11.1-15.33"}],"t":"ref","v":"Lev 11–15"},"). The prophets used the concept as a metaphor for Israel’s moral uncleanness as the result of her idolatry (",{"href":"?bref=Isa.6.5","r":"Isa.6.5","rawR":"Isa.6.5","sourceRefs":[{"raw":"Isa.6.5","value":"Isa.6.5"}],"t":"ref","v":"Isa 6:5"},"; ",{"href":"?bref=Mic.2.10","r":"Mic.2.10","rawR":"Mic.2.10","sourceRefs":[{"raw":"Mic.2.10","value":"Mic.2.10"}],"t":"ref","v":"Mic 2:10"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.5.3","refs":[{"book":"HOS","endChapter":5,"endVerse":3,"startChapter":5,"startVerse":3}],"sourceAttributes":{"name":"Hos.5.3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[5],"sourceItemFragmentSha256":"5e75e3d51e3dfa44087fb8fd5bd728d969a55a340b0369dfb45ce41079381752","sourceItemName":"Hos.5.3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10899,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.5.3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.5.3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.5.4","r":"Hos.5.4","rawR":"Hos.5.4","sourceRefs":[{"raw":"Hos.5.4","value":"Hos.5.4"}],"t":"ref","v":"5:4"}],"sourceClass":"sn-ref","t":"span"}," Israel’s idolatrous practices were so ingrained that they were apparently powerless to ",{"c":["return"],"sourceClass":"sn-excerpt","t":"span"}," to the Lord. • ",{"c":["You are a prostitute through and through"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["the spirit of prostitution is within them"],"sourceClass":"ital","t":"span"},"): Israel’s sin was not simply a behavior; it was the nation’s essential nature. They instinctively preferred the corrupt to the pure. Only through God’s work of salvation could Israel escape."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.5.4","refs":[{"book":"HOS","endChapter":5,"endVerse":4,"startChapter":5,"startVerse":4}],"sourceAttributes":{"name":"Hos.5.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[5],"sourceItemFragmentSha256":"91d0cd664be56c8da406aadea2db9b99875c467d03a62082dc09470c5c57b3c2","sourceItemName":"Hos.5.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10900,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.5.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.5.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.5.6-7","r":"Hos.5.6-7","rawR":"Hos.5.6-7","sourceRefs":[{"raw":"Hos.5.6-7","value":"Hos.5.6-7"}],"t":"ref","v":"5:6-7"}],"sourceClass":"sn-ref","t":"span"}," The people might think that they could win God’s favor with their ",{"c":["sacrifices"],"sourceClass":"sn-excerpt","t":"span"},", but Hosea warned them that ",{"c":["they"],"sourceClass":"sn-excerpt","t":"span"}," would ",{"c":["not find him"],"sourceClass":"sn-excerpt","t":"span"},{"c":[";"],"sourceClass":"ital","t":"span"}," God had left them to the consequences of their sin."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.5.6-7","refs":[{"book":"HOS","endChapter":5,"endVerse":7,"startChapter":5,"startVerse":6}],"sourceAttributes":{"name":"Hos.5.6-7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[5],"sourceItemFragmentSha256":"3d77aa30632d77ba43167d88fb945852e74a90a33d9213704455a7e81935dc2d","sourceItemName":"Hos.5.6-7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10901,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.5.6-7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.5.6-7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.5.8-9","r":"Hos.5.8-9","rawR":"Hos.5.8-9","sourceRefs":[{"raw":"Hos.5.8-9","value":"Hos.5.8-9"}],"t":"ref","v":"5:8-9"}],"sourceClass":"sn-ref","t":"span"}," Hosea sounded the ",{"c":["alarm"],"sourceClass":"sn-excerpt","t":"span"}," to warn the Israelites of God’s coming judgment. Because of their sins, the Lord had become Israel’s enemy and would punish them. • ",{"c":["Gibeah"],"sourceClass":"sn-excerpt","t":"span"},", ",{"c":["Ramah"],"sourceClass":"sn-excerpt","t":"span"},", and ",{"c":["Beth-aven"],"sourceClass":"sn-excerpt","t":"span"}," (Bethel) are all cities in the tribal territory of ",{"c":["Benjamin"],"sourceClass":"sn-excerpt","t":"span"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.5.8-9","refs":[{"book":"HOS","endChapter":5,"endVerse":9,"startChapter":5,"startVerse":8}],"sourceAttributes":{"name":"Hos.5.8-9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[5],"sourceItemFragmentSha256":"b0479ed8a4dd0371879f8c43a918a087869d4bf1287f56acdafdc744d1f55a06","sourceItemName":"Hos.5.8-9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10902,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.5.8-9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.5.8-9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.5.10","r":"Hos.5.10","rawR":"Hos.5.10","sourceRefs":[{"raw":"Hos.5.10","value":"Hos.5.10"}],"t":"ref","v":"5:10"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["thieves"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["those who move a boundary marker"],"sourceClass":"ital","t":"span"},"): The Lord was the owner of the land, which he entrusted to the tribes following the conquest (see ",{"href":"?bref=Josh.13.8-19.51","r":"Josh.13.8-19.51","rawR":"Josh.13.8-19.51","sourceRefs":[{"raw":"Josh.13.8-19.51","value":"Josh.13.8-19.51"}],"t":"ref","v":"Josh 13:8–19:51"},"). To move a boundary marker and change God’s allotted boundaries was to steal from God (",{"href":"?bref=Deut.19.14","r":"Deut.19.14","rawR":"Deut.19.14","sourceRefs":[{"raw":"Deut.19.14","value":"Deut.19.14"}],"t":"ref","v":"Deut 19:14"},"). Such an act rightly invoked divine punishment (",{"href":"?bref=Deut.27.17","r":"Deut.27.17","rawR":"Deut.27.17","sourceRefs":[{"raw":"Deut.27.17","value":"Deut.27.17"}],"t":"ref","v":"Deut 27:17"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.5.10","refs":[{"book":"HOS","endChapter":5,"endVerse":10,"startChapter":5,"startVerse":10}],"sourceAttributes":{"name":"Hos.5.10","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[5],"sourceItemFragmentSha256":"00465c67908ee809ca58c8e5bfd476f771af54b115db261fd3f429051030bcf8","sourceItemName":"Hos.5.10","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10903,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.5.10","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.5.10","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.5.12","r":"Hos.5.12","rawR":"Hos.5.12","sourceRefs":[{"raw":"Hos.5.12","value":"Hos.5.12"}],"t":"ref","v":"5:12"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["as a moth . . . rotten wood:"],"sourceClass":"sn-excerpt","t":"span"}," Sin can destroy the very fabric and foundation of a people while leaving them unaware that the destruction has taken place."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.5.12","refs":[{"book":"HOS","endChapter":5,"endVerse":12,"startChapter":5,"startVerse":12}],"sourceAttributes":{"name":"Hos.5.12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[5],"sourceItemFragmentSha256":"c16293f5bd4e16a3cd9f2d1033b917161af5b044c9615eaf359f6f67cac9e647","sourceItemName":"Hos.5.12","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10904,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.5.12","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.5.12","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.5.13","r":"Hos.5.13","rawR":"Hos.5.13","sourceRefs":[{"raw":"Hos.5.13","value":"Hos.5.13"}],"t":"ref","v":"5:13"}],"sourceClass":"sn-ref","t":"span"}," In a final effort to avoid complete destruction, the Israelites overthrew King Pekah and placed a new king, Hoshea, on the throne. Hoshea then appealed to the Assyrian king Shalmaneser for peace (",{"href":"?bref=2Kgs.15.29-30","r":"2Kgs.15.29-30","rawR":"2Kgs.15.29-30","sourceRefs":[{"raw":"2Kgs.15.29-30","value":"2Kgs.15.29-30"}],"t":"ref","v":"2 Kgs 15:29-30"},"; ",{"href":"?bref=2Kgs.17.3","r":"2Kgs.17.3","rawR":"2Kgs.17.3","sourceRefs":[{"raw":"2Kgs.17.3","value":"2Kgs.17.3"}],"t":"ref","v":"17:3"},"), but these diplomatic maneuvers could ",{"c":["neither help nor cure"],"sourceClass":"sn-excerpt","t":"span"}," Israel—they would soon be destroyed by Assyria."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.5.13","refs":[{"book":"HOS","endChapter":5,"endVerse":13,"startChapter":5,"startVerse":13}],"sourceAttributes":{"name":"Hos.5.13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[5],"sourceItemFragmentSha256":"6298d6bcd14795e002e5667a63cafbad991a126771a8576f27fd670f98f644c9","sourceItemName":"Hos.5.13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10905,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.5.13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.5.13","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.5.15","r":"Hos.5.15","rawR":"Hos.5.15","sourceRefs":[{"raw":"Hos.5.15","value":"Hos.5.15"}],"t":"ref","v":"5:15"}],"sourceClass":"sn-ref","t":"span"}," Hosea again reminded Israel that divine judgment was not merely punitive. God’s purpose was to convince Israel to ",{"c":["admit their guilt"],"sourceClass":"sn-excerpt","t":"span"}," and return to the Lord (see ",{"href":"?bref=Hos.2.2","r":"Hos.2.2","rawR":"Hos.2.2","sourceRefs":[{"raw":"Hos.2.2","value":"Hos.2.2"}],"t":"ref","v":"2:2"},", ",{"href":"?bref=Hos.2.14","r":"Hos.2.14","rawR":"Hos.2.14","sourceRefs":[{"raw":"Hos.2.14","value":"Hos.2.14"}],"t":"ref","v":"14"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.5.15","refs":[{"book":"HOS","endChapter":5,"endVerse":15,"startChapter":5,"startVerse":15}],"sourceAttributes":{"name":"Hos.5.15","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[5],"sourceItemFragmentSha256":"a1d311aac20fc30cfb7c28834d565566cb72e648496ce8521e37e57bf7e9ddeb","sourceItemName":"Hos.5.15","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10906,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.5.15","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.5.15","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}