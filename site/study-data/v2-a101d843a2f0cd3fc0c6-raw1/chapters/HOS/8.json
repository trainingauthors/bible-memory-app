on","title":"Hosea, Book of"},"Lord":{"file":"dictionary/0a54f5caa03523157b50ef58ec814d810e7db1abd5db44ec093ece07106e3447.json","title":"Lord"},"MineralsandMetals":{"file":"dictionary/0c29c89181964b918e5a1d8bc92cdc825859b38d50c449ac9ba1147d502cc9d0.json","title":"Minerals* and Metals"},"Prophecy":{"file":"dictionary/2230864ea0e1d7a0d22e60f1cd1ca915e6b99d8360bb5574adc2415ebb961f33.json","title":"Prophecy"},"Samaria":{"file":"dictionary/cdfefce67e0ff0abc2f8d5c959f3aa8e8d8544faaf52ebb61516fa833c7f1e2f.json","title":"Samaria"},"Whirlwind":{"file":"dictionary/632583d71b62c150c762978113e187937e76325d573e573562e4303a1aaa17ab.json","title":"Whirlwind"}},"dictionaryRelated":[{"id":"Alliance","title":"Alliance"},{"id":"Animals","title":"Animals"},{"id":"Birds","title":"Birds"},{"id":"CalfGolden","title":"Calf, Golden"},{"id":"Communication","title":"Communication"},{"id":"FortFortification","title":"Fort, Fortification"},{"id":"HoseaBookof","title":"Hosea, Book of"},{"id":"MineralsandMetals","title":"Minerals* and Metals"},{"id":"Prophecy","title":"Prophecy"},{"id":"Whirlwind","title":"Whirlwind"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Put the ram’s horn to your lips! An eagle looms over the house of the LORD, because the people have transgressed My covenant and rebelled against My law.","verse":1},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Though they offer sacrifices as gifts to Me, and though they eat the meat, the LORD does not accept them. Now He will remember their iniquity and punish their sins: They will return to Egypt.","verse":13}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Samaria","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Samaria::Samaria::reviewed_unambiguous_name","sourceHeadwordId":"Samaria"},"text":"He has rejected your calf, O Samaria. My anger burns against them. How long will they be incapable of innocence?","verse":5},{"matchingRule":"reviewed_exact_headword","phrase":"Samaria","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Samaria::Samaria::reviewed_unambiguous_name","sourceHeadwordId":"Samaria"},"text":"For this thing is from Israel—a craftsman made it, and it is not God. It will be broken to pieces, that calf of Samaria.","verse":6}],"id":"Samaria","label":"Samaria","matchReviews":[{"ruleId":"Samaria::Samaria::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Samaria","term":"Samaria"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Samaria","sourceTitle":"Samaria"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.8.1","r":"Hos.8.1","rawR":"Hos.8.1","sourceRefs":[{"raw":"Hos.8.1","value":"Hos.8.1"}],"t":"ref","v":"8:1"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Sound the alarm:"],"sourceClass":"sn-excerpt","t":"span"}," The ram’s horn trumpet (",{"c":["shofar"],"sourceClass":"hebrew","t":"span"},") called the people to worship (",{"href":"?bref=Ps.98.6","r":"Ps.98.6","rawR":"Ps.98.6","sourceRefs":[{"raw":"Ps.98.6","value":"Ps.98.6"}],"t":"ref","v":"Ps 98:6"},"); it was also (as here) the signal for battle (",{"href":"?bref=2Sam.20.1","r":"2Sam.20.1","rawR":"2Sam.20.1","sourceRefs":[{"raw":"2Sam.20.1","value":"2Sam.20.1"}],"t":"ref","v":"2 Sam 20:1"},"). God was sending an ",{"c":["enemy"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," the Assyrians, to execute his judgment on Israel. • ",{"c":["revolted against my law:"],"sourceClass":"sn-excerpt","t":"span"}," God’s law (Hebrew ",{"c":["torah"],"sourceClass":"hebrew","t":"span"},") is much more than the sum of the individual laws in the Pentateuch. It represents the totality of God’s instruction to his people through his words and his deeds. Loving fulfillment of the Torah was Israel’s part of the covenant. They had broken God’s commandments, and they had turned aside from their covenant relationship with the Lord."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.8.1","refs":[{"book":"HOS","endChapter":8,"endVerse":1,"startChapter":8,"startVerse":1}],"sourceAttributes":{"name":"Hos.8.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"f9ef35fb1cca6ff0cfa53f413e7aa906ec3eea8898fa7d3762fd99e08f20f836","sourceItemName":"Hos.8.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10927,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.8.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.8.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.8.3","r":"Hos.8.3","rawR":"Hos.8.3","sourceRefs":[{"raw":"Hos.8.3","value":"Hos.8.3"}],"t":"ref","v":"8:3"}],"sourceClass":"sn-ref","t":"span"}," Jesus tells us that God alone is ",{"c":["good"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=Mark.10.18","r":"Mark.10.18","rawR":"Mark.10.18","sourceRefs":[{"raw":"Mark.10.18","value":"Mark.10.18"}],"t":"ref","v":"Mark 10:18"},"). God is the source of every good thing, yet Israel ",{"c":["rejected"],"sourceClass":"sn-excerpt","t":"span"}," him."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.8.3","refs":[{"book":"HOS","endChapter":8,"endVerse":3,"startChapter":8,"startVerse":3}],"sourceAttributes":{"name":"Hos.8.3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"e871905ed40d9ffe5904c7f8f072c684108ab39bf2932b92390b11ce8133df60","sourceItemName":"Hos.8.3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10928,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.8.3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.8.3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.8.4","r":"Hos.8.4","rawR":"Hos.8.4","sourceRefs":[{"raw":"Hos.8.4","value":"Hos.8.4"}],"t":"ref","v":"8:4"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["appointed kings without my consent:"],"sourceClass":"sn-excerpt","t":"span"}," The Israelites quickly disposed of one king and appointed another if they thought it might save their nation (see ",{"href":"?bref=Hos.7.7","r":"Hos.7.7","rawR":"Hos.7.7","sourceRefs":[{"raw":"Hos.7.7","value":"Hos.7.7"}],"t":"ref","v":"7:7"},"). They did all of this without consulting their true king, the Lord."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.8.4","refs":[{"book":"HOS","endChapter":8,"endVerse":4,"startChapter":8,"startVerse":4}],"sourceAttributes":{"name":"Hos.8.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"80500ab9ba31e3ddab6dad204a4529050decdf5a0a51ad14f7b7268d5aa27469","sourceItemName":"Hos.8.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10929,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.8.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.8.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.8.5-6","r":"Hos.8.5-6","rawR":"Hos.8.5-6","sourceRefs":[{"raw":"Hos.8.5-6","value":"Hos.8.5-6"}],"t":"ref","v":"8:5-6"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["this calf:"],"sourceClass":"sn-excerpt","t":"span"}," When Jeroboam I (931–910 ",{"c":["BC"],"sourceClass":"era","t":"span"},"), the first king of the northern kingdom of Israel, ascended the throne, he established places of worship in the cities of Dan and Bethel so that the people would not travel to the Temple in Jerusalem, the capital of the southern kingdom. At each site, he erected a gold calf for the people to worship (",{"href":"?bref=1Kgs.12.26-30","r":"1Kgs.12.26-30","rawR":"1Kgs.12.26-30","sourceRefs":[{"raw":"1Kgs.12.26-30","value":"1Kgs.12.26-30"}],"t":"ref","v":"1 Kgs 12:26-30"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.8.5-6","refs":[{"book":"HOS","endChapter":8,"endVerse":6,"startChapter":8,"startVerse":5}],"sourceAttributes":{"name":"Hos.8.5-6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"55c00d27bb5fa5232845716a0fb68c03d7d54f999eb5a48d60b7b76823977536","sourceItemName":"Hos.8.5-6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10930,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.8.5-6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.8.5-6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.8.7","r":"Hos.8.7","rawR":"Hos.8.7","sourceRefs":[{"raw":"Hos.8.7","value":"Hos.8.7"}],"t":"ref","v":"8:7"}],"sourceClass":"sn-ref","t":"span"}," When Hosea proclaimed divine judgment, the punishment fit the crime (see ",{"href":"?item=Hos.4.10_StudyNote_Filament","id":"Hos.4.10_StudyNote_Filament","rawId":"Hos.4.10_StudyNote_Filament","t":"link","v":"study note on 4:10"},"). Through their idolatry and political intrigue, the Israelites had ",{"c":["planted"],"sourceClass":"sn-excerpt","t":"span"}," the seeds of their own destruction (see ",{"href":"?bref=Gal.6.7","r":"Gal.6.7","rawR":"Gal.6.7","sourceRefs":[{"raw":"Gal.6.7","value":"Gal.6.7"}],"t":"ref","v":"Gal 6:7"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.8.7","refs":[{"book":"HOS","endChapter":8,"endVerse":7,"startChapter":8,"startVerse":7}],"sourceAttributes":{"name":"Hos.8.7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"5a76bc17bf9839c2074e24efbd5e7928304ead7b8496495999e51c1c3f5f288c","sourceItemName":"Hos.8.7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10931,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.8.7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.8.7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.8.9","r":"Hos.8.9","rawR":"Hos.8.9","sourceRefs":[{"raw":"Hos.8.9","value":"Hos.8.9"}],"t":"ref","v":"8:9"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Like a wild donkey:"],"sourceClass":"sn-excerpt","t":"span"}," Hosea compared Israel’s worship of the Canaanite fertility gods to an animal in heat that was desperate to mate (see ",{"href":"?bref=Jer.2.23-24","r":"Jer.2.23-24","rawR":"Jer.2.23-24","sourceRefs":[{"raw":"Jer.2.23-24","value":"Jer.2.23-24"}],"t":"ref","v":"Jer 2:23-24"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.8.9","refs":[{"book":"HOS","endChapter":8,"endVerse":9,"startChapter":8,"startVerse":9}],"sourceAttributes":{"name":"Hos.8.9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"28343446b1ddc55bd55218ead701c8bc35c2559096139224fdee28204f88e8a0","sourceItemName":"Hos.8.9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10932,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.8.9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.8.9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.8.10","r":"Hos.8.10","rawR":"Hos.8.10","sourceRefs":[{"raw":"Hos.8.10","value":"Hos.8.10"}],"t":"ref","v":"8:10"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["I will now gather them together:"],"sourceClass":"sn-excerpt","t":"span"}," Although God sometimes promises to gather his people for deliverance (",{"href":"?bref=Zech.10.8-10","r":"Zech.10.8-10","rawR":"Zech.10.8-10","sourceRefs":[{"raw":"Zech.10.8-10","value":"Zech.10.8-10"}],"t":"ref","v":"Zech 10:8-10"},"), here the Lord would gather them ",{"c":["for judgment"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=Joel.3.11","r":"Joel.3.11","rawR":"Joel.3.11","sourceRefs":[{"raw":"Joel.3.11","value":"Joel.3.11"}],"t":"ref","v":"Joel 3:11"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.8.10","refs":[{"book":"HOS","endChapter":8,"endVerse":10,"startChapter":8,"startVerse":10}],"sourceAttributes":{"name":"Hos.8.10","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"b07849c9c857417b4c90ad3a5b813f05d18ca9fd39529680b2766d7a82723893","sourceItemName":"Hos.8.10","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10933,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.8.10","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.8.10","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.8.11","r":"Hos.8.11","rawR":"Hos.8.11","sourceRefs":[{"raw":"Hos.8.11","value":"Hos.8.11"}],"t":"ref","v":"8:11"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Israel has built many altars:"],"sourceClass":"sn-excerpt","t":"span"}," As Israel’s idolatry increased, her religious activities increased in an attempt ",{"c":["to take away sin"],"sourceClass":"sn-excerpt","t":"span"},{"c":[";"],"sourceClass":"ital","t":"span"}," instead, these rites only increased her sin."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.8.11","refs":[{"book":"HOS","endChapter":8,"endVerse":11,"startChapter":8,"startVerse":11}],"sourceAttributes":{"name":"Hos.8.11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"4673b70838c25aef926455a4578bdd5fca1f7f1d9fab83c7cecdd40a5ee8de22","sourceItemName":"Hos.8.11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10934,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.8.11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.8.11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.8.13","r":"Hos.8.13","rawR":"Hos.8.13","sourceRefs":[{"raw":"Hos.8.13","value":"Hos.8.13"}],"t":"ref","v":"8:13"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["I do not accept their sacrifices:"],"sourceClass":"sn-excerpt","t":"span"}," See ",{"href":"?bref=Hos.6.6","r":"Hos.6.6","rawR":"Hos.6.6","sourceRefs":[{"raw":"Hos.6.6","value":"Hos.6.6"}],"t":"ref","v":"6:6"},"; ",{"href":"?bref=Isa.1.10-17","r":"Isa.1.10-17","rawR":"Isa.1.10-17","sourceRefs":[{"raw":"Isa.1.10-17","value":"Isa.1.10-17"}],"t":"ref","v":"Isa 1:10-17"},"; ",{"href":"?bref=Amos.5.21-24","r":"Amos.5.21-24","rawR":"Amos.5.21-24","sourceRefs":[{"raw":"Amos.5.21-24","value":"Amos.5.21-24"}],"t":"ref","v":"Amos 5:21-24"},"; ",{"href":"?bref=Mic.6.6-8","r":"Mic.6.6-8","rawR":"Mic.6.6-8","sourceRefs":[{"raw":"Mic.6.6-8","value":"Mic.6.6-8"}],"t":"ref","v":"Mic 6:6-8"},". • ",{"c":["They will return to Egypt,"],"sourceClass":"sn-excerpt","t":"span"}," the place of slavery (",{"href":"?bref=Deut.28.68","r":"Deut.28.68","rawR":"Deut.28.68","sourceRefs":[{"raw":"Deut.28.68","value":"Deut.28.68"}],"t":"ref","v":"Deut 28:68"},"). God’s dealings with Israel did not end with judgment. The divine purpose of judgment was to restore Israel to the status they had when they came out of Egypt, so that they could experience a new beginning (see ",{"href":"?bref=Hos.2.14-15","r":"Hos.2.14-15","rawR":"Hos.2.14-15","sourceRefs":[{"raw":"Hos.2.14-15","value":"Hos.2.14-15"}],"t":"ref","v":"Hos 2:14-15"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.8.13","refs":[{"book":"HOS","endChapter":8,"endVerse":13,"startChapter":8,"startVerse":13}],"sourceAttributes":{"name":"Hos.8.13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"3784afad016b7da0355df4afdda0eebb678894b9237d25f51c2621cdb9721191","sourceItemName":"Hos.8.13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10935,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.8.13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.8.13","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.8.14","r":"Hos.8.14","rawR":"Hos.8.14","sourceRefs":[{"raw":"Hos.8.14","value":"Hos.8.14"}],"t":"ref","v":"8:14"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Israel has forgotten its Maker:"],"sourceClass":"sn-excerpt","t":"span"}," See ",{"href":"?bref=Hos.2.13","r":"Hos.2.13","rawR":"Hos.2.13","sourceRefs":[{"raw":"Hos.2.13","value":"Hos.2.13"}],"t":"ref","v":"2:13"},". • God’s judgment is often described as ",{"c":["fire"],"sourceClass":"sn-excerpt","t":"span"}," sent upon the royal ",{"c":["palaces"],"sourceClass":"sn-excerpt","t":"span"}," and ",{"c":["fortresses"],"sourceClass":"sn-excerpt","t":"span"}," (see ",{"href":"?bref=Amos.1.4","r":"Amos.1.4","rawR":"Amos.1.4","sourceRefs":[{"raw":"Amos.1.4","value":"Amos.1.4"}],"t":"ref","v":"Amos 1:4"},", ",{"href":"?bref=Amos.1.7","r":"Amos.1.7","rawR":"Amos.1.7","sourceRefs":[{"raw":"Amos.1.7","value":"Amos.1.7"}],"t":"ref","v":"7"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.8.14","refs":[{"book":"HOS","endChapter":8,"endVerse":14,"startChapter":8,"startVerse":14}],"sourceAttributes":{"name":"Hos.8.14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"00647ed664136bd6eaad60ecbb17d78d7f652d73f5831e6d541dffe714e58ad7","sourceItemName":"Hos.8.14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10936,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.8.14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.8.14","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}