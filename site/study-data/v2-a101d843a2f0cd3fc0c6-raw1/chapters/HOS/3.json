rceClass":"sn-excerpt","t":"span"}," to him in reverential ",{"c":["awe"],"sourceClass":"sn-excerpt","t":"span"}," and recognize him alone as the source of all ",{"c":["goodness"],"sourceClass":"sn-excerpt","t":"span"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.3.5","refs":[{"book":"HOS","endChapter":3,"endVerse":5,"startChapter":3,"startVerse":5}],"sourceAttributes":{"name":"Hos.3.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"10a7f80a11b0b8eca6f8a3834daa0ef621a3689cf207c2ad5397020101eee992","sourceItemName":"Hos.3.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10884,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.3.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.3.5","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}