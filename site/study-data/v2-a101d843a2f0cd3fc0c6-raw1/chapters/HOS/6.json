dbb022f8b7aaa89f09b42d655.json","title":"Soul"},"Suffering":{"file":"dictionary/7f94c56f774a7919f892673c395c8e5d3e17a11555bcbf4808fbd29c37f95011.json","title":"Suffering"},"WrathofGod":{"file":"dictionary/07bb1fdae14b09e50a8e5023eed72e67c8b0ed68c76b86cd1334011d6c6add32.json","title":"Wrath of God"}},"dictionaryRelated":[{"id":"AdamPerson","title":"Adam (Person)"},{"id":"Dew","title":"Dew"},{"id":"EphraimPlace","title":"Ephraim (Place)"},{"id":"GileadPlace","title":"Gilead (Place)"},{"id":"HoseaBookof","title":"Hosea, Book of"},{"id":"LatterRain","title":"Latter Rain*"},{"id":"Love","title":"Love"},{"id":"NumbersandNumerology","title":"Numbers and Numerology*"},{"id":"PriestsandLevites","title":"Priests and Levites"},{"id":"Resurrection","title":"Resurrection"},{"id":"Soul","title":"Soul"},{"id":"Suffering","title":"Suffering"},{"id":"WrathofGod","title":"Wrath of God"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Come, let us return to the LORD. For He has torn us to pieces, but He will heal us; He has wounded us, but He will bind up our wounds.","verse":1},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"So let us know—let us press on to know the LORD. As surely as the sun rises, He will appear; He will come to us like the rain, like the spring showers that water the earth.","verse":3}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.6.1-3","r":"Hos.6.1-3","rawR":"Hos.6.1-3","sourceRefs":[{"raw":"Hos.6.1-3","value":"Hos.6.1-3"}],"t":"ref","v":"6:1-3"}],"sourceClass":"sn-ref","t":"span"}," In response to God’s acts of judgment on Israel, the religious leaders called the people to ",{"c":["return to the"],"sourceClass":"sn-excerpt","t":"span"}," ",{"c":["Lord"],"sourceClass":"sn-excerpt-divine-name","t":"span"}," in repentance and urged everyone to ",{"c":["know the"],"sourceClass":"sn-excerpt","t":"span"}," ",{"c":["Lord"],"sourceClass":"sn-excerpt-divine-name","t":"span"},". • The ",{"c":["rains in early spring"],"sourceClass":"sn-excerpt","t":"span"}," were essential to the agricultural cycle of the land."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.6.1-3","refs":[{"book":"HOS","endChapter":6,"endVerse":3,"startChapter":6,"startVerse":1}],"sourceAttributes":{"name":"Hos.6.1-3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[6],"sourceItemFragmentSha256":"f0b9f736cbc8b8228fb279cb7c7d61274f41fde7a68b315dffa102ce1db9e9f7","sourceItemName":"Hos.6.1-3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10907,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.6.1-3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.6.1-3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.6.4","r":"Hos.6.4","rawR":"Hos.6.4","sourceRefs":[{"raw":"Hos.6.4","value":"Hos.6.4"}],"t":"ref","v":"6:4"}],"sourceClass":"sn-ref","t":"span"}," The response of ",{"c":["Israel"],"sourceClass":"sn-excerpt","t":"span"}," was inadequate; God lamented that their ",{"c":["love"],"sourceClass":"sn-excerpt","t":"span"}," disappeared like ",{"c":["morning mist"],"sourceClass":"sn-excerpt","t":"span"}," and ",{"c":["dew"],"sourceClass":"sn-excerpt","t":"span"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.6.4","refs":[{"book":"HOS","endChapter":6,"endVerse":4,"startChapter":6,"startVerse":4}],"sourceAttributes":{"name":"Hos.6.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[6],"sourceItemFragmentSha256":"cc165d777ab6b3db8f5443c75c7cf34855f7b7b01ec3791a2bc344477842462c","sourceItemName":"Hos.6.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10908,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.6.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.6.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.6.6","r":"Hos.6.6","rawR":"Hos.6.6","sourceRefs":[{"raw":"Hos.6.6","value":"Hos.6.6"}],"t":"ref","v":"6:6"}],"sourceClass":"sn-ref","t":"span"}," In one of Hosea’s key verses, God names the most important qualities that should characterize the Israelites’ covenant lives with him. First, the Lord wants his people ",{"c":["to show love"],"sourceClass":"sn-excerpt","t":"span"}," more than he wants ",{"c":["sacrifices"],"sourceClass":"sn-excerpt","t":"span"},". Love (Hebrew ",{"c":["khesed"],"sourceClass":"hebrew","t":"span"},") includes faithfulness (see ",{"href":"?bref=Hos.4.1","r":"Hos.4.1","rawR":"Hos.4.1","sourceRefs":[{"raw":"Hos.4.1","value":"Hos.4.1"}],"t":"ref","v":"4:1"},"; ",{"href":"?bref=Hos.6.4","r":"Hos.6.4","rawR":"Hos.6.4","sourceRefs":[{"raw":"Hos.6.4","value":"Hos.6.4"}],"t":"ref","v":"6:4"},"). God is always faithful (",{"href":"?bref=Ps.136.1-26","r":"Ps.136.1-26","rawR":"Ps.136.1-26","sourceRefs":[{"raw":"Ps.136.1-26","value":"Ps.136.1-26"}],"t":"ref","v":"Ps 136"},"), and he requires the same of his people. Second, the Lord wants Israel ",{"c":["to know"],"sourceClass":"sn-excerpt","t":"span"}," him more than he wants ",{"c":["burnt offerings"],"sourceClass":"sn-excerpt","t":"span"},". Knowing God is much more than simply knowing facts about God (see “",{"href":"?item=KnowingGod_ThemeNote_Filament","id":"KnowingGod_ThemeNote_Filament","rawId":"KnowingGod_ThemeNote_Filament","t":"link","v":"Knowing God"},"” Theme Note). An intimate personal relationship with God is characterized by complete trust and integrity. Sacrifice still had a proper place in Israelite religion, but only when it was offered by a people who truly knew and loved God (see ",{"href":"?bref=Isa.1.10-17","r":"Isa.1.10-17","rawR":"Isa.1.10-17","sourceRefs":[{"raw":"Isa.1.10-17","value":"Isa.1.10-17"}],"t":"ref","v":"Isa 1:10-17"},"; ",{"href":"?bref=Amos.5.21-24","r":"Amos.5.21-24","rawR":"Amos.5.21-24","sourceRefs":[{"raw":"Amos.5.21-24","value":"Amos.5.21-24"}],"t":"ref","v":"Amos 5:21-24"},"; ",{"href":"?bref=Mic.6.6-8","r":"Mic.6.6-8","rawR":"Mic.6.6-8","sourceRefs":[{"raw":"Mic.6.6-8","value":"Mic.6.6-8"}],"t":"ref","v":"Mic 6:6-8"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.6.6","refs":[{"book":"HOS","endChapter":6,"endVerse":6,"startChapter":6,"startVerse":6}],"sourceAttributes":{"name":"Hos.6.6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[6],"sourceItemFragmentSha256":"c21a2946742a6701c3ac2feeb280dada53f6eef14ff7ac3e9a176783756e569d","sourceItemName":"Hos.6.6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10909,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.6.6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.6.6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.6.7-11","r":"Hos.6.7-11","rawR":"Hos.6.7-11","sourceRefs":[{"raw":"Hos.6.7-11","value":"Hos.6.7-11"}],"t":"ref","v":"6:7-11"}],"sourceClass":"sn-ref","t":"span"}," Hosea traces the way that human rebellion against God began with Adam and spread through the cities of Israel to the land of Judah."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.6.7-11","refs":[{"book":"HOS","endChapter":6,"endVerse":11,"startChapter":6,"startVerse":7}],"sourceAttributes":{"name":"Hos.6.7-11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[6],"sourceItemFragmentSha256":"a601248379a2af767a81a13eee09f266d5f24d674b1a2684c497cca8c41ca51d","sourceItemName":"Hos.6.7-11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10910,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.6.7-11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.6.7-11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.6.9","r":"Hos.6.9","rawR":"Hos.6.9","sourceRefs":[{"raw":"Hos.6.9","value":"Hos.6.9"}],"t":"ref","v":"6:9"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Priests form bands of robbers:"],"sourceClass":"sn-excerpt","t":"span"}," Hosea again condemns the religious leaders for their crimes (see ",{"href":"?bref=Hos.4.4-8","r":"Hos.4.4-8","rawR":"Hos.4.4-8","sourceRefs":[{"raw":"Hos.4.4-8","value":"Hos.4.4-8"}],"t":"ref","v":"4:4-8"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.6.9","refs":[{"book":"HOS","endChapter":6,"endVerse":9,"startChapter":6,"startVerse":9}],"sourceAttributes":{"name":"Hos.6.9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[6],"sourceItemFragmentSha256":"b5f50cb3106e12cc441592739658f7d39bd04f0891a3a226c1cc0509211c24e4","sourceItemName":"Hos.6.9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10911,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.6.9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.6.9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.6.10","r":"Hos.6.10","rawR":"Hos.6.10","sourceRefs":[{"raw":"Hos.6.10","value":"Hos.6.10"}],"t":"ref","v":"6:10"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["something horrible:"],"sourceClass":"sn-excerpt","t":"span"}," The prophet uses this rare word (also in ",{"href":"?bref=Jer.18.13","r":"Jer.18.13","rawR":"Jer.18.13","sourceRefs":[{"raw":"Jer.18.13","value":"Jer.18.13"}],"t":"ref","v":"Jer 18:13"},") to describe the depth of Israel’s sin in breaking God’s covenant and betraying his trust."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.6.10","refs":[{"book":"HOS","endChapter":6,"endVerse":10,"startChapter":6,"startVerse":10}],"sourceAttributes":{"name":"Hos.6.10","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[6],"sourceItemFragmentSha256":"4532798cc6a0d5b34eadd837915910bdceffd145bab7f7b427d980cc593cdf5a","sourceItemName":"Hos.6.10","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10912,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.6.10","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.6.10","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}