enseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":5,"href":"?bref=Hos.1.1-3.5","rawReference":"Hos.1.1-3.5"}],"ruleId":"Gomer::Gomer::source_verse_citation","sourceHeadwordId":"Gomer"},"text":"Gomer again conceived and gave birth to a daughter, and the LORD said to Hosea, “Name her Lo-ruhamah, for I will no longer have compassion on the house of Israel, that I should ever forgive them.","verse":6},{"matchingRule":"reviewed_exact_headword","phrase":"Gomer","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":5,"href":"?bref=Hos.1.1-3.5","rawReference":"Hos.1.1-3.5"}],"ruleId":"Gomer::Gomer::source_verse_citation","sourceHeadwordId":"Gomer"},"text":"After she had weaned Lo-ruhamah, Gomer conceived and gave birth to a son.","verse":8}],"id":"Gomer","label":"Gomer","matchReviews":[{"ruleId":"Gomer::Gomer::source_verse_citation","scope":"source_verse_citation","senseReview":"Original complete headword and source opening identify a named person, people, or place. Promotion requires a capitalized whole name and the original article explicitly citing this same BSB verse. No arbitrary qualifier stripping or book-title inference. This citation-constrained rule was reviewed once globally; unmatched contexts remain excluded.","sourceHeadwordId":"Gomer","term":"Gomer"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Gomer","sourceTitle":"Gomer"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Hezekiah","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Hezekiah::Hezekiah::reviewed_unambiguous_name","sourceHeadwordId":"Hezekiah"},"text":"This is the word of the LORD that came to Hosea son of Beeri in the days of Uzziah, Jotham, Ahaz, and Hezekiah, kings of Judah, and of Jeroboam son of Jehoash, king of Israel.","verse":1}],"id":"Hezekiah","label":"Hezekiah","matchReviews":[{"ruleId":"Hezekiah::Hezekiah::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Hezekiah","term":"Hezekiah"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Hezekiah","sourceTitle":"Hezekiah"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Jehu","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":23,"href":"?bref=Hos.1.4","rawReference":"Hos.1.4"}],"ruleId":"Jehu::Jehu::source_verse_citation","sourceHeadwordId":"Jehu"},"text":"Then the LORD said to Hosea, “Name him Jezreel, for soon I will bring the bloodshed of Jezreel upon the house of Jehu, and I will put an end to the kingdom of Israel.","verse":4}],"id":"Jehu","label":"Jehu","matchReviews":[{"ruleId":"Jehu::Jehu::source_verse_citation","scope":"source_verse_citation","senseReview":"Original complete headword and source opening identify a named person, people, or place. Promotion requires a capitalized whole name and the original article explicitly citing this same BSB verse. No arbitrary qualifier stripping or book-title inference. This citation-constrained rule was reviewed once globally; unmatched contexts remain excluded.","sourceHeadwordId":"Jehu","term":"Jehu"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Jehu","sourceTitle":"Jehu"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"This is the word of the LORD that came to Hosea son of Beeri in the days of Uzziah, Jotham, Ahaz, and Hezekiah, kings of Judah, and of Jeroboam son of Jehoash, king of Israel.","verse":1},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"When the LORD first spoke through Hosea, He told him, “Go, take a prostitute as your wife and have children of adultery, because this land is flagrantly prostituting itself by departing from the LORD.”","verse":2},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Then the LORD said to Hosea, “Name him Jezreel, for soon I will bring the bloodshed of Jezreel upon the house of Jehu, and I will put an end to the kingdom of Israel.","verse":4},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Gomer again conceived and gave birth to a daughter, and the LORD said to Hosea, “Name her Lo-ruhamah, for I will no longer have compassion on the house of Israel, that I should ever forgive them.","verse":6},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Yet I will have compassion on the house of Judah, and I will save them—not by bow or sword or war, not by horses and cavalry, but by the LORD their God.”","verse":7},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"And the LORD said, “Name him Lo-ammi, for you are not My people, and I am not your God.","verse":9}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.1.1","r":"Hos.1.1","rawR":"Hos.1.1","sourceRefs":[{"raw":"Hos.1.1","value":"Hos.1.1"}],"t":"ref","v":"1:1"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["The"],"sourceClass":"sn-excerpt","t":"span"}," ",{"c":["Lord"],"sourceClass":"sn-excerpt-divine-name","t":"span"},{"c":[" gave this message:"],"sourceClass":"sn-excerpt","t":"span"}," The book of Hosea begins by declaring that these are not merely human words but a message from the only true God (cp. ",{"href":"?bref=Joel.1.1","r":"Joel.1.1","rawR":"Joel.1.1","sourceRefs":[{"raw":"Joel.1.1","value":"Joel.1.1"}],"t":"ref","v":"Joel 1:1"},"; ",{"href":"?bref=Mic.1.1","r":"Mic.1.1","rawR":"Mic.1.1","sourceRefs":[{"raw":"Mic.1.1","value":"Mic.1.1"}],"t":"ref","v":"Mic 1:1"},"; ",{"href":"?bref=Zeph.1.1","r":"Zeph.1.1","rawR":"Zeph.1.1","sourceRefs":[{"raw":"Zeph.1.1","value":"Zeph.1.1"}],"t":"ref","v":"Zeph 1:1"},"). • ",{"c":["Hosea son of Beeri:"],"sourceClass":"sn-excerpt","t":"span"}," Several other important people in the Old Testament are also named Hosea (or Hoshea; both are spelled the same in Hebrew; ",{"href":"?bref=Num.13.8","r":"Num.13.8","rawR":"Num.13.8","sourceRefs":[{"raw":"Num.13.8","value":"Num.13.8"}],"t":"ref","v":"Num 13:8"},"; ",{"href":"?bref=2Kgs.17.1","r":"2Kgs.17.1","rawR":"2Kgs.17.1","sourceRefs":[{"raw":"2Kgs.17.1","value":"2Kgs.17.1"}],"t":"ref","v":"2 Kgs 17:1"},"). Hosea means “the Lord saves,” an appropriate name for this prophet. • ",{"c":["Jeroboam . . . king of Israel:"],"sourceClass":"sn-excerpt","t":"span"}," Hosea prophesied to the northern kingdom of Israel during the reigns of its last seven kings, though only one of them, Jeroboam II, is listed here (see ",{"href":"?item=Hos_BookIntro_Filament","id":"Hos_BookIntro_Filament","rawId":"Hos_BookIntro_Filament","t":"link","v":"Hosea Book Introduction"},", “Setting”)."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.1.1","refs":[{"book":"HOS","endChapter":1,"endVerse":1,"startChapter":1,"startVerse":1}],"sourceAttributes":{"name":"Hos.1.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"b763f792bc91bdeb12c220c4cca9bc7f90b206cf719c4bf1ee7d2666cafd4f2a","sourceItemName":"Hos.1.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10854,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.1.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.1.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.1.2-3.5","r":"Hos.1.2-3.5","rawR":"Hos.1.2-3.5","sourceRefs":[{"raw":"Hos.1.2-3.5","value":"Hos.1.2-3.5"}],"t":"ref","v":"1:2–3:5"}],"sourceClass":"sn-ref","t":"span"}," This section describes a small segment of the prophet’s life, focusing on his unhappy marriage and illuminating God’s painful relationship with Israel, his chosen people."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.1.2-3.5","refs":[{"book":"HOS","endChapter":3,"endVerse":5,"startChapter":1,"startVerse":2}],"sourceAttributes":{"name":"Hos.1.2-3.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[1,2,3],"sourceItemFragmentSha256":"fae56bbeb43f6e4e0a21d3d3d99a4d66ca3c5d340c3b67f9acbe9d06244c53d0","sourceItemName":"Hos.1.2-3.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10855,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.1.2-3.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.1.2-3.5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.1.2-3","r":"Hos.1.2-3","rawR":"Hos.1.2-3","sourceRefs":[{"raw":"Hos.1.2-3","value":"Hos.1.2-3"}],"t":"ref","v":"1:2-3"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["a prostitute:"],"sourceClass":"sn-excerpt","t":"span"}," Some have found it impossible to believe that God would command a prophet to marry a prostitute. As a result, there is a long tradition of interpreting this passage symbolically. Many in the early church believed that the marriage did not actually take place. They thought that this passage was an allegory in which Hosea represented the Lord and Gomer represented Israel. Today, most interpreters regard the marriage as a real one, but they differ in their ideas about Gomer’s occupation prior to the marriage. Some suggest that Gomer was an ordinary prostitute, while others suggest that she was one of the sacred prostitutes involved in Canaanite fertility worship. Another possibility is that Gomer was a young woman who had not previously participated in illicit sexual activity, but whom God knew to be predisposed toward adultery and prostitution."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.1.2-3","refs":[{"book":"HOS","endChapter":1,"endVerse":3,"startChapter":1,"startVerse":2}],"sourceAttributes":{"name":"Hos.1.2-3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"dd6a1a01c034cecb7e903f1fdeedff64d6a2f0ff4ca8930ecbb0948ca67b8427","sourceItemName":"Hos.1.2-3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10856,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.1.2-3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.1.2-3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.1.4","r":"Hos.1.4","rawR":"Hos.1.4","sourceRefs":[{"raw":"Hos.1.4","value":"Hos.1.4"}],"t":"ref","v":"1:4"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Jezreel"],"sourceClass":"sn-excerpt","t":"span"}," is a fertile valley in north central Israel. • ",{"c":["The murders"],"sourceClass":"sn-excerpt","t":"span"}," Jehu ",{"c":["committed at Jezreel"],"sourceClass":"sn-excerpt","t":"span"}," are described in ",{"href":"?bref=2Kgs.9.1-10.36","r":"2Kgs.9.1-10.36","rawR":"2Kgs.9.1-10.36","sourceRefs":[{"raw":"2Kgs.9.1-10.36","value":"2Kgs.9.1-10.36"}],"t":"ref","v":"2 Kgs 9–10"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.1.4","refs":[{"book":"HOS","endChapter":1,"endVerse":4,"startChapter":1,"startVerse":4}],"sourceAttributes":{"name":"Hos.1.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"cc704995d051340c76fa79f401928ac02205c291521691c5889a9a5181a0e524","sourceItemName":"Hos.1.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10857,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.1.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.1.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.1.5","r":"Hos.1.5","rawR":"Hos.1.5","sourceRefs":[{"raw":"Hos.1.5","value":"Hos.1.5"}],"t":"ref","v":"1:5"}],"sourceClass":"sn-ref","t":"span"}," King Tiglath-pileser III of Assyria fulfilled this prophecy in 733 ",{"c":["BC"],"sourceClass":"era","t":"span"}," when he defeated Israelite forces and captured the Valley of Jezreel."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.1.5","refs":[{"book":"HOS","endChapter":1,"endVerse":5,"startChapter":1,"startVerse":5}],"sourceAttributes":{"name":"Hos.1.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"da53508fb2ac6b49c0a47af78514aafd05fe8de084fc5b23e0c73a77b3a81419","sourceItemName":"Hos.1.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10858,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.1.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.1.5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.1.6","r":"Hos.1.6","rawR":"Hos.1.6","sourceRefs":[{"raw":"Hos.1.6","value":"Hos.1.6"}],"t":"ref","v":"1:6"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Lo-ruhamah:"],"sourceClass":"sn-excerpt","t":"span"}," The names of Hosea’s children were part of his prophetic message (cp. ",{"href":"?bref=Isa.7.10-8.8","r":"Isa.7.10-8.8","rawR":"Isa.7.10-8.8","sourceRefs":[{"raw":"Isa.7.10-8.8","value":"Isa.7.10-8.8"}],"t":"ref","v":"Isa 7:10–8:8"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.1.6","refs":[{"book":"HOS","endChapter":1,"endVerse":6,"startChapter":1,"startVerse":6}],"sourceAttributes":{"name":"Hos.1.6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"54536fa897d59606ffb03c40e52a3104df10da56edf7f7a412e9eb1c80f9c58f","sourceItemName":"Hos.1.6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10859,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.1.6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.1.6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.1.7","r":"Hos.1.7","rawR":"Hos.1.7","sourceRefs":[{"raw":"Hos.1.7","value":"Hos.1.7"}],"t":"ref","v":"1:7"}],"sourceClass":"sn-ref","t":"span"}," For many years, the kingdom of Israel had depended upon its ",{"c":["armies"],"sourceClass":"sn-excerpt","t":"span"}," and ",{"c":["horses and charioteers"],"sourceClass":"sn-excerpt","t":"span"}," for security, but its confidence was completely misplaced. Safety and security are only to be found in God’s ",{"c":["power as the"],"sourceClass":"sn-excerpt","t":"span"}," ",{"c":["Lord"],"sourceClass":"sn-excerpt-divine-name","t":"span"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.1.7","refs":[{"book":"HOS","endChapter":1,"endVerse":7,"startChapter":1,"startVerse":7}],"sourceAttributes":{"name":"Hos.1.7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"ff810cfe183d11396bb79f8aaa6e1338d0ff9c727c6d438d661178cbdeaf6265","sourceItemName":"Hos.1.7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10860,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.1.7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.1.7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.1.9","r":"Hos.1.9","rawR":"Hos.1.9","sourceRefs":[{"raw":"Hos.1.9","value":"Hos.1.9"}],"t":"ref","v":"1:9"}],"sourceClass":"sn-ref","t":"span"}," The name ",{"c":["Lo-ammi"],"sourceClass":"sn-excerpt","t":"span"}," carries the harshest judgment of all, because it seems to announce the end of Israel’s covenant relationship with the Lord. The cherished title ",{"c":["my people"],"sourceClass":"sn-excerpt","t":"span"},"—bestowed upon Israel when they lived obediently in covenant with the Lord their God (",{"href":"?bref=Lev.26.12","r":"Lev.26.12","rawR":"Lev.26.12","sourceRefs":[{"raw":"Lev.26.12","value":"Lev.26.12"}],"t":"ref","v":"Lev 26:12"},"; see also ",{"href":"?bref=Exod.6.7","r":"Exod.6.7","rawR":"Exod.6.7","sourceRefs":[{"raw":"Exod.6.7","value":"Exod.6.7"}],"t":"ref","v":"Exod 6:7"},")—was now withdrawn due to their blatant unfaithfulness. • ",{"c":["I am not their God:"],"sourceClass":"sn-excerpt","t":"span"}," The Hebrew behind this declaration can be translated ",{"c":["I am not ‘"],"sourceClass":"ital","t":"span"},{"c":["I Am"],"sourceClass":"divine-name-ital","t":"span"},{"c":["’ for you"],"sourceClass":"ital","t":"span"}," (cp. ",{"href":"?bref=Exod.3.14","r":"Exod.3.14","rawR":"Exod.3.14","sourceRefs":[{"raw":"Exod.3.14","value":"Exod.3.14"}],"t":"ref","v":"Exod 3:14"},"). The third child’s name prophetically announces that the Israelites stand outside the covenant and are no longer privileged to call upon the ",{"c":["I Am"],"sourceClass":"divine-name-ital","t":"span"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.1.9","refs":[{"book":"HOS","endChapter":1,"endVerse":9,"startChapter":1,"startVerse":9}],"sourceAttributes":{"name":"Hos.1.9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"a3bb5bd6528b71256956d0e5152202e25f87917574ce712159a7c074aac06445","sourceItemName":"Hos.1.9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10861,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.1.9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.1.9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.1.10-11","r":"Hos.1.10-11","rawR":"Hos.1.10-11","sourceRefs":[{"raw":"Hos.1.10-11","value":"Hos.1.10-11"}],"t":"ref","v":"1:10-11"}],"sourceClass":"sn-ref","t":"span"}," These verses mark an abrupt shift in Hosea’s prophecy from judgment to hope. In the next three verses, Hosea transforms the names of Gomer’s three children from names of divine punishment on Israel into names of blessing and hope. This dramatically demonstrates God’s sovereign power of reversal from darkness to light, judgment to hope, and even death to life."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.1.10-11","refs":[{"book":"HOS","endChapter":1,"endVerse":11,"startChapter":1,"startVerse":10}],"sourceAttributes":{"name":"Hos.1.10-11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"c992e121fd1640dea24b41a9060eab7035e78cb0d46b925698d9ed434501efab","sourceItemName":"Hos.1.10-11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10862,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.1.10-11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.1.10-11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.1.10","r":"Hos.1.10","rawR":"Hos.1.10","sourceRefs":[{"raw":"Hos.1.10","value":"Hos.1.10"}],"t":"ref","v":"1:10"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["sands of the seashore:"],"sourceClass":"sn-excerpt","t":"span"}," This promise of future population growth for God’s people echoes the promise given to the patriarchs Abraham and Jacob (",{"href":"?bref=Gen.22.17","r":"Gen.22.17","rawR":"Gen.22.17","sourceRefs":[{"raw":"Gen.22.17","value":"Gen.22.17"}],"t":"ref","v":"Gen 22:17"},"; ",{"href":"?bref=Gen.32.12","r":"Gen.32.12","rawR":"Gen.32.12","sourceRefs":[{"raw":"Gen.32.12","value":"Gen.32.12"}],"t":"ref","v":"32:12"},"). • ",{"c":["You are children of the living God:"],"sourceClass":"sn-excerpt","t":"span"}," This expression is found nowhere else in the Old Testament, but Paul quoted this verse (",{"href":"?bref=Rom.9.26","r":"Rom.9.26","rawR":"Rom.9.26","sourceRefs":[{"raw":"Rom.9.26","value":"Rom.9.26"}],"t":"ref","v":"Rom 9:26"},") to establish that God had also called the Gentiles to salvation."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.1.10","refs":[{"book":"HOS","endChapter":1,"endVerse":10,"startChapter":1,"startVerse":10}],"sourceAttributes":{"name":"Hos.1.10","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"ecedff467124ad2835755483584fe1dafea6639c21e96209f69e40c004f192e9","sourceItemName":"Hos.1.10","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10863,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.1.10","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.1.10","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.1.11","r":"Hos.1.11","rawR":"Hos.1.11","sourceRefs":[{"raw":"Hos.1.11","value":"Hos.1.11"}],"t":"ref","v":"1:11"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Judah and Israel will unite together:"],"sourceClass":"sn-excerpt","t":"span"}," For almost 200 years, Israel and Judah had been divided into separate kingdoms by political rivalry. When God restores his people, he will reunite the divided kingdoms under a single leader as in the time of David, and he will reverse the curse of exile (see also ",{"href":"?bref=Ezek.37.15-28","r":"Ezek.37.15-28","rawR":"Ezek.37.15-28","sourceRefs":[{"raw":"Ezek.37.15-28","value":"Ezek.37.15-28"}],"t":"ref","v":"Ezek 37:15-28"},"). • ",{"c":["The day of Jezreel:"],"sourceClass":"sn-excerpt","t":"span"}," Hosea announced that in a coming time, God would restore the original meaning of Jezreel. It would signify blessing and growth rather than judgment."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.1.11","refs":[{"book":"HOS","endChapter":1,"endVerse":11,"startChapter":1,"startVerse":11}],"sourceAttributes":{"name":"Hos.1.11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"85f0b38cf4e9e2fdf189ada136c490d642ac8c4a983309b13ac804521e7c477a","sourceItemName":"Hos.1.11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10864,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.1.11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.1.11","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}