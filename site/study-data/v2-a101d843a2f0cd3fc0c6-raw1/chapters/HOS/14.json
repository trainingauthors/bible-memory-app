:"1PE","chapter":2,"verses":[7,8]}]}],"verse":9}],"dictionaryArticles":{"Branch":{"file":"dictionary/36a6e51622d385188b1764f10f49b7f9f6173384250fe265473a62e63bc4f7e6.json","title":"Branch"},"Conversion":{"file":"dictionary/b3f43f11b38b5efc3ea36ab7eba9947412d18be8bbca164dea77bd5c4f20b9f8.json","title":"Conversion"},"Dew":{"file":"dictionary/8f003bf39e38bd756bd8450c70e6daa3245afd0b7ddee3ce6f76321e7effc4c2.json","title":"Dew"},"HoseaBookof":{"file":"dictionary/c1a4487378a2e23f1817cccce8b02d9e8b35a77c379502de5ad72d0d73910c65.json","title":"Hosea, Book of"},"Lord":{"file":"dictionary/0a54f5caa03523157b50ef58ec814d810e7db1abd5db44ec093ece07106e3447.json","title":"Lord"},"Orphan":{"file":"dictionary/577cb9aa1c7446c420768ec6107b1e9bd9c464ffb51d1fb1219b39f6d3f2ad47.json","title":"Orphan"},"Plants":{"file":"dictionary/4577249ac9b7773d00fd8bc627ee1383687474dfdb93b77f98c93d99e4ce0612.json","title":"Plants"},"Prophecy":{"file":"dictionary/2230864ea0e1d7a0d22e60f1cd1ca915e6b99d8360bb5574adc2415ebb961f33.json","title":"Prophecy"}},"dictionaryRelated":[{"id":"Branch","title":"Branch"},{"id":"Conversion","title":"Conversion"},{"id":"Dew","title":"Dew"},{"id":"HoseaBookof","title":"Hosea, Book of"},{"id":"Orphan","title":"Orphan"},{"id":"Plants","title":"Plants"},{"id":"Prophecy","title":"Prophecy"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Return, O Israel, to the LORD your God, for you have stumbled by your iniquity.","verse":1},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Bring your confessions and return to the LORD. Say to Him: “Take away all our iniquity and receive us graciously, that we may present the fruit of our lips.","verse":2},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Whoever is wise, let him understand these things; whoever is discerning, let him know them. For the ways of the LORD are right, and the righteous walk in them but the rebellious stumble in them.","verse":9}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.14.1-9","r":"Hos.14.1-9","rawR":"Hos.14.1-9","sourceRefs":[{"raw":"Hos.14.1-9","value":"Hos.14.1-9"}],"t":"ref","v":"14:1-9"}],"sourceClass":"sn-ref","t":"span"}," Destruction was not God’s last word to his covenant people. Although judgment must come, God’s healing, restoring grace is always more powerful than human sin."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.14.1-9","refs":[{"book":"HOS","endChapter":14,"endVerse":9,"startChapter":14,"startVerse":1}],"sourceAttributes":{"name":"Hos.14.1-9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[14],"sourceItemFragmentSha256":"03b26ed2b669918b56256f6e15704538a9153c46b142601da3fe3bf38a3fd9f2","sourceItemName":"Hos.14.1-9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10989,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.14.1-9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.14.1-9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.14.2-3","r":"Hos.14.2-3","rawR":"Hos.14.2-3","sourceRefs":[{"raw":"Hos.14.2-3","value":"Hos.14.2-3"}],"t":"ref","v":"14:2-3"}],"sourceClass":"sn-ref","t":"span"}," Hosea composed a model prayer of confession to help his people return to the Lord. God’s prophets not only identified with God in his outrage over Israel’s rebellion; they also identified with the people in their broken condition (see also ",{"href":"?bref=Dan.9.4-19","r":"Dan.9.4-19","rawR":"Dan.9.4-19","sourceRefs":[{"raw":"Dan.9.4-19","value":"Dan.9.4-19"}],"t":"ref","v":"Dan 9:4-19"},"). • ",{"c":["Forgive all our sins:"],"sourceClass":"sn-excerpt","t":"span"}," The Israelites should throw themselves upon God’s mercy and grace, freely acknowledging their many sins. • ",{"c":["so that we may offer you our praises:"],"sourceClass":"sn-excerpt","t":"span"}," Israel’s inclination was to offer animal sacrifices for sin, but the Lord had made it clear that sacrifices were not the solution (see ",{"href":"?bref=Hos.6.6","r":"Hos.6.6","rawR":"Hos.6.6","sourceRefs":[{"raw":"Hos.6.6","value":"Hos.6.6"}],"t":"ref","v":"Hos 6:6"},"). Israel should offer God genuine repentance."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.14.2-3","refs":[{"book":"HOS","endChapter":14,"endVerse":3,"startChapter":14,"startVerse":2}],"sourceAttributes":{"name":"Hos.14.2-3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[14],"sourceItemFragmentSha256":"519257d66fad63919c92870d4f7bf8762c313bb76160442dc3ee498cc7461935","sourceItemName":"Hos.14.2-3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10990,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.14.2-3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.14.2-3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.14.3","r":"Hos.14.3","rawR":"Hos.14.3","sourceRefs":[{"raw":"Hos.14.3","value":"Hos.14.3"}],"t":"ref","v":"14:3"}],"sourceClass":"sn-ref","t":"span"}," The Israelites must renounce their dependence upon ",{"c":["idols"],"sourceClass":"sn-excerpt","t":"span"},", foreign alliances, and their own military strength. Although they were God’s own children (",{"href":"?bref=Hos.11.1","r":"Hos.11.1","rawR":"Hos.11.1","sourceRefs":[{"raw":"Hos.11.1","value":"Hos.11.1"}],"t":"ref","v":"11:1"},"), they made themselves ",{"c":["orphans"],"sourceClass":"sn-excerpt","t":"span"}," through their rebellion. When they sincerely and completely repented, they could again ",{"c":["find mercy"],"sourceClass":"sn-excerpt","t":"span"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.14.3","refs":[{"book":"HOS","endChapter":14,"endVerse":3,"startChapter":14,"startVerse":3}],"sourceAttributes":{"name":"Hos.14.3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[14],"sourceItemFragmentSha256":"574041f77f76e0602a0e105145fc7fb9076241aad9a132b086b1042055e6a645","sourceItemName":"Hos.14.3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10991,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.14.3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.14.3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.14.4","r":"Hos.14.4","rawR":"Hos.14.4","sourceRefs":[{"raw":"Hos.14.4","value":"Hos.14.4"}],"t":"ref","v":"14:4"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Then I will heal you:"],"sourceClass":"sn-excerpt","t":"span"}," Healing by God is the only solution for the disease of sin. The Lord heals all our diseases, both physical and spiritual (",{"href":"?bref=Ps.103.3","r":"Ps.103.3","rawR":"Ps.103.3","sourceRefs":[{"raw":"Ps.103.3","value":"Ps.103.3"}],"t":"ref","v":"Ps 103:3"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.14.4","refs":[{"book":"HOS","endChapter":14,"endVerse":4,"startChapter":14,"startVerse":4}],"sourceAttributes":{"name":"Hos.14.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[14],"sourceItemFragmentSha256":"2db18048013bdd92e9444d415c7f16bbfffe609569c5a3da7da1ab331161d724","sourceItemName":"Hos.14.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10992,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.14.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.14.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.14.5-7","r":"Hos.14.5-7","rawR":"Hos.14.5-7","sourceRefs":[{"raw":"Hos.14.5-7","value":"Hos.14.5-7"}],"t":"ref","v":"14:5-7"}],"sourceClass":"sn-ref","t":"span"}," Hosea describes the effect of God’s healing love on repentant Israel. God promises to provide the fertility that Israel had sought from the baals."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.14.5-7","refs":[{"book":"HOS","endChapter":14,"endVerse":7,"startChapter":14,"startVerse":5}],"sourceAttributes":{"name":"Hos.14.5-7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[14],"sourceItemFragmentSha256":"9b09812a7d6df6e55cec1608e94c4281d73087c812d443480e11a185d8c5a5e9","sourceItemName":"Hos.14.5-7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10993,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.14.5-7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.14.5-7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.14.5","r":"Hos.14.5","rawR":"Hos.14.5","sourceRefs":[{"raw":"Hos.14.5","value":"Hos.14.5"}],"t":"ref","v":"14:5"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["like a refreshing dew:"],"sourceClass":"sn-excerpt","t":"span"}," In the semi-desert climate of Israel, dew was an important source of life-giving moisture (",{"href":"?bref=Gen.27.28","r":"Gen.27.28","rawR":"Gen.27.28","sourceRefs":[{"raw":"Gen.27.28","value":"Gen.27.28"}],"t":"ref","v":"Gen 27:28"},"; ",{"href":"?bref=Deut.33.28","r":"Deut.33.28","rawR":"Deut.33.28","sourceRefs":[{"raw":"Deut.33.28","value":"Deut.33.28"}],"t":"ref","v":"Deut 33:28"},"). • ",{"c":["it will send roots deep:"],"sourceClass":"sn-excerpt","t":"span"}," When Israel lived in faithfulness to their covenant with the Lord, they would be solid and stable like the majestic ",{"c":["cedars in Lebanon"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=Ps.92.12","r":"Ps.92.12","rawR":"Ps.92.12","sourceRefs":[{"raw":"Ps.92.12","value":"Ps.92.12"}],"t":"ref","v":"Ps 92:12"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.14.5","refs":[{"book":"HOS","endChapter":14,"endVerse":5,"startChapter":14,"startVerse":5}],"sourceAttributes":{"name":"Hos.14.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[14],"sourceItemFragmentSha256":"fe61932921e07ca05e7d79708e435bae97db1ce4b62210b5141665f328c79b7c","sourceItemName":"Hos.14.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10994,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.14.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.14.5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Hos.14.7","r":"Hos.14.7","rawR":"Hos.14.7","sourceRefs":[{"raw":"Hos.14.7","value":"Hos.14.7"}],"t":"ref","v":"14:7"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["under my shade:"],"sourceClass":"sn-excerpt","t":"span"}," A place of safety and relief (",{"href":"?bref=Ps.91.1","r":"Ps.91.1","rawR":"Ps.91.1","sourceRefs":[{"raw":"Ps.91.1","value":"Ps.91.1"}],"t":"ref","v":"Ps 91:1"},"; ",{"href":"?bref=Isa.25.4","r":"Isa.25.4","rawR":"Isa.25.4","sourceRefs":[{"raw":"Isa.25.4","value":"Isa.25.4"}],"t":"ref","v":"Isa 25:4"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.14.7","refs":[{"book":"HOS","endChapter":14,"endVerse":7,"startChapter":14,"startVerse":7}],"sourceAttributes":{"name":"Hos.14.7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[14],"sourceItemFragmentSha256":"ab4add6aa59ff60f07ba2a4de4400756fbbccbe18d546932b0ddd66a3e6c033b","sourceItemName":"Hos.14.7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10995,"sourceReferenceException":false,"sourceReferenceMa