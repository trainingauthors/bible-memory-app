":"span"}," This final verse commends Hosea’s words to ",{"c":["wise"],"sourceClass":"sn-excerpt","t":"span"}," and discerning believers of all generations."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Hos.14.9","refs":[{"book":"HOS","endChapter":14,"endVerse":9,"startChapter":14,"startVerse":9}],"sourceAttributes":{"name":"Hos.14.9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"HOS","sourceChapterCoverage":[14],"sourceItemFragmentSha256":"4abad7bbd3f4f7ebf01639f50b40e24d1cce24afc39328d849017c74780c1e43","sourceItemName":"Hos.14.9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10997,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"HOS","canonicalOSIS":"Hos","method":"official_book_intro_ref_title","sourceOSIS":"Hos"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Hos.14.9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Hos.14.9","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}