ant Ruth","refs":["Ruth 2:10-13","1 Sam 25:41","Luke 14:11"],"sourceRowNumber":11202,"targets":[{"label":"Ruth 2:10-13","passages":[{"book":"RUT","chapter":2,"verses":[10,11,12,13]}]},{"label":"1 Sam 25:41","passages":[{"book":"1SA","chapter":25,"verses":[41]}]},{"label":"Luke 14:11","passages":[{"book":"LUK","chapter":14,"verses":[11]}]}],"verse":9},{"anchor":"Spread","refs":["Ezek 16:8"],"sourceRowNumber":11203,"targets":[{"label":"Ezek 16:8","passages":[{"book":"EZK","chapter":16,"verses":[8]}]}],"verse":9},{"anchor":"kinsman-redeemer","refs":["Ruth 3:12","Ruth 2:20"],"sourceRowNumber":11204,"targets":[{"label":"Ruth 3:12","passages":[{"book":"RUT","chapter":3,"verses":[12]}]},{"label":"Ruth 2:20","passages":[{"book":"RUT","chapter":2,"verses":[20]}]}],"verse":9},{"anchor":"bless you","refs":["Ruth 2:4,20","1 Cor 13:4-5"],"sourceRowNumber":11205,"targets":[{"label":"Ruth 2:4,20","passages":[{"book":"RUT","chapter":2,"verses":[4,20]}]},{"label":"1 Cor 13:4-5","passages":[{"book":"1CO","chapter":13,"verses":[4,5]}]}],"verse":10},{"anchor":"before","refs":["Ruth 1:8"],"sourceRowNumber":11206,"targets":[{"label":"Ruth 1:8","passages":[{"book":"RUT","chapter":1,"verses":[8]}]}],"verse":10},{"anchor":"townspeople","refs":["Prov 12:4","Prov 31:10,29-31"],"sourceRowNumber":11207,"targets":[{"label":"Prov 12:4","passages":[{"book":"PRO","chapter":12,"verses":[4]}]},{"label":"Prov 31:10,29-31","passages":[{"book":"PRO","chapter":31,"verses":[10,29,30,31]}]}],"verse":11},{"anchor":"there is","refs":["Ruth 4:1","Matt 7:12","1 Thess 4:6"],"sourceRowNumber":11208,"targets":[{"label":"Ruth 4:1","passages":[{"book":"RUT","chapter":4,"verses":[1]}]},{"label":"Matt 7:12","passages":[{"book":"MAT","chapter":7,"verses":[12]}]},{"label":"1 Thess 4:6","passages":[{"book":"1TH","chapter":4,"verses":[6]}]}],"verse":12},{"anchor":"if he wants to redeem","refs":["Ruth 2:20","Ruth 4:5","Deut 25:5-9","Matt 22:24-27"],"sourceRowNumber":11209,"targets":[{"label":"Ruth 2:20","passages":[{"book":"RUT","chapter":2,"verses":[20]}]},{"label":"Ruth 4:5","passages":[{"book":"RUT","chapter":4,"verses":[5]}]},{"label":"Deut 25:5-9","passages":[{"book":"DEU","chapter":25,"verses":[5,6,7,8,9]}]},{"label":"Matt 22:24-27","passages":[{"book":"MAT","chapter":22,"verses":[24,25,26,27]}]}],"verse":13},{"anchor":"as surely as the LORD lives","refs":["Judg 8:19","Jer 4:2","2 Cor 1:23","Heb 6:16"],"sourceRowNumber":11210,"targets":[{"label":"Judg 8:19","passages":[{"book":"JDG","chapter":8,"verses":[19]}]},{"label":"Jer 4:2","passages":[{"book":"JER","chapter":4,"verses":[2]}]},{"label":"2 Cor 1:23","passages":[{"book":"2CO","chapter":1,"verses":[23]}]},{"label":"Heb 6:16","passages":[{"book":"HEB","chapter":6,"verses":[16]}]}],"verse":13},{"anchor":"Do not let it be known","refs":["Eccl 7:1","Rom 12:17","Rom 14:16","1 Cor 10:32","2 Cor 8:21","1 Thess 5:22","1 Pet 2:12"],"sourceRowNumber":11211,"targets":[{"label":"Eccl 7:1","passages":[{"book":"ECC","chapter":7,"verses":[1]}]},{"label":"Rom 12:17","passages":[{"book":"ROM","chapter":12,"verses":[17]}]},{"label":"Rom 14:16","passages":[{"book":"ROM","chapter":14,"verses":[16]}]},{"label":"1 Cor 10:32","passages":[{"book":"1CO","chapter":10,"verses":[32]}]},{"label":"2 Cor 8:21","passages":[{"book":"2CO","chapter":8,"verses":[21]}]},{"label":"1 Thess 5:22","passages":[{"book":"1TH","chapter":5,"verses":[22]}]},{"label":"1 Pet 2:12","passages":[{"book":"1PE","chapter":2,"verses":[12]}]}],"verse":14},{"anchor":"poured in","refs":["Isa 32:8","Gal 6:10"],"sourceRowNumber":11212,"targets":[{"label":"Isa 32:8","passages":[{"book":"ISA","chapter":32,"verses":[8]}]},{"label":"Gal 6:10","passages":[{"book":"GAL","chapter":6,"verses":[10]}]}],"verse":15},{"anchor":"Wait","refs":["Ps 37:3-5","Isa 28:16","Isa 30:7"],"sourceRowNumber":11213,"targets":[{"label":"Ps 37:3-5","passages":[{"book":"PSA","chapter":37,"verses":[3,4,5]}]},{"label":"Isa 28:16","passages":[{"book":"ISA","chapter":28,"verses":[16]}]},{"label":"Isa 30:7","passages":[{"book":"ISA","chapter":30,"verses":[7]}]}],"verse":18}],"dictionaryArticles":{"Anoint":{"file":"dictionary/234488dbfef236784ccea62d267c70b40f947f9621aa8337773ce8f2d63872fb.json","title":"Anoint"},"Banquet":{"file":"dictionary/fd298b6f1ca4e4fea7cc00e7375b01b900c8cec13862e9c010932406f7513eda.json","title":"Banquet"},"BatheBathing":{"file":"dictionary/9475e4f3795a35a9252aa51b3aed0586b5f6edff98e0bd4cfcbf3a72c57eaf68.json","title":"Bathe, Bathing"},"Bread":{"file":"dictionary/4b035e16672469a11a3916a5556cfc68c90c5999d6ccb33c793773eb5ee3693d.json","title":"Bread"},"FamilyLifeandRelations":{"file":"dictionary/fac83b571d436ea0ad0c35a9a3c3261e3b465aad98d7059f5a2398702224101f.json","title":"Family Life and Relations"},"Lord":{"file":"dictionary/0a54f5caa03523157b50ef58ec814d810e7db1abd5db44ec093ece07106e3447.json","title":"Lord"},"MarriageMarriageCustoms":{"file":"dictionary/ee8f20a87ce12a456b97b614120c238fc8a91ff5336a98515bc295184fa79ad9.json","title":"Marriage, Marriage Customs"},"Naomi":{"file":"dictionary/9a3aeeb02d76d74c0d74fa2146ccbe8fe78014249756ca37885adc15ad91a568.json","title":"Naomi"},"Oil":{"file":"dictionary/2e76733fece008d9e32042598c132d04b6dbc8bf830f196a690263555b71aca6.json","title":"Oil"},"Perfume":{"file":"dictionary/2d4d34b80170762b246f1b7959614e9754532598f4245aa815941bcabe3f32ea.json","title":"Perfume"},"Ransom":{"file":"dictionary/ed905eb653630f7b7802564ec87c99b97eb97841a20806e75ca904e5137a07d5.json","title":"Ransom"},"RedeemerRedemption":{"file":"dictionary/68231fe6debb5d1fc7a9a636ef95bfeebfbb4cec74e8afacaf363a4522d4ec29.json","title":"Redeemer, Redemption"},"RuthBookof":{"file":"dictionary/0fe3904742c63eb09fb2176b4cf6dc0282b35b133c39b1295a28aacd19cd9870.json","title":"Ruth, Book of"}},"dictionaryRelated":[{"id":"Anoint","title":"Anoint"},{"id":"Banquet","title":"Banquet"},{"id":"BatheBathing","title":"Bathe, Bathing"},{"id":"Bread","title":"Bread"},{"id":"FamilyLifeandRelations","title":"Family Life and Relations"},{"id":"MarriageMarriageCustoms","title":"Marriage, Marriage Customs"},{"id":"Oil","title":"Oil"},{"id":"Perfume","title":"Perfume"},{"id":"Ransom","title":"Ransom"},{"id":"RedeemerRedemption","title":"Redeemer, Redemption"},{"id":"RuthBookof","title":"Ruth, Book of"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Then Boaz said, “May the LORD bless you, my daughter. You have shown more kindness now than before, because you have not run after the younger men, whether rich or poor.","verse":10},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Stay here tonight, and in the morning, if he wants to redeem you, good. Let him redeem you. But if he does not want to redeem you, as surely as the LORD lives, I will. Now lie here until morning.”","verse":13}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Naomi","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[{"anchorIndex":4,"href":"?bref=Ruth.2.1-4.22","rawReference":"Ruth.2.1-4.22"}],"ruleId":"Naomi::Naomi::reviewed_unambiguous_name","sourceHeadwordId":"Naomi"},"text":"One day Ruth’s mother-in-law Naomi said to her, “My daughter, should I not seek a resting place for you, that it may be well with you?","verse":1},{"matchingRule":"reviewed_exact_headword","phrase":"Naomi","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[{"anchorIndex":4,"href":"?bref=Ruth.2.1-4.22","rawReference":"Ruth.2.1-4.22"}],"ruleId":"Naomi::Naomi::reviewed_unambiguous_name","sourceHeadwordId":"Naomi"},"text":"When Ruth returned to her mother-in-law, Naomi asked her, “How did it go, my daughter?” Then Ruth told her all that Boaz had done for her.","verse":16},{"matchingRule":"reviewed_exact_headword","phrase":"Naomi","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[{"anchorIndex":4,"href":"?bref=Ruth.2.1-4.22","rawReference":"Ruth.2.1-4.22"}],"ruleId":"Naomi::Naomi::reviewed_unambiguous_name","sourceHeadwordId":"Naomi"},"text":"“Wait, my daughter,” said Naomi, “until you find out how things go, for he will not rest unless he has resolved the matter today.”","verse":18}],"id":"Naomi","label":"Naomi","matchReviews":[{"ruleId":"Naomi::Naomi::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Naomi","term":"Naomi"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Naomi","sourceTitle":"Naomi"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":["Ruth"],"sourceClass":"profile-title","t":"h"},{"c":["The story of Ruth tells of a kind and loyal woman and of the hidden providence of God, who makes all things work together for the good of those who love him (",{"href":"?bref=Rom.8.28","r":"Rom.8.28","rawR":"Rom.8.28","sourceRefs":[{"raw":"Rom.8.28","value":"Rom.8.28"}],"t":"ref","v":"Rom 8:28"},"). This story, part of the history that leads to the Messiah himself, starts with sadness but ends happily."],"sourceClass":"profile-body-fl","t":"p"},{"c":["Ruth lived during the turbulent period of the judges. A foreigner from Moab, she married into an Israelite family from Bethlehem when that family was living in Moab. All the men of this Israelite family died in Moab, leaving behind three widows—Ruth, her mother-in-law Naomi, and her sister-in-law Orpah. When Naomi decided to return to her hometown of Bethlehem, Ruth cast her lot with her mother-in-law. Ruth’s declaration of love, loyalty, and faith in the Lord (Naomi’s God) has few equals (",{"href":"?bref=Ruth.1.16-17","r":"Ruth.1.16-17","rawR":"Ruth.1.16-17","sourceRefs":[{"raw":"Ruth.1.16-17","value":"Ruth.1.16-17"}],"t":"ref","v":"Ruth 1:16-17"},")."],"sourceClass":"profile-body","t":"p"},{"c":["As Naomi had expected, the situation in Bethlehem was difficult for her and her daughter-in-law. Ruth, by her own initiative, undertook solving the problem of food for herself and Naomi through the hard and risky task of gleaning in the grain fields (",{"href":"?bref=Ruth.2.2","r":"Ruth.2.2","rawR":"Ruth.2.2","sourceRefs":[{"raw":"Ruth.2.2","value":"Ruth.2.2"}],"t":"ref","v":"2:2"},"). She acted with modesty, grace, and courtesy, but also with determination, focus, and endurance."],"sourceClass":"profile-body","t":"p"},{"c":["With Naomi’s encouragement, Ruth then took the initiative in asking Boaz, the wealthy landowner who was supporting Ruth’s gleaning, to act as the family redeemer (",{"href":"?bref=Ruth.3.1-9","r":"Ruth.3.1-9","rawR":"Ruth.3.1-9","sourceRefs":[{"raw":"Ruth.3.1-9","value":"Ruth.3.1-9"}],"t":"ref","v":"3:1-9"},"), which would include marriage. In doing this, Ruth was exercising great “family loyalty” (",{"href":"?bref=Ruth.3.10","r":"Ruth.3.10","rawR":"Ruth.3.10","sourceRefs":[{"raw":"Ruth.3.10","value":"Ruth.3.10"}],"t":"ref","v":"3:10"},"); Ruth’s generous and diligent care for Naomi is a major theme throughout this little book. Boaz responded to Ruth’s proposal by calling her a “virtuous woman” (",{"href":"?bref=Ruth.3.11","r":"Ruth.3.11","rawR":"Ruth.3.11","sourceRefs":[{"raw":"Ruth.3.11","value":"Ruth.3.11"}],"t":"ref","v":"3:11"},"), and she certainly embodied the characteristics of a virtuous and capable wife (cp. ",{"href":"?bref=Pr.31.10-31","r":"Pr.31.10-31","rawR":"Pr.31.10-31","sourceRefs":[{"raw":"Pr.31.10-31","value":"Pr.31.10-31"}],"t":"ref","v":"Prov 31:10-31"},", which uses the same Hebrew phrase and is placed immediately before Ruth in the Hebrew Bible)."],"sourceClass":"profile-body","t":"p"},{"c":["Boaz settled the legal matters and then married Ruth. The book ends by announcing the birth of a baby boy, Obed. With this ending we see an important purpose of the book of Ruth. Obed became the grandfather of King David. The New Testament includes Ruth as one of only five women mentioned in the genealogy of Jesus Christ (",{"href":"?bref=Matt.1.5","r":"Matt.1.5","rawR":"Matt.1.5","sourceRefs":[{"raw":"Matt.1.5","value":"Matt.1.5"}],"t":"ref","v":"Matt 1:5"},"). The everyday faithfulness of Ruth had eternal significance as God worked out his purposes through her."],"sourceClass":"profile-body","t":"p"},{"c":["Passages for Further Study"],"sourceClass":"profile-refs-title","t":"h"},{"c":[{"href":"?bref=Ruth.1.4-4.13","r":"Ruth.1.4-4.13","rawR":"Ruth.1.4-4.13","sourceRefs":[{"raw":"Ruth.1.4-4.13","value":"Ruth.1.4-4.13"}],"t":"ref","v":"Ruth 1:4–4:13"},"; ",{"href":"?bref=Matt.1.5","r":"Matt.1.5","rawR":"Matt.1.5","sourceRefs":[{"raw":"Matt.1.5","value":"Matt.1.5"}],"t":"ref","v":"Matt 1:5"}],"sourceClass":"profile-refs","t":"p"}],"id":"Profile:Ruth","refs":[{"book":"RUT","endChapter":4,"endVerse":22,"startChapter":1,"startVerse":1}],"sourceAttributes":{"name":"Ruth","product":"TyndaleOpenStudyNotes","typename":"Profile"},"sourceBookAppCode":"RUT","sourceChapterCoverage":[1,2,3,4],"sourceItemFragmentSha256":"01b7d131d221d392cb0ae22b4d3e920df6beff644126636da097a8c40d5bd01b","sourceItemName":"Ruth","sourceMember":"Tyndale Open Study Notes/Profiles.xml","sourceOrder":32,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"RUT","canonicalOSIS":"Ruth","method":"official_book_intro_ref_title","sourceOSIS":"Ruth"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ruth.1.1-4.22","sourceRelease":"1.25","sourceTitleExact":"Ruth","supplementPointersNotIncludedAsContent":[],"title":"Ruth","type":"Profile"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":["The Family Redeemer"],"sourceClass":"theme-title","t":"h"},{"c":["The idea of a family redeemer, established in the law of Moses, finds a vivid example in the story of Ruth. In that book, the expression “family redeemer” has a specific, technical meaning. Elsewhere, the underlying Hebrew term ",{"c":["go’el"],"sourceClass":"hebrew","t":"span"}," is translated “nearest relative” (",{"href":"?bref=Num.27.11","r":"Num.27.11","rawR":"Num.27.11","sourceRefs":[{"raw":"Num.27.11","value":"Num.27.11"}],"t":"ref","v":"Num 27:11"},"; ",{"href":"?bref=Num.35.19","r":"Num.35.19","rawR":"Num.35.19","sourceRefs":[{"raw":"Num.35.19","value":"Num.35.19"}],"t":"ref","v":"35:19"},", ",{"href":"?bref=Num.35.24","r":"Num.35.24","rawR":"Num.35.24","sourceRefs":[{"raw":"Num.35.24","value":"Num.35.24"}],"t":"ref","v":"24"},")."],"sourceClass":"theme-body-fl","t":"p"},{"c":["According to the law, family redeemers had three main responsibilities in Israel:"],"sourceClass":"theme-body","t":"p"},{"c":["1. ",{"href":"?bref=Lev.25.23-34","r":"Lev.25.23-34","rawR":"Lev.25.23-34","sourceRefs":[{"raw":"Lev.25.23-34","value":"Lev.25.23-34"}],"t":"ref","v":"Leviticus 25:23-34"}," stipulates that if an Israelite became so poor that he had to sell his land, a family member was to pay off the debt so the land would remain in the family. If no relative could purchase the land and the seller was unable to buy it back, the land still reverted to the seller or his heirs in the Jubilee (fiftieth) Year. Two examples of family redeemers buying land for their relatives are Boaz (",{"href":"?bref=Ruth.4.1-12","r":"Ruth.4.1-12","rawR":"Ruth.4.1-12","sourceRefs":[{"raw":"Ruth.4.1-12","value":"Ruth.4.1-12"}],"t":"ref","v":"Ruth 4:1-12"},") and Jeremiah (",{"href":"?bref=Jer.32.6-15","r":"Jer.32.6-15","rawR":"Jer.32.6-15","sourceRefs":[{"raw":"Jer.32.6-15","value":"Jer.32.6-15"}],"t":"ref","v":"Jer 32:6-15"},")."],"sourceClass":"theme-body","t":"p"},{"c":["2. Similarly, if an Israelite became so poor he had to sell himself into debt-slavery, a family redeemer was to buy his relative from service to a non-relative (",{"href":"?bref=Lev.25.35-55","r":"Lev.25.35-55","rawR":"Lev.25.35-55","sourceRefs":[{"raw":"Lev.25.35-55","value":"Lev.25.35-55"}],"t":"ref","v":"Lev 25:35-55"},"). The poor Israelite would pay off his debt by working for his relative, who could be expected to treat him better than a stranger would."],"sourceClass":"theme-body","t":"p"},{"c":["3. The family redeemer was to pursue justice for an Israelite killed by another’s hand, under conditions described in ",{"href":"?bref=Num.35.9-34","r":"Num.35.9-34","rawR":"Num.35.9-34","sourceRefs":[{"raw":"Num.35.9-34","value":"Num.35.9-34"}],"t":"ref","v":"Num 35:9-34"},"."],"sourceClass":"theme-body","t":"p"},{"c":["The concept of the family redeemer reminds us that God is the true owner of all things, and he commands us to love our neighbor as ourselves (",{"href":"?bref=Lev.19.18","r":"Lev.19.18","rawR":"Lev.19.18","sourceRefs":[{"raw":"Lev.19.18","value":"Lev.19.18"}],"t":"ref","v":"Lev 19:18"},"; ",{"href":"?bref=Matt.22.39-40","r":"Matt.22.39-40","rawR":"Matt.22.39-40","sourceRefs":[{"raw":"Matt.22.39-40","value":"Matt.22.39-40"}],"t":"ref","v":"Matt 22:39-40"},"). The New Testament presents Jesus as the perfect family redeemer, buying us from the slavery to sin and death into which we had sold ourselves (",{"href":"?bref=Matt.20.28","r":"Matt.20.28","rawR":"Matt.20.28","sourceRefs":[{"raw":"Matt.20.28","value":"Matt.20.28"}],"t":"ref","v":"Matt 20:28"},"; ",{"href":"?bref=Rom.3.24-25","r":"Rom.3.24-25","rawR":"Rom.3.24-25","sourceRefs":[{"raw":"Rom.3.24-25","value":"Rom.3.24-25"}],"t":"ref","v":"Rom 3:24-25"},"; ",{"href":"?bref=Eph.1.7","r":"Eph.1.7","rawR":"Eph.1.7","sourceRefs":[{"raw":"Eph.1.7","value":"Eph.1.7"}],"t":"ref","v":"Eph 1:7"},"; ",{"href":"?bref=Titus.2.14","r":"Titus.2.14","rawR":"Titus.2.14","sourceRefs":[{"raw":"Titus.2.14","value":"Titus.2.14"}],"t":"ref","v":"Titus 2:14"},"; ",{"href":"?bref=Rev.5.9","r":"Rev.5.9","rawR":"Rev.5.9","sourceRefs":[{"raw":"Rev.5.9","value":"Rev.5.9"}],"t":"ref","v":"Rev 5:9"},"; cp. ",{"href":"?bref=Exod.6.6","r":"Exod.6.6","rawR":"Exod.6.6","sourceRefs":[{"raw":"Exod.6.6","value":"Exod.6.6"}],"t":"ref","v":"Exod 6:6"},"; ",{"href":"?bref=Exod.15.13","r":"Exod.15.13","rawR":"Exod.15.13","sourceRefs":[{"raw":"Exod.15.13","value":"Exod.15.13"}],"t":"ref","v":"15:13"},"; ",{"href":"?bref=Ps.130.8","r":"Ps.130.8","rawR":"Ps.130.8","sourceRefs":[{"raw":"Ps.130.8","value":"Ps.130.8"}],"t":"ref","v":"Ps 130:8"},"; ",{"href":"?bref=Isa.44.22","r":"Isa.44.22","rawR":"Isa.44.22","sourceRefs":[{"raw":"Isa.44.22","value":"Isa.44.22"}],"t":"ref","v":"Isa 44:22"},"; ",{"href":"?bref=Isa.59.20","r":"Isa.59.20","rawR":"Isa.59.20","sourceRefs":[{"raw":"Isa.59.20","value":"Isa.59.20"}],"t":"ref","v":"59:20"},"; ",{"href":"?bref=Isa.63.9","r":"Isa.63.9","rawR":"Isa.63.9","sourceRefs":[{"raw":"Isa.63.9","value":"Isa.63.9"}],"t":"ref","v":"63:9"},"; ",{"href":"?bref=Jer.31.11","r":"Jer.31.11","rawR":"Jer.31.11","sourceRefs":[{"raw":"Jer.31.11","value":"Jer.31.11"}],"t":"ref","v":"Jer 31:11"},"). In the spirit of the Old Testament family redeemer (such as Boaz) and following the example of our great Redeemer, we, too, are commanded to act with love and compassion toward others (",{"href":"?bref=Lev.19.11-18","r":"Lev.19.11-18","rawR":"Lev.19.11-18","sourceRefs":[{"raw":"Lev.19.11-18","value":"Lev.19.11-18"}],"t":"ref","v":"Lev 19:11-18"},"; ",{"href":"?bref=Matt.5.43-48","r":"Matt.5.43-48","rawR":"Matt.5.43-48","sourceRefs":[{"raw":"Matt.5.43-48","value":"Matt.5.43-48"}],"t":"ref","v":"Matt 5:43-48"},"; ",{"href":"?bref=Matt.19.19","r":"Matt.19.19","rawR":"Matt.19.19","sourceRefs":[{"raw":"Matt.19.19","value":"Matt.19.19"}],"t":"ref","v":"19:19"},"; ",{"href":"?bref=Matt.22.37-40","r":"Matt.22.37-40","rawR":"Matt.22.37-40","sourceRefs":[{"raw":"Matt.22.37-40","value":"Matt.22.37-40"}],"t":"ref","v":"22:37-40"},"; ",{"href":"?bref=Rom.13.8-10","r":"Rom.13.8-10","rawR":"Rom.13.8-10","sourceRefs":[{"raw":"Rom.13.8-10","value":"Rom.13.8-10"}],"t":"ref","v":"Rom 13:8-10"},"; ",{"href":"?bref=Gal.5.14","r":"Gal.5.14","rawR":"Gal.5.14","sourceRefs":[{"raw":"Gal.5.14","value":"Gal.5.14"}],"t":"ref","v":"Gal 5:14"},"; ",{"href":"?bref=Jas.2.8-9","r":"Jas.2.8-9","rawR":"Jas.2.8-9","sourceRefs":[{"raw":"Jas.2.8-9","value":"Jas.2.8-9"}],"t":"ref","v":"Jas 2:8-9"},")."],"sourceClass":"theme-body","t":"p"},{"c":["Passages for Further Study"],"sourceClass":"theme-refs-title","t":"h"},{"c":[{"href":"?bref=Lev.25.23-55","r":"Lev.25.23-55","rawR":"Lev.25.23-55","sourceRefs":[{"raw":"Lev.25.23-55","value":"Lev.25.23-55"}],"t":"ref","v":"Lev 25:23-55"},"; ",{"href":"?bref=Num.35.9-34","r":"Num.35.9-34","rawR":"Num.35.9-34","sourceRefs":[{"raw":"Num.35.9-34","value":"Num.35.9-34"}],"t":"ref","v":"Num 35:9-34"},"; ",{"href":"?bref=Ruth.2.20","r":"Ruth.2.20","rawR":"Ruth.2.20","sourceRefs":[{"raw":"Ruth.2.20","value":"Ruth.2.20"}],"t":"ref","v":"Ruth 2:20"},"; ",{"href":"?bref=Ruth.3.9","r":"Ruth.3.9","rawR":"Ruth.3.9","sourceRefs":[{"raw":"Ruth.3.9","value":"Ruth.3.9"}],"t":"ref","v":"3:9"},", ",{"href":"?bref=Ruth.3.12","r":"Ruth.3.12","rawR":"Ruth.3.12","sourceRefs":[{"raw":"Ruth.3.12","value":"Ruth.3.12"}],"t":"ref","v":"12"},"; ",{"href":"?bref=Ruth.4.1-10","r":"Ruth.4.1-10","rawR":"Ruth.4.1-10","sourceRefs":[{"raw":"Ruth.4.1-10","value":"Ruth.4.1-10"}],"t":"ref","v":"4:1-10"},"; ",{"href":"?bref=Isa.59.20","r":"Isa.59.20","rawR":"Isa.59.20","sourceRefs":[{"raw":"Isa.59.20","value":"Isa.59.20"}],"t":"ref","v":"Isa 59:20"},"; ",{"href":"?bref=Jer.32.6-15","r":"Jer.32.6-15","rawR":"Jer.32.6-15","sourceRefs":[{"raw":"Jer.32.6-15","value":"Jer.32.6-15"}],"t":"ref","v":"Jer 32:6-15"},"; ",{"href":"?bref=Matt.20.28","r":"Matt.20.28","rawR":"Matt.20.28","sourceRefs":[{"raw":"Matt.20.28","value":"Matt.20.28"}],"t":"ref","v":"Matt 20:28"},"; ",{"href":"?bref=Rom.3.24-25","r":"Rom.3.24-25","rawR":"Rom.3.24-25","sourceRefs":[{"raw":"Rom.3.24-25","value":"Rom.3.24-25"}],"t":"ref","v":"Rom 3:24-25"},"; ",{"href":"?bref=Eph.1.7","r":"Eph.1.7","rawR":"Eph.1.7","sourceRefs":[{"raw":"Eph.1.7","value":"Eph.1.7"}],"t":"ref","v":"Eph 1:7"},"; ",{"href":"?bref=Titus.2.14","r":"Titus.2.14","rawR":"Titus.2.14","sourceRefs":[{"raw":"Titus.2.14","value":"Titus.2.14"}],"t":"ref","v":"Titus 2:14"},"; ",{"href":"?bref=Rev.5.9","r":"Rev.5.9","rawR":"Rev.5.9","sourceRefs":[{"raw":"Rev.5.9","value":"Rev.5.9"}],"t":"ref","v":"Rev 5:9"}],"sourceClass":"theme-refs","t":"p"}],"id":"ThemeNote:TheFamilyRedeemer","refs":[{"book":"RUT","endChapter":4,"endVerse":15,"startChapter":2,"startVerse":20}],"sourceAttributes":{"name":"TheFamilyRedeemer","product":"TyndaleOpenStudyNotes","typename":"ThemeNote"},"sourceBookAppCode":"RUT","sourceChapterCoverage":[2,3,4],"sourceItemFragmentSha256":"455cde4de2175e07b655c5ddcd6a8bb908051cc0fef20b9d646540cbdfe2dcab","sourceItemName":"TheFamilyRedeemer","sourceMember":"Tyndale Open Study Notes/ThemeNotes.xml","sourceOrder":55,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"RUT","canonicalOSIS":"Ruth","method":"official_book_intro_ref_title","sourceOSIS":"Ruth"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ruth.2.20-4.15","sourceRelease":"1.25","sourceTitleExact":"The Family Redeemer","supplementPointersNotIncludedAsContent":[],"title":"The Family Redeemer","type":"ThemeNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ruth.3.1","r":"Ruth.3.1","rawR":"Ruth.3.1","sourceRefs":[{"raw":"Ruth.3.1","value":"Ruth.3.1"}],"t":"ref","v":"3:1"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["a permanent home"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["a resting place"],"sourceClass":"ital","t":"span"},"): Naomi used a related word in ",{"href":"?bref=Ruth.1.9","r":"Ruth.1.9","rawR":"Ruth.1.9","sourceRefs":[{"raw":"Ruth.1.9","value":"Ruth.1.9"}],"t":"ref","v":"1:9"}," when she prayed for Ruth and Orpah. Now she suggested a course of action that might encourage Boaz to act on Ruth’s behalf."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ruth.3.1","refs":[{"book":"RUT","endChapter":3,"endVerse":1,"startChapter":3,"startVerse":1}],"sourceAttributes":{"name":"Ruth.3.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"RUT","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"bb3040cc57bd4b0a5faafb06737b8f050f00de2582e60d47688c2fdd88072537","sourceItemName":"Ruth.3.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":3189,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"RUT","canonicalOSIS":"Ruth","method":"official_book_intro_ref_title","sourceOSIS":"Ruth"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ruth.3.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ruth.3.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ruth.3.2","r":"Ruth.3.2","rawR":"Ruth.3.2","sourceRefs":[{"raw":"Ruth.3.2","value":"Ruth.3.2"}],"t":"ref","v":"3:2"}],"sourceClass":"sn-ref","t":"span"}," As a ",{"c":["close relative"],"sourceClass":"sn-excerpt","t":"span"},", Boaz might act as a redeemer for Ruth and Naomi (see study notes on ",{"href":"?item=Ruth.2.20_StudyNote_Filament","id":"Ruth.2.20_StudyNote_Filament","rawId":"Ruth.2.20_StudyNote_Filament","t":"link","v":"2:20"},"; ",{"href":"?item=Ruth.3.9_StudyNote_Filament","id":"Ruth.3.9_StudyNote_Filament","rawId":"Ruth.3.9_StudyNote_Filament","t":"link","v":"3:9"},"). • The ",{"c":["threshing floor"],"sourceClass":"sn-excerpt","t":"span"}," was a flat surface of stone or hardened earth. The farmer spread sheaves of grain over its surface and beat them to separate the grain from the straw. Then the farmer would begin ",{"c":["winnowing"],"sourceClass":"sn-excerpt","t":"span"}," by throwing the mixed straw and grain into the air with a wooden fork or shovel. The breeze carried the lighter straw and chaff downwind, while the heavier grains fell to the threshing floor."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ruth.3.2","refs":[{"book":"RUT","endChapter":3,"endVerse":2,"startChapter":3,"startVerse":2}],"sourceAttributes":{"name":"Ruth.3.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"RUT","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"1a784ba2d937a415cbb9193478d14467e3a52086a029ffc8535fad5b5b784a9e","sourceItemName":"Ruth.3.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":3190,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"RUT","canonicalOSIS":"Ruth","method":"official_book_intro_ref_title","sourceOSIS":"Ruth"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ruth.3.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ruth.3.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ruth.3.3","r":"Ruth.3.3","rawR":"Ruth.3.3","sourceRefs":[{"raw":"Ruth.3.3","value":"Ruth.3.3"}],"t":"ref","v":"3:3"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["take a bath"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["wash yourself"],"sourceClass":"ital","t":"span"},"): Ruth probably bathed herself with a cloth dipped in water (only the wealthy had facilities for immersing themselves). Bathing was not an everyday expectation; this was a special occasion."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ruth.3.3","refs":[{"book":"RUT","endChapter":3,"endVerse":3,"startChapter":3,"startVerse":3}],"sourceAttributes":{"name":"Ruth.3.3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"RUT","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"15b9a85ad9f33438401aee9fc2f5bca80c6f8a97c3f1bdd6f7176859960bfdb5","sourceItemName":"Ruth.3.3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":3191,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"RUT","canonicalOSIS":"Ruth","method":"official_book_intro_ref_title","sourceOSIS":"Ruth"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ruth.3.3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ruth.3.3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ruth.3.4","r":"Ruth.3.4","rawR":"Ruth.3.4","sourceRefs":[{"raw":"Ruth.3.4","value":"Ruth.3.4"}],"t":"ref","v":"3:4"}],"sourceClass":"sn-ref","t":"span"}," Ruth was to ",{"c":["uncover"],"sourceClass":"sn-excerpt","t":"span"}," Boaz’s ",{"c":["feet"],"sourceClass":"sn-excerpt","t":"span"}," to ensure that he would waken."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ruth.3.4","refs":[{"book":"RUT","endChapter":3,"endVerse":4,"startChapter":3,"startVerse":4}],"sourceAttributes":{"name":"Ruth.3.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"RUT","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"4fb93c51b5c6a297ce17c952d827d7c99472f422f800ca8560c433520710dab4","sourceItemName":"Ruth.3.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":3192,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"RUT","canonicalOSIS":"Ruth","method":"official_book_intro_ref_title","sourceOSIS":"Ruth"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ruth.3.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ruth.3.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ruth.3.7","r":"Ruth.3.7","rawR":"Ruth.3.7","sourceRefs":[{"raw":"Ruth.3.7","value":"Ruth.3.7"}],"t":"ref","v":"3:7"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["he lay down:"],"sourceClass":"sn-excerpt","t":"span"}," The owner slept at the threshing floor to deter petty theft."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ruth.3.7","refs":[{"book":"RUT","endChapter":3,"endVerse":7,"startChapter":3,"startVerse":7}],"sourceAttributes":{"name":"Ruth.3.7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"RUT","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"f770ffb63408c9d2b14a634ec1930258dac374e7767f69f0a67ed77f82c09658","sourceItemName":"Ruth.3.7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":3193,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"RUT","canonicalOSIS":"Ruth","method":"official_book_intro_ref_title","sourceOSIS":"Ruth"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ruth.3.7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ruth.3.7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ruth.3.8","r":"Ruth.3.8","rawR":"Ruth.3.8","sourceRefs":[{"raw":"Ruth.3.8","value":"Ruth.3.8"}],"t":"ref","v":"3:8"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["He was surprised"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["He was terrified"],"sourceClass":"ital","t":"span"},"): Boaz knew that a woman lay ",{"c":["at his feet"],"sourceClass":"sn-excerpt","t":"span"},", but he did not know who she was or why she was there."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ruth.3.8","refs":[{"book":"RUT","endChapter":3,"endVerse":8,"startChapter":3,"startVerse":8}],"sourceAttributes":{"name":"Ruth.3.8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"RUT","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"b19ac32deb50e2f4c0cf3b255305448fd54a3d64b6a3350063c6d140e2f0eee2","sourceItemName":"Ruth.3.8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":3194,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"RUT","canonicalOSIS":"Ruth","method":"official_book_intro_ref_title","sourceOSIS":"Ruth"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ruth.3.8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ruth.3.8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ruth.3.9","r":"Ruth.3.9","rawR":"Ruth.3.9","sourceRefs":[{"raw":"Ruth.3.9","value":"Ruth.3.9"}],"t":"ref","v":"3:9"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["your servant:"],"sourceClass":"sn-excerpt","t":"span"}," Ruth deliberately identified herself with the female workers. • ",{"c":["Spread . . . your covering over me:"],"sourceClass":"sn-excerpt","t":"span"}," This was a way of asking Boaz to marry her (cp. ",{"href":"?bref=Ezek.16.8","r":"Ezek.16.8","rawR":"Ezek.16.8","sourceRefs":[{"raw":"Ezek.16.8","value":"Ezek.16.8"}],"t":"ref","v":"Ezek 16:8"},"). • Ruth appealed to Boaz’s status as a ",{"c":["family redeemer"],"sourceClass":"sn-excerpt","t":"span"}," (Hebrew ",{"c":["go’el"],"sourceClass":"hebrew","t":"span"},") to persuade him to marry her (see ",{"href":"?bref=Ruth.4.5","r":"Ruth.4.5","rawR":"Ruth.4.5","sourceRefs":[{"raw":"Ruth.4.5","value":"Ruth.4.5"}],"t":"ref","v":"Ruth 4:5"},"; “",{"href":"?item=TheFamilyRedeemer_ThemeNote_Filament","id":"TheFamilyRedeemer_ThemeNote_Filament","rawId":"TheFamilyRedeemer_ThemeNote_Filament","t":"link","v":"The Family Redeemer"},"” Theme Note)."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ruth.3.9","refs":[{"book":"RUT","endChapter":3,"endVerse":9,"startChapter":3,"startVerse":9}],"sourceAttributes":{"name":"Ruth.3.9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"RUT","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"a8c73bd1630c5a556133dfec938e7acb4c563b3db3a6c23e38d2b419b9ba23d9","sourceItemName":"Ruth.3.9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":3195,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"RUT","canonicalOSIS":"Ruth","method":"official_book_intro_ref_title","sourceOSIS":"Ruth"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ruth.3.9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ruth.3.9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ruth.3.10","r":"Ruth.3.10","rawR":"Ruth.3.10","sourceRefs":[{"raw":"Ruth.3.10","value":"Ruth.3.10"}],"t":"ref","v":"3:10"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["You are showing even more family loyalty:"],"sourceClass":"sn-excerpt","t":"span"}," Ruth was not obligated to come to Bethlehem with Naomi, nor did she have to marry within Elimelech’s family or provide them with an heir to the land (see ",{"href":"?bref=Ruth.4.5","r":"Ruth.4.5","rawR":"Ruth.4.5","sourceRefs":[{"raw":"Ruth.4.5","value":"Ruth.4.5"}],"t":"ref","v":"4:5"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ruth.3.10","refs":[{"book":"RUT","endChapter":3,"endVerse":10,"startChapter":3,"startVerse":10}],"sourceAttributes":{"name":"Ruth.3.10","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"RUT","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"66caa47f297ed7ad83dba7c2a57efdff52fe3839f42d67ca9266e311a3d1db42","sourceItemName":"Ruth.3.10","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":3196,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"RUT","canonicalOSIS":"Ruth","method":"official_book_intro_ref_title","sourceOSIS":"Ruth"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ruth.3.10","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ruth.3.10","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ruth.3.11","r":"Ruth.3.11","rawR":"Ruth.3.11","sourceRefs":[{"raw":"Ruth.3.11","value":"Ruth.3.11"}],"t":"ref","v":"3:11"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["what is necessary"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["what you are asking"],"sourceClass":"ital","t":"span"},"): Boaz agreed to act on Ruth’s behalf. Some interpreters understand Boaz’s statement as an unconditional agreement to marry Ruth (see also ",{"href":"?item=Ruth.4.5_StudyNote_Filament","id":"Ruth.4.5_StudyNote_Filament","rawId":"Ruth.4.5_StudyNote_Filament","t":"link","v":"study note on 4:5"},"); most take it to mean that Boaz would act to provide for Ruth and Naomi by presenting to the nearer kinsman the opportunity to act as family redeemer before taking the opportunity himself (",{"href":"?bref=Ruth.4.1-12","r":"Ruth.4.1-12","rawR":"Ruth.4.1-12","sourceRefs":[{"raw":"Ruth.4.1-12","value":"Ruth.4.1-12"}],"t":"ref","v":"4:1-12"},"). By voluntarily taking on the role of the family redeemer for Ruth and Naomi, Boaz became a forerunner of Jesus."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ruth.3.11","refs":[{"book":"RUT","endChapter":3,"endVerse":11,"startChapter":3,"startVerse":11}],"sourceAttributes":{"name":"Ruth.3.11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"RUT","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"c1345fa7c3838c60d16d7c5b0cf991447faa254d50761478e63781027475d84c","sourceItemName":"Ruth.3.11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":3197,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"RUT","canonicalOSIS":"Ruth","method":"official_book_intro_ref_title","sourceOSIS":"Ruth"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ruth.3.11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ruth.3.11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ruth.3.12-13","r":"Ruth.3.12-13","rawR":"Ruth.3.12-13","sourceRefs":[{"raw":"Ruth.3.12-13","value":"Ruth.3.12-13"}],"t":"ref","v":"3:12-13"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Another man"],"sourceClass":"sn-excerpt","t":"span"}," was ",{"c":["more closely related"],"sourceClass":"sn-excerpt","t":"span"}," to Elimelech than Boaz. He had the first right of refusal to act as family redeemer and (according to most interpreters) to marry Ruth."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ruth.3.12-13","refs":[{"book":"RUT","endChapter":3,"endVerse":13,"startChapter":3,"startVerse":12}],"sourceAttributes":{"name":"Ruth.3.12-13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"RUT","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"30b51ea93fc86a2c6d63db95553c07205763f91df5a64f12ed27b2112744788c","sourceItemName":"Ruth.3.12-13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":3198,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"RUT","canonicalOSIS":"Ruth","method":"official_book_intro_ref_title","sourceOSIS":"Ruth"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ruth.3.12-13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ruth.3.12-13","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ruth.3.15","r":"Ruth.3.15","rawR":"Ruth.3.15","sourceRefs":[{"raw":"Ruth.3.15","value":"Ruth.3.15"}],"t":"ref","v":"3:15"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["six scoops:"],"sourceClass":"sn-excerpt","t":"span"}," There were two scoop sizes. The smaller measure (the ",{"c":["omer"],"sourceClass":"ital","t":"span"},") was ",{"c":["1"],"sourceClass":"sup","t":"span"},"/",{"c":["10"],"sourceClass":"sub","t":"span"}," of an ephah (about 2 quarts); the larger measure (the ",{"c":["seah"],"sourceClass":"ital","t":"span"},") was ",{"c":["1"],"sourceClass":"sup","t":"span"},"/",{"c":["3"],"sourceClass":"sub","t":"span"}," of an ephah (about 6 ",{"c":["2"],"sourceClass":"sup","t":"span"},"/",{"c":["3"],"sourceClass":"sub","t":"span"}," quarts). The latter quantity is more likely and indicates a very generous gift, twice the amount that Ruth gleaned on her first day (",{"href":"?bref=Ruth.2.17","r":"Ruth.2.17","rawR":"Ruth.2.17","sourceRefs":[{"raw":"Ruth.2.17","value":"Ruth.2.17"}],"t":"ref","v":"2:17"},"); it was a significant token of good faith."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ruth.3.15","refs":[{"book":"RUT","endChapter":3,"endVerse":15,"startChapter":3,"startVerse":15}],"sourceAttributes":{"name":"Ruth.3.15","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"RUT","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"aa67d4f4a26b5d2ba14dbcf3db03e7a09cae5efb28069ed022ceabf8ae100dd9","sourceItemName":"Ruth.3.15","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":3199,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"RUT","canonicalOSIS":"Ruth","method":"official_book_intro_ref_title","sourceOSIS":"Ruth"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ruth.3.15","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ruth.3.15","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}