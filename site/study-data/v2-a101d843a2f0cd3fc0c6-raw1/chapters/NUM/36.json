"reviewed_exact_headword"],"sourceProvenanceId":"Moses","sourceTitle":"Moses"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Noah","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[{"anchorIndex":16,"href":"?bref=Num.36.1-12","rawReference":"Num.36.1-12"}],"ruleId":"Noah::Noah::reviewed_unambiguous_name","sourceHeadwordId":"Noah"},"text":"Mahlah, Tirzah, Hoglah, Milcah, and Noah, the daughters of Zelophehad, were married to cousins on their father’s side.","verse":11}],"id":"Noah","label":"Noah","matchReviews":[{"ruleId":"Noah::Noah::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Noah","term":"Noah"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Noah","sourceTitle":"Noah"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.36.1-13","r":"Num.36.1-13","rawR":"Num.36.1-13","sourceRefs":[{"raw":"Num.36.1-13","value":"Num.36.1-13"}],"t":"ref","v":"36:1-13"}],"sourceClass":"sn-ref","t":"span"}," The five daughters of Zelophehad had petitioned for, and had been granted, equitable property rights (",{"href":"?bref=Num.27.1-11","r":"Num.27.1-11","rawR":"Num.27.1-11","sourceRefs":[{"raw":"Num.27.1-11","value":"Num.27.1-11"}],"t":"ref","v":"27:1-11"},"). Here the ramifications of that decision are discussed."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.36.1-13","refs":[{"book":"NUM","endChapter":36,"endVerse":13,"startChapter":36,"startVerse":1}],"sourceAttributes":{"name":"Num.36.1-13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[36],"sourceItemFragmentSha256":"edf9420db3b870da55390d970d0b92bb0c8d7bc0b12c7b2fff01a25cf50a0a44","sourceItemName":"Num.36.1-13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2021,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.36.1-13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.36.1-13","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.36.1-4","r":"Num.36.1-4","rawR":"Num.36.1-4","sourceRefs":[{"raw":"Num.36.1-4","value":"Num.36.1-4"}],"t":"ref","v":"36:1-4"}],"sourceClass":"sn-ref","t":"span"}," Women who inherited land might ",{"c":["marry men from another tribe"],"sourceClass":"sn-excerpt","t":"span"},{"c":[";"],"sourceClass":"ital","t":"span"}," their land would then be lost by their ancestral tribe and transferred to their husband’s tribe. The Year of Jubilee (",{"href":"?bref=Lev.25.8-55","r":"Lev.25.8-55","rawR":"Lev.25.8-55","sourceRefs":[{"raw":"Lev.25.8-55","value":"Lev.25.8-55"}],"t":"ref","v":"Lev 25:8-55"},") normally provided the means for land to return to its original owner, but it pertained only to land that was sold, not to land acquired through marriage."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.36.1-4","refs":[{"book":"NUM","endChapter":36,"endVerse":4,"startChapter":36,"startVerse":1}],"sourceAttributes":{"name":"Num.36.1-4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[36],"sourceItemFragmentSha256":"28f40fe424cdefa523d9054d0bf9fb57ac1f6af9bf23e067cd386b4064663f47","sourceItemName":"Num.36.1-4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2022,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.36.1-4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.36.1-4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.36.5","r":"Num.36.5","rawR":"Num.36.5","sourceRefs":[{"raw":"Num.36.5","value":"Num.36.5"}],"t":"ref","v":"36:5"}],"sourceClass":"sn-ref","t":"span"}," The Lord readily provided the justice that ",{"c":["the men of the tribe of Joseph"],"sourceClass":"sn-excerpt","t":"span"}," (i.e., of the tribe of Manasseh, the son of Joseph) sought in their petition."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.36.5","refs":[{"book":"NUM","endChapter":36,"endVerse":5,"startChapter":36,"startVerse":5}],"sourceAttributes":{"name":"Num.36.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[36],"sourceItemFragmentSha256":"0f12663e88966ab43177f77b2d8d44fbffa13095434eee8d6237fa3ca0f7f954","sourceItemName":"Num.36.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2023,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.36.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.36.5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.36.6-9","r":"Num.36.6-9","rawR":"Num.36.6-9","sourceRefs":[{"raw":"Num.36.6-9","value":"Num.36.6-9"}],"t":"ref","v":"36:6-9"}],"sourceClass":"sn-ref","t":"span"}," These stipulations resolved the quandary, guaranteeing the stability and continuity of the tribal land allotments."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.36.6-9","refs":[{"book":"NUM","endChapter":36,"endVerse":9,"startChapter":36,"startVerse":6}],"sourceAttributes":{"name":"Num.36.6-9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[36],"sourceItemFragmentSha256":"939f61d590871aebdea1be1e6ade124b911882c351ce35eec315798ba9d302e3","sourceItemName":"Num.36.6-9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2024,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.36.6-9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.36.6-9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.36.10-12","r":"Num.36.10-12","rawR":"Num.36.10-12","sourceRefs":[{"raw":"Num.36.10-12","value":"Num.36.10-12"}],"t":"ref","v":"36:10-12"}],"sourceClass":"sn-ref","t":"span"}," As they had been instructed, Zelophehad’s five daughters ",{"c":["all married cousins on their father’s side"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," keeping their father’s allotment within his clan. Marriage to a first cousin was acceptable in ancient Hebrew society (cp. ",{"href":"?bref=Lev.18.1-30","r":"Lev.18.1-30","rawR":"Lev.18.1-30","sourceRefs":[{"raw":"Lev.18.1-30","value":"Lev.18.1-30"}],"t":"ref","v":"Lev 18"},", ",{"href":"?bref=Lev.20.1-27","r":"Lev.20.1-27","rawR":"Lev.20.1-27","sourceRefs":[{"raw":"Lev.20.1-27","value":"Lev.20.1-27"}],"t":"ref","v":"20"},"; see also ",{"href":"?bref=1Chr.23.22","r":"1Chr.23.22","rawR":"1Chr.23.22","sourceRefs":[{"raw":"1Chr.23.22","value":"1Chr.23.22"}],"t":"ref","v":"1 Chr 23:22"},") as well as in other Near Eastern cultures."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.36.10-12","refs":[{"book":"NUM","endChapter":36,"endVerse":12,"startChapter":36,"startVerse":10}],"sourceAttributes":{"name":"Num.36.10-12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[36],"sourceItemFragmentSha256":"e9b5760176ae05fed34480690cc1bd5440321f53fe1b4450362ffc74046224f5","sourceItemName":"Num.36.10-12","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2025,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.36.10-12","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.36.10-12","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.36.13","r":"Num.36.13","rawR":"Num.36.13","sourceRefs":[{"raw":"Num.36.13","value":"Num.36.13"}],"t":"ref","v":"36:13"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Commands and regulations"],"sourceClass":"sn-excerpt","t":"span"}," might refer to legal pronouncements from the whole book (cp. ",{"href":"?bref=Lev.27.34","r":"Lev.27.34","rawR":"Lev.27.34","sourceRefs":[{"raw":"Lev.27.34","value":"Lev.27.34"}],"t":"ref","v":"Lev 27:34"},") or only to those given ",{"c":["on the plains of Moab"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=Num.26.1-36.13","r":"Num.26.1-36.13","rawR":"Num.26.1-36.13","sourceRefs":[{"raw":"Num.26.1-36.13","value":"Num.26.1-36.13"}],"t":"ref","v":"Num 26–36"},"). • All that remained to make the Israelites ready to enter Canaan was for Moses to remind them of their history and covenant obligations—the subjects of the book of Deuteronomy."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.36.13","refs":[{"book":"NUM","endChapter":36,"endVerse":13,"startChapter":36,"startVerse":13}],"sourceAttributes":{"name":"Num.36.13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[36],"sourceItemFragmentSha256":"083f0e950e93b2eb529636961e384700fd9c61b67083ee5a178ef1b7cdeb192a","sourceItemName":"Num.36.13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2026,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.36.13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.36.13","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}