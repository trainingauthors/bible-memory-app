aa0f8fc30647393a1d8e49676753f1ab5a0e5e1bbac37de619f91e28af.json","title":"Deuteronomy, Book of"},"FamilyLifeandRelations":{"file":"dictionary/fac83b571d436ea0ad0c35a9a3c3261e3b465aad98d7059f5a2398702224101f.json","title":"Family Life and Relations"},"Forgiveness":{"file":"dictionary/ff8753cd2795c4274e76c9156b2341018a05aa19ead8a6f71add5d90f5dd0772.json","title":"Forgiveness"},"LawBiblicalConceptof":{"file":"dictionary/3abfe86f0add8235f7dc654a7b16bef5482eac2c4ccc84d543d4b4463992fabb.json","title":"Law, Biblical Concept of"},"Lord":{"file":"dictionary/0a54f5caa03523157b50ef58ec814d810e7db1abd5db44ec093ece07106e3447.json","title":"Lord"},"Moses":{"file":"dictionary/91ff39375ee14c7621443129210c81b1d472f29d47ddb581180392db8602873d.json","title":"Moses"},"NumbersBookof":{"file":"dictionary/dfba67e1b59192d35e290d6230bd33c973c88fbcaeb2c2a0f78a6164c8b6fe3c.json","title":"Numbers, Book of"},"VowVows":{"file":"dictionary/4dddebc541d453b6e44708c868937995c2e88ae3ff412201ba345467ddb3c669.json","title":"Vow, Vows"},"Woman":{"file":"dictionary/ff404f08b2e589f2bc12722294663882bc54bc5a7d82a1f79f9357ab7023ac23.json","title":"Woman"}},"dictionaryRelated":[{"id":"BondBondage","title":"Bond, Bondage"},{"id":"Corban","title":"Corban*"},{"id":"DeuteronomyBookof","title":"Deuteronomy, Book of"},{"id":"FamilyLifeandRelations","title":"Family Life and Relations"},{"id":"Forgiveness","title":"Forgiveness"},{"id":"LawBiblicalConceptof","title":"Law, Biblical Concept of"},{"id":"NumbersBookof","title":"Numbers, Book of"},{"id":"VowVows","title":"Vow, Vows"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Then Moses said to the heads of the tribes of Israel, “This is what the LORD has commanded:","verse":1},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"If a man makes a vow to the LORD or swears an oath to obligate himself by a pledge, he must not break his word; he must do everything he has promised.","verse":2},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"And if a woman in her father’s house during her youth makes a vow to the LORD or obligates herself by a pledge,","verse":3},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"But if her father prohibits her on the day he hears about it, then none of the vows or pledges by which she has bound herself shall stand. The LORD will absolve her because her father has prohibited her.","verse":5},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"But if her husband prohibits her when he hears of it, he nullifies the vow that binds her or the rash promise she has made, and the LORD will absolve her.","verse":8},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"But if her husband nullifies them on the day he hears of them, then nothing that came from her lips, whether her vows or pledges, shall stand. Her husband has nullified them, and the LORD will absolve her.","verse":12},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"These are the statutes that the LORD commanded Moses concerning the relationship between a man and his wife, and between a father and a young daughter still in his home.","verse":16}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Moses","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[{"anchorIndex":83,"href":"?bref=Num.28.1-30.16","rawReference":"Num.28.1-30.16"}],"ruleId":"Moses::Moses::reviewed_unambiguous_name","sourceHeadwordId":"Moses"},"text":"Then Moses said to the heads of the tribes of Israel, “This is what the LORD has commanded:","verse":1},{"matchingRule":"reviewed_exact_headword","phrase":"Moses","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[{"anchorIndex":83,"href":"?bref=Num.28.1-30.16","rawReference":"Num.28.1-30.16"}],"ruleId":"Moses::Moses::reviewed_unambiguous_name","sourceHeadwordId":"Moses"},"text":"These are the statutes that the LORD commanded Moses concerning the relationship between a man and his wife, and between a father and a young daughter still in his home.","verse":16}],"id":"Moses","label":"Moses","matchReviews":[{"ruleId":"Moses::Moses::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Moses","term":"Moses"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Moses","sourceTitle":"Moses"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"woman","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":20,"href":"?bref=Num.30.1-16","rawReference":"Num.30.1-16"}],"ruleId":"Woman::Woman::source_verse_citation","sourceHeadwordId":"Woman"},"text":"And if a woman in her father’s house during her youth makes a vow to the LORD or obligates herself by a pledge,","verse":3},{"matchingRule":"reviewed_exact_headword","phrase":"woman","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":20,"href":"?bref=Num.30.1-16","rawReference":"Num.30.1-16"}],"ruleId":"Woman::Woman::source_verse_citation","sourceHeadwordId":"Woman"},"text":"If a woman marries while under a vow or rash promise by which she has bound herself,","verse":6},{"matchingRule":"reviewed_exact_headword","phrase":"woman","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":20,"href":"?bref=Num.30.1-16","rawReference":"Num.30.1-16"}],"ruleId":"Woman::Woman::source_verse_citation","sourceHeadwordId":"Woman"},"text":"Every vow a widow or divorced woman pledges to fulfill is binding on her.","verse":9},{"matchingRule":"reviewed_exact_headword","phrase":"woman","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":20,"href":"?bref=Num.30.1-16","rawReference":"Num.30.1-16"}],"ruleId":"Woman::Woman::source_verse_citation","sourceHeadwordId":"Woman"},"text":"If a woman in her husband’s house has made a vow or put herself under an obligation with an oath,","verse":10}],"id":"Woman","label":"woman","matchReviews":[{"ruleId":"Woman::Woman::source_verse_citation","scope":"source_verse_citation","senseReview":"Reviewed original headword and source sense. This substantive word is admitted only where the original article explicitly cites the exact occurrence verse; ambiguous homographs and known context mismatches are separately excluded. This is selective contextual evidence, not an automatic rule for every same-spelling word.","sourceHeadwordId":"Woman","term":"Woman"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Woman","sourceTitle":"Woman"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.30.1-16","r":"Num.30.1-16","rawR":"Num.30.1-16","sourceRefs":[{"raw":"Num.30.1-16","value":"Num.30.1-16"}],"t":"ref","v":"30:1-16"}],"sourceClass":"sn-ref","t":"span"}," Vows were an important way to express devotion or piety, but were sometimes made in haste and were often forgotten. Voluntary pledges were commonly made on special religious occasions or in times of war. Perhaps the reference to vows and voluntary offerings (",{"href":"?bref=Num.29.39","r":"Num.29.39","rawR":"Num.29.39","sourceRefs":[{"raw":"Num.29.39","value":"Num.29.39"}],"t":"ref","v":"29:39"},") prompted the further discussion here (cp. ",{"href":"?bref=Num.15.3","r":"Num.15.3","rawR":"Num.15.3","sourceRefs":[{"raw":"Num.15.3","value":"Num.15.3"}],"t":"ref","v":"15:3"},"; see also ",{"href":"?bref=Num.6.1-21","r":"Num.6.1-21","rawR":"Num.6.1-21","sourceRefs":[{"raw":"Num.6.1-21","value":"Num.6.1-21"}],"t":"ref","v":"6:1-21"},"; ",{"href":"?bref=Lev.5.4-5","r":"Lev.5.4-5","rawR":"Lev.5.4-5","sourceRefs":[{"raw":"Lev.5.4-5","value":"Lev.5.4-5"}],"t":"ref","v":"Lev 5:4-5"},"; ",{"href":"?bref=Lev.27.1-34","r":"Lev.27.1-34","rawR":"Lev.27.1-34","sourceRefs":[{"raw":"Lev.27.1-34","value":"Lev.27.1-34"}],"t":"ref","v":"27:1-34"},"; ",{"href":"?bref=Deut.23.21-23","r":"Deut.23.21-23","rawR":"Deut.23.21-23","sourceRefs":[{"raw":"Deut.23.21-23","value":"Deut.23.21-23"}],"t":"ref","v":"Deut 23:21-23"},"). These instructions were applied in the case of Hannah and Elkanah (",{"href":"?bref=1Sam.1.1-28","r":"1Sam.1.1-28","rawR":"1Sam.1.1-28","sourceRefs":[{"raw":"1Sam.1.1-28","value":"1Sam.1.1-28"}],"t":"ref","v":"1 Sam 1:1-28"},"). Such practices, which included fasting, continued into the New Testament period (e.g., ",{"href":"?bref=Matt.6.16","r":"Matt.6.16","rawR":"Matt.6.16","sourceRefs":[{"raw":"Matt.6.16","value":"Matt.6.16"}],"t":"ref","v":"Matt 6:16"},"; ",{"href":"?bref=Matt.15.3-9","r":"Matt.15.3-9","rawR":"Matt.15.3-9","sourceRefs":[{"raw":"Matt.15.3-9","value":"Matt.15.3-9"}],"t":"ref","v":"15:3-9"},"; ",{"href":"?bref=Acts.18.18","r":"Acts.18.18","rawR":"Acts.18.18","sourceRefs":[{"raw":"Acts.18.18","value":"Acts.18.18"}],"t":"ref","v":"Acts 18:18"},"; ",{"href":"?bref=Acts.21.23","r":"Acts.21.23","rawR":"Acts.21.23","sourceRefs":[{"raw":"Acts.21.23","value":"Acts.21.23"}],"t":"ref","v":"21:23"},"). Vows of females—young and unmarried or adult and married—were subject to approval by the responsible male who would be a financial partner in the vow. Nobody, male or female, young or old, should make a vow to God and then neglect it."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.30.1-16","refs":[{"book":"NUM","endChapter":30,"endVerse":16,"startChapter":30,"startVerse":1}],"sourceAttributes":{"name":"Num.30.1-16","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[30],"sourceItemFragmentSha256":"864939aa47e465353312faf765d12cbf62854dd52082fc253b1b3c6bf18cbc26","sourceItemName":"Num.30.1-16","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1939,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.30.1-16","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.30.1-16","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.30.1-2","r":"Num.30.1-2","rawR":"Num.30.1-2","sourceRefs":[{"raw":"Num.30.1-2","value":"Num.30.1-2"}],"t":"ref","v":"30:1-2"}],"sourceClass":"sn-ref","t":"span"}," Vows included promises of offerings (e.g., Hannah’s vow, ",{"href":"?bref=1Sam.1.1-28","r":"1Sam.1.1-28","rawR":"1Sam.1.1-28","sourceRefs":[{"raw":"1Sam.1.1-28","value":"1Sam.1.1-28"}],"t":"ref","v":"1 Sam 1"},") and pledges of abstinence (e.g., the Nazirite vow, ",{"href":"?bref=Num.6.1-27","r":"Num.6.1-27","rawR":"Num.6.1-27","sourceRefs":[{"raw":"Num.6.1-27","value":"Num.6.1-27"}],"t":"ref","v":"Num 6"},"). Jesus made reference to the instruction regarding vows in the Sermon on the Mount (",{"href":"?bref=Matt.5.33","r":"Matt.5.33","rawR":"Matt.5.33","sourceRefs":[{"raw":"Matt.5.33","value":"Matt.5.33"}],"t":"ref","v":"Matt 5:33"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.30.1-2","refs":[{"book":"NUM","endChapter":30,"endVerse":2,"startChapter":30,"startVerse":1}],"sourceAttributes":{"name":"Num.30.1-2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[30],"sourceItemFragmentSha256":"475b866d2b5b3369afaccec79db2675571790fbea55a4ebc93a8a1a6cd15b130","sourceItemName":"Num.30.1-2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1940,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.30.1-2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.30.1-2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.30.3-5","r":"Num.30.3-5","rawR":"Num.30.3-5","sourceRefs":[{"raw":"Num.30.3-5","value":"Num.30.3-5"}],"t":"ref","v":"30:3-5"}],"sourceClass":"sn-ref","t":"span"}," A ",{"c":["young woman"],"sourceClass":"sn-excerpt","t":"span"}," was under the authority of ",{"c":["her father"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," who was responsible for her actions and her financial obligations."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.30.3-5","refs":[{"book":"NUM","endChapter":30,"endVerse":5,"startChapter":30,"startVerse":3}],"sourceAttributes":{"name":"Num.30.3-5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[30],"sourceItemFragmentSha256":"d82275978af747a764b548181f0f2a007680b8ee56e88c04eec2e7ee67734c56","sourceItemName":"Num.30.3-5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1941,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.30.3-5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.30.3-5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.30.6-8","r":"Num.30.6-8","rawR":"Num.30.6-8","sourceRefs":[{"raw":"Num.30.6-8","value":"Num.30.6-8"}],"t":"ref","v":"30:6-8"}],"sourceClass":"sn-ref","t":"span"}," When a ",{"c":["young"],"sourceClass":"sn-excerpt","t":"span"}," Hebrew ",{"c":["woman"],"sourceClass":"sn-excerpt","t":"span"}," married, she came under the authority of ",{"c":["her husband"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," who could void the obligations of a ",{"c":["vow or pledge"],"sourceClass":"sn-excerpt","t":"span"}," made by his wife while she was under her father’s authority by nullifying it as soon as he heard about it."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.30.6-8","refs":[{"book":"NUM","endChapter":30,"endVerse":8,"startChapter":30,"startVerse":6}],"sourceAttributes":{"name":"Num.30.6-8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[30],"sourceItemFragmentSha256":"f6ecaca36dd22f7d2fa66705cf6d9cd35cc896a7ed294dce20dbb1fd9b6bce11","sourceItemName":"Num.30.6-8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1942,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.30.6-8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.30.6-8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.30.9","r":"Num.30.9","rawR":"Num.30.9","sourceRefs":[{"raw":"Num.30.9","value":"Num.30.9"}],"t":"ref","v":"30:9"}],"sourceClass":"sn-ref","t":"span"}," A ",{"c":["widow"],"sourceClass":"sn-excerpt","t":"span"}," or a ",{"c":["divorced"],"sourceClass":"sn-excerpt","t":"span"}," woman usually returned to her father’s family (",{"href":"?bref=Lev.22.13","r":"Lev.22.13","rawR":"Lev.22.13","sourceRefs":[{"raw":"Lev.22.13","value":"Lev.22.13"}],"t":"ref","v":"Lev 22:13"},"), but a mature single woman who made a vow or pledge was required to ",{"c":["fulfill"],"sourceClass":"sn-excerpt","t":"span"}," her religious duties."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.30.9","refs":[{"book":"NUM","endChapter":30,"endVerse":9,"startChapter":30,"startVerse":9}],"sourceAttributes":{"name":"Num.30.9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[30],"sourceItemFragmentSha256":"8183ee00b870514546ad8862d0377db7f9be89e97803d4e19ba0fe0e212b8f7b","sourceItemName":"Num.30.9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1943,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.30.9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.30.9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.30.10-15","r":"Num.30.10-15","rawR":"Num.30.10-15","sourceRefs":[{"raw":"Num.30.10-15","value":"Num.30.10-15"}],"t":"ref","v":"30:10-15"}],"sourceClass":"sn-ref","t":"span"}," A ",{"c":["married"],"sourceClass":"sn-excerpt","t":"span"}," woman also needed the approval of ",{"c":["her husband"],"sourceClass":"sn-excerpt","t":"span"}," to make vows and pledges. Her husband could ",{"c":["nullify"],"sourceClass":"sn-excerpt","t":"span"}," her religious promise, but he had to make this decision on the day he heard about it. God did not hold the married woman guilty of breaking this promise if her husband cancelled it in the proper manner (cp. ",{"href":"?bref=Num.30.5","r":"Num.30.5","rawR":"Num.30.5","sourceRefs":[{"raw":"Num.30.5","value":"Num.30.5"}],"t":"ref","v":"30:5"},", ",{"href":"?bref=Num.30.8","r":"Num.30.8","rawR":"Num.30.8","sourceRefs":[{"raw":"Num.30.8","value":"Num.30.8"}],"t":"ref","v":"8"},", ",{"href":"?bref=Num.30.12","r":"Num.30.12","rawR":"Num.30.12","sourceRefs":[{"raw":"Num.30.12","value":"Num.30.12"}],"t":"ref","v":"12"},"). The self-denial mentioned in ",{"href":"?bref=Num.30.13","r":"Num.30.13","rawR":"Num.30.13","sourceRefs":[{"raw":"Num.30.13","value":"Num.30.13"}],"t":"ref","v":"30:13"}," probably refers to fasting. If he raised no objection, the husband’s silence implied consent. He could not delay in his objection, or he would incur the guilt of a broken vow (cp. ",{"href":"?bref=Lev.5.4-13","r":"Lev.5.4-13","rawR":"Lev.5.4-13","sourceRefs":[{"raw":"Lev.5.4-13","value":"Lev.5.4-13"}],"t":"ref","v":"Lev 5:4-13"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.30.10-15","refs":[{"book":"NUM","endChapter":30,"endVerse":15,"startChapter":30,"startVerse":10}],"sourceAttributes":{"name":"Num.30.10-15","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[30],"sourceItemFragmentSha256":"97dcede3acd38ce3d6ed0888f9b38e782c0f931ad1d5729f0fa6068e61a86290","sourceItemName":"Num.30.10-15","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1944,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.30.10-15","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.30.10-15","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}