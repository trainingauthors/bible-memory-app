m.16.1-17.13","rawR":"Num.16.1-17.13","sourceRefs":[{"raw":"Num.16.1-17.13","value":"Num.16.1-17.13"}],"t":"ref","v":"16:1–17:13"}],"sourceClass":"sn-ref","t":"span"}," Another rebellion called for a clear delineation of the duties of priests and Levites. This power struggle was a more serious challenge than any of the previous rebellions against God’s authority (ch ",{"href":"?bref=Num.11.1-35","r":"Num.11.1-35","rawR":"Num.11.1-35","sourceRefs":[{"raw":"Num.11.1-35","value":"Num.11.1-35"}],"t":"ref","v":"11"},"; ",{"href":"?bref=Num.12.1-15","r":"Num.12.1-15","rawR":"Num.12.1-15","sourceRefs":[{"raw":"Num.12.1-15","value":"Num.12.1-15"}],"t":"ref","v":"12:1-15"},"; ",{"href":"?bref=Num.14.1-45","r":"Num.14.1-45","rawR":"Num.14.1-45","sourceRefs":[{"raw":"Num.14.1-45","value":"Num.14.1-45"}],"t":"ref","v":"14:1-45"},"). As in all of these historical episodes, the coconspirators protested relatively minor issues and questioned the actions of their leaders, but Moses reminded them that they were really rebelling against God. Once again, the Israelites suffered the deadly consequences of their rebellion."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.16.1-17.13","refs":[{"book":"NUM","endChapter":17,"endVerse":13,"startChapter":16,"startVerse":1}],"sourceAttributes":{"name":"Num.16.1-17.13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[16,17],"sourceItemFragmentSha256":"20c182338d9bfc0c1fe3582226feedb0b31d6062d282071f3883e8751f5a8ae9","sourceItemName":"Num.16.1-17.13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1761,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.16.1-17.13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.16.1-17.13","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.17.1-13","r":"Num.17.1-13","rawR":"Num.17.1-13","sourceRefs":[{"raw":"Num.17.1-13","value":"Num.17.1-13"}],"t":"ref","v":"17:1-13"}],"sourceClass":"sn-ref","t":"span"}," The Lord prescribed another trial to reinforce the lessons taught by the incidents in ch ",{"href":"?bref=Num.16.1-50","r":"Num.16.1-50","rawR":"Num.16.1-50","sourceRefs":[{"raw":"Num.16.1-50","value":"Num.16.1-50"}],"t":"ref","v":"16"}," and to introduce the instructions of ch ",{"href":"?bref=Num.18.1-32","r":"Num.18.1-32","rawR":"Num.18.1-32","sourceRefs":[{"raw":"Num.18.1-32","value":"Num.18.1-32"}],"t":"ref","v":"18"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.17.1-13","refs":[{"book":"NUM","endChapter":17,"endVerse":13,"startChapter":17,"startVerse":1}],"sourceAttributes":{"name":"Num.17.1-13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[17],"sourceItemFragmentSha256":"68fe82874098f0f3b0cd7d4548bfaccfcd200f46e3f1311c366de595e7e1ed18","sourceItemName":"Num.17.1-13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1782,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.17.1-13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.17.1-13","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.17.1-5","r":"Num.17.1-5","rawR":"Num.17.1-5","sourceRefs":[{"raw":"Num.17.1-5","value":"Num.17.1-5"}],"t":"ref","v":"17:1-5"}],"sourceClass":"sn-ref","t":"span"}," The shepherd’s staff was a common possession (cp. ",{"href":"?bref=Ps.23.4","r":"Ps.23.4","rawR":"Ps.23.4","sourceRefs":[{"raw":"Ps.23.4","value":"Ps.23.4"}],"t":"ref","v":"Ps 23:4"},") and, like the scepter, was a symbol of authority (cp. ",{"href":"?bref=Jer.48.17","r":"Jer.48.17","rawR":"Jer.48.17","sourceRefs":[{"raw":"Jer.48.17","value":"Jer.48.17"}],"t":"ref","v":"Jer 48:17"},"). This trial was especially appropriate because the Hebrew words translated ",{"c":["staffs"],"sourceClass":"sn-excerpt","t":"span"}," and ",{"c":["tribes"],"sourceClass":"sn-excerpt","t":"span"}," are homonyms; the Lord’s choice of staff would indicate his choice of tribe."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.17.1-5","refs":[{"book":"NUM","endChapter":17,"endVerse":5,"startChapter":17,"startVerse":1}],"sourceAttributes":{"name":"Num.17.1-5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[17],"sourceItemFragmentSha256":"593933af5667d04f8c8eb807a334c36a9290f317875031a1f8403825fe68ae51","sourceItemName":"Num.17.1-5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1783,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.17.1-5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.17.1-5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.17.4","r":"Num.17.4","rawR":"Num.17.4","sourceRefs":[{"raw":"Num.17.4","value":"Num.17.4"}],"t":"ref","v":"17:4"}],"sourceClass":"sn-ref","t":"span"}," The staffs were in the Lord’s presence (",{"href":"?bref=Num.17.7","r":"Num.17.7","rawR":"Num.17.7","sourceRefs":[{"raw":"Num.17.7","value":"Num.17.7"}],"t":"ref","v":"17:7"},"), a safe spot where no one would tamper with them."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.17.4","refs":[{"book":"NUM","endChapter":17,"endVerse":4,"startChapter":17,"startVerse":4}],"sourceAttributes":{"name":"Num.17.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[17],"sourceItemFragmentSha256":"b7f83e56dd3c95a43a344c27d55f3ee6974bbef08e82ade9b5b1bde4abc5dcef","sourceItemName":"Num.17.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1784,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.17.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.17.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.17.8","r":"Num.17.8","rawR":"Num.17.8","sourceRefs":[{"raw":"Num.17.8","value":"Num.17.8"}],"t":"ref","v":"17:8"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Aaron’s staff . . . produced ripe almonds!"],"sourceClass":"sn-excerpt","t":"span"}," This was more than enough proof that Aaron was God’s chosen leader and that the Levites held a special position. The cups on the Tabernacle’s lampstand were shaped like almond blossoms (",{"href":"?bref=Exod.25.33-36","r":"Exod.25.33-36","rawR":"Exod.25.33-36","sourceRefs":[{"raw":"Exod.25.33-36","value":"Exod.25.33-36"}],"t":"ref","v":"Exod 25:33-36"},"). Later, Jeremiah’s vision of an almond branch represented the Lord’s vigil and his intention to carry out his plans (see ",{"href":"?bref=Jer.1.11-12","r":"Jer.1.11-12","rawR":"Jer.1.11-12","sourceRefs":[{"raw":"Jer.1.11-12","value":"Jer.1.11-12"}],"t":"ref","v":"Jer 1:11-12"},"). • There is no natural explanation for the budding of Aaron’s staff. Almond wood is soft while alive and only becomes hard enough for use as a staff long after it has been cut off and allowed to dry."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.17.8","refs":[{"book":"NUM","endChapter":17,"endVerse":8,"startChapter":17,"startVerse":8}],"sourceAttributes":{"name":"Num.17.8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[17],"sourceItemFragmentSha256":"4ededad1bfcce65852ceceebd1bff68ee057aa100fce5a55ac6bf07d0c52aed0","sourceItemName":"Num.17.8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1785,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.17.8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.17.8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.17.9-11","r":"Num.17.9-11","rawR":"Num.17.9-11","sourceRefs":[{"raw":"Num.17.9-11","value":"Num.17.9-11"}],"t":"ref","v":"17:9-11"}],"sourceClass":"sn-ref","t":"span"}," After each tribal leader ",{"c":["claimed his own staff"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," it was clear that ",{"c":["Aaron’s"],"sourceClass":"sn-excerpt","t":"span"}," deserved special treatment. It was placed ",{"c":["permanently before the Ark"],"sourceClass":"sn-excerpt","t":"span"}," to warn potential ",{"c":["rebels"],"sourceClass":"sn-excerpt","t":"span"}," and to deter Israelites who complained about the Lord and his appointed leaders. The Ark eventually contained this staff, a jar of manna, and the stone tablets of the law (cp. ",{"href":"?bref=Heb.9.4","r":"Heb.9.4","rawR":"Heb.9.4","sourceRefs":[{"raw":"Heb.9.4","value":"Heb.9.4"}],"t":"ref","v":"Heb 9:4"},") to remind the Israelites of their wilderness wanderings."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.17.9-11","refs":[{"book":"NUM","endChapter":17,"endVerse":11,"startChapter":17,"startVerse":9}],"sourceAttributes":{"name":"Num.17.9-11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[17],"sourceItemFragmentSha256":"60998fd8dac369be74c9150e109f5aa11d0a4b2ec0f35250f3801d2f2fd565ba","sourceItemName":"Num.17.9-11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1786,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.17.9-11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.17.9-11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.17.12-13","r":"Num.17.12-13","rawR":"Num.17.12-13","sourceRefs":[{"raw":"Num.17.12-13","value":"Num.17.12-13"}],"t":"ref","v":"17:12-13"}],"sourceClass":"sn-ref","t":"span"}," The Lord and his Tabernacle were holy, and because of God’s holiness, his sanctuary could be a dangerous place for those who were not qualified to enter it. Moses’ efforts to make the people understand and respect the God of Israel were bearing fruit."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.17.12-13","refs":[{"book":"NUM","endChapter":17,"endVerse":13,"startChapter":17,"startVerse":12}],"sourceAttributes":{"name":"Num.17.12-13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[17],"sourceItemFragmentSha256":"d7a7dda717936dec62d06f5c06438f8155bbb78ac4c686540ae64743f388535f","sourceItemName":"Num.17.12-13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1787,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.17.12-13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.17.12-13","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}