::reviewed_publisher_redirect","sourceHeadwordId":"SinOffering"},"text":"Include one male goat as a sin offering to make atonement for you.","verse":22},{"matchingRule":"source_verified_redirect","phrase":"drink offering","senseEvidence":{"basis":"reviewed_publisher_redirect","originalCitations":[],"ruleId":"OfferingsandSacrifices::Drink Offering::reviewed_publisher_redirect","sourceHeadwordId":"DrinkOffering"},"text":"Offer the same food each day for seven days as a food offering, a pleasing aroma to the LORD. It is to be offered with its drink offering and the regular burnt offering.","verse":24}],"id":"OfferingsandSacrifices","label":"drink offering","matchReviews":[{"ruleId":"OfferingsandSacrifices::Drink Offering::reviewed_publisher_redirect","scope":"reviewed_publisher_redirect","senseReview":"The original publisher explicitly links this complete unambiguous name/phrase to this target. Redirect and target were reviewed once; actual BSB phrase and full word boundaries required. Target original title and complete article remain unchanged.","sourceHeadwordId":"DrinkOffering","term":"Drink Offering"},{"ruleId":"OfferingsandSacrifices::Sin Offering::reviewed_publisher_redirect","scope":"reviewed_publisher_redirect","senseReview":"The original publisher explicitly links this complete unambiguous name/phrase to this target. Redirect and target were reviewed once; actual BSB phrase and full word boundaries required. Target original title and complete article remain unchanged.","sourceHeadwordId":"SinOffering","term":"Sin Offering"}],"matchingRule":"source_verified_redirect","matchingRules":["source_verified_redirect"],"sourceProvenanceId":"OfferingsandSacrifices","sourceTitle":"Offerings and Sacrifices"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Then the LORD said to Moses,","verse":1},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"And tell them that this is the food offering you are to present to the LORD as a regular burnt offering each day: two unblemished year-old male lambs.","verse":3},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"This is a regular burnt offering established at Mount Sinai as a pleasing aroma, a food offering to the LORD.","verse":6},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"The drink offering accompanying each lamb shall be a quarter hin. Pour out the offering of fermented drink to the LORD in the sanctuary area.","verse":7},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"And offer the second lamb at twilight, with the same grain offering and drink offering as in the morning. It is a food offering, a pleasing aroma to the LORD.","verse":8},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"At the beginning of every month, you are to present to the LORD a burnt offering of two young bulls, one ram, and seven male lambs a year old, all unblemished,","verse":11},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"and a tenth of an ephah of fine flour mixed with oil as a grain offering with each lamb. This is a burnt offering, a pleasing aroma, a food offering to the LORD.","verse":13},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"In addition to the regular burnt offering with its drink offering, one male goat is to be presented to the LORD as a sin offering.","verse":15},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"The fourteenth day of the first month is the LORD’s Passover.","verse":16},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Present to the LORD a food offering, a burnt offering of two young bulls, one ram, and seven male lambs a year old, all unblemished.","verse":19},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Offer the same food each day for seven days as a food offering, a pleasing aroma to the LORD. It is to be offered with its drink offering and the regular burnt offering.","verse":24},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"On the day of firstfruits, when you present an offering of new grain to the LORD during the Feast of Weeks, you are to hold a sacred assembly; you must not do any regular work.","verse":26},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Present a burnt offering of two young bulls, one ram, and seven male lambs a year old as a pleasing aroma to the LORD,","verse":27}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Moses","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[{"anchorIndex":83,"href":"?bref=Num.28.1-30.16","rawReference":"Num.28.1-30.16"}],"ruleId":"Moses::Moses::reviewed_unambiguous_name","sourceHeadwordId":"Moses"},"text":"Then the LORD said to Moses,","verse":1}],"id":"Moses","label":"Moses","matchReviews":[{"ruleId":"Moses::Moses::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Moses","term":"Moses"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Moses","sourceTitle":"Moses"},{"evidence":[{"matchingRule":"source_verified_redirect","phrase":"Mount Sinai","senseEvidence":{"basis":"reviewed_publisher_redirect","originalCitations":[],"ruleId":"SinaSinai::Mount Sinai::reviewed_publisher_redirect","sourceHeadwordId":"MountSinai"},"text":"This is a regular burnt offering established at Mount Sinai as a pleasing aroma, a food offering to the LORD.","verse":6}],"id":"SinaSinai","label":"Mount Sinai","matchReviews":[{"ruleId":"SinaSinai::Mount Sinai::reviewed_publisher_redirect","scope":"reviewed_publisher_redirect","senseReview":"The original publisher explicitly links this complete unambiguous name/phrase to this target. Redirect and target were reviewed once; actual BSB phrase and full word boundaries required. Target original title and complete article remain unchanged.","sourceHeadwordId":"MountSinai","term":"Mount Sinai"}],"matchingRule":"source_verified_redirect","matchingRules":["source_verified_redirect"],"sourceProvenanceId":"SinaSinai","sourceTitle":"Sina*, Sinai"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.28.1-29.40","r":"Num.28.1-29.40","rawR":"Num.28.1-29.40","sourceRefs":[{"raw":"Num.28.1-29.40","value":"Num.28.1-29.40"}],"t":"ref","v":"28:1–29:40"}],"sourceClass":"sn-ref","t":"span"}," These two chapters contain information about Israel’s ritual calendar, including a list of required daily, weekly, and monthly offerings and a list of annual religious events. Thus Israel was instructed to worship God “properly and in order” (",{"href":"?bref=1Cor.14.40","r":"1Cor.14.40","rawR":"1Cor.14.40","sourceRefs":[{"raw":"1Cor.14.40","value":"1Cor.14.40"}],"t":"ref","v":"1 Cor 14:40"},"). The annual cycle of sacrifices involved a tremendous investment of animals, grain, oil, and wine. Israel marked these special days by stopping their normal work, a kind of sacrifice that recognized the importance of these holy days. This annual cycle included eight different occasions for worship, all of which recalled Israel’s relationship with the Lord. Each worship event included a different combination of burnt, grain, liquid, and/or sin offerings. • For details on the grain and liquid offerings, see ",{"href":"?bref=Num.15.1-16","r":"Num.15.1-16","rawR":"Num.15.1-16","sourceRefs":[{"raw":"Num.15.1-16","value":"Num.15.1-16"}],"t":"ref","v":"Num 15:1-16"},". For explanations of the different types of offerings, see ",{"href":"?bref=Lev.1.1-7.38","r":"Lev.1.1-7.38","rawR":"Lev.1.1-7.38","sourceRefs":[{"raw":"Lev.1.1-7.38","value":"Lev.1.1-7.38"}],"t":"ref","v":"Lev 1:1–7:38"},". For a description of Israel’s festivals, see ",{"href":"?bref=Lev.23.1-44","r":"Lev.23.1-44","rawR":"Lev.23.1-44","sourceRefs":[{"raw":"Lev.23.1-44","value":"Lev.23.1-44"}],"t":"ref","v":"Lev 23:1-44"},". For the New Testament perspective on the Old Testament sacrificial system, see ",{"href":"?bref=John.1.29","r":"John.1.29","rawR":"John.1.29","sourceRefs":[{"raw":"John.1.29","value":"John.1.29"}],"t":"ref","v":"John 1:29"},"; ",{"href":"?bref=Rom.12.1","r":"Rom.12.1","rawR":"Rom.12.1","sourceRefs":[{"raw":"Rom.12.1","value":"Rom.12.1"}],"t":"ref","v":"Rom 12:1"},"; ",{"href":"?bref=Heb.9.9-15","r":"Heb.9.9-15","rawR":"Heb.9.9-15","sourceRefs":[{"raw":"Heb.9.9-15","value":"Heb.9.9-15"}],"t":"ref","v":"Heb 9:9-15"},"; ",{"href":"?bref=Heb.10.1-2","r":"Heb.10.1-2","rawR":"Heb.10.1-2","sourceRefs":[{"raw":"Heb.10.1-2","value":"Heb.10.1-2"}],"t":"ref","v":"10:1-2"},"; ",{"href":"?bref=1Pet.2.5","r":"1Pet.2.5","rawR":"1Pet.2.5","sourceRefs":[{"raw":"1Pet.2.5","value":"1Pet.2.5"}],"t":"ref","v":"1 Pet 2:5"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.28.1-29.40","refs":[{"book":"NUM","endChapter":29,"endVerse":40,"startChapter":28,"startVerse":1}],"sourceAttributes":{"name":"Num.28.1-29.40","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[28,29],"sourceItemFragmentSha256":"55f5a986f930b07fc4d14f5af30eb4b821a7e37b9e1dadddce4db5874035d0da","sourceItemName":"Num.28.1-29.40","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1926,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.28.1-29.40","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.28.1-29.40","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.28.1-2","r":"Num.28.1-2","rawR":"Num.28.1-2","sourceRefs":[{"raw":"Num.28.1-2","value":"Num.28.1-2"}],"t":"ref","v":"28:1-2"}],"sourceClass":"sn-ref","t":"span"}," The Lord accepted ",{"c":["special gifts"],"sourceClass":"sn-excerpt","t":"span"}," (cp. ",{"href":"?bref=Num.15.3","r":"Num.15.3","rawR":"Num.15.3","sourceRefs":[{"raw":"Num.15.3","value":"Num.15.3"}],"t":"ref","v":"15:3"},") as ",{"c":["a pleasing aroma"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," a figurative expression describing God’s acceptance and enjoyment of these gifts (see also ",{"href":"?bref=Gen.8.21","r":"Gen.8.21","rawR":"Gen.8.21","sourceRefs":[{"raw":"Gen.8.21","value":"Gen.8.21"}],"t":"ref","v":"Gen 8:21"},"; ",{"href":"?bref=Lev.1.9","r":"Lev.1.9","rawR":"Lev.1.9","sourceRefs":[{"raw":"Lev.1.9","value":"Lev.1.9"}],"t":"ref","v":"Lev 1:9"},"; ",{"href":"?bref=Eph.5.2","r":"Eph.5.2","rawR":"Eph.5.2","sourceRefs":[{"raw":"Eph.5.2","value":"Eph.5.2"}],"t":"ref","v":"Eph 5:2"},"; ",{"href":"?bref=Phil.4.18","r":"Phil.4.18","rawR":"Phil.4.18","sourceRefs":[{"raw":"Phil.4.18","value":"Phil.4.18"}],"t":"ref","v":"Phil 4:18"},"). Offerings were made at ",{"c":["appointed times"],"sourceClass":"sn-excerpt","t":"span"}," according to specific ",{"c":["instructions"],"sourceClass":"sn-excerpt","t":"span"}," (see ",{"href":"?bref=Num.28.3-29.39","r":"Num.28.3-29.39","rawR":"Num.28.3-29.39","sourceRefs":[{"raw":"Num.28.3-29.39","value":"Num.28.3-29.39"}],"t":"ref","v":"Num 28:3–29:39"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.28.1-2","refs":[{"book":"NUM","endChapter":28,"endVerse":2,"startChapter":28,"startVerse":1}],"sourceAttributes":{"name":"Num.28.1-2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[28],"sourceItemFragmentSha256":"19c1a65de2c2417bec4f8420066b56c3af5309163547553550cb90334d574df9","sourceItemName":"Num.28.1-2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1927,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.28.1-2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.28.1-2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.28.2","r":"Num.28.2","rawR":"Num.28.2","sourceRefs":[{"raw":"Num.28.2","value":"Num.28.2"}],"t":"ref","v":"28:2"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["they are my food:"],"sourceClass":"sn-excerpt","t":"span"}," See study notes on ",{"href":"?item=Exod.29.18_StudyNote_Filament","id":"Exod.29.18_StudyNote_Filament","rawId":"Exod.29.18_StudyNote_Filament","t":"link","v":"Exod 29:18"},"; ",{"href":"?item=Deut.8.2_StudyNote_Filament","id":"Deut.8.2_StudyNote_Filament","rawId":"Deut.8.2_StudyNote_Filament","t":"link","v":"Deut 8:2"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.28.2","refs":[{"book":"NUM","endChapter":28,"endVerse":2,"startChapter":28,"startVerse":2}],"sourceAttributes":{"name":"Num.28.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[28],"sourceItemFragmentSha256":"b6609ccade12b968e08f0d4818affce140b915c104b1183b0552862ed3505fba","sourceItemName":"Num.28.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1928,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.28.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.28.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.28.3-8","r":"Num.28.3-8","rawR":"Num.28.3-8","sourceRefs":[{"raw":"Num.28.3-8","value":"Num.28.3-8"}],"t":"ref","v":"28:3-8"}],"sourceClass":"sn-ref","t":"span"}," The daily offering was the foundation of the sacrificial system. Its practice was ",{"c":["instituted at Mount Sinai"],"sourceClass":"sn-excerpt","t":"span"}," (see ",{"href":"?bref=Exod.29.38-46","r":"Exod.29.38-46","rawR":"Exod.29.38-46","sourceRefs":[{"raw":"Exod.29.38-46","value":"Exod.29.38-46"}],"t":"ref","v":"Exod 29:38-46"},"). • ",{"c":["alcoholic drink:"],"sourceClass":"sn-excerpt","t":"span"}," Cp. ",{"href":"?bref=Num.6.3","r":"Num.6.3","rawR":"Num.6.3","sourceRefs":[{"raw":"Num.6.3","value":"Num.6.3"}],"t":"ref","v":"Num 6:3"},"; ",{"href":"?bref=Lev.10.9","r":"Lev.10.9","rawR":"Lev.10.9","sourceRefs":[{"raw":"Lev.10.9","value":"Lev.10.9"}],"t":"ref","v":"Lev 10:9"},"; ",{"href":"?bref=Deut.14.26","r":"Deut.14.26","rawR":"Deut.14.26","sourceRefs":[{"raw":"Deut.14.26","value":"Deut.14.26"}],"t":"ref","v":"Deut 14:26"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.28.3-8","refs":[{"book":"NUM","endChapter":28,"endVerse":8,"startChapter":28,"startVerse":3}],"sourceAttributes":{"name":"Num.28.3-8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[28],"sourceItemFragmentSha256":"3b1d9fdab8d4d4d7de6a3ff693250391c31d5f5932babe774f607cbd3f5b6d2f","sourceItemName":"Num.28.3-8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1929,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.28.3-8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.28.3-8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.28.9-10","r":"Num.28.9-10","rawR":"Num.28.9-10","sourceRefs":[{"raw":"Num.28.9-10","value":"Num.28.9-10"}],"t":"ref","v":"28:9-10"}],"sourceClass":"sn-ref","t":"span"}," Special days called for additional offerings. The ",{"c":["Sabbath day"],"sourceClass":"sn-excerpt","t":"span"}," required a sacrifice over and above the ",{"c":["regular burnt offering and its accompanying liquid offering"],"sourceClass":"sn-excerpt","t":"span"},". Other passages highlight the importance of the Sabbath (e.g., ",{"href":"?bref=Exod.20.8-11","r":"Exod.20.8-11","rawR":"Exod.20.8-11","sourceRefs":[{"raw":"Exod.20.8-11","value":"Exod.20.8-11"}],"t":"ref","v":"Exod 20:8-11"},"; ",{"href":"?bref=Lev.23.3","r":"Lev.23.3","rawR":"Lev.23.3","sourceRefs":[{"raw":"Lev.23.3","value":"Lev.23.3"}],"t":"ref","v":"Lev 23:3"},"; ",{"href":"?bref=Deut.5.12-15","r":"Deut.5.12-15","rawR":"Deut.5.12-15","sourceRefs":[{"raw":"Deut.5.12-15","value":"Deut.5.12-15"}],"t":"ref","v":"Deut 5:12-15"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.28.9-10","refs":[{"book":"NUM","endChapter":28,"endVerse":10,"startChapter":28,"startVerse":9}],"sourceAttributes":{"name":"Num.28.9-10","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[28],"sourceItemFragmentSha256":"b02d0b4031e7d041ade91de2f07dd0a172833c241c7ad2de41bc07ae9e4c241a","sourceItemName":"Num.28.9-10","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1930,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.28.9-10","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.28.9-10","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.28.11-15","r":"Num.28.11-15","rawR":"Num.28.11-15","sourceRefs":[{"raw":"Num.28.11-15","value":"Num.28.11-15"}],"t":"ref","v":"28:11-15"}],"sourceClass":"sn-ref","t":"span"}," The offering of the ",{"c":["first day of each month"],"sourceClass":"sn-excerpt","t":"span"},"—the New Moon—called for the sacrifice of bulls, rams, and lambs as burnt offerings, along with a male goat as a sin offering."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.28.11-15","refs":[{"book":"NUM","endChapter":28,"endVerse":15,"startChapter":28,"startVerse":11}],"sourceAttributes":{"name":"Num.28.11-15","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[28],"sourceItemFragmentSha256":"0f80f79ed85d9bd32741f02a933a66548ec216eda2f1fa10c46227159a6dd98f","sourceItemName":"Num.28.11-15","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1931,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.28.11-15","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.28.11-15","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.28.16-25","r":"Num.28.16-25","rawR":"Num.28.16-25","sourceRefs":[{"raw":"Num.28.16-25","value":"Num.28.16-25"}],"t":"ref","v":"28:16-25"}],"sourceClass":"sn-ref","t":"span"}," The Passover, followed by the Festival of Unleavened Bread, was the first of five great annual festivals; it was held in early spring (March~April). The Passover required no public sacrifices—it was a family occasion celebrated at home (see also ",{"href":"?bref=Num.9.1-4","r":"Num.9.1-4","rawR":"Num.9.1-4","sourceRefs":[{"raw":"Num.9.1-4","value":"Num.9.1-4"}],"t":"ref","v":"9:1-4"},"; ",{"href":"?bref=Exod.12.1-13.10","r":"Exod.12.1-13.10","rawR":"Exod.12.1-13.10","sourceRefs":[{"raw":"Exod.12.1-13.10","value":"Exod.12.1-13.10"}],"t":"ref","v":"Exod 12:1–13:10"},"; ",{"href":"?bref=Lev.23.5-8","r":"Lev.23.5-8","rawR":"Lev.23.5-8","sourceRefs":[{"raw":"Lev.23.5-8","value":"Lev.23.5-8"}],"t":"ref","v":"Lev 23:5-8"},"; ",{"href":"?bref=Deut.16.1-8","r":"Deut.16.1-8","rawR":"Deut.16.1-8","sourceRefs":[{"raw":"Deut.16.1-8","value":"Deut.16.1-8"}],"t":"ref","v":"Deut 16:1-8"},"). This festival played a special role in the background of the Last Supper (see ",{"href":"?bref=Matt.26.17-19","r":"Matt.26.17-19","rawR":"Matt.26.17-19","sourceRefs":[{"raw":"Matt.26.17-19","value":"Matt.26.17-19"}],"t":"ref","v":"Matt 26:17-19"},", ",{"href":"?bref=Matt.26.26-27","r":"Matt.26.26-27","rawR":"Matt.26.26-27","sourceRefs":[{"raw":"Matt.26.26-27","value":"Matt.26.26-27"}],"t":"ref","v":"26-27"},"; ",{"href":"?bref=Mark.14.12","r":"Mark.14.12","rawR":"Mark.14.12","sourceRefs":[{"raw":"Mark.14.12","value":"Mark.14.12"}],"t":"ref","v":"Mark 14:12"},"; ",{"href":"?bref=John.11.55","r":"John.11.55","rawR":"John.11.55","sourceRefs":[{"raw":"John.11.55","value":"John.11.55"}],"t":"ref","v":"John 11:55"},"; ",{"href":"?bref=John.12.1","r":"John.12.1","rawR":"John.12.1","sourceRefs":[{"raw":"John.12.1","value":"John.12.1"}],"t":"ref","v":"12:1"},"; ",{"href":"?bref=John.13.1","r":"John.13.1","rawR":"John.13.1","sourceRefs":[{"raw":"John.13.1","value":"John.13.1"}],"t":"ref","v":"13:1"},"; ",{"href":"?bref=John.18.28","r":"John.18.28","rawR":"John.18.28","sourceRefs":[{"raw":"John.18.28","value":"John.18.28"}],"t":"ref","v":"18:28"},", ",{"href":"?bref=John.18.39","r":"John.18.39","rawR":"John.18.39","sourceRefs":[{"raw":"John.18.39","value":"John.18.39"}],"t":"ref","v":"39"},"; ",{"href":"?bref=John.19.14","r":"John.19.14","rawR":"John.19.14","sourceRefs":[{"raw":"John.19.14","value":"John.19.14"}],"t":"ref","v":"19:14"},", ",{"href":"?bref=John.19.31","r":"John.19.31","rawR":"John.19.31","sourceRefs":[{"raw":"John.19.31","value":"John.19.31"}],"t":"ref","v":"31"},"; cp. ",{"href":"?bref=1Cor.5.7","r":"1Cor.5.7","rawR":"1Cor.5.7","sourceRefs":[{"raw":"1Cor.5.7","value":"1Cor.5.7"}],"t":"ref","v":"1 Cor 5:7"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.28.16-25","refs":[{"book":"NUM","endChapter":28,"endVerse":25,"startChapter":28,"startVerse":16}],"sourceAttributes":{"name":"Num.28.16-25","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[28],"sourceItemFragmentSha256":"af50e6098f55e2bea6600d7787b80ef8a49eb0452a1e842092ed16758e1c9517","sourceItemName":"Num.28.16-25","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1932,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.28.16-25","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.28.16-25","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.28.26-31","r":"Num.28.26-31","rawR":"Num.28.26-31","sourceRefs":[{"raw":"Num.28.26-31","value":"Num.28.26-31"}],"t":"ref","v":"28:26-31"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["Festival of Harvest"],"sourceClass":"sn-excerpt","t":"span"}," was later called the Festival of Pentecost (see ",{"href":"?bref=Acts.2.1","r":"Acts.2.1","rawR":"Acts.2.1","sourceRefs":[{"raw":"Acts.2.1","value":"Acts.2.1"}],"t":"ref","v":"Acts 2:1"},"); see also ",{"href":"?bref=Lev.23.15-22","r":"Lev.23.15-22","rawR":"Lev.23.15-22","sourceRefs":[{"raw":"Lev.23.15-22","value":"Lev.23.15-22"}],"t":"ref","v":"Lev 23:15-22"},". It celebrated the end of the barley harvest and the beginning of the wheat harvest in early summer (May~June). The Greek name ",{"c":["Pentecost"],"sourceClass":"ital","t":"span"}," means “fiftieth day” (i.e., after Passover; see ",{"href":"?bref=Acts.20.16","r":"Acts.20.16","rawR":"Acts.20.16","sourceRefs":[{"raw":"Acts.20.16","value":"Acts.20.16"}],"t":"ref","v":"Acts 20:16"},"; ",{"href":"?bref=1Cor.16.8","r":"1Cor.16.8","rawR":"1Cor.16.8","sourceRefs":[{"raw":"1Cor.16.8","value":"1Cor.16.8"}],"t":"ref","v":"1 Cor 16:8"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.28.26-31","refs":[{"book":"NUM","endChapter":28,"endVerse":31,"startChapter":28,"startVerse":26}],"sourceAttributes":{"name":"Num.28.26-31","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[28],"sourceItemFragmentSha256":"4ed785dae3f934d3cb5e602ff543f09becd9802719447cf29c1ac1cf975d6188","sourceItemName":"Num.28.26-31","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1933,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.28.26-31","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.28.26-31","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}