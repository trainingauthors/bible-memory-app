le":"Joshua, Book of"},{"id":"MalachiBookof","title":"Malachi, Book of"},{"id":"MidianMidianite","title":"Midian, Midianite"},{"id":"MoabMoabites","title":"Moab, Moabites"},{"id":"Nicolaitans","title":"Nicolaitans"},{"id":"NumbersBookof","title":"Numbers, Book of"},{"id":"PeorDeity","title":"Peor (Deity)"},{"id":"PeorPlace","title":"Peor (Place)"},{"id":"Phinehas","title":"Phinehas"},{"id":"ProstituteProstitution","title":"Prostitute, Prostitution"},{"id":"Salu","title":"Salu"},{"id":"ShittimPlace","title":"Shittim* (Place)"},{"id":"ZimriPerson","title":"Zimri (Person)"},{"id":"Zur","title":"Zur"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Aaron","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Aaron::Aaron::reviewed_unambiguous_name","sourceHeadwordId":"Aaron"},"text":"On seeing this, Phinehas son of Eleazar, the son of Aaron the priest, got up from the assembly, took a spear in his hand,","verse":7},{"matchingRule":"reviewed_exact_headword","phrase":"Aaron","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Aaron::Aaron::reviewed_unambiguous_name","sourceHeadwordId":"Aaron"},"text":"“Phinehas son of Eleazar, the son of Aaron the priest, has turned My wrath away from the Israelites; for he was zealous for My sake among them, so that I did not consume the Israelites in My zeal.","verse":11}],"id":"Aaron","label":"Aaron","matchReviews":[{"ruleId":"Aaron::Aaron::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Aaron","term":"Aaron"}],"ma