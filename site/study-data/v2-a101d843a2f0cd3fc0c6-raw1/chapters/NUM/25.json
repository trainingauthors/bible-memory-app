reviewed_exact_headword","phrase":"Moses","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Moses::Moses::reviewed_unambiguous_name","sourceHeadwordId":"Moses"},"text":"Then the LORD said to Moses, “Take all the leaders of the people and execute them in broad daylight before the LORD, so that His fierce anger may turn away from Israel.”","verse":4},{"matchingRule":"reviewed_exact_headword","phrase":"Moses","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Moses::Moses::reviewed_unambiguous_name","sourceHeadwordId":"Moses"},"text":"So Moses told the judges of Israel, “Each of you must kill all of his men who have joined in worshiping Baal of Peor.”","verse":5},{"matchingRule":"reviewed_exact_headword","phrase":"Moses","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Moses::Moses::reviewed_unambiguous_name","sourceHeadwordId":"Moses"},"text":"Just then an Israelite man brought to his family a Midianite woman in the sight of Moses and the whole congregation of Israel while they were weeping at the entrance to the Tent of Meeting.","verse":6},{"matchingRule":"reviewed_exact_headword","phrase":"Moses","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Moses::Moses::reviewed_unambiguous_name","sourceHeadwordId":"Moses"},"text":"Then the LORD said to Moses,","verse":10},{"matchingRule":"reviewed_exact_headword","phrase":"Moses","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Moses::Moses::reviewed_unambiguous_name","sourceHeadwordId":"Moses"},"text":"And the LORD said to Moses,","verse":16}],"id":"Moses","label":"Moses","matchReviews":[{"ruleId":"Moses::Moses::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Moses","term":"Moses"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Moses","sourceTitle":"Moses"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"peace","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":20,"href":"?bref=Num.25.12","rawReference":"Num.25.12"}],"ruleId":"Peace::Peace::source_verse_citation","sourceHeadwordId":"Peace"},"text":"Declare, therefore, that I am granting him My covenant of peace.","verse":12}],"id":"Peace","label":"peace","matchReviews":[{"ruleId":"Peace::Peace::source_verse_citation","scope":"source_verse_citation","senseReview":"Reviewed original headword and source sense. This substantive word is admitted only where the original article explicitly cites the exact occurrence verse; ambiguous homographs and known context mismatches are separately excluded. This is selective contextual evidence, not an automatic rule for every same-spelling word.","sourceHeadwordId":"Peace","term":"Peace"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Peace","sourceTitle":"Peace"},{"evidence":[{"matchingRule":"source_verified_redirect","phrase":"Tent of Meeting","senseEvidence":{"basis":"reviewed_publisher_redirect","originalCitations":[],"ruleId":"Tabernacle::Tent of Meeting::reviewed_publisher_redirect","sourceHeadwordId":"TentofMeeting"},"text":"Just then an Israelite man brought to his family a Midianite woman in the sight of Moses and the whole congregation of Israel while they were weeping at the entrance to the Tent of Meeting.","verse":6}],"id":"Tabernacle","label":"Tent of Meeting","matchReviews":[{"ruleId":"Tabernacle::Tent of Meeting::reviewed_publisher_redirect","scope":"reviewed_publisher_redirect","senseReview":"The original publisher explicitly links this complete unambiguous name/phrase to this target. Redirect and target were reviewed once; actual BSB phrase and full word boundaries required. Target original title and complete article remain unchanged.","sourceHeadwordId":"TentofMeeting","term":"Tent of Meeting"}],"matchingRule":"source_verified_redirect","matchingRules":["source_verified_redirect"],"sourceProvenanceId":"Tabernacle","sourceTitle":"Tabernacle"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.25.1-18","r":"Num.25.1-18","rawR":"Num.25.1-18","sourceRefs":[{"raw":"Num.25.1-18","value":"Num.25.1-18"}],"t":"ref","v":"25:1-18"}],"sourceClass":"sn-ref","t":"span"}," Israel was camped across the Jordan from Jericho, almost on the eve of conquest, but they plunged to a new low in moral failure and spiritual bankruptcy. Balaam’s advice led to the immorality and apostasy of Baal-peor (",{"href":"?bref=Num.31.16","r":"Num.31.16","rawR":"Num.31.16","sourceRefs":[{"raw":"Num.31.16","value":"Num.31.16"}],"t":"ref","v":"31:16"},"); he found a way to damage Israel, if not through a curse, then through lust and idolatry. The same temptation to idolatry and immorality existed for the early church (",{"href":"?bref=1Cor.10.6","r":"1Cor.10.6","rawR":"1Cor.10.6","sourceRefs":[{"raw":"1Cor.10.6","value":"1Cor.10.6"}],"t":"ref","v":"1 Cor 10:6"},", ",{"href":"?bref=1Cor.10.11","r":"1Cor.10.11","rawR":"1Cor.10.11","sourceRefs":[{"raw":"1Cor.10.11","value":"1Cor.10.11"}],"t":"ref","v":"11"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.25.1-18","refs":[{"book":"NUM","endChapter":25,"endVerse":18,"startChapter":25,"startVerse":1}],"sourceAttributes":{"name":"Num.25.1-18","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[25],"sourceItemFragmentSha256":"1c7746f655c8b450c35a38e4c9bc8680eccf73372eda18241fd5272575ddc5a4","sourceItemName":"Num.25.1-18","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1898,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.25.1-18","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.25.1-18","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.25.1","r":"Num.25.1","rawR":"Num.25.1","sourceRefs":[{"raw":"Num.25.1","value":"Num.25.1"}],"t":"ref","v":"25:1"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Acacia Grove:"],"sourceClass":"sn-excerpt","t":"span"}," This type of tree thrives in arid regions. From here, Joshua later sent spies across the Jordan, and the Hebrews launched their conquest (",{"href":"?bref=Josh.2.1","r":"Josh.2.1","rawR":"Josh.2.1","sourceRefs":[{"raw":"Josh.2.1","value":"Josh.2.1"}],"t":"ref","v":"Josh 2:1"},"; ",{"href":"?bref=Josh.3.1","r":"Josh.3.1","rawR":"Josh.3.1","sourceRefs":[{"raw":"Josh.3.1","value":"Josh.3.1"}],"t":"ref","v":"3:1"},").  • ",{"c":["Moabite women:"],"sourceClass":"sn-excerpt","t":"span"}," The Moabites and Midianites shared culpability in the episode involving Balaam (",{"href":"?bref=Num.22.2-4","r":"Num.22.2-4","rawR":"Num.22.2-4","sourceRefs":[{"raw":"Num.22.2-4","value":"Num.22.2-4"}],"t":"ref","v":"Num 22:2-4"},", ",{"href":"?bref=Num.22.7","r":"Num.22.7","rawR":"Num.22.7","sourceRefs":[{"raw":"Num.22.7","value":"Num.22.7"}],"t":"ref","v":"7"},"; ",{"href":"?bref=Num.31.8","r":"Num.31.8","rawR":"Num.31.8","sourceRefs":[{"raw":"Num.31.8","value":"Num.31.8"}],"t":"ref","v":"31:8"},", ",{"href":"?bref=Num.31.15-16","r":"Num.31.15-16","rawR":"Num.31.15-16","sourceRefs":[{"raw":"Num.31.15-16","value":"Num.31.15-16"}],"t":"ref","v":"15-16"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.25.1","refs":[{"book":"NUM","endChapter":25,"endVerse":1,"startChapter":25,"startVerse":1}],"sourceAttributes":{"name":"Num.25.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[25],"sourceItemFragmentSha256":"592263b088e8567ae0a688c7964850bec41408a2ae727bed25e9812de31e7c19","sourceItemName":"Num.25.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1899,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.25.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.25.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.25.2","r":"Num.25.2","rawR":"Num.25.2","sourceRefs":[{"raw":"Num.25.2","value":"Num.25.2"}],"t":"ref","v":"25:2"}],"sourceClass":"sn-ref","t":"span"}," The Israelites participated in worship feasts associated with the ",{"c":["gods of Moab"],"sourceClass":"sn-excerpt","t":"span"}," (see ",{"href":"?bref=Ps.106.28","r":"Ps.106.28","rawR":"Ps.106.28","sourceRefs":[{"raw":"Ps.106.28","value":"Ps.106.28"}],"t":"ref","v":"Ps 106:28"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.25.2","refs":[{"book":"NUM","endChapter":25,"endVerse":2,"startChapter":25,"startVerse":2}],"sourceAttributes":{"name":"Num.25.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[25],"sourceItemFragmentSha256":"8cc2bb916f70cfbb163355c5fa96ee2af22101ac4210fa2abe14818fbc26317a","sourceItemName":"Num.25.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1900,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.25.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.25.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.25.3","r":"Num.25.3","rawR":"Num.25.3","sourceRefs":[{"raw":"Num.25.3","value":"Num.25.3"}],"t":"ref","v":"25:3"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Baal of Peor"],"sourceClass":"sn-excerpt","t":"span"}," might refer to Chemosh (",{"href":"?bref=Num.21.29","r":"Num.21.29","rawR":"Num.21.29","sourceRefs":[{"raw":"Num.21.29","value":"Num.21.29"}],"t":"ref","v":"21:29"},") by a different name, but probably Baal (“lord”), the Canaanite god, was included on the list of deities honored by the Moabites. Numerous place-names were formed with this deity’s name (e.g., Baal-gad, Baal-hermon, Baal-meon, Baal-peor), representing shrines for local manifestations of Baal. Peor was a mountain from which Balaam could see the Israelite camp in the plains of Moab; the mountain and the related shrine of Beth-peor (",{"href":"?bref=Num.23.28","r":"Num.23.28","rawR":"Num.23.28","sourceRefs":[{"raw":"Num.23.28","value":"Num.23.28"}],"t":"ref","v":"23:28"},"; ",{"href":"?bref=Num.25.3","r":"Num.25.3","rawR":"Num.25.3","sourceRefs":[{"raw":"Num.25.3","value":"Num.25.3"}],"t":"ref","v":"25:3"},", ",{"href":"?bref=Num.25.5","r":"Num.25.5","rawR":"Num.25.5","sourceRefs":[{"raw":"Num.25.5","value":"Num.25.5"}],"t":"ref","v":"5"},", ",{"href":"?bref=Num.25.18","r":"Num.25.18","rawR":"Num.25.18","sourceRefs":[{"raw":"Num.25.18","value":"Num.25.18"}],"t":"ref","v":"18"},"; ",{"href":"?bref=Num.31.16","r":"Num.31.16","rawR":"Num.31.16","sourceRefs":[{"raw":"Num.31.16","value":"Num.31.16"}],"t":"ref","v":"31:16"},"; ",{"href":"?bref=Deut.3.29","r":"Deut.3.29","rawR":"Deut.3.29","sourceRefs":[{"raw":"Deut.3.29","value":"Deut.3.29"}],"t":"ref","v":"Deut 3:29"},"; ",{"href":"?bref=Deut.4.3","r":"Deut.4.3","rawR":"Deut.4.3","sourceRefs":[{"raw":"Deut.4.3","value":"Deut.4.3"}],"t":"ref","v":"4:3"},", ",{"href":"?bref=Deut.4.46","r":"Deut.4.46","rawR":"Deut.4.46","sourceRefs":[{"raw":"Deut.4.46","value":"Deut.4.46"}],"t":"ref","v":"46"},"; ",{"href":"?bref=Deut.34.6","r":"Deut.34.6","rawR":"Deut.34.6","sourceRefs":[{"raw":"Deut.34.6","value":"Deut.34.6"}],"t":"ref","v":"34:6"},"; ",{"href":"?bref=Josh.13.20","r":"Josh.13.20","rawR":"Josh.13.20","sourceRefs":[{"raw":"Josh.13.20","value":"Josh.13.20"}],"t":"ref","v":"Josh 13:20"},"; ",{"href":"?bref=Josh.22.17","r":"Josh.22.17","rawR":"Josh.22.17","sourceRefs":[{"raw":"Josh.22.17","value":"Josh.22.17"}],"t":"ref","v":"22:17"},") were somewhere in the vicinity of Mount Nebo. • Israel’s idolatry caused ",{"c":["the"],"sourceClass":"sn-excerpt","t":"span"}," ",{"c":["Lord"],"sourceClass":"sn-excerpt-divine-name","t":"span"},{"c":["’s anger to blaze against his people"],"sourceClass":"sn-excerpt","t":"span"},{"c":[";"],"sourceClass":"ital","t":"span"}," this included a plague (",{"href":"?bref=Num.25.8-9","r":"Num.25.8-9","rawR":"Num.25.8-9","sourceRefs":[{"raw":"Num.25.8-9","value":"Num.25.8-9"}],"t":"ref","v":"Num 25:8-9"},"; ",{"href":"?bref=Num.26.1","r":"Num.26.1","rawR":"Num.26.1","sourceRefs":[{"raw":"Num.26.1","value":"Num.26.1"}],"t":"ref","v":"26:1"},"; cp. ",{"href":"?bref=Num.11.1","r":"Num.11.1","rawR":"Num.11.1","sourceRefs":[{"raw":"Num.11.1","value":"Num.11.1"}],"t":"ref","v":"11:1"},", ",{"href":"?bref=Num.11.10","r":"Num.11.10","rawR":"Num.11.10","sourceRefs":[{"raw":"Num.11.10","value":"Num.11.10"}],"t":"ref","v":"10"},"; ",{"href":"?bref=Num.12.9","r":"Num.12.9","rawR":"Num.12.9","sourceRefs":[{"raw":"Num.12.9","value":"Num.12.9"}],"t":"ref","v":"12:9"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.25.3","refs":[{"book":"NUM","endChapter":25,"endVerse":3,"startChapter":25,"startVerse":3}],"sourceAttributes":{"name":"Num.25.3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[25],"sourceItemFragmentSha256":"6e039af09cbed68eb4cb17437b490be6de1a3ae8cdd6a7c40510bfd20e1e38a0","sourceItemName":"Num.25.3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1901,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.25.3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.25.3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.25.4","r":"Num.25.4","rawR":"Num.25.4","sourceRefs":[{"raw":"Num.25.4","value":"Num.25.4"}],"t":"ref","v":"25:4"}],"sourceClass":"sn-ref","t":"span"}," As he had at Sinai (",{"href":"?bref=Exod.32.27-28","r":"Exod.32.27-28","rawR":"Exod.32.27-28","sourceRefs":[{"raw":"Exod.32.27-28","value":"Exod.32.27-28"}],"t":"ref","v":"Exod 32:27-28"},"), the Lord required swift justice. • ",{"c":["execute . . . in broad daylight:"],"sourceClass":"sn-excerpt","t":"span"}," The guilty parties were perhaps impaled and left out in the sun (see ",{"href":"?bref=2Sam.21.6","r":"2Sam.21.6","rawR":"2Sam.21.6","sourceRefs":[{"raw":"2Sam.21.6","value":"2Sam.21.6"}],"t":"ref","v":"2 Sam 21:6"},", ",{"href":"?bref=2Sam.21.9","r":"2Sam.21.9","rawR":"2Sam.21.9","sourceRefs":[{"raw":"2Sam.21.9","value":"2Sam.21.9"}],"t":"ref","v":"9"},") so that everyone could see them and learn from their mistakes (cp. ",{"href":"?bref=2Sam.12.12","r":"2Sam.12.12","rawR":"2Sam.12.12","sourceRefs":[{"raw":"2Sam.12.12","value":"2Sam.12.12"}],"t":"ref","v":"2 Sam 12:12"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.25.4","refs":[{"book":"NUM","endChapter":25,"endVerse":4,"startChapter":25,"startVerse":4}],"sourceAttributes":{"name":"Num.25.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[25],"sourceItemFragmentSha256":"098eb4e0b8829001f1a8c1e2c6bf94f89faca8998184de8121cdf4ead832e101","sourceItemName":"Num.25.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1902,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.25.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.25.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.25.6","r":"Num.25.6","rawR":"Num.25.6","sourceRefs":[{"raw":"Num.25.6","value":"Num.25.6"}],"t":"ref","v":"25:6"}],"sourceClass":"sn-ref","t":"span"}," Here another ",{"c":["Israelite"],"sourceClass":"sn-excerpt","t":"span"}," defiled himself with a foreign woman; apparently both Moabite and ",{"c":["Midianite"],"sourceClass":"sn-excerpt","t":"span"}," women had been involved in the scandal (",{"href":"?bref=Num.25.1-3","r":"Num.25.1-3","rawR":"Num.25.1-3","sourceRefs":[{"raw":"Num.25.1-3","value":"Num.25.1-3"}],"t":"ref","v":"25:1-3"},", ",{"href":"?bref=Num.25.16-18","r":"Num.25.16-18","rawR":"Num.25.16-18","sourceRefs":[{"raw":"Num.25.16-18","value":"Num.25.16-18"}],"t":"ref","v":"16-18"},"; ",{"href":"?bref=Num.31.1-2","r":"Num.31.1-2","rawR":"Num.31.1-2","sourceRefs":[{"raw":"Num.31.1-2","value":"Num.31.1-2"}],"t":"ref","v":"31:1-2"},"). The man’s sin was particularly brazen, as he apparently disregarded the judgment and mourning around him. • Some suggest that ",{"c":["his tent"],"sourceClass":"sn-excerpt","t":"span"}," was an unauthorized shrine associated with the worship of Yahweh, and not just Zimri’s dwelling."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.25.6","refs":[{"book":"NUM","endChapter":25,"endVerse":6,"startChapter":25,"startVerse":6}],"sourceAttributes":{"name":"Num.25.6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[25],"sourceItemFragmentSha256":"9f34a5446d0f98261a87c8f8586cd60d80235977f994073f54fc38ac69783970","sourceItemName":"Num.25.6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1903,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.25.6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.25.6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.25.7-9","r":"Num.25.7-9","rawR":"Num.25.7-9","sourceRefs":[{"raw":"Num.25.7-9","value":"Num.25.7-9"}],"t":"ref","v":"25:7-9"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Phinehas,"],"sourceClass":"sn-excerpt","t":"span"}," acting as a representative of the priestly family, killed Zimri and Cozbi with one ",{"c":["thrust"],"sourceClass":"sn-excerpt","t":"span"}," of a ",{"c":["spear"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=Num.25.7-8","r":"Num.25.7-8","rawR":"Num.25.7-8","sourceRefs":[{"raw":"Num.25.7-8","value":"Num.25.7-8"}],"t":"ref","v":"25:7-8"},"), which probably indicates that they were engaged in sexual intercourse. Phinehas’s zeal ",{"c":["stopped"],"sourceClass":"sn-excerpt","t":"span"}," the plague (",{"href":"?bref=Num.25.1-3","r":"Num.25.1-3","rawR":"Num.25.1-3","sourceRefs":[{"raw":"Num.25.1-3","value":"Num.25.1-3"}],"t":"ref","v":"25:1-3"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.25.7-9","refs":[{"book":"NUM","endChapter":25,"endVerse":9,"startChapter":25,"startVerse":7}],"sourceAttributes":{"name":"Num.25.7-9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[25],"sourceItemFragmentSha256":"d365bbc305bdc7dd3a299d560556dbeda708e2f6ededfcfb9f6b05c654303f63","sourceItemName":"Num.25.7-9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1904,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.25.7-9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.25.7-9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.25.10-13","r":"Num.25.10-13","rawR":"Num.25.10-13","sourceRefs":[{"raw":"Num.25.10-13","value":"Num.25.10-13"}],"t":"ref","v":"25:10-13"}],"sourceClass":"sn-ref","t":"span"}," Israel’s identity as the Lord’s people was severely threatened by their unfaithfulness on this occasion. Phinehas was ",{"c":["as zealous"],"sourceClass":"sn-excerpt","t":"span"}," as God in his pursuit of holiness and justice. As a result, Phinehas and his descendants were granted a special status; God made a ",{"c":["special covenant of peace"],"sourceClass":"sn-excerpt","t":"span"}," with Phinehas, and qualified men in his family inherited ",{"c":["a permanent right to the priesthood"],"sourceClass":"sn-excerpt","t":"span"}," (cp. ",{"href":"?bref=Mal.2.5","r":"Mal.2.5","rawR":"Mal.2.5","sourceRefs":[{"raw":"Mal.2.5","value":"Mal.2.5"}],"t":"ref","v":"Mal 2:5"},"). This unconditional covenant was similar to that extended to David (see ",{"href":"?bref=Jer.33.19-22","r":"Jer.33.19-22","rawR":"Jer.33.19-22","sourceRefs":[{"raw":"Jer.33.19-22","value":"Jer.33.19-22"}],"t":"ref","v":"Jer 33:19-22"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.25.10-13","refs":[{"book":"NUM","endChapter":25,"endVerse":13,"startChapter":25,"startVerse":10}],"sourceAttributes":{"name":"Num.25.10-13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[25],"sourceItemFragmentSha256":"ed9c3beb8d9ce305a3114f9598a41c6d9f9c365366a68c1f3480965110845665","sourceItemName":"Num.25.10-13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1905,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.25.10-13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.25.10-13","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.25.13","r":"Num.25.13","rawR":"Num.25.13","sourceRefs":[{"raw":"Num.25.13","value":"Num.25.13"}],"t":"ref","v":"25:13"}],"sourceClass":"sn-ref","t":"span"}," The deaths of Zimri and Cozbi helped to purify Israel from its sin; Phinehas’s act had atoning value (see ",{"href":"?item=Lev.1.4_StudyNote_Filament","id":"Lev.1.4_StudyNote_Filament","rawId":"Lev.1.4_StudyNote_Filament","t":"link","v":"study note on Lev 1:4"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.25.13","refs":[{"book":"NUM","endChapter":25,"endVerse":13,"startChapter":25,"startVerse":13}],"sourceAttributes":{"name":"Num.25.13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[25],"sourceItemFragmentSha256":"121b7614a7bec5a4c14d5f02ecd3fe77f01283e3798dd73e3a30465e8f62bf0a","sourceItemName":"Num.25.13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1906,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.25.13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.25.13","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.25.16-18","r":"Num.25.16-18","rawR":"Num.25.16-18","sourceRefs":[{"raw":"Num.25.16-18","value":"Num.25.16-18"}],"t":"ref","v":"25:16-18"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Attack the Midianites and destroy them:"],"sourceClass":"sn-excerpt","t":"span"}," This war is recorded in ch ",{"href":"?bref=Num.31.1-54","r":"Num.31.1-54","rawR":"Num.31.1-54","sourceRefs":[{"raw":"Num.31.1-54","value":"Num.31.1-54"}],"t":"ref","v":"31"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.25.16-18","refs":[{"book":"NUM","endChapter":25,"endVerse":18,"startChapter":25,"startVerse":16}],"sourceAttributes":{"name":"Num.25.16-18","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[25],"sourceItemFragmentSha256":"2b1c7b90aab1d6f0bc3cbd59fb9f6f289b874760cf1aa593cc9e213b4461df9d","sourceItemName":"Num.25.16-18","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1907,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.25.16-18","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.25.16-18","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}