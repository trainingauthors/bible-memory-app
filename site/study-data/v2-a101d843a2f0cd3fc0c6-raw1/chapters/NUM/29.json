[{"c":[{"href":"?bref=Num.29.7-11","r":"Num.29.7-11","rawR":"Num.29.7-11","sourceRefs":[{"raw":"Num.29.7-11","value":"Num.29.7-11"}],"t":"ref","v":"29:7-11"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["The Day of Atonement"],"sourceClass":"sn-excerpt","t":"span"}," was a solemn occasion, a day of fasting (see also ",{"href":"?bref=Lev.16.1-34","r":"Lev.16.1-34","rawR":"Lev.16.1-34","sourceRefs":[{"raw":"Lev.16.1-34","value":"Lev.16.1-34"}],"t":"ref","v":"Lev 16"},"; ",{"href":"?bref=Lev.23.26-32","r":"Lev.23.26-32","rawR":"Lev.23.26-32","sourceRefs":[{"raw":"Lev.23.26-32","value":"Lev.23.26-32"}],"t":"ref","v":"23:26-32"},"; ",{"href":"?bref=Rom.3.23-25","r":"Rom.3.23-25","rawR":"Rom.3.23-25","sourceRefs":[{"raw":"Rom.3.23-25","value":"Rom.3.23-25"}],"t":"ref","v":"Rom 3:23-25"},"; ",{"href":"?bref=Heb.9.7-12","r":"Heb.9.7-12","rawR":"Heb.9.7-12","sourceRefs":[{"raw":"Heb.9.7-12","value":"Heb.9.7-12"}],"t":"ref","v":"Heb 9:7-12"},", ",{"href":"?bref=Heb.9.23-28","r":"Heb.9.23-28","rawR":"Heb.9.23-28","sourceRefs":[{"raw":"Heb.9.23-28","value":"Heb.9.23-28"}],"t":"ref","v":"23-28"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.29.7-11","refs":[{"book":"NUM","endChapter":29,"endVerse":11,"startChapter":29,"startVerse":7}],"sourceAttributes":{"name":"Num.29.7-11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[29],"sourceItemFragmentSha256":"74dd029a7b9be72e52c0bddbb0868861ddf4e3295c2575c8eb262b31c713387d","sourceItemName":"Num.29.7-11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1935,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.29.7-11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.29.7-11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.29.7","r":"Num.29.7","rawR":"Num.29.7","sourceRefs":[{"raw":"Num.29.7","value":"Num.29.7"}],"t":"ref","v":"29:7"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Ten days later, on the tenth day of the same month:"],"sourceClass":"sn-excerpt","t":"span"}," It is celebrated today as Yom Kippur (from Hebrew ",{"c":["yom hakkippurim"],"sourceClass":"hebrew","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," ",{"href":"?bref=Lev.23.27","r":"Lev.23.27","rawR":"Lev.23.27","sourceRefs":[{"raw":"Lev.23.27","value":"Lev.23.27"}],"t":"ref","v":"Lev 23:27"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.29.7","refs":[{"book":"NUM","endChapter":29,"endVerse":7,"startChapter":29,"startVerse":7}],"sourceAttributes":{"name":"Num.29.7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[29],"sourceItemFragmentSha256":"63cd6ca909b21b29bed0498f442d3ac8e6281fa4a3eb52d5ddd15588aa5f5ddd","sourceItemName":"Num.29.7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1936,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.29.7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.29.7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.29.12-38","r":"Num.29.12-38","rawR":"Num.29.12-38","sourceRefs":[{"raw":"Num.29.12-38","value":"Num.29.12-38"}],"t":"ref","v":"29:12-38"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["The Festival of Shelters"],"sourceClass":"sn-excerpt","t":"span"}," began on the fifteenth day of the seventh month. It was an eight-day harvest celebration (",{"href":"?bref=Num.29.12","r":"Num.29.12","rawR":"Num.29.12","sourceRefs":[{"raw":"Num.29.12","value":"Num.29.12"}],"t":"ref","v":"29:12"},", ",{"href":"?bref=Num.29.35","r":"Num.29.35","rawR":"Num.29.35","sourceRefs":[{"raw":"Num.29.35","value":"Num.29.35"}],"t":"ref","v":"35"},"; ",{"href":"?bref=Exod.34.22","r":"Exod.34.22","rawR":"Exod.34.22","sourceRefs":[{"raw":"Exod.34.22","value":"Exod.34.22"}],"t":"ref","v":"Exod 34:22"},") that required an enormous number of offerings. This harvest festival was an especially joyous occasion and a time for thanksgiving (see ",{"href":"?bref=Neh.8.13-18","r":"Neh.8.13-18","rawR":"Neh.8.13-18","sourceRefs":[{"raw":"Neh.8.13-18","value":"Neh.8.13-18"}],"t":"ref","v":"Neh 8:13-18"},"). The shelters also reminded the Israelites of dwelling in tents during their wilderness sojourn (see also ",{"href":"?bref=Lev.23.33-43","r":"Lev.23.33-43","rawR":"Lev.23.33-43","sourceRefs":[{"raw":"Lev.23.33-43","value":"Lev.23.33-43"}],"t":"ref","v":"Lev 23:33-43"},"; ",{"href":"?bref=1Kgs.8.1-2","r":"1Kgs.8.1-2","rawR":"1Kgs.8.1-2","sourceRefs":[{"raw":"1Kgs.8.1-2","value":"1Kgs.8.1-2"}],"t":"ref","v":"1 Kgs 8:1-2"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.29.12-38","refs":[{"book":"NUM","endChapter":29,"endVerse":38,"startChapter":29,"startVerse":12}],"sourceAttributes":{"name":"Num.29.12-38","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[29],"sourceItemFragmentSha256":"7b4276d650024611a39272dd3f2e8da6ddcfb2e2f10f711ef3eddf64967ac164","sourceItemName":"Num.29.12-38","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1937,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.29.12-38","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.29.12-38","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Num.29.39","r":"Num.29.39","rawR":"Num.29.39","sourceRefs":[{"raw":"Num.29.39","value":"Num.29.39"}],"t":"ref","v":"29:39"}],"sourceClass":"sn-ref","t":"span"}," Public offerings were supplemented by a variety of ",{"c":["voluntary"],"sourceClass":"sn-excerpt","t":"span"}," individual gifts (cp. ",{"href":"?bref=Lev.23.38","r":"Lev.23.38","rawR":"Lev.23.38","sourceRefs":[{"raw":"Lev.23.38","value":"Lev.23.38"}],"t":"ref","v":"Lev 23:38"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.29.39","refs":[{"book":"NUM","endChapter":29,"endVerse":39,"startChapter":29,"startVerse":39}],"sourceAttributes":{"name":"Num.29.39","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[29],"sourceItemFragmentSha256":"c69eb71464b051323c573be99edf75ca2c8d3817c0c34ee48bbcfb378b76a4cb","sourceItemName":"Num.29.39","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1938,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.29.39","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.29.39","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}