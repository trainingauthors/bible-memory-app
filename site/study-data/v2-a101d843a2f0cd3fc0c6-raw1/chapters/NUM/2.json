":"Num.2.34","sourceRefs":[{"raw":"Num.2.34","value":"Num.2.34"}],"t":"ref","v":"2:34"}],"sourceClass":"sn-ref","t":"span"}," The Hebrews initially obeyed God by camping and marching in the manner Moses had specified, but this obedient spirit did not last for long."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Num.2.34","refs":[{"book":"NUM","endChapter":2,"endVerse":34,"startChapter":2,"startVerse":34}],"sourceAttributes":{"name":"Num.2.34","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NUM","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"49f734a1407d4b9cb818ed2a5eeef8abffce8444d9d9c795c429f9c3d57426e3","sourceItemName":"Num.2.34","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1608,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NUM","canonicalOSIS":"Num","method":"official_book_intro_ref_title","sourceOSIS":"Num"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Num.2.34","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Num.2.34","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}