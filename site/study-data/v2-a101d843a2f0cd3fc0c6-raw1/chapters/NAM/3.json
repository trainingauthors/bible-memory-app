de1057814b997221e1b04d1d28e65c13a88a96a1209.json","title":"Put (Place)"},"Sorcery":{"file":"dictionary/7d5ad1d390cf2b75dcf0d33752b792fe884bafd5e2e9fe25a93c23ec4494f31a.json","title":"Sorcery"},"Thebes":{"file":"dictionary/93e63299acf75b2cfb4347c3bf377df1dbb0f6511ab72453158b06c6aa8e5ff8.json","title":"Thebes"}},"dictionaryRelated":[{"id":"Animals","title":"Animals"},{"id":"AssyriaAssyrians","title":"Assyria, Assyrians"},{"id":"Crown","title":"Crown"},{"id":"LehabimLehabites","title":"Lehabim*, Lehabites"},{"id":"LibyaLibyans","title":"Libya, Libyans"},{"id":"Lubim","title":"Lubim*"},{"id":"Merchant","title":"Merchant"},{"id":"NahumBookof","title":"Nahum, Book of"},{"id":"No","title":"No*"},{"id":"NoAmon","title":"No-Amon*"},{"id":"PutPlace","title":"Put (Place)"},{"id":"Sorcery","title":"Sorcery"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"“Behold, I am against you,” declares the LORD of Hosts. “I will lift your skirts over your face. I will show your nakedness to the nations and your shame to the kingdoms.","verse":5}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Thebes","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":2,"href":"?bref=Nah.3.8","rawReference":"Nah.3.8"}],"ruleId":"Thebes::Thebes::source_verse_citation","sourceHeadwordId":"Thebes"},"text":"Are you better than Thebes, stationed by the Nile with water around her, whose rampart was the sea, whose wall was the water?","verse":8}],"id":"Thebes","label":"Thebes","matchReviews":[{"ruleId":"Thebes::Thebes::source_verse_citation","scope":"source_verse_citation","senseReview":"Original complete headword and source opening identify a named person, people, or place. Promotion requires a capitalized whole name and the original article explicitly citing this same BSB verse. No arbitrary qualifier stripping or book-title inference. This citation-constrained rule was reviewed once globally; unmatched contexts remain excluded.","sourceHeadwordId":"Thebes","term":"Thebes"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Thebes","sourceTitle":"Thebes"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Nah.3.1","r":"Nah.3.1","rawR":"Nah.3.1","sourceRefs":[{"raw":"Nah.3.1","value":"Nah.3.1"}],"t":"ref","v":"3:1"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["city of murder:"],"sourceClass":"sn-excerpt","t":"span"}," The Assyrians’ graphic cruelty is well documented. Their practices included cutting off external body parts—such as noses, ears, hands, and feet—and execution by impalement on stakes. They heaped up severed heads before the gates of besieged cities. The eyes of victims might also be put out and their skin stripped from their bodies while they were still alive."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Nah.3.1","refs":[{"book":"NAM","endChapter":3,"endVerse":1,"startChapter":3,"startVerse":1}],"sourceAttributes":{"name":"Nah.3.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NAM","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"61f7e75ad56279ad5035abe00c83a7b5af17245a0d9ac7f7c2c068218074561e","sourceItemName":"Nah.3.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11360,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NAM","canonicalOSIS":"Nah","method":"official_book_intro_ref_title","sourceOSIS":"Nah"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Nah.3.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Nah.3.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Nah.3.2-3","r":"Nah.3.2-3","rawR":"Nah.3.2-3","sourceRefs":[{"raw":"Nah.3.2-3","value":"Nah.3.2-3"}],"t":"ref","v":"3:2-3"}],"sourceClass":"sn-ref","t":"span"}," These short, staccato phrases dramatize the effects of seeing and hearing the battle. • Assyrian ",{"c":["chariots"],"sourceClass":"sn-excerpt","t":"span"}," and ",{"c":["charioteers"],"sourceClass":"sn-excerpt","t":"span"}," were feared far and wide."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Nah.3.2-3","refs":[{"book":"NAM","endChapter":3,"endVerse":3,"startChapter":3,"startVerse":2}],"sourceAttributes":{"name":"Nah.3.2-3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NAM","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"a7fe215c64cdc19f9bd9cfd28f3ca29e5f2f7051d2f57810fcc4f1ba973ac9b9","sourceItemName":"Nah.3.2-3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11361,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NAM","canonicalOSIS":"Nah","method":"official_book_intro_ref_title","sourceOSIS":"Nah"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Nah.3.2-3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Nah.3.2-3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Nah.3.4","r":"Nah.3.4","rawR":"Nah.3.4","sourceRefs":[{"raw":"Nah.3.4","value":"Nah.3.4"}],"t":"ref","v":"3:4"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["mistress of deadly charms:"],"sourceClass":"sn-excerpt","t":"span"}," The Assyrians charmed other nations with wealth and promises of safety and prosperity but then victimized them through military might and economic exploitation. Therefore, their punishment was a just recompense for their deeds (see ",{"href":"?bref=Pr.24.12","r":"Pr.24.12","rawR":"Pr.24.12","sourceRefs":[{"raw":"Pr.24.12","value":"Pr.24.12"}],"t":"ref","v":"Prov 24:12"},"; ",{"href":"?bref=Joel.3.4-8","r":"Joel.3.4-8","rawR":"Joel.3.4-8","sourceRefs":[{"raw":"Joel.3.4-8","value":"Joel.3.4-8"}],"t":"ref","v":"Joel 3:4-8"},"; ",{"href":"?bref=Rev.18.6","r":"Rev.18.6","rawR":"Rev.18.6","sourceRefs":[{"raw":"Rev.18.6","value":"Rev.18.6"}],"t":"ref","v":"Rev 18:6"},"; ",{"href":"?bref=Rev.20.12","r":"Rev.20.12","rawR":"Rev.20.12","sourceRefs":[{"raw":"Rev.20.12","value":"Rev.20.12"}],"t":"ref","v":"20:12"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Nah.3.4","refs":[{"book":"NAM","endChapter":3,"endVerse":4,"startChapter":3,"startVerse":4}],"sourceAttributes":{"name":"Nah.3.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NAM","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"b96ab65afce93d9e7b85c469f230f1c35a412eef63e62adb271dbb48b12f22a0","sourceItemName":"Nah.3.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11362,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NAM","canonicalOSIS":"Nah","method":"official_book_intro_ref_title","sourceOSIS":"Nah"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Nah.3.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Nah.3.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Nah.3.5","r":"Nah.3.5","rawR":"Nah.3.5","sourceRefs":[{"raw":"Nah.3.5","value":"Nah.3.5"}],"t":"ref","v":"3:5"}],"sourceClass":"sn-ref","t":"span"}," Twice God tells Nineveh, ",{"c":["I am your enemy"],"sourceClass":"sn-excerpt","t":"span"}," (also ",{"href":"?bref=Nah.2.13","r":"Nah.2.13","rawR":"Nah.2.13","sourceRefs":[{"raw":"Nah.2.13","value":"Nah.2.13"}],"t":"ref","v":"2:13"},"). Nineveh’s judgment stands as a historical reminder that the Lord abhors sin and will deal with people and nations according to their deeds (",{"href":"?bref=Ps.9.7-8","r":"Ps.9.7-8","rawR":"Ps.9.7-8","sourceRefs":[{"raw":"Ps.9.7-8","value":"Ps.9.7-8"}],"t":"ref","v":"Pss 9:7-8"},"; ",{"href":"?bref=Ps.62.12","r":"Ps.62.12","rawR":"Ps.62.12","sourceRefs":[{"raw":"Ps.62.12","value":"Ps.62.12"}],"t":"ref","v":"62:12"},"; ",{"href":"?bref=Jer.46.28","r":"Jer.46.28","rawR":"Jer.46.28","sourceRefs":[{"raw":"Jer.46.28","value":"Jer.46.28"}],"t":"ref","v":"Jer 46:28"},"; ",{"href":"?bref=Acts.17.31","r":"Acts.17.31","rawR":"Acts.17.31","sourceRefs":[{"raw":"Acts.17.31","value":"Acts.17.31"}],"t":"ref","v":"Acts 17:31"},"). One day, God’s justice will fall worldwide on those who have rebelled against him (",{"href":"?bref=Rev.17.1-19.21","r":"Rev.17.1-19.21","rawR":"Rev.17.1-19.21","sourceRefs":[{"raw":"Rev.17.1-19.21","value":"Rev.17.1-19.21"}],"t":"ref","v":"Rev 17–19"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Nah.3.5","refs":[{"book":"NAM","endChapter":3,"endVerse":5,"startChapter":3,"startVerse":5}],"sourceAttributes":{"name":"Nah.3.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NAM","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"f833df71bf2b82c50b2ca2c3f7bf4a7aef88ab870c32e2a4006cc977fc4fbe81","sourceItemName":"Nah.3.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11363,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NAM","canonicalOSIS":"Nah","method":"official_book_intro_ref_title","sourceOSIS":"Nah"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Nah.3.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Nah.3.5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Nah.3.8","r":"Nah.3.8","rawR":"Nah.3.8","sourceRefs":[{"raw":"Nah.3.8","value":"Nah.3.8"}],"t":"ref","v":"3:8"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Thebes"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," the historic capital of Egypt, was situated on both sides of the Nile in Upper Egypt. It achieved its greatest fame as the political, religious, and cultural center of Egypt’s great New Kingdom (1550–1069 ",{"c":["BC"],"sourceClass":"era","t":"span"},"). Though no longer Egypt’s capital in the 600s ",{"c":["BC"],"sourceClass":"era","t":"span"},", the city was still a thriving metropolis."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Nah.3.8","refs":[{"book":"NAM","endChapter":3,"endVerse":8,"startChapter":3,"startVerse":8}],"sourceAttributes":{"name":"Nah.3.8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NAM","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"90d1240403311b2f7afc3defd558b7b936609ef0d7bd908d8648b5b10bd6a5d1","sourceItemName":"Nah.3.8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11364,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NAM","canonicalOSIS":"Nah","method":"official_book_intro_ref_title","sourceOSIS":"Nah"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Nah.3.8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Nah.3.8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Nah.3.9-10","r":"Nah.3.9-10","rawR":"Nah.3.9-10","sourceRefs":[{"raw":"Nah.3.9-10","value":"Nah.3.9-10"}],"t":"ref","v":"3:9-10"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Thebes fell"],"sourceClass":"sn-excerpt","t":"span"}," to the Assyrians under King Ashurbanipal in 663 ",{"c":["BC"],"sourceClass":"era","t":"span"},". Before Ashurbanipal’s victory, Thebes had seemed to have unconquerable defenses, as well as the help of all Egypt and its allies: ",{"c":["Ethiopia"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," ",{"c":["Put"],"sourceClass":"sn-excerpt","t":"span"}," (perhaps the fabled land of Punt, located near what is now coastal Somalia), and ",{"c":["Libya"],"sourceClass":"sn-excerpt","t":"span"},". None of these, however, had effectively protected Thebes. • ",{"c":["babies were dashed to death:"],"sourceClass":"sn-excerpt","t":"span"}," Ancient conquerors had the heinous practice of exterminating the infants of their enemies in this way (",{"href":"?bref=2Kgs.8.12","r":"2Kgs.8.12","rawR":"2Kgs.8.12","sourceRefs":[{"raw":"2Kgs.8.12","value":"2Kgs.8.12"}],"t":"ref","v":"2 Kgs 8:12"},"; ",{"href":"?bref=Ps.137.9","r":"Ps.137.9","rawR":"Ps.137.9","sourceRefs":[{"raw":"Ps.137.9","value":"Ps.137.9"}],"t":"ref","v":"Ps 137:9"},"; ",{"href":"?bref=Isa.13.16","r":"Isa.13.16","rawR":"Isa.13.16","sourceRefs":[{"raw":"Isa.13.16","value":"Isa.13.16"}],"t":"ref","v":"Isa 13:16"},", ",{"href":"?bref=Isa.13.18","r":"Isa.13.18","rawR":"Isa.13.18","sourceRefs":[{"raw":"Isa.13.18","value":"Isa.13.18"}],"t":"ref","v":"18"},"). • ",{"c":["Soldiers threw dice"],"sourceClass":"sn-excerpt","t":"span"}," for the spoils of war, while the ",{"c":["leaders"],"sourceClass":"sn-excerpt","t":"span"}," of the conquered people ",{"c":["were bound in chains"],"sourceClass":"sn-excerpt","t":"span"}," (see ",{"href":"?bref=2Kgs.25.7","r":"2Kgs.25.7","rawR":"2Kgs.25.7","sourceRefs":[{"raw":"2Kgs.25.7","value":"2Kgs.25.7"}],"t":"ref","v":"2 Kgs 25:7"},"; ",{"href":"?bref=Jer.40.1","r":"Jer.40.1","rawR":"Jer.40.1","sourceRefs":[{"raw":"Jer.40.1","value":"Jer.40.1"}],"t":"ref","v":"Jer 40:1"},", ",{"href":"?bref=Jer.40.4","r":"Jer.40.4","rawR":"Jer.40.4","sourceRefs":[{"raw":"Jer.40.4","value":"Jer.40.4"}],"t":"ref","v":"4"},"; ",{"href":"?bref=Joel.3.3","r":"Joel.3.3","rawR":"Joel.3.3","sourceRefs":[{"raw":"Joel.3.3","value":"Joel.3.3"}],"t":"ref","v":"Joel 3:3"},"; ",{"href":"?bref=Obad.1.11","r":"Obad.1.11","rawR":"Obad.1.11","sourceRefs":[{"raw":"Obad.1.11","value":"Obad.1.11"}],"t":"ref","v":"Obad 1:11"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Nah.3.9-10","refs":[{"book":"NAM","endChapter":3,"endVerse":10,"startChapter":3,"startVerse":9}],"sourceAttributes":{"name":"Nah.3.9-10","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NAM","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"1880758200657ef6a13afd0ea3110b332256c0f23d6ef55418e23237a354d494","sourceItemName":"Nah.3.9-10","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11365,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NAM","canonicalOSIS":"Nah","method":"official_book_intro_ref_title","sourceOSIS":"Nah"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Nah.3.9-10","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Nah.3.9-10","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Nah.3.12","r":"Nah.3.12","rawR":"Nah.3.12","sourceRefs":[{"raw":"Nah.3.12","value":"Nah.3.12"}],"t":"ref","v":"3:12"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["ripe figs:"],"sourceClass":"sn-excerpt","t":"span"}," Cp. ",{"href":"?bref=Amos.8.1-2","r":"Amos.8.1-2","rawR":"Amos.8.1-2","sourceRefs":[{"raw":"Amos.8.1-2","value":"Amos.8.1-2"}],"t":"ref","v":"Amos 8:1-2"},"; ",{"href":"?bref=Rev.6.13","r":"Rev.6.13","rawR":"Rev.6.13","sourceRefs":[{"raw":"Rev.6.13","value":"Rev.6.13"}],"t":"ref","v":"Rev 6:13"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Nah.3.12","refs":[{"book":"NAM","endChapter":3,"endVerse":12,"startChapter":3,"startVerse":12}],"sourceAttributes":{"name":"Nah.3.12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NAM","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"c9fb2c0133e27892a93dae9fff941e707dd5fc5f3338778022eca49e850ef9b0","sourceItemName":"Nah.3.12","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11366,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NAM","canonicalOSIS":"Nah","method":"official_book_intro_ref_title","sourceOSIS":"Nah"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Nah.3.12","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Nah.3.12","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Nah.3.14","r":"Nah.3.14","rawR":"Nah.3.14","sourceRefs":[{"raw":"Nah.3.14","value":"Nah.3.14"}],"t":"ref","v":"3:14"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Get ready . . . Strengthen:"],"sourceClass":"sn-excerpt","t":"span"}," Nahum used sarcasm to stress that no amount of preparation would make the Assyrians able to withstand God’s wrath (note also the sarcastic tone of ",{"href":"?bref=Nah.2.11-13","r":"Nah.2.11-13","rawR":"Nah.2.11-13","sourceRefs":[{"raw":"Nah.2.11-13","value":"Nah.2.11-13"}],"t":"ref","v":"2:11-13"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Nah.3.14","refs":[{"book":"NAM","endChapter":3,"endVerse":14,"startChapter":3,"startVerse":14}],"sourceAttributes":{"name":"Nah.3.14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NAM","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"0654c99b11fabaa7612c47d8c6fb06bff20c546c836b7b2691d22c70082105df","sourceItemName":"Nah.3.14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11367,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NAM","canonicalOSIS":"Nah","method":"official_book_intro_ref_title","sourceOSIS":"Nah"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Nah.3.14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Nah.3.14","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Nah.3.15","r":"Nah.3.15","rawR":"Nah.3.15","sourceRefs":[{"raw":"Nah.3.15","value":"Nah.3.15"}],"t":"ref","v":"3:15"}],"sourceClass":"sn-ref","t":"span"}," The Old Testament often uses ",{"c":["locusts"],"sourceClass":"sn-excerpt","t":"span"}," as a metaphor for armies (see ",{"href":"?bref=Joel.2.1-11","r":"Joel.2.1-11","rawR":"Joel.2.1-11","sourceRefs":[{"raw":"Joel.2.1-11","value":"Joel.2.1-11"}],"t":"ref","v":"Joel 2:1-11"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Nah.3.15","refs":[{"book":"NAM","endChapter":3,"endVerse":15,"startChapter":3,"startVerse":15}],"sourceAttributes":{"name":"Nah.3.15","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NAM","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"dd3950822e9ceab4d15fdf212f857b06f0a844728fb62c39e514c95c21e6a57f","sourceItemName":"Nah.3.15","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11368,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NAM","canonicalOSIS":"Nah","method":"official_book_intro_ref_title","sourceOSIS":"Nah"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Nah.3.15","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Nah.3.15","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Nah.3.16","r":"Nah.3.16","rawR":"Nah.3.16","sourceRefs":[{"raw":"Nah.3.16","value":"Nah.3.16"}],"t":"ref","v":"3:16"}],"sourceClass":"sn-ref","t":"span"}," Assyrian ",{"c":["merchants"],"sourceClass":"sn-excerpt","t":"span"}," had spread throughout the Near East like ",{"c":["locusts"],"sourceClass":"sn-excerpt","t":"span"},", filling Nineveh with untold wealth. But just as locusts desire only to satisfy their insatiable appetites and then fly off, the merchants would take their goods and go in the time of Nineveh’s distress, leaving a needy populace behind."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Nah.3.16","refs":[{"book":"NAM","endChapter":3,"endVerse":16,"startChapter":3,"startVerse":16}],"sourceAttributes":{"name":"Nah.3.16","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NAM","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"1404719d9b09ba861f1ded1d6860dbd8c57d53970d97d55739475ec5c2c3292a","sourceItemName":"Nah.3.16","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11369,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NAM","canonicalOSIS":"Nah","method":"official_book_intro_ref_title","sourceOSIS":"Nah"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Nah.3.16","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Nah.3.16","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Nah.3.18","r":"Nah.3.18","rawR":"Nah.3.18","sourceRefs":[{"raw":"Nah.3.18","value":"Nah.3.18"}],"t":"ref","v":"3:18"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["shepherds:"],"sourceClass":"sn-excerpt","t":"span"}," With the leaders gone, Nineveh’s ",{"c":["people"],"sourceClass":"sn-excerpt","t":"span"}," would be ",{"c":["scattered"],"sourceClass":"sn-excerpt","t":"span"}," like sheep. • ",{"c":["lie dead"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["sleep"],"sourceClass":"ital","t":"span"},"; see ",{"href":"?bref=John.11.11-14","r":"John.11.11-14","rawR":"John.11.11-14","sourceRefs":[{"raw":"John.11.11-14","value":"John.11.11-14"}],"t":"ref","v":"John 11:11-14"},"): Assyria’s leaders, asleep during Nineveh’s crisis, would sleep in death. By contrast, Israel’s Shepherd does not slumber (",{"href":"?bref=Ps.121.3","r":"Ps.121.3","rawR":"Ps.121.3","sourceRefs":[{"raw":"Ps.121.3","value":"Ps.121.3"}],"t":"ref","v":"Ps 121:3"},"), and he will gather Israel’s lost sheep (",{"href":"?bref=Jer.23.3","r":"Jer.23.3","rawR":"Jer.23.3","sourceRefs":[{"raw":"Jer.23.3","value":"Jer.23.3"}],"t":"ref","v":"Jer 23:3"},"; ",{"href":"?bref=Ezek.36.35","r":"Ezek.36.35","rawR":"Ezek.36.35","sourceRefs":[{"raw":"Ezek.36.35","value":"Ezek.36.35"}],"t":"ref","v":"Ezek 36:35"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Nah.3.18","refs":[{"book":"NAM","endChapter":3,"endVerse":18,"startChapter":3,"startVerse":18}],"sourceAttributes":{"name":"Nah.3.18","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NAM","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"0d10a5e7cb68f5d9e05af77ae1221515fda406118d2d3d58376c298bda4010aa","sourceItemName":"Nah.3.18","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11370,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NAM","canonicalOSIS":"Nah","method":"official_book_intro_ref_title","sourceOSIS":"Nah"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Nah.3.18","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Nah.3.18","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Nah.3.19","r":"Nah.3.19","rawR":"Nah.3.19","sourceRefs":[{"raw":"Nah.3.19","value":"Nah.3.19"}],"t":"ref","v":"3:19"}],"sourceClass":"sn-ref","t":"span"}," Nineveh deserved ",{"c":["destruction"],"sourceClass":"sn-excerpt","t":"span"}," rather than ",{"c":["healing"],"sourceClass":"sn-excerpt","t":"span"},". Although God had been patient with Nineveh in Jonah’s day (",{"href":"?bref=Jon.3.10","r":"Jon.3.10","rawR":"Jon.3.10","sourceRefs":[{"raw":"Jon.3.10","value":"Jon.3.10"}],"t":"ref","v":"Jon 3:10"},"), the Assyrians had returned to ",{"c":["cruelty"],"sourceClass":"sn-excerpt","t":"span"}," and would reap the harvest of their own evil (see ",{"href":"?bref=Pr.11.16-19","r":"Pr.11.16-19","rawR":"Pr.11.16-19","sourceRefs":[{"raw":"Pr.11.16-19","value":"Pr.11.16-19"}],"t":"ref","v":"Prov 11:16-19"},"; ",{"href":"?bref=Isa.66.5-6","r":"Isa.66.5-6","rawR":"Isa.66.5-6","sourceRefs":[{"raw":"Isa.66.5-6","value":"Isa.66.5-6"}],"t":"ref","v":"Isa 66:5-6"},"; ",{"href":"?bref=Hos.8.7","r":"Hos.8.7","rawR":"Hos.8.7","sourceRefs":[{"raw":"Hos.8.7","value":"Hos.8.7"}],"t":"ref","v":"Hos 8:7"},"). Those who had ",{"c":["suffered"],"sourceClass":"sn-excerpt","t":"span"}," under Assyria’s ",{"c":["cruelty"],"sourceClass":"sn-excerpt","t":"span"}," would welcome this message with ",{"c":["joy"],"sourceClass":"sn-excerpt","t":"span"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Nah.3.19","refs":[{"book":"NAM","endChapter":3,"endVerse":19,"startChapter":3,"startVerse":19}],"sourceAttributes":{"name":"Nah.3.19","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NAM","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"efd5c20d9556b1e934ed5d57c1a7612de8d24b148a88d6e9d97b848e7147e3a0","sourceItemName":"Nah.3.19","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11371,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NAM","canonicalOSIS":"Nah","method":"official_book_intro_ref_title","sourceOSIS":"Nah"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Nah.3.19","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Nah.3.19","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}