mName":"Nah.2.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11349,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NAM","canonicalOSIS":"Nah","method":"official_book_intro_ref_title","sourceOSIS":"Nah"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Nah.2.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Nah.2.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Nah.2.2","r":"Nah.2.2","rawR":"Nah.2.2","sourceRefs":[{"raw":"Nah.2.2","value":"Nah.2.2"}],"t":"ref","v":"2:2"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["vine"],"sourceClass":"sn-excerpt","t":"span"}," symbolizes God’s blessing his people (",{"href":"?bref=Isa.27.2-6","r":"Isa.27.2-6","rawR":"Isa.27.2-6","sourceRefs":[{"raw":"Isa.27.2-6","value":"Isa.27.2-6"}],"t":"ref","v":"Isa 27:2-6"},"), while the ",{"c":["stripped"],"sourceClass":"sn-excerpt","t":"span"}," vine reflects God’s previous chastisement of them (",{"href":"?bref=Isa.5.1-7","r":"Isa.5.1-7","rawR":"Isa.5.1-7","sourceRefs":[{"raw":"Isa.5.1-7","value":"Isa.5.1-7"}],"t":"ref","v":"Isa 5:1-7"},"). The children of Israel were in a sad state compared to the days of the great kings David and Solomon, but God promised to ",{"c":["restore"],"sourceClass":"sn-excerpt","t":"span"}," the ",{"c":["splendor"],"sourceClass":"sn-excerpt","t":"span"}," of his people."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Nah.2.2","refs":[{"book":"NAM","endChapter":2,"endVerse":2,"startChapter":2,"startVerse":2}],"sourceAttributes":{"name":"Nah.2.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NAM","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"260b9971bf89d77c3fce71a2b2192c72b1a7e6a1a3d22d2283b1bff312596e42","sourceItemName":"Nah.2.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11350,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NAM","canonicalOSIS":"Nah","method":"official_book_intro_ref_title","sourceOSIS":"Nah"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Nah.2.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Nah.2.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Nah.2.4","r":"Nah.2.4","rawR":"Nah.2.4","sourceRefs":[{"raw":"Nah.2.4","value":"Nah.2.4"}],"t":"ref","v":"2:4"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Chariots"],"sourceClass":"sn-excerpt","t":"span"}," were virtually unstoppable in battle because of their maneuverability and power."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Nah.2.4","refs":[{"book":"NAM","endChapter":2,"endVerse":4,"startChapter":2,"startVerse":4}],"sourceAttributes":{"name":"Nah.2.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NAM","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"d305161c56b73e7e4d45b11e93c2505a7deeb5d00b56b35c6df485864403947d","sourceItemName":"Nah.2.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11351,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NAM","canonicalOSIS":"Nah","method":"official_book_intro_ref_title","sourceOSIS":"Nah"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Nah.2.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Nah.2.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Nah.2.5","r":"Nah.2.5","rawR":"Nah.2.5","sourceRefs":[{"raw":"Nah.2.5","value":"Nah.2.5"}],"t":"ref","v":"2:5"}],"sourceClass":"sn-ref","t":"span"}," The Assyrian king overcomes the initial shock of Nineveh’s being attacked and ",{"c":["shouts to his officers"],"sourceClass":"sn-excerpt","t":"span"},". He and the city have been caught off guard and they rush ",{"c":["to the walls"],"sourceClass":"sn-excerpt","t":"span"}," to thwart the siege. • ",{"c":["to set up their defenses"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["the covering is prepared"],"sourceClass":"ital","t":"span"},"): The meaning of the Hebrew term here is uncertain. ",{"c":["Covering"],"sourceClass":"ital","t":"span"}," probably refers to something the attackers or the defenders used to protect themselves from armaments hurled through the air."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Nah.2.5","refs":[{"book":"NAM","endChapter":2,"endVerse":5,"startChapter":2,"startVerse":5}],"sourceAttributes":{"name":"Nah.2.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NAM","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"77ba8a4382b6d3a8e973f90955b797281b03d8b3ea7a61ef8e898a727b594bf0","sourceItemName":"Nah.2.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11352,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NAM","canonicalOSIS":"Nah","method":"official_book_intro_ref_title","sourceOSIS":"Nah"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Nah.2.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Nah.2.5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Nah.2.6","r":"Nah.2.6","rawR":"Nah.2.6","sourceRefs":[{"raw":"Nah.2.6","value":"Nah.2.6"}],"t":"ref","v":"2:6"}],"sourceClass":"sn-ref","t":"span"}," The rush to defend (",{"href":"?bref=Nah.2.5","r":"Nah.2.5","rawR":"Nah.2.5","sourceRefs":[{"raw":"Nah.2.5","value":"Nah.2.5"}],"t":"ref","v":"2:5"},") comes too late; the defenses are already breached. • Nineveh was served by a reservoir formed by a double dam on the Khosr River, a tributary of the Tigris that flowed through the city. The reservoir was augmented by a series of flood ",{"c":["gates"],"sourceClass":"sn-excerpt","t":"span"},". The Greek historian Diodorus reported that during this time torrential rains had already swelled the city’s river system. By first closing, then opening the flood gates, Nineveh’s attackers released the pent-up water as a battering ram against the city walls."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Nah.2.6","refs":[{"book":"NAM","endChapter":2,"endVerse":6,"startChapter":2,"startVerse":6}],"sourceAttributes":{"name":"Nah.2.6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NAM","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"37cb3bbe3ff3c4ff4ab7ae6fdc7a98aa5962de220c6c7b309ab93531968c6d05","sourceItemName":"Nah.2.6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11353,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NAM","canonicalOSIS":"Nah","method":"official_book_intro_ref_title","sourceOSIS":"Nah"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Nah.2.6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Nah.2.6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Nah.2.7","r":"Nah.2.7","rawR":"Nah.2.7","sourceRefs":[{"raw":"Nah.2.7","value":"Nah.2.7"}],"t":"ref","v":"2:7"}],"sourceClass":"sn-ref","t":"span"}," Because ",{"c":["Nineveh’s exile"],"sourceClass":"sn-excerpt","t":"span"}," had ",{"c":["been decreed"],"sourceClass":"sn-excerpt","t":"span"}," by God, it would certainly happen. • To ",{"c":["beat their breasts"],"sourceClass":"sn-excerpt","t":"span"}," was a common sign of mourning (see, e.g., ",{"href":"?bref=Luke.18.13","r":"Luke.18.13","rawR":"Luke.18.13","sourceRefs":[{"raw":"Luke.18.13","value":"Luke.18.13"}],"t":"ref","v":"Luke 18:13"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Nah.2.7","refs":[{"book":"NAM","endChapter":2,"endVerse":7,"startChapter":2,"startVerse":7}],"sourceAttributes":{"name":"Nah.2.7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NAM","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"7f37902dd143e41beb065956d8e619d29a57d71c0ade25d97de36f4107424563","sourceItemName":"Nah.2.7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11354,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NAM","canonicalOSIS":"Nah","method":"official_book_intro_ref_title","sourceOSIS":"Nah"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Nah.2.7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Nah.2.7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Nah.2.8","r":"Nah.2.8","rawR":"Nah.2.8","sourceRefs":[{"raw":"Nah.2.8","value":"Nah.2.8"}],"t":"ref","v":"2:8"}],"sourceClass":"sn-ref","t":"span"}," The people would run away as fast as water flows from a breached ",{"c":["reservoir"],"sourceClass":"sn-excerpt","t":"span"}," (see ",{"href":"?item=Nah.2.6_StudyNote_Filament","id":"Nah.2.6_StudyNote_Filament","rawId":"Nah.2.6_StudyNote_Filament","t":"link","v":"study note on 2:6"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Nah.2.8","refs":[{"book":"NAM","endChapter":2,"endVerse":8,"startChapter":2,"startVerse":8}],"sourceAttributes":{"name":"Nah.2.8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NAM","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"6fc30bb98c4d6d349540a283b7a633e6763c82261cc019a12c6069863fac8fa0","sourceItemName":"Nah.2.8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11355,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NAM","canonicalOSIS":"Nah","method":"official_book_intro_ref_title","sourceOSIS":"Nah"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Nah.2.8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Nah.2.8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Nah.2.9","r":"Nah.2.9","rawR":"Nah.2.9","sourceRefs":[{"raw":"Nah.2.9","value":"Nah.2.9"}],"t":"ref","v":"2:9"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["vast, uncounted wealth"],"sourceClass":"sn-excerpt","t":"span"}," of other nations poured into the Assyrian capital as trade, tribute, and spoils, but it was gone in an instant. Ruthless aggression and wickedness may succeed temporarily, but ultimately they will be destroyed (",{"href":"?bref=Pr.13.22","r":"Pr.13.22","rawR":"Pr.13.22","sourceRefs":[{"raw":"Pr.13.22","value":"Pr.13.22"}],"t":"ref","v":"Prov 13:22"},"; ",{"href":"?bref=Obad.1.15","r":"Obad.1.15","rawR":"Obad.1.15","sourceRefs":[{"raw":"Obad.1.15","value":"Obad.1.15"}],"t":"ref","v":"Obad 1:15"},"; ",{"href":"?bref=Luke.12.16-20","r":"Luke.12.16-20","rawR":"Luke.12.16-20","sourceRefs":[{"raw":"Luke.12.16-20","value":"Luke.12.16-20"}],"t":"ref","v":"Luke 12:16-20"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Nah.2.9","refs":[{"book":"NAM","endChapter":2,"endVerse":9,"startChapter":2,"startVerse":9}],"sourceAttributes":{"name":"Nah.2.9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NAM","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"529e39f8f2e1e483a70c87e2186c21be08a7b6f29b14a87c27c5a30e5901fded","sourceItemName":"Nah.2.9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11356,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NAM","canonicalOSIS":"Nah","method":"official_book_intro_ref_title","sourceOSIS":"Nah"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Nah.2.9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Nah.2.9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Nah.2.10","r":"Nah.2.10","rawR":"Nah.2.10","sourceRefs":[{"raw":"Nah.2.10","value":"Nah.2.10"}],"t":"ref","v":"2:10"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["plundered, empty, and ruined:"],"sourceClass":"sn-excerpt","t":"span"}," The Hebrew here is alliterated for effect: ",{"c":["buqah umbuqah umbullaqah"],"sourceClass":"hebrew","t":"span"},". The effect might be translated into English as “devastated, despoiled, and destroyed.”"],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Nah.2.10","refs":[{"book":"NAM","endChapter":2,"endVerse":10,"startChapter":2,"startVerse":10}],"sourceAttributes":{"name":"Nah.2.10","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NAM","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"cb4f3568e8849600671497b0f41b954f076adb7ca2ecc6935c05d96129cea2d6","sourceItemName":"Nah.2.10","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11357,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NAM","canonicalOSIS":"Nah","method":"official_book_intro_ref_title","sourceOSIS":"Nah"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Nah.2.10","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Nah.2.10","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Nah.2.11-13","r":"Nah.2.11-13","rawR":"Nah.2.11-13","sourceRefs":[{"raw":"Nah.2.11-13","value":"Nah.2.11-13"}],"t":"ref","v":"2:11-13"}],"sourceClass":"sn-ref","t":"span"}," Following the description of Nineveh’s fall (",{"href":"?bref=Nah.2.1-10","r":"Nah.2.1-10","rawR":"Nah.2.1-10","sourceRefs":[{"raw":"Nah.2.1-10","value":"Nah.2.1-10"}],"t":"ref","v":"2:1-10"},"), Nahum inserts the first of three taunt songs (see also ",{"href":"?bref=Nah.3.8-13","r":"Nah.3.8-13","rawR":"Nah.3.8-13","sourceRefs":[{"raw":"Nah.3.8-13","value":"Nah.3.8-13"}],"t":"ref","v":"3:8-13"},", ",{"href":"?bref=Nah.3.14-19","r":"Nah.3.14-19","rawR":"Nah.3.14-19","sourceRefs":[{"raw":"Nah.3.14-19","value":"Nah.3.14-19"}],"t":"ref","v":"14-19"},"; this was a common form in the ancient Near East). In biting satire, he compares Nineveh to a lion’s ",{"c":["den"],"sourceClass":"sn-excerpt","t":"span"},". King Sennacherib and other Assyrian kings had compared themselves to ",{"c":["lions"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," even decorating their palaces with artistic representations of lions and of themselves on lion hunts. However, with God as its enemy, Nineveh would no longer be the lair of an invincible predator."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Nah.2.11-13","refs":[{"book":"NAM","endChapter":2,"endVerse":13,"startChapter":2,"startVerse":11}],"sourceAttributes":{"name":"Nah.2.11-13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NAM","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"346c0a21882bf1189fd6ab8273db5d7ac2bc86fe26fc34490a19f666b9cfae60","sourceItemName":"Nah.2.11-13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11358,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NAM","canonicalOSIS":"Nah","method":"official_book_intro_ref_title","sourceOSIS":"Nah"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Nah.2.11-13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Nah.2.11-13","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Nah.2.13","r":"Nah.2.13","rawR":"Nah.2.13","sourceRefs":[{"raw":"Nah.2.13","value":"Nah.2.13"}],"t":"ref","v":"2:13"}],"sourceClass":"sn-ref","t":"span"}," Examples of the ",{"c":["voices"],"sourceClass":"sn-excerpt","t":"span"}," of Assyria’s ",{"c":["proud messengers"],"sourceClass":"sn-excerpt","t":"span"}," are found in ",{"href":"?bref=2Kgs.18.19-19.13","r":"2Kgs.18.19-19.13","rawR":"2Kgs.18.19-19.13","sourceRefs":[{"raw":"2Kgs.18.19-19.13","value":"2Kgs.18.19-19.13"}],"t":"ref","v":"2 Kgs 18:19–19:13"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Nah.2.13","refs":[{"book":"NAM","endChapter":2,"endVerse":13,"startChapter":2,"startVerse":13}],"sourceAttributes":{"name":"Nah.2.13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NAM","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"bf2cf82bc86242cfa28a33fc4e4b3f2a525c0cfe02e2adb59710790a2b547082","sourceItemName":"Nah.2.13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11359,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NAM","canonicalOSIS":"Nah","method":"official_book_intro_ref_title","sourceOSIS":"Nah"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Nah.2.13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Nah.2.13","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}