e alliance of Syria and Israel—see ",{"href":"?item=Isa.7.1-25_StudyNote_Filament","id":"Isa.7.1-25_StudyNote_Filament","rawId":"Isa.7.1-25_StudyNote_Filament","t":"link","v":"study note on 7:1-25"},") to the Assyrian crisis in 701 ",{"c":["BC"],"sourceClass":"era","t":"span"}," (see chs ",{"href":"?bref=Isa.36.1-37.38","r":"Isa.36.1-37.38","rawR":"Isa.36.1-37.38","sourceRefs":[{"raw":"Isa.36.1-37.38","value":"Isa.36.1-37.38"}],"t":"ref","v":"36–37"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Isa.17.1-20.6","refs":[{"book":"ISA","endChapter":20,"endVerse":6,"startChapter":17,"startVerse":1}],"sourceAttributes":{"name":"Isa.17.1-20.6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ISA","sourceChapterCoverage":[17,18,19,20],"sourceItemFragmentSha256":"5ece2b0dda176c3196d5fd3bf36188e6325fd3f72c40e344d550d44316f781c1","sourceItemName":"Isa.17.1-20.6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8452,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ISA","canonicalOSIS":"Isa","method":"official_book_intro_ref_title","sourceOSIS":"Isa"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Isa.17.1-20.6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Isa.17.1-20.6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Isa.18.1","r":"Isa.18.1","rawR":"Isa.18.1","sourceRefs":[{"raw":"Isa.18.1","value":"Isa.18.1"}],"t":"ref","v":"18:1"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Ethiopia"],"sourceClass":"sn-excerpt","t":"span"}," was at the southern extremity of the kingdom of Egypt. At the time, Egypt was ruled by the dynasty of the Ethiopian Piankhi."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Isa.18.1","refs":[{"book":"ISA","endChapter":18,"endVerse":1,"startChapter":18,"startVerse":1}],"sourceAttributes":{"name":"Isa.18.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ISA","sourceChapterCoverage":[18],"sourceItemFragmentSha256":"6c4ad67af0923b2296b946a28d5e6e0151f5cd702b77a1d94a162568daea7051","sourceItemName":"Isa.18.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8468,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ISA","canonicalOSIS":"Isa","method":"official_book_intro_ref_title","sourceOSIS":"Isa"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Isa.18.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Isa.18.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Isa.18.3","r":"Isa.18.3","rawR":"Isa.18.3","sourceRefs":[{"raw":"Isa.18.3","value":"Isa.18.3"}],"t":"ref","v":"18:3"}],"sourceClass":"sn-ref","t":"span"}," Both the ",{"c":["battle flag"],"sourceClass":"sn-excerpt","t":"span"}," and ",{"c":["ram’s horn"],"sourceClass":"sn-excerpt","t":"span"}," were used to marshal and send signals to armies in battle (see ",{"href":"?bref=Judg.3.27","r":"Judg.3.27","rawR":"Judg.3.27","sourceRefs":[{"raw":"Judg.3.27","value":"Judg.3.27"}],"t":"ref","v":"Judg 3:27"},"; ",{"href":"?bref=Judg.6.34","r":"Judg.6.34","rawR":"Judg.6.34","sourceRefs":[{"raw":"Judg.6.34","value":"Judg.6.34"}],"t":"ref","v":"6:34"},"; ",{"href":"?bref=2Sam.2.28","r":"2Sam.2.28","rawR":"2Sam.2.28","sourceRefs":[{"raw":"2Sam.2.28","value":"2Sam.2.28"}],"t":"ref","v":"2 Sam 2:28"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Isa.18.3","refs":[{"book":"ISA","endChapter":18,"endVerse":3,"startChapter":18,"startVerse":3}],"sourceAttributes":{"name":"Isa.18.3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ISA","sourceChapterCoverage":[18],"sourceItemFragmentSha256":"c3cfa604c5f51c12155cfd3cae4f8c13c20fe58ed186ac26b42d15f70957640f","sourceItemName":"Isa.18.3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8469,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ISA","canonicalOSIS":"Isa","method":"official_book_intro_ref_title","sourceOSIS":"Isa"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Isa.18.3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Isa.18.3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Isa.18.4","r":"Isa.18.4","rawR":"Isa.18.4","sourceRefs":[{"raw":"Isa.18.4","value":"Isa.18.4"}],"t":"ref","v":"18:4"}],"sourceClass":"sn-ref","t":"span"}," The Lord is untroubled by human activities; he watches ",{"c":["quietly from"],"sourceClass":"sn-excerpt","t":"span"}," his ",{"c":["dwelling place"],"sourceClass":"sn-excerpt","t":"span"}," and acts in his own time (see ",{"href":"?bref=Ps.2.1-4","r":"Ps.2.1-4","rawR":"Ps.2.1-4","sourceRefs":[{"raw":"Ps.2.1-4","value":"Ps.2.1-4"}],"t":"ref","v":"Ps 2:1-4"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Isa.18.4","refs":[{"book":"ISA","endChapter":18,"endVerse":4,"startChapter":18,"startVerse":4}],"sourceAttributes":{"name":"Isa.18.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ISA","sourceChapterCoverage":[18],"sourceItemFragmentSha256":"57c4ba7af5287650aad5a099ba5814c1bbaa98a0a466948ca3bb7b4e8d6a4d62","sourceItemName":"Isa.18.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8470,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ISA","canonicalOSIS":"Isa","method":"official_book_intro_ref_title","sourceOSIS":"Isa"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Isa.18.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Isa.18.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Isa.18.5","r":"Isa.18.5","rawR":"Isa.18.5","sourceRefs":[{"raw":"Isa.18.5","value":"Isa.18.5"}],"t":"ref","v":"18:5"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["your plans are ripening:"],"sourceClass":"sn-excerpt","t":"span"}," Ethiopia had made every effort to form alliances to protect itself against Assyria, but its alliance with Judah would not help."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Isa.18.5","refs":[{"book":"ISA","endChapter":18,"endVerse":5,"startChapter":18,"startVerse":5}],"sourceAttributes":{"name":"Isa.18.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ISA","sourceChapterCoverage":[18],"sourceItemFragmentSha256":"0b7b0993c70e0160e4e17c28665c425ae968ed01faaeead077e59d6ad942fb11","sourceItemName":"Isa.18.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8471,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ISA","canonicalOSIS":"Isa","method":"official_book_intro_ref_title","sourceOSIS":"Isa"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Isa.18.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Isa.18.5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Isa.18.7","r":"Isa.18.7","rawR":"Isa.18.7","sourceRefs":[{"raw":"Isa.18.7","value":"Isa.18.7"}],"t":"ref","v":"18:7"}],"sourceClass":"sn-ref","t":"span"}," Conquered or weaker nations were often forced to pay tribute to a dominant king in the region (see ",{"href":"?bref=Isa.16.1","r":"Isa.16.1","rawR":"Isa.16.1","sourceRefs":[{"raw":"Isa.16.1","value":"Isa.16.1"}],"t":"ref","v":"16:1"},"; ",{"href":"?bref=2Kgs.3.4-5","r":"2Kgs.3.4-5","rawR":"2Kgs.3.4-5","sourceRefs":[{"raw":"2Kgs.3.4-5","value":"2Kgs.3.4-5"}],"t":"ref","v":"2 Kgs 3:4-5"},"). The Ethiopians would come bringing ",{"c":["gifts"],"sourceClass":"sn-excerpt","t":"span"}," to honor the Lord for his defeat of the Assyrians (see also ",{"href":"?bref=2Chr.32.23","r":"2Chr.32.23","rawR":"2Chr.32.23","sourceRefs":[{"raw":"2Chr.32.23","value":"2Chr.32.23"}],"t":"ref","v":"2 Chr 32:23"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Isa.18.7","refs":[{"book":"ISA","endChapter":18,"endVerse":7,"startChapter":18,"startVerse":7}],"sourceAttributes":{"name":"Isa.18.7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ISA","sourceChapterCoverage":[18],"sourceItemFragmentSha256":"488fbfe2a6f837c627cfa780b883c966b9d4fc37acf878104b9fa725f3bb03cc","sourceItemName":"Isa.18.7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8472,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ISA","canonicalOSIS":"Isa","method":"official_book_intro_ref_title","sourceOSIS":"Isa"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Isa.18.7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Isa.18.7","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}