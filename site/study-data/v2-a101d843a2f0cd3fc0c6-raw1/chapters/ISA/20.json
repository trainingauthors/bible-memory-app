Study Notes/StudyNotes.xml","sourceOrder":8473,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ISA","canonicalOSIS":"Isa","method":"official_book_intro_ref_title","sourceOSIS":"Isa"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Isa.19.1-20.6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Isa.19.1-20.6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Isa.20.1-5","r":"Isa.20.1-5","rawR":"Isa.20.1-5","sourceRefs":[{"raw":"Isa.20.1-5","value":"Isa.20.1-5"}],"t":"ref","v":"20:1-5"}],"sourceClass":"sn-ref","t":"span"}," Ashdod’s reliance on Egypt and Ethiopia was useless. As a complement to his words, Isaiah walked about exposed and barefoot, a symbolic action for what God would do."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Isa.20.1-5","refs":[{"book":"ISA","endChapter":20,"endVerse":5,"startChapter":20,"startVerse":1}],"sourceAttributes":{"name":"Isa.20.1-5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ISA","sourceChapterCoverage":[20],"sourceItemFragmentSha256":"eaf2cade31b0f2f9ade39b49e01fe5bcee66812bef01b8becf5758e5e1381546","sourceItemName":"Isa.20.1-5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8495,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ISA","canonicalOSIS":"Isa","method":"official_book_intro_ref_title","sourceOSIS":"Isa"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Isa.20.1-5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Isa.20.1-5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Isa.20.1","r":"Isa.20.1","rawR":"Isa.20.1","sourceRefs":[{"raw":"Isa.20.1","value":"Isa.20.1"}],"t":"ref","v":"20:1"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Sargon of Assyria"],"sourceClass":"sn-excerpt","t":"span"}," is Sargon II (721–705 ",{"c":["BC"],"sourceClass":"era","t":"span"},"). • ",{"c":["Ashdod"],"sourceClass":"sn-excerpt","t":"span"}," was one of the five Philistine cities that rebelled against Assyria in 713 ",{"c":["BC"],"sourceClass":"era","t":"span"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Isa.20.1","refs":[{"book":"ISA","endChapter":20,"endVerse":1,"startChapter":20,"startVerse":1}],"sourceAttributes":{"name":"Isa.20.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ISA","sourceChapterCoverage":[20],"sourceItemFragmentSha256":"1812101e34f6bf683763a2c43a44a886cf34f55a2e84765d2b0c468f9a6ff8b0","sourceItemName":"Isa.20.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8496,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ISA","canonicalOSIS":"Isa","method":"official_book_intro_ref_title","sourceOSIS":"Isa"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Isa.20.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Isa.20.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Isa.20.2","r":"Isa.20.2","rawR":"Isa.20.2","sourceRefs":[{"raw":"Isa.20.2","value":"Isa.20.2"}],"t":"ref","v":"20:2"}],"sourceClass":"sn-ref","t":"span"}," Prophets characteristically wore ",{"c":["burlap"],"sourceClass":"sn-excerpt","t":"span"}," or other rough clothing as a sign of mourning over the sins of the people (see ",{"href":"?bref=2Kgs.1.8","r":"2Kgs.1.8","rawR":"2Kgs.1.8","sourceRefs":[{"raw":"2Kgs.1.8","value":"2Kgs.1.8"}],"t":"ref","v":"2 Kgs 1:8"},"; ",{"href":"?bref=Mark.1.6","r":"Mark.1.6","rawR":"Mark.1.6","sourceRefs":[{"raw":"Mark.1.6","value":"Mark.1.6"}],"t":"ref","v":"Mark 1:6"},"). • ",{"c":["naked:"],"sourceClass":"sn-excerpt","t":"span"}," That is, exposed in some way, possibly even completely nude."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Isa.20.2","refs":[{"book":"ISA","endChapter":20,"endVerse":2,"startChapter":20,"startVerse":2}],"sourceAttributes":{"name":"Isa.20.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ISA","sourceChapterCoverage":[20],"sourceItemFragmentSha256":"985ed7d07b89e9dcbf3733b6cddf7500663f634d587189850cdf7fea01f61ac2","sourceItemName":"Isa.20.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8497,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ISA","canonicalOSIS":"Isa","method":"official_book_intro_ref_title","sourceOSIS":"Isa"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Isa.20.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Isa.20.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Isa.20.3-4","r":"Isa.20.3-4","rawR":"Isa.20.3-4","sourceRefs":[{"raw":"Isa.20.3-4","value":"Isa.20.3-4"}],"t":"ref","v":"20:3-4"}],"sourceClass":"sn-ref","t":"span"}," This symbolic event took place some ",{"c":["three years"],"sourceClass":"sn-excerpt","t":"span"}," before the fall of Ashdod (see ",{"href":"?bref=Isa.20.2","r":"Isa.20.2","rawR":"Isa.20.2","sourceRefs":[{"raw":"Isa.20.2","value":"Isa.20.2"}],"t":"ref","v":"20:2"},"). Through it, Isaiah became an object lesson for the people (see ",{"href":"?bref=Isa.8.18","r":"Isa.8.18","rawR":"Isa.8.18","sourceRefs":[{"raw":"Isa.8.18","value":"Isa.8.18"}],"t":"ref","v":"8:18"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Isa.20.3-4","refs":[{"book":"ISA","endChapter":20,"endVerse":4,"startChapter":20,"startVerse":3}],"sourceAttributes":{"name":"Isa.20.3-4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ISA","sourceChapterCoverage":[20],"sourceItemFragmentSha256":"aca497b1027857907915e07b31a3db08d955ea5197714f324b6c60151c006966","sourceItemName":"Isa.20.3-4","sourceMember":"Tyndale Ope