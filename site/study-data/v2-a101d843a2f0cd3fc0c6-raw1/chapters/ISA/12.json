":[{"book":"PSA","chapter":68,"verses":[16]}]},{"label":"Ps 71:22","passages":[{"book":"PSA","chapter":71,"verses":[22]}]},{"label":"Ps 89:18","passages":[{"book":"PSA","chapter":89,"verses":[18]}]},{"label":"Ps 132:14","passages":[{"book":"PSA","chapter":132,"verses":[14]}]},{"label":"Ezek 43:7","passages":[{"book":"EZK","chapter":43,"verses":[7]}]},{"label":"Ezek 48:35","passages":[{"book":"EZK","chapter":48,"verses":[35]}]},{"label":"Zeph 2:5","passages":[{"book":"ZEP","chapter":2,"verses":[5]}]},{"label":"Zeph 3:15-17","passages":[{"book":"ZEP","chapter":3,"verses":[15,16,17]}]},{"label":"Zech 2:5,10-11","passages":[{"book":"ZEC","chapter":2,"verses":[5,10,11]}]}],"verse":6}],"dictionaryArticles":{"GodBeingandAttributesof":{"file":"dictionary/8bebeeccd538c24c7d2aff01451d1524801d088e6e70cba806dead0013d42472.json","title":"God, Being and Attributes of"},"GodNamesof":{"file":"dictionary/99d1c172eb65aef1d6f4b924d29da9c0297aac75b43eeff143684393cd6f2e5f.json","title":"God, Names of"},"Gratitude":{"file":"dictionary/35a5d37de00985fff241ff51f4b5c57e135b73b8040d6601fa10bf0d854b8302.json","title":"Gratitude"},"IsaiahBookof":{"file":"dictionary/638e77971feb8133668268c6f589e5fe4c5423054468bfc7dc62227c9fbc53e0.json","title":"Isaiah, Book of"},"Lord":{"file":"dictionary/0a54f5caa03523157b50ef58ec814d810e7db1abd5db44ec093ece07106e3447.json","title":"Lord"},"Well":{"file":"dictionary/9ca8b71c8509ff5af4abfd68954b28fac9a5813067997ec844327dffa810551d.json","title":"Well"},"Zion":{"file":"dictionary/fe8ad75e47c438a63b5e52a974e7a7b70aaa518e21b10c2e750f0e2833b3326e.json","title":"Zion"}},"dictionaryRelated":[{"id":"GodBeingandAttributesof","title":"God, Being and Attributes of"},{"id":"GodNamesof","title":"God, Names of"},{"id":"Gratitude","title":"Gratitude"},{"id":"IsaiahBookof","title":"Isaiah, Book of"},{"id":"Well","title":"Well"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"In that day you will say: “O LORD, I will praise You. Although You were angry with me, Your anger has turned away, and You have comforted me.","verse":1},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Surely God is my salvation; I will trust and not be afraid. For the LORD GOD is my strength and my song, and He also has become my salvation.”","verse":2},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"and on that day you will say: “Give praise to the LORD; proclaim His name! Make His works known among the peoples; declare that His name is exalted.","verse":4},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Sing to the LORD, for He has done glorious things. Let this be known in all the earth.","verse":5}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Zion","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Zion::Zion::reviewed_unambiguous_name","sourceHeadwordId":"Zion"},"text":"Cry out and sing, O citizen of Zion, for great among you is the Holy One of Israel.”","verse":6}],"id":"Zion","label":"Zion","matchReviews":[{"ruleId":"Zion::Zion::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Zion","term":"Zion"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Zion","sourceTitle":"Zion"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":["Isaiah"],"sourceClass":"profile-title","t":"h"},{"c":["Isaiah was a Judean prophet during the reigns of Uzziah, Jotham, Ahaz, and Hezekiah. He was the son of Amoz (",{"href":"?bref=Isa.1.1","r":"Isa.1.1","rawR":"Isa.1.1","sourceRefs":[{"raw":"Isa.1.1","value":"Isa.1.1"}],"t":"ref","v":"Isa 1:1"},") and was possibly related to King Amaziah. He lived in Jerusalem, was well educated, and had deep insight into human nature. He had a long ministry (about 740~685 BC); as Judah’s political and religious counselor, he had access to kings and was apparently the court historian (",{"href":"?bref=2Chr.26.22","r":"2Chr.26.22","rawR":"2Chr.26.22","sourceRefs":[{"raw":"2Chr.26.22","value":"2Chr.26.22"}],"t":"ref","v":"2 Chr 26:22"},"; ",{"href":"?bref=2Chr.32.32","r":"2Chr.32.32","rawR":"2Chr.32.32","sourceRefs":[{"raw":"2Chr.32.32","value":"2Chr.32.32"}],"t":"ref","v":"32:32"},"). Isaiah’s wife was called a “prophetess” (see Study Note on ",{"href":"?bref=Isa.8.3","r":"Isa.8.3","rawR":"Isa.8.3","sourceRefs":[{"raw":"Isa.8.3","value":"Isa.8.3"}],"t":"ref","v":"Isa 8:3"},"); their sons were Shear-jashub (",{"href":"?bref=Isa.7.3","r":"Isa.7.3","rawR":"Isa.7.3","sourceRefs":[{"raw":"Isa.7.3","value":"Isa.7.3"}],"t":"ref","v":"7:3"},") and Maher-shalal-hash-baz (",{"href":"?bref=Isa.8.3","r":"Isa.8.3","rawR":"Isa.8.3","sourceRefs":[{"raw":"Isa.8.3","value":"Isa.8.3"}],"t":"ref","v":"8:3"},")."],"sourceClass":"profile-body-fl","t":"p"},{"c":["Isaiah opposed social and political evil at all levels. He censured fortune-tellers. He rebuked kings for their willfulness and indifference. He denounced wealthy, influential people who ignored their responsibilities. And he exhorted everyone to obey God’s covenant. Isaiah opposed Canaanite idolatry and insincere religious observances (",{"href":"?bref=Isa.1.10-17","r":"Isa.1.10-17","rawR":"Isa.1.10-17","sourceRefs":[{"raw":"Isa.1.10-17","value":"Isa.1.10-17"}],"t":"ref","v":"1:10-17"},"; ",{"href":"?bref=Isa.29.13","r":"Isa.29.13","rawR":"Isa.29.13","sourceRefs":[{"raw":"Isa.29.13","value":"Isa.29.13"}],"t":"ref","v":"29:13"},"), proclaiming judgment and declaring that only a righteous remnant would survive (",{"href":"?bref=Isa.6.11-13","r":"Isa.6.11-13","rawR":"Isa.6.11-13","sourceRefs":[{"raw":"Isa.6.11-13","value":"Isa.6.11-13"}],"t":"ref","v":"6:11-13"},"). He foretold the coming Messiah, the peaceful prince of God’s kingdom (",{"href":"?bref=Isa.9.6-7","r":"Isa.9.6-7","rawR":"Isa.9.6-7","sourceRefs":[{"raw":"Isa.9.6-7","value":"Isa.9.6-7"}],"t":"ref","v":"9:6-7"},"; ",{"href":"?bref=Isa.11.1-11","r":"Isa.11.1-11","rawR":"Isa.11.1-11","sourceRefs":[{"raw":"Isa.11.1-11","value":"Isa.11.1-11"}],"t":"ref","v":"11:1-11"},") who was also an obedient, suffering servant (",{"href":"?bref=Isa.53.3-12","r":"Isa.53.3-12","rawR":"Isa.53.3-12","sourceRefs":[{"raw":"Isa.53.3-12","value":"Isa.53.3-12"}],"t":"ref","v":"53:3-12"},"). The book of Isaiah has more overtones of the New Testament than any other Old Testament book and is frequently cited by New Testament authors."],"sourceClass":"profile-body","t":"p"},{"c":["Passages for Further Study"],"sourceClass":"profile-refs-title","t":"h"},{"c":[{"href":"?bref=2Kgs.19.1-20.19","r":"2Kgs.19.1-20.19","rawR":"2Kgs.19.1-20.19","sourceRefs":[{"raw":"2Kgs.19.1-20.19","value":"2Kgs.19.1-20.19"}],"t":"ref","v":"2 Kgs 19:1–20:19"},"; ",{"href":"?bref=2Chr.26.22","r":"2Chr.26.22","rawR":"2Chr.26.22","sourceRefs":[{"raw":"2Chr.26.22","value":"2Chr.26.22"}],"t":"ref","v":"2 Chr 26:22"},"; ",{"href":"?bref=2Chr.32.20","r":"2Chr.32.20","rawR":"2Chr.32.20","sourceRefs":[{"raw":"2Chr.32.20","value":"2Chr.32.20"}],"t":"ref","v":"32:20"},", ",{"href":"?bref=2Chr.32.32","r":"2Chr.32.32","rawR":"2Chr.32.32","sourceRefs":[{"raw":"2Chr.32.32","value":"2Chr.32.32"}],"t":"ref","v":"32"},"; ",{"href":"?bref=Isa.1.1–66.24","r":"Isa.1.1–66.24","rawR":"Isa.1.1–66.24","sourceRefs":[{"raw":"Isa.1.1–66.24","value":"Isa.1.1–66.24"}],"t":"ref","v":"Isa 1:1–66:24"},"; ",{"href":"?bref=Matt.3.3","r":"Matt.3.3","rawR":"Matt.3.3","sourceRefs":[{"raw":"Matt.3.3","value":"Matt.3.3"}],"t":"ref","v":"Matt 3:3"},"; ",{"href":"?bref=Matt.4.14-16","r":"Matt.4.14-16","rawR":"Matt.4.14-16","sourceRefs":[{"raw":"Matt.4.14-16","value":"Matt.4.14-16"}],"t":"ref","v":"4:14-16"},"; ",{"href":"?bref=Matt.8.17","r":"Matt.8.17","rawR":"Matt.8.17","sourceRefs":[{"raw":"Matt.8.17","value":"Matt.8.17"}],"t":"ref","v":"8:17"},"; ",{"href":"?bref=Matt.12.17-21","r":"Matt.12.17-21","rawR":"Matt.12.17-21","sourceRefs":[{"raw":"Matt.12.17-21","value":"Matt.12.17-21"}],"t":"ref","v":"12:17-21"},"; ",{"href":"?bref=Matt.13.14-15","r":"Matt.13.14-15","rawR":"Matt.13.14-15","sourceRefs":[{"raw":"Matt.13.14-15","value":"Matt.13.14-15"}],"t":"ref","v":"13:14-15"},"; ",{"href":"?bref=Matt.15.7-9","r":"Matt.15.7-9","rawR":"Matt.15.7-9","sourceRefs":[{"raw":"Matt.15.7-9","value":"Matt.15.7-9"}],"t":"ref","v":"15:7-9"},"; ",{"href":"?bref=Mark.1.2-3","r":"Mark.1.2-3","ra