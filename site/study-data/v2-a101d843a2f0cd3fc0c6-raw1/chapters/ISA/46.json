r":72,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ISA","canonicalOSIS":"Isa","method":"official_book_intro_ref_title","sourceOSIS":"Isa"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Isa.1.1-66.24","sourceRelease":"1.25","sourceTitleExact":"Isaiah","supplementPointersNotIncludedAsContent":[],"title":"Isaiah","type":"Profile"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Isa.46.1-2","r":"Isa.46.1-2","rawR":"Isa.46.1-2","sourceRefs":[{"raw":"Isa.46.1-2","value":"Isa.46.1-2"}],"t":"ref","v":"46:1-2"}],"sourceClass":"sn-ref","t":"span"}," This taunt was against the self-contradiction of Babylonian religion."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Isa.46.1-2","refs":[{"book":"ISA","endChapter":46,"endVerse":2,"startChapter":46,"startVerse":1}],"sourceAttributes":{"name":"Isa.46.1-2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ISA","sourceChapterCoverage":[46],"sourceItemFragmentSha256":"6015625a5d9cd82260e299f7728a99abb96f83112e75f3bf475ff8d0147faf50","sourceItemName":"Isa.46.1-2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8889,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ISA","canonicalOSIS":"Isa","method":"official_book_intro_ref_title","sourceOSIS":"Isa"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Isa.46.1-2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Isa.46.1-2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Isa.46.1","r":"Isa.46.1","rawR":"Isa.46.1","sourceRefs":[{"raw":"Isa.46.1","value":"Isa.46.1"}],"t":"ref","v":"46:1"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Marduk-bel"],"sourceClass":"ital","t":"span"}," was the most important god in the Babylonian pantheon. ",{"c":["Bel"],"sourceClass":"sn-excerpt","t":"span"}," (similar to “Baal”) designated lordship. • ",{"c":["Nebo"],"sourceClass":"sn-excerpt","t":"span"}," (",{"c":["Nabu,"],"sourceClass":"ital","t":"span"}," ",{"c":["Nebu"],"sourceClass":"ital","t":"span"},"), the patron deity of Babylonian scribes, was thought to be the son of Marduk-bel. • Instead of being paraded in glory at a Babylonian festival, these gods would be ",{"c":["hauled away on ox carts"],"sourceClass":"sn-excerpt","t":"span"}," and disposed of, rejected by the Babylonian people."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Isa.46.1","refs":[{"book":"ISA","endChapter":46,"endVerse":1,"startChapter":46,"startVerse":1}],"sourceAttributes":{"name":"Isa.46.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ISA","sourceChapterCoverage":[46],"sourceItemFragmentSha256":"156c99fa67651f6e054cc31d65ef5e160c3e421bffb5b1a00d0e0e70715b06dc","sourceItemName":"Isa.46.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8890,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ISA","canonicalOSIS":"Isa","method":"official_book_intro_ref_title","sourceOSIS":"Isa"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Isa.46.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Isa.46.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Isa.46.3","r":"Isa.46.3","rawR":"Isa.46.3","sourceRefs":[{"raw":"Isa.46.3","value":"Isa.46.3"}],"t":"ref","v":"46:3"}],"sourceClass":"sn-ref","t":"span"}," Those ",{"c":["who remain in Israel"],"sourceClass":"sn-excerpt","t":"span"}," refers to the remnant that would be left alive after the destruction of Jerusalem in 586 ",{"c":["BC"],"sourceClass":"era","t":"span"},". • The Lord, the Creator of humanity, cares for and carries his people (contrast the Babylonian idols that must be ",{"c":["carried"],"sourceClass":"sn-excerpt","t":"span"}," instead). • ",{"c":["since you were born . . . before you were born:"],"sourceClass":"sn-excerpt","t":"span"}," The Lord chose Israel even before they were a nation (see also ",{"href":"?bref=Isa.49.5","r":"Isa.49.5","rawR":"Isa.49.5","sourceRefs":[{"raw":"Isa.49.5","value":"Isa.49.5"}],"t":"ref","v":"49:5"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Isa.46.3","refs":[{"book":"ISA","endChapter":46,"endVerse":3,"startChapter":46,"startVerse":3}],"sourceAttributes":{"name":"Isa.46.3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ISA","sourceChapterCoverage":[46],"sourceItemFragmentSha256":"6faede5209364ccd6f18f025d4e8ea9f0e0829ff0f55871a8378e53d48a226f0","sourceItemName":"Isa.46.3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8891,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ISA","canonicalOSIS":"Isa","method":"official_book_intro_ref_title","sourceOSIS":"Isa"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Isa.46.3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Isa.46.3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Isa.46.8-13","r":"Isa.46.8-13","rawR":"Isa.46.8-13","sourceRefs":[{"raw":"Isa.46.8-13","value":"Isa.46.8-13"}],"t":"ref","v":"46:8-13"}],"sourceClass":"sn-ref","t":"span"}," Many of the exiles would be completely discouraged and not believe the prediction of God’s rescue. God challenged this unbelief."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Isa.46.8-13","refs":[{"book":"ISA","endChapter":46,"endVerse":13,"startChapter":46,"startVerse":8}],"sourceAttributes":{"name":"Isa.46.8-13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ISA","sourceChapterCoverage":[46],"sourceItemFragmentSha256":"ad840a6a82b437a61f6ade5578df2c4cdecf0287d6d2f7e96ef640b7c5872f82","sourceItemName":"Isa.46.8-13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8892,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ISA","canonicalOSIS":"Isa","method":"official_book_intro_ref_title","sourceOSIS":"Isa"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Isa.46.8-13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Isa.46.8-13","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Isa.46.10","r":"Isa.46.10","rawR":"Isa.46.10","sourceRefs":[{"raw":"Isa.46.10","value":"Isa.46.10"}],"t":"ref","v":"46:10"}],"sourceClass":"sn-ref","t":"span"}," God knows ",{"c":["the future before it even happens"],"sourceClass":"sn-excerpt","t":"span"},{"c":[";"],"sourceClass":"ital","t":"span"}," he has comprehensive control over all events, and all his acts match his words (",{"href":"?bref=Isa.41.4","r":"Isa.41.4","rawR":"Isa.41.4","sourceRefs":[{"raw":"Isa.41.4","value":"Isa.41.4"}],"t":"ref","v":"41:4"},", ",{"href":"?bref=Isa.41.26","r":"Isa.41.26","rawR":"Isa.41.26","sourceRefs":[{"raw":"Isa.41.26","value":"Isa.41.26"}],"t":"ref","v":"26"},"). He is the First and the Last (",{"href":"?bref=Isa.44.6","r":"Isa.44.6","rawR":"Isa.44.6","sourceRefs":[{"raw":"Isa.44.6","value":"Isa.44.6"}],"t":"ref","v":"44:6"},"; ",{"href":"?bref=Isa.48.12","r":"Isa.48.12","rawR":"Isa.48.12","sourceRefs":[{"raw":"Isa.48.12","value":"Isa.48.12"}],"t":"ref","v":"48:12"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Isa.46.10","refs":[{"book":"ISA","endChapter":46,"endVerse":10,"startChapter":46,"startVerse":10}],"sourceAttributes":{"name":"Isa.46.10","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ISA","sourceChapterCoverage":[46],"sourceItemFragmentSha256":"3041630f9b25e3d7fdf4d6282201a6be3750fe51fb4f1e883b11a0282514a742","sourceItemName":"Isa.46.10","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8893,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ISA","canonicalOSIS":"Isa","method":"official_book_intro_ref_title","sourceOSIS":"Isa"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Isa.46.10","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Isa.46.10","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Isa.46.11","r":"Isa.46.11","rawR":"Isa.46.11","sourceRefs":[{"raw":"Isa.46.11","value":"Isa.46.11"}],"t":"ref","v":"46:11"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["swift bird of prey from the east"],"sourceClass":"sn-excerpt","t":"span"}," refers to Cyrus, the Persian king (see ",{"href":"?item=Isa.41.2_StudyNote_Filament","id":"Isa.41.2_StudyNote_Filament","rawId":"Isa.41.2_StudyNote_Filament","t":"link","v":"study note on 41:2"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Isa.46.11","refs":[{"book":"ISA","endChapter":46,"endVerse":11,"startChapter":46,"startVerse":11}],"sourceAttributes":{"name":"Isa.46.11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ISA","sourceChapterCoverage":[46],"sourceItemFragmentSha256":"f2142851beaa2b461e468bd939b26865d7fd16567d4fb1193a3c93a3f74a86af","sourceItemName":"Isa.46.11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8894,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ISA","canonicalOSIS":"Isa","method":"official_book_intro_ref_title","sourceOSIS":"Isa"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Isa.46.11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Isa.46.11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Isa.46.12","r":"Isa.46.12","rawR":"Isa.46.12","sourceRefs":[{"raw":"Isa.46.12","value":"Isa.46.12"}],"t":"ref","v":"46:12"}],"sourceClass":"sn-ref","t":"span"}," Formerly, Israel cared little for ",{"c":["doing right"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["righteousness;"],"sourceClass":"ital","t":"span"}," see also ",{"href":"?bref=Isa.58.2","r":"Isa.58.2","rawR":"Isa.58.2","sourceRefs":[{"raw":"Isa.58.2","value":"Isa.58.2"}],"t":"ref","v":"58:2"},"; ",{"href":"?bref=Isa.59.9","r":"Isa.59.9","rawR":"Isa.59.9","sourceRefs":[{"raw":"Isa.59.9","value":"Isa.59.9"}],"t":"ref","v":"59:9"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Isa.46.12","refs":[{"book":"ISA","endChapter":46,"endVerse":12,"startChapter":46,"startVerse":12}],"sourceAttributes":{"name":"Isa.46.12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ISA","sourceChapterCoverage":[46],"sourceItemFragmentSha256":"9f66292168971b1eef3c1ab562f2c3b68a17d715d12f34470bd90f68a92a249e","sourceItemName":"Isa.46.12","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8895,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ISA","canonicalOSIS":"Isa","method":"official_book_intro_ref_title","sourceOSIS":"Isa"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Isa.46.12","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Isa.46.12","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Isa.46.13","r":"Isa.46.13","rawR":"Isa.46.13","sourceRefs":[{"raw":"Isa.46.13","value":"Isa.46.13"}],"t":"ref","v":"46:13"}],"sourceClass":"sn-ref","t":"span"}," The good news for Israel was that God was coming to ",{"c":["set things right"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["I will bring my righteousness near;"],"sourceClass":"ital","t":"span"}," see ",{"href":"?bref=Isa.40.9","r":"Isa.40.9","rawR":"Isa.40.9","sourceRefs":[{"raw":"Isa.40.9","value":"Isa.40.9"}],"t":"ref","v":"40:9"},"; ",{"href":"?bref=Isa.51.5","r":"Isa.51.5","rawR":"Isa.51.5","sourceRefs":[{"raw":"Isa.51.5","value":"Isa.51.5"}],"t":"ref","v":"51:5"},"). • ",{"c":["show my glory to Israel:"],"sourceClass":"sn-excerpt","t":"span"}," Unlike a craftsman who bestows material splendor on an idol (",{"href":"?bref=Isa.44.13","r":"Isa.44.13","rawR":"Isa.44.13","sourceRefs":[{"raw":"Isa.44.13","value":"Isa.44.13"}],"t":"ref","v":"44:13"},"), the Lord bestows true dignity on his people."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Isa.46.13","refs":[{"book":"ISA","endChapter":46,"endVerse":13,"startChapter":46,"startVerse":13}],"sourceAttributes":{"name":"Isa.46.13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"ISA","sourceChapterCoverage":[46],"sourceItemFragmentSha256":"143fd9281ca32fe0c3ea2ae060414bebd84f1de55a234ee549aab7612ae400fd","sourceItemName":"Isa.46.13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8896,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"ISA","canonicalOSIS":"Isa","method":"official_book_intro_ref_title","sourceOSIS":"Isa"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Isa.46.13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Isa.46.13","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}