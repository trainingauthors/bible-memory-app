ogyandtheBible","title":"Archaeology and the Bible*"},{"id":"Bible","title":"Bible*"},{"id":"BibleCanonofthe","title":"Bible*, Canon of the"},{"id":"Brother","title":"Brother"},{"id":"Covenant","title":"Covenant"},{"id":"CriminalLawandPunishment","title":"Criminal Law and Punishment*"},{"id":"DeuteronomyBookof","title":"Deuteronomy, Book of"},{"id":"Elder","title":"Elder"},{"id":"HebrewLanguage","title":"Hebrew Language"},{"id":"HerodHerodianFamily","title":"Herod, Herodian Family*"},{"id":"Herodias","title":"Herodias"},{"id":"Incest","title":"Incest*"},{"id":"Inheritance","title":"Inheritance"},{"id":"LawBiblicalConceptof","title":"Law, Biblical Concept of"},{"id":"MaccabeanPeriod","title":"Maccabean Period*"},{"id":"MarriageMarriageCustoms","title":"Marriage, Marriage Customs"},{"id":"OffendOffense","title":"Offend, Offense"},{"id":"Purse","title":"Purse"},{"id":"RuthBookof","title":"Ruth, Book of"},{"id":"WeightsandMeasures","title":"Weights and Measures"},{"id":"Zerubbabel","title":"Zerubbabel"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"You must maintain accurate and honest weights and measures, so that you may live long in the land that the LORD your God is giving you.","verse":15},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"For everyone who behaves dishonestly in regard to these things is detestable to the LORD your God.","verse":16},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"When the LORD your God gives you rest from the enemies around you in the land that He is giving you to possess as an inheritance, you are to blot out the memory of Amalek from under heaven. Do not forget!","verse":19}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.25.3","r":"Deut.25.3","rawR":"Deut.25.3","sourceRefs":[{"raw":"Deut.25.3","value":"Deut.25.3"}],"t":"ref","v":"25:3"}],"sourceClass":"sn-ref","t":"span"}," At a flogging, the maximum number of strikes allowed was ",{"c":["forty lashes."],"sourceClass":"sn-excerpt","t":"span"}," Fewer could be applied depending on the case (",{"href":"?bref=Deut.25.2","r":"Deut.25.2","rawR":"Deut.25.2","sourceRefs":[{"raw":"Deut.25.2","value":"Deut.25.2"}],"t":"ref","v":"25:2"},"). As people created in the image of God, even wrongdoers were entitled to mercy and respect. In later Judaism, thirty-nine lashes were given (see ",{"href":"?bref=2Cor.11.24","r":"2Cor.11.24","rawR":"2Cor.11.24","sourceRefs":[{"raw":"2Cor.11.24","value":"2Cor.11.24"}],"t":"ref","v":"2 Cor 11:24 and note"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.25.3","refs":[{"book":"DEU","endChapter":25,"endVerse":3,"startChapter":25,"startVerse":3}],"sourceAttributes":{"name":"Deut.25.3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[25],"sourceItemFragmentSha256":"c5093ae4ef183047a2b49d5c26d5375650b20061b0940e1c5039dfa3ff07f8e4","sourceItemName":"Deut.25.3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2329,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.25.3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.25.3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.25.4","r":"Deut.25.4","rawR":"Deut.25.4","sourceRefs":[{"raw":"Deut.25.4","value":"Deut.25.4"}],"t":"ref","v":"25:4"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["You must not muzzle an ox:"],"sourceClass":"sn-excerpt","t":"span"}," The animal had to be able to eat the grain as it worked (cp. ",{"href":"?bref=1Cor.9.9-14","r":"1Cor.9.9-14","rawR":"1Cor.9.9-14","sourceRefs":[{"raw":"1Cor.9.9-14","value":"1Cor.9.9-14"}],"t":"ref","v":"1 Cor 9:9-14"},"; ",{"href":"?bref=1Tim.5.17-18","r":"1Tim.5.17-18","rawR":"1Tim.5.17-18","sourceRefs":[{"raw":"1Tim.5.17-18","value":"1Tim.5.17-18"}],"t":"ref","v":"1 Tim 5:17-18"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.25.4","refs":[{"book":"DEU","endChapter":25,"endVerse":4,"startChapter":25,"startVerse":4}],"sourceAttributes":{"name":"Deut.25.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[25],"sourceItemFragmentSha256":"bfcd6b078a7963a41a69ca92daf0c659ead34e21cef3b051fcd424fda4757f6f","sourceItemName":"Deut.25.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2330,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.25.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.25.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.25.5","r":"Deut.25.5","rawR":"Deut.25.5","sourceRefs":[{"raw":"Deut.25.5","value":"Deut.25.5"}],"t":"ref","v":"25:5"}],"sourceClass":"sn-ref","t":"span"}," The term rendered ",{"c":["duties of a brother-in-law"],"sourceClass":"sn-excerpt","t":"span"}," refers to the ",{"c":["levirate"],"sourceClass":"latin","t":"span"}," (Latin for ",{"c":["brother-in-law"],"sourceClass":"ital","t":"span"},") marriage custom. The brother of a deceased man was encouraged to marry his brother’s widow and father her children so that the name of the dead brother would not be forgotten. For examples of this custom, see ",{"href":"?bref=Gen.38.6-11","r":"Gen.38.6-11","rawR":"Gen.38.6-11","sourceRefs":[{"raw":"Gen.38.6-11","value":"Gen.38.6-11"}],"t":"ref","v":"Gen 38:6-11"},"; ",{"href":"?bref=Ruth.3.12-13","r":"Ruth.3.12-13","rawR":"Ruth.3.12-13","sourceRefs":[{"raw":"Ruth.3.12-13","value":"Ruth.3.12-13"}],"t":"ref","v":"Ruth 3:12-13"},"; ",{"href":"?bref=Ruth.4.1-12","r":"Ruth.4.1-12","rawR":"Ruth.4.1-12","sourceRefs":[{"raw":"Ruth.4.1-12","value":"Ruth.4.1-12"}],"t":"ref","v":"4:1-12"},"; ",{"href":"?bref=Luke.20.27-33","r":"Luke.20.27-33","rawR":"Luke.20.27-33","sourceRefs":[{"raw":"Luke.20.27-33","value":"Luke.20.27-33"}],"t":"ref","v":"Luke 20:27-33"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.25.5","refs":[{"book":"DEU","endChapter":25,"endVerse":5,"startChapter":25,"startVerse":5}],"sourceAttributes":{"name":"Deut.25.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[25],"sourceItemFragmentSha256":"e5e52daf2962fb6844ebebe87a5689fc7ee0bad0415df775e6abd31d363df551","sourceItemName":"Deut.25.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2331,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.25.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.25.5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.25.9","r":"Deut.25.9","rawR":"Deut.25.9","sourceRefs":[{"raw":"Deut.25.9","value":"Deut.25.9"}],"t":"ref","v":"25:9"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["pull his sandal from his foot:"],"sourceClass":"sn-excerpt","t":"span"}," Using footwear, which touched the ground, the brother-in-law showed that he relinquished any claim to his dead brother’s estate (",{"href":"?bref=Ruth.4.7","r":"Ruth.4.7","rawR":"Ruth.4.7","sourceRefs":[{"raw":"Ruth.4.7","value":"Ruth.4.7"}],"t":"ref","v":"Ruth 4:7"},"). • ",{"c":["spit in his face:"],"sourceClass":"sn-excerpt","t":"span"}," This is an almost universal gesture of utter contempt (see ",{"href":"?bref=Num.12.14","r":"Num.12.14","rawR":"Num.12.14","sourceRefs":[{"raw":"Num.12.14","value":"Num.12.14"}],"t":"ref","v":"Num 12:14"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.25.9","refs":[{"book":"DEU","endChapter":25,"endVerse":9,"startChapter":25,"startVerse":9}],"sourceAttributes":{"name":"Deut.25.9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[25],"sourceItemFragmentSha256":"8a74af54ef81bf95771176d912586a28d7b46005da2b7fed6bf6b2671485dfa9","sourceItemName":"Deut.25.9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2332,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.25.9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.25.9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.25.10","r":"Deut.25.10","rawR":"Deut.25.10","sourceRefs":[{"raw":"Deut.25.10","value":"Deut.25.10"}],"t":"ref","v":"25:10"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["his family will be referred to:"],"sourceClass":"sn-excerpt","t":"span"}," If a man refused to perpetuate his brother’s name, he would be spoken of in a derogatory way."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.25.10","refs":[{"book":"DEU","endChapter":25,"endVerse":10,"startChapter":25,"startVerse":10}],"sourceAttributes":{"name":"Deut.25.10","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[25],"sourceItemFragmentSha256":"51277aadd33a855ac40f759480ba7fefebcb45ba8899de72accf1182ec67a228","sourceItemName":"Deut.25.10","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2333,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.25.10","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.25.10","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.25.11-12","r":"Deut.25.11-12","rawR":"Deut.25.11-12","sourceRefs":[{"raw":"Deut.25.11-12","value":"Deut.25.11-12"}],"t":"ref","v":"25:11-12"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["cut off her hand:"],"sourceClass":"sn-excerpt","t":"span"}," The woman’s act would emasculate the man, depriving him of (or ",{"c":["cutting off"],"sourceClass":"ital","t":"span"}," from him) any offspring. As with the previous law (",{"href":"?bref=Deut.25.9","r":"Deut.25.9","rawR":"Deut.25.9","sourceRefs":[{"raw":"Deut.25.9","value":"Deut.25.9"}],"t":"ref","v":"25:9"},"), the punishment fits the crime (",{"c":["lex talionis;"],"sourceClass":"ital","t":"span"}," see ",{"href":"?item=Deut.19.21_StudyNote_Filament","id":"Deut.19.21_StudyNote_Filament","rawId":"Deut.19.21_StudyNote_Filament","t":"link","v":"study note on 19:21"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.25.11-12","refs":[{"book":"DEU","endChapter":25,"endVerse":12,"startChapter":25,"startVerse":11}],"sourceAttributes":{"name":"Deut.25.11-12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[25],"sourceItemFragmentSha256":"2cc807a6a71949f529be32e0f7bea766688fcb2e78567fa4be7e7fe21086e3d9","sourceItemName":"Deut.25.11-12","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2334,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.25.11-12","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.25.11-12","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.25.13-14","r":"Deut.25.13-14","rawR":"Deut.25.13-14","sourceRefs":[{"raw":"Deut.25.13-14","value":"Deut.25.13-14"}],"t":"ref","v":"25:13-14"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["You must use accurate scales . . . full and honest measures"],"sourceClass":"sn-excerpt","t":"span"}," (Hebrew ",{"c":["you must not have stone and stone, large and small, . . . ephah and ephah, large and small"],"sourceClass":"ital","t":"span"},"): Merchants were not to use two sets of weights and measures for cheating customers—a heavier weight or measure when purchasing goods (thus reducing their own cost) and a lighter one when selling them (thus increasing their own profit)."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.25.13-14","refs":[{"book":"DEU","endChapter":25,"endVerse":14,"startChapter":25,"startVerse":13}],"sourceAttributes":{"name":"Deut.25.13-14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[25],"sourceItemFragmentSha256":"141c5ae4d77760fc762471979def53e173d5023446d6a4463a8d5e843f873faf","sourceItemName":"Deut.25.13-14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2335,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.25.13-14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.25.13-14","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.25.17","r":"Deut.25.17","rawR":"Deut.25.17","sourceRefs":[{"raw":"Deut.25.17","value":"Deut.25.17"}],"t":"ref","v":"25:17"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["Amalekites"],"sourceClass":"sn-excerpt","t":"span"}," were tribal peoples who attacked Israel’s rear flanks during the Sinai wilderness wandering (",{"href":"?bref=Exod.17.8-16","r":"Exod.17.8-16","rawR":"Exod.17.8-16","sourceRefs":[{"raw":"Exod.17.8-16","value":"Exod.17.8-16"}],"t":"ref","v":"Exod 17:8-16"},"). They were apparently related to the Edomites (",{"href":"?bref=Gen.36.12","r":"Gen.36.12","rawR":"Gen.36.12","sourceRefs":[{"raw":"Gen.36.12","value":"Gen.36.12"}],"t":"ref","v":"Gen 36:12"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.25.17","refs":[{"book":"DEU","endChapter":25,"endVerse":17,"startChapter":25,"startVerse":17}],"sourceAttributes":{"name":"Deut.25.17","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[25],"sourceItemFragmentSha256":"a29064b2fa7090d042a8891fbcdf5dde0dfc9dc9d1b7d4a2be1fa2d5ebf0c53b","sourceItemName":"Deut.25.17","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2336,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.25.17","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.25.17","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.25.19","r":"Deut.25.19","rawR":"Deut.25.19","sourceRefs":[{"raw":"Deut.25.19","value":"Deut.25.19"}],"t":"ref","v":"25:19"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["destroy:"],"sourceClass":"sn-excerpt","t":"span"}," God authorized war against his enemies. Later, Samuel commanded Saul to completely destroy ",{"c":["the Amalekites"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," something he only partially accomplished (",{"href":"?bref=1Sam.15.1-35","r":"1Sam.15.1-35","rawR":"1Sam.15.1-35","sourceRefs":[{"raw":"1Sam.15.1-35","value":"1Sam.15.1-35"}],"t":"ref","v":"1 Sam 15"},"). As a result, God rejected Saul as king. • ",{"c":["from under heaven:"],"sourceClass":"sn-excerpt","t":"span"}," The Amalekites were to be obliterated completely (see ",{"href":"?item=Deut.2.34_StudyNote_Filament","id":"Deut.2.34_StudyNote_Filament","rawId":"Deut.2.34_StudyNote_Filament","t":"link","v":"study note on Deut 2:34"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.25.19","refs":[{"book":"DEU","endChapter":25,"endVerse":19,"startChapter":25,"startVerse":19}],"sourceAttributes":{"name":"Deut.25.19","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[25],"sourceItemFragmentSha256":"fa64143f3466404d7ed9f5a5907ae5d78ab297aeb222e465f93a4908645c67d7","sourceItemName":"Deut.25.19","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2337,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.25.19","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.25.19","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}