8db2136a6f4df7f72ae94d68fa3a155e0330bfd275164788e9e0e8dbef40fb1.json","title":"Miracle"},"ProphetProphetess":{"file":"dictionary/286bb9d4638ec7b15bf70acb6475f36527a3a2485b61f86327f3214745b81a49.json","title":"Prophet, Prophetess"},"Ransom":{"file":"dictionary/ed905eb653630f7b7802564ec87c99b97eb97841a20806e75ca904e5137a07d5.json","title":"Ransom"},"Sign":{"file":"dictionary/ea3d383aaeb282be81aa6eb4e781f6f88ea7e67d4a6244eb7af8f23d057bcafb.json","title":"Sign"},"Soul":{"file":"dictionary/66fc7772300f161526ab0b24231b00ff7e389b5dbb022f8b7aaa89f09b42d655.json","title":"Soul"},"SpiritofGod":{"file":"dictionary/1dc9e8143ad543108f8801c89e75db01f1ebac11e68923476f0b56cf07bd410a.json","title":"Spirit of God"},"Tell":{"file":"dictionary/43291e97cb4a7f0083c48ba9bc86328673e34fd2f79a3b0454e2108a63a5fdcf.json","title":"Tell*"}},"dictionaryRelated":[{"id":"ArchaeologyandtheBible","title":"Archaeology and the Bible*"},{"id":"BelialBeliar","title":"Belial*, Beliar*"},{"id":"Brother","title":"Brother"},{"id":"CourtsandTrials","title":"Courts and Trials"},{"id":"Covenant","title":"Covenant"},{"id":"CriminalLawandPunishment","title":"Criminal Law and Punishment*"},{"id":"DeuteronomyBookof","title":"Deuteronomy, Book of"},{"id":"Dreams","title":"Dreams"},{"id":"KingsBooksofFirstandSecond","title":"Kings, Books of First and Second"},{"id":"LawBiblicalConceptof","title":"Law, Biblical Concept of"},{"id":"Miracle","title":"Miracle"},{"id":"ProphetProphetess","title":"Prophet, Prophetess"},{"id":"Ransom","title":"Ransom"},{"id":"Sign","title":"Sign"},{"id":"Soul","title":"Soul"},{"id":"SpiritofGod","title":"Spirit of God"},{"id":"Tell","title":"Tell*"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"you must not listen to the words of that prophet or dreamer. For the LORD your God is testing you to find out whether you love Him with all your heart and with all your soul.","verse":3},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"You are to follow the LORD your God and fear Him. Keep His commandments and listen to His voice; serve Him and hold fast to Him.","verse":4},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Such a prophet or dreamer must be put to death, because he has advocated rebellion against the LORD your God, who brought you out of the land of Egypt and redeemed you from the house of slavery; he has tried to turn you from the way in which the LORD your God has commanded you to walk. So you must purge the evil from among you.","verse":5},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Stone him to death for trying to turn you away from the LORD your God, who brought you out of the land of Egypt, out of the house of slavery.","verse":10},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"If, regarding one of the cities the LORD your God is giving you to inhabit, you hear it said","verse":12},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"And you are to gather all its plunder in the middle of the public square, and completely burn the city and all its plunder as a whole burnt offering to the LORD your God. The city must remain a mound of ruins forever, never to be rebuilt.","verse":16},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Nothing devoted to destruction shall cling to your hands, so that the LORD will turn from His fierce anger, grant you mercy, show you compassion, and multiply you as He swore to your fathers,","verse":17},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"because you obey the LORD your God, keeping all His commandments I am giving you today and doing what is right in the eyes of the LORD your God.","verse":18}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.13.1-18","r":"Deut.13.1-18","rawR":"Deut.13.1-18","sourceRefs":[{"raw":"Deut.13.1-18","value":"Deut.13.1-18"}],"t":"ref","v":"13:1-18"}],"sourceClass":"sn-ref","t":"span"}," Prophets who tried to lead Israel away from the one true God were guilty of treason, which carried the death penalty. No other religion insisted on exclusive worship of their national gods; consequently, such harsh penalties for the worship of competing deities were unknown elsewhere in the ancient Near East."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.13.1-18","refs":[{"book":"DEU","endChapter":13,"endVerse":18,"startChapter":13,"startVerse":1}],"sourceAttributes":{"name":"Deut.13.1-18","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[13],"sourceItemFragmentSha256":"5d54d0f2c4d933127a713ae7964064f9cb1bd51c60dfad397fafd21ff2ff6429","sourceItemName":"Deut.13.1-18","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2199,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.13.1-18","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.13.1-18","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.13.1","r":"Deut.13.1","rawR":"Deut.13.1","sourceRefs":[{"raw":"Deut.13.1","value":"Deut.13.1"}],"t":"ref","v":"13:1"}],"sourceClass":"sn-ref","t":"span"}," God performed ",{"c":["signs"],"sourceClass":"sn-excerpt","t":"span"}," and ",{"c":["miracles"],"sourceClass":"sn-excerpt","t":"span"}," to induce amazement and faith in those who witnessed them (see ",{"href":"?bref=Deut.6.22","r":"Deut.6.22","rawR":"Deut.6.22","sourceRefs":[{"raw":"Deut.6.22","value":"Deut.6.22"}],"t":"ref","v":"6:22"},"). False prophets and magicians were able to replicate these feats to a degree and thus sometimes led God’s people astray (see ",{"href":"?bref=Exod.7.11","r":"Exod.7.11","rawR":"Exod.7.11","sourceRefs":[{"raw":"Exod.7.11","value":"Exod.7.11"}],"t":"ref","v":"Exod 7:11"},", ",{"href":"?bref=Exod.7.22","r":"Exod.7.22","rawR":"Exod.7.22","sourceRefs":[{"raw":"Exod.7.22","value":"Exod.7.22"}],"t":"ref","v":"22"},"; ",{"href":"?bref=Exod.8.7","r":"Exod.8.7","rawR":"Exod.8.7","sourceRefs":[{"raw":"Exod.8.7","value":"Exod.8.7"}],"t":"ref","v":"8:7"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.13.1","refs":[{"book":"DEU","endChapter":13,"endVerse":1,"startChapter":13,"startVerse":1}],"sourceAttributes":{"name":"Deut.13.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[13],"sourceItemFragmentSha256":"6d89cc5951ee9139e39844589e7f26a2e24b7495c650ef9930d97037189d7ca7","sourceItemName":"Deut.13.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2200,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.13.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.13.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.13.5","r":"Deut.13.5","rawR":"Deut.13.5","sourceRefs":[{"raw":"Deut.13.5","value":"Deut.13.5"}],"t":"ref","v":"13:5"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["visionaries:"],"sourceClass":"sn-excerpt","t":"span"}," Literally ",{"c":["dreamer of dreams."],"sourceClass":"ital","t":"span"}," • ",{"c":["purge"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["burn"],"sourceClass":"ital","t":"span"},"): God wanted false prophets to be completely eliminated, leaving no residue of their evil ways. See also ",{"href":"?bref=Deut.17.12","r":"Deut.17.12","rawR":"Deut.17.12","sourceRefs":[{"raw":"Deut.17.12","value":"Deut.17.12"}],"t":"ref","v":"17:12"},"; ",{"href":"?bref=Deut.19.13","r":"Deut.19.13","rawR":"Deut.19.13","sourceRefs":[{"raw":"Deut.19.13","value":"Deut.19.13"}],"t":"ref","v":"19:13"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.13.5","refs":[{"book":"DEU","endChapter":13,"endVerse":5,"startChapter":13,"startVerse":5}],"sourceAttributes":{"name":"Deut.13.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[13],"sourceItemFragmentSha256":"2b15eb02a93543d975f08797fa0a48c9e1dff0281abfc15993bf38b36f2c82bb","sourceItemName":"Deut.13.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2201,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.13.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.13.5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.13.6","r":"Deut.13.6","rawR":"Deut.13.6","sourceRefs":[{"raw":"Deut.13.6","value":"Deut.13.6"}],"t":"ref","v":"13:6"}],"sourceClass":"sn-ref","t":"span"},{"c":[" neither you nor your ancestors have known:"],"sourceClass":"sn-excerpt","t":"span"}," The Israelites had heard of these false gods before, but they had never worshiped them. Doing so would violate the first two commandments, the essence of the covenant."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.13.6","refs":[{"book":"DEU","endChapter":13,"endVerse":6,"startChapter":13,"startVerse":6}],"sourceAttributes":{"name":"Deut.13.6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[13],"sourceItemFragmentSha256":"dd2bdeac120a390b8398c57e3194e36c9a5d4fecacf04e2711e0e7bb5fc4fefa","sourceItemName":"Deut.13.6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2202,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.13.6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.13.6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.13.9","r":"Deut.13.9","rawR":"Deut.13.9","sourceRefs":[{"raw":"Deut.13.9","value":"Deut.13.9"}],"t":"ref","v":"13:9"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Strike the first blow yourself:"],"sourceClass":"sn-excerpt","t":"span"}," Because the guilty parties would be members of one’s own family (",{"href":"?bref=Deut.13.6","r":"Deut.13.6","rawR":"Deut.13.6","sourceRefs":[{"raw":"Deut.13.6","value":"Deut.13.6"}],"t":"ref","v":"13:6"},"), this difficult demand would test the depth of a person’s commitment to worship the Lord exclusively. Love for God must take priority over love for family members and friends (",{"href":"?bref=Matt.10.34-39","r":"Matt.10.34-39","rawR":"Matt.10.34-39","sourceRefs":[{"raw":"Matt.10.34-39","value":"Matt.10.34-39"}],"t":"ref","v":"Matt 10:34-39"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.13.9","refs":[{"book":"DEU","endChapter":13,"endVerse":9,"startChapter":13,"startVerse":9}],"sourceAttributes":{"name":"Deut.13.9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[13],"sourceItemFragmentSha256":"3e855392758a6675ab041b7ae1e74f4c60bbb479aa56b0005d29c5aa5aedaf02","sourceItemName":"Deut.13.9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2203,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.13.9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.13.9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.13.13","r":"Deut.13.13","rawR":"Deut.13.13","sourceRefs":[{"raw":"Deut.13.13","value":"Deut.13.13"}],"t":"ref","v":"13:13"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["scoundrels"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["sons of Belial"],"sourceClass":"ital","t":"span"},"): In Hebrew, “son(s) of” often expresses group affiliation or shared characteristics. ",{"c":["Scoundrels"],"sourceClass":"ital","t":"span"}," typically deceived others and led them astray (",{"href":"?bref=Pr.6.12","r":"Pr.6.12","rawR":"Pr.6.12","sourceRefs":[{"raw":"Pr.6.12","value":"Pr.6.12"}],"t":"ref","v":"Prov 6:12"},"; ",{"href":"?bref=Pr.16.27","r":"Pr.16.27","rawR":"Pr.16.27","sourceRefs":[{"raw":"Pr.16.27","value":"Pr.16.27"}],"t":"ref","v":"16:27"},"; ",{"href":"?bref=Pr.19.28","r":"Pr.19.28","rawR":"Pr.19.28","sourceRefs":[{"raw":"Pr.19.28","value":"Pr.19.28"}],"t":"ref","v":"19:28"},"; ",{"href":"?bref=Nah.1.11","r":"Nah.1.11","rawR":"Nah.1.11","sourceRefs":[{"raw":"Nah.1.11","value":"Nah.1.11"}],"t":"ref","v":"Nah 1:11"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.13.13","refs":[{"book":"DEU","endChapter":13,"endVerse":13,"startChapter":13,"startVerse":13}],"sourceAttributes":{"name":"Deut.13.13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[13],"sourceItemFragmentSha256":"e14220046e5f9528059714dccb638a5e54b5d8a8588b7cc770dbcf15d161816a","sourceItemName":"Deut.13.13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2204,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.13.13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsCo