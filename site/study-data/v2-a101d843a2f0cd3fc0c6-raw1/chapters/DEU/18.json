","title":"Priests and Levites"},"Prophecy":{"file":"dictionary/2230864ea0e1d7a0d22e60f1cd1ca915e6b99d8360bb5574adc2415ebb961f33.json","title":"Prophecy"},"ProphetProphetess":{"file":"dictionary/286bb9d4638ec7b15bf70acb6475f36527a3a2485b61f86327f3214745b81a49.json","title":"Prophet, Prophetess"},"Qumran":{"file":"dictionary/e009133c754823848e95029a819522762b6ac94080a4abbc00cbb1a10dc0a567.json","title":"Qumran*"},"Samaritans":{"file":"dictionary/1bc8ce62b97b93e17d083b2780b0e6eda347c5409e96feb498098173a5bae706.json","title":"Samaritans"},"Sheol":{"file":"dictionary/8fc31f793a66c47fd2240ef0dc053e82f21940245b0f39177820ebab6d546e3d.json","title":"Sheol*"},"Soothsayer":{"file":"dictionary/5f6db6c9eddc864bcdd18a8a0226004dba894f0c087ebbe654a545eddd17d918.json","title":"Soothsayer*"},"Sorcery":{"file":"dictionary/7d5ad1d390cf2b75dcf0d33752b792fe884bafd5e2e9fe25a93c23ec4494f31a.json","title":"Sorcery"},"SpiritofGod":{"file":"dictionary/1dc9e8143ad543108f8801c89e75db01f1ebac11e68923476f0b56cf07bd410a.json","title":"Spirit of God"}},"dictionaryRelated":[{"id":"Abomination","title":"Abomination"},{"id":"ArchaeologyandtheBible","title":"Archaeology and the Bible*"},{"id":"Balaam","title":"Balaam"},{"id":"Covenant","title":"Covenant"},{"id":"DeadPlaceofthe","title":"Dead, Place of the"},{"id":"DeuteronomyBookof","title":"Deuteronomy, Book of"},{"id":"DietaryLaws","title":"Dietary Laws*"},{"id":"Dreams","title":"Dreams"},{"id":"EphodGarment","title":"Ephod (Garment)"},{"id":"FeastsandFestivalsofIsrael","title":"Feasts and Festivals of Israel"},{"id":"Inheritance","title":"Inheritance"},{"id":"JohntheBaptist","title":"John the Baptist"},{"id":"KingsBooksofFirstandSecond","title":"Kings, Books of First and Second"},{"id":"LawBiblicalConceptof","title":"Law, Biblical Concept of"},{"id":"LeviticalCities","title":"Levitical Cities"},{"id":"Magic","title":"Magic"},{"id":"Messiah","title":"Messiah"},{"id":"NecromancerNecromancy","title":"Necromancer*, Necromancy*"},{"id":"Omen","title":"Omen"},{"id":"Patrimony","title":"Patrimony*"},{"id":"PlaguesuponEgypt","title":"Plagues upon Egypt"},{"id":"PriestsandLevites","title":"Priests and Levites"},{"id":"Prophecy","title":"Prophecy"},{"id":"ProphetProphetess","title":"Prophet, Prophetess"},{"id":"Qumran","title":"Qumran*"},{"id":"Samaritans","title":"Samaritans"},{"id":"Sheol","title":"Sheol*"},{"id":"Soothsayer","title":"Soothsayer*"},{"id":"Sorcery","title":"Sorcery"},{"id":"SpiritofGod","title":"Spirit of God"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"The Levitical priests—indeed the whole tribe of Levi—shall have no portion or inheritance with Israel. They are to eat the food offerings to the LORD; that is their inheritance.","verse":1},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Although they have no inheritance among their brothers, the LORD is their inheritance, as He promised them.","verse":2},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"For the LORD your God has chosen Levi and his sons out of all your tribes to stand and minister in His name for all time.","verse":5},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Now if a Levite moves from any town of residence throughout Israel and comes in all earnestness to the place the LORD will choose,","verse":6},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"then he shall serve in the name of the LORD his God like all his fellow Levites who stand there before the LORD.","verse":7},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"When you enter the land that the LORD your God is giving you, do not imitate the detestable ways of the nations there.","verse":9},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"For whoever does these things is detestable to the LORD. And because of these detestable things, the LORD your God is driving out the nations before you.","verse":12},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"You must be blameless before the LORD your God.","verse":13},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Though these nations, which you will dispossess, listen to conjurers and diviners, the LORD your God has not permitted you to do so.","verse":14},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"The LORD your God will raise up for you a prophet like me from among your brothers. You must listen to him.","verse":15},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"This is what you asked of the LORD your God at Horeb on the day of the assembly, when you said, “Let us not hear the voice of the LORD our God or see this great fire anymore, so that we will not die!”","verse":16},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Then the LORD said to me, “They have spoken well.","verse":17},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"You may ask in your heart, “How can we recognize a message that the LORD has not spoken?”","verse":21},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"When a prophet speaks in the name of the LORD and the message does not come to pass or come true, that is a message the LORD has not spoken. The prophet has spoken presumptuously. Do not be afraid of him.","verse":22}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.18.1","r":"Deut.18.1","rawR":"Deut.18.1","sourceRefs":[{"raw":"Deut.18.1","value":"Deut.18.1"}],"t":"ref","v":"18:1"}],"sourceClass":"sn-ref","t":"span"}," The term ",{"c":["Levitical priests"],"sourceClass":"sn-excerpt","t":"span"}," described the entire ",{"c":["tribe of Levi"],"sourceClass":"sn-excerpt","t":"span"},". Technically, however, only Aaron’s descendants were priests. The non-priestly Levites were their assistants (see ",{"href":"?bref=Deut.12.12","r":"Deut.12.12","rawR":"Deut.12.12","sourceRefs":[{"raw":"Deut.12.12","value":"Deut.12.12"}],"t":"ref","v":"12:12"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.18.1","refs":[{"book":"DEU","endChapter":18,"endVerse":1,"startChapter":18,"startVerse":1}],"sourceAttributes":{"name":"Deut.18.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[18],"sourceItemFragmentSha256":"68451a1599aa6fdf923d794e645aaefd82c236f1f01329a731b5b67439a78082","sourceItemName":"Deut.18.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2257,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.18.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.18.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.18.2","r":"Deut.18.2","rawR":"Deut.18.2","sourceRefs":[{"raw":"Deut.18.2","value":"Deut.18.2"}],"t":"ref","v":"18:2"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["The"],"sourceClass":"sn-excerpt","t":"span"}," ",{"c":["Lord"],"sourceClass":"sn-excerpt-divine-name","t":"span"},{"c":[" himself is their special possession:"],"sourceClass":"sn-excerpt","t":"span"}," The allotment of the Levites was spiritual, not territorial or material. They possessed the Lord by giving their whole lives to his service. This idea is a remarkable inverse of the idea that Israel was the Lord’s possession (see ",{"href":"?bref=Deut.7.6","r":"Deut.7.6","rawR":"Deut.7.6","sourceRefs":[{"raw":"Deut.7.6","value":"Deut.7.6"}],"t":"ref","v":"7:6"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.18.2","refs":[{"book":"DEU","endChapter":18,"endVerse":2,"startChapter":18,"startVerse":2}],"sourceAttributes":{"name":"Deut.18.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[18],"sourceItemFragmentSha256":"d845b7a24ea78af38b86e002bf1af7a23c2b8f99c608b2d03f6ac6d481687f59","sourceItemName":"Deut.18.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2258,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.18.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.18.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.18.3","r":"Deut.18.3","rawR":"Deut.18.3","sourceRefs":[{"raw":"Deut.18.3","value":"Deut.18.3"}],"t":"ref","v":"18:3"}],"sourceClass":"sn-ref","t":"span"}," In the dietary fare of ancient Israel, ",{"c":["the shoulder, the cheeks, and the stomach"],"sourceClass":"sn-excerpt","t":"span"}," of oxen and sheep were the choice cuts. God’s priestly servants were to be honored by receiving the very best (see ",{"href":"?bref=Lev.7.28-34","r":"Lev.7.28-34","rawR":"Lev.7.28-34","sourceRefs":[{"raw":"Lev.7.28-34","value":"Lev.7.28-34"}],"t":"ref","v":"Lev 7:28-34"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.18.3","refs":[{"book":"DEU","endChapter":18,"endVerse":3,"startChapter":18,"startVerse":3}],"sourceAttributes":{"name":"Deut.18.3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[18],"sourceItemFragmentSha256":"a542da98105ad7371103227429bf20ba6d8a3a0b9a995d5d544496d4c8591600","sourceItemName":"Deut.18.3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2259,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.18.3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.18.3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.18.8","r":"Deut.18.8","rawR":"Deut.18.8","sourceRefs":[{"raw":"Deut.18.8","value":"Deut.18.8"}],"t":"ref","v":"18:8"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["support from his family:"],"sourceClass":"sn-excerpt","t":"span"}," Although Levites were in full-time ministry at the Tabernacle and (later) the Temple, they could still hold material assets of their own (see ",{"href":"?bref=Num.35.1-8","r":"Num.35.1-8","rawR":"Num.35.1-8","sourceRefs":[{"raw":"Num.35.1-8","value":"Num.35.1-8"}],"t":"ref","v":"Num 35:1-8"},"). The Levites were to be supported by the regular offerings designated for that purpose without having to forfeit any of their own assets."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.18.8","refs":[{"book":"DEU","endChapter":18,"endVerse":8,"startChapter":18,"startVerse":8}],"sourceAttributes":{"name":"Deut.18.8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[18],"sourceItemFragmentSha256":"113cfba981d11818691f956d168abd4dada02ac5fdb8f900a0bd477d84cd8958","sourceItemName":"Deut.18.8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2260,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.18.8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.18.8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.18.10","r":"Deut.18.10","rawR":"Deut.18.10","sourceRefs":[{"raw":"Deut.18.10","value":"Deut.18.10"}],"t":"ref","v":"18:10"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["never sacrifice your son or daughter as a burnt offering:"],"sourceClass":"sn-excerpt","t":"span"}," Some Canaanite religions included child sacrifice to appease their gods. Israel was strictly warned never to engage in this practice (",{"href":"?bref=Exod.34.15-16","r":"Exod.34.15-16","rawR":"Exod.34.15-16","sourceRefs":[{"raw":"Exod.34.15-16","value":"Exod.34.15-16"}],"t":"ref","v":"Exod 34:15-16"},"; ",{"href":"?bref=Lev.18.21","r":"Lev.18.21","rawR":"Lev.18.21","sourceRefs":[{"raw":"Lev.18.21","value":"Lev.18.21"}],"t":"ref","v":"Lev 18:21"},"; ",{"href":"?bref=Lev.20.2-5","r":"Lev.20.2-5","rawR":"Lev.20.2-5","sourceRefs":[{"raw":"Lev.20.2-5","value":"Lev.20.2-5"}],"t":"ref","v":"20:2-5"},"). When they did, it aroused God’s judgment (",{"href":"?bref=2Kgs.17.16-17","r":"2Kgs.17.16-17","rawR":"2Kgs.17.16-17","sourceRefs":[{"raw":"2Kgs.17.16-17","value":"2Kgs.17.16-17"}],"t":"ref","v":"2 Kgs 17:16-17"},"; ",{"href":"?bref=2Kgs.21.6","r":"2Kgs.21.6","rawR":"2Kgs.21.6","sourceRefs":[{"raw":"2Kgs.21.6","value":"2Kgs.21.6"}],"t":"ref","v":"21:6"},"; ",{"href":"?bref=Ezek.23.37","r":"Ezek.23.37","rawR":"Ezek.23.37","sourceRefs":[{"raw":"Ezek.23.37","value":"Ezek.23.37"}],"t":"ref","v":"Ezek 23:37"},"). • ",{"c":["fortune-telling:"],"sourceClass":"sn-excerpt","t":"span"}," Throughout the ancient Near East, diviners were considered experts at reading and interpreting omens. Divination was commonly done through ",{"c":["extispicy,"],"sourceClass":"ital","t":"span"}," the examination of livers, kidneys, and other internal organs of various animals. • ",{"c":["sorcery:"],"sourceClass":"sn-excerpt","t":"span"}," Sorcerers conjured up the spirits of the dead. • Divining cups were often used to ",{"c":["interpret omens"],"sourceClass":"sn-excerpt","t":"span"}," (see ",{"href":"?bref=Gen.44.5","r":"Gen.44.5","rawR":"Gen.44.5","sourceRefs":[{"raw":"Gen.44.5","value":"Gen.44.5"}],"t":"ref","v":"Gen 44:5"},"). Drops of oil would be placed in containers of water, and the spread of the oil communicated some message to the expert. A parallel would be reading tea leaves. • The practice of ",{"c":["witchcraft"],"sourceClass":"sn-excerpt","t":"span"}," included performing unusual acts or signs (",{"href":"?bref=Exod.7.11","r":"Exod.7.11","rawR":"Exod.7.11","sourceRefs":[{"raw":"Exod.7.11","value":"Exod.7.11"}],"t":"ref","v":"Exod 7:11"},") to mislead people (",{"href":"?bref=Mal.3.5","r":"Mal.3.5","rawR":"Mal.3.5","sourceRefs":[{"raw":"Mal.3.5","value":"Mal.3.5"}],"t":"ref","v":"Mal 3:5"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.18.10","refs":[{"book":"DEU","endChapter":18,"endVerse":10,"startChapter":18,"startVerse":10}],"sourceAttributes":{"name":"Deut.18.10","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[18],"sourceItemFragmentSha256":"33e507390f9e14984e31620a1e91cb746a001a3b429f811a3366c8a2465eb873","sourceItemName":"Deut.18.10","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2261,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.18.10","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.18.10","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.18.11","r":"Deut.18.11","rawR":"Deut.18.11","sourceRefs":[{"raw":"Deut.18.11","value":"Deut.18.11"}],"t":"ref","v":"18:11"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["cast spells:"],"sourceClass":"sn-excerpt","t":"span"}," These incantations wereto destroy or injure others by invoking curses on them. The false prophet Balaam was hired for this purpose against Israel (",{"href":"?bref=Num.22.2-6","r":"Num.22.2-6","rawR":"Num.22.2-6","sourceRefs":[{"raw":"Num.22.2-6","value":"Num.22.2-6"}],"t":"ref","v":"Num 22:2-6"},"). • ",{"c":["Mediums"],"sourceClass":"sn-excerpt","t":"span"}," and ",{"c":["psychics"],"sourceClass":"sn-excerpt","t":"span"}," were especially adept at conjuring up and communicating with the spirits of the dead (see ",{"href":"?bref=1Sam.28.3-25","r":"1Sam.28.3-25","rawR":"1Sam.28.3-25","sourceRefs":[{"raw":"1Sam.28.3-25","value":"1Sam.28.3-25"}],"t":"ref","v":"1 Sam 28:3-25"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.18.11","refs":[{"book":"DEU","endChapter":18,"endVerse":11,"startChapter":18,"startVerse":11}],"sourceAttributes":{"name":"Deut.18.11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[18],"sourceItemFragmentSha256":"c6599f0c5e175c60626de080cd9ad091a67c9872a3bc9da5f0e5d337fc536692","sourceItemName":"Deut.18.11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2262,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.18.11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.18.11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.18.15","r":"Deut.18.15","rawR":"Deut.18.15","sourceRefs":[{"raw":"Deut.18.15","value":"Deut.18.15"}],"t":"ref","v":"18:15"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["A prophet like me"],"sourceClass":"sn-excerpt","t":"span"}," would be beyond the ordinary because Moses was without peer among the prophets (see ",{"href":"?bref=Deut.34.10-11","r":"Deut.34.10-11","rawR":"Deut.34.10-11","sourceRefs":[{"raw":"Deut.34.10-11","value":"Deut.34.10-11"}],"t":"ref","v":"34:10-11"},"). This prophet would be ",{"c":["from among your fellow Israelites"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["from among your brothers"],"sourceClass":"ital","t":"span"},"), and Israel was required to listen to him (",{"href":"?bref=Deut.18.19","r":"Deut.18.19","rawR":"Deut.18.19","sourceRefs":[{"raw":"Deut.18.19","value":"Deut.18.19"}],"t":"ref","v":"18:19"},"). The prophets of Old Testament Israel would partially fulfill the function of God’s spokesman to whom Israel ",{"c":["must listen."],"sourceClass":"sn-excerpt","t":"span"}," Later, Judaism looked for this prophet as a major messianic figure (see ",{"href":"?bref=John.1.21","r":"John.1.21","rawR":"John.1.21","sourceRefs":[{"raw":"John.1.21","value":"John.1.21"}],"t":"ref","v":"John 1:21"},"; ",{"href":"?bref=John.6.14","r":"John.6.14","rawR":"John.6.14","sourceRefs":[{"raw":"John.6.14","value":"John.6.14"}],"t":"ref","v":"6:14"},"; ",{"href":"?bref=John.7.40","r":"John.7.40","rawR":"John.7.40","sourceRefs":[{"raw":"John.7.40","value":"John.7.40"}],"t":"ref","v":"7:40"},"); the New Testament identifies Jesus as this prophet (",{"href":"?bref=Acts.3.18-26","r":"Acts.3.18-26","rawR":"Acts.3.18-26","sourceRefs":[{"raw":"Acts.3.18-26","value":"Acts.3.18-26"}],"t":"ref","v":"Acts 3:18-26"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.18.15","refs":[{"book":"DEU","endChapter":18,"endVerse":15,"startChapter":18,"startVerse":15}],"sourceAttributes":{"name":"Deut.18.15","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[18],"sourceItemFragmentSha256":"6dbfb788813902183468a29d01707d8ccfcdf8cd17176db1a626665b18907d8f","sourceItemName":"Deut.18.15","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2263,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.18.15","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.18.15","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.18.18","r":"Deut.18.18","rawR":"Deut.18.18","sourceRefs":[{"raw":"Deut.18.18","value":"Deut.18.18"}],"t":"ref","v":"18:18"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["prophet"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=Deut.18.15","r":"Deut.18.15","rawR":"Deut.18.15","sourceRefs":[{"raw":"Deut.18.15","value":"Deut.18.15"}],"t":"ref","v":"18:15"},") would be the Lord’s spokesman, as Moses was (see ",{"href":"?bref=Deut.4.10-17","r":"Deut.4.10-17","rawR":"Deut.4.10-17","sourceRefs":[{"raw":"Deut.4.10-17","value":"Deut.4.10-17"}],"t":"ref","v":"4:10-17"},"; ",{"href":"?bref=Exod.7.1","r":"Exod.7.1","rawR":"Exod.7.1","sourceRefs":[{"raw":"Exod.7.1","value":"Exod.7.1"}],"t":"ref","v":"Exod 7:1"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.18.18","refs":[{"book":"DEU","endChapter":18,"endVerse":18,"startChapter":18,"startVerse":18}],"sourceAttributes":{"name":"Deut.18.18","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[18],"sourceItemFragmentSha256":"4e6902b47b5cff84df1409d800fcfa20adf96efbdd5b25bfab78e2b90a3497fc","sourceItemName":"Deut.18.18","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2264,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.18.18","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.18.18","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.18.19","r":"Deut.18.19","rawR":"Deut.18.19","sourceRefs":[{"raw":"Deut.18.19","value":"Deut.18.19"}],"t":"ref","v":"18:19"}],"sourceClass":"sn-ref","t":"span"}," Not to listen to the Lord’s spokesman is not to listen to the Lord."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.18.19","refs":[{"book":"DEU","endChapter":18,"endVerse":19,"startChapter":18,"startVerse":19}],"sourceAttributes":{"name":"Deut.18.19","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[18],"sourceItemFragmentSha256":"cc432f50f68f72e312618fb6928d629be8b0dfb83066f1f76d94e4f71c3adfd7","sourceItemName":"Deut.18.19","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2265,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.18.19","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.18.19","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.18.22","r":"Deut.18.22","rawR":"Deut.18.22","sourceRefs":[{"raw":"Deut.18.22","value":"Deut.18.22"}],"t":"ref","v":"18:22"}],"sourceClass":"sn-ref","t":"span"}," Any prophet whose ",{"c":["prediction"],"sourceClass":"sn-excerpt","t":"span"}," fails must be branded as false, even if he claims to speak for God. The mere claim is insufficient if it goes unfulfilled."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.18.22","refs":[{"book":"DEU","endChapter":18,"endVerse":22,"startChapter":18,"startVerse":22}],"sourceAttributes":{"name":"Deut.18.22","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[18],"sourceItemFragmentSha256":"d7371d9a3e9a9d1950eb012499b7f1a515ff605abe19095b92e13da3029a4d84","sourceItemName":"Deut.18.22","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2266,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.18.22","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.18.22","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}