erence","content":[{"c":[{"c":[{"href":"?bref=Deut.22.9","r":"Deut.22.9","rawR":"Deut.22.9","sourceRefs":[{"raw":"Deut.22.9","value":"Deut.22.9"}],"t":"ref","v":"22:9"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["any other crop between the rows:"],"sourceClass":"sn-excerpt","t":"span"}," This would bring about a mingling of things that should be kept separate."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.22.9","refs":[{"book":"DEU","endChapter":22,"endVerse":9,"startChapter":22,"startVerse":9}],"sourceAttributes":{"name":"Deut.22.9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[22],"sourceItemFragmentSha256":"b500bcefe890d97697bb47c2e6da1c3b0fbae8a7f3fb92d447cb64f1cd31355c","sourceItemName":"Deut.22.9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2297,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.22.9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.22.9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.22.10","r":"Deut.22.10","rawR":"Deut.22.10","sourceRefs":[{"raw":"Deut.22.10","value":"Deut.22.10"}],"t":"ref","v":"22:10"}],"sourceClass":"sn-ref","t":"span"}," Plowing ",{"c":["with an ox and a donkey"],"sourceClass":"sn-excerpt","t":"span"}," would be inefficient; this example illustrates the principle of separation and order (see also ",{"href":"?bref=2Cor.6.14-18","r":"2Cor.6.14-18","rawR":"2Cor.6.14-18","sourceRefs":[{"raw":"2Cor.6.14-18","value":"2Cor.6.14-18"}],"t":"ref","v":"2 Cor 6:14-18"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.22.10","refs":[{"book":"DEU","endChapter":22,"endVerse":10,"startChapter":22,"startVerse":10}],"sourceAttributes":{"name":"Deut.22.10","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[22],"sourceItemFragmentSha256":"3399f9904e7706dc352e59a8aaa97756504d431bd508d90ae59076232930d976","sourceItemName":"Deut.22.10","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2298,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.22.10","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.22.10","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.22.11","r":"Deut.22.11","rawR":"Deut.22.11","sourceRefs":[{"raw":"Deut.22.11","value":"Deut.22.11"}],"t":"ref","v":"22:11"}],"sourceClass":"sn-ref","t":"span"}," Keeping ",{"c":["wool and linen"],"sourceClass":"sn-excerpt","t":"span"}," separate illustrated Israel’s separation as God’s holy people (see also ",{"href":"?bref=Lev.19.19","r":"Lev.19.19","rawR":"Lev.19.19","sourceRefs":[{"raw":"Lev.19.19","value":"Lev.19.19"}],"t":"ref","v":"Lev 19:19"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.22.11","refs":[{"book":"DEU","endChapter":22,"endVerse":11,"startChapter":22,"startVerse":11}],"sourceAttributes":{"name":"Deut.22.11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[22],"sourceItemFragmentSha256":"0683202204c2fa8f736984bb92106451325847374d4d8a612cf32ef654fa20d8","sourceItemName":"Deut.22.11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2299,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.22.11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.22.11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.22.12","r":"Deut.22.12","rawR":"Deut.22.12","sourceRefs":[{"raw":"Deut.22.12","value":"Deut.22.12"}],"t":"ref","v":"22:12"}],"sourceClass":"sn-ref","t":"span"}," Placing ",{"c":["four tassels on the hem"],"sourceClass":"sn-excerpt","t":"span"}," of a garment probably reminded the wearer to be loyal to the covenant, similar to tying a string around one’s finger (see ",{"href":"?bref=Num.15.37-41","r":"Num.15.37-41","rawR":"Num.15.37-41","sourceRefs":[{"raw":"Num.15.37-41","value":"Num.15.37-41"}],"t":"ref","v":"Num 15:37-41"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.22.12","refs":[{"book":"DEU","endChapter":22,"endVerse":12,"startChapter":22,"startVerse":12}],"sourceAttributes":{"name":"Deut.22.12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[22],"sourceItemFragmentSha256":"a3389b410baaac05ed10752033e595aa92002754cf611462a92bbf8e0def7bc4","sourceItemName":"Deut.22.12","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2300,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.22.12","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.22.12","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.22.14","r":"Deut.22.14","rawR":"Deut.22.14","sourceRefs":[{"raw":"Deut.22.14","value":"Deut.22.14"}],"t":"ref","v":"22:14"}],"sourceClass":"sn-ref","t":"span"}," A husband who discovered evidence that his wife had lost her virginity prior to marriage (see ",{"href":"?bref=Deut.22.15","r":"Deut.22.15","rawR":"Deut.22.15","sourceRefs":[{"raw":"Deut.22.15","value":"Deut.22.15"}],"t":"ref","v":"22:15"},") would accuse her of ",{"c":["shameful conduct"],"sourceClass":"sn-excerpt","t":"span"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.22.14","refs":[{"book":"DEU","endChapter":22,"endVerse":14,"startChapter":22,"startVerse":14}],"sourceAttributes":{"name":"Deut.22.14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[22],"sourceItemFragmentSha256":"30329f23dbc38c68ed6bdf8841c89edddc1af294fe77b588f43fa9b7bd9fc962","sourceItemName":"Deut.22.14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2301,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.22.14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.22.14","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.22.15","r":"Deut.22.15","rawR":"Deut.22.15","sourceRefs":[{"raw":"Deut.22.15","value":"Deut.22.15"}],"t":"ref","v":"22:15"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["proof of her virginity:"],"sourceClass":"sn-excerpt","t":"span"}," A blood-stained cloth would indicate that the woman’s hymen was ruptured by her first act of intercourse with her husband."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.22.15","refs":[{"book":"DEU","endChapter":22,"endVerse":15,"startChapter":22,"startVerse":15}],"sourceAttributes":{"name":"Deut.22.15","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[22],"sourceItemFragmentSha256":"98446170a8b513c688a841098037634a557829783aaab65cd7eb64ee31750b6a","sourceItemName":"Deut.22.15","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2302,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.22.15","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.22.15","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.22.17","r":"Deut.22.17","rawR":"Deut.22.17","sourceRefs":[{"raw":"Deut.22.17","value":"Deut.22.17"}],"t":"ref","v":"22:17"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["bed sheet"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["covering"],"sourceClass":"ital","t":"span"},") might also have been a garment of some kind, such as a nightgown."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.22.17","refs":[{"book":"DEU","endChapter":22,"endVerse":17,"startChapter":22,"startVerse":17}],"sourceAttributes":{"name":"Deut.22.17","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[22],"sourceItemFragmentSha256":"6ecd85ecb7db6cb6de7dc4711cd7585ef4b6bc0fdc04f3475e4cb2a77b39963c","sourceItemName":"Deut.22.17","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2303,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.22.17","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.22.17","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.22.19","r":"Deut.22.19","rawR":"Deut.22.19","sourceRefs":[{"raw":"Deut.22.19","value":"Deut.22.19"}],"t":"ref","v":"22:19"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["100 pieces of silver:"],"sourceClass":"sn-excerpt","t":"span"}," The husband, who had already paid the woman’s father the normal bride price, must now pay additional compensation for defaming her character."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.22.19","refs":[{"book":"DEU","endChapter":22,"endVerse":19,"startChapter":22,"startVerse":19}],"sourceAttributes":{"name":"Deut.22.19","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[22],"sourceItemFragmentSha256":"6a7dc60c58fdc7a4ed293c2609acfaf09ee4ac4853d1596cbafc101a4fd9ddbe","sourceItemName":"Deut.22.19","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2304,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.22.19","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.22.19","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.22.21","r":"Deut.22.21","rawR":"Deut.22.21","sourceRefs":[{"raw":"Deut.22.21","value":"Deut.22.21"}],"t":"ref","v":"22:21"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["by being promiscuous"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["acting as a prostitute"],"sourceClass":"ital","t":"span"},"): A single act of sexual intercourse by an unmarried woman was enough to earn this ",{"c":["disgraceful"],"sourceClass":"sn-excerpt","t":"span"}," label and the death penalty."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.22.21","refs":[{"book":"DEU","endChapter":22,"endVerse":21,"startChapter":22,"startVerse":21}],"sourceAttributes":{"name":"Deut.22.21","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[22],"sourceItemFragmentSha256":"5fe8c8ddfb22a1e2b956b1b9118a8818c3c006fe76c2eeb11b67d625fcbe8639","sourceItemName":"Deut.22.21","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2305,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.22.21","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.22.21","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.22.24","r":"Deut.22.24","rawR":"Deut.22.24","sourceRefs":[{"raw":"Deut.22.24","value":"Deut.22.24"}],"t":"ref","v":"22:24"}],"sourceClass":"sn-ref","t":"span"}," Because betrothal was tantamount to marriage in the Old Testament, ",{"c":["another man’s wife"],"sourceClass":"sn-excerpt","t":"span"}," in this passage technically refers to a fiancée."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.22.24","refs":[{"book":"DEU","endChapter":22,"endVerse":24,"startChapter":22,"startVerse":24}],"sourceAttributes":{"name":"Deut.22.24","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[22],"sourceItemFragmentSha256":"175f7ab1671b97a15988eb2838cfdd96384cbebe1ee471eda19e2b8490b7296c","sourceItemName":"Deut.22.24","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2306,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.22.24","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.22.24","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.22.29","r":"Deut.22.29","rawR":"Deut.22.29","sourceRefs":[{"raw":"Deut.22.29","value":"Deut.22.29"}],"t":"ref","v":"22:29"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["fifty pieces of silver:"],"sourceClass":"sn-excerpt","t":"span"}," The father could still expect a dowry for his unmarried daughter (see ",{"href":"?bref=Gen.34.12","r":"Gen.34.12","rawR":"Gen.34.12","sourceRefs":[{"raw":"Gen.34.12","value":"Gen.34.12"}],"t":"ref","v":"Gen 34:12"},"; ",{"href":"?bref=Exod.22.16","r":"Exod.22.16","rawR":"Exod.22.16","sourceRefs":[{"raw":"Exod.22.16","value":"Exod.22.16"}],"t":"ref","v":"Exod 22:16"},"). • ",{"c":["he must marry:"],"sourceClass":"sn-excerpt","t":"span"}," The assumption is that the girl and her father were willing to undertake the arrangement (see ",{"href":"?bref=Exod.22.17","r":"Exod.22.17","rawR":"Exod.22.17","sourceRefs":[{"raw":"Exod.22.17","value":"Exod.22.17"}],"t":"ref","v":"Exod 22:17"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.22.29","refs":[{"book":"DEU","endChapter":22,"endVerse":29,"startChapter":22,"startVerse":29}],"sourceAttributes":{"name":"Deut.22.29","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[22],"sourceItemFragmentSha256":"ef9b4299ceabc1c82f78cc6cab2ba6c6f48dbe19605e24cdd1eba621aa4cf0e9","sourceItemName":"Deut.22.29","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2307,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.22.29","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.22.29","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.22.30","r":"Deut.22.30","rawR":"Deut.22.30","sourceRefs":[{"raw":"Deut.22.30","value":"Deut.22.30"}],"t":"ref","v":"22:30"}],"sourceClass":"sn-ref","t":"span"}," The phrase ",{"c":["his father’s former wife"],"sourceClass":"sn-excerpt","t":"span"}," does not refer to a man’s own mother because incest was a more serious crime (see ",{"href":"?bref=Lev.18.7-8","r":"Lev.18.7-8","rawR":"Lev.18.7-8","sourceRefs":[{"raw":"Lev.18.7-8","value":"Lev.18.7-8"}],"t":"ref","v":"Lev 18:7-8"},", ",{"href":"?bref=Lev.18.29","r":"Lev.18.29","rawR":"Lev.18.29","sourceRefs":[{"raw":"Lev.18.29","value":"Lev.18.29"}],"t":"ref","v":"29"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.22.30","refs":[{"book":"DEU","endChapter":22,"endVerse":30,"startChapter":22,"startVerse":30}],"sourceAttributes":{"name":"Deut.22.30","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[22],"sourceItemFragmentSha256":"543b5059d6829547ad6adbbfa5aa2e3da4e34301c15ea5d50e35061fa7b64cb1","sourceItemName":"Deut.22.30","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2308,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.22.30","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.22.30","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}