f5b504747c4b9b642e19f9e6444bd54c911448e272.json","title":"Wealth"},"WordWordofGodWordsofGod":{"file":"dictionary/90b8c6d9b0885a5722588a705ee349c9cf27c6a9cdb5d69193e7c82e34987599.json","title":"Word, Word of God, Words of God"},"ZinWildernessof":{"file":"dictionary/1cb6ed873c139bbe273082a34fbeed4e9a73744db881dffbccea17481aab5903.json","title":"Zin, Wilderness of"}},"dictionaryRelated":[{"id":"AdamPerson","title":"Adam (Person)"},{"id":"Animals","title":"Animals"},{"id":"Arabah","title":"Arabah"},{"id":"ArchaeologyandtheBible","title":"Archaeology and the Bible*"},{"id":"BibleQuotationsoftheOldTestamentintheNewTestament","title":"Bible*, Quotations of the Old Testament in the New Testament"},{"id":"Copper","title":"Copper"},{"id":"DeuteronomyBookof","title":"Deuteronomy, Book of"},{"id":"Discipline","title":"Discipline"},{"id":"Dropsy","title":"Dropsy*"},{"id":"FeastsandFestivalsofIsrael","title":"Feasts and Festivals of Israel"},{"id":"FoodandFoodPreparation","title":"Food and Food Preparation"},{"id":"Harvest","title":"Harvest"},{"id":"LawBiblicalConceptof","title":"Law, Biblical Concept of"},{"id":"MineralsandMetals","title":"Minerals* and Metals"},{"id":"Plants","title":"Plants"},{"id":"Pride","title":"Pride"},{"id":"Riches","title":"Riches"},{"id":"WordWordofGodWordsofGod","title":"Word, Word of God, Words of God"},{"id":"ZinWildernessof","title":"Zin, Wilderness of"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"heart","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":11,"href":"?bref=Deut.8.17","rawReference":"Deut.8.17"}],"ruleId":"Heart::Heart::source_verse_citation","sourceHeadwordId":"Heart"},"text":"You might say in your heart, “The power and strength of my hands have made this wealth for me.”","verse":17}],"id":"Heart","label":"heart","matchReviews":[{"ruleId":"Heart::Heart::source_verse_citation","scope":"source_verse_citation","senseReview":"Reviewed original headword and source sense. This substantive word is admitted only where the original article explicitly cites the exact occurrence verse; ambiguous homographs and known context mismatches are separately excluded. This is selective contextual evidence, not an automatic rule for every same-spelling word.","sourceHeadwordId":"Heart","term":"Heart"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Heart","sourceTitle":"Heart"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"You must carefully follow every commandment I am giving you today, so that you may live and multiply, and enter and possess the land that the LORD swore to give your fathers.","verse":1},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Remember that these forty years the LORD your God led you all the way in the wilderness, so that He might humble you and test you in order to know what was in your heart, whether or not you would keep His commandments.","verse":2},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"He humbled you, and in your hunger He gave you manna to eat, which neither you nor your fathers had known, so that you might understand that man does not live on bread alone, but on every word that comes from the mouth of the LORD.","verse":3},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"So know in your heart that just as a man disciplines his son, so the LORD your God disciplines you.","verse":5},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Therefore you shall keep the commandments of the LORD your God, walking in His ways and fearing Him.","verse":6},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"For the LORD your God is bringing you into a good land, a land of brooks and fountains and springs that flow through the valleys and hills;","verse":7},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"When you eat and are satisfied, you are to bless the LORD your God for the good land that He has given you.","verse":10},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Be careful not to forget the LORD your God by failing to keep His commandments and ordinances and statutes, which I am giving you this day.","verse":11},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"then your heart will become proud, and you will forget the LORD your God who brought you out of the land of Egypt, out of the house of slavery.","verse":14},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"But remember that it is the LORD your God who gives you the power to gain wealth, in order to confirm His covenant that He swore to your fathers even to this day.","verse":18},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"If you ever forget the LORD your God and go after other gods to worship and bow down to them, I testify against you today that you will surely perish.","verse":19},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Like the nations that the LORD has destroyed before you, so you will perish if you do not obey the LORD your God.","verse":20}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"wealth","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":1,"href":"?bref=Deut.8.18","rawReference":"Deut.8.18"}],"ruleId":"Wealth::Wealth::source_verse_citation","sourceHeadwordId":"Wealth"},"text":"But remember that it is the LORD your God who gives you the power to gain wealth, in order to confirm His covenant that He swore to your fathers even to this day.","verse":18}],"id":"Wealth","label":"wealth","matchReviews":[{"ruleId":"Wealth::Wealth::source_verse_citation","scope":"source_verse_citation","senseReview":"Reviewed original headword and source sense. This substantive word is admitted only where the original article explicitly cites the exact occurrence verse; ambiguous homographs and known context mismatches are separately excluded. This is selective contextual evidence, not an automatic rule for every same-spelling word.","sourceHeadwordId":"Wealth","term":"Wealth"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Wealth","sourceTitle":"Wealth"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":["Curses and Blessings"],"sourceClass":"theme-title","t":"h"},{"c":["Nearly all treaty or covenant texts from the ancient Near East contained curses and blessings. The curses were leveled against those who violated the terms of the agreement, while blessings were promised to the faithful. This was particularly true of suzerain-vassal covenants like Deuteronomy (see ",{"href":"?item=Deut_BookIntro_Filament","id":"Deut_BookIntro_Filament","rawId":"Deut_BookIntro_Filament","t":"link","v":"Deuteronomy Book Introduction"},", “Literary Form”)."],"sourceClass":"theme-body-fl","t":"p"},{"c":["Deuteronomy presented to the assembly of Israel what God expected of the nation. The covenant required the nation of Israel to obey the Lord, and the Israelites had pledged to do so (",{"href":"?bref=Exod.19.8","r":"Exod.19.8","rawR":"Exod.19.8","sourceRefs":[{"raw":"Exod.19.8","value":"Exod.19.8"}],"t":"ref","v":"Exod 19:8"},"). The section on curses and blessings (",{"href":"?bref=Deut.27.1-29","r":"Deut.27.1-29","rawR":"Deut.27.1-29","sourceRefs":[{"raw":"Deut.27.1-29","value":"Deut.27.1-29"}],"t":"ref","v":"Deut 27:1–29:1"},") spells out how God would reward their obedience and judge their disobedience. The curses receive more emphasis than the blessings, perhaps because people naturally pay more attention to promises than to warnings. Blessings may also be more easily understood—promised blessings in the future seem to simply provide well-being, whereas judgment is more abstract and needs detailed, graphic description. God emphasizes the curses to drive home the consequences of wrongdoing. The warnings Jesus offered about things to come (",{"href":"?bref=Matt.24.1-25.46","r":"Matt.24.1-25.46","rawR":"Matt.24.1-25.46","sourceRefs":[{"raw":"Matt.24.1-25.46","value":"Matt.24.1-25.46"}],"t":"ref","v":"Matt 24–25"},") were very much in line with these warnings."],"sourceClass":"theme-body","t":"p"},{"c":["Israel’s subsequent history bears witness to God’s promise of both the blessings and the curses. When Israel was faithful to their covenant with God, he blessed the people. When they rebelled, he brought judgment upon them. Israel’s history of rebellion is succinctly summarized in ",{"href":"?bref=2Kgs.17.7-20","r":"2Kgs.17.7-20","rawR":"2Kgs.17.7-20","sourceRefs":[{"raw":"2Kgs.17.7-20","value":"2Kgs.17.7-20"}],"t":"ref","v":"2 Kings 17:7-20"},". When the Israelites broke the first two commandments (",{"href":"?bref=Deut.5.7-10","r":"Deut.5.7-10","rawR":"Deut.5.7-10","sourceRefs":[{"raw":"Deut.5.7-10","value":"Deut.5.7-10"}],"t":"ref","v":"Deut 5:7-10"},"), they proceeded to violate the whole covenant, and their rebellion brought upon them the curses of ",{"href":"?bref=Deut.28.1-68","r":"Deut.28.1-68","rawR":"Deut.28.1-68","sourceRefs":[{"raw":"Deut.28.1-68","value":"Deut.28.1-68"}],"t":"ref","v":"Deuteronomy 28"},"."],"sourceClass":"theme-body","t":"p"},{"c":["Passages for Further Study"],"sourceClass":"theme-refs-title","t":"h"},{"c":[{"href":"?bref=Gen.9.24-27","r":"Gen.9.24-27","rawR":"Gen.9.24-27","sourceRefs":[{"raw":"Gen.9.24-27","value":"Gen.9.24-27"}],"t":"ref","v":"Gen 9:24-27"},"; ",{"href":"?bref=Lev.26.3-45","r":"Lev.26.3-45","rawR":"Lev.26.3-45","sourceRefs":[{"raw":"Lev.26.3-45","value":"Lev.26.3-45"}],"t":"ref","v":"Lev 26:3-45"},"; ",{"href":"?bref=Deut.8.7-20","r":"Deut.8.7-20","rawR":"Deut.8.7-20","sourceRefs":[{"raw":"Deut.8.7-20","value":"Deut.8.7-20"}],"t":"ref","v":"Deut 8:7-20"},"; ",{"href":"?bref=Deut.11.29","r":"Deut.11.29","rawR":"Deut.11.29","sourceRefs":[{"raw":"Deut.11.29","value":"Deut.11.29"}],"t":"ref","v":"11:29"},"; ",{"href":"?bref=Deut.27.1-29","r":"Deut.27.1-29","rawR":"Deut.27.1-29","sourceRefs":[{"raw":"Deut.27.1-29","value":"Deut.27.1-29"}],"t":"ref","v":"Deut 27:1–29:1"},"; ",{"href":"?bref=Josh.8.33-35","r":"Josh.8.33-35","rawR":"Josh.8.33-35","sourceRefs":[{"raw":"Josh.8.33-35","value":"Josh.8.33-35"}],"t":"ref","v":"Josh 8:33-35"},"; ",{"href":"?bref=2Kgs.17.7-20","r":"2Kgs.17.7-20","rawR":"2Kgs.17.7-20","sourceRefs":[{"raw":"2Kgs.17.7-20","value":"2Kgs.17.7-20"}],"t":"ref","v":"2 Kgs 17:7-20"},"; ",{"href":"?bref=2Chr.36.17-21","r":"2Chr.36.17-21","rawR":"2Chr.36.17-21","sourceRefs":[{"raw":"2Chr.36.17-21","value":"2Chr.36.17-21"}],"t":"ref","v":"2 Chr 36:17-21"}],"sourceClass":"theme-refs","t":"p"}],"id":"ThemeNote:CursesAndBlessings","refs":[{"book":"DEU","endChapter":8,"endVerse":20,"startChapter":8,"startVerse":1}],"sourceAttributes":{"name":"CursesAndBlessings","product":"TyndaleOpenStudyNotes","typename":"ThemeNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"3222dbe58b4b81b7dca5a9660e126bed398b07eaeb803045b73021588f5b37de","sourceItemName":"CursesAndBlessings","sourceMember":"Tyndale Open Study Notes/ThemeNotes.xml","sourceOrder":44,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.8.1-20","sourceRelease":"1.25","sourceTitleExact":"Curses and Blessings","supplementPointersNotIncludedAsContent":[],"title":"Curses and Blessings","type":"ThemeNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.8.1-20","r":"Deut.8.1-20","rawR":"Deut.8.1-20","sourceRefs":[{"raw":"Deut.8.1-20","value":"Deut.8.1-20"}],"t":"ref","v":"8:1-20"}],"sourceClass":"sn-ref","t":"span"}," Once Israel inhabited the land, they might have the human tendency to take credit for the blessings that followed. Moses warned the people to guard against a self-congratulatory attitude. God alone is the source of all prosperity and achievement."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.8.1-20","refs":[{"book":"DEU","endChapter":8,"endVerse":20,"startChapter":8,"startVerse":1}],"sourceAttributes":{"name":"Deut.8.1-20","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"2cb2b721e638b8fea29bbf1906a871e8cac987a0bd2989c913c1528337a37e5d","sourceItemName":"Deut.8.1-20","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2151,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.8.1-20","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.8.1-20","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.8.2","r":"Deut.8.2","rawR":"Deut.8.2","sourceRefs":[{"raw":"Deut.8.2","value":"Deut.8.2"}],"t":"ref","v":"8:2"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["to prove your character"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["to know what is in your heart"],"sourceClass":"ital","t":"span"},"): God already knew the Israelites’ innermost thoughts (",{"href":"?bref=Ps.51.6","r":"Ps.51.6","rawR":"Ps.51.6","sourceRefs":[{"raw":"Ps.51.6","value":"Ps.51.6"}],"t":"ref","v":"Pss 51:6"},"; ",{"href":"?bref=Ps.139.1","r":"Ps.139.1","rawR":"Ps.139.1","sourceRefs":[{"raw":"Ps.139.1","value":"Ps.139.1"}],"t":"ref","v":"139:1"},", ",{"href":"?bref=Ps.139.4","r":"Ps.139.4","rawR":"Ps.139.4","sourceRefs":[{"raw":"Ps.139.4","value":"Ps.139.4"}],"t":"ref","v":"4"},", ",{"href":"?bref=Ps.139.23","r":"Ps.139.23","rawR":"Ps.139.23","sourceRefs":[{"raw":"Ps.139.23","value":"Ps.139.23"}],"t":"ref","v":"23"},"); he wanted their character to come out in their actions. • ",{"c":["to find out whether:"],"sourceClass":"sn-excerpt","t":"span"}," The Old Testament often describes God in human terms, even in ways that appear to limit God. ",{"c":["Anthropomorphism"],"sourceClass":"ital","t":"span"}," (assigning human characteristics to God) and ",{"c":["anthropopathism"],"sourceClass":"ital","t":"span"}," (assigning human feelings or emotions to God) are ways of representing God on a human level so the human mind can better grasp his ways, but God is not limited in his knowledge, power, or transcendence. Here, God is figuratively described as having only a human knowledge of the future, but other passages make it clear that God knows everything—past, present, and future (",{"href":"?bref=Ps.139.1-18","r":"Ps.139.1-18","rawR":"Ps.139.1-18","sourceRefs":[{"raw":"Ps.139.1-18","value":"Ps.139.1-18"}],"t":"ref","v":"Ps 139:1-18"},"; ",{"href":"?bref=Heb.4.13","r":"Heb.4.13","rawR":"Heb.4.13","sourceRefs":[{"raw":"Heb.4.13","value":"Heb.4.13"}],"t":"ref","v":"Heb 4:13"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.8.2","refs":[{"book":"DEU","endChapter":8,"endVerse":2,"startChapter":8,"startVerse":2}],"sourceAttributes":{"name":"Deut.8.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"4f1f41368e563fa815f1feaf47d735348481fbec641421a9d4c4b0aa82421b48","sourceItemName":"Deut.8.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2152,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.8.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.8.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.8.3","r":"Deut.8.3","rawR":"Deut.8.3","sourceRefs":[{"raw":"Deut.8.3","value":"Deut.8.3"}],"t":"ref","v":"8:3"}],"sourceClass":"sn-ref","t":"span"}," The word ",{"c":["manna"],"sourceClass":"sn-excerpt","t":"span"}," is derived from the Hebrew words ",{"c":["man hu"],"sourceClass":"hebrew","t":"span"}," (meaning “what is it?”). God miraculously provided this food to teach his people total dependence on him (",{"href":"?bref=Exod.16.1-30","r":"Exod.16.1-30","rawR":"Exod.16.1-30","sourceRefs":[{"raw":"Exod.16.1-30","value":"Exod.16.1-30"}],"t":"ref","v":"Exod 16:1-30"},"; ",{"href":"?bref=Num.11.4-9","r":"Num.11.4-9","rawR":"Num.11.4-9","sourceRefs":[{"raw":"Num.11.4-9","value":"Num.11.4-9"}],"t":"ref","v":"Num 11:4-9"},"). Manna represented the word of God, which is even more essential to life and well-being than food is. • ",{"c":["people do not live by bread alone:"],"sourceClass":"sn-excerpt","t":"span"}," Jesus quoted this phrase to rebut Satan (",{"href":"?bref=Matt.4.4","r":"Matt.4.4","rawR":"Matt.4.4","sourceRefs":[{"raw":"Matt.4.4","value":"Matt.4.4"}],"t":"ref","v":"Matt 4:4"},"; ",{"href":"?bref=Luke.4.4","r":"Luke.4.4","rawR":"Luke.4.4","sourceRefs":[{"raw":"Luke.4.4","value":"Luke.4.4"}],"t":"ref","v":"Luke 4:4"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.8.3","refs":[{"book":"DEU","endChapter":8,"endVerse":3,"startChapter":8,"startVerse":3}],"sourceAttributes":{"name":"Deut.8.3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"b63107e95a88c1d7dca7183c2a4d2b48e617e6c129ae218f996ea0dffed44b29","sourceItemName":"Deut.8.3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2153,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.8.3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.8.3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.8.9","r":"Deut.8.9","rawR":"Deut.8.9","sourceRefs":[{"raw":"Deut.8.9","value":"Deut.8.9"}],"t":"ref","v":"8:9"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Iron"],"sourceClass":"sn-excerpt","t":"span"}," was not widely used in this period of the Bronze Age because the process of smelting and working it was known to only a few cultures (see ",{"href":"?bref=1Sam.13.19-21","r":"1Sam.13.19-21","rawR":"1Sam.13.19-21","sourceRefs":[{"raw":"1Sam.13.19-21","value":"1Sam.13.19-21"}],"t":"ref","v":"1 Sam 13:19-21"},"). The time would come when Israel would exploit this vastly superior metal (see ",{"href":"?bref=Josh.17.16-18","r":"Josh.17.16-18","rawR":"Josh.17.16-18","sourceRefs":[{"raw":"Josh.17.16-18","value":"Josh.17.16-18"}],"t":"ref","v":"Josh 17:16-18"},"; ",{"href":"?bref=1Kgs.6.7","r":"1Kgs.6.7","rawR":"1Kgs.6.7","sourceRefs":[{"raw":"1Kgs.6.7","value":"1Kgs.6.7"}],"t":"ref","v":"1 Kgs 6:7"},"; ",{"href":"?bref=2Kgs.6.5","r":"2Kgs.6.5","rawR":"2Kgs.6.5","sourceRefs":[{"raw":"2Kgs.6.5","value":"2Kgs.6.5"}],"t":"ref","v":"2 Kgs 6:5"},"; ",{"href":"?bref=1Chr.22.3","r":"1Chr.22.3","rawR":"1Chr.22.3","sourceRefs":[{"raw":"1Chr.22.3","value":"1Chr.22.3"}],"t":"ref","v":"1 Chr 22:3"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.8.9","refs":[{"book":"DEU","endChapter":8,"endVerse":9,"startChapter":8,"startVerse":9}],"sourceAttributes":{"name":"Deut.8.9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"673aceded7fb7b6774edc983661120a24acf84d92a0131ddaf552120ddb0570c","sourceItemName":"Deut.8.9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2154,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.8.9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.8.9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.8.15","r":"Deut.8.15","rawR":"Deut.8.15","sourceRefs":[{"raw":"Deut.8.15","value":"Deut.8.15"}],"t":"ref","v":"8:15"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["water from the rock!"],"sourceClass":"sn-excerpt","t":"span"}," See ",{"href":"?bref=Exod.17.6","r":"Exod.17.6","rawR":"Exod.17.6","sourceRefs":[{"raw":"Exod.17.6","value":"Exod.17.6"}],"t":"ref","v":"Exod 17:6"},"; ",{"href":"?bref=Num.20.2-13","r":"Num.20.2-13","rawR":"Num.20.2-13","sourceRefs":[{"raw":"Num.20.2-13","value":"Num.20.2-13"}],"t":"ref","v":"Num 20:2-13"},"; see also ",{"href":"?bref=Deut.1.37","r":"Deut.1.37","rawR":"Deut.1.37","sourceRefs":[{"raw":"Deut.1.37","value":"Deut.1.37"}],"t":"ref","v":"Deut 1:37"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.8.15","refs":[{"book":"DEU","endChapter":8,"endVerse":15,"startChapter":8,"startVerse":15}],"sourceAttributes":{"name":"Deut.8.15","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"2a51fef6f21f371a334d0e6641dcece53968b2a6f18e02ee5beb1f8b35c3629c","sourceItemName":"Deut.8.15","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2155,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.8.15","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.8.15","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.8.18","r":"Deut.8.18","rawR":"Deut.8.18","sourceRefs":[{"raw":"Deut.8.18","value":"Deut.8.18"}],"t":"ref","v":"8:18"}],"sourceClass":"sn-ref","t":"span"}," This was not ",{"c":["the covenant"],"sourceClass":"sn-excerpt","t":"span"}," that God made with the previous generation of Israelites at Sinai but the one he first made with Abraham (",{"href":"?bref=Gen.15.1-21","r":"Gen.15.1-21","rawR":"Gen.15.1-21","sourceRefs":[{"raw":"Gen.15.1-21","value":"Gen.15.1-21"}],"t":"ref","v":"Gen 15:1-21"},"; ",{"href":"?bref=Gen.17.1-21","r":"Gen.17.1-21","rawR":"Gen.17.1-21","sourceRefs":[{"raw":"Gen.17.1-21","value":"Gen.17.1-21"}],"t":"ref","v":"17:1-21"},"), then Isaac (",{"href":"?bref=Gen.26.1-5","r":"Gen.26.1-5","rawR":"Gen.26.1-5","sourceRefs":[{"raw":"Gen.26.1-5","value":"Gen.26.1-5"}],"t":"ref","v":"Gen 26:1-5"},") and Jacob (",{"href":"?bref=Gen.28.1-4","r":"Gen.28.1-4","rawR":"Gen.28.1-4","sourceRefs":[{"raw":"Gen.28.1-4","value":"Gen.28.1-4"}],"t":"ref","v":"Gen 28:1-4"},", ",{"href":"?bref=Gen.28.13-15","r":"Gen.28.13-15","rawR":"Gen.28.13-15","sourceRefs":[{"raw":"Gen.28.13-15","value":"Gen.28.13-15"}],"t":"ref","v":"13-15"},"; ",{"href":"?bref=Gen.46.1-4","r":"Gen.46.1-4","rawR":"Gen.46.1-4","sourceRefs":[{"raw":"Gen.46.1-4","value":"Gen.46.1-4"}],"t":"ref","v":"46:1-4"},"). • In order to be legal and proper, a covenant had to be sworn to with ",{"c":["an oath"],"sourceClass":"sn-excerpt","t":"span"}," that all parties to the agreement uttered. Although by his very nature God could never rescind a promise, he honored the protocol (see ",{"href":"?bref=Deut.7.12","r":"Deut.7.12","rawR":"Deut.7.12","sourceRefs":[{"raw":"Deut.7.12","value":"Deut.7.12"}],"t":"ref","v":"Deut 7:12"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.8.18","refs":[{"book":"DEU","endChapter":8,"endVerse":18,"startChapter":8,"startVerse":18}],"sourceAttributes":{"name":"Deut.8.18","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"0b6d2efeea01d0865f6f0940c037e6a37398f884c0a8756047163faec88d7ca5","sourceItemName":"Deut.8.18","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2156,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.8.18","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.8.18","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}