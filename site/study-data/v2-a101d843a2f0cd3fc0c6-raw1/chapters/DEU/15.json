file":"dictionary/ee833257ac93d1e73262de463f9b042494ad9204c505f3d4c9695045c219a294.json","title":"Handmaid, Handmaiden*"},"HardnessofHeart":{"file":"dictionary/5187e8165694894daa95ee20e6aec9357805b379cf740f26b9a3102d2be70ec7.json","title":"Hardness of Heart*"},"Humility":{"file":"dictionary/903754aaa7c760056614f920899bb73f17429344c789973c840a8c979ea9f837.json","title":"Humility"},"LawBiblicalConceptof":{"file":"dictionary/3abfe86f0add8235f7dc654a7b16bef5482eac2c4ccc84d543d4b4463992fabb.json","title":"Law, Biblical Concept of"},"Lord":{"file":"dictionary/0a54f5caa03523157b50ef58ec814d810e7db1abd5db44ec093ece07106e3447.json","title":"Lord"},"Neighbor":{"file":"dictionary/77eacd14ee02b59d4db4a2c31313b1e1ba843ab4107cc84c3adef8d7d1af59bd.json","title":"Neighbor"},"Poorthe":{"file":"dictionary/c2d143d5b84ffae28b4094d81084d5b3504cfbb6f8ff1eea388d64bb4519a0e5.json","title":"Poor, the"},"Ransom":{"file":"dictionary/ed905eb653630f7b7802564ec87c99b97eb97841a20806e75ca904e5137a07d5.json","title":"Ransom"},"RedeemerRedemption":{"file":"dictionary/68231fe6debb5d1fc7a9a636ef95bfeebfbb4cec74e8afacaf363a4522d4ec29.json","title":"Redeemer, Redemption"},"Sabbath":{"file":"dictionary/dd5ebac938d7ddd91c065f359119dacdbd2544c3b434556ad5abae17b7679793.json","title":"Sabbath"},"Servant":{"file":"dictionary/642805613af5e954085fdc4c25cb0bc282656e891efdba422af3a63190cc9205.json","title":"Servant"},"SlaveSlavery":{"file":"dictionary/991e4ee5b1b2f76312e6a8182edbc2c85d5489b0b929b3673b1abb46a62bdfa3.json","title":"Slave, Slavery"}},"dictionaryRelated":[{"id":"Alms","title":"Alms"},{"id":"ArchaeologyandtheBible","title":"Archaeology and the Bible*"},{"id":"Aul","title":"Aul*"},{"id":"BankerBanking","title":"Banker, Banking"},{"id":"Beggar","title":"Beggar"},{"id":"Consecration","title":"Consecration*"},{"id":"Covenant","title":"Covenant"},{"id":"CriminalLawandPunishment","title":"Criminal Law and Punishment*"},{"id":"Debt","title":"Debt"},{"id":"DeuteronomyBookof","title":"Deuteronomy, Book of"},{"id":"DietaryLaws","title":"Dietary Laws*"},{"id":"FeastsandFestivalsofIsrael","title":"Feasts and Festivals of Israel"},{"id":"Foreigner","title":"Foreigner"},{"id":"Hand","title":"Hand"},{"id":"HandmaidHandmaiden","title":"Handmaid, Handmaiden*"},{"id":"HardnessofHeart","title":"Hardness of Heart*"},{"id":"Humility","title":"Humility"},{"id":"LawBiblicalConceptof","title":"Law, Biblical Concept of"},{"id":"Neighbor","title":"Neighbor"},{"id":"Poorthe","title":"Poor, the"},{"id":"Ransom","title":"Ransom"},{"id":"RedeemerRedemption","title":"Redeemer, Redemption"},{"id":"Sabbath","title":"Sabbath"},{"id":"Servant","title":"Servant"},{"id":"SlaveSlavery","title":"Slave, Slavery"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"This is the manner of remission: Every creditor shall cancel what he has loaned to his neighbor. He is not to collect anything from his neighbor or brother, because the LORD’s time of release has been proclaimed.","verse":2},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"There will be no poor among you, however, because the LORD will surely bless you in the land that the LORD your God is giving you to possess as an inheritance,","verse":4},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"if only you obey the LORD your God and are careful to follow all these commandments I am giving you today.","verse":5},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"When the LORD your God blesses you as He has promised, you will lend to many nations but borrow from none; you will rule over many nations but be ruled by none.","verse":6},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"If there is a poor man among your brothers within any of the gates in the land that the LORD your God is giving you, then you are not to harden your heart or shut your hand from your poor brother.","verse":7},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Be careful not to harbor this wicked thought in your heart: “The seventh year, the year of release, is near,” so that you look upon your poor brother begrudgingly and give him nothing. He will cry out to the LORD against you, and you will be guilty of sin.","verse":9},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Give generously to him, and do not let your heart be grieved when you do so. And because of this the LORD your God will bless you in all your work and in everything to which you put your hand.","verse":10},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"You are to furnish him liberally from your flock, your threshing floor, and your winepress. You shall give to him as the LORD your God has blessed you.","verse":14},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Remember that you were slaves in the land of Egypt, and the LORD your God redeemed you; that is why I am giving you this command today.","verse":15},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Do not regard it as a hardship to set your servant free, because his six years of service were worth twice the wages of a hired hand. And the LORD your God will bless you in all you do.","verse":18},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"You must set apart to the LORD your God every firstborn male produced by your herds and flocks. You are not to put the firstborn of your oxen to work, nor are you to shear the firstborn of your flock.","verse":19},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Each year you and your household are to eat it before the LORD your God in the place the LORD will choose.","verse":20},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"But if an animal has a defect, is lame or blind, or has any serious flaw, you must not sacrifice it to the LORD your God.","verse":21}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.15.1-23","r":"Deut.15.1-23","rawR":"Deut.15.1-23","sourceRefs":[{"raw":"Deut.15.1-23","value":"Deut.15.1-23"}],"t":"ref","v":"15:1-23"}],"sourceClass":"sn-ref","t":"span"}," The Law included the regulation of borrowing and lending so that the poor could survive deprivation. It provided restrictions to allow the rich to minister to the needs of the poor without exploiting them."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.15.1-23","refs":[{"book":"DEU","endChapter":15,"endVerse":23,"startChapter":15,"startVerse":1}],"sourceAttributes":{"name":"Deut.15.1-23","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[15],"sourceItemFragmentSha256":"31409f6466b44f249277b0c037a8eebe2024b8e202e10f9b4b6d88e78d416c27","sourceItemName":"Deut.15.1-23","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2221,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.15.1-23","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.15.1-23","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.15.1","r":"Deut.15.1","rawR":"Deut.15.1","sourceRefs":[{"raw":"Deut.15.1","value":"Deut.15.1"}],"t":"ref","v":"15:1"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["cancel the debts:"],"sourceClass":"sn-excerpt","t":"span"}," This technical term refers to releasing people in financial bondage from their creditors and from any penalty for their default."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.15.1","refs":[{"book":"DEU","endChapter":15,"endVerse":1,"startChapter":15,"startVerse":1}],"sourceAttributes":{"name":"Deut.15.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[15],"sourceItemFragmentSha256":"1451b6a71fd04cc2d7f2385268fdf038ce13caa2f44df3ab0073bf37683229a2","sourceItemName":"Deut.15.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2222,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.15.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.15.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.15.2","r":"Deut.15.2","rawR":"Deut.15.2","sourceRefs":[{"raw":"Deut.15.2","value":"Deut.15.2"}],"t":"ref","v":"15:2"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["time of release"],"sourceClass":"sn-excerpt","t":"span"}," was to occur every seventh year across the nation (the Sabbath year, ",{"href":"?bref=Lev.25.1-7","r":"Lev.25.1-7","rawR":"Lev.25.1-7","sourceRefs":[{"raw":"Lev.25.1-7","value":"Lev.25.1-7"}],"t":"ref","v":"Lev 25:1-7"},"). The time frame followed the calendar rather than the length of the loan arrangement. This meant that the year of release could fall as soon as a year after a loan was made."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.15.2","refs":[{"book":"DEU","endChapter":15,"endVerse":2,"startChapter":15,"startVerse":2}],"sourceAttributes":{"name":"Deut.15.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[15],"sourceItemFragmentSha256":"d8010dcb4fecd8d27537b6a28dcef25d17c9e07395fbbe3e82a9782274cc49eb","sourceItemName":"Deut.15.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2223,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.15.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.15.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.15.4","r":"Deut.15.4","rawR":"Deut.15.4","sourceRefs":[{"raw":"Deut.15.4","value":"Deut.15.4"}],"t":"ref","v":"15:4"}],"sourceClass":"sn-ref","t":"span"}," If Israel lived in perfect obedience to the covenant, there would ",{"c":["be no poor"],"sourceClass":"sn-excerpt","t":"span"}," in the nation. However, this ideal was never realized in ancient Israel, and poverty was very much an issue."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.15.4","refs":[{"book":"DEU","endChapter":15,"endVerse":4,"startChapter":15,"startVerse":4}],"sourceAttributes":{"name":"Deut.15.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[15],"sourceItemFragmentSha256":"cdf6c574eeda9b7e9a1aa6a6441963cb63f344b5bed8f6696bc9d1787f68731e","sourceItemName":"Deut.15.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2224,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.15.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.15.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.15.6","r":"Deut.15.6","rawR":"Deut.15.6","sourceRefs":[{"raw":"Deut.15.6","value":"Deut.15.6"}],"t":"ref","v":"15:6"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["You will lend money to many nations:"],"sourceClass":"sn-excerpt","t":"span"}," An obedient Israel would become an affluent nation able to provide international aid. This bounty would bear testimony to God’s promise to Abraham that his seed would be a blessing to all nations (",{"href":"?bref=Gen.12.2-3","r":"Gen.12.2-3","rawR":"Gen.12.2-3","sourceRefs":[{"raw":"Gen.12.2-3","value":"Gen.12.2-3"}],"t":"ref","v":"Gen 12:2-3"},"; ",{"href":"?bref=Gen.17.4-6","r":"Gen.17.4-6","rawR":"Gen.17.4-6","sourceRefs":[{"raw":"Gen.17.4-6","value":"Gen.17.4-6"}],"t":"ref","v":"17:4-6"},"; ",{"href":"?bref=Gen.26.3-4","r":"Gen.26.3-4","rawR":"Gen.26.3-4","sourceRefs":[{"raw":"Gen.26.3-4","value":"Gen.26.3-4"}],"t":"ref","v":"26:3-4"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.15.6","refs":[{"book":"DEU","endChapter":15,"endVerse":6,"startChapter":15,"startVerse":6}],"sourceAttributes":{"name":"Deut.15.6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[15],"sourceItemFragmentSha256":"8f356d3bfe17d7488a214822177d829e5cc74ed26004a0affdaafe590f3afac7","sourceItemName":"Deut.15.6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2225,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.15.6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.15.6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.15.11","r":"Deut.15.11","rawR":"Deut.15.11","sourceRefs":[{"raw":"Deut.15.11","value":"Deut.15.11"}],"t":"ref","v":"15:11"}],"sourceClass":"sn-ref","t":"span"}," The reality that there ",{"c":["will always be some . . . who are poor"],"sourceClass":"sn-excerpt","t":"span"}," in a fallen world is no excuse for indifference to their plight. Instead, it should emphasize the need for the rich to contribute to the well-being of the poor (",{"href":"?bref=Matt.26.6-13","r":"Matt.26.6-13","rawR":"Matt.26.6-13","sourceRefs":[{"raw":"Matt.26.6-13","value":"Matt.26.6-13"}],"t":"ref","v":"Matt 26:6-13"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.15.11","refs":[{"book":"DEU","endChapter":15,"endVerse":11,"startChapter":15,"startVerse":11}],"sourceAttributes":{"name":"Deut.15.11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[15],"sourceItemFragmentSha256":"ffa74c3876ae1ee480611201e12318da5c1d74808accb76a6aee78d32db26f56","sourceItemName":"Deut.15.11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2226,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.15.11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.15.11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.15.12","r":"Deut.15.12","rawR":"Deut.15.12","sourceRefs":[{"raw":"Deut.15.12","value":"Deut.15.12"}],"t":"ref","v":"15:12"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["If a fellow Hebrew sells himself or herself to be your servant:"],"sourceClass":"sn-excerpt","t":"span"}," This arrangement allowed a debtor to work off financial obligations to a creditor. The limit of this arrangement was seven years (but see ",{"href":"?bref=Deut.15.16-17","r":"Deut.15.16-17","rawR":"Deut.15.16-17","sourceRefs":[{"raw":"Deut.15.16-17","value":"Deut.15.16-17"}],"t":"ref","v":"15:16-17"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.15.12","refs":[{"book":"DEU","endChapter":15,"endVerse":12,"startChapter":15,"startVerse":12}],"sourceAttributes":{"name":"Deut.15.12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[15],"sourceItemFragmentSha256":"4a80a1800f1987a4450fcaf5789c06146a38862ecb01b9d0bed4cf257d9c7eec","sourceItemName":"Deut.15.12","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2227,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.15.12","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.15.12","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.15.16","r":"Deut.15.16","rawR":"Deut.15.16","sourceRefs":[{"raw":"Deut.15.16","value":"Deut.15.16"}],"t":"ref","v":"15:16"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["he loves you:"],"sourceClass":"sn-excerpt","t":"span"}," In the context of a covenant, this phrase speaks of a binding relationship with both legal and emotional overtones."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.15.16","refs":[{"book":"DEU","endChapter":15,"endVerse":16,"startChapter":15,"startVerse":16}],"sourceAttributes":{"name":"Deut.15.16","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[15],"sourceItemFragmentSha256":"c0fd66b78bd602581b2d0e045b1289dfc37d12d8cb55d19e921155affb79cf52","sourceItemName":"Deut.15.16","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2228,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.15.16","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.15.16","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.15.17","r":"Deut.15.17","rawR":"Deut.15.17","sourceRefs":[{"raw":"Deut.15.17","value":"Deut.15.17"}],"t":"ref","v":"15:17"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["push it through his earlobe:"],"sourceClass":"sn-excerpt","t":"span"}," This disfigurement publicly indicated that a bondservant had voluntarily indentured himself to his master for life. This might be what Paul meant when he said “I bear on my body the scars that show I belong to Jesus” (",{"href":"?bref=Gal.6.17","r":"Gal.6.17","rawR":"Gal.6.17","sourceRefs":[{"raw":"Gal.6.17","value":"Gal.6.17"}],"t":"ref","v":"Gal 6:17"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.15.17","refs":[{"book":"DEU","endChapter":15,"endVerse":17,"startChapter":15,"startVerse":17}],"sourceAttributes":{"name":"Deut.15.17","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[15],"sourceItemFragmentSha256":"dd5f23c305c791fcb513b876d31791ef7a28ce60246ca22695c312d9fd1e7d5a","sourceItemName":"Deut.15.17","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2229,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.15.17","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.15.17","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.15.18","r":"Deut.15.18","rawR":"Deut.15.18","sourceRefs":[{"raw":"Deut.15.18","value":"Deut.15.18"}],"t":"ref","v":"15:18"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["worth double the wages:"],"sourceClass":"sn-excerpt","t":"span"}," Because a bondservant worked all day, every day, his output was more than that of a day laborer, who merely put in his shift."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.15.18","refs":[{"book":"DEU","endChapter":15,"endVerse":18,"startChapter":15,"startVerse":18}],"sourceAttributes":{"name":"Deut.15.18","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[15],"sourceItemFragmentSha256":"7feddfc47dac1085a41be9213fd559e768b9eff544a15cdfb0d5fe18efb7ed0d","sourceItemName":"Deut.15.18","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2230,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.15.18","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.15.18","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.15.19","r":"Deut.15.19","rawR":"Deut.15.19","sourceRefs":[{"raw":"Deut.15.19","value":"Deut.15.19"}],"t":"ref","v":"15:19"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["firstborn males"],"sourceClass":"sn-excerpt","t":"span"}," of livestock represented the firstborn sons of Israel who had been spared from death in the tenth plague (",{"href":"?bref=Exod.12.12","r":"Exod.12.12","rawR":"Exod.12.12","sourceRefs":[{"raw":"Exod.12.12","value":"Exod.12.12"}],"t":"ref","v":"Exod 12:12"},", ",{"href":"?bref=Exod.12.29","r":"Exod.12.29","rawR":"Exod.12.29","sourceRefs":[{"raw":"Exod.12.29","value":"Exod.12.29"}],"t":"ref","v":"29"},"; ",{"href":"?bref=Exod.13.2","r":"Exod.13.2","rawR":"Exod.13.2","sourceRefs":[{"raw":"Exod.13.2","value":"Exod.13.2"}],"t":"ref","v":"13:2"},", ",{"href":"?bref=Exod.13.12","r":"Exod.13.12","rawR":"Exod.13.12","sourceRefs":[{"raw":"Exod.13.12","value":"Exod.13.12"}],"t":"ref","v":"12"},"; ",{"href":"?bref=Exod.22.29","r":"Exod.22.29","rawR":"Exod.22.29","sourceRefs":[{"raw":"Exod.22.29","value":"Exod.22.29"}],"t":"ref","v":"22:29"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.15.19","refs":[{"book":"DEU","endChapter":15,"endVerse":19,"startChapter":15,"startVerse":19}],"sourceAttributes":{"name":"Deut.15.19","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[15],"sourceItemFragmentSha256":"559b510a33c22e96b56002a0f003443ffbb46f098b4409f2be138cd8884b07e0","sourceItemName":"Deut.15.19","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2231,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.15.19","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.15.19","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.15.21","r":"Deut.15.21","rawR":"Deut.15.21","sourceRefs":[{"raw":"Deut.15.21","value":"Deut.15.21"}],"t":"ref","v":"15:21"}],"sourceClass":"sn-ref","t":"span"}," A ",{"c":["defect"],"sourceClass":"sn-excerpt","t":"span"}," was any imperfection that devalued an animal; it was no sacrifice to give up something that was of little or no worth to begin with (",{"href":"?bref=2Sam.24.24","r":"2Sam.24.24","rawR":"2Sam.24.24","sourceRefs":[{"raw":"2Sam.24.24","value":"2Sam.24.24"}],"t":"ref","v":"2 Sam 24:24"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.15.21","refs":[{"book":"DEU","endChapter":15,"endVerse":21,"startChapter":15,"startVerse":21}],"sourceAttributes":{"name":"Deut.15.21","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[15],"sourceItemFragmentSha256":"17517ae97e164b585fd90988ce2770af338f9dbc4c3f418d3787419ff5b3da2e","sourceItemName":"Deut.15.21","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2232,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.15.21","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.15.21","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.15.23","r":"Deut.15.23","rawR":"Deut.15.23","sourceRefs":[{"raw":"Deut.15.23","value":"Deut.15.23"}],"t":"ref","v":"15:23"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["blood"],"sourceClass":"sn-excerpt","t":"span"}," of an animal was seen as synonymous with its life, the most sacred of God’s creations, so it was sacrilegious to ",{"c":["consume"],"sourceClass":"sn-excerpt","t":"span"}," it (see ",{"href":"?bref=Deut.12.16","r":"Deut.12.16","rawR":"Deut.12.16","sourceRefs":[{"raw":"Deut.12.16","value":"Deut.12.16"}],"t":"ref","v":"12:16"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.15.23","refs":[{"book":"DEU","endChapter":15,"endVerse":23,"startChapter":15,"startVerse":23}],"sourceAttributes":{"name":"Deut.15.23","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[15],"sourceItemFragmentSha256":"ece76c9f8b4606665d03c634f1f372ce342d240