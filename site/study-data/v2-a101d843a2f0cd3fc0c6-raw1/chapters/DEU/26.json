k":"REV","chapter":1,"verses":[5,6]}]}],"verse":19},{"anchor":"holy people","refs":["Deut 7:6","Deut 28:9","Exod 19:6","1 Pet 2:9"],"sourceRowNumber":8446,"targets":[{"label":"Deut 7:6","passages":[{"book":"DEU","chapter":7,"verses":[6]}]},{"label":"Deut 28:9","passages":[{"book":"DEU","chapter":28,"verses":[9]}]},{"label":"Exod 19:6","passages":[{"book":"EXO","chapter":19,"verses":[6]}]},{"label":"1 Pet 2:9","passages":[{"book":"1PE","chapter":2,"verses":[9]}]}],"verse":19}],"dictionaryArticles":{"ArchaeologyandtheBible":{"file":"dictionary/204e20689ff35c6852bf5a15d81484bff93d8028ba30819ff60333855dd08ef5.json","title":"Archaeology and the Bible*"},"Covenant":{"file":"dictionary/6fabc3710d91aa715b7e22eb42d7769321a5fde810a123cc8e1a77127eade148.json","title":"Covenant"},"DeuteronomyBookof":{"file":"dictionary/98e8abaa0f8fc30647393a1d8e49676753f1ab5a0e5e1bbac37de619f91e28af.json","title":"Deuteronomy, Book of"},"Exodusthe":{"file":"dictionary/059e7dc2f49bd5a4c03f04de75b996e6e4fdcaf45827fd3eee464adb55b4910e.json","title":"Exodus, the"},"FeastsandFestivalsofIsrael":{"file":"dictionary/61ac88ed742f8c4da98fe0e3a58bdcd78b644dc69537048a43832a6c83f93a74.json","title":"Feasts and Festivals of Israel"},"Firstfruits":{"file":"dictionary/04be08ba5390625cba84de78af6e22a39586017e88bafbf223bed32c24073850.json","title":"Firstfruits"},"LawBiblicalConceptof":{"file":"dictionary/3abfe86f0add8235f7dc654a7b16bef5482eac2c4ccc84d543d4b4463992fabb.json","title":"Law, Biblical Concept of"},"Lord":{"file":"dictionary/0a54f5caa03523157b50ef58ec814d810e7db1abd5db44ec093ece07106e3447.json","title":"Lord"},"Nations":{"file":"dictionary/1fdffe71ca6cfb98583a1ffc84f41f913b0e20be3dd3d474133f661d7173a98f.json","title":"Nations"},"Orphan":{"file":"dictionary/577cb9aa1c7446c420768ec6107b1e9bd9c464ffb51d1fb1219b39f6d3f2ad47.json","title":"Orphan"},"PeopleofGod":{"file":"dictionary/5b5a9189140e1507941f06ad4f9a925e70aec565aa64c00ed56df5052b0aa304.json","title":"People of God"},"Power":{"file":"dictionary/3f161924099fe2f845c8fcf541bba92a038ee5a46d124c21af068a675506c238.json","title":"Power"},"Prayer":{"file":"dictionary/fae981bffb99abab976ccf52d1a775ce94b4b4da3dfcb674c63c57004f2ccc2d.json","title":"Prayer"},"SyriaSyrians":{"file":"dictionary/305228727bd78a3357d2593c171da6a66ed9d678b52f5e16aede846caef4b1fd.json","title":"Syria, Syrians"},"TitheTithing":{"file":"dictionary/e68d6e34acdbf34efb1d739bc904157bcf717cb6d96391860c224fcb9d0cf1a9.json","title":"Tithe, Tithing"},"Widow":{"file":"dictionary/358fa55d7ed93b83258a82adbe8004543adf089e0698cce4e53cfda0f84ceccd.json","title":"Widow"},"Worship":{"file":"dictionary/b49748b47f4477107e66fb89b6e99498a20192bedd7180ba8bd63c90c434f666.json","title":"Worship"}},"dictionaryRelated":[{"id":"ArchaeologyandtheBible","title":"Archaeology and the Bible*"},{"id":"Covenant","title":"Covenant"},{"id":"DeuteronomyBookof","title":"Deuteronomy, Book of"},{"id":"Exodusthe","title":"Exodus, the"},{"id":"FeastsandFestivalsofIsrael","title":"Feasts and Festivals of Israel"},{"id":"Firstfruits","title":"Firstfruits"},{"id":"LawBiblicalConceptof","title":"Law, Biblical Concept of"},{"id":"Nations","title":"Nations"},{"id":"Orphan","title":"Orphan"},{"id":"PeopleofGod","title":"People of God"},{"id":"Power","title":"Power"},{"id":"Prayer","title":"Prayer"},{"id":"SyriaSyrians","title":"Syria, Syrians"},{"id":"TitheTithing","title":"Tithe, Tithing"},{"id":"Widow","title":"Widow"},{"id":"Worship","title":"Worship"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"When you enter the land that the LORD your God is giving you as an inheritance, and you take possession of it and settle in it,","verse":1},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"you are to take some of the firstfruits of all your produce from the soil of the land that the LORD your God is giving you and put them in a basket. Then go to the place the LORD your God will choose as a dwelling for His Name,","verse":2},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"to the priest who is serving at that time, and say to him, “I declare today to the LORD your God that I have entered the land that the LORD swore to our fathers to give us.”","verse":3},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Then the priest shall take the basket from your hands and place it before the altar of the LORD your God,","verse":4},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"and you are to declare before the LORD your God, “My father was a wandering Aramean, and he went down to Egypt few in number and lived there and became a great nation, mighty and numerous.","verse":5},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"So we called out to the LORD, the God of our fathers; and the LORD heard our voice and saw our affliction, toil, and oppression.","verse":7},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Then the LORD brought us out of Egypt with a mighty hand and an outstretched arm, with great terror, signs, and wonders.","verse":8},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"And now, behold, I have brought the firstfruits of the land that You, O LORD, have given me.” Then you are to place the basket before the LORD your God and bow down before Him.","verse":10},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"So you shall rejoice—you, the Levite, and the foreigner dwelling among you—in all the good things the LORD your God has given to you and your household.","verse":11},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Then you shall declare in the presence of the LORD your God, “I have removed from my house the sacred portion and have given it to the Levite, the foreigner, the fatherless, and the widow, according to all the commandments You have given me. I have not transgressed or forgotten Your commandments.","verse":13},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"I have not eaten any of the sacred portion while in mourning, or removed any of it while unclean, or offered any of it for the dead. I have obeyed the LORD my God; I have done everything You commanded me.","verse":14},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"The LORD your God commands you this day to follow these statutes and ordinances. You must be careful to follow them with all your heart and with all your soul.","verse":16},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Today you have proclaimed that the LORD is your God and that you will walk in His ways, keep His statutes and commandments and ordinances, and listen to His voice.","verse":17},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"And today the LORD has proclaimed that you are His people and treasured possession as He promised, that you are to keep all His commandments,","verse":18},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"that He will set you high in praise and name and honor above all the nations He has made, and that you will be a holy people to the LORD your God, as He has promised.","verse":19}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.26.1-15","r":"Deut.26.1-15","rawR":"Deut.26.1-15","sourceRefs":[{"raw":"Deut.26.1-15","value":"Deut.26.1-15"}],"t":"ref","v":"26:1-15"}],"sourceClass":"sn-ref","t":"span"}," Under the terms of the covenant, the Great King required that his subjects render him tribute annually or even more frequently. Since Israel was an agrarian society, God required offerings of animal, vegetable, or grain products. This tribute specifically celebrated the mighty Exodus redemption."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.26.1-15","refs":[{"book":"DEU","endChapter":26,"endVerse":15,"startChapter":26,"startVerse":1}],"sourceAttributes":{"name":"Deut.26.1-15","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[26],"sourceItemFragmentSha256":"8514128fae67312cc23f14d4eac69b292d8e34a70ed7d8f893889746c90c213f","sourceItemName":"Deut.26.1-15","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2338,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.26.1-15","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.26.1-15","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.26.5","r":"Deut.26.5","rawR":"Deut.26.5","sourceRefs":[{"raw":"Deut.26.5","value":"Deut.26.5"}],"t":"ref","v":"26:5"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Jacob"],"sourceClass":"sn-excerpt","t":"span"},{"c":["’"],"sourceClass":"ital","t":"span"},"s mother (Rebekah) was an ",{"c":["Aramean"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=Gen.24.10","r":"Gen.24.10","rawR":"Gen.24.10","sourceRefs":[{"raw":"Gen.24.10","value":"Gen.24.10"}],"t":"ref","v":"Gen 24:10"},"; ",{"href":"?bref=Gen.25.20","r":"Gen.25.20","rawR":"Gen.25.20","sourceRefs":[{"raw":"Gen.25.20","value":"Gen.25.20"}],"t":"ref","v":"25:20"},", ",{"href":"?bref=Gen.25.26","r":"Gen.25.26","rawR":"Gen.25.26","sourceRefs":[{"raw":"Gen.25.26","value":"Gen.25.26"}],"t":"ref","v":"26"},"), and Jacob also lived in Aram for many years (",{"href":"?bref=Gen.31.41-42","r":"Gen.31.41-42","rawR":"Gen.31.41-42","sourceRefs":[{"raw":"Gen.31.41-42","value":"Gen.31.41-42"}],"t":"ref","v":"Gen 31:41-42"},"). His lifestyle was seminomadic (",{"c":["wandering"],"sourceClass":"sn-excerpt","t":"span"},"). • ",{"c":["few in number:"],"sourceClass":"sn-excerpt","t":"span"}," Jacob and his family totaled only seventy when they went to Egypt (see ",{"href":"?bref=Gen.46.27","r":"Gen.46.27","rawR":"Gen.46.27","sourceRefs":[{"raw":"Gen.46.27","value":"Gen.46.27"}],"t":"ref","v":"Gen 46:27"},"; ",{"href":"?bref=Exod.1.5","r":"Exod.1.5","rawR":"Exod.1.5","sourceRefs":[{"raw":"Exod.1.5","value":"Exod.1.5"}],"t":"ref","v":"Exod 1:5"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.26.5","refs":[{"book":"DEU","endChapter":26,"endVerse":5,"startChapter":26,"startVerse":5}],"sourceAttributes":{"name":"Deut.26.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[26],"sourceItemFragmentSha256":"daad3cbe5a997dd31d06ee8f2479408e064f096cf5aaa5e9d53e5838d5894cc6","sourceItemName":"Deut.26.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2339,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.26.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.26.5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.26.11","r":"Deut.26.11","rawR":"Deut.26.11","sourceRefs":[{"raw":"Deut.26.11","value":"Deut.26.11"}],"t":"ref","v":"26:11"}],"sourceClass":"sn-ref","t":"span"}," In Israelite society, ",{"c":["foreigners"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["sojourners"],"sourceClass":"ital","t":"span"},") were resident aliens; see also ",{"href":"?item=Deut.10.18_StudyNote_Filament","id":"Deut.10.18_StudyNote_Filament","rawId":"Deut.10.18_StudyNote_Filament","t":"link","v":"study note on 10:18"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.26.11","refs":[{"book":"DEU","endChapter":26,"endVerse":11,"startChapter":26,"startVerse":11}],"sourceAttributes":{"name":"Deut.26.11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[26],"sourceItemFragmentSha256":"7d1bae1a90dd210728d19eb0a290942a1280f2e213d7689de83a614fa14b3ebd","sourceItemName":"Deut.26.11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2340,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.26.11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.26.11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.26.12","r":"Deut.26.12","rawR":"Deut.26.12","sourceRefs":[{"raw":"Deut.26.12","value":"Deut.26.12"}],"t":"ref","v":"26:12"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Every third year"],"sourceClass":"sn-excerpt","t":"span"}," the tithe was gathered for the Levites and other dependents; see also ",{"href":"?item=Deut.14.28_StudyNote_Filament","id":"Deut.14.28_StudyNote_Filament","rawId":"Deut.14.28_StudyNote_Filament","t":"link","v":"study note on 14:28"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.26.12","refs":[{"book":"DEU","endChapter":26,"endVerse":12,"startChapter":26,"startVerse":12}],"sourceAttributes":{"name":"Deut.26.12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[26],"sourceItemFragmentSha256":"847793b78841243f0ada00a5e71b1d87b4ad70ffca5d9cc1a4390e9423c6ba09","sourceItemName":"Deut.26.12","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2341,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.26.12","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.26.12","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.26.13","r":"Deut.26.13","rawR":"Deut.26.13","sourceRefs":[{"raw":"Deut.26.13","value":"Deut.26.13"}],"t":"ref","v":"26:13"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["I have taken"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["burned"],"sourceClass":"ital","t":"span"},") ",{"c":["the sacred gift:"],"sourceClass":"sn-excerpt","t":"span"}," This phrase means that the donor had given his own property to the Levites and to others in need."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.26.13","refs":[{"book":"DEU","endChapter":26,"endVerse":13,"startChapter":26,"startVerse":13}],"sourceAttributes":{"name":"Deut.26.13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[26],"sourceItemFragmentSha256":"27f9e29356c76749dc1944b4b6a38ad2c91243fcb67d0b2c5125d27ddfa445f4","sourceItemName":"Deut.26.13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2342,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.26.13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.26.13","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.26.14","r":"Deut.26.14","rawR":"Deut.26.14","sourceRefs":[{"raw":"Deut.26.14","value":"Deut.26.14"}],"t":"ref","v":"26:14"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["offered any of it to the dead:"],"sourceClass":"sn-excerpt","t":"span"}," These pagan rituals were intended to sustain the dead through food offerings. Such food would be unacceptable as a part of the tithe given to the Levites."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.26.14","refs":[{"book":"DEU","endChapter":26,"endVerse":14,"startChapter":26,"startVerse":14}],"sourceAttributes":{"name":"Deut.26.14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[26],"sourceItemFragmentSha256":"fbce3ea8f1512cdc9ad07822df6921639c5ca31b48352f6d1a4f8979e902a7ab","sourceItemName":"Deut.26.14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2343,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.26.14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.26.14","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.26.16-19","r":"Deut.26.16-19","rawR":"Deut.26.16-19","sourceRefs":[{"raw":"Deut.26.16-19","value":"Deut.26.16-19"}],"t":"ref","v":"26:16-19"}],"sourceClass":"sn-ref","t":"span"}," Having laid out the great covenant principles (chs ",{"href":"?bref=Deut.5.1-11.32","r":"Deut.5.1-11.32","rawR":"Deut.5.1-11.32","sourceRefs":[{"raw":"Deut.5.1-11.32","value":"Deut.5.1-11.32"}],"t":"ref","v":"5–11"},") and clarified their application (chs ",{"href":"?bref=Deut.12.1-26.19","r":"Deut.12.1-26.19","rawR":"Deut.12.1-26.19","sourceRefs":[{"raw":"Deut.12.1-26.19","value":"Deut.12.1-26.19"}],"t":"ref","v":"12–26"},"), Moses urged the people to obey the covenant with all their hearts. The Lord had called them into a special relationship with himself, a privilege that required obedience to the covenant prescriptions. The result of this submission was holiness, a state that reflected God’s character and that would flow naturally from unbroken fellowship with him."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.26.16-19","refs":[{"book":"DEU","endChapter":26,"endVerse":19,"startChapter":26,"startVerse":16}],"sourceAttributes":{"name":"Deut.26.16-19","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[26],"sourceItemFragmentSha256":"a85f74941601fee6440727b6ecaab5a4c0c275d220026a795ab921298086c7d1","sourceItemName":"Deut.26.16-19","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2344,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.26.16-19","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.26.16-19","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Deut.26.16","r":"Deut.26.16","rawR":"Deut.26.16","sourceRefs":[{"raw":"Deut.26.16","value":"Deut.26.16"}],"t":"ref","v":"26:16"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["wholeheartedly"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["with all your heart and with all your soul"],"sourceClass":"ital","t":"span"},"): This Hebrew phrase is a clear reference to the ",{"c":["Shema,"],"sourceClass":"ital","t":"span"}," the foundational statement of Israel’s faith and covenant commitment (see ",{"href":"?bref=Deut.6.4-5","r":"Deut.6.4-5","rawR":"Deut.6.4-5","sourceRefs":[{"raw":"Deut.6.4-5","value":"Deut.6.4-5"}],"t":"ref","v":"6:4-5"}," and ",{"href":"?item=Deut.6.4-5_StudyNote_Filament","id":"Deut.6.4-5_StudyNote_Filament","rawId":"Deut.6.4-5_StudyNote_Filament","t":"link","v":"study notes"},"). There could be no halfhearted compliance with God’s high and holy expectations; it must be all or nothing."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Deut.26.16","refs":[{"book":"DEU","endChapter":26,"endVerse":16,"startChapter":26,"startVerse":16}],"sourceAttributes":{"name":"Deut.26.16","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"DEU","sourceChapterCoverage":[26],"sourceItemFragmentSha256":"94daf483a5ea7932b71d4f8d9abc0c7b62b4d410e6877cbc7e8d8475390d6863","sourceItemName":"Deut.26.16","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":2345,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"DEU","canonicalOSIS":"Deut","method":"official_book_intro_ref_title","sourceOSIS":"Deut"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Deut.26.16","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Deut.26.16","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}