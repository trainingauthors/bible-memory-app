:"Isa.44.20"}],"t":"ref","v":"Isa 44:20"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.115.8","refs":[{"book":"PSA","endChapter":115,"endVerse":8,"startChapter":115,"startVerse":8}],"sourceAttributes":{"name":"Ps.115.8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[115],"sourceItemFragmentSha256":"ada08ed36af00196aec07968e4f747e6b61b3793494c07d0ef1a29a7ec977bbd","sourceItemName":"Ps.115.8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7207,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.115.8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.115.8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.115.9-11","r":"Ps.115.9-11","rawR":"Ps.115.9-11","sourceRefs":[{"raw":"Ps.115.9-11","value":"Ps.115.9-11"}],"t":"ref","v":"115:9-11"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Israel . . . priests . . . you who fear the"],"sourceClass":"sn-excerpt","t":"span"}," ",{"c":["Lord"],"sourceClass":"sn-excerpt-divine-name","t":"span"},{"c":[":"],"sourceClass":"sn-excerpt","t":"span"}," The psalmist calls on all those in the God-fearing community to commit their ways to the living God. The threefold address assures them that the Lord is their true ",{"c":["helper"],"sourceClass":"sn-excerpt","t":"span"}," and ",{"c":["shield"],"sourceClass":"sn-excerpt","t":"span"}," (cp. ",{"href":"?bref=Ps.118.2-4","r":"Ps.118.2-4","rawR":"Ps.118.2-4","sourceRefs":[{"raw":"Ps.118.2-4","value":"Ps.118.2-4"}],"t":"ref","v":"118:2-4"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.115.9-11","refs":[{"book":"PSA","endChapter":115,"endVerse":11,"startChapter":115,"startVerse":9}],"sourceAttributes":{"name":"Ps.115.9-11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[115],"sourceItemFragmentSha256":"21acfcccdf75a96b0d60fba551d909fccfe2e42d7f0f85b79eefce07ceb80c39","sourceItemName":"Ps.115.9-11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7208,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.115.9-11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.115.9-11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.115.12-13","r":"Ps.115.12-13","rawR":"Ps.115.12-13","sourceRefs":[{"raw":"Ps.115.12-13","value":"Ps.115.12-13"}],"t":"ref","v":"115:12-13"}],"sourceClass":"sn-ref","t":"span"}," The groups named in ",{"href":"?bref=Ps.115.9-11","r":"Ps.115.9-11","rawR":"Ps.115.9-11","sourceRefs":[{"raw":"Ps.115.9-11","value":"Ps.115.9-11"}],"t":"ref","v":"115:9-11"}," receive assurance of the Lord’s blessing, regardless of their social status (see ",{"href":"?bref=Ps.113.8","r":"Ps.113.8","rawR":"Ps.113.8","sourceRefs":[{"raw":"Ps.113.8","value":"Ps.113.8"}],"t":"ref","v":"113:8"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.115.12-13","refs":[{"book":"PSA","endChapter":115,"endVerse":13,"startChapter":115,"startVerse":12}],"sourceAttributes":{"name":"Ps.115.12-13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[115],"sourceItemFragmentSha256":"b7ee3fb844b952c9dee0ee4deeb4a759397039401a84a548adc8731f47ae2cd6","sourceItemName":"Ps.115.12-13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7209,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.115.12-13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.115.12-13","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.115.14-15","r":"Ps.115.14-15","rawR":"Ps.115.14-15","sourceRefs":[{"raw":"Ps.115.14-15","value":"Ps.115.14-15"}],"t":"ref","v":"115:14-15"}],"sourceClass":"sn-ref","t":"span"}," The psalmist blesses (",{"href":"?bref=Ps.107.37-38","r":"Ps.107.37-38","rawR":"Ps.107.37-38","sourceRefs":[{"raw":"Ps.107.37-38","value":"Ps.107.37-38"}],"t":"ref","v":"107:37-38"},", ",{"href":"?bref=Ps.107.41","r":"Ps.107.41","rawR":"Ps.107.41","sourceRefs":[{"raw":"Ps.107.41","value":"Ps.107.41"}],"t":"ref","v":"41"},") all who trust in and fear the Lord. The Creator will care for the families of those who fear him. • ",{"c":["who made heaven and earth:"],"sourceClass":"sn-excerpt","t":"span"}," This statement speaks of the Lord’s all-encompassing power in creation."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.115.14-15","refs":[{"book":"PSA","endChapter":115,"endVerse":15,"startChapter":115,"startVerse":14}],"sourceAttributes":{"name":"Ps.115.14-15","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[115],"sourceItemFragmentSha256":"bef73b85c8abe47a071eb2dbbdfb56b653064a3b0b3bbbbc16015dc8b531aaf8","sourceItemName":"Ps.115.14-15","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7210,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.115.14-15","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.115.14-15","type":"StudyNote"},{"chapterAssociationStatu