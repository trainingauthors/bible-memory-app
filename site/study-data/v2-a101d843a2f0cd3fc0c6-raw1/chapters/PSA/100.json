,"; ",{"href":"?bref=Ps.19.1-14","r":"Ps.19.1-14","rawR":"Ps.19.1-14","sourceRefs":[{"raw":"Ps.19.1-14","value":"Ps.19.1-14"}],"t":"ref","v":"19"},"; ",{"href":"?bref=Ps.28.1-9","r":"Ps.28.1-9","rawR":"Ps.28.1-9","sourceRefs":[{"raw":"Ps.28.1-9","value":"Ps.28.1-9"}],"t":"ref","v":"28"},"; ",{"href":"?bref=Ps.33.1-22","r":"Ps.33.1-22","rawR":"Ps.33.1-22","sourceRefs":[{"raw":"Ps.33.1-22","value":"Ps.33.1-22"}],"t":"ref","v":"33"},"; ",{"href":"?bref=Ps.89.1-52","r":"Ps.89.1-52","rawR":"Ps.89.1-52","sourceRefs":[{"raw":"Ps.89.1-52","value":"Ps.89.1-52"}],"t":"ref","v":"89"},"; ",{"href":"?bref=Ps.104.1-35","r":"Ps.104.1-35","rawR":"Ps.104.1-35","sourceRefs":[{"raw":"Ps.104.1-35","value":"Ps.104.1-35"}],"t":"ref","v":"and 104"},"). ",{"href":"?bref=Ps.8.1-9","r":"Ps.8.1-9","rawR":"Ps.8.1-9","sourceRefs":[{"raw":"Ps.8.1-9","value":"Ps.8.1-9"}],"t":"ref","v":"Psalm 8"}," centers on God’s endowing human beings with splendor and vesting them as his rulers in creation. ",{"href":"?bref=Ps.19.1-14","r":"Ps.19.1-14","rawR":"Ps.19.1-14","sourceRefs":[{"raw":"Ps.19.1-14","value":"Ps.19.1-14"}],"t":"ref","v":"Psalm 19"}," encourages reflection on creation in order to cultivate wisdom. ",{"href":"?bref=Ps.29.1-11","r":"Ps.29.1-11","rawR":"Ps.29.1-11","sourceRefs":[{"raw":"Ps.29.1-11","value":"Ps.29.1-11"}],"t":"ref","v":"Psalm 29"}," reveals God’s power in the world and the stability of his creation. ",{"href":"?bref=Ps.33.1-22","r":"Ps.33.1-22","rawR":"Ps.33.1-22","sourceRefs":[{"raw":"Ps.33.1-22","value":"Ps.33.1-22"}],"t":"ref","v":"Psalm 33"}," exalts God’s governance, order, and wisdom in creation and underscores the importance of fearing the Lord. In ",{"href":"?bref=Ps.89.1-52","r":"Ps.89.1-52","rawR":"Ps.89.1-52","sourceRefs":[{"raw":"Ps.89.1-52","value":"Ps.89.1-52"}],"t":"ref","v":"Psalm 89"},", God’s covenant with David is founded on God’s commitment to creation (",{"href":"?bref=Ps.89.9-18","r":"Ps.89.9-18","rawR":"Ps.89.9-18","sourceRefs":[{"raw":"Ps.89.9-18","value":"Ps.89.9-18"}],"t":"ref","v":"89:9-18"},")."],"sourceClass":"theme-body","t":"p"},{"c":[{"href":"?bref=Ps.93.1-100.5","r":"Ps.93.1-100.5","rawR":"Ps.93.1-100.5","sourceRefs":[{"raw":"Ps.93.1-100.5","value":"Ps.93.1-100.5"}],"t":"ref","v":"Psalms 93–100"}," reflect on God’s worldwide dominion. The earth belongs to him, and the Creator has demonstrated his power in history. ",{"href":"?bref=Ps.104.1-35","r":"Ps.104.1-35","rawR":"Ps.104.1-35","sourceRefs":[{"raw":"Ps.104.1-35","value":"Ps.104.1-35"}],"t":"ref","v":"Psalm 104"}," is a creation hymn that reworks the six days of creation into a marvelous lyric in praise of God’s wisdom."],"sourceClass":"theme-body","t":"p"},{"c":["Scripture calls upon all nations to acknowledge and praise God and to show their acceptance of his sovereign rule (see ",{"href":"?bref=Ps.9.11","r":"Ps.9.11","rawR":"Ps.9.11","sourceRefs":[{"raw":"Ps.9.11","value":"Ps.9.11"}],"t":"ref","v":"9:11"},"; ",{"href":"?bref=Ps.47.1-2","r":"Ps.47.1-2","rawR":"Ps.47.1-2","sourceRefs":[{"raw":"Ps.47.1-2","value":"Ps.47.1-2"}],"t":"ref","v":"47:1-2"},", ",{"href":"?bref=Ps.47.7-9","r":"Ps.47.7-9","rawR":"Ps.47.7-9","sourceRefs":[{"raw":"Ps.47.7-9","value":"Ps.47.7-9"}],"t":"ref","v":"7-9"},"; ",{"href":"?bref=Ps.66.8","r":"Ps.66.8","rawR":"Ps.66.8","sourceRefs":[{"raw":"Ps.66.8","value":"Ps.66.8"}],"t":"ref","v":"66:8"},"; ",{"href":"?bref=Ps.117.1","r":"Ps.117.1","rawR":"Ps.117.1","sourceRefs":[{"raw":"Ps.117.1","value":"Ps.117.1"}],"t":"ref","v":"117:1"},")."],"sourceClass":"theme-body","t":"p"},{"c":["Passages for Further Study"],"sourceClass":"theme-refs-title","t":"h"},{"c":[{"href":"?bref=Gen.1.1-2.4","r":"Gen.1.1-2.4","rawR":"Gen.1.1-2.4","sourceRefs":[{"raw":"Gen.1.1-2.4","value":"Gen.1.1-2.4"}],"t":"ref","v":"Gen 1:1–2:4"},"; ",{"href":"?bref=Ps.8.1-9","r":"Ps.8.1-9","rawR":"Ps.8.1-9","sourceRefs":[{"raw":"Ps.8.1-9","value":"Ps.8.1-9"}],"t":"ref","v":"Pss 8"},"; ",{"href":"?bref=Ps.19.1-14","r":"Ps.19.1-14","rawR":"Ps.19.1-14","sourceRefs":[{"raw":"Ps.19.1-14","value":"Ps.19.1-14"}],"t":"ref","v":"19"},"; ",{"href":"?bref=Ps.28.1-9","r":"Ps.28.1-9","rawR":"Ps.28.1-9","sourceRefs":[{"raw":"Ps.28.1-9","value":"Ps.28.1-9"}],"t":"ref","v":"28"},"; ",{"href":"?bref=Ps.29.1-11","r":"Ps.29.1-11","rawR":"Ps.29.1-11","sourceRefs":[{"raw":"Ps.29.1-11","value":"Ps.29.1-11"}],"t":"ref","v":"29"},"; ",{"href":"?bref=Ps.33.1-22","r":"Ps.33.1-22","rawR":"Ps.33.1-22","sourceRefs":[{"raw":"Ps.33.1-22","value":"Ps.33.1-22"}],"t":"ref","v":"33"},"; ",{"href":"?bref=Ps.89.1-52","r":"Ps.89.1-52","rawR":"Ps.89.1-52","sourceRefs":[{"raw":"Ps.89.1-52","value":"Ps.89.1-52"}],"t":"ref","v":"89"},"; ",{"href":"?bref=Ps.93.1-100.5","r":"Ps.93.1-100.5","rawR":"Ps.93.1-100.5","sourceRefs":[{"raw":"Ps.93.1-100.5","value":"Ps.93.1-100.5"}],"t":"ref","v":"93–100"},"; ",{"href":"?bref=Ps.104.1-35","r":"Ps.104.1-35","rawR":"Ps.104.1-35","sourceRefs":[{"raw":"Ps.104.1-35","value":"Ps.104.1-35"}],"t":"ref","v":"104"},"; ",{"href":"?bref=Eccl.12.1-7","r":"Eccl.12.1-7","rawR":"Eccl.12.1-7","sourceRefs":[{"raw":"Eccl.12.1-7","value":"Eccl.12.1-7"}],"t":"ref","v":"Eccl 12:1-7"},", ",{"href":"?bref=Eccl.12.13-14","r":"Eccl.12.13-14","rawR":"Eccl.12.13-14","sourceRefs":[{"raw":"Eccl.12.13-14","value":"Eccl.12.13-14"}],"t":"ref","v":"13-14"},"; ",{"href":"?bref=Isa.40.25-28","r":"Isa.40.25-28","rawR":"Isa.40.25-28","sourceRefs":[{"raw":"Isa.40.25-28","value":"Isa.40.25-28"}],"t":"ref","v":"Isa 40:25-28"},"; ",{"href":"?bref=Isa.43.15","r":"Isa.43.15","rawR":"Isa.43.15","sourceRefs":[{"raw":"Isa.43.15","value":"Isa.43.15"}],"t":"ref","v":"43:15"},"; ",{"href":"?bref=Isa.44.24","r":"Isa.44.24","rawR":"Isa.44.24","sourceRefs":[{"raw":"Isa.44.24","value":"Isa.44.24"}],"t":"ref","v":"44:24"},"; ",{"href":"?bref=Isa.51.13","r":"Isa.51.13","rawR":"Isa.51.13","sourceRefs":[{"raw":"Isa.51.13","value":"Isa.51.13"}],"t":"ref","v":"51:13"},"; ",{"href":"?bref=Jer.10.16","r":"Jer.10.16","rawR":"Jer.10.16","sourceRefs":[{"raw":"Jer.10.16","value":"Jer.10.16"}],"t":"ref","v":"Jer 10:16"},"; ",{"href":"?bref=Acts.4.23-31","r":"Acts.4.23-31","rawR":"Acts.4.23-31","sourceRefs":[{"raw":"Acts.4.23-31","value":"Acts.4.23-31"}],"t":"ref","v":"Acts 4:23-31"},"; ",{"href":"?bref=Col.3.10","r":"Col.3.10","rawR":"Col.3.10","sourceRefs":[{"raw":"Col.3.10","value":"Col.3.10"}],"t":"ref","v":"Col 3:10"}],"sourceClass":"theme-refs","t":"p"}],"id":"ThemeNote:TheCreator-King","refs":[{"book":"PSA","endChapter":100,"endVerse":5,"startChapter":93,"startVerse":1}],"sourceAttributes":{"name":"TheCreator-King","product":"TyndaleOpenStudyNotes","typename":"ThemeNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[93,94,95,96,97,98,99,100],"sourceItemFragmentSha256":"ed9471bf5168f6dc300f05dcd288fda50f5422ef10eb1ae4048279a1ba3a77bd","sourceItemName":"TheCreator-King","sourceMember":"Tyndale Open Study Notes/ThemeNotes.xml","sourceOrder":120,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.93.1-100.5","sourceRelease":"1.25","sourceTitleExact":"The Creator-King","supplementPointersNotIncludedAsContent":[],"title":"The Creator-King","type":"ThemeNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.93.1-100.5","r":"Ps.93.1-100.5","rawR":"Ps.93.1-100.5","sourceRefs":[{"raw":"Ps.93.1-100.5","value":"Ps.93.1-100.5"}],"t":"ref","v":"Pss 93–100"}],"sourceClass":"sn-ref","t":"span"}," These psalms challenge the doubts created by the Exile (see ",{"href":"?bref=Ps.89.1-52","r":"Ps.89.1-52","rawR":"Ps.89.1-52","sourceRefs":[{"raw":"Ps.89.1-52","value":"Ps.89.1-52"}],"t":"ref","v":"Ps 89"},") and answer the questions asked in ",{"href":"?bref=Ps.90.11","r":"Ps.90.11","rawR":"Ps.90.11","sourceRefs":[{"raw":"Ps.90.11","value":"Ps.90.11"}],"t":"ref","v":"90:11"},", ",{"href":"?bref=Ps.90.13","r":"Ps.90.13","rawR":"Ps.90.13","sourceRefs":[{"raw":"Ps.90.13","value":"Ps.90.13"}],"t":"ref","v":"13"},". The Lord has established a kingdom (",{"href":"?bref=Ps.93.1-5","r":"Ps.93.1-5","rawR":"Ps.93.1-5","sourceRefs":[{"raw":"Ps.93.1-5","value":"Ps.93.1-5"}],"t":"ref","v":"Ps 93"},") that is characterized by the punishment of the wicked (",{"href":"?bref=Ps.94.1-23","r":"Ps.94.1-23","rawR":"Ps.94.1-23","sourceRefs":[{"raw":"Ps.94.1-23","value":"Ps.94.1-23"}],"t":"ref","v":"Ps 94"},"), reverent obedience among his people (",{"href":"?bref=Ps.95.1-11","r":"Ps.95.1-11","rawR":"Ps.95.1-11","sourceRefs":[{"raw":"Ps.95.1-11","value":"Ps.95.1-11"}],"t":"ref","v":"Ps 95"},"), justice for the poor (",{"href":"?bref=Ps.96.1-13","r":"Ps.96.1-13","rawR":"Ps.96.1-13","sourceRefs":[{"raw":"Ps.96.1-13","value":"Ps.96.1-13"}],"t":"ref","v":"Ps 96"},"), celebration in Zion (",{"href":"?bref=Ps.97.1-12","r":"Ps.97.1-12","rawR":"Ps.97.1-12","sourceRefs":[{"raw":"Ps.97.1-12","value":"Ps.97.1-12"}],"t":"ref","v":"Ps 97"},"), salvation for Israel (",{"href":"?bref=Ps.98.1-9","r":"Ps.98.1-9","rawR":"Ps.98.1-9","sourceRefs":[{"raw":"Ps.98.1-9","value":"Ps.98.1-9"}],"t":"ref","v":"Ps 98"},"), holiness (",{"href":"?bref=Ps.99.1-9","r":"Ps.99.1-9","rawR":"Ps.99.1-9","sourceRefs":[{"raw":"Ps.99.1-9","value":"Ps.99.1-9"}],"t":"ref","v":"Ps 99"},"), and praise (",{"href":"?bref=Ps.100.1-5","r":"Ps.100.1-5","rawR":"Ps.100.1-5","sourceRefs":[{"raw":"Ps.100.1-5","value":"Ps.100.1-5"}],"t":"ref","v":"Ps 100"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.93.1-100.5","refs":[{"book":"PSA","endChapter":100,"endVerse":5,"startChapter":93,"startVerse":1}],"sourceAttributes":{"name":"Ps.93.1-100.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[93,94,95,96,97,98,99,100],"sourceItemFragmentSha256":"18ce7eafdcd2ed5de8a90ce1092dd66910bcd71ee5f794f2454756cf1614b47e","sourceItemName":"Ps.93.1-100.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6956,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.93.1-100.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.93.1-100.5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.100.1-5","r":"Ps.100.1-5","rawR":"Ps.100.1-5","sourceRefs":[{"raw":"Ps.100.1-5","value":"Ps.100.1-5"}],"t":"ref","v":"Ps 100"}],"sourceClass":"sn-ref","t":"span"}," This psalm calls all nations to come to Jerusalem to worship the Lord and acknowledge his goodness to Israel."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.100.1-5","refs":[{"book":"PSA","endChapter":100,"endVerse":5,"startChapter":100,"startVerse":1}],"sourceAttributes":{"name":"Ps.100.1-5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[100],"sourceItemFragmentSha256":"a3efedcbbe4657cb0883a1f358a23227710bfc1a2dcc0a9d98b07939c8db10c6","sourceItemName":"Ps.100.1-5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7017,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.100.1-5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.100.1-5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.100.3","r":"Ps.100.3","rawR":"Ps.100.3","sourceRefs":[{"raw":"Ps.100.3","value":"Ps.100.3"}],"t":"ref","v":"100:3"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["The"],"sourceClass":"sn-excerpt","t":"span"}," ",{"c":["Lord"],"sourceClass":"sn-excerpt-divine-name","t":"span"}," is the one who determines who ",{"c":["his people"],"sourceClass":"sn-excerpt","t":"span"}," are. • ",{"c":["the sheep of his pasture:"],"sourceClass":"sn-excerpt","t":"span"}," God will guide and protect his people (",{"href":"?bref=Ps.23.1","r":"Ps.23.1","rawR":"Ps.23.1","sourceRefs":[{"raw":"Ps.23.1","value":"Ps.23.1"}],"t":"ref","v":"23:1"},", ",{"href":"?bref=Ps.23.4","r":"Ps.23.4","rawR":"Ps.23.4","sourceRefs":[{"raw":"Ps.23.4","value":"Ps.23.4"}],"t":"ref","v":"4"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.100.3","refs":[{"book":"PSA","endChapter":100,"endVerse":3,"startChapter":100,"startVerse":3}],"sourceAttributes":{"name":"Ps.100.3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[100],"sourceItemFragmentSha256":"be6f18d471230fb80fbe1de55dfad1596c0eb19fb187f43019a466076a156c05","sourceItemName":"Ps.100.3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7018,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.100.3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.100.3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.100.4","r":"Ps.100.4","rawR":"Ps.100.4","sourceRefs":[{"raw":"Ps.100.4","value":"Ps.100.4"}],"t":"ref","v":"100:4"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Gates"],"sourceClass":"sn-excerpt","t":"span"}," and ",{"c":["courts"],"sourceClass":"sn-excerpt","t":"span"}," were part of the Temple in Jerusalem."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.100.4","refs":[{"book":"PSA","endChapter":100,"endVerse":4,"startChapter":100,"startVerse":4}],"sourceAttributes":{"name":"Ps.100.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCovera