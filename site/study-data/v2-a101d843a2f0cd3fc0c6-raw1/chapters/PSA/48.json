zation and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Zion","term":"Zion"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Zion","sourceTitle":"Zion"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.48.1-14","r":"Ps.48.1-14","rawR":"Ps.48.1-14","sourceRefs":[{"raw":"Ps.48.1-14","value":"Ps.48.1-14"}],"t":"ref","v":"Ps 48"}],"sourceClass":"sn-ref","t":"span"}," This song of Zion (see also ",{"href":"?bref=Ps.46.1-11","r":"Ps.46.1-11","rawR":"Ps.46.1-11","sourceRefs":[{"raw":"Ps.46.1-11","value":"Ps.46.1-11"}],"t":"ref","v":"Pss 46"},", ",{"href":"?bref=Ps.76.1-12","r":"Ps.76.1-12","rawR":"Ps.76.1-12","sourceRefs":[{"raw":"Ps.76.1-12","value":"Ps.76.1-12"}],"t":"ref","v":"76"},", ",{"href":"?bref=Ps.87.1-7","r":"Ps.87.1-7","rawR":"Ps.87.1-7","sourceRefs":[{"raw":"Ps.87.1-7","value":"Ps.87.1-7"}],"t":"ref","v":"87"},", ",{"href":"?bref=Ps.122.1-9","r":"Ps.122.1-9","rawR":"Ps.122.1-9","sourceRefs":[{"raw":"Ps.122.1-9","value":"Ps.122.1-9"}],"t":"ref","v":"122"},") explicitly views Jerusalem (Zion) as the city of the Great King where the godly find protection (",{"href":"?bref=Ps.48.1-3","r":"Ps.48.1-3","rawR":"Ps.48.1-3","sourceRefs":[{"raw":"Ps.48.1-3","value":"Ps.48.1-3"}],"t":"ref","v":"48:1-3"},"). God rules from Zion in faithfulness, righteousness, and justice, and he inspires his subjects with confidence and joy (",{"href":"?bref=Ps.48.9-11","r":"Ps.48.9-11","rawR":"Ps.48.9-11","sourceRefs":[{"raw":"Ps.48.9-11","value":"Ps.48.9-11"}],"t":"ref","v":"48:9-11"},"). They commit themselves to seeing the glory of Zion for themselves so that they can tell the next generation about it (",{"href":"?bref=Ps.48.8","r":"Ps.48.8","rawR":"Ps.48.8","sourceRefs":[{"raw":"Ps.48.8","value":"Ps.48.8"}],"t":"ref","v":"48:8"},", ",{"href":"?bref=Ps.48.12-14","r":"Ps.48.12-14","rawR":"Ps.48.12-14","sourceRefs":[{"raw":"Ps.48.12-14","value":"Ps.48.12-14"}],"t":"ref","v":"12-14"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.48.1-14","refs":[{"book":"PSA","endChapter":48,"endVerse":14,"startChapter":48,"startVerse":1}],"sourceAttributes":{"name":"Ps.48.1-14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[48],"sourceItemFragmentSha256":"726d11ff558d2ab7e0c0ac25130d99e495b577e574118edfea514d2a6b81e8dd","sourceItemName":"Ps.48.1-14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6481,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.48.1-14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.48.1-14","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.48.3","r":"Ps.48.3","rawR":"Ps.48.3","sourceRefs":[{"raw":"Ps.48.3","value":"Ps.48.3"}],"t":"ref","v":"48:3"}],"sourceClass":"sn-ref","t":"span"}," God dwells in Zion to protect it from all enemies (see ",{"href":"?bref=Ps.46.5","r":"Ps.46.5","rawR":"Ps.46.5","sourceRefs":[{"raw":"Ps.46.5","value":"Ps.46.5"}],"t":"ref","v":"46:5"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.48.3","refs":[{"book":"PSA","endChapter":48,"endVerse":3,"startChapter":48,"startVerse":3}],"sourceAttributes":{"name":"Ps.48.3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[48],"sourceItemFragmentSha256":"68f781efd081914cd677339b762411b64d841b49fb914b1f0fe9e66740e93b34","sourceItemName":"Ps.48.3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6482,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalO