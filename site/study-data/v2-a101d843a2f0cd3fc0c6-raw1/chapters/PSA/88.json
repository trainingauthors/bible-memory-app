efore You.","verse":13},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Why, O LORD, do You reject me? Why do You hide Your face from me?","verse":14}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.88.1-18","r":"Ps.88.1-18","rawR":"Ps.88.1-18","sourceRefs":[{"raw":"Ps.88.1-18","value":"Ps.88.1-18"}],"t":"ref","v":"Ps 88"}],"sourceClass":"sn-ref","t":"span"}," In this lament, the psalmist sees himself as cast out from God’s presence. At first, he calls on the Lord. When he finds no relief from his suffering, he presents three charges against God (",{"href":"?bref=Ps.88.6-7","r":"Ps.88.6-7","rawR":"Ps.88.6-7","sourceRefs":[{"raw":"Ps.88.6-7","value":"Ps.88.6-7"}],"t":"ref","v":"88:6-7"},", ",{"href":"?bref=Ps.88.8-12","r":"Ps.88.8-12","rawR":"Ps.88.8-12","sourceRefs":[{"raw":"Ps.88.8-12","value":"Ps.88.8-12"}],"t":"ref","v":"8-12"},", ",{"href":"?bref=Ps.88.13-17","r":"Ps.88.13-17","rawR":"Ps.88.13-17","sourceRefs":[{"raw":"Ps.88.13-17","value":"Ps.88.13-17"}],"t":"ref","v":"13-17"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.88.1-18","refs":[{"book":"PSA","endChapter":88,"endVerse":18,"startChapter":88,"startVerse":1}],"sourceAttributes":{"name":"Ps.88.1-18","product":"TyndaleO