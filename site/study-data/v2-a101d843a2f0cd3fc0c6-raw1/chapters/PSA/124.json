 throughout history."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.120.1-134.3","refs":[{"book":"PSA","endChapter":134,"endVerse":3,"startChapter":120,"startVerse":1}],"sourceAttributes":{"name":"Ps.120.1-134.3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[120,121,122,123,124,125,126,127,128,129,130,131,132,133,134],"sourceItemFragmentSha256":"804bdc0d4264fc96adf7bf16357af3c33f1b33647dde7b70863e764ccb4e0941","sourceItemName":"Ps.120.1-134.3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7297,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.120.1-134.3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.120.1-134.3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.124.1-8","r":"Ps.124.1-8","rawR":"Ps.124.1-8","sourceRefs":[{"raw":"Ps.124.1-8","value":"Ps.124.1-8"}],"t":"ref","v":"Ps 124"}],"sourceClass":"sn-ref","t":"span"}," This thanksgiving song describes what might happen if the Lord were not present with his people."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.124.1-8","refs":[{"book":"PSA","endChapter":124,"endVerse":8,"startChapter":124,"startVerse":1}],"sourceAttributes":{"name":"Ps.124.1-8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[124],"sourceItemFragmentSha256":"0efec161f287d47271933bbe21b6b844074a307d6c060b37ec9ac3839ec3e4c3","sourceItemName":"Ps.124.1-8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7317,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceRefe