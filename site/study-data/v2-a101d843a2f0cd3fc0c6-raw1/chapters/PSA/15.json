f=Ps.14.1-7","r":"Ps.14.1-7","rawR":"Ps.14.1-7","sourceRefs":[{"raw":"Ps.14.1-7","value":"Ps.14.1-7"}],"t":"ref","v":"Ps 14"},"). The questions in this psalm invite readers to examine themselves and to look away from problems with the wicked. The question of who dwells in God’s presence leads into a description of godly character qualities (cp. ",{"href":"?bref=Ps.24.3-6","r":"Ps.24.3-6","rawR":"Ps.24.3-6","sourceRefs":[{"raw":"Ps.24.3-6","value":"Ps.24.3-6"}],"t":"ref","v":"24:3-6"},"; ",{"href":"?bref=Isa.33.14-16","r":"Isa.33.14-16","rawR":"Isa.33.14-16","sourceRefs":[{"raw":"Isa.33.14-16","value":"Isa.33.14-16"}],"t":"ref","v":"Isa 33:14-16"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.15.1-5","refs":[{"book":"PSA","endChapter":15,"endVerse":5,"startChapter":15,"startVerse":1}],"sourceAttributes":{"name":"Ps.15.1-5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[15],"sourceItemFragmentSha256":"b8a17309726a5231b6a4b291a3d656528bf9985a668c8fd54226e7424c29786b","sourceItemName":"Ps.15.1-5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6099,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.15.1-5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.15.1-5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.15.1","r":"Ps.15.1","rawR":"Ps.15.1","sourceRefs":[{"raw":"Ps.15.1","value":"Ps.15.1"}],"t":"ref","v":"15:1"}],"sourceClass":"sn-ref","t":"span"}," Only the godly may reside in the Lord’s ",{"c":["presence"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=Ps.5.4","r":"Ps.5.4","rawR":"Ps.5.4","sourceRefs":[{"raw":"Ps.5.4","value":"Ps.5.4"}],"t":"ref","v":"5:4"},"). As his guests, they experience his hospitality and protection. • ",{"c":["sanctuary"],"sourceClass":"sn-excerpt","t":"span"}," (or ",{"c":["tent"],"sourceClass":"ital","t":"span"},"): In David’s time, God’s sanctuary was a tent (the Tabernacle; see ",{"href":"?bref=1Sam.21.6","r":"1Sam.21.6","rawR":"1Sam.21.6","sourceRefs":[{"raw":"1Sam.21.6","value":"1Sam.21.6"}],"t":"ref","v":"1 Sam 21:6"},"; ",{"href":"?bref=2Sam.6.17","r":"2Sam.6.17","rawR":"2Sam.6.17","sourceRefs":[{"raw":"2Sam.6.17","value":"2Sam.6.17"}],"t":"ref","v":"2 Sam 6:17"},"; ",{"href":"?bref=2Sam.7.6","r":"2Sam.7.6","rawR":"2Sam.7.6","sourceRefs":[{"raw":"2Sam.7.6","value":"2Sam.7.6"}],"t":"ref","v":"7:6"},"; ",{"href":"?bref=2Sam.12.20","r":"2Sam.12.20","rawR":"2Sam.12.20","sourceRefs":[{"raw":"2Sam.12.20","value":"2Sam.12.20"}],"t":"ref","v":"12:20"},"; ",{"href":"?bref=1Chr.6.32","r":"1Chr.6.32","rawR":"1Chr.6.32","sourceRefs":[{"raw":"1Chr.6.32","value":"1Chr.6.32"}],"t":"ref","v":"1 Chr 6:32"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.15.1","refs":[{"book":"PSA","endChapter":15,"endVerse":1,"startChapter":15,"startVerse":1}],"sourceAttributes":{"name":"Ps.15.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[15],"sourceItemFragmentSha256":"61dae06465fa673518c9c075a194adb40b4a1539515d8bdeafa8d8f17b631089","sourceItemName":"Ps.15.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6100,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.15.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.15.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.15.2","r":"Ps.15.2","rawR":"Ps.15.2","sourceRefs":[{"raw":"Ps.15.2","value":"Ps.15.2"}],"t":"ref","v":"15:2"}],"sourceClass":"sn-ref","t":"span"}," The godly speak truthfully and act faithfully in their relationships. Unlike the wicked, they are open and transparent (",{"href":"?bref=Ps.12.2-4","r":"Ps.12.2-4","rawR":"Ps.12.2-4","sourceRefs":[{"raw":"Ps.12.2-4","value":"Ps.12.2-4"}],"t":"ref","v":"12:2-4"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.15.2","refs":[{"book":"PSA","endChapter":15,"endVerse":2,"startChapter":15,"startVerse":2}],"sourceAttributes":{"name":"Ps.15.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[15],"sourceItemFragmentSha256":"ae58c7ade07696af6266ce661b9adaea29f2faa2cbcf59574565803888e4f15b","sourceItemName":"Ps.15.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6101,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.15.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.15.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.15.5","r":"Ps.15.5","rawR":"Ps.15.5","sourceRefs":[{"raw":"Ps.15.5","value":"Ps.15.5"}],"t":"ref","v":"15:5"}],"sourceClass":"sn-ref","t":"span"}," The Lord prohibited Israel from ",{"c":["charging interest"],"sourceClass":"sn-excerpt","t":"span"}," to people in need (",{"href":"?bref=Exod.22.25-27","r":"Exod.22.25-27","rawR":"Exod.22.25-27","sourceRefs":[{"raw":"Exod.22.25-27","value":"Exod.22.25-27"}],"t":"ref","v":"Exod 22:25-27"},"). • The assurance of God’s presence keeps the godly from destruction (",{"href":"?bref=Ps.16.8","r":"Ps.16.8","rawR":"Ps.16.8","sourceRefs":[{"raw":"Ps.16.8","value":"Ps.16.8"}],"t":"ref","v":"Pss 16:8"},"; ",{"href":"?bref=Ps.46.5","r":"Ps.46.5","rawR":"Ps.46.5","sourceRefs":[{"raw":"Ps.46.5","value":"Ps.46.5"}],"t":"ref","v":"46:5"},"; ",{"href":"?bref=Ps.125.1","r":"Ps.125.1","rawR":"Ps.125.1","sourceRefs":[{"raw":"Ps.125.1","value":"Ps.125.1"}],"t":"ref","v":"125:1"},"). Their circumstances might shake them temporarily, but they ultimately ",{"c":["stand firm"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=Ps.30.6","r":"Ps.30.6","rawR":"Ps.30.6","sourceRefs":[{"raw":"Ps.30.6","value":"Ps.30.6"}],"t":"ref","v":"30:6"},"; ",{"href":"?bref=Ps.94.18","r":"Ps.94.18","rawR":"Ps.94.18","sourceRefs":[{"raw":"Ps.94.18","value":"Ps.94.18"}],"t":"ref","v":"94:18"},"; ",{"href":"?bref=Ps.112.6","r":"Ps.112.6","rawR":"Ps.112.6","sourceRefs":[{"raw":"Ps.112.6","value":"Ps.112.6"}],"t":"ref","v":"112:6"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.15.5","refs":[{"book":"PSA","endChapter":15,"endVerse":5,"startChapter":15,"startVerse":5}],"sourceAttributes":{"name":"Ps.15.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[15],"sourceItemFragmentSha256":"89c0219aac9ca501a9329c42b4e1f0e956da8cb4e8f8b8c4e88c7b45fe6d4835","sourceItemName":"Ps.15.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6102,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.15.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.15.5","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}