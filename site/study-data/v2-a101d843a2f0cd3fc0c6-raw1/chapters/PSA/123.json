"123:1-2"},"). The psalmist prays for God’s favor on the community, as the reality of evil surrounds them (",{"href":"?bref=Ps.123.3-4","r":"Ps.123.3-4","rawR":"Ps.123.3-4","sourceRefs":[{"raw":"Ps.123.3-4","value":"Ps.123.3-4"}],"t":"ref","v":"123:3-4"},"). The poet looks beyond Jerusalem (",{"href":"?bref=Ps.122.1-9","r":"Ps.122.1-9","rawR":"Ps.122.1-9","sourceRefs":[{"raw":"Ps.122.1-9","value":"Ps.122.1-9"}],"t":"ref","v":"Ps 122"},") to God’s throne ",{"c":["in heaven."],"sourceClass":"sn-excerpt","t":"span"}],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.123.1-4","refs":[{"book":"PSA","endChapter":123,"endVerse":4,"startChapter":123,"startVerse":1}],"sourceAttributes":{"name":"Ps.123.1-4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[123],"sourceItemFragmentSha256":"d7d266bf934c014a592eda7419792ea90e4541d8f30139bf1880047c67c5458a","sourceItemName":"Ps.123.1-4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7316,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.123.1-4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.123.1-4","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}