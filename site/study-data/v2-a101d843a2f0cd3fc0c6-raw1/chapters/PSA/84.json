cob"},"text":"O LORD God of Hosts, hear my prayer; give ear, O God of Jacob. Selah","verse":8}],"id":"Jacob","label":"Jacob","matchReviews":[{"ruleId":"Jacob::Jacob::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Jacob","term":"Jacob"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Jacob","sourceTitle":"Jacob"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"For the choirmaster. According to Gittith. A Psalm of the sons of Korah. How lovely is Your dwelling place, O LORD of Hosts!","verse":1},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"My soul longs, even faints, for the courts of the LORD; my heart and my flesh cry out for the living God.","verse":2},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Even the sparrow has found a home, and the swallow a nest for herself, where she places her young near Your altars, O LORD of Hosts, my King and my God.","verse":3},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"O LORD God of Hosts, hear my prayer; give ear, O God of Jacob. Selah","verse":8},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"For the LORD God is a sun and a shield; the LORD gives grace and glory; He withholds no good thing from those who walk with integrity.","verse":11},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"O LORD of Hosts, how blessed is the man who trusts in You!","verse":12}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Zion","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[{"anchorIndex":57,"href":"?bref=Ps.84.1-12","rawReference":"Ps.84.1-12"}],"ruleId":"Zion::Zion::reviewed_unambiguous_name","sourceHeadwordId":"Zion"},"text":"They go from strength to strength, until each appears before God in Zion.","verse":7}],"id":"Zion","label":"Zion","matchReviews":[{"ruleId":"Zion::Zion::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Zion","term":"Zion"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Zion","sourceTitle":"Zion"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.84.1-12","r":"Ps.84.1-12","rawR":"Ps.84.1-12","sourceRefs":[{"raw":"Ps.84.1-12","value":"Ps.84.1-12"}],"t":"ref","v":"Ps 84"}],"sourceClass":"sn-ref","t":"span"}," The psalmist expresses his deep spiritual longing for God’s presence. He faints with longing as he reflects on the Temple and on pilgrims making the journey to Jerusalem (",{"href":"?bref=Ps.84.1-7","r":"Ps.84.1-7","rawR":"Ps.84.1-7","sourceRefs":[{"raw":"Ps.84.1-7","value":"Ps.84.1-7"}],"t":"ref","v":"84:1-7"},"). He prays for himself and for the community (",{"href":"?bref=Ps.84.8-9","r":"Ps.84.8-9","rawR":"Ps.84.8-9","sourceRefs":[{"raw":"Ps.84.8-9","value":"Ps.84.8-9"}],"t":"ref","v":"84:8-9"},"). The conclusion of the psalm (",{"href":"?bref=Ps.84.10-12","r":"Ps.84.10-12","rawR":"Ps.84.10-12","sourceRefs":[{"raw":"Ps.84.10-12","value":"Ps.84.10-12"}],"t":"ref","v":"84:10-12"},") clarifies that the Temple represents God—the psalmist truly longs for God’s presence. He knows that God’s goodness is greater than life and that only God can give his people favor and honor (",{"href":"?bref=Ps.84.10-11","r":"Ps.84.10-11","rawR":"Ps.84.10-11","sourceRefs":[{"raw":"Ps.84.10-11","value":"Ps.84.10-11"}],"t":"ref","v":"84:10-11"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.84.1-12","refs":[{"book":"PSA","endChapter":84,"endVerse":12,"startChapter":84,"startVerse":1}],"sourceAttributes":{"name":"Ps.84.1-12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[84],"sourceItemFragmentSha256":"8799a99b7f2eadd5c999bca636ffb011d65ec9c00a90cec361a61b0a36893792","sourceItemName":"Ps.84.1-12","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6849,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.84.1-12","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.84.1-12","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.84.1-4","r":"Ps.84.1-4","rawR":"Ps.84.1-4","sourceRefs":[{"raw":"Ps.84.1-4","value":"Ps.84.1-4"}],"t":"ref","v":"84:1-4"}],"sourceClass":"sn-ref","t":"span"}," The psalmist is far from the Temple. He turns toward it in hopeful reflection."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.84.1-4","refs":[{"book":"PSA","endChapter":84,"endVerse":4,"startChapter":84,"startVerse":1}],"sourceAttributes":{"name":"Ps.84.1-4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[84],"sourceItemFragmentSha256":"8af04778d6ef245a69758aef35ae4e47d5d4c7e3caf875d7ba26241a82c8a59f","sourceItemName":"Ps.84.1-4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6850,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.84.1-4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.84.1-4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","cont