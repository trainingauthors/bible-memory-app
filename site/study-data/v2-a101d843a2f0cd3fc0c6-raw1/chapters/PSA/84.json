5","value":"Ps.84.5"}],"t":"ref","v":"84:5"}],"sourceClass":"sn-ref","t":"span"}," Travelers needed ",{"c":["strength"],"sourceClass":"sn-excerpt","t":"span"}," to meet the challenges of ",{"c":["pilgrimage"],"sourceClass":"sn-excerpt","t":"span"}," by foot along unpaved paths, in all kinds of weather and with the possibility of assaults."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.84.5","refs":[{"book":"PSA","endChapter":84,"endVerse":5,"startChapter":84,"startVerse":5}],"sourceAttributes":{"name":"Ps.84.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[84],"sourceItemFragmentSha256":"838d1b821392290d9e401b916a5f48ffc210afeab4dec891ea9b765e0809b4c4","sourceItemName":"Ps.84.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6854,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.84.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.84.5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.84.6","r":"Ps.84.6","rawR":"Ps.84.6","sourceRefs":[{"raw":"Ps.84.6","value":"Ps.84.6"}],"t":"ref","v":"84:6"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["Valley of Weeping"],"sourceClass":"sn-excerpt","t":"span"}," probably refers to the anguish that lonely pilgrims endured (see ",{"href":"?bref=Ps.23.4","r":"Ps.23.4","rawR":"Ps.23.4","sourceRefs":[{"raw":"Ps.23.4","value":"Ps.23.4"}],"t":"ref","v":"23:4"},"), rather than to an actual location. • ",{"c":["refreshing springs . . . autumn rains:"],"sourceClass":"sn-excerpt","t":"span"}," Even when pilgrims feel totally exhausted, the prospect of drawing near to the Lord renews their spirits (cp. ",{"href":"?bref=Isa.35.6-10","r":"Isa.35.6-10","rawR":"Is