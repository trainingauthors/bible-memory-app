"t":"ref","v":"17:1"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.17.3","refs":[{"book":"PSA","endChapter":17,"endVerse":3,"startChapter":17,"startVerse":3}],"sourceAttributes":{"name":"Ps.17.3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[17],"sourceItemFragmentSha256":"6633ac6c960a0b5d41b5811798720821cc503f07e0fb6c1fec6f630206c2a0a2","sourceItemName":"Ps.17.3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6116,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.17.3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.17.3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.17.6-9","r":"Ps.17.6-9","rawR":"Ps.17.6-9","sourceRefs":[{"raw":"Ps.17.6-9","value":"Ps.17.6-9"}],"t":"ref","v":"17:6-9"}],"sourceClass":"sn-ref","t":"span"}," This prayer for God’s care returns to the petition begun in ",{"href":"?bref=Ps.17.1-2","r":"Ps.17.1-2","rawR":"Ps.17.1-2","sourceRefs":[{"raw":"Ps.17.1-2","value":"Ps.17.1-2"}],"t":"ref","v":"17:1-2"}," for redemption from evil."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.17.6-9","refs":[{"book":"PSA","endChapter":17,"endVerse":9,"startChapter":17,"startVerse":6}],"sourceAttributes":{"name":"Ps.17.6-9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[17],"sourceItemFragmentSha256":"ecb193dfce1de23b154f15f2e30dace717f0989d79ae29b588cc725e4d49b7f2","sourceItemName":"Ps.17.6-9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6117,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.17.6-9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.17.6-9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.17.8","r":"Ps.17.8","rawR":"Ps.17.8","sourceRefs":[{"raw":"Ps.17.8","value":"Ps.17.8"}],"t":"ref","v":"17:8"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["as you would guard your own eyes"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["as the pupil of your eye"],"sourceClass":"ital","t":"span"},"): This metaphor expresses God’s care and affection for the psalmist (see ",{"href":"?bref=Deut.32.10","r":"Deut.32.10","rawR":"Deut.32.10","sourceRefs":[{"raw":"Deut.32.10","value":"Deut.32.10"}],"t":"ref","v":"Deut 32:10"},"). • The ",{"c":["shadow of"],"sourceClass":"sn-excerpt","t":"span"}," God’s ",{"c":["wings"],"sourceClass":"sn-excerpt","t":"span"}," is a place of his protection from enemies and adversity (",{"href":"?bref=Ps.36.7","r":"Ps.36.7","rawR":"Ps.36.7","sourceRefs":[{"raw":"Ps.36.7","value":"Ps.36.7"}],"t":"ref","v":"Pss 36:7"},"; ",{"href":"?bref=Ps.57.1","r":"Ps.57.1","rawR":"Ps.57.1","sourceRefs":[{"raw":"Ps.57.1","value":"Ps.57.1"}],"t":"ref","v":"57:1"},"; ",{"href":"?bref=Ps.61.4","r":"Ps.61.4","rawR":"Ps.61.4","sourceRefs":[{"raw":"Ps.61.4","value":"Ps.61.4"}],"t":"ref","v":"61:4"},"; ",{"href":"?bref=Ps.63.7","r":"Ps.63.7","rawR":"Ps.63.7","sourceRefs":[{"raw":"Ps.63.7","value":"Ps.63.7"}],"t":"ref","v":"63:7"},"; ",{"href":"?bref=Ps.91.4","r":"Ps.91.4","rawR":"Ps.91.4","sourceRefs":[{"raw":"Ps.91.4","value":"Ps.91.4"}],"t":"ref","v":"91:4"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.17.8","refs":[{"book":"PSA","endChapter":17,"endVerse":8,"startChapter":17,"startVerse":8}],"sourceAttributes":{"name":"Ps.17.8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCovera