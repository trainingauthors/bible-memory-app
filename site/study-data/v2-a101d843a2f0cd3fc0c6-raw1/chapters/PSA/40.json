ated":[{"id":"Confession","title":"Confession"},{"id":"DeliveranceDeliverer","title":"Deliverance, Deliverer"},{"id":"Fellowship","title":"Fellowship"},{"id":"HebrewsLettertothe","title":"Hebrews, Letter to the"},{"id":"ImprecatoryPsalms","title":"Imprecatory Psalms*"},{"id":"Leather","title":"Leather"},{"id":"Messiah","title":"Messiah"},{"id":"Music","title":"Music"},{"id":"New","title":"New"},{"id":"PsalmsBookof","title":"Psalms, Book of"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"David","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[{"anchorIndex":53,"href":"?bref=Ps.1.1-41.13","rawReference":"Ps.1.1-41.13"}],"ruleId":"David::David::reviewed_unambiguous_name","sourceHeadwordId":"David"},"text":"For the choirmaster. A Psalm of David. I waited patiently for the LORD; He inclined to me and heard my cry.","verse":1}],"id":"David","label":"David","matchReviews":[{"ruleId":"David::David::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"David","term":"David"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"David","sourceTitle":"David"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"For the choirmaster. A Psalm of David. I waited patiently for the LORD; He inclined to me and heard my cry.","verse":1},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"He put a new song in my mouth, a hymn of praise to our God. Many will see and fear and put their trust in the LORD.","verse":3},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Blessed is the man who has made the LORD his trust, who has not turned to the proud, nor to those who lapse into falsehood.","verse":4},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Many, O LORD my God, are the wonders You have done, and the plans You have for us—none can compare to You—if I proclaim and declare them, they are more than I can count.","verse":5},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"I proclaim righteousness in the great assembly; behold, I do not seal my lips, as You, O LORD, do know.","verse":9},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"O LORD, do not withhold Your mercy from me; Your loving devotion and faithfulness will always guard me.","verse":11},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Be pleased, O LORD, to deliver me; hurry, O LORD, to help me.","verse":13},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"May all who seek You rejoice and be glad in You; may those who love Your salvation always say, “The LORD be magnified!”","verse":16}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"mercy","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":20,"href":"?bref=Ps.40.11-17","rawReference":"Ps.40.11-17"}],"ruleId":"Mercy::Mercy::source_verse_citation","sourceHeadwordId":"Mercy"},"text":"O LORD, do not withhold Your mercy from me; Your loving devotion and faithfulness will always guard me.","verse":11}],"id":"Mercy","label":"mercy","matchReviews":[{"ruleId":"Mercy::Mercy::source_verse_citation","scope":"source_verse_citation","senseReview":"Reviewed original headword and source sense. This substantive word is admitted only where the original article explicitly cites the exact occurrence verse; ambiguous homographs and known context mismatches are separately excluded. This is selective contextual evidence, not an automatic rule for every same-spelling word.","sourceHeadwordId":"Mercy","term":"Mercy"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Mercy","sourceTitle":"Mercy"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.40.1-17","r":"Ps.40.1-17","rawR":"Ps.40.1-17","sourceRefs":[{"raw":"Ps.40.1-17","value":"Ps.40.1-17"}],"t":"ref","v":"Ps 40"}],"sourceClass":"sn-ref","t":"span"}," This psalm includes a thanksgiving song (",{"href":"?bref=Ps.40.1-10","r":"Ps.40.1-10","rawR":"Ps.40.1-10","sourceRefs":[{"raw":"Ps.40.1-10","value":"Ps.40.1-10"}],"t":"ref","v":"40:1-10"},") followed by a lament (",{"href":"?bref=Ps.40.11-17","r":"Ps.40.11-17","rawR":"Ps.40.11-17","sourceRefs":[{"raw":"Ps.40.11-17","value":"Ps.40.11-17"}],"t":"ref","v":"40:11-17"},"). The thanksgiving song includes the reason for the thanksgiving (",{"href":"?bref=Ps.40.1-5","r":"Ps.40.1-5","rawR":"Ps.40.1-5","sourceRefs":[{"raw":"Ps.40.1-5","value":"Ps.40.1-5"}],"t":"ref","v":"40:1-5"},"), an affirmation of commitment (",{"href":"?bref=Ps.40.6-8","r":"Ps.40.6-8","rawR":"Ps.40.6-8","sourceRefs":[{"raw":"Ps.40.6-8","value":"Ps.40.6-8"}],"t":"ref","v":"40:6-8"},"), and a public testimony of God’s character (",{"href":"?bref=Ps.40.7-10","r":"Ps.40.7-10","rawR":"Ps.40.7-10","sourceRefs":[{"raw":"Ps.40.7-10","value":"Ps.40.7-10"}],"t":"ref","v":"40:7-10"},"). The lament concerns the psalmist’s troubles because of his sins (",{"href":"?bref=Ps.40.11-12","r":"Ps.40.11-12","rawR":"Ps.40.11-12","sourceRefs":[{"raw":"Ps.40.11-12","value":"Ps.40.11-12"}],"t":"ref","v":"40:11-12"},") and is followed by two prayers for vindication (",{"href":"?bref=Ps.40.13-15","r":"Ps.40.13-15","rawR":"Ps.40.13-15","sourceRefs":[{"raw":"Ps.40.13-15","value":"Ps.40.13-15"}],"t":"ref","v":"40:13-15"},", ",{"href":"?bref=Ps.40.17","r":"Ps.40.17","rawR":"Ps.40.17","sourceRefs":[{"raw":"Ps.40.17","value":"Ps.40.17"}],"t":"ref","v":"17"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.40.1-17","refs":[{"book":"PSA","endChapter":40,"endVe