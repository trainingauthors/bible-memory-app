"],"sourceClass":"sn-excerpt","t":"span"}," ",{"c":["Lord"],"sourceClass":"sn-excerpt-divine-name","t":"span"},{"c":[" of Heaven’s Armies"],"sourceClass":"sn-excerpt","t":"span"}," reigns from his home, the Temple in Jerusalem (",{"href":"?bref=Ps.84.3-5","r":"Ps.84.3-5","rawR":"Ps.84.3-5","sourceRefs":[{"raw":"Ps.84.3-5","value":"Ps.84.3-5"}],"t":"ref","v":"84:3-5"},"). He excludes sin and sinners (",{"href":"?bref=Ps.24.3-6","r":"Ps.24.3-6","rawR":"Ps.24.3-6","sourceRefs":[{"raw":"Ps.24.3-6","value":"Ps.24.3-6"}],"t":"ref","v":"24:3-6"},") but protects all who dwell in Zion."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.24.10","refs":[{"book":"PSA","endChapter":24,"endVerse":10,"startChapter":24,"startVerse":10}],"sourceAttributes":{"name":"Ps.24.10","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[24],"sourceItemFragmentSha256":"3d8dbc45ace520f42a4eaa2d4c4f6bee89ca4034297aca30d8760b217d6f848e","sourceItemName":"Ps.24.10","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6223,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.24.10","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.24.10","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}