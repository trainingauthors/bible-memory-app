Ps.104.5"}],"t":"ref","v":"104:5"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.24.2","refs":[{"book":"PSA","endChapter":24,"endVerse":2,"startChapter":24,"startVerse":2}],"sourceAttributes":{"name":"Ps.24.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[24],"sourceItemFragmentSha256":"f315f3365ad898db5c78d79692640304921e7477e89788bbda07a3028d8aa7a2","sourceItemName":"Ps.24.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6219,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.24.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.24.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.24.3-6","r":"Ps.24.3-6","rawR":"Ps.24.3-6","sourceRefs":[{"raw":"Ps.24.3-6","value":"Ps.24.3-6"}],"t":"ref","v":"24:3-6"}],"sourceClass":"sn-ref","t":"span"}," The citizens of the King’s realm include all who seek him. The Lord invites them to enter his presence."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.24.3-6","refs":[{"book":"PSA","endChapter":24,"endVerse":6,"startChapter":24,"startVerse":3}],"sourceAttributes":{"name":"Ps.24.3-6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[24],"sourceItemFragmentSha256":"f6336abebbc5850c0a5da8c8a26bf36b2928b61003c9969eb30026dd608530b1","sourceItemName":"Ps.24.3-6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6220,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.24.3-6","sourceRelease":"1.25","s