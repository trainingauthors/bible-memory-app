ovenanceId":"Lord","sourceTitle":"Lord"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.41.1-13","r":"Ps.41.1-13","rawR":"Ps.41.1-13","sourceRefs":[{"raw":"Ps.41.1-13","value":"Ps.41.1-13"}],"t":"ref","v":"Ps 41"}],"sourceClass":"sn-ref","t":"span"}," In this wisdom psalm, the psalmist prays for healing (",{"href":"?bref=Ps.41.4","r":"Ps.41.4","rawR":"Ps.41.4","sourceRefs":[{"raw":"Ps.41.4","value":"Ps.41.4"}],"t":"ref","v":"41:4"},", ",{"href":"?bref=Ps.41.10","r":"Ps.41.10","rawR":"Ps.41.10","sourceRefs":[{"raw":"Ps.41.10","value":"Ps.41.10"}],"t":"ref","v":"10"},"), laments his distress (",{"href":"?bref=Ps.41.5-9","r":"Ps.41.5-9","rawR":"Ps.41.5-9","sourceRefs":[{"raw":"Ps.41.5-9","value":"Ps.41.5-9"}],"t":"ref","v":"41:5-9"},"), and expresses confidence in the Lord’s blessing (",{"href":"?bref=Ps.41.1-3","r":"Ps.41.1-3","rawR":"Ps.41.1-3","sourceRefs":[{"raw":"Ps.41.1-3","value":"Ps.41.1-3"}],"t":"ref","v":"41:1-3"},", ",{"href":"?bref=Ps.41.11-12","r":"Ps.41.11-12","rawR":"Ps.41.11-12","sourceRefs":[{"raw":"Ps.41.11-12","value":"Ps.41.11-12"}],"t":"ref","v":"11-12"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.41.1-13","refs":[{"book":"PSA","endChapter":41,"endVerse":13,"startChapter":41,"startVerse":1}],"sourceAttributes":{"name":"Ps.41.1-13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[41],"sourceItemFragmentSha256":"21ed1dc4aca2a2673aff4ab242c121f0b2cf11a1d10ff819056fa030f1c7a69a","sourceItemName":"Ps.41.1-13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6416,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.41.1-13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent