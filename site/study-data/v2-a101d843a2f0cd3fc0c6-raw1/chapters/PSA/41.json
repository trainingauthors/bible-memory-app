"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.41.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.41.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.41.3","r":"Ps.41.3","rawR":"Ps.41.3","sourceRefs":[{"raw":"Ps.41.3","value":"Ps.41.3"}],"t":"ref","v":"41:3"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["when they are sick:"],"sourceClass":"sn-excerpt","t":"span"}," This illness might be physical or spiritual (see ",{"href":"?bref=Ps.6.2","r":"Ps.6.2","rawR":"Ps.6.2","sourceRefs":[{"raw":"Ps.6.2","value":"Ps.6.2"}],"t":"ref","v":"6:2"},"; ",{"href":"?bref=Ps.38.1-22","r":"Ps.38.1-22","rawR":"Ps.38.1-22","sourceRefs":[{"raw":"Ps.38.1-22","value":"Ps.38.1-22"}],"t":"ref","v":"Ps 38"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.41.3","refs":[{"book":"PSA","endChapter":41,"endVerse":3,"startChapter":41,"startVerse":3}],"sourceAttributes":{"name":"Ps.41.3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[41],"sourceItemFragmentSha256":"36b8f8a583785223bec9b27494e4ea2449f75f70a91f6e7601eb16985c4f0eb4","sourceItemName":"Ps.41.3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6418,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.41.3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.41.3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.41.4","r":"Ps.41.4","rawR":"Ps.41.4","sourceRefs":[{"raw":"Ps.41.4","value":"Ps.41.4"}],"t":"ref","v":"41:4"}],"sourceClass":"sn-ref","t":"span"}," The psalmist applies the blessing to himself (",{"href":"?bref=Ps.41.12","r":"Ps.41.12","rawR":"Ps.41.12","sourceRefs":[{"raw":"Ps.41.12","value":"Ps.41.12"}],"t":"ref","v":"41:12"},"). Apparently he has taken care of the poor (",{"href":"?bref=Ps.41.1","r":"Ps.41.1","rawR":"Ps.41.1","sourceRefs":[{"raw":"Ps.41.1","value":"Ps.41.1"}],"t":"ref","v":"41:1"},"), but he has sinned against the Lord in other ways. Out of his pain, he cries for healing while confessing his sin. The Lord alone can grant the restoration that brings true joy (",{"href":"?bref=Ps.30.2","r":"Ps.30.2","rawR":"Ps.30.2","sourceRefs":[{"raw":"Ps.30.2","value":"Ps.30.2"}],"t":"ref","v":"30:2"},"; ",{"href":"?bref=Ps.107.20-21","r":"Ps.107.20-21","rawR":"Ps.107.20-21","sourceRefs":[{"raw":"Ps.107.20-21","value":"Ps.107.20-21"}],"t":"ref","v":"107:20-21"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.41.4","refs":[{"book":"PSA","endChapter":41,"endVerse":4,"startChapter":41,"startVerse":4}],"sourceAttributes":{"name":"Ps.41.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[41],"sourceItemFragmentSha256":"d5d66c9a1b77386cabd1faf9cd8a5c4060ab6feef6c7ee1dd172d590df28965d","sourceItemName":"Ps.41.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6419,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.41.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.41.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.41.5-9","r":"Ps.41.5-9","rawR":"Ps.41.5-9","sourceRefs":[{"raw":"Ps.41.5-9","value":"Ps.41.5-9"}],"t":"ref","v":"41:5-9"}],"sourceClass":"sn-ref","t":"span"}," The psalmist’s enemies disguise themselves as friends, while his friends openly become his enemies."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.41.5-9","refs":[{"book":"PSA","endChapter":41,"endVerse":9,"startChapter":41,"startVerse":5}],"sourceAttributes":{"name":"Ps.41.5-9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[41],"sourceItemFragmentSha256":"75caddf1fdc4089e16b91ea7ee4275fa72190ccacecd1c60f1ec0456cc05a8a1","sourceItemName":"Ps.41.5-9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6420,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.41.5-9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.41.5-9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.41.5","r":"Ps.41.5","rawR":"Ps.41.5","sourceRefs":[{"raw":"Ps.41.5","value":"Ps.41.5"}],"t":"ref","v":"41:5"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["How soon will he die?"],"sourceClass":"sn-excerpt","t":"span"}," The psalmist’s opponents regard his suffering as a divine judgment (cp. ",{"href":"?bref=Ps.1.6","r":"Ps.1.6","rawR":"Ps.1.6","sourceRefs":[{"raw":"Ps.1.6","value":"Ps.1.6"}],"t":"ref","v":"1:6"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.41.5","refs":[{"book":"PSA","endChapter":41,"endVerse":5,"startChapter":41,"startVerse":5}],"sourceAttributes":{"name":"Ps.41.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[41],"sourceItemFragmentSha256":"d808ef89fd90042b88a648a704bf23f5e398c787af3df0ae4eb3fd9b61ee855a","sourceItemName":"Ps.41.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6421,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.41.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.41.5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.41.9","r":"Ps.41.9","rawR":"Ps.41.9","sourceRefs":[{"raw":"Ps.41.9","value":"Ps.41.9"}],"t":"ref","v":"41:9"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["the one who shared my food:"],"sourceClass":"sn-excerpt","t":"span"}," Eating together was a sign of unity (",{"href":"?bref=Acts.2.42","r":"Acts.2.42","rawR":"Acts.2.42","sourceRefs":[{"raw":"Acts.2.42","value":"Acts.2.42"}],"t":"ref","v":"Acts 2:42"},"). Refusing to eat with someone indicated hostility (",{"href":"?bref=1Cor.5.11","r":"1Cor.5.11","rawR":"1Cor.5.11","sourceRefs":[{"raw":"1Cor.5.11","value":"1Cor.5.11"}],"t":"ref","v":"1 Cor 5:11"},"). Jesus experienced the same kind of betrayal (",{"href":"?bref=John.13.1","r":"John.13.1","rawR":"John.13.1","sourceRefs":[{"raw":"John.13.1","value":"John.13.1"}],"t":"ref","v":"John 13:1"},", ",{"href":"?bref=John.13.18","r":"John.13.18","rawR":"John.13.18","sourceRefs":[{"raw":"John.13.18","value":"John.13.18"}],"t":"ref","v":"18"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.41.9","refs":[{"book":"PSA","endChapter":41,"endVerse":9,"startChapter":41,"startVerse":9}],"sourceAttributes":{"name":"Ps.41.9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[41],"sourceItemFragmentSha256":"97a831ef5feff11231ee4467e125b6fcaf65cac80498174707c3eca670a31bbe","sourceItemName":"Ps.41.9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6422,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.41.9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.41.9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.41.11-12","r":"Ps.41.11-12","rawR":"Ps.41.11-12","sourceRefs":[{"raw":"Ps.41.11-12","value":"Ps.41.11-12"}],"t":"ref","v":"41:11-12"}],"sourceClass":"sn-ref","t":"span"}," The psalmist knows that the Lord has forgiven him and will bless him."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.41.11-12","refs":[{"book":"PSA","endChapter":41,"endVerse":12,"startChapter":41,"startVerse":11}],"sourceAttributes":{"name":"Ps.41.11-12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[41],"sourceItemFragmentSha256":"5cace0daf6bfbb241cae3a4b3385f614d7728acebbfda1e4ba049923074fbefd","sourceItemName":"Ps.41.11-12","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6423,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.41.11-12","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.41.11-12","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.41.13","r":"Ps.41.13","rawR":"Ps.41.13","sourceRefs":[{"raw":"Ps.41.13","value":"Ps.41.13"}],"t":"ref","v":"41:13"}],"sourceClass":"sn-ref","t":"span"}," This doxology closes Book One (",{"href":"?bref=Ps.1.1-41.13","r":"Ps.1.1-41.13","rawR":"Ps.1.1-41.13","sourceRefs":[{"raw":"Ps.1.1-41.13","value":"Ps.1.1-41.13"}],"t":"ref","v":"Pss 1–41"},"). Cp. ",{"href":"?bref=Ps.106.48","r":"Ps.106.48","rawR":"Ps.106.48","sourceRefs":[{"raw":"Ps.106.48","value":"Ps.106.48"}],"t":"ref","v":"106:48"},"."],"sourceClass":"sn-text","t":"p"}],"id"