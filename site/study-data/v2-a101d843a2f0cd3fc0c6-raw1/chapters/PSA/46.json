s.46.8"}],"t":"ref","v":"46:8"}],"sourceClass":"sn-ref","t":"span"}," Israel saw the Lord’s ",{"c":["glorious works"],"sourceClass":"sn-excerpt","t":"span"}," in the wilderness (",{"href":"?bref=Ps.107.24","r":"Ps.107.24","rawR":"Ps.107.24","sourceRefs":[{"raw":"Ps.107.24","value":"Ps.107.24"}],"t":"ref","v":"107:24"},"; ",{"href":"?bref=Ps.111.2","r":"Ps.111.2","rawR":"Ps.111.2","sourceRefs":[{"raw":"Ps.111.2","value":"Ps.111.2"}],"t":"ref","v":"111:2"},"), but the wicked, who have no concern for them (",{"href":"?bref=Ps.28.5","r":"Ps.28.5","rawR":"Ps.28.5","sourceRefs":[{"raw":"Ps.28.5","value":"Ps.28.5"}],"t":"ref","v":"28:5"},"), are left desolate (",{"href":"?bref=Ps.73.19","r":"Ps.73.19","rawR":"Ps.73.19","sourceRefs":[{"raw":"Ps.73.19","value":"Ps.73.19"}],"t":"ref","v":"73:19"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.46.8","refs":[{"book":"PSA","endChapter":46,"endVerse":8,"startChapter":46,"startVerse":8}],"sourceAttributes":{"name":"Ps.46.8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[46],"sourceItemFragmentSha256":"fff30fabfedfd77aa61a14d162d8067a818244e46dc182545b11b210a65f1fe4","sourceItemName":"Ps.46.8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6471,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.46.8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.46.8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.46.10","r":"Ps.46.10","rawR":"Ps.46.10","sourceRefs":[{"raw":"Ps.46.10","value":"Ps.46.10"}],"t":"ref","v":"46:10"}],"sourceClass":"sn-ref","t":"span"}," A message directly from the Lord confirms the authenticity of the psalmist’s vision (see also ",{"href":"?bref=Ps.12.5-6","r":"Ps.12.5-6","rawR":"Ps.12.5-6","sourceRefs":[{"raw":"Ps.12.5-6","value":"Ps.12.5-6"}],"t":"ref","v":"12:5-6"},"; ",{"href":"?bref=Ps.32.8","r":"Ps.32.8","rawR":"Ps.32.8","sourceRefs":[{"raw":"Ps.32.8","value":"Ps.32.8"}],"t":"ref","v":"32:8"},"). • ",{"c":["know that I am God:"],"sourceClass":"sn-excerpt","t":"span"}," The Lord will do what he promises (",{"href":"?bref=Isa.45.3","r":"Isa.45.3","rawR":"Isa.45.3","sourceRefs":[{"raw":"Isa.45.3","value":"Isa.45.3"}],"t":"ref","v":"Isa 45:3"},"; ",{"href":"?bref=Isa.49.23","r":"Isa.49.23","rawR":"Isa.49.23","sourceRefs":[{"raw":"Isa.49.23","value":"Isa.49.23"}],"t":"ref","v":"49:23"},"; ",{"href":"?bref=Isa.60.16","r":"Isa.60.16","rawR":"Isa.60.16","sourceRefs":[{"raw":"Isa.60.16","value":"Isa.60.16"}],"t":"ref","v":"60:16"},"). • God will be exalted (",{"href":"?bref=Ps.47.1-9","r":"Ps.47.1-9","rawR":"Ps.47.1-9","sourceRefs":[{"raw":"Ps.47.1-9","value":"Ps.47.1-9"}],"t":"ref","v":"Ps 47"},"; ",{"href":"?bref=Isa.6.1","r":"Isa.6.1","rawR":"Isa.6.1","sourceRefs":[{"raw":"Isa.6.1","value":"Isa.6.1"}],"t":"ref","v":"Isa 6:1"},"); he will judge the nations and rescue his people (see ",{"href":"?bref=Ps.57.11","r":"Ps.57.11","rawR":"Ps.57.11","sourceRefs":[{"raw":"Ps.57.11","value":"Ps.57.11"}],"t":"ref","v":"Pss 57:11"},"; ",{"href":"?bref=Ps.89.13","r":"Ps.89.13","rawR":"Ps.89.13","sourceRefs":[{"raw":"Ps.89.13","value":"Ps.89.13"}],"t":"ref","v":"89:13"},"; ",{"href":"?bref=Ps.108.5-6","r":"Ps.108.5-6","rawR":"Ps.108.5-6","sourceRefs":[{"raw":"Ps.108.5-6","value":"Ps.108.5-6"}],"t":"ref","v":"108:5-6"},"; ",{"href":"?bref=Ps.118.16","r":"Ps.118.16","rawR":"Ps.118.16","sourceRefs":[{"raw":"Ps.118.16","value":"Ps.118.16"}],"t":"ref","v":"118:16"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.46.10","refs":[{"book":"PSA","endChapter":46,"endVerse":10,"startChapter":46,"startVerse":10}],"sourceAttributes":{"name":"Ps.46.10","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"source