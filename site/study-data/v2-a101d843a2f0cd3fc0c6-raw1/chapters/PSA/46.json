:"sn-excerpt","t":"span"}," protects its inhabitants. They enjoy the ",{"c":["river"],"sourceClass":"sn-excerpt","t":"span"}," flowing inside the city. This river contrasts with the turbulent waters (the powers of the nations) outside the city."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.46.4-6","refs":[{"book":"PSA","endChapter":46,"endVerse":6,"startChapter":46,"startVerse":4}],"sourceAttributes":{"name":"Ps.46.4-6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[46],"sourceItemFragmentSha256":"3e3bb6444bafb248d85bab2a683a2a7ba8f95d86dc6e0949eee529ae69d2aea9","sourceItemName":"Ps.46.4-6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6465,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.46.4-6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.46.4-6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.46.4","r":"Ps.46.4","rawR":"Ps.46.4","sourceRefs":[{"raw":"Ps.46.4","value":"Ps.46.4"}],"t":"ref","v":"46:4"}],"sourceClass":"sn-ref","t":"span"}," Like the streams flowing through Eden, this ",{"c":["river"],"sourceClass":"sn-excerpt","t":"span"}," brings the water of life, restoration, and healing (",{"href":"?bref=Ps.36.8-9","r":"Ps.36.8-9","rawR":"Ps.36.8-9","sourceRefs":[{"raw":"Ps.36.8-9","value":"Ps.36.8-9"}],"t":"ref","v":"36:8-9"},"; see ",{"href":"?bref=Gen.2.10","r":"Gen.2.10","rawR":"Gen.2.10","sourceRefs":[{"raw":"Gen.2.10","value":"Gen.2.10"}],"t":"ref","v":"Gen 2:10"},"; ",{"href":"?bref=Ezek.47.1-23","r":"Ezek.47.1-23","rawR":"Ezek.47.1-23","sourceRefs":[{"raw":"Ezek.47.1-23","value":"Ezek.47.1-23"}],"t":"ref","v":"Ezek 47"},"; ",{"href":"?bref=Rev.22.2","r":"Rev.22.2","rawR":"Rev.22.2","sourceRefs":[{"raw":"Rev.22.2","value":"Rev.22.2"}],"t":"ref","v":"Rev 22:2"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.46.4","refs":[{"book":"PSA","endChapter":46,"endVerse":4,"startChapter":46,"startVerse":4}],"sourceAttributes":{"name":"Ps.46.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[46],"sourceItemFragmentSha256":"2584c8d19024386ac4d83fb60558f20368b54a6d539f26d6f961cd0fdd5daca3","sourceItemName":"Ps.46.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6466,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.46.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.46.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.46.5","r":"Ps.46.5","rawR":"Ps.46.5","sourceRefs":[{"raw":"Ps.46.5","value":"Ps.46.5"}],"t":"ref","v":"46:5"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["From the very break of day:"],"sourceClass":"sn-excerpt","t":"span"}," In the ancient Near East, enemies attacked cities during the day; even during the most dangerous times, the Lord ",{"c":["will protect"],"sourceClass":"sn-excerpt","t":"span"}," the place where his name dwells."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.46.5","refs":[{"book":"PSA","endChapter":46,"endVerse":5,"startChapter":46,"startVerse":5}],"sourceAttributes":{"name":"Ps.46.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[46],"sourceItemFragmentSha256":"05e16ccf97100b00a8d649ce1cda3444decf86e9469d52f6d3a0e99f358733f2","sourceItemName":"Ps.46.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6467,"sourceReferenceException":fals