enemy in the days of Gideon (",{"href":"?bref=Judg.7.1-8.5","r":"Judg.7.1-8.5","rawR":"Judg.7.1-8.5","sourceRefs":[{"raw":"Judg.7.1-8.5","value":"Judg.7.1-8.5"}],"t":"ref","v":"Judg 7:1–8:5"},"). Barak’s coalition defeated ",{"c":["Sisera and Jabin"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=Judg.4.1-24","r":"Judg.4.1-24","rawR":"Judg.4.1-24","sourceRefs":[{"raw":"Judg.4.1-24","value":"Judg.4.1-24"}],"t":"ref","v":"Judg 4"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.83.9-11","refs":[{"book":"PSA","endChapter":83,"endVerse":11,"startChapter":83,"startVerse":9}],"sourceAttributes":{"name":"Ps.83.9-11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[83],"sourceItemFragmentSha256":"7f0f9c706c1f987062aed5a2aa1326794ef69ea783a8230e919f946c75572d47","sourceItemName":"Ps.83.9-11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6845,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.83.9-11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.83.9-11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.83.12","r":"Ps.83.12","rawR":"Ps.83.12","sourceRefs":[{"raw":"Ps.83.12","value":"Ps.83.12"}],"t":"ref","v":"83:12"}],"sourceClass":"sn-ref","t":"span"}," The coalition’s motivation for wiping out Israel was to acquire the land (see ",{"href":"?bref=Jer.3.19","r":"Jer.3.19","rawR":"Jer.3.19","sourceRefs":[{"raw":"Jer.3.19","value":"Jer.3.19"}],"t":"ref","v":"Jer 3:19"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.83.12","refs":[{"book":"PSA","endChapter":83,"endVerse":12,"startChapter":83,"startVerse":12}],"sourceAttributes":{"name":"Ps.83.12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[83],"sourceItemFragmentSha256":"241f0fc10b3f92d1fb27d3a2764754e16d719afe79a64f363acbfeea3608435b","sourceItemName":"Ps.83.12","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6846,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.83.12","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.83.12","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.83.13","r":"Ps.83.13","rawR":"Ps.83.13","sourceRefs":[{"raw":"Ps.83.13","value":"Ps.83.13"}],"t":"ref","v":"83:13"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["tumbleweed . . . chaff:"],"sourceClass":"sn-excerpt","t":"span"}," This dry plant material easily blows away (see ",{"href":"?bref=Isa.17.13","r":"Isa.17.13","rawR":"Isa.17.13","sourceRefs":[{"raw":"Isa.17.13","value":"Isa.17.13"}],"t":"ref","v":"Isa 17:13"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.83.13","refs":[{"book":"PSA","endChapter":83,"endVerse":13,"startChapter":83,"startVerse":13}],"sourceAttributes":{"name":"Ps.83.13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[83],"sourceItemFragmentSha256":"8289db1c55cbffd96187b83bef5322e8fad526f8d25801995b1b977c65e90ede","sourceItemName":"Ps.83.13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6847,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.83.13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.83.13","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.83.14-15","r":"Ps.83.14-15","rawR":"Ps.83.14-15","sourceRefs":[{"raw":"Ps.83.14-15","value":"Ps.83.14-15"}],"t":"ref","v":"83:14-15"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["fire . . . fierce storm . . . tempest:"],"sourceClass":"sn-excerpt","t":"span"}," These are images of God’s manifestation in judgment (see ",{"href":"?bref=Isa.29.6","r":"Isa.29.6","rawR":"Isa.29.6","sourceRefs":[{"raw":"Isa.29.6","value":"Isa.29.6"}],"t":"ref","v":"Isa 29:6"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.83.14-15","refs":[{"book":"PSA","endChapter":83,"endVerse":15,"startChapter":83,"startVerse":14}],"sourceAttributes":{"name":"Ps.83.14-15","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[83],"sourceItemFragmentSha256":"e2bf75e4562b0cf1930641b9b4bd73552caebec9fd8e99acfd552a72de1baba7","sourceItemName":"Ps.83.14-15","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6848,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.83.14-15","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.83.14-15","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}