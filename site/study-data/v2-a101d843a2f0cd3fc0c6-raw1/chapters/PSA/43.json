A","chapter":6,"verses":[5]}]},{"label":"Rev 5:8","passages":[{"book":"REV","chapter":5,"verses":[8]}]}],"verse":4},{"anchor":"my God","refs":["Ps 42:6"],"sourceRowNumber":25788,"targets":[{"label":"Ps 42:6","passages":[{"book":"PSA","chapter":42,"verses":[6]}]}],"verse":4},{"anchor":"Why are you downcast, O my soul? Why the unease within me? Put your hope in God, for I will yet praise Him, my Savior and my God.","refs":["Ps 42:5,11"],"sourceRowNumber":25789,"targets":[{"label":"Ps 42:5,11","passages":[{"book":"PSA","chapter":42,"verses":[5,11]}]}],"verse":5}],"dictionaryArticles":{"David":{"file":"dictionary/a4f0bc8087f5ea80097160069911416d6992f1ee1a7c63890a01645e3abcd0ea.json","title":"David"},"Music":{"file":"dictionary/e0153531a40025ba8163d173c411943f354522e4d2beb121583465efec5c09a7.json","title":"Music"},"NumbersBookof":{"file":"dictionary/dfba67e1b59192d35e290d6230bd33c973c88fbcaeb2c2a0f78a6164c8b6fe3c.json","title":"Numbers, Book of"},"PsalmsBookof":{"file":"dictionary/8701f5dabbe5f1d73c94a8c5c69f9c0f6cf4ece07a1f4dd71ef33b5d7b8a964b.json","title":"Psalms, Book of"}},"dictionaryRelated":[{"id":"David","title":"David"},{"id":"Music","title":"Music"},{"id":"NumbersBookof","title":"Numbers, Book of"},{"id":"PsalmsBookof","title":"Psalms, Book of"}],"dictionaryWords":[],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":["Questions and Doubt"],"sourceClass":"theme-title","t":"h"},{"c":["The psalmists are not afraid to ask questions and express doubts. The number of questions in a psalm indicates the intensity of the mood or the significance of the issue at hand. The psalms with the greatest number of questions raise the important issues of God’s perceived abandonment (",{"href":"?bref=Ps.13.1-6","r":"Ps.13.1-6","rawR":"Ps.13.1-6","sourceRefs":[{"raw":"Ps.13.1-6","value":"Ps.13.1-6"}],"t":"ref","v":"Ps 13"},"; ",{"href":"?bref=Ps.42.1-43.5","r":"Ps.42.1-43.5","rawR":"Ps.42.1-43.5","sourceRefs":[{"raw":"Ps.42.1-43.5","value":"Ps.42.1-43.5"}],"t":"ref","v":"Pss 42–43"},"; ",{"href":"?bref=Ps.74.1-23","r":"Ps.74.1-23","rawR":"Ps.74.1-23","sourceRefs":[{"raw":"Ps.74.1-23","value":"Ps.74.1-23"}],"t":"ref","v":"74"},"; ",{"href":"?bref=Ps.89.1-52","r":"Ps.89.1-52","rawR":"Ps.89.1-52","sourceRefs":[{"raw":"Ps.89.1-52","value":"Ps.89.1-52"}],"t":"ref","v":"89"},") and the prosperity of the wicked (",{"href":"?bref=Ps.73.1-28","r":"Ps.73.1-28","rawR":"Ps.73.1-28","sourceRefs":[{"raw":"Ps.73.1-28","value":"Ps.73.1-28"}],"t":"ref","v":"Ps 73"},")."],"sourceClass":"theme-body-fl","t":"p"},{"c":["The psalmists’ questions clarify life issues. Some questions ask whether the Lord is the true God (",{"href":"?bref=Ps.94.9-10","r":"Ps.94.9-10","rawR":"Ps.94.9-10","sourceRefs":[{"raw":"Ps.94.9-10","value":"Ps.94.9-10"}],"t":"ref","v":"94:9-10"},") and why he seems to have abandoned the godly (",{"href":"?bref=Ps.77.7","r":"Ps.77.7","rawR":"Ps.77.7","sourceRefs":[{"raw":"Ps.77.7","value":"Ps.77.7"}],"t":"ref","v":"77:7"},"). Other questions call attention to the success of the wicked (",{"href":"?bref=Ps.10.13","r":"Ps.10.13","rawR":"Ps.10.13","sourceRefs":[{"raw":"Ps.10.13","value":"Ps.10.13"}],"t":"ref","v":"10:13"},"), the impotence of the godly (",{"href":"?bref=Ps.11.3","r":"Ps.11.3","rawR":"Ps.11.3","sourceRefs":[{"raw":"Ps.11.3","value":"Ps.11.3"}],"t":"ref","v":"11:3"},"), the election of Zion (",{"href":"?bref=Ps.68.16","r":"Ps.68.16","rawR":"Ps.68.16","sourceRefs":[{"raw":"Ps.68.16","value":"Ps.68.16"}],"t":"ref","v":"68:16"},"), the power of God (",{"href":"?bref=Ps.114.5-6","r":"Ps.114.5-6","rawR":"Ps.114.5-6","sourceRefs":[{"raw":"Ps.114.5-6","value":"Ps.114.5-6"}],"t":"ref","v":"114:5-6"},"; ",{"href":"?bref=Ps.147.17","r":"Ps.147.17","rawR":"Ps.147.17","sourceRefs":[{"raw":"Ps.147.17","value":"Ps.147.17"}],"t":"ref","v":"147:17"},"), the folly of the nations (",{"href":"?bref=Ps.2.1","r":"Ps.2.1","rawR":"Ps.2.1","sourceRefs":[{"raw":"Ps.2.1","value":"Ps.2.1"}],"t":"ref","v":"2:1"},"), and the issue of injustice (",{"href":"?bref=Ps.82.2","r":"Ps.82.2","rawR":"Ps.82.2","sourceRefs":[{"raw":"Ps.82.2","value":"Ps.82.2"}],"t":"ref","v":"82:2"},"). The psalmists question, examine, challenge, doubt, and occasionally despair over God’s seeming lack of concern."],"sourceClass":"theme-body","t":"p"},{"c":["The psalmists’ questions may also lead to praise and worship: “Who can list the glorious miracles of the ",{"c":["Lord"],"sourceClass":"divine-name","t":"span"},"? Who can ever praise him enough?” (",{"href":"?bref=Ps.106.2","r":"Ps.106.2","rawR":"Ps.106.2","sourceRefs":[{"raw":"Ps.106.2","value":"Ps.106.2"}],"t":"ref","v":"106:2"},"). The question, “Who will come from Mount Zion to rescue Israel?” (",{"href":"?bref=Ps.53.6","r":"Ps.53.6","rawR":"Ps.53.6","sourceRefs":[{"raw":"Ps.53.6","value":"Ps.53.6"}],"t":"ref","v":"53:6"},") calls attention to the answer: The Lord rescues his people. For many questions, the implied answer brings praise to the Lord: “Whom have I in heaven but you? I desire you more than anything on earth” (",{"href":"?bref=Ps.73.25","r":"Ps.73.25","rawR":"Ps.73.25","sourceRefs":[{"raw":"Ps.73.25","value":"Ps.73.25"}],"t":"ref","v":"73:25"},"; see also ",{"href":"?bref=Ps.89.8","r":"Ps.89.8","rawR":"Ps.89.8","sourceRefs":[{"raw":"Ps.89.8","value":"Ps.89.8"}],"t":"ref","v":"89:8"},"). Questions may also express wonder at God’s grace (",{"href":"?bref=Ps.8.4","r":"Ps.8.4","rawR":"Ps.8.4","sourceRefs":[{"raw":"Ps.8.4","value":"Ps.8.4"}],"t":"ref","v":"8:4"},"; ",{"href":"?bref=Ps.130.3","r":"Ps.130.3","rawR":"Ps.130.3","sourceRefs":[{"raw":"Ps.130.3","value":"Ps.130.3"}],"t":"ref","v":"130:3"},"; ",{"href":"?bref=Ps.144.3","r":"Ps.144.3","rawR":"Ps.144.3","sourceRefs":[{"raw":"Ps.144.3","value":"Ps.144.3"}],"t":"ref","v":"144:3"},")."],"sourceClass":"theme-body","t":"p"},{"c":["Asking good questions can be the beginning of a dialogue with the Lord that leads us along the path of wisdom and results in worship and praise."],"sourceClass":"theme-body","t":"p"},{"c":["Passages for Further Study"],"sourceClass":"theme-refs-title","t":"h"},{"c":[{"href":"?bref=Ps.2.1","r":"Ps.2.1","rawR":"Ps.2.1","sourceRefs":[{"raw":"Ps.2.1","value":"Ps.2.1"}],"t":"ref","v":"Pss 2:1"},"; ",{"href":"?bref=Ps.4.2","r":"Ps.4.2","rawR":"Ps.4.2","sourceRefs":[{"raw":"Ps.4.2","value":"Ps.4.2"}],"t":"ref","v":"4:2"},"; ",{"href":"?bref=Ps.6.3","r":"Ps.6.3","rawR":"Ps.6.3","sourceRefs":[{"raw":"Ps.6.3","value":"Ps.6.3"}],"t":"ref","v":"6:3"},"; ",{"href":"?bref=Ps.10.1","r":"Ps.10.1","rawR":"Ps.10.1","sourceRefs":[{"raw":"Ps.10.1","value":"Ps.10.1"}],"t":"ref","v":"10:1"},"; ",{"href":"?bref=Ps.11.3","r":"Ps.11.3","rawR":"Ps.11.3","sourceRefs":[{"raw":"Ps.11.3","value":"Ps.11.3"}],"t":"ref","v":"11:3"},"; ",{"href":"?bref=Ps.13.1-6","r":"Ps.13.1-6","rawR":"Ps.13.1-6","sourceRefs":[{"raw":"Ps.13.1-6","value":"Ps.13.1-6"}],"t":"ref","v":"13:1-6"},"; ",{"href":"?bref=Ps.22.1","r":"Ps.22.1","rawR":"Ps.22.1","sourceRefs":[{"raw":"Ps.22.1","value":"Ps.22.1"}],"t":"ref","v":"22:1"},"; ",{"href":"?bref=Ps.35.17","r":"Ps.35.17","rawR":"Ps.35.17","sourceRefs":[{"raw":"Ps.35.17","value":"Ps.35.17"}],"t":"ref","v":"35:17"},"; ",{"href":"?bref=Ps.42.1-11","r":"Ps.42.1-11","rawR":"Ps.42.1-11","sourceRefs":[{"raw":"Ps.42.1-11","value":"Ps.42.1-11"}],"t":"ref","v":"42:1-11"},"; ",{"href":"?bref=Ps.43.1-5","r":"Ps.43.1-5","rawR":"Ps.43.1-5","sourceRefs":[{"raw":"Ps.43.1-5","value":"Ps.43.1-5"}],"t":"ref","v":"43:1-5"},"; ",{"href":"?bref=Ps.44.23-24","r":"Ps.44.23-24","rawR":"Ps.44.23-24","sourceRefs":[{"raw":"Ps.44.23-24","value":"Ps.44.23-24"}],"t":"ref","v":"44:23-24"},"; ",{"href":"?bref=Ps.53.6","r":"Ps.53.6","rawR":"Ps.53.6","sourceRefs":[{"raw":"Ps.53.6","value":"Ps.53.6"}],"t":"ref","v":"53:6"},"; ",{"href":"?bref=Ps.60.9-10","r":"Ps.60.9-10","rawR":"Ps.60.9-10","sourceRefs":[{"raw":"Ps.60.9-10","value":"Ps.60.9-10"}],"t":"ref","v":"60:9-10"},"; ",{"href":"?bref=Ps.68.16","r":"Ps.68.16","rawR":"Ps.68.16","sourceRefs":[{"raw":