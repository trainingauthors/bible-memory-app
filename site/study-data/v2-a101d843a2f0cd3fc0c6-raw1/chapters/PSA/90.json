d":"Creation","title":"Creation"},{"id":"David","title":"David"},{"id":"Day","title":"Day"},{"id":"GodNamesof","title":"God, Names of"},{"id":"HoseaBookof","title":"Hosea, Book of"},{"id":"Light","title":"Light"},{"id":"Music","title":"Music"},{"id":"NumbersandNumerology","title":"Numbers and Numerology*"},{"id":"NumbersBookof","title":"Numbers, Book of"},{"id":"PsalmsBookof","title":"Psalms, Book of"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Return, O LORD! How long will it be? Have compassion on Your servants.","verse":13}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Moses","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Moses::Moses::reviewed_unambiguous_name","sourceHeadwordId":"Moses"},"text":"A prayer of Moses the man of God. Lord, You have been our dwelling place through all generations.","verse":1}],"id":"Moses","label":"Moses","matchReviews":[{"ruleId":"Moses::Moses::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Moses","term":"Moses"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Moses","sourceTitle":"Moses"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.90.1-17","r":"Ps.90.1-17","rawR":"Ps.90.1-17","sourceRefs":[{"raw":"Ps.90.1-17","value":"Ps.90.1-17"}],"t":"ref","v":"Ps 90"}],"sourceClass":"sn-ref","t":"span"}," Although the Lord’s people have made their home in him for generations, their sin widens the gap between them and their infinite Lord. The Lord’s wrath against a person’s sin might last a lifetime and yet be only a taste of his displeasure with sin. This lamentable situation calls the community to seek the Lord’s light. Taking the first step means seeking restoration with the Lord on the basis of his compassion and love (",{"href":"?bref=Ps.90.13-14","r":"Ps.90.13-14","rawR":"Ps.90.13-14","sourceRefs":[{"raw":"Ps.90.13-14","value":"Ps.90.13-14"}],"t":"ref","v":"90:13-14"},"). He alone makes his servants glad and blesses their future generations (",{"href":"?bref=Ps.90.16-17","r":"Ps.90.16-17","rawR":"Ps.90.16-17","sourceRefs":[{"raw":"Ps.90.16-17","value":"Ps.90.16-17"}],"t":"ref","v":"90:16-17"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.90.1-17","refs":[{"book":"PSA","endChapter":90,"endVerse":17,"startChapter":90,"startVerse":1}],"sourceAttributes":{"name":"Ps.90.1-17","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[90],"sourceItemFragmentSha256":"539293650a8460df0661c4c01011167c9e05d13960db335371158cb079e1b345","sourceItemName":"Ps.90.1-17","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6915,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.90.1-17","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.90.1-17","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"href":"?bref=Ps.90.1","r":"Ps.90.1","rawR":"Ps.90.1","sourceRefs":[{"raw":"Ps.90.1","value":"Ps.90.1"}],"t":"ref","v":"90:title"}," ",{"c":["Moses"],"sourceClass":"sn-excerpt","t":"span"}," led God’s people from slavery in Egypt to Mount Sinai, where he received the law and established God’s covenant with Israel. • ",{"c":["the man of God:"],"sourceClass":"sn-excerpt","t":"span"}," Moses enjoyed a special relationship with God (",{"href":"?bref=Deut.33.1","r":"Deut.33.1","rawR":"Deut.33.1","sourceRefs":[{"raw":"Deut.33.1","value":"Deut.33.1"}],"t":"ref","v":"Deut 33:1"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.90.1","refs":[{"book":"PSA","endChapter":90,"endVerse":1,"startChapter":90,"startVerse":1}],"sourceAttributes":{"name":"Ps.90.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[90],"sourceItemFragmentSha256":"852273f5d7ac02485f5b3f58158e64364a9e1d9dec99e179a42a1dcd64241023","sourceItemName":"Ps.90.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6916,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.90.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.90.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.90.1-2","r":"Ps.90.1-2","rawR":"Ps.90.1-2","sourceRefs":[{"raw":"Ps.90.1-2","value":"Ps.90.1-2"}],"t":"ref","v":"90:1-2"}],"sourceClass":"sn-ref","t":"span"}," The Lord becomes the ",{"c":["home"],"sourceClass":"sn-excerpt","t":"span"}," of the godly; he has provided shelter for countless ",{"c":["generations."],"sourceClass":"sn-excerpt","t":"span"}," The word translated ",{"c":["home"],"sourceClass":"ital","t":"span"}," is not used frequently in the Psalter. It describes a place of safety where the Lord meets his needy people and cares for them (",{"href":"?bref=Ps.68.5","r":"Ps.68.5","rawR":"Ps.68.5","sourceRefs":[{"raw":"Ps.68.5","value":"Ps.68.5"}],"t":"ref","v":"68:5"},"; ",{"href":"?bref=Ps.71.3","r":"Ps.71.3","rawR":"Ps.71.3","sourceRefs":[{"raw":"Ps.71.3","value":"Ps.71.3"}],"t":"ref","v":"71:3"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.90.1-2","refs":[{"book":"PSA","endChapter":90,"endVerse":2,"startChapter":90,"startVerse":1}],"sourceAttributes":{"name":"Ps.90.1-2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[90],"sourceItemFragmentSha256":"b0689f743da476ac3fe077e4fe7ca6a8e2be6df0a349c03899c114f67f7e16fb","sourceItemName":"Ps.90.1-2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6917,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.90.1-2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.90.1-2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.90.2","r":"Ps.90.2","rawR":"Ps.90.2","sourceRefs":[{"raw":"Ps.90.2","value":"Ps.90.2"}],"t":"ref","v":"90:2"}],"sourceClass":"sn-ref","t":"span"}," The Lord is the eternal God. • The Lord ",{"c":["gave birth to the earth"],"sourceClass":"sn-excerpt","t":"span"}," by creating it."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.90.2","refs":[{"book":"PSA","endChapter":90,"endVerse":2,"startChapter":90,"startVerse":2}],"sourceAttributes":{"name":"Ps.90.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[90],"sourceItemFragmentSha256":"461489664b3cc4fea9a7cac1d4587c689b72ed3421bd8d7a7a67aeef376f5519","sourceItemName":"Ps.90.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6918,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.90.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.90.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.90.3-6","r":"Ps.90.3-6","rawR":"Ps.90.3-6","sourceRefs":[{"raw":"Ps.90.3-6","value":"Ps.90.3-6"}],"t":"ref","v":"90:3-6"}],"sourceClass":"sn-ref","t":"span"}," Unlike God, humans are mortal and transitory."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.90.3-6","refs":[{"book":"PSA","endChapter":90,"endVerse":6,"startChapter":90,"startVerse":3}],"sourceAttributes":{"name":"Ps.90.3-6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[90],"sourceItemFragmentSha256":"489c83d7ab5ef32083cc67c7873d2be3718db8d44448ae148669cffb47c808bb","sourceItemName":"Ps.90.3-6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6919,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.90.3-6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.90.3-6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_ref