":"Presence of God, the"},{"id":"PsalmsBookof","title":"Psalms, Book of"},{"id":"Sun","title":"Sun"},{"id":"Work","title":"Work"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"David","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[{"anchorIndex":53,"href":"?bref=Ps.1.1-41.13","rawReference":"Ps.1.1-41.13"}],"ruleId":"David::David::reviewed_unambiguous_name","sourceHeadwordId":"David"},"text":"For the choirmaster. A Psalm of David. The heavens declare the glory of God; the skies proclaim the work of His hands.","verse":1}],"id":"David","label":"David","matchReviews":[{"ruleId":"David::David::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"David","term":"David"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"David","sourceTitle":"David"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"The Law of the LORD is perfect, reviving the soul; the testimony of the LORD is trustworthy, making wise the simple.","verse":7},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"The precepts of the LORD are right, bringing joy to the heart; the commandments of the LORD are radiant, giving light to the eyes.","verse":8},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"The fear of the LORD is pure, enduring forever; the judgments of the LORD are true, being altogether righteous.","verse":9},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"May the words of my mouth and the meditation of my heart be pleasing in Your sight, O LORD, my Rock and my Redeemer.","verse":14}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.15.1-19.14","r":"Ps.15.1-19.14","rawR":"Ps.15.1-19.14","sourceRefs":[{"raw":"Ps.15.1-19.14","value":"Ps.15.1-19.14"}],"t":"ref","v":"Pss 15–19"}],"sourceClass":"sn-ref","t":"span"}," The psalms in this section affirm integrity and purity (",{"href":"?bref=Ps.17.15","r":"Ps.17.15","rawR":"Ps.17.15","sourceRefs":[{"raw":"Ps.17.15","value":"Ps.17.15"}],"t":"ref","v":"17:15"},"; ",{"href":"?bref=Ps.18.20-26","r":"Ps.18.20-26","rawR":"Ps.18.20-26","sourceRefs":[{"raw":"Ps.18.20-26","value":"Ps.18.20-26"}],"t":"ref","v":"18:20-26"},"; ",{"href":"?bref=Ps.19.13-14","r":"Ps.19.13-14","rawR":"Ps.19.13-14","sourceRefs":[{"raw":"Ps.19.13-14","value":"Ps.19.13-14"}],"t":"ref","v":"19:13-14"},"). They refer to people as dwelling in God’s presence (",{"href":"?bref=Ps.16.9-11","r":"Ps.16.9-11","rawR":"Ps.16.9-11","sourceRefs":[{"raw":"Ps.16.9-11","value":"Ps.16.9-11"}],"t":"ref","v":"16:9-11"},"; ",{"href":"?bref=Ps.17.15","r":"Ps.17.15","rawR":"Ps.17.15","sourceRefs":[{"raw":"Ps.17.15","value":"Ps.17.15"}],"t":"ref","v":"17:15"},") and as not being shaken (",{"href":"?bref=Ps.15.5","r":"Ps.15.5","rawR":"Ps.15.5","sourceRefs":[{"raw":"Ps.15.5","value":"Ps.15.5"}],"t":"ref","v":"15:5"},"; ",{"href":"?bref=Ps.16.8","r":"Ps.16.8","rawR":"Ps.16.8","sourceRefs":[{"raw":"Ps.16.8","value":"Ps.16.8"}],"t":"ref","v":"16:8"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.15.1-19.14","refs":[{"book":"PSA","endChapter":19,"endVerse":14,"startChapter":15,"startVerse":1}],"sourceAttributes":{"name":"Ps.15.1-19.14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[15,16,17,18,19],"sourceItemFragmentSha256":"f6974c951b5f10f2f46cc82a89534d5e7f2ce9b9e0deb1642ab60bc3fe0af9da","sourceItemName":"Ps.15.1-19.14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6098,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.15.1-19.14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.15.1-19.14","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.19.1-14","r":"Ps.19.1-14","rawR":"Ps.19.1-14","sourceRefs":[{"raw":"Ps.19.1-14","value":"Ps.19.1-14"}],"t":"ref","v":"Ps 19"}],"sourceClass":"sn-ref","t":"span"}," God’s wisdom is manifest in heaven (",{"href":"?bref=Ps.19.1-4","r":"Ps.19.1-4","rawR":"Ps.19.1-4","sourceRefs":[{"raw":"Ps.19.1-4","value":"Ps.19.1-4"}],"t":"ref","v":"19:1-4"},"), in nature (",{"href":"?bref=Ps.19.4-6","r":"Ps.19.4-6","rawR":"Ps.19.4-6","sourceRefs":[{"raw":"Ps.19.4-6","value":"Ps.19.4-6"}],"t":"ref","v":"19:4-6"},"), in his instruction (",{"href":"?bref=Ps.19.7-11","r":"Ps.19.7-11","rawR":"Ps.19.7-11","sourceRefs":[{"raw":"Ps.19.7-11","value":"Ps.19.7-11"}],"t":"ref","v":"19:7-11"},"), and in the life of the psalmist (",{"href":"?bref=Ps.19.12-14","r":"Ps.19.12-14","rawR":"Ps.19.12-14","sourceRefs":[{"raw":"Ps.19.12-14","value":"Ps.19.12-14"}],"t":"ref","v":"19:12-14"},"). Like ",{"href":"?bref=Ps.8.1-9","r":"Ps.8.1-9","rawR":"Ps.8.1-9","sourceRefs":[{"raw":"Ps.8.1-9","value":"Ps.8.1-9"}],"t":"ref","v":"Ps 8"},", this hymn uses creation to motivate reflection—it is a peaceful oasis after the drama of the lament and victory psalms. The psalm begins with creation as a source of wisdom, then moves to God’s word as the perfect source of wisdom, and ends with the human need for redemption."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.19.1-14","refs":[{"book":"PSA","endChapter":19,"endVerse":14,"startChapter":19,"startVerse":1}],"sourceAttributes":{"name":"Ps.19.1-14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[19],"sourceItemFragmentSha256":"cbfe36167cf4f294edf466c7c6cb4c6938f932c54974b4c26a66c216f2ee8850","sourceItemName":"Ps.19.1-14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6150,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.19.1-14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.19.1-14","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.19.1-4","r":"Ps.19.1-4","rawR":"Ps.19.1-4","sourceRefs":[{"raw":"Ps.19.1-4","value":"Ps.19.1-4"}],"t":"ref","v":"19:1-4"}],"sourceClass":"sn-ref","t":"span"}," The created order is an arena of God’s wisdom, and the heavens are the place of God’s dwelling (",{"href":"?bref=Ps.2.4","r":"Ps.2.4","rawR":"Ps.2.4","sourceRefs":[{"raw":"Ps.2.4","value":"Ps.2.4"}],"t":"ref","v":"2:4"},"; see ",{"href":"?bref=Ps.8.1","r":"Ps.8.1","rawR":"Ps.8.1","sourceRefs":[{"raw":"Ps.8.1","value":"Ps.8.1"}],"t":"ref","v":"8:1"},"; ",{"href":"?bref=Ps.57.5","r":"Ps.57.5","rawR":"Ps.57.5","sourceRefs":[{"raw":"Ps.57.5","value":"Ps.57.5"}],"t":"ref","v":"57:5"},"; ",{"href":"?bref=Ps.89.6","r":"Ps.89.6","rawR":"Ps.89.6","sourceRefs":[{"raw":"Ps.89.6","value":"Ps.89.6"}],"t":"ref","v":"89:6"},"; ",{"href":"?bref=Ps.115.3","r":"Ps.115.3","rawR":"Ps.115.3","sourceRefs":[{"raw":"Ps.115.3","value":"Ps.115.3"}],"t":"ref","v":"115:3"},"). From heaven, God observes humanity (",{"href":"?bref=Ps.11.4","r":"Ps.11.4","rawR":"Ps.11.4","sourceRefs":[{"raw":"Ps.11.4","value":"Ps.11.4"}],"t":"ref","v":"11:4"},"; ",{"href":"?bref=Ps.14.2","r":"Ps.14.2","rawR":"Ps.14.2","sourceRefs":[{"raw":"Ps.14.2","value":"Ps.14.2"}],"t":"ref","v":"14:2"},"; ",{"href":"?bref=Ps.33.13","r":"Ps.33.13","rawR":"Ps.33.13","sourceRefs":[{"raw":"Ps.33.13","value":"Ps.33.13"}],"t":"ref","v":"33:13"},"; ",{"href":"?bref=Ps.53.2","r":"Ps.53.2","rawR":"Ps.53.2","sourceRefs":[{"raw":"Ps.53.2","value":"Ps.53.2"}],"t":"ref","v":"53:2"},"; ",{"href":"?bref=Ps.80.14","r":"Ps.80.14","rawR":"Ps.80.14","sourceRefs":[{"raw":"Ps.80.14","value":"Ps.80.14"}],"t":"ref","v":"80:14"},"; ",{"href":"?bref=Ps.102.19","r":"Ps.102.19","rawR":"Ps.102.19","sourceRefs":[{"raw":"Ps.102.19","value":"Ps.102.19"}],"t":"ref","v":"102:19"},") and comes to the rescue of his servants (",{"href":"?bref=Ps.18.6-8","r":"Ps.18.6-8","rawR":"Ps.18.6-8","sourceRefs":[{"raw":"Ps.18.6-8","value":"Ps.18.6-8"}],"t":"ref","v":"18:6-8"},", ",{"href":"?bref=Ps.18.13","r":"Ps.18.13","rawR":"Ps.18.13","sourceRefs":[{"raw":"Ps.18.13","value":"Ps.18.13"}],"t":"ref","v":"13"},"; ",{"href":"?bref=Ps.20.6","r":"Ps.20.6","rawR":"Ps.20.6","sourceRefs":[{"raw":"Ps.20.6","value":"Ps.20.6"}],"t":"ref","v":"20:6"},"; ",{"href":"?bref=Ps.57.3","r":"Ps.57.3","rawR":"Ps.57.3","sourceRefs":[{"raw":"Ps.57.3","value":"Ps.57.3"}],"t":"ref","v":"57:3"},"; ",{"href":"?bref=Ps.76.8","r":"Ps.76.8","rawR":"Ps.76.8","sourceRefs":[{"raw":"Ps.76.8","value":"Ps.76.8"}],"t":"ref","v":"76:8"},"; ",{"href":"?bref=Ps.144.5","r":"Ps.144.5","rawR":"Ps.144.5","sourceRefs":[{"raw":"Ps.144.5","value":"Ps.144.5"}],"t":"ref","v":"144:5"},"). The heavens remain unaffected by human failures and rebellions (see ",{"href":"?bref=Ps.2.1-4","r":"Ps.2.1-4","rawR":"Ps.2.1-4","sourceRefs":[{"raw":"Ps.2.1-4","value":"Ps.2.1-4"}],"t":"ref","v":"2:1-4"},"). They display God’s qualities of fidelity, righteousness (",{"href":"?bref=Ps.36.5","r":"Ps.36.5","rawR":"Ps.36.5","sourceRefs":[{"raw":"Ps.36.5","value":"Ps.36.5"}],"t":"ref","v":"36:5"},"; ",{"href":"?bref=Ps.50.6","r":"Ps.50.6","rawR":"Ps.50.6","sourceRefs":[{"raw":"Ps.50.6","value":"Ps.50.6"}],"t":"ref","v":"50:6"},"; ",{"href":"?bref=Ps.57.10","r":"Ps.57.10","rawR":"Ps.57.10","sourceRefs":[{"raw":"Ps.57.10","value":"Ps.57.10"}],"t":"ref","v":"57:10"},"; ",{"href":"?bref=Ps.85.11","r":"Ps.85.11","rawR":"Ps.85.11","sourceRefs":[{"raw":"Ps.85.11","value":"Ps.85.11"}],"t":"ref","v":"85:11"},"; ",{"href":"?bref=Ps.89.2","r":"Ps.89.2","rawR":"Ps.89.2","sourceRefs":[{"raw":"Ps.89.2","value":"Ps.89.2"}],"t":"ref","v":"89:2"},", ",{"href":"?bref=Ps.89.5","r":"Ps.89.5","rawR":"Ps.89.5","sourceRefs":[{"raw":"Ps.89.5","value":"Ps.89.5"}],"t":"ref","v":"5"},"; ",{"href":"?bref=Ps.97.6","r":"Ps.97.6","rawR":"Ps.97.6","sourceRefs":[{"raw":"Ps.97.6","value":"Ps.97.6"}],"t":"ref","v":"97:6"},"; ",{"href":"?bref=Ps.108.4","r":"Ps.108.4","rawR":"Ps.108.4","sourceRefs":[{"raw":"Ps.108.4","value":"Ps.108.4"}],"t":"ref","v":"108:4"},"), and wisdom (",{"href":"?bref=Ps.136.5","r":"Ps.136.5","rawR":"Ps.136.5","sourceRefs":[{"raw":"Ps.136.5","value":"Ps.136.5"}],"t":"ref","v":"136:5"},"; see ",{"href":"?bref=Ps.119.89-90","r":"Ps.119.89-90","rawR":"Ps.119.89-90","sourceRefs":[{"raw":"Ps.119.89-90","value":"Ps.119.89-90"}],"t":"ref","v":"119:89-90"},"). The heavens reveal the Lord’s glory (see ",{"href":"?bref=Ps.19.1","r":"Ps.19.1","rawR":"Ps.19.1","sourceRefs":[{"raw":"Ps.19.1","value":"Ps.19.1"}],"t":"ref","v":"19:1"},") and give evidence of his presence and handiwork."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.19.1-4","refs":[{"book":"PSA","endChapter":19,"endVerse":4,"startChapter":19,"startVerse":1}],"sourceAttributes":{"name":"Ps.19.1-4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[19],"sourceItemFragmentSha256":"83ed720ae90d497949a8386f3900a920d5d8df338a35098848add9ef9b5b0334","sourceItemName":"Ps.19.1-4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6151,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.19.1-4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.19.1-4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.19.1","r":"Ps.19.1","rawR":"Ps.19.1","sourceRefs":[{"raw":"Ps.19.1","value":"Ps.19.1"}],"t":"ref","v":"19:1"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["glory of God"],"sourceClass":"sn-excerpt","t":"span"}," refers to the splendor or manifest presence of the Creator (",{"href":"?bref=Ps.113.4","r":"Ps.113.4","rawR":"Ps.113.4","sourceRefs":[{"raw":"Ps.113.4","value":"Ps.113.4"}],"t":"ref","v":"113:4"},"). • ",{"c":["God"],"sourceClass":"sn-excerpt","t":"span"}," (Hebrew ",{"c":["’el"],"sourceClass":"hebrew","t":"span"},"): ",{"c":["El"],"sourceClass":"ital","t":"span"}," is an ancient designation for God that signifies his creative power."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.19.1","refs":[{"book":"PSA","endChapter":19,"endVerse":1,"startChapter":19,"startVerse":1}],"sourceAttributes":{"name":"Ps.19.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[19],"sourceItemFragmentSha256":"584d43067594dc1ed7d3c1e74d94b11d6087311acba584b8fefd9b4c1cfa3473","sourceItemName":"Ps.19.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6152,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.19.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.19.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.19.3-4","r":"Ps.19.3-4","rawR":"Ps.19.3-4","sourceRefs":[{"raw":"Ps.19.3-4","value":"Ps.19.3-4"}],"t":"ref","v":"19:3-4"}],"sourceClass":"sn-ref","t":"span"}," God’s wisdom does not need to be spoken. Through creation, it is seen, felt, and experienced. Paul applied this text to condemn Israel for its lack of receptivity to Jesus Christ (",{"href":"?bref=Rom.10.18","r":"Rom.10.18","rawR":"Rom.10.18","sourceRefs":[{"raw":"Rom.10.18","value":"Rom.10.18"}],"t":"ref","v":"Rom 10:18"},"). • The ",{"c":["sun"],"sourceClass":"sn-excerpt","t":"span"}," is part of God’s creation, but it is not a deity, as people of other nations in the ancient Near East commonly believed."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.19.3-4","refs":[{"book":"PSA","endChapter":19,"endVerse":4,"startChapter":19,"startVerse":3}],"sourceAttributes":{"name":"Ps.19.3-4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[19],"sourceItemFragmentSha256":"ad2771cb8611a56143f99b725ab90f2fd25aacfbee5441063cbb4ac5bfc3406d","sourceItemName":"Ps.19.3-4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6153,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.19.3-4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.19.3-4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.19.7-11","r":"Ps.19.7-11","rawR":"Ps.19.7-11","sourceRefs":[{"raw":"Ps.19.7-11","value":"Ps.19.7-11"}],"t":"ref","v":"19:7-11"}],"sourceClass":"sn-ref","t":"span"}," God’s ",{"c":["instructions"],"sourceClass":"sn-excerpt","t":"span"}," to humans reveal his character and wisdom. God’s instruction is precious and pleasant (",{"href":"?bref=Ps.119.103","r":"Ps.119.103","rawR":"Ps.119.103","sourceRefs":[{"raw":"Ps.119.103","value":"Ps.119.103"}],"t":"ref","v":"119:103"},"). It nourishes the person (",{"href":"?bref=Pr.16.24","r":"Pr.16.24","rawR":"Pr.16.24","sourceRefs":[{"raw":"Pr.16.24","value":"Pr.16.24"}],"t":"ref","v":"Prov 16:24"},"; ",{"href":"?bref=Pr.24.14","r":"Pr.24.14","rawR":"Pr.24.14","sourceRefs":[{"raw":"Pr.24.14","value":"Pr.24.14"}],"t":"ref","v":"24:14"},") and is of more value than objects of human worth (",{"href":"?bref=Ps.81.13-16","r":"Ps.81.13-16","rawR":"Ps.81.13-16","sourceRefs":[{"raw":"Ps.81.13-16","value":"Ps.81.13-16"}],"t":"ref","v":"Ps 81:13-16"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.19.7-11","refs":[{"book":"PSA","endChapter":19,"endVerse":11,"startChapter":19,"startVerse":7}],"sourceAttributes":{"name":"Ps.19.7-11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[19],"sourceItemFragmentSha256":"d79dd77ae69ed62786624546bc214e776ed4cc80044fa443e0acffccbccf10c1","sourceItemName":"Ps.19.7-11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6154,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.19.7-11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.19.7-11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.19.12-14","r":"Ps.19.12-14","rawR":"Ps.19.12-14","sourceRefs":[{"raw":"Ps.19.12-14","value":"Ps.19.12-14"}],"t":"ref","v":"19:12-14"}],"sourceClass":"sn-ref","t":"span"}," The psalmist knows his faults, so he prays to remain faithful and commits himself to the Lord."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.19.12-14","refs":[{"book":"PSA","endChapter":19,"endVerse":14,"startChapter":19,"startVerse":12}],"sourceAttributes":{"name":"Ps.19.12-14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[19],"sourceItemFragmentSha256":"cccec49f60c3dcc12bf0a4d0a3d8862cdd3590f7afc4bd880e14249fba48726b","sourceItemName":"Ps.19.12-14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6155,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.19.12-14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.19.12-14","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.19.13","r":"Ps.19.13","rawR":"Ps.19.13","sourceRefs":[{"raw":"Ps.19.13","value":"Ps.19.13"}],"t":"ref","v":"19:13"}],"sourceClass":"sn-ref","t":"span"}," An individual who commits ",{"c":["deliberate sins"],"sourceClass":"sn-excerpt","t":"span"}," does so with an insolent (",{"href":"?bref=Ps.86.14","r":"Ps.86.14","rawR":"Ps.86.14","sourceRefs":[{"raw":"Ps.86.14","value":"Ps.86.14"}],"t":"ref","v":"86:14"},") or arrogant (",{"href":"?bref=Ps.119.21","r":"Ps.119.21","rawR":"Ps.119.21","sourceRefs":[{"raw":"Ps.119.21","value":"Ps.119.21"}],"t":"ref","v":"119:21"},", ",{"href":"?bref=Ps.119.69","r":"Ps.119.69","rawR":"Ps.119.69","sourceRefs":[{"raw":"Ps.119.69","value":"Ps.119.69"}],"t":"ref","v":"69"},") attitude. • The ",{"c":["great sin"],"sourceClass":"sn-excerpt","t":"span"}," is rebellion (see ",{"href":"?bref=Ps.32.1","r":"Ps.32.1","rawR":"Ps.32.1","sourceRefs":[{"raw":"Ps.32.1","value":"Ps.32.1"}],"t":"ref","v":"32:1"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.19.13","refs":[{"book":"PSA","endChapter":19,"endVerse":13,"startChapter":19,"startVerse":13}],"sourceAttributes":{"name":"Ps.19.13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[19],"sourceItemFragmentSha256":"4ee9c6187aa5d4d1a588a0c1fafccb80a3107be69cf2717bd9cc480a08ace29b","sourceItemName":"Ps.19.13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6156,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.19.13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.19.13","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.19.14","r":"Ps.19.14","rawR":"Ps.19.14","sourceRefs":[{"raw":"Ps.19.14","value":"Ps.19.14"}],"t":"ref","v":"19:14"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["words of my mouth . . . meditation of my heart:"],"sourceClass":"sn-excerpt","t":"span"}," The psalmist desires to please God in everything he says and thinks (see ",{"href":"?bref=Luke.6.45","r":"Luke.6.45","rawR":"Luke.6.45","sourceRefs":[{"raw":"Luke.6.45","value":"Luke.6.45"}],"t":"ref","v":"Luke 6:45"},"; ",{"href":"?bref=Rom.12.1-2","r":"Rom.12.1-2","rawR":"Rom.12.1-2","sourceRefs":[{"raw":"Rom.12.1-2","value":"Rom.12.1-2"}],"t":"ref","v":"Rom 12:1-2"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.19.14","refs":[{"book":"PSA","endChapter":19,"endVerse":14,"startChapter":19,"startVerse":14}],"sourceAttributes":{"name":"Ps.19.14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[19],"sourceItemFragmentSha256":"1a2966333f1f69c9449b1b23e5cf4369120aff09d0242259cfd9e7811d62e91f","sourceItemName":"Ps.19.14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6157,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.19.14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.19.14","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}