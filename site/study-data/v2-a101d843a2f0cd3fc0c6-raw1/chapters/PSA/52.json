"v":"52:6"}],"sourceClass":"sn-ref","t":"span"}," In Hebrew, the verbs here translated ",{"c":["see"],"sourceClass":"sn-excerpt","t":"span"}," and ",{"c":["be amazed"],"sourceClass":"sn-excerpt","t":"span"}," sound almost alike."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.52.6","refs":[{"book":"PSA","endChapter":52,"endVerse":6,"startChapter":52,"startVerse":6}],"sourceAttributes":{"name":"Ps.52.6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[52],"sourceItemFragmentSha256":"880c38dd4958ab7671d8c4823d3a5ee1896b5511b986e5c74ac6e32a924a235c","sourceItemName":"Ps.52.6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6532,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.52.6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.52.6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.52.8-9","r":"Ps.52.8-9","rawR":"Ps.52.8-9","sourceRefs":[{"raw":"Ps.52.8-9","value":"Ps.52.8-9"}],"t":"ref","v":"52:8-9"}],"sourceClass":"sn-ref","t":"span"}," The psalmist commits himself to a life of trust in the Lord. • An ",{"c":["olive tree"],"sourceClass":"sn-excerpt","t":"span"}," lives a long time when cared for (",{"href":"?bref=Ps.1.3","r":"Ps.1.3","rawR":"Ps.1.3","sourceRefs":[{"raw":"Ps.1.3","value":"Ps.1.3"}],"t":"ref","v":"1:3"},"; ",{"href":"?bref=Ps.128.3","r":"Ps.128.3","rawR":"Ps.128.3","sourceRefs":[{"raw":"Ps.128.3","value":"Ps.128.3"}],"t":"ref","v":"128:3"},"). The psalmist desires to be close to the Lord, his Savior and the source of his blessing (",{"href":"?bref=Ps.18.6","r":"Ps.18.6","rawR":"Ps.18.6","sourceRefs":[{"raw":"Ps.18.6","value":"Ps.18.6"}],"t":"ref","v":"18:6"},"; ",{"href":"?bref=Ps.23.6","r":"Ps.23.6","rawR":"Ps.23.6","sourceRefs":[{"raw":"Ps.23.6","value":"Ps.23.6"}],"t":"ref","v":"23:6"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.52.8-9","refs":[{"book":"PSA","endChapter":52,"endVerse":9,"startChapter":52,"startVerse":8}],"sourceAttributes":{"name":"Ps.52.8-9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[52],"sourceItemFragmentSha256":"caaa637db37617933c36ce70cadc4723b72991de3e425e8657d06988f1e1720b","sourceItemName":"Ps.52.8-9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6533,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.52.8-9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.52.8-9","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}