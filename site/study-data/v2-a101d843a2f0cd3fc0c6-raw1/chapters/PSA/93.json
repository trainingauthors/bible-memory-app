 46:8"},"; ",{"href":"?bref=Jer.47.2","r":"Jer.47.2","rawR":"Jer.47.2","sourceRefs":[{"raw":"Jer.47.2","value":"Jer.47.2"}],"t":"ref","v":"47:2"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.93.3-4","refs":[{"book":"PSA","endChapter":93,"endVerse":4,"startChapter":93,"startVerse":3}],"sourceAttributes":{"name":"Ps.93.3-4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[93],"sourceItemFragmentSha256":"dddfdb6f757b6a395ffb9b6f245efd7de0dffabaa0c81e429efc30290395aa7f","sourceItemName":"Ps.93.3-4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6959,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.93.3-4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.93.3-4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.93.5","r":"Ps.93.5","rawR":"Ps.93.5","sourceRefs":[{"raw":"Ps.93.5","value":"Ps.93.5"}],"t":"ref","v":"93:5"}],"sourceClass":"sn-ref","t":"span"}," Through his stable rule and ",{"c":["royal laws"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," the Lord orders the world. • ",{"c":["Your reign"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["your house"],"sourceClass":"ital","t":"span"},"): The ",{"c":["house"],"sourceClass":"ital","t":"span"}," from which God reigns might be the Lord’s heavenly palace or the earthly Temple."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.93.5","refs":[{"book":"PSA","endChapter":93,"endVerse":5,"startChapter":93,"startVerse":5}],"sourceAttributes":{"name":"Ps.93.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[93],"sourceItemFragment