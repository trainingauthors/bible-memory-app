alue":"Ps.89.1-52"}],"t":"ref","v":"Ps 89"},") and answer the questions asked in ",{"href":"?bref=Ps.90.11","r":"Ps.90.11","rawR":"Ps.90.11","sourceRefs":[{"raw":"Ps.90.11","value":"Ps.90.11"}],"t":"ref","v":"90:11"},", ",{"href":"?bref=Ps.90.13","r":"Ps.90.13","rawR":"Ps.90.13","sourceRefs":[{"raw":"Ps.90.13","value":"Ps.90.13"}],"t":"ref","v":"13"},". The Lord has established a kingdom (",{"href":"?bref=Ps.93.1-5","r":"Ps.93.1-5","rawR":"Ps.93.1-5","sourceRefs":[{"raw":"Ps.93.1-5","value":"Ps.93.1-5"}],"t":"ref","v":"Ps 93"},") that is characterized by the punishment of the wicked (",{"href":"?bref=Ps.94.1-23","r":"Ps.94.1-23","rawR":"Ps.94.1-23","sourceRefs":[{"raw":"Ps.94.1-23","value":"Ps.94.1-23"}],"t":"ref","v":"Ps 94"},"), reverent obedience among his people (",{"href":"?bref=Ps.95.1-11","r":"Ps.95.1-11","rawR":"Ps.95.1-11","sourceRefs":[{"raw":"Ps.95.1-11","value":"Ps.95.1-11"}],"t":"ref","v":"Ps 95"},"), justice for the poor (",{"href":"?bref=Ps.96.1-13","r":"Ps.96.1-13","rawR":"Ps.96.1-13","sourceRefs":[{"raw":"Ps.96.1-13","value":"Ps.96.1-13"}],"t":"ref","v":"Ps 96"},"), celebration in Zion (",{"href":"?bref=Ps.97.1-12","r":"Ps.97.1-12","rawR":"Ps.97.1-12","sourceRefs":[{"raw":"Ps.97.1-12","value":"Ps.97.1-12"}],"t":"ref","v":"Ps 97"},"), salvation for Israel (",{"href":"?bref=Ps.98.1-9","r":"Ps.98.1-9","rawR":"Ps.98.1-9","sourceRefs":[{"raw":"Ps.98.1-9","value":"Ps.98.1-9"}],"t":"ref","v":"Ps 98"},"), holiness (",{"href":"?bref=Ps.99.1-9","r":"Ps.99.1-9","rawR":"Ps.99.1-9","sourceRefs":[{"raw":"Ps.99.1-9","value":"Ps.99.1-9"}],"t":"ref","v":"Ps 99"},"), and praise (",{"href":"?bref=Ps.100.1-5","r":"Ps.100.1-5","rawR":"Ps.100.1-5","sourceRefs":[{"raw":"Ps.100.1-5","value":"Ps.100.1-5"}],"t":"ref","v":"Ps 100"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.93.1-100.5","refs":[{"book":"PSA","endChapter":100,"endVerse":5,"startChapter":93,"startVerse":1}],"sourceAttributes":{"name":"Ps.93.1-100.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[93,94,95,96,97,98,99,100],"sourceItemFragmentSha256":"18ce7eafdcd2ed5de8a90ce1092dd66910bcd71ee5f794f2454756cf1614b47e","sourceItemName":"Ps.93.1-100.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6956,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.93.1-100.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.93.1-100.5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.93.1-5","r":"Ps.93.1-5","rawR":"Ps.93.1-5","sourceRefs":[{"raw":"Ps.93.1-5","value":"Ps.93.1-5"}],"t":"ref","v":"Ps 93"}],"sourceClass":"sn-ref","t":"span"}," The everlasting Lord gloriously establishes his kingship (cp. ",{"href":"?bref=Ps.47.1-9","r":"Ps.47.1-9","rawR":"Ps.47.1-9","sourceRefs":[{"raw":"Ps.47.1-9","value":"Ps.47.1-9"}],"t":"ref","v":"Pss 47"},", ",{"href":"?bref=Ps.99.1-100.5","r":"Ps.99.1-100.5","rawR":"Ps.99.1-100.5","sourceRefs":[{"raw":"Ps.99.1-100.5","value":"Ps.99.1-100.5"}],"t":"ref","v":"99–100"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.93.1-5","refs":[{"book":"PSA","endChapter":93,"endVerse":5,"startChapter":93,"startVerse":1}],"sourceAttributes":{"name":"Ps.93.1-5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[93],"sourceItemFragmentSha256":"7957c0595c580b2cc49b264b1f04e799242c42db3361d3baa82072ea28c1a6f9","sourceItemName":"Ps.93.1-5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6957,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact"