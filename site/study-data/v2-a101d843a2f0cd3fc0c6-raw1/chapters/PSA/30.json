Ps.30.3","value":"Ps.30.3"}],"t":"ref","v":"Ps 30:3"},"). • In his justice and care, God ",{"c":["refused to let"],"sourceClass":"sn-excerpt","t":"span"}," the psalmist’s ",{"c":["enemies triumph"],"sourceClass":"sn-excerpt","t":"span"}," (see ",{"href":"?bref=Ps.26.9","r":"Ps.26.9","rawR":"Ps.26.9","sourceRefs":[{"raw":"Ps.26.9","value":"Ps.26.9"}],"t":"ref","v":"26:9"},"; ",{"href":"?bref=Ps.27.12","r":"Ps.27.12","rawR":"Ps.27.12","sourceRefs":[{"raw":"Ps.27.12","value":"Ps.27.12"}],"t":"ref","v":"27:12"},"; ",{"href":"?bref=Ps.28.3","r":"Ps.28.3","rawR":"Ps.28.3","sourceRefs":[{"raw":"Ps.28.3","value":"Ps.28.3"}],"t":"ref","v":"28:3"},"; ",{"href":"?bref=Ps.31.8","r":"Ps.31.8","rawR":"Ps.31.8","sourceRefs":[{"raw":"Ps.31.8","value":"Ps.31.8"}],"t":"ref","v":"31:8"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.30.1","refs":[{"book":"PSA","endChapter":30,"endVerse":1,"startChapter":30,"startVerse":1}],"sourceAttributes":{"name":"Ps.30.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[30],"sourceItemFragmentSha256":"c5fa7df9ff8a1e55765421435190b7c6a6a09dba2e49f5bd6c39b4a044e008c9","sourceItemName":"Ps.30.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6281,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.30.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.30.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.30.4","r":"Ps.30.4","rawR":"Ps.30.4","sourceRefs":[{"raw":"Ps.30.4","value":"Ps.30.4"}],"t":"ref","v":"30:4"}],"sourceClass":"sn-ref","t":"span"}," The godly should celebrate the Lord’s acts of rescue with song and ",{"c":["praise"],"sourceClass":"sn-excerpt","t":"span"}," (