}],"t":"ref","v":"104:27-30"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.30.6-7","refs":[{"book":"PSA","endChapter":30,"endVerse":7,"startChapter":30,"startVerse":6}],"sourceAttributes":{"name":"Ps.30.6-7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[30],"sourceItemFragmentSha256":"f8a7a6e5b5908ae5e80ffe1863381a08e0997e5c90fb7400a3e3ee42a1c7554e","sourceItemName":"Ps.30.6-7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6283,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.30.6-7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.30.6-7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.30.8-12","r":"Ps.30.8-12","rawR":"Ps.30.8-12","sourceRefs":[{"raw":"Ps.30.8-12","value":"Ps.30.8-12"}],"t":"ref","v":"30:8-12"}],"sourceClass":"sn-ref","t":"span"}," The psalmist faced death (also in ",{"href":"?bref=Ps.30.1-3","r":"Ps.30.1-3","rawR":"Ps.30.1-3","sourceRefs":[{"raw":"Ps.30.1-3","value":"Ps.30.1-3"}],"t":"ref","v":"30:1-3"},")—perhaps literally, perhaps figuratively. But when he turned to the Lord, the Lord rescued him and turned his ",{"c":["mourning into joyful dancing"],"sourceClass":"sn-excerpt","t":"span"},". Only God’s favor can permanently and powerfully overcome human failure and the depths of despair."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.30.8-12","refs":[{"book":"PSA","endChapter":30,"endVerse":12,"startChapter":30,"startVerse":8}],"sourceAttributes":{"name":"Ps.30.8-12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[30],"sourceItemFragmentSha256":"a986133d04208e81c80eec44e8b768ec00eda403b4a3e6c6