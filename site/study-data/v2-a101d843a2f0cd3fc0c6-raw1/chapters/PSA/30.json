":"Ps.30.1-12","sourceRefs":[{"raw":"Ps.30.1-12","value":"Ps.30.1-12"}],"t":"ref","v":"Ps 30"}],"sourceClass":"sn-ref","t":"span"}," This individual thanksgiving psalm opens in praise to the Lord for his salvation (",{"href":"?bref=Ps.30.1-3","r":"Ps.30.1-3","rawR":"Ps.30.1-3","sourceRefs":[{"raw":"Ps.30.1-3","value":"Ps.30.1-3"}],"t":"ref","v":"30:1-3"},"), then contrasts God’s favor with his anger (",{"href":"?bref=Ps.30.4-7","r":"Ps.30.4-7","rawR":"Ps.30.4-7","sourceRefs":[{"raw":"Ps.30.4-7","value":"Ps.30.4-7"}],"t":"ref","v":"30:4-7"},"), and ends with a transformation from mourning to dancing (",{"href":"?bref=Ps.30.8-12","r":"Ps.30.8-12","rawR":"Ps.30.8-12","sourceRefs":[{"raw":"Ps.30.8-12","value":"Ps.30.8-12"}],"t":"ref","v":"30:8-12"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.30.1-12","refs":[{"book":"PSA","endChapter":30,"endVerse":12,"startChapter":30,"startVerse":1}],"sourceAttributes":{"name":"Ps.30.1-12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[30],"sourceItemFragmentSha256":"24ada5ba98d80a63ec9881544bc63f6aae09ef764142ad853a83f76692407428","sourceItemName":"Ps.30.1-12","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6278,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.30.1-12","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.30.1-12","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"href":"?bref=Ps.30.1","r":"Ps.30.1","rawR":"Ps.30.1","sourceRefs":[{"raw":"Ps.30.1","value":"Ps.30.1"}],"t":"ref","v":"30:title"}," Perhaps ",{"c":["David"],"sourceClass":"sn-excerpt","t":"span"}," wrote this psalm in advance for ",{"c":["the dedication of the Temple"],"sourceClass":"sn-excerpt","t":"spa