":["women"],"sourceClass":"sn-excerpt","t":"span"}," became part of the harem (see ",{"href":"?bref=1Kgs.11.1-3","r":"1Kgs.11.1-3","rawR":"1Kgs.11.1-3","sourceRefs":[{"raw":"1Kgs.11.1-3","value":"1Kgs.11.1-3"}],"t":"ref","v":"1 Kgs 11:1-3"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.45.9","refs":[{"book":"PSA","endChapter":45,"endVerse":9,"startChapter":45,"startVerse":9}],"sourceAttributes":{"name":"Ps.45.9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[45],"sourceItemFragmentSha256":"b68c8bb044bba9c74619f9e32c2c521b6b41073fb5656f53e4b66019de4f0179","sourceItemName":"Ps.45.9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6459,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.45.9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.45.9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.45.10-12","r":"Ps.45.10-12","rawR":"Ps.45.10-12","sourceRefs":[{"raw":"Ps.45.10-12","value":"Ps.45.10-12"}],"t":"ref","v":"45:10-12"}],"sourceClass":"sn-ref","t":"span"}," The bride is a representative of the king. Powerful people and nations try to gain her favor in order to get close to the king. This is a great honor, and she is encouraged to give herself fully to her new position."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.45.10-12","refs":[{"book":"PSA","endChapter":45,"endVerse":12,"startChapter":45,"startVerse":10}],"sourceAttributes":{"name":"Ps.45.10-12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[45],"sourceItemFragmentSha256":"833032672b97c3fc72168929c1fc51806d3dedd3599734e82f42fe2dd17985e0","sourceItemName":"Ps.45.