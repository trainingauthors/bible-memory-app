2"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.6.6-7","refs":[{"book":"PSA","endChapter":6,"endVerse":7,"startChapter":6,"startVerse":6}],"sourceAttributes":{"name":"Ps.6.6-7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[6],"sourceItemFragmentSha256":"63f54e7f1735c240fcbca670f6596061f27ffd9d5991666133dd0aa2f0722f9d","sourceItemName":"Ps.6.6-7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6013,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.6.6-7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.6.6-7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.6.8-10","r":"Ps.6.8-10","rawR":"Ps.6.8-10","sourceRefs":[{"raw":"Ps.6.8-10","value":"Ps.6.8-10"}],"t":"ref","v":"6:8-10"}],"sourceClass":"sn-ref","t":"span"}," In a closing note of triumph, the psalmist reasserts his confidence in the Lord."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.6.8-10","refs":[{"book":"PSA","endChapter":6,"endVerse":10,"startChapter":6,"startVerse":8}],"sourceAttributes":{"name":"Ps.6.8-10","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[6],"sourceItemFragmentSha256":"fdc7d8f3334c325abbca0c4c8ee6a977a1aee7d7a7ca8a571b5c670d323eb5e4","sourceItemName":"Ps.6.8-10","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6014,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.6.8-10","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAs