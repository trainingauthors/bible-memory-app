,"value":"Ps.6.2-3"}],"t":"ref","v":"6:2-3"}],"sourceClass":"sn-ref","t":"span"}," In his longing for God’s response to his prayer, the psalmist grew physically ",{"c":["weak"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=Ps.6.6","r":"Ps.6.6","rawR":"Ps.6.6","sourceRefs":[{"raw":"Ps.6.6","value":"Ps.6.6"}],"t":"ref","v":"6:6"},"; see ",{"href":"?bref=Ps.77.3","r":"Ps.77.3","rawR":"Ps.77.3","sourceRefs":[{"raw":"Ps.77.3","value":"Ps.77.3"}],"t":"ref","v":"77:3"},"; ",{"href":"?bref=Ps.119.81","r":"Ps.119.81","rawR":"Ps.119.81","sourceRefs":[{"raw":"Ps.119.81","value":"Ps.119.81"}],"t":"ref","v":"119:81"},"; ",{"href":"?bref=Ps.142.1-3","r":"Ps.142.1-3","rawR":"Ps.142.1-3","sourceRefs":[{"raw":"Ps.142.1-3","value":"Ps.142.1-3"}],"t":"ref","v":"142:1-3"},"; see also ",{"href":"?bref=Ps.101.1-8","r":"Ps.101.1-8","rawR":"Ps.101.1-8","sourceRefs":[{"raw":"Ps.101.1-8","value":"Ps.101.1-8"}],"t":"ref","v":"Ps 101"},"). Fasting might have played a part in his ",{"c":["agony"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," but this is not mentioned."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.6.2-3","refs":[{"book":"PSA","endChapter":6,"endVerse":3,"startChapter":6,"startVerse":2}],"sourceAttributes":{"name":"Ps.6.2-3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[6],"sourceItemFragmentSha256":"869716801ceaf88e4a2389e915066ca063f53e27365bf44b3eeb2e862018ecb3","sourceItemName":"Ps.6.2-3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6010,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.6.2-3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.6.2-3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_