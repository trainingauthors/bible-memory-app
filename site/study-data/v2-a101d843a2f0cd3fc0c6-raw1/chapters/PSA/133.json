psalmist tells of the joy of consecrated relationships."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.133.1-2","refs":[{"book":"PSA","endChapter":133,"endVerse":2,"startChapter":133,"startVerse":1}],"sourceAttributes":{"name":"Ps.133.1-2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[133],"sourceItemFragmentSha256":"917418a826c57a342f9bed5a77225354d21e7846548c7385da00ffdc91c0fcea","sourceItemName":"Ps.133.1-2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7359,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.133.1-2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.133.1-2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.133.1","r":"Ps.133.1","rawR":"Ps.133.1","sourceRefs":[{"raw":"Ps.133.1","value":"Ps.133.1"}],"t":"ref","v":"133:1"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Brothers"],"sourceClass":"sn-excerpt","t":"span"}," are related by blood, by profession, or by commitment."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.133.1","refs":[{"book":"PSA","endChapter":133,"endVerse":1,"startChapter":133,"startVerse":1}],"sourceAttributes":{"name":"Ps.133.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[133],"sourceItemFragmentSha256":"4e3b84b7150f42874179ddee7ba86ba3897657a80faa69dc719d4c6c45d3bacf","sourceItemName":"Ps.133.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7360,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExa