d_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"My help comes from the LORD, the Maker of heaven and earth.","verse":2},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"The LORD is your keeper; the LORD is the shade on your right hand.","verse":5},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"The LORD will guard you from all evil; He will preserve your soul.","verse":7},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"The LORD will watch over your coming and going, both now and forevermore.","verse":8}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.120.1-134.3","r":"Ps.120.1-134.3","rawR":"Ps.120.1-134.3","sourceRefs":[{"raw":"Ps.120.1-134.3","value":"Ps.120.1-134.3"}],"t":"ref","v":"Pss 120–134"}],"sourceClass":"sn-ref","t":"span"}," These short, appealing songs were sung during pilgrims’ journeys to Jerusalem for the national festivals three times per year (",{"href":"?bref=Deut.16.16","r":"Deut.16.16","rawR":"Deut.16.16","sourceRefs":[{"raw":"Deut.16.16","value":"Deut.16.16"}],"t":"ref","v":"Deut 16:16"},"). The title of these psalms includes the Hebrew word for stairs, which some take to mean “ascending to Jerusalem.” These psalms (sometimes called the Songs of Ascents) take the reader on a pilgrimage to Jerusalem to praise God for his goodness to Israel throughout history."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.120.1-134.3","refs":[{"book":"PSA","endChapter":134,"endVerse":3,"startChapter":120,"startVerse":1}],"sourceAttributes":{"name":"Ps.120.1-134.3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[120,121,122,123,124,125,126,127,128,129,130,131,132,133,134],"sourceItemFragmentSha256":"804bdc0d4264fc96adf7bf16357af3c33f1b33647dde7b70863e764ccb4e0941","sourceItemName":"Ps.120.1-134.3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7297,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.120.1-134.3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.120.1-134.3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.121.1-8","r":"Ps.121.1-8","rawR":"Ps.121.1-8","sourceRefs":[{"raw":"Ps.121.1-8","value":"Ps.121.1-8"}],"t":"ref","v":"Ps 121"}],"sourceClass":"sn-ref","t":"span"}," The leader of the group of pilgrims uses word pictures to assure the group of the Lord’s presence during the journey."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.121.1-8","refs":[{"book":"PSA","endChapter":121,"endVerse":8,"startChapter":121,"startVerse":1}],"sourceAttributes":{"name":"Ps.121.1-8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[121],"sourceItemFragmentSha256":"1f606b792c141e096d057fe3110fc4b6404af8037f0bcb58629e94c893f683f6","sourceItemName":"Ps.121.1-8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7304,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.121.1-8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.121.1-8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.121.1","r":"Ps.121.1","rawR":"Ps.121.1","sourceRefs":[{"raw":"Ps.121.1","value":"Ps.121.1"}],"t":"ref","v":"121:1"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["The mountains"],"sourceClass":"sn-excerpt","t":"span"}," were known for their idolatrous worship (",{"href":"?bref=Deut.12.2","r":"Deut.12.2","rawR":"Deut.12.2","sourceRefs":[{"raw":"Deut.12.2","value":"Deut.12.2"}],"t":"ref","v":"Deut 12:2"},"), and Israel was enticed to the hilltop shrines (",{"href":"?bref=Hos.4.13","r":"Hos.4.13","rawR":"Hos.4.13","sourceRefs":[{"raw":"Hos.4.13","value":"Hos.4.13"}],"t":"ref","v":"Hos 4:13"},"). This verse can be understood as a rhetorical question expecting a negative answer: The gods of the hilltop shrines cannot rescue anyone. Others understand the mountains to be a symbol of the Lord’s strength (",{"href":"?bref=Ps.95.4","r":"Ps.95.4","rawR":"Ps.95.4","sourceRefs":[{"raw":"Ps.95.4","value":"Ps.95.4"}],"t":"ref","v":"Ps 95:4"},"). In that case, the question would be interpreted literally (",{"c":["Where does my help come from?"],"sourceClass":"ital","t":"span"},"), with the answer given in the next verse"],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.121.1","refs":[{"book":"PSA","endChapter":121,"endVerse":1,"startChapter":121,"startVerse":1}],"sourceAttributes":{"name":"Ps.121.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[121],"sourceItemFragmentSha256":"2186885489e9b60578ed67a3998db3410ca6d4f53f0bc98f380df9c303db0efc","sourceItemName":"Ps.121.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7305,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.121.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.121.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.121.4-6","r":"Ps.121.4-6","rawR":"Ps.121.4-6","sourceRefs":[{"raw":"Ps.121.4-6","value":"Ps.121.4-6"}],"t":"ref","v":"121:4-6"}],"sourceClass":"sn-ref","t":"span"}," The Creator (",{"href":"?bref=Ps.121.2","r":"Ps.121.2","rawR":"Ps.121.2","sourceRefs":[{"raw":"Ps.121.2","value":"Ps.121.2"}],"t":"ref","v":"121:2"},") is the guardian of Israel. • God ",{"c":["stands beside"],"sourceClass":"sn-excerpt","t":"span"}," Israel, supporting and caring for the godly (see ",{"href":"?bref=Ps.16.7-8","r":"Ps.16.7-8","rawR":"Ps.16.7-8","sourceRefs":[{"raw":"Ps.16.7-8","value":"Ps.16.7-8"}],"t":"ref","v":"16:7-8"},"). • Both the ",{"c":["sun"],"sourceClass":"sn-excerpt","t":"span"}," and the ",{"c":["moon"],"sourceClass":"sn-excerpt","t":"span"}," were regarded as deities in the ancient Near East, but the Creator limits their power. They, too, praise the Lord (",{"href":"?bref=Ps.148.3","r":"Ps.148.3","rawR":"Ps.148.3","sourceRefs":[{"raw":"Ps.148.3","value":"Ps.148.3"}],"t":"ref","v":"148:3"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.121.4-6","refs":[{"book":"PSA","endChapter":121,"endVerse":6,"startChapter":121,"startVerse":4}],"sourceAttributes":{"name":"Ps.121.4-6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[121],"sourceItemFragmentSha256":"81980deb72b9627cdb4c897b125212be1a5f47471ab82d3c5a9249c558feaa4f","sourceItemName":"Ps.121.4-6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7306,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.121.4-6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.121.4-6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.121.4","r":"Ps.121.4","rawR":"Ps.121.4","sourceRefs":[{"raw":"Ps.121.4","value":"Ps.121.4"}],"t":"ref","v":"121:4"}],"sourceClass":"sn-ref","t":"span"}," God ",{"c":["watches over"],"sourceClass":"sn-excerpt","t":"span"}," his own, even and especially when they face many troubles (",{"href":"?bref=Ps.12.5","r":"Ps.12.5","rawR":"Ps.12.5","sourceRefs":[{"raw":"Ps.12.5","value":"Ps.12.5"}],"t":"ref","v":"12:5"},", ",{"href":"?bref=Ps.12.7","r":"Ps.12.7","rawR":"Ps.12.7","sourceRefs":[{"raw":"Ps.12.7","value":"Ps.12.7"}],"t":"ref","v":"7"},"; ",{"href":"?bref=Ps.69.29","r":"Ps.69.29","rawR":"Ps.69.29","sourceRefs":[{"raw":"Ps.69.29","value":"Ps.69.29"}],"t":"ref","v":"69:29"},"; ",{"href":"?bref=Ps.91.14","r":"Ps.91.14","rawR":"Ps.91.14","sourceRefs":[{"raw":"Ps.91.14","value":"Ps.91.14"}],"t":"ref","v":"91:14"},"; ",{"href":"?bref=Ps.146.9","r":"Ps.146.9","rawR":"Ps.146.9","sourceRefs":[{"raw":"Ps.146.9","value":"Ps.146.9"}],"t":"ref","v":"146:9"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.121.4","refs":[{"book":"PSA","endChapter":121,"endVerse":4,"startChapter":121,"startVerse":4}],"sourceAttributes":{"name":"Ps.12