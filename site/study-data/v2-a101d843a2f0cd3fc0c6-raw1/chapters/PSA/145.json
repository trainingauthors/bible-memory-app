ue":"Ps.145.10-13"}],"t":"ref","v":"10-13"},"). God’s actions reveal his royal qualities (",{"href":"?bref=Ps.145.4-7","r":"Ps.145.4-7","rawR":"Ps.145.4-7","sourceRefs":[{"raw":"Ps.145.4-7","value":"Ps.145.4-7"}],"t":"ref","v":"145:4-7"},"). He cares for all creatures (",{"href":"?bref=Ps.145.14-17","r":"Ps.145.14-17","rawR":"Ps.145.14-17","sourceRefs":[{"raw":"Ps.145.14-17","value":"Ps.145.14-17"}],"t":"ref","v":"145:14-17"},") and for those who fear him (",{"href":"?bref=Ps.145.18-20","r":"Ps.145.18-20","rawR":"Ps.145.18-20","sourceRefs":[{"raw":"Ps.145.18-20","value":"Ps.145.18-20"}],"t":"ref","v":"145:18-20"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.145.1-21","refs":[{"book":"PSA","endChapter":145,"endVerse":21,"startChapter":145,"startVerse":1}],"sourceAttributes":{"name":"Ps.145.1-21","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[145],"sourceItemFragmentSha256":"a1d1daf404dfb480b149f59baefe80649dc347c9a11a1d290a7b9ae3cfec0176","sourceItemName":"Ps.145.1-21","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7442,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.145.1-21","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.145.1-21","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.145.1-3","r":"Ps.145.1-3","rawR":"Ps.145.1-3","sourceRefs":[{"raw":"Ps.145.1-3","value":"Ps.145.1-3"}],"t":"ref","v":"145:1-3"}],"sourceClass":"sn-ref","t":"span"}," The psalmist praises God, the Great King who reigns over all other rulers (see ",{"href":"?bref=Ps.47.2","r":"Ps.47.2","rawR":"Ps.47.2","sourceRefs":[{"raw":"Ps.47.2","value":"Ps.47.2"}],"t":"ref","v":"47:2"},")."],"sourceClass":"sn-text","t":