sa.40.6-8"}],"t":"ref","v":"Isa 40:6-8"},"). He had expected a wicked life to have those qualities (see ",{"href":"?bref=Ps.37.2","r":"Ps.37.2","rawR":"Ps.37.2","sourceRefs":[{"raw":"Ps.37.2","value":"Ps.37.2"}],"t":"ref","v":"Pss 37:2"},", ",{"href":"?bref=Ps.37.20","r":"Ps.37.20","rawR":"Ps.37.20","sourceRefs":[{"raw":"Ps.37.20","value":"Ps.37.20"}],"t":"ref","v":"20"},"; ",{"href":"?bref=Ps.103.15-16","r":"Ps.103.15-16","rawR":"Ps.103.15-16","sourceRefs":[{"raw":"Ps.103.15-16","value":"Ps.103.15-16"}],"t":"ref","v":"103:15-16"},"), but now whether a person is godly or not seems to be irrelevant."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.39.4-6","refs":[{"book":"PSA","endChapter":39,"endVerse":6,"startChapter":39,"startVerse":4}],"sourceAttributes":{"name":"Ps.39.4-6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[39],"sourceItemFragmentSha256":"c08e28ca4573a44f3818eec5de9448d3fbb099bac1a49ce00603f837c1e47b19","sourceItemName":"Ps.39.4-6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6403,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.39.4-6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.39.4-6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.39.4-5","r":"Ps.39.4-5","rawR":"Ps.39.4-5","sourceRefs":[{"raw":"Ps.39.4-5","value":"Ps.39.4-5"}],"t":"ref","v":"39:4-5"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["how fleeting my life is:"],"sourceClass":"sn-excerpt","t":"span"}," This perspective comes out of suffering (see ",{"href":"?bref=Ps.78.39","r":"Ps.78.39","rawR":"Ps.78.39","sourceRefs":[{"raw":"Ps.78.39","value":"Ps.78.39"}],"t":"ref","v":"78:39"},"; ",{"href":"?bref=Ps.89.47-48","r":"Ps.89.47-48","rawR":"Ps.89.47-48","sourceRefs":[{"raw":"Ps.89.47-48","value":"Ps.89.47-48"}],"t":"ref","v":"89:47-48"},"; ",{"href":"?bref=Ps.90.3-10","r":"Ps.90.3-10","rawR":"Ps.90.3-10","sourceRefs":[{"raw":"Ps.90.3-10","value":"Ps.90.3-10"}],"t":"ref","v":"90:3-10"},"). The human ",{"c":["lifetime"],"sourceClass":"sn-excerpt","t":"span"}," is but a ",{"c":["moment"],"sourceClass":"sn-excerpt","t":"span"}," to God (",{"href":"?bref=Ps.90.4","r":"Ps.90.4","rawR":"Ps.90.4","sourceRefs":[{"raw":"Ps.90.4","value":"Ps.90.4"}],"t":"ref","v":"90:4"},"), as temporary as a ",{"c":["breath"],"sourceClass":"sn-excerpt","t":"span"}," (see ",{"href":"?bref=Ps.39.11","r":"Ps.39.11","rawR":"Ps.39.11","sourceRefs":[{"raw":"Ps.39.11","value":"Ps.39.11"}],"t":"ref","v":"39:11"},"; ",{"href":"?bref=Ps.144.4","r":"Ps.144.4","rawR":"Ps.144.4","sourceRefs":[{"raw":"Ps.144.4","value":"Ps.144.4"}],"t":"ref","v":"144:4"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.39.4-5","refs":[{"book":"PSA","endChapter":39,"endVerse":5,"startChapter":39,"startVerse":4}],"sourceAttributes":{"name":"Ps.39.4-5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[39],"sourceItemFragmentSha256":"924fafb3da8438f878024a959b154c64dded92ec87c2621ba5743bbb56d5d5cf","sourceItemName":"Ps.39.4-5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6404,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.39.4-5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.39.4-5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.39.8","r":"Ps.39.8","rawR":"Ps.39.8","sourceRefs":[{"raw":"Ps.39.8","value":"Ps.39.8"}],"t":"ref","v":"39:8"}],"sourceClass":"sn-ref","t":"span"}," The idea that ",{"c":["rebellion"],"sourceClass":"sn-excerpt","t":"span"}," brings on suffering is a common thread in ",{"href":"?bref=Ps.32.1-11","r":"Ps.32.1-11","rawR":"Ps.32.1-11","sourceRefs":[{"raw":"Ps.32.1-11","value":"Ps.32.1-11"}],"t":"ref","v":"Pss 32"},", ",{"href":"?bref=Ps.38.1-41.13","r":"Ps.38.1-41.13","rawR":"Ps.38.1-41.13","sourceRefs":[{"raw":"Ps.38.1-41.13","value":"Ps.38.1-41.13"}],"t":"ref","v":"38–41"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.39.8","refs":[{"book":"PSA","endChapter":39,"endVerse":8,"startChapter":39,"startVerse":8}],"sourceAttributes":{"name":"Ps.39.8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[39],"sourceItemFragmentSha256":"5aac696aa41ab8fe493c440e8e77c76fd86f8b7a0214b3f8630d19eeac799100","sourceItemName":"Ps.39.8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6405,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.39.8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.39.8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.39.9-11","r":"Ps.39.9-11","rawR":"Ps.39.9-11","sourceRefs":[{"raw":"Ps.39.9-11","value":"Ps.39.9-11"}],"t":"ref","v":"39:9-11"}],"sourceClass":"sn-ref","t":"span"}," The psalmist links suffering with God’s ",{"c":["discipline"],"sourceClass":"sn-excerpt","t":"span"},", assuming that it is ",{"c":["punishment"],"sourceClass":"sn-excerpt","t":"span"}," for his sin."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.39.9-11","refs":[{"book":"PSA","endChapter":39,"endVerse":11,"startChapter":39,"startVerse":9}],"sourceAttributes":{"name":"Ps.39.9-11","product":"TyndaleOpenStudyNotes","type