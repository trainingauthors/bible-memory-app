urceClass":"sn-ref","t":"span"}," ",{"c":["Meshech"],"sourceClass":"sn-excerpt","t":"span"}," was a Japhethite territory far to the north of Canaan. ",{"c":["Kedar"],"sourceClass":"sn-excerpt","t":"span"}," was an Ishmaelite territory in Arabia. Violent people lived in both locations. Meshech was the home of a famous slave trade (",{"href":"?bref=Ezek.27.13","r":"Ezek.27.13","rawR":"Ezek.27.13","sourceRefs":[{"raw":"Ezek.27.13","value":"Ezek.27.13"}],"t":"ref","v":"Ezek 27:13"},"; cp. ",{"href":"?bref=Exod.21.16","r":"Exod.21.16","rawR":"Exod.21.16","sourceRefs":[{"raw":"Exod.21.16","value":"Exod.21.16"}],"t":"ref","v":"Exod 21:16"},") and Kedar of renowned warriors (",{"href":"?bref=Isa.21.16-17","r":"Isa.21.16-17","rawR":"Isa.21.16-17","sourceRefs":[{"raw":"Isa.21.16-17","value":"Isa.21.16-17"}],"t":"ref","v":"Isa 21:16-17"},"). These places can be understood as representative of the apostate, violent land where the psalmist suffered."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.120.5","refs":[{"book":"PSA","endChapter":120,"endVerse":5,"startChapter":120,"startVerse":5}],"sourceAttributes":{"name":"Ps.120.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[120],"sourceItemFragmentSha256":"bf494197817bf6f5f22b1561777cdf7847180b9538479ae6ca12e71bbdf4d06b","sourceItemName":"Ps.120.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7302,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.120.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.120.5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.120.6-7","r":"Ps.120.6-7","rawR":"Ps.120.6-7","sourceRefs":[{"raw":"Ps.120.6-7","value":"Ps.120.6-7