,"t":"span"}," This phrase might refer to the ",{"c":["land"],"sourceClass":"sn-excerpt","t":"span"},", the ",{"c":["Temple"],"sourceClass":"sn-excerpt","t":"span"}," (see ",{"href":"?bref=Ps.61.5","r":"Ps.61.5","rawR":"Ps.61.5","sourceRefs":[{"raw":"Ps.61.5","value":"Ps.61.5"}],"t":"ref","v":"61:5"},"), or the people (see ",{"href":"?bref=Ps.79.2","r":"Ps.79.2","rawR":"Ps.79.2","sourceRefs":[{"raw":"Ps.79.2","value":"Ps.79.2"}],"t":"ref","v":"79:2"},"; ",{"href":"?bref=Ps.78.71","r":"Ps.78.71","rawR":"Ps.78.71","sourceRefs":[{"raw":"Ps.78.71","value":"Ps.78.71"}],"t":"ref","v":"78:71"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.79.1","refs":[{"book":"PSA","endChapter":79,"endVerse":1,"startChapter":79,"startVerse":1}],"sourceAttributes":{"name":"Ps.79.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[79],"sourceItemFragmentSha256":"cd1416fdd4cec68d46aec441376aa8ca50fae55154096c385cb547ca9b5afd83","sourceItemName":"Ps.79.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6801,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.79.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.79.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.79.5-8","r":"Ps.79.5-8","rawR":"Ps.79.5-8","sourceRefs":[{"raw":"Ps.79.5-8","value":"Ps.79.5-8"}],"t":"ref","v":"79:5-8"}],"sourceClass":"sn-ref","t":"span"}," The intensity of God’s judgment surprises the people; they cry out in despair for compassion, forgiveness, and relief. Verses ",{"href":"?bref=Ps.6.1-7.17","r":"Ps.6.1-7.17","rawR":"Ps.6.1-7.17","sourceRefs":[{"raw":"Ps.6.1-7.17","value":"Ps.6.1-7.17"}],"t":"ref","v":"6-7"}," are repeated almost verbatim in ",{"href":"?bref=Jer.10.25","r":"Jer.10.25","rawR":"Jer.10.25","sourceRefs":[{"raw":"Jer.10.25","value":"Jer.10.25"}],"t":"ref","v":"Jer 10:25"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.79.5-8","refs":[{"book":"PSA","endChapter":79,"endVerse":8,"startChapter":79,"startVerse":5}],"sourceAttributes":{"name":"Ps.79.5-8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[79],"sourceItemFragmentSha256":"86b7681c0fc726c5120be7fe983cb7a038df2862f64a94ca11e29f2ec3411198","sourceItemName":"Ps.79.5-8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6802,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.79.5-8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.79.5-8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.79.6","r":"Ps.79.6","rawR":"Ps.79.6","sourceRefs":[{"raw":"Ps.79.6","value":"Ps.79.6"}],"t":"ref","v":"79:6"}],"sourceClass":"sn-ref","t":"span"}," The repentant among God’s people ask him to vent his anger not on them but on their wicked and unrepentant enemies."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.79.6","refs":[{"book":"PSA","endChapter":79,"endVerse":6,"startChapter":79,"startVerse":6}],"sourceAttributes":{"name":"Ps.79.6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[79],"sourceItemFragmentSha256":"8548d31b79f70a49e1b056c06883fd6c68d9c2b9b6f3503a12227ee99b9e8646","sourceItemName":"Ps.79.6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6803,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.79.6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.79.6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.79.8","r":"Ps.79.8","rawR":"Ps.79.8","sourceRefs":[{"raw":"Ps.79.8","value":"Ps.79.8"}],"t":"ref","v":"79:8"}],"sourceClass":"sn-ref","t":"span"}," The people’s accumulation of past ",{"c":["sins"],"sourceClass":"sn-excerpt","t":"span"}," contributed to the Exile (",{"href":"?bref=2Kgs.17.7-23","r":"2Kgs.17.7-23","rawR":"2Kgs.17.7-23","sourceRefs":[{"raw":"2Kgs.17.7-23","value":"2Kgs.17.7-23"}],"t":"ref","v":"2 Kgs 17:7-23"},"; ",{"href":"?bref=2Kgs.24.3-4","r":"2Kgs.24.3-4","rawR":"2Kgs.24.3-4","sourceRefs":[{"raw":"2Kgs.24.3-4","value":"2Kgs.24.3-4"}],"t":"ref","v":"24:3-4"},"); however, the people perished because of their own sins (",{"href":"?bref=Jer.31.30","r":"Jer.31.30","rawR":"Jer.31.30","sourceRefs":[{"raw":"Jer.31.30","value":"Jer.31.30"}],"t":"ref","v":"Jer 31:30"},"; ",{"href":"?bref=Ezek.18.20","r":"Ezek.18.20","rawR":"Ezek.18.20","sourceRefs":[{"raw":"Ezek.18.20","value":"Ezek.18.20"}],"t":"ref","v":"Ezek 18:20"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.79.8","refs":[{"book":"PSA","endChapter":79,"endVerse":8,"startChapter":79,"startVerse":8}],"sourceAttributes":{"name":"Ps.79.8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[79],"sourceItemFragmentSha256":"44b1c95b41ab2da9de779051a04f3c425d237b79f75ef007872719d15d76b261","sourceItemName":"Ps.79.8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6804,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.79.8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.79.8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.79.9-11","r":"Ps.79.9-11","rawR":"Ps.79.9-11","sourceRefs":[{"raw":"Ps.79.9-11","value":"Ps.79.9-11"}],"t":"ref","v":"79:9-11"}],"sourceClass":"sn-ref","t":"span"}," The people ask God to rescue them. Although Israel’s sins caused the tragedy, the ",{"c":["pagan nations"],"sourceClass":"sn-excerpt","t":"span"}," must also be held responsible for the bloodshed."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.79.9-11","refs":[{"book":"PSA","endChapter":79,"endVerse":11,"startChapter":79,"startVerse":9}],"sourceAttributes":{"name":"Ps.79.9-11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[79],"sourceItemFragmentSha256":"46662c9c26d59beee86a0de8f2ac9096d0e5ff8f355fe2b06281b7c48090a5ee","sourceItemName":"Ps.79.9-11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6805,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.79.9-11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.79.9-11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.79.12","r":"Ps.79.12","rawR":"Ps.79.12","sourceRefs":[{"raw":"Ps.79.12","value":"Ps.79.12"}],"t":"ref","v":"79:12"}],"sourceClass":"sn-ref","t":"span"}," The Exile resulted in national suffering and in individual searching for the Lord. • ",{"c":["pay back:"],"sourceClass":"sn-excerpt","t":"span"}," See ",{"href":"?bref=Ps.1.6","r":"Ps.1.6","rawR":"Ps.1.6","sourceRefs":[{"raw":"Ps.1.6","value":"Ps.1.6"}],"t":"ref","v":"1:6"},"; ",{"href":"?bref=Ps.94.2","r":"Ps.94.2","ra