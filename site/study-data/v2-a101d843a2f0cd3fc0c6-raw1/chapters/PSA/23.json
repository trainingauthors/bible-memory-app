0.json","title":"Meals, Significance of"},"Music":{"file":"dictionary/e0153531a40025ba8163d173c411943f354522e4d2beb121583465efec5c09a7.json","title":"Music"},"PsalmsBookof":{"file":"dictionary/8701f5dabbe5f1d73c94a8c5c69f9c0f6cf4ece07a1f4dd71ef33b5d7b8a964b.json","title":"Psalms, Book of"},"Shepherd":{"file":"dictionary/ddfeb3f9ede2359d16a9d6b45268a848c6ef31230c85f1aa38b70a889f713f4e.json","title":"Shepherd"}},"dictionaryRelated":[{"id":"Color","title":"Color"},{"id":"Cup","title":"Cup"},{"id":"EzekielBookof","title":"Ezekiel, Book of"},{"id":"GodNamesof","title":"God, Names of"},{"id":"HebrewLanguage","title":"Hebrew Language"},{"id":"Hunting","title":"Hunting"},{"id":"MealsSignificanceof","title":"Meals, Significance of"},{"id":"Music","title":"Music"},{"id":"PsalmsBookof","title":"Psalms, Book of"},{"id":"Shepherd","title":"Shepherd"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"David","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[{"anchorIndex":53,"href":"?bref=Ps.1.1-41.13","rawReference":"Ps.1.1-41.13"}],"ruleId":"David::David::reviewed_unambiguous_name","sourceHeadwordId":"David"},"text":"A Psalm of David. The LORD is my shepherd; I shall not want.","verse":1}],"id":"David","label":"David","matchReviews":[{"ruleId":"David::David::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"David","term":"David"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"David","sourceTitle":"David"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"A Psalm of David. The LORD is my shepherd; I shall not want.","verse":1},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Surely goodness and mercy will follow me all the days of my life, and I will dwell in the house of the LORD forever.","verse":6}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":["The Shepherd"],"sourceClass":"theme-title","t":"h"},{"c":["In the Jewish economy, the shepherd who tended a flock of sheep or goats held a position of importance. Shepherding was fundamental to ancient Near Eastern society. The shepherd’s task was to lead the flock out of the fold each morning (",{"href":"?bref=John.10.2-4","r":"John.10.2-4","rawR":"John.10.2-4","sourceRefs":[{"raw":"John.10.2-4","value":"John.10.2-4"}],"t":"ref","v":"John 10:2-4"},"), to find grass and water for the flock, to protect them from wild animals (",{"href":"?bref=Amos.3.12","r":"Amos.3.12","rawR":"Amos.3.12","sourceRefs":[{"raw":"Amos.3.12","value":"Amos.3.12"}],"t":"ref","v":"Amos 3:12"},"), to look for and restore those that strayed (",{"href":"?bref=Ezek.34.8","r":"Ezek.34.8","rawR":"Ezek.34.8","sourceRefs":[{"raw":"Ezek.34.8","value":"Ezek.34.8"}],"t":"ref","v":"Ezek 34:8"},"; ",{"href":"?bref=Matt.18.12","r":"Matt.18.12","rawR":"Matt.18.12","sourceRefs":[{"raw":"Matt.18.12","value":"Matt.18.12"}],"t":"ref","v":"Matt 18:12"},"), and to return the flock to the fold every evening."],"sourceClass":"theme-body-fl","t":"p"},{"c":["The word ",{"c":["shepherd"],"sourceClass":"ital","t":"span"}," became a common term for a ruler. The kings of Assyria, Babylon, and Egypt were often referred to as shepherds who protected their people. This metaphorical use is also prevalent in the Old Testament (",{"href":"?bref=Num.27.17","r":"Num.27.17","rawR":"Num.27.17","sourceRefs":[{"raw":"Num.27.17","value":"Num.27.17"}],"t":"ref","v":"Num 27:17"},"; ",{"href":"?bref=1Kgs.22.17","r":"1Kgs.22.17","rawR":"1Kgs.22.17","sourceRefs":[{"raw":"1Kgs.22.17","value":"1Kgs.22.17"}],"t":"ref","v":"1 Kgs 22:17"},"; ",{"href":"?bref=Jer.10.21","r":"Jer.10.21","rawR":"Jer.10.21","sourceRefs":[{"raw":"Jer.10.21","value":"Jer.10.21"}],"t":"ref","v":"Jer 10:21"},"; ",{"href":"?bref=Jer.23.1-2","r":"Jer.23.1-2","rawR":"Jer.23.1-2","sourceRefs":[{"raw":"Jer.23.1-2","value":"Jer.23.1-2"}],"t":"ref","v":"23:1-2"},"; ",{"href":"?bref=Ezek.34.1-10","r":"Ezek.34.1-10","rawR":"Ezek.34.1-10","sourceRefs":[{"raw":"Ezek.34.1-10","value":"Ezek.34.1-10"}],"t":"ref","v":"Ezek 34:1-10"},")."],"sourceClass":"theme-body","t":"p"},{"c":["In the Old Testament, God is pictured as the Shepherd of Israel, concerned for every aspect of his people’s welfare (",{"href":"?bref=Gen.49.24","r":"Gen.49.24","rawR":"Gen.49.24","sourceRefs":[{"raw":"Gen.49.24","value":"Gen.49.24"}],"t":"ref","v":"Gen 49:24"},"; ",{"href":"?bref=Ps.23.1","r":"Ps.23.1","rawR":"Ps.23.1","sourceRefs":[{"raw":"Ps.23.1","value":"Ps.23.1"}],"t":"ref","v":"Pss 23:1"},"; ",{"href":"?bref=Ps.80.1","r":"Ps.80.1","rawR":"Ps.80.1","sourceRefs":[{"raw":"Ps.80.1","value":"Ps.80.1"}],"t":"ref","v":"80:1"},"; ",{"href":"?bref=Isa.40.11","r":"Isa.40.11","rawR":"Isa.40.11","sourceRefs":[{"raw":"Isa.40.11","value":"Isa.40.11"}],"t":"ref","v":"Isa 40:11"},"). God himself would provide for his flock (",{"href":"?bref=Jer.23.3","r":"Jer.23.3","rawR":"Jer.23.3","sourceRefs":[{"raw":"Jer.23.3","value":"Jer.23.3"}],"t":"ref","v":"Jer 23:3"},"; ",{"href":"?bref=Jer.31.10","r":"Jer.31.10","rawR":"Jer.31.10","sourceRefs":[{"raw":"Jer.31.10","value":"Jer.31.10"}],"t":"ref","v":"31:10"},"; ",{"href":"?bref=Ezek.34.11-22","r":"Ezek.34.11-22","rawR":"Ezek.34.11-22","sourceRefs":[{"raw":"Ezek.34.11-22","value":"Ezek.34.11-22"}],"t":"ref","v":"Ezek 34:11-22"},"), and he promised to provide faithful shepherds who showed concern for his people (",{"href":"?bref=Jer.3.15","r":"Jer.3.15","rawR":"Jer.3.15","sourceRefs":[{"raw":"Jer.3.15","value":"Jer.3.15"}],"t":"ref","v":"Jer 3:15"},"; ",{"href":"?bref=Jer.23.4","r":"Jer.23.4","rawR":"Jer.23.4","sourceRefs":[{"raw":"Jer.23.4","value":"Jer.23.4"}],"t":"ref","v":"23:4"},"). When Israel’s early leaders proved to be unfaithful shepherds, God intervened and appointed his servant David as a faithful shepherd to lead them. He later promised that he would establish David’s offspring as shepherd over them (see ",{"href":"?bref=Ezek.34.23-24","r":"Ezek.34.23-24","rawR":"Ezek.34.23-24","sourceRefs":[{"raw":"Ezek.34.23-24","value":"Ezek.34.23-24"}],"t":"ref","v":"Ezek 34:23-24"},"). By the time of the prophet Jeremiah, ",{"c":["shepherd"],"sourceClass":"ital","t":"span"}," began to be used with reference to the coming Messiah."],"sourceClass":"theme-body","t":"p"},{"c":["In the New Testament, Jesus referred to himself as the Shepherd (",{"href":"?bref=Matt.25.31-33","r":"Matt.25.31-33","rawR":"Matt.25.31-33","sourceRefs":[{"raw":"Matt.25.31-33","value":"Matt.25.31-33"}],"t":"ref","v":"Matt 25:31-33"},"; ",{"href":"?bref=Mark.14.27","r":"Mark.14.27","rawR":"Mark.14.27","sourceRefs":[{"raw":"Mark.14.27","value":"Mark.14.27"}],"t":"ref","v":"Mark 14:27"},"; ",{"href":"?bref=John.10.1-30","r":"John.10.1-30","rawR":"John.10.1-30","sourceRefs":[{"raw":"John.10.1-30","value":"John.10.1-30"}],"t":"ref","v":"John 10:1-30"},"). He is the Good Shepherd who gives his life for the sheep (",{"href":"?bref=John.10.11-18","r":"John.10.11-18","rawR":"John.10.11-18","sourceRefs":[{"raw":"John.10.11-18","value":"John.10.11-18"}],"t":"ref","v":"John 10:11-18"},"; see also ",{"href":"?bref=Heb.13.20","r":"Heb.13.20","rawR":"Heb.13.20","sourceRefs":[{"raw":"Heb.13.20","value":"Heb.13.20"}],"t":"ref","v":"Heb 13:20"},")."],"sourceClass":"theme-body","t":"p"},{"c":["The leaders of the church are also called shepherds (",{"href":"?bref=Eph.4.11","r":"Eph.4.11","rawR":"Eph.4.11","sourceRefs":[{"raw":"Eph.4.11","value":"Eph.4.11"}],"t":"ref","v":"Eph 4:11"},", translated “pastors”)—God gives them to the church to care for his people as a shepherd does their sheep, leading and teaching them in the ways of God. They are to be faithful shepherds until the Chief Shepherd, Jesus Christ, appears to lead his people directly (",{"href":"?bref=1Pet.5.1-4","r":"1Pet.5.1-4","rawR":"1Pet.5.1-4","sourceRefs":[{"raw":"1Pet.5.1-4","value":"1Pet.5.1-4"}],"t":"ref","v":"1 Pet 5:1-4"},")."],"sourceClass":"theme-body","t":"p"},{"c":["Passages for Further Study"],"sourceClass":"theme-refs-title","t":"h"},{"c":[{"href":"?bref=Gen.29.1-10","r":"Gen.29.1-10","rawR":"Gen.29.1-10","sourceRefs":[{"raw":"Gen.29.1-10","value":"Gen.29.1-10"}],"t":"ref","v":"Gen 29:1-10"},"; ",{"href":"?bref=Num.27.16-18","r":"Num.27.16-18","rawR":"Num.27.16-18","sourceRefs":[{"raw":"Num.27.16-18","value":"Num.27.16-18"}],"t":"ref","v":"Num 27:16-18"},"; ",{"href":"?bref=2Sam.7.7","r":"2Sam.7.7","rawR":"2Sam.7.7","sourceRefs":[{"raw":"2Sam.7.7","value":"2Sam.7.7"}],"t":"ref","v":"2 Sam 7:7"},"; ",{"href":"?bref=1Kgs.22.17","r":"1Kgs.22.17","rawR":"1Kgs.22.17","sourceRefs":[{"raw":"1Kgs.22.17","value":"1Kgs.22.17"}],"t":"ref","v":"1 Kgs 22:17"},"; ",{"href":"?bref=1Chr.11.2","r":"1Chr.11.2","rawR":"1Chr.11.2","sourceRefs":[{"raw":"1Chr.11.2","value":"1Chr.11.2"}],"t":"ref","v":"1 Chr 11:2"},"; ",{"href":"?bref=Ps.23.1-6","r":"Ps.23.1-6","rawR":"Ps.23.1-6","sourceRefs":[{"raw":"Ps.23.1-6","value":"Ps.23.1-6"}],"t":"ref","v":"Pss 23:1-6"},"; ",{"href":"?bref=Ps.77.20","r":"Ps.77.20","rawR":"Ps.77.20","sourceRefs":[{"raw":"Ps.77.20","value":"Ps.77.20"}],"t":"ref","v":"77:20"},"; ",{"href":"?bref=Ps.80.1","r":"Ps.80.1","rawR":"Ps.80.1","sourceRefs":[{"raw":"Ps.80.1","value":"Ps.80.1"}],"t":"ref","v":"80:1"},"; ",{"href":"?bref=Isa.40.11","r":"Isa.40.11","rawR":"Isa.40.11","sourceRefs":[{"raw":"Isa.40.11","value":"Isa.40.11"}],"t":"ref","v":"Isa 40:11"},"; ",{"href":"?bref=Isa.44.28","r":"Isa.44.28","rawR":"Isa.44.28","sourceRefs":[{"raw":"Isa.44.28","value":"Isa.44.28"}],"t":"ref","v":"44:28"},"; ",{"href":"?bref=Isa.56.10-11","r":"Isa.56.10-11","rawR":"Isa.56.10-11","sourceRefs":[{"raw":"Isa.56.10-11","value":"Isa.56.10-11"}],"t":"ref","v":"56:10-11"},"; ",{"href":"?bref=Jer.10.21","r":"Jer.10.21","rawR":"Jer.10.21","sourceRefs":[{"raw":"Jer.10.21","value":"Jer.10.21"}],"t":"ref","v":"Jer 10:21"},"; ",{"href":"?bref=Jer.25.34-36","r":"Jer.25.34-36","rawR":"Jer.25.34-36","sourceRefs":[{"raw":"Jer.25.34-36","value":"Jer.25.34-36"}],"t":"ref","v":"25:34-36"},"; ",{"href":"?bref=Ezek.34.1-31","r":"Ezek.34.1-31","rawR":"Ezek.34.1-31","sourceRefs":[{"raw":"Ezek.34.1-31","value":"Ezek.34.1-31"}],"t":"ref","v":"Ezek 34:1-31"},"; ",{"href":"?bref=Mic.7.14","r":"Mic.7.14","rawR":"Mic.7.14","sourceRefs":[{"raw":"Mic.7.14","value":"Mic.7.14"}],"t":"ref","v":"Mic 7:14"},"; ",{"href":"?bref=Zech.10.2-3","r":"Zech.10.2-3","rawR":"Zech.10.2-3","sourceRefs":[{"raw":"Zech.10.2-3","value":"Zech.10.2-3"}],"t":"ref","v":"Zech 10:2b-3"},"; ",{"href":"?bref=Zech.11.4-17","r":"Zech.11.4-17","rawR":"Zech.11.4-17","sourceRefs":[{"raw":"Zech.11.4-17","value":"Zech.11.4-17"}],"t":"ref","v":"11:4-17"},"; ",{"href":"?bref=Zech.13.7","r":"Zech.13.7","rawR":"Zech.13.7","sourceRefs":[{"raw":"Zech.13.7","value":"Zech.13.7"}],"t":"ref","v":"13:7"},"; ",{"href":"?bref=Matt.2.6","r":"Matt.2.6","rawR":"Matt.2.6","sourceRefs":[{"raw":"Matt.2.6","value":"Matt.2.6"}],"t":"ref","v":"Matt 2:6"},"; ",{"href":"?bref=Matt.18.12-14","r":"Matt.18.12-14","rawR":"Matt.18.12-14","sourceRefs":[{"raw":"Matt.18.12-14","value":"Matt.18.12-14"}],"t":"ref","v":"18:12-14"},"; ",{"href":"?bref=Matt.26.31","r":"Matt.26.31","rawR":"Matt.26.31","sourceRefs":[{"raw":"Matt.26.31","value":"Matt.26.31"}],"t":"ref","v":"26:31"},"; ",{"href":"?bref=John.10.1-16","r":"John.10.1-16","rawR":"John.10.1-16","sourceRefs":[{"raw":"John.10.1-16","value":"John.10.1-16"}],"t":"ref","v":"John 10:1-16"},"; ",{"href":"?bref=1Pet.2.25","r":"1Pet.2.25","rawR":"1Pet.2.25","sourceRefs":[{"raw":"1Pet.2.25","value":"1Pet.2.25"}],"t":"ref","v":"1 Pet 2:25"},"; ",{"href":"?bref=1Pet.5.1-4","r":"1Pet.5.1-4","rawR":"1Pet.5.1-4","sourceRefs":[{"raw":"1Pet.5.1-4","value":"1Pet.5.1-4"}],"t":"ref","v":"5:1-4"},"; ",{"href":"?bref=Jude.1.12","r":"Jude.1.12","rawR":"Jude.1.12","sourceRefs":[{"raw":"Jude.1.12","value":"Jude.1.12"}],"t":"ref","v":"Jude 1:12"},"; ",{"href":"?bref=Rev.7.17","r":"Rev.7.17","rawR":"Rev.7.17","sourceRefs":[{"raw":"Rev.7.17","value":"Rev.7.17"}],"t":"ref","v":"Rev 7:17"}],"sourceClass":"theme-refs","t":"p"}],"id":"ThemeNote:TheShepherd","refs":[{"book":"PSA","endChapter":23,"endVerse":6,"startChapter":23,"startVerse":1}],"sourceAttributes":{"name":"TheShepherd","product":"TyndaleOpenStudyNotes","typename":"ThemeNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[23],"sourceItemFragmentSha256":"0ae4f1082baa4ee8c52e282ee47c5a9d9e75b6b30b24313568d9cbcfdccf5d3b","sourceItemName":"TheShepherd","sourceMember":"Tyndale Open Study Notes/ThemeNotes.xml","sourceOrder":111,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.23.1-6","sourceRelease":"1.25","sourceTitleExact":"The Shepherd","supplementPointersNotIncludedAsContent":[],"title":"The Shepherd","type":"ThemeNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.20.1-24.10","r":"Ps.20.1-24.10","rawR":"Ps.20.1-24.10","sourceRefs":[{"raw":"Ps.20.1-24.10","value":"Ps.20.1-24.10"}],"t":"ref","v":"Pss 20–24"}],"sourceClass":"sn-ref","t":"span"}," This sequence of psalms expresses the experience of moving from confidence and commitment (",{"href":"?bref=Ps.20.1-21.13","r":"Ps.20.1-21.13","rawR":"Ps.20.1-21.13","sourceRefs":[{"raw":"Ps.20.1-21.13","value":"Ps.20.1-21.13"}],"t":"ref","v":"Pss 20–21"},"), through anguish and abandonment (",{"href":"?bref=Ps.22.1-31","r":"Ps.22.1-31","rawR":"Ps.22.1-31","sourceRefs":[{"raw":"Ps.22.1-31","value":"Ps.22.1-31"}],"t":"ref","v":"Ps 22"},"), and finally to comfort, insight, and hope (",{"href":"?bref=Ps.23.1-24.10","r":"Ps.23.1-24.10","rawR":"Ps.23.1-24.10","sourceRefs":[{"raw":"Ps.23.1-24.10","value":"Ps.23.1-24.10"}],"t":"ref","v":"Pss 23–24"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.20.1-24.10","refs":[{"book":"PSA","endChapter":24,"endVerse":10,"startChapter":20,"startVerse":1}],"sourceAttributes":{"name":"Ps.20.1-24.10","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[20,21,22,23,24],"sourceItemFragmentSha256":"5df1d0f4875f3ea1d1c2cf769acf98707968ff9dc4eb2fb1123634b85c59c7a6","sourceItemName":"Ps.20.1-24.10","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6158,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.20.1-24.10","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.20.1-24.10","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.23.1-28.9","r":"Ps.23.1-28.9","rawR":"Ps.23.1-28.9","sourceRefs":[{"raw":"Ps.23.1-28.9","value":"Ps.23.1-28.9"}],"t":"ref","v":"Pss 23–28"}],"sourceClass":"sn-ref","t":"span"}," These psalms develop the importance of integrity (",{"href":"?bref=Ps.25.4-7","r":"Ps.25.4-7","rawR":"Ps.25.4-7","sourceRefs":[{"raw":"Ps.25.4-7","value":"Ps.25.4-7"}],"t":"ref","v":"25:4-7"},", ",{"href":"?bref=Ps.25.12-14","r":"Ps.25.12-14","rawR":"Ps.25.12-14","sourceRefs":[{"raw":"Ps.25.12-14","value":"Ps.25.12-14"}],"t":"ref","v":"12-14"},", ",{"href":"?bref=Ps.25.21","r":"Ps.25.21","rawR":"Ps.25.21","sourceRefs":[{"raw":"Ps.25.21","value":"Ps.25.21"}],"t":"ref","v":"21"},"; ",{"href":"?bref=Ps.26.6","r":"Ps.26.6","rawR":"Ps.26.6","sourceRefs":[{"raw":"Ps.26.6","value":"Ps.26.6"}],"t":"ref","v":"26:6"},", ",{"href":"?bref=Ps.26.11","r":"Ps.26.11","rawR":"Ps.26.11","sourceRefs":[{"raw":"Ps.26.11","value":"Ps.26.11"}],"t":"ref","v":"11"},"; ",{"href":"?bref=Ps.27.7-12","r":"Ps.27.7-12","rawR":"Ps.27.7-12","sourceRefs":[{"raw":"Ps.27.7-12","value":"Ps.27.7-12"}],"t":"ref","v":"27:7-12"},"), God’s shepherding care (",{"href":"?bref=Ps.23.1","r":"Ps.23.1","rawR":"Ps.23.1","sourceRefs":[{"raw":"Ps.23.1","value":"Ps.23.1"}],"t":"ref","v":"23:1"},"; ",{"href":"?bref=Ps.28.9","r":"Ps.28.9","rawR":"Ps.28.9","sourceRefs":[{"raw":"Ps.28.9","value":"Ps.28.9"}],"t":"ref","v":"28:9"},"), God’s guidance (",{"href":"?bref=Ps.23.2-3","r":"Ps.23.2-3","rawR":"Ps.23.2-3","sourceRefs":[{"raw":"Ps.23.2-3","value":"Ps.23.2-3"}],"t":"ref","v":"23:2-3"},"; ",{"href":"?bref=Ps.25.5","r":"Ps.25.5","rawR":"Ps.25.5","sourceRefs":[{"raw":"Ps.25.5","value":"Ps.25.5"}],"t":"ref","v":"25:5"},"; ",{"href":"?bref=Ps.27.11","r":"Ps.27.11","rawR":"Ps.27.11","sourceRefs":[{"raw":"Ps.27.11","value":"Ps.27.11"}],"t":"ref","v":"27:11"},"), God’s goodness (",{"href":"?bref=Ps.23.6","r":"Ps.23.6","rawR":"Ps.23.6","sourceRefs":[{"raw":"Ps.23.6","value":"Ps.23.6"}],"t":"ref","v":"23:6"},"; ",{"href":"?bref=Ps.25.7-8","r":"Ps.25.7-8","rawR":"Ps.25.7-8","sourceRefs":[{"raw":"Ps.25.7-8","value":"Ps.25.7-8"}],"t":"ref","v":"25:7-8"},"; ",{"href":"?bref=Ps.27.13","r":"Ps.27.13","rawR":"Ps.27.13","sourceRefs":[{"raw":"Ps.27.13","value":"Ps.27.13"}],"t":"ref","v":"27:13"},"), and living in his house (",{"href":"?bref=Ps.23.6","r":"Ps.23.6","rawR":"Ps.23.6","sourceRefs":[{"raw":"Ps.23.6","value":"Ps.23.6"}],"t":"ref","v":"23:6"},"; ",{"href":"?bref=Ps.26.8","r":"Ps.26.8","rawR":"Ps.26.8","sourceRefs":[{"raw":"Ps.26.8","value":"Ps.26.8"}],"t":"ref","v":"26:8"},"; ",{"href":"?bref=Ps.27.4","r":"Ps.27.4","rawR":"Ps.27.4","sourceRefs":[{"raw":"Ps.27.4","value":"Ps.27.4"}],"t":"ref","v":"27:4"},", ",{"href":"?bref=Ps.27.8","r":"Ps.27.8","rawR":"Ps.27.8","sourceRefs":[{"raw":"Ps.27.8","value":"Ps.27.8"}],"t":"ref","v":"8"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.23.1-28.9","refs":[{"book":"PSA","endChapter":28,"endVerse":9,"startChapter":23,"startVerse":1}],"sourceAttributes":{"name":"Ps.23.1-28.9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[23,24,25,26,27,28],"sourceItemFragmentSha256":"3d421a5bd98a2c78ba9a5046fb3b46dfd76fdde16fe27ca0acb4bdfa4aaec79b","sourceItemName":"Ps.23.1-28.9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6207,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.23.1-28.9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.23.1-28.9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.23.1-6","r":"Ps.23.1-6","rawR":"Ps.23.1-6","sourceRefs":[{"raw":"Ps.23.1-6","value":"Ps.23.1-6"}],"t":"ref","v":"Ps 23"}],"sourceClass":"sn-ref","t":"span"}," This psalm of trust and confidence in the Lord has been a favorite of God’s people for generations. It expresses assurance of God’s presence in the midst of adversity. It evokes images of the Good Shepherd (",{"href":"?bref=Ps.23.1-3","r":"Ps.23.1-3","rawR":"Ps.23.1-3","sourceRefs":[{"raw":"Ps.23.1-3","value":"Ps.23.1-3"}],"t":"ref","v":"23:1-3"},"; see ",{"href":"?bref=Ezek.34.12","r":"Ezek.34.12","rawR":"Ezek.34.12","sourceRefs":[{"raw":"Ezek.34.12","value":"Ezek.34.12"}],"t":"ref","v":"Ezek 34:12"},"; ",{"href":"?bref=John.10.11","r":"John.10.11","rawR":"John.10.11","sourceRefs":[{"raw":"John.10.11","value":"John.10.11"}],"t":"ref","v":"John 10:11"},") and of the messianic banquet (",{"href":"?bref=Ps.23.5-6","r":"Ps.23.5-6","rawR":"Ps.23.5-6","sourceRefs":[{"raw":"Ps.23.5-6","value":"Ps.23.5-6"}],"t":"ref","v":"Ps 23:5-6"},"; see ",{"href":"?bref=Isa.25.6","r":"Isa.25.6","rawR":"Isa.25.6","sourceRefs":[{"raw":"Isa.25.6","value":"Isa.25.6"}],"t":"ref","v":"Isa 25:6"},"; ",{"href":"?bref=Rev.19.9","r":"Rev.19.9","rawR":"Rev.19.9","sourceRefs":[{"raw":"Rev.19.9","value":"Rev.19.9"}],"t":"ref","v":"Rev 19:9"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.23.1-6","refs":[{"book":"PSA","endChapter":23,"endVerse":6,"startChapter":23,"startVerse":1}],"sourceAttributes":{"name":"Ps.23.1-6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[23],"sourceItemFragmentSha256":"c79c6ad18e3533271e3f496dec88a01e3ecaefad755d44073b4ae7e1c9d3021d","sourceItemName":"Ps.23.1-6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6208,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.23.1-6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.23.1-6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.23.1-3","r":"Ps.23.1-3","rawR":"Ps.23.1-3","sourceRefs":[{"raw":"Ps.23.1-3","value":"Ps.23.1-3"}],"t":"ref","v":"23:1-3"}],"sourceClass":"sn-ref","t":"span"}," People in the ancient Near East commonly viewed their rulers as shepherds."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.23.1-3","refs":[{"book":"PSA","endChapter":23,"endVerse":3,"startChapter":23,"startVerse":1}],"sourceAttributes":{"name":"Ps.23.1-3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[23],"sourceItemFragmentSha256":"54f0988977ab733346878cb7a6f99fd26446b5b36eee6f2e3abe93a2d4a98798","sourceItemName":"Ps.23.1-3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6209,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.23.1-3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.23.1-3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.23.1","r":"Ps.23.1","rawR":"Ps.23.1","sourceRefs":[{"raw":"Ps.23.1","value":"Ps.23.1"}],"t":"ref","v":"23:1"}],"sourceClass":"sn-ref","t":"span"}," The Lord promises to take care of his children (",{"href":"?bref=Ps.34.9-10","r":"Ps.34.9-10","rawR":"Ps.34.9-10","sourceRefs":[{"raw":"Ps.34.9-10","value":"Ps.34.9-10"}],"t":"ref","v":"34:9-10"},"; ",{"href":"?bref=Isa.51.14","r":"Isa.51.14","rawR":"Isa.51.14","sourceRefs":[{"raw":"Isa.51.14","value":"Isa.51.14"}],"t":"ref","v":"Isa 51:14"},"). He demonstrated this ability to Israel in the wilderness (",{"href":"?bref=Deut.2.7","r":"Deut.2.7","rawR":"Deut.2.7","sourceRefs":[{"raw":"Deut.2.7","value":"Deut.2.7"}],"t":"ref","v":"Deut 2:7"},") and in the Promised Land (",{"href":"?bref=Deut.8.9","r":"Deut.8.9","rawR":"Deut.8.9","sourceRefs":[{"raw":"Deut.8.9","value":"Deut.8.9"}],"t":"ref","v":"Deut 8:9"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.23.1","refs":[{"book":"PSA","endChapter":23,"endVerse":1,"startChapter":23,"startVerse":1}],"sourceAttributes":{"name":"Ps.23.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[23],"sourceItemFragmentSha256":"01362a2d120a17ffd6f60be07299499bee25e6c06a83e07afaf139cc692116e5","sourceItemName":"Ps.23.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6210,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.23.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.23.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.23.2","r":"Ps.23.2","rawR":"Ps.23.2","sourceRefs":[{"raw":"Ps.23.2","value":"Ps.23.2"}],"t":"ref","v":"23:2"}],"sourceClass":"sn-ref","t":"span"}," Sheep ",{"c":["rest"],"sourceClass":"sn-excerpt","t":"span"}," after they have eaten their fill (",{"href":"?bref=Zeph.3.13","r":"Zeph.3.13","rawR":"Zeph.3.13","sourceRefs":[{"raw":"Zeph.3.13","value":"Zeph.3.13"}],"t":"ref","v":"Zeph 3:13"},"; see ",{"href":"?bref=Isa.11.7","r":"Isa.11.7","rawR":"Isa.11.7","sourceRefs":[{"raw":"Isa.11.7","value":"Isa.11.7"}],"t":"ref","v":"Isa 11:7"},"; cp. ",{"href":"?bref=Isa.13.20","r":"Isa.13.20","rawR":"Isa.13.20","sourceRefs":[{"raw":"Isa.13.20","value":"Isa.13.20"}],"t":"ref","v":"Isa 13:20"},"; ",{"href":"?bref=Isa.27.10","r":"Isa.27.10","rawR":"Isa.27.10","sourceRefs":[{"raw":"Isa.27.10","value":"Isa.27.10"}],"t":"ref","v":"27:10"},"). • The Lord ",{"c":["leads"],"sourceClass":"sn-excerpt","t":"span"}," the sheep for their own benefit (see ",{"href":"?bref=Ps.5.8","r":"Ps.5.8","rawR":"Ps.5.8","sourceRefs":[{"raw":"Ps.5.8","value":"Ps.5.8"}],"t":"ref","v":"Ps 5:8"},"). • Sheep only drink from still water, so the shepherd seeks out ",{"c":["peaceful streams"],"sourceClass":"sn-excerpt","t":"span"}," for his flock."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.23.2","refs":[{"book":"PSA","endChapter":23,"endVerse":2,"startChapter":23,"startVerse":2}],"sourceAttributes":{"name":"Ps.23.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[23],"sourceItemFragmentSha256":"96a9cb32565e31d39ad94c98a5597ffdba7102b87f4726416c012d075663ae6e","sourceItemName":"Ps.23.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6211,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.23.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.23.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.23.3","r":"Ps.23.3","rawR":"Ps.23.3","sourceRefs":[{"raw":"Ps.23.3","value":"Ps.23.3"}],"t":"ref","v":"23:3"}],"sourceClass":"sn-ref","t":"span"}," Cp. ",{"href":"?bref=Ps.19.7","r":"Ps.19.7","rawR":"Ps.19.7","sourceRefs":[{"raw":"Ps.19.7","value":"Ps.19.7"}],"t":"ref","v":"19:7"},"; the Lord’s word ",{"c":["renews my strength."],"sourceClass":"sn-excerpt","t":"span"}," • The Lord ",{"c":["guides"],"sourceClass":"sn-excerpt","t":"span"}," by rescuing his people from evil (",{"href":"?bref=Ps.23.4-5","r":"Ps.23.4-5","rawR":"Ps.23.4-5","sourceRefs":[{"raw":"Ps.23.4-5","value":"Ps.23.4-5"}],"t":"ref","v":"23:4-5"},"; see ",{"href":"?bref=Ps.31.3","r":"Ps.31.3","rawR":"Ps.31.3","sourceRefs":[{"raw":"Ps.31.3","value":"Ps.31.3"}],"t":"ref","v":"31:3"},"), bringing them back to himself (",{"href":"?bref=Ps.5.8","r":"Ps.5.8","rawR":"Ps.5.8","sourceRefs":[{"raw":"Ps.5.8","value":"Ps.5.8"}],"t":"ref","v":"5:8"},"; ",{"href":"?bref=Ps.61.2","r":"Ps.61.2","rawR":"Ps.61.2","sourceRefs":[{"raw":"Ps.61.2","value":"Ps.61.2"}],"t":"ref","v":"61:2"},"), caring (",{"href":"?bref=Ps.48.14","r":"Ps.48.14","rawR":"Ps.48.14","sourceRefs":[{"raw":"Ps.48.14","value":"Ps.48.14"}],"t":"ref","v":"48:14"},"; ",{"href":"?bref=Ps.139.10","r":"Ps.139.10","rawR":"Ps.139.10","sourceRefs":[{"raw":"Ps.139.10","value":"Ps.139.10"}],"t":"ref","v":"139:10"},"), ruling (",{"href":"?bref=Ps.67.4","r":"Ps.67.4","rawR":"Ps.67.4","sourceRefs":[{"raw":"Ps.67.4","value":"Ps.67.4"}],"t":"ref","v":"67:4"},"), counseling (",{"href":"?bref=Ps.73.24","r":"Ps.73.24","rawR":"Ps.73.24","sourceRefs":[{"raw":"Ps.73.24","value":"Ps.73.24"}],"t":"ref","v":"73:24"},"), protecting (",{"href":"?bref=Ps.78.53","r":"Ps.78.53","rawR":"Ps.78.53","sourceRefs":[{"raw":"Ps.78.53","value":"Ps.78.53"}],"t":"ref","v":"78:53"},"; ",{"href":"?bref=Ps.107.30","r":"Ps.107.30","rawR":"Ps.107.30","sourceRefs":[{"raw":"Ps.107.30","value":"Ps.107.30"}],"t":"ref","v":"107:30"},"; ",{"href":"?bref=Ps.143.11","r":"Ps.143.11","rawR":"Ps.143.11","sourceRefs":[{"raw":"Ps.143.11","value":"Ps.143.11"}],"t":"ref","v":"143:11"},"), and instructing them in wisdom (",{"href":"?bref=Ps.27.11","r":"Ps.27.11","rawR":"Ps.27.11","sourceRefs":[{"raw":"Ps.27.11","value":"Ps.27.11"}],"t":"ref","v":"27:11"},"; see ",{"href":"?bref=Pr.4.11","r":"Pr.4.11","rawR":"Pr.4.11","sourceRefs":[{"raw":"Pr.4.11","value":"Pr.4.11"}],"t":"ref","v":"Prov 4:11"},"). • The Lord’s ",{"c":["name"],"sourceClass":"sn-excerpt","t":"span"}," guarantees the relationship; he guards his reputation against any accusation of his abandoning his people or allowing them to sin (see ",{"href":"?bref=Ps.25.11","r":"Ps.25.11","rawR":"Ps.25.11","sourceRefs":[{"raw":"Ps.25.11","value":"Ps.25.11"}],"t":"ref","v":"Pss 25:11"},"; ",{"href":"?bref=Ps.31.3","r":"Ps.31.3","rawR":"Ps.31.3","sourceRefs":[{"raw":"Ps.31.3","value":"Ps.31.3"}],"t":"ref","v":"31:3"},"; ",{"href":"?bref=Ps.106.8","r":"Ps.106.8","rawR":"Ps.106.8","sourceRefs":[{"raw":"Ps.106.8","value":"Ps.106.8"}],"t":"ref","v":"106:8"},"; ",{"href":"?bref=Ps.143.11","r":"Ps.143.11","rawR":"Ps.143.11","sourceRefs":[{"raw":"Ps.143.11","value":"Ps.143.11"}],"t":"ref","v":"143:11"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.23.3","refs":[{"book":"PSA","endChapter":23,"endVerse":3,"startChapter":23,"startVerse":3}],"sourceAttributes":{"name":"Ps.23.3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[23],"sourceItemFragmentSha256":"60073c90c636066cc083c14a6adfd0aeecc9f5a36fb1bc27b2888121260766f7","sourceItemName":"Ps.23.3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6212,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.23.3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.23.3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.23.4","r":"Ps.23.4","rawR":"Ps.23.4","sourceRefs":[{"raw":"Ps.23.4","value":"Ps.23.4"}],"t":"ref","v":"23:4"}],"sourceClass":"sn-ref","t":"span"}," The shepherd used his ",{"c":["rod"],"sourceClass":"sn-excerpt","t":"span"}," and ",{"c":["staff"],"sourceClass":"sn-excerpt","t":"span"}," to fend off danger."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.23.4","refs":[{"book":"PSA","endChapter":23,"endVerse":4,"startChapter":23,"startVerse":4}],"sourceAttributes":{"name":"Ps.23.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[23],"sourceItemFragmentSha256":"8409c5a2981b01ea8316c05c790f9de846ce2693ac6bf40911f56b772dd404b4","sourceItemName":"Ps.23.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6213,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.23.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.23.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.23.5","r":"Ps.23.5","rawR":"Ps.23.5","sourceRefs":[{"raw":"Ps.23.5","value":"Ps.23.5"}],"t":"ref","v":"23:5"}],"sourceClass":"sn-ref","t":"span"}," A ",{"c":["feast"],"sourceClass":"sn-excerpt","t":"span"}," demonstrates the Lord’s care and mercy toward his people (see ",{"href":"?bref=Ps.22.26","r":"Ps.22.26","rawR":"Ps.22.26","sourceRefs":[{"raw":"Ps.22.26","value":"Ps.22.26"}],"t":"ref","v":"22:26"},", ",{"href":"?bref=Ps.22.29","r":"Ps.22.29","rawR":"Ps.22.29","sourceRefs":[{"raw":"Ps.22.29","value":"Ps.22.29"}],"t":"ref","v":"29"},"). Although ",{"c":["enemies"],"sourceClass":"sn-excerpt","t":"span"}," can watch, they cannot trouble the guests. • The ritual of ",{"c":["anointing"],"sourceClass":"sn-excerpt","t":"span"}," the ",{"c":["head with oil"],"sourceClass":"sn-excerpt","t":"span"}," showed guests ",{"c":["honor"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=Ps.92.9-11","r":"Ps.92.9-11","rawR":"Ps.92.9-11","sourceRefs":[{"raw":"Ps.92.9-11","value":"Ps.92.9-11"}],"t":"ref","v":"92:9-11"},"), hospitality, and refreshment (",{"href":"?bref=Ps.104.15","r":"Ps.104.15","rawR":"Ps.104.15","sourceRefs":[{"raw":"Ps.104.15","value":"Ps.104.15"}],"t":"ref","v":"104:15"},"; ",{"href":"?bref=Ps.133.2","r":"Ps.133.2","rawR":"Ps.133.2","sourceRefs":[{"raw":"Ps.133.2","value":"Ps.133.2"}],"t":"ref","v":"133:2"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.23.5","refs":[{"book":"PSA","endChapter":23,"endVerse":5,"startChapter":23,"startVerse":5}],"sourceAttributes":{"name":"Ps.23.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[23],"sourceItemFragmentSha256":"839b32b34a00f28c5184bb9dd9aee31af6141ac3191107486c620e16fd7047f6","sourceItemName":"Ps.23.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6214,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.23.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.23.5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.23.6","r":"Ps.23.6","rawR":"Ps.23.6","sourceRefs":[{"raw":"Ps.23.6","value":"Ps.23.6"}],"t":"ref","v":"23:6"}],"sourceClass":"sn-ref","t":"span"}," The Lord expresses his ",{"c":["unfailing love"],"sourceClass":"sn-excerpt","t":"span"}," through the ",{"c":["goodness"],"sourceClass":"sn-excerpt","t":"span"}," of his presence and other benefits that he alone provides (",{"href":"?bref=Ps.69.16","r":"Ps.69.16","rawR":"Ps.69.16","sourceRefs":[{"raw":"Ps.69.16","value":"Ps.69.16"}],"t":"ref","v":"69:16"},"; ",{"href":"?bref=Ps.86.17","r":"Ps.86.17","rawR":"Ps.86.17","sourceRefs":[{"raw":"Ps.86.17","value":"Ps.86.17"}],"t":"ref","v":"86:17"},"; ",{"href":"?bref=Ps.109.21","r":"Ps.109.21","rawR":"Ps.109.21","sourceRefs":[{"raw":"Ps.109.21","value":"Ps.109.21"}],"t":"ref","v":"109:21"},"; see ",{"href":"?bref=Ps.18.6","r":"Ps.18.6","rawR":"Ps.18.6","sourceRefs":[{"raw":"Ps.18.6","value":"Ps.18.6"}],"t":"ref","v":"18:6"},"; ",{"href":"?bref=Ps.61.4","r":"Ps.61.4","rawR":"Ps.61.4","sourceRefs":[{"raw":"Ps.61.4","value":"Ps.61.4"}],"t":"ref","v":"61:4"},"). He actively bestows care that is greater than the temporary trials imposed by enemies (",{"href":"?bref=Ps.7.1","r":"Ps.7.1","rawR":"Ps.7.1","sourceRefs":[{"raw":"Ps.7.1","value":"Ps.7.1"}],"t":"ref","v":"7:1"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.23.6","refs":[{"book":"PSA","endChapter":23,"endVerse":6,"startChapter":23,"startVerse":6}],"sourceAttributes":{"name":"Ps.23.6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[23],"sourceItemFragmentSha256":"da1d2a18f7e0c07bda236c55f78ffd86e411ac9434ce3035fe25e6c83288309a","sourceItemName":"Ps.23.6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6215,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.23.6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.23.6","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}