leOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[138,139,140,141,142,143,144,145],"sourceItemFragmentSha256":"635758a56903b7b4813131c900a660965334f93d93f552c627645cb63ca925dc","sourceItemName":"Ps.138.1-145.21","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7386,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.138.1-145.21","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.138.1-145.21","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.140.1-13","r":"Ps.140.1-13","rawR":"Ps.140.1-13","sourceRefs":[{"raw":"Ps.140.1-13","value":"Ps.140.1-13"}],"t":"ref","v":"Ps 140"}],"sourceClass":"sn-ref","t":"span"}," In this individual lament, the psalmist artistically sketches God’s enemies with all their evil intents. He prays for the Lord’s protection and rescue with confidence in God’s strength and justice. He foresees the evil as being judged by fire (",{"href":"?bref=Ps.140.9-11","r":"Ps.140.9-11","rawR":"Ps.140.9-11","sourceRefs":[{"raw":"Ps.140.9-11","value":"Ps.140.9-11"}],"t":"ref","v":"140:9-11"},") and himself as being vindicated and dwelling in the Lord’s presence (",{"href":"?bref=Ps.140.13","r":"Ps.140.13","rawR":"Ps.140.13","sourceRefs":[{"raw":"Ps.140.13","value":"Ps.140.13"}],"t":"ref","v":"140:13"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.140.1-13","refs":[{"book":"PSA","endChapter":140,"endVerse":13,"startChapter":140,"startVerse":1}],"sourceAttributes":{"name":"Ps.140.1-13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[140],"sourceItemFragmentSha256":"5acf976805487605b5057bac23328b5cfc46ab9056e7c82ed277c88bb9784f6f","sourceItemName"