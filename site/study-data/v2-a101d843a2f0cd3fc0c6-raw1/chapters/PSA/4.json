 as they sleep, but silence opens their hearts to trust in the Lord (",{"href":"?bref=Ps.4.5","r":"Ps.4.5","rawR":"Ps.4.5","sourceRefs":[{"raw":"Ps.4.5","value":"Ps.4.5"}],"t":"ref","v":"Ps 4:5"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.4.4","refs":[{"book":"PSA","endChapter":4,"endVerse":4,"startChapter":4,"startVerse":4}],"sourceAttributes":{"name":"Ps.4.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[4],"sourceItemFragmentSha256":"fa9b0b65c14a0bea1b007f72df83edc65a0801be8d2c8837dd9f5d8b7589ecd6","sourceItemName":"Ps.4.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5993,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.4.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.4.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.4.5","r":"Ps.4.5","rawR":"Ps.4.5","sourceRefs":[{"raw":"Ps.4.5","value":"Ps.4.5"}],"t":"ref","v":"4:5"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Offer sacrifices in the right spirit:"],"sourceClass":"sn-excerpt","t":"span"}," Redirecting emotions toward the Lord prevents a godly individual from doing too much self-reflection (",{"href":"?bref=Ps.40.6-8","r":"Ps.40.6-8","rawR":"Ps.40.6-8","sourceRefs":[{"raw":"Ps.40.6-8","value":"Ps.40.6-8"}],"t":"ref","v":"40:6-8"},"; ",{"href":"?bref=Ps.51.17","r":"Ps.51.17","rawR":"Ps.51.17","sourceRefs":[{"raw":"Ps.51.17","value":"Ps.51.17"}],"t":"ref","v":"51:17"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.4.5","refs":[{"book":"PSA","endChapter":4,"endVerse":5,"startChapter":4,"startVerse":5}],"sourceAttributes":{"name":"Ps.4.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBo