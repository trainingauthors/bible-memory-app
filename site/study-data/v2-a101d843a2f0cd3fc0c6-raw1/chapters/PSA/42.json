 by Dan at the foot of Mount Hermon. • ",{"c":["Mount Mizar"],"sourceClass":"sn-excerpt","t":"span"}," might be a peak in the Mount Hermon range."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.42.6","refs":[{"book":"PSA","endChapter":42,"endVerse":6,"startChapter":42,"startVerse":6}],"sourceAttributes":{"name":"Ps.42.6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[42],"sourceItemFragmentSha256":"d1f95da8661a69f7e52b9201fcbb27610616fb7e13f47a2be94e481f0f6943a5","sourceItemName":"Ps.42.6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6432,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.42.6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.42.6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.42.7","r":"Ps.42.7","rawR":"Ps.42.7","sourceRefs":[{"raw":"Ps.42.7","value":"Ps.42.7"}],"t":"ref","v":"42:7"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["raging seas"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," ",{"c":["waves"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," and ",{"c":["surging tides"],"sourceClass":"sn-excerpt","t":"span"}," conjure images of God’s wrath (see ",{"href":"?bref=Ps.88.7","r":"Ps.88.7","rawR":"Ps.88.7","sourceRefs":[{"raw":"Ps.88.7","value":"Ps.88.7"}],"t":"ref","v":"88:7"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.42.7","refs":[{"book":"PSA","endChapter":42,"endVerse":7,"startChapter":42,"startVerse":7}],"sourceAttributes":{"name":"Ps.42.7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[42],"sourceItemFra