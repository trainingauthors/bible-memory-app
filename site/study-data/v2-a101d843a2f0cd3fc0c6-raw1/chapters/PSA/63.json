"Ps.63.5","sourceRefs":[{"raw":"Ps.63.5","value":"Ps.63.5"}],"t":"ref","v":"63:5"},"; ",{"href":"?bref=Pr.16.8","r":"Pr.16.8","rawR":"Pr.16.8","sourceRefs":[{"raw":"Pr.16.8","value":"Pr.16.8"}],"t":"ref","v":"Prov 16:8"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.63.3","refs":[{"book":"PSA","endChapter":63,"endVerse":3,"startChapter":63,"startVerse":3}],"sourceAttributes":{"name":"Ps.63.3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[63],"sourceItemFragmentSha256":"e933b256a8427b155113762fb8ce5941565bc125a6b789061ee72794566c1de5","sourceItemName":"Ps.63.3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6608,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.63.3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.63.3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.63.6-8","r":"Ps.63.6-8","rawR":"Ps.63.6-8","sourceRefs":[{"raw":"Ps.63.6-8","value":"Ps.63.6-8"}],"t":"ref","v":"63:6-8"}],"sourceClass":"sn-ref","t":"span"}," The psalmist reflects and meditates on God’s presence ",{"c":["through the night"],"sourceClass":"sn-excerpt","t":"span"},". In the absence of light, God is the light. The quietness of the night and the longing for dawn provide time to focus on the true significance of life with the Lord."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.63.6-8","refs":[{"book":"PSA","endChapter":63,"endVerse":8,"startChapter":63,"startVerse":6}],"sourceAttributes":{"name":"Ps.63.6-8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[63],"sourceItemFragmentSha256":"7a745d1da08ec1a6c9fd05efed0836116e54ed6520d9d368972dca97de9eb862","sourceItemName":"Ps.63.6-8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6609,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.63.6-8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.63.6-8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.63.6","r":"Ps.63.6","rawR":"Ps.63.6","sourceRefs":[{"raw":"Ps.63.6","value":"Ps.63.6"}],"t":"ref","v":"63:6"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Meditating"],"sourceClass":"sn-excerpt","t":"span"}," on God requires focused awareness, concentration, thought, and reflection (see ",{"href":"?bref=Ps.1.2","r":"Ps.1.2","rawR":"Ps.1.2","sourceRefs":[{"raw":"Ps.1.2","value":"Ps.1.2"}],"t":"ref","v":"1:2"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.63.6","refs":[{"book":"PSA","endChapter":63,"endVerse":6,"startChapter":63,"startVerse":6}],"sourceAttributes":{"name":"Ps.63.6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[63],"sourceItemFragmentSha256":"dff7b06c989eb462bd62e8dd3763eb492a51c492ae48b06f9441549280594026","sourceItemName":"Ps.63.6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6610,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.63.6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.63.6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.63.9","r":"Ps.63.9","rawR":"Ps.63.9","sourceRefs":[{"raw":"Ps.63.9","value":"Ps.63.9"}],"t":"ref","v":"63:9"}],"sourceClass":"sn-ref","t":"span"}," The wicked were ",{"c":["plotting to destroy"],"sourceClass":"sn-excerpt","t":"span"}," the psalmist’s life through deception and lies, but they would meet their end. • The ",{"c":["depths of the earth"],"sourceClass":"sn-excerpt","t":"span"}," refers to the place of the dead."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.63.9","refs":[{"book":"PSA","endChapter":63,"endVerse":9,"startChapter":63,"startVerse":9}],"sourceAttributes":{"name":"Ps.63.9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[63],"sourceItemFragmentSha256":"76f99ff13d89e361094cb4cd86a31f931da35aa4931a0b67f6149df6a18065f0","sourceItemName":"Ps.63.9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6611,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.63.9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.63.9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Ps.63.10","r":"Ps.63.10","rawR":"Ps.63.10","sourceRefs":[{"raw":"Ps.63.10","value":"Ps.63.10"}],"t":"ref","v":"63:10"}],"sourceClass":"sn-ref","t":"span"}," Wild ",{"c":["jackals"],"sourceClass":"sn-excerpt","t":"span"}," are associated with desolation and abandonment (",{"href":"?bref=Isa.13.20-22","r":"Isa.13.20-22","rawR":"Isa.13.20-22","sourceRefs":[{"raw":"Isa.13.20-22","value":"Isa.13.20-22"}],"t":"ref","v":"Isa 13:20-22"},"; ",{"href":"?bref=Isa.34.10-15","r":"Isa.34.10-15","rawR":"Isa.34.10-15","sourceRefs":[{"raw":"Isa.34.10-15","value":"Isa.34.10-15"}],"t":"ref","v":"34:10-15"},"; ",{"href":"?bref=Jer.9.11","r":"Jer.9.11","rawR":"Jer.9.11","sourceRefs":[{"raw":"Jer.9.11","value":"Jer.9.11"}],"t":"ref","v":"Jer 9:11"},"; ",{"href":"?bref=Jer.49.33","r":"Jer.49.33","rawR":"Jer.49.33","sourceRefs":[{"raw":"Jer.49.33","value":"Jer.49.33"}],"t":"ref","v":"49:33"},"; ",{"href":"?bref=Jer.51.37","r":"Jer.51.37","rawR":"Jer.51.37","sourceRefs":[{"raw":"Jer.51.37","value":"Jer.51.37"}],"t":"ref","v":"51:37"},"; ",{"href":"?bref=Lam.5.18","r":"Lam.5.18","rawR":"Lam.5.18","sourceRefs":[{"raw":"Lam.5.18","value":"Lam.5.18"}],"t":"ref","v":"Lam 5:18"},"; ",{"href":"?bref=Mal.1.3","r":"Mal.1.3","rawR":"Mal.1.3","sourceRefs":[{"raw":"Mal.1.3","value":"Mal.1.3"}],"t":"ref","v":"Mal 1:3"},"). The wicked will not receive honor in death; their bodies will be left to scavenging animals (",{"href":"?bref=Eccl.6.3","r":"Eccl.6.3","rawR":"Eccl.6.3","sourceRefs":[{"raw":"Eccl.6.3","value":"Eccl.6.3"}],"t":"ref","v":"Eccl 6:3"},"; ",{"href":"?bref=Jer.22.18-19","r":"Jer.22.18-19","rawR":"Jer.22.18-19","sourceRefs":[{"raw":"Jer.22.18-19","value":"Jer.22.18-19"}],"t":"ref","v":"Jer 22:18-19"},"; ",{"href":"?bref=Jer.36.29-30","r":"Jer.36.29-30","rawR":"Jer.36.29-30","sourceRefs":[{"raw":"Jer.36.29-30","value":"Jer.36.29-30"}],"t":"ref","v":"36:29-30"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Ps.63.10","refs":[{"book":"PSA","endChapter":63,"endVerse":10,"startChapter":63,"startVerse":10}],"sourceAttributes":{"name":"Ps.63.10","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PSA","sourceChapterCoverage":[63],"sourceItemFragmentSha256":"2b5216a19130e54bc492e32f798cd3d7f9880e381451d9ebe9b721378e9cf4d3","sourceItemName":"Ps.63.10","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":6612,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PSA","canonicalOSIS":"Ps","method":"official_book_intro_ref_title","sourceOSIS":"Ps"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Ps.63.10","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Ps.63.10","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}