932db1.json","title":"Patience"},"Plants":{"file":"dictionary/4577249ac9b7773d00fd8bc627ee1383687474dfdb93b77f98c93d99e4ce0612.json","title":"Plants"},"TarshishPlace":{"file":"dictionary/b2f03288121f21817e108d54c4fc438dfd67fafecb2742b36a9ab3544a0af7c7.json","title":"Tarshish (Place)"}},"dictionaryRelated":[{"id":"Animals","title":"Animals"},{"id":"Booth","title":"Booth"},{"id":"EastWind","title":"East Wind"},{"id":"GodBeingandAttributesof","title":"God, Being and Attributes of"},{"id":"JonahBookof","title":"Jonah, Book of"},{"id":"NinevehNinevite","title":"Nineveh, Ninevite*"},{"id":"Patience","title":"Patience"},{"id":"Plants","title":"Plants"},{"id":"TarshishPlace","title":"Tarshish (Place)"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"So he prayed to the LORD, saying, “O LORD, is this not what I said while I was still in my own country? This is why I was so quick to flee toward Tarshish. I knew that You are a gracious and compassionate God, slow to anger, abounding in loving devotion—One who relents from sending disaster.","verse":2},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"And now, O LORD, please take my life from me, for it is better for me to die than to live.”","verse":3},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"But the LORD replied, “Have you any right to be angry?”","verse":4},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"So the LORD God appointed a vine, and it grew up to provide shade over Jonah’s head to ease his discomfort, and Jonah was greatly pleased with the plant.","verse":6},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"But the LORD said, “You cared about the plant, which you neither tended nor made grow. It sprang up in a night and perished in a night.","verse":10}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Jon.3.1-4.11","r":"Jon.3.1-4.11","rawR":"Jon.3.1-4.11","sourceRefs":[{"raw":"Jon.3.1-4.11","value":"Jon.3.1-4.11"}],"t":"ref","v":"3:1–4:11"}],"sourceClass":"sn-ref","t":"span"}," God again commands Jonah to preach to Nineveh. This time Jonah obeys, leading to an irony: The city repents, as Jonah had feared, and he is angry at God."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Jon.3.1-4.11","refs":[{"book":"JON","endChapter":4,"endVerse":11,"startChapter":3,"startVerse":1}],"sourceAttributes":{"name":"Jon.3.1-4.11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JON","sourceChapterCoverage":[3,4],"sourceItemF