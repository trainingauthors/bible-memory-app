1745c60125a9ba3bae1bee611088199fa455.json","title":"Hades*"},"JonahBookof":{"file":"dictionary/d889b823599a62ea61b7a81031819ee37011a06906d5d2d9df4c504ab73812cf.json","title":"Jonah, Book of"},"Lord":{"file":"dictionary/0a54f5caa03523157b50ef58ec814d810e7db1abd5db44ec093ece07106e3447.json","title":"Lord"}},"dictionaryRelated":[{"id":"Animals","title":"Animals"},{"id":"DeadPlaceofthe","title":"Dead, Place of the"},{"id":"Hades","title":"Hades*"},{"id":"JonahBookof","title":"Jonah, Book of"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"From inside the fish, Jonah prayed to the LORD his God,","verse":1},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"saying: “In my distress I called to the LORD, and He answered me. From the belly of Sheol I called for help, and You heard my voice.","verse":2},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"To the roots of the mountains I descended; the earth beneath me barred me in forever! But You raised my life from the pit, O LORD my God!","verse":6},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"As my life was fading away, I remembered the LORD. My prayer went up to You, to Your holy temple.","verse":7},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"But I, with the voice of thanksgiving, will sacrifice to You. I will fulfill what I have vowed. Salvation is from the LORD!”","verse":9},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"And the LORD commanded the fish, and it vomited Jonah onto dry land.","verse":10}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"},{"evidence":[{"matchingRule":"source_verified_redirect","phrase":"thanksgiving","senseEvidence":{"basis":"reviewed_publisher_redirect","originalCitations":[],"ruleId":"Gratitude::Thanksgiving::reviewed_publisher_redirect","sourceHeadwordId":"Thanksgiving"},"text":"But I, with the voice of thanksgiving, will sacrifice to You. I will fulfill what I have vowed. Salvation is from the LORD!”","verse":9}],"id":"Gratitude","label":"thanksgiving","matchReviews":[{"ruleId":"Gratitude::Thanksgiving::reviewed_publisher_redirect","scope":"reviewed_publisher_redirect","senseReview":"The original publisher explicitly links this complete unambiguous name/phrase to this target. Redirect and target were reviewed once; actual BSB phrase and full word boundaries required. Target original title and complete article remain unchanged.","sourceHeadwordId":"Thanksgiving","term":"Thanksgiving"}],"matchingRule":"source_verified_redirect","matchingRules":["source_verified_redirect"],"sourceProvenanceId":"Gratitude","sourceTitle":"Gratitude"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Jon.2.1-9","r":"Jon.2.1-9","rawR":"Jon.2.1-9","sourceRefs":[{"raw":"Jon.2.1-9","value":"Jon.2.1-9"}],"t":"ref","v":"2:1-9"}],"sourceClass":"sn-ref","t":"span"}," Realizing that the Lord had graciously delivered him by sending the fish, Jonah composed this psalm-like prayer. Its careful structure, conforming to the pattern of an individual song of thanksgiving, suggests that it may have been composed after the event, as Jonah recalled his emotions and concerns."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Jon.2.1-9","refs":[{"book":"JON","endChapter":2,"endVerse":9,"startChapter":2,"startVerse":1}],"sourceAttributes":{"name":"Jon.2.1-9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JON","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"29d526eb1dd3b489179714c494d0af391de1c6c201f8ccb1a36bf92d288f894a","sourceItemName":"Jon.2.1-9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11224,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JON","canonicalOSIS":"Jonah","method":"official_book_intro_ref_title","sourceOSIS":"Jon"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"Jon.2.1-9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Jon.2.1-9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Jon.2.2","r":"Jon.2.2","rawR":"Jon.2.2","sourceRefs":[{"raw":"Jon.2.2","value":"Jon.2.2"}],"t":"ref","v":"2:2"}],"sourceClass":"sn-ref","t":"span"}," Jonah’s psalm-prayer opens by recalling a previous prayer that was not so polished yet was all the more fervent—his cry for help while on the verge of drowning. • ",{"c":["from the land of the dead"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["from the belly of Sheol"],"sourceClass":"ital","t":"span"},"): Sheol was thought to be the abode of the dead (see ",{"href":"?bref=Isa.14.15","r":"Isa.14.15","rawR":"Isa.14.15","sourceRefs":[{"raw":"Isa.14.15","value":"Isa.14.15"}],"t":"ref","v":"Isa 14:15"},"; ",{"href":"?bref=Ezek.31.15-17","r":"Ezek.31.15-17","rawR":"Ezek.31.15-17","sourceRefs":[{"raw":"Ezek.31.15-17","value":"Ezek.31.15-17"}],"t":"ref","v":"Ezek 31:15-17"},"). The belly metaphor for Sheol is found nowhere else in the Old Testament; it pictures Jonah’s experience of being delivered from Sheol through the belly of a fish."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Jon.2.2","refs":[{"book":"JON","endChapter":2,"endVerse":2,"startChapter":2,"startVerse":2}],"sourceAttributes":{"name":"Jon.2.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JON","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"09f7a2b03596624cdd1d04b3925b66044fe9aa7c78734af82c47db1a8a31d970","sourceItemName":"Jon.2.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11225,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JON","canonicalOSIS":"Jonah","method":"official_book_intro_ref_title","sourceOSIS":"Jon"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"Jon.2.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Jon.2.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Jon.2.4","r":"Jon.2.4","rawR":"Jon.2.4","sourceRefs":[{"raw":"Jon.2.4","value":"Jon.2.4"}],"t":"ref","v":"2:4"}],"sourceClass":"sn-ref","t":"span"}," On the brink of drowning, Jonah called out for help, for life, and for God’s renewed presence. It is ironic that Jonah spoke of God as driving Jonah from his ",{"c":["presence"],"sourceClass":"sn-excerpt","t":"span"},", for that was Jonah’s own aim in fleeing to Tarshish (",{"href":"?bref=Jon.1.3","r":"Jon.1.3","rawR":"Jon.1.3","sourceRefs":[{"raw":"Jon.1.3","value":"Jon.1.3"}],"t":"ref","v":"1:3"},"). • ",{"c":["I will look once more:"],"sourceClass":"sn-excerpt","t":"span"}," Either Jonah was confident that he would be rescued and thus worship again in the Temple in Jerusalem, or he was calling to the Lord in his Temple from the sea (cp. ",{"href":"?bref=Jon.2.7","r":"Jon.2.7","rawR":"Jon.2.7","sourceRefs":[{"raw":"Jon.2.7","value":"Jon.2.7"}],"t":"ref","v":"2:7"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Jon.2.4","refs":[{"book":"JON","endChapter":2,"endVerse":4,"startChapter":2,"startVerse":4}],"sourceAttributes":{"name":"Jon.2.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JON","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"5b4dd30dcc33ef3a44cbbd2d6c1cbefcf1723091f61c1da8fd8e247ed55dc713","sourceItemName":"Jon.2.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11226,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JON","canonicalOSIS":"Jonah","method":"official_book_intro_ref_title","sourceOSIS":"Jon"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"Jon.2.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Jon.2.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Jon.2.6","r":"Jon.2.6","rawR":"Jon.2.6","sourceRefs":[{"raw":"Jon.2.6","value":"Jon.2.6"}],"t":"ref","v":"2:6"}],"sourceClass":"sn-ref","t":"span"}," Jonah’s metaphors (",{"c":["roots of the mountains"],"sourceClass":"sn-excerpt","t":"span"},{"c":[";"],"sourceClass":"ital","t":"span"},{"c":[" imprisoned in the earth"],"sourceClass":"sn-excerpt","t":"span"},") reflect ancient concepts of the underworld, with the dead being deep within the earth (see also ",{"href":"?bref=Jon.2.2","r":"Jon.2.2","rawR":"Jon.2.2","sourceRefs":[{"raw":"Jon.2.2","value":"Jon.2.2"}],"t":"ref","v":"2:2"},"). At one point Jonah felt hopelessly doomed to death’s prison. • ",{"c":["But:"],"sourceClass":"sn-excerpt","t":"span"}," The transition is powerful. Jonah, though certain of his own death, was not beyond God’s gracious reach. • ",{"c":["the jaws of death"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["the pit"],"sourceClass":"ital","t":"span"},"): The Hebrew term normally denotes the habitat of the dead. Jonah’s language again makes it clear that at this point he considered himself as good as dead."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Jon.2.6","refs":[{"book":"JON","endChapter":2,"endVerse":6,"startChapter":2,"startVerse":6}],"sourceAttributes":{"name":"Jon.2.6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JON","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"0005fab2f7e3a5d8efce1ad590628a379e87b09cfd086afb8ec5f8b2a3fc54f8","sourceItemName":"Jon.2.6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11227,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JON","canonicalOSIS":"Jonah","method":"official_book_intro_ref_title","sourceOSIS":"Jon"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"Jon.2.6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Jon.2.6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Jon.2.7","r":"Jon.2.7","rawR":"Jon.2.7","sourceRefs":[{"raw":"Jon.2.7","value":"Jon.2.7"}],"t":"ref","v":"2:7"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["I remembered the"],"sourceClass":"sn-excerpt","t":"span"}," ",{"c":["Lord"],"sourceClass":"sn-excerpt-divine-name","t":"span"},{"c":[":"],"sourceClass":"sn-excerpt","t":"span"}," In this context, Jonah’s statement means “I turned my thoughts to the Lord in prayer.” • ",{"c":["earnest prayer . . . holy Temple:"],"sourceClass":"sn-excerpt","t":"span"}," The Temple was God’s special dwelling place in Israel’s worship, even though God is present everywhere at all times (",{"href":"?bref=Ps.139.7-10","r":"Ps.139.7-10","rawR":"Ps.139.7-10","sourceRefs":[{"raw":"Ps.139.7-10","value":"Ps.139.7-10"}],"t":"ref","v":"Ps 139:7-10"},"; ",{"href":"?bref=Jer.23.23-24","r":"Jer.23.23-24","rawR":"Jer.23.23-24","sourceRefs":[{"raw":"Jer.23.23-24","value":"Jer.23.23-24"}],"t":"ref","v":"Jer 23:23-24"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Jon.2.7","refs":[{"book":"JON","endChapter":2,"endVerse":7,"startChapter":2,"startVerse":7}],"sourceAttributes":{"name":"Jon.2.7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JON","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"d8c6e64133aa4112e3af0a5a558471ac55137c96c2a89ca938a0343ee74eb343","sourceItemName":"Jon.2.7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11228,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JON","canonicalOSIS":"Jonah","method":"official_book_intro_ref_title","sourceOSIS":"Jon"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"Jon.2.7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Jon.2.7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Jon.2.8-9","r":"Jon.2.8-9","rawR":"Jon.2.8-9","sourceRefs":[{"raw":"Jon.2.8-9","value":"Jon.2.8-9"}],"t":"ref","v":"2:8-9"}],"sourceClass":"sn-ref","t":"span"}," The conclusion to Jonah’s psalm-prayer bears similarity to ",{"href":"?bref=Jon.1.16","r":"Jon.1.16","rawR":"Jon.1.16","sourceRefs":[{"raw":"Jon.1.16","value":"Jon.1.16"}],"t":"ref","v":"1:16"},": The sailors also responded to the Lord’s power to save and acts of mercy with ",{"c":["sacrifices"],"sourceClass":"sn-excerpt","t":"span"}," and ",{"c":["vows"],"sourceClass":"sn-excerpt","t":"span"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Jon.2.8-9","refs":[{"book":"JON","endChapter":2,"endVerse":9,"startChapter":2,"startVerse":8}],"sourceAttributes":{"name":"Jon.2.8-9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JON","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"577ba9b7e938f6e7b135e6b962ec5966aa8152e536257434b24db2282e6f3e47","sourceItemName":"Jon.2.8-9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11229,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JON","canonicalOSIS":"Jonah","method":"official_book_intro_ref_title","sourceOSIS":"Jon"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"Jon.2.8-9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Jon.2.8-9","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}