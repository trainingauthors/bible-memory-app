{"book":"JON","chapter":3,"crossrefs":[{"anchor":"word of the LORD","refs":["Jonah 1:1"],"sourceRowNumber":43590,"targets":[{"label":"Jonah 1:1","passages":[{"book":"JON","chapter":1,"verses":[1]}]}],"verse":1},{"anchor":"a second time","refs":["John 21:15-17"],"sourceRowNumber":43591,"targets":[{"label":"John 21:15-17","passages":[{"book":"JHN","chapter":21,"verses":[15,16,17]}]}],"verse":1},{"anchor":"Nineveh","refs":["Jonah 3:3","Jonah 1:2","Zeph 2:13-15"],"sourceRowNumber":43592,"targets":[{"label":"Jonah 3:3","passages":[{"book":"JON","chapter":3,"verses":[3]}]},{"label":"Jonah 1:2","passages":[{"book":"JON","chapter":1,"verses":[2]}]},{"label":"Zeph 2:13-15","passages":[{"book":"ZEP","chapter":2,"verses":[13,14,15]}]}],"verse":2},{"anchor":"proclaim","refs":["Jer 1:17","Jer 15:19-21","Ezek 2:7","Ezek 3:17","Matt 3:8","John 5:14"],"sourceRowNumber":43593,"targets":[{"label":"Jer 1:17","passages":[{"book":"JER","chapter":1,"verses":[17]}]},{"label":"Jer 15:19-21","passages":[{"book":"JER","chapter":15,"verses":[19,20,21]}]},{"label":"Ezek 2:7","passages":[{"book":"EZK","chapter":2,"verses":[7]}]},{"label":"Ezek 3:17","passages":[{"book":"EZK","chapter":3,"verses":[17]}]},{"label":"Matt 3:8","passages":[{"book":"MAT","chapter":3,"verses":[8]}]},{"label":"John 5:14","passages":[{"book":"JHN","chapter":5,"verses":[14]}]}],"verse":2},{"anchor":"got up","refs":["Gen 22:3","Matt 21:28-29","2 Tim 4:11"],"sourceRowNumber":43594,"targets":[{"label":"Gen 22:3","passages":[{"book":"GEN","chapter":22,"verses":[3]}]},{"label":"Matt 21:28-29","passages":[{"book":"MAT","chapter":21,"verses":[28,29]}]},{"label":"2 Tim 4:11","passages":[{"book":"2TI","chapter":4,"verses":[11]}]}],"verse":3},{"anchor":"exceedingly great","refs":["Gen 30:8","Ps 36:6","Ps 80:10"],"sourceRowNumber":43595,"targets":[{"label":"Gen 30:8","passages":[{"book":"GEN","chapter":30,"verses":[8]}]},{"label":"Ps 36:6","passages":[{"book":"PSA","chapter":36,"verses":[6]}]},{"label":"Ps 80:10","passages":[{"book":"PSA","chapter":80,"verses":[10]}]}],"verse":3},{"anchor":"Forty more days","refs":["Jonah 3:10","Deut 18:22","2 Kgs 20:1,6","Jer 18:7-10"],"sourceRowNumber":43596,"targets":[{"label":"Jonah 3:10","passages":[{"book":"JON","chapter":3,"verses":[10]}]},{"label":"Deut 18:22","passages":[{"book":"DEU","chapter":18,"verses":[22]}]},{"label":"2 Kgs 20:1,6","passages":[{"book":"2KI","chapter":20,"verses":[1,6]}]},{"label":"Jer 18:7-10","passages":[{"book":"JER","chapter":18,"verses":[7,8,9,10]}]}],"verse":4},{"anchor":"believed God","refs":["Exod 9:18-21","Matt 12:41","Luke 11:32","Acts 27:25","Heb 11:1,7"],"sourceRowNumber":43597,"targets":[{"label":"Exod 9:18-21","passages":[{"book":"EXO","chapter":9,"verses":[18,19,20,21]}]},{"label":"Matt 12:41","passages":[{"book":"MAT","chapter":12,"verses":[41]}]},{"label":"Luke 11:32","passages":[{"book":"LUK","chapter":11,"verses":[32]}]},{"label":"Acts 27:25","passages":[{"book":"ACT","chapter":27,"verses":[25]}]},{"label":"Heb 11:1,7","passages":[{"book":"HEB","chapter":11,"verses":[1,7]}]}],"verse":5},{"anchor":"proclaimed a fast","refs":["2 Chr 20:3","Ezra 8:21","Jer 36:9","Joel 1:14","Joel 2:12-17"],"sourceRowNumber":43598,"targets":[{"label":"2 Chr 20:3","passages":[{"book":"2CH","chapter":20,"verses":[3]}]},{"label":"Ezra 8:21","passages":[{"book":"EZR","chapter":8,"verses":[21]}]},{"label":"Jer 36:9","passages":[{"book":"JER","chapter":36,"verses":[9]}]},{"label":"Joel 1:14","passages":[{"book":"JOL","chapter":1,"verses":[14]}]},{"label":"Joel 2:12-17","passages":[{"book":"JOL","chapter":2,"verses":[12,13,14,15,16,17]}]}],"verse":5},{"anchor":"from the greatest of them to the least","refs":["Jer 31:34","Jer 42:1,8","Acts 8:10"],"sourceRowNumber":43599,"targets":[{"label":"Jer 31:34","passages":[{"book":"JER","chapter":31,"verses":[34]}]},{"label":"Jer 42:1,8","passages":[{"book":"JER","chapter":42,"verses":[1,8]}]},{"label":"Acts 8:10","passages":[{"book":"ACT","chapter":8,"verses":[10]}]}],"verse":5},{"anchor":"word reached","refs":["Jer 13:18"],"sourceRowNumber":43600,"targets":[{"label":"Jer 13:18","passages":[{"book":"JER","chapter":13,"verses":[18]}]}],"verse":6},{"anchor":"got up from his throne","refs":["Ps 2:10-12","Jas 1:9-10","Jas 4:6-10"],"sourceRowNumber":43601,"targets":[{"label":"Ps 2:10-12","passages":[{"book":"PSA","chapter":2,"verses":[10,11,12]}]},{"label":"Jas 1:9-10","passages":[{"book":"JAS","chapter":1,"verses":[9,10]}]},{"label":"Jas 4:6-10","passages":[{"book":"JAS","chapter":4,"verses":[6,7,8,9,10]}]}],"verse":6},{"anchor":"covered himself with sackcloth","refs":["Esth 4:1-4","Job 2:8","Job 42:6","Jer 6:26","Lam 3:29","Dan 9:3","Mic 1:10","Matt 11:21","Luke 10:13"],"sourceRowNumber":43602,"targets":[{"label":"Esth 4:1-4","passages":[{"book":"EST","chapter":4,"verses":[1,2,3,4]}]},{"label":"Job 2:8","passages":[{"book":"JOB","chapter":2,"verses":[8]}]},{"label":"Job 42:6","passages":[{"book":"JOB","chapter":42,"verses":[6]}]},{"label":"Jer 6:26","passages":[{"book":"JER","chapter":6,"verses":[26]}]},{"label":"Lam 3:29","passages":[{"book":"LAM","chapter":3,"verses":[29]}]},{"label":"Dan 9:3","passages":[{"book":"DAN","chapter":9,"verses":[3]}]},{"label":"Mic 1:10","passages":[{"book":"MIC","chapter":1,"verses":[10]}]},{"label":"Matt 11:21","passages":[{"book":"MAT","chapter":11,"verses":[21]}]},{"label":"Luke 10:13","passages":[{"book":"LUK","chapter":10,"verses":[13]}]}],"verse":6},{"anchor":"issued a proclamation","refs":["Jonah 3:5","2 Chr 20:3","Ezra 8:21","Joel 2:15-16"],"sourceRowNumber":43603,"targets":[{"label":"Jonah 3:5","passages":[{"book":"JON","chapter":3,"verses":[5]}]},{"label":"2 Chr 20:3","passages":[{"book":"2CH","chapter":20,"verses":[3]}]},{"label":"Ezra 8:21","passages":[{"book":"EZR","chapter":8,"verses":[21]}]},{"label":"Joel 2:15-16","passages":[{"book":"JOL","chapter":2,"verses":[15,16]}]}],"verse":7},{"anchor":"man or beast, herd or flock","refs":["Joel 1:18","Rom 8:20-22"],"sourceRowNumber":43604,"targets":[{"label":"Joel 1:18","p