96968dd1b105ad643d55595d053e2565532b3b7ecee012c2d9ba3fd.json","title":"Nineveh, Ninevite*"},"PsalmsBookof":{"file":"dictionary/8701f5dabbe5f1d73c94a8c5c69f9c0f6cf4ece07a1f4dd71ef33b5d7b8a964b.json","title":"Psalms, Book of"},"Sackcloth":{"file":"dictionary/9c0c5642521c750957876e011e81f1cdfdca82a1c4140c3e1a1fd2a7d40e79d3.json","title":"Sackcloth"},"Throne":{"file":"dictionary/2f46e596272f05ecbc6d350e2603d9c432e989fc89526c9984c8cec2259ca671.json","title":"Throne"}},"dictionaryRelated":[{"id":"Ashes","title":"Ashes"},{"id":"GodBeingandAttributesof","title":"God, Being and Attributes of"},{"id":"JonahBookof","title":"Jonah, Book of"},{"id":"NinevehNinevite","title":"Nineveh, Ninevite*"},{"id":"PsalmsBookof","title":"Psalms, Book of"},{"id":"Sackcloth","title":"Sackcloth"},{"id":"Throne","title":"Throne"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_qualified_headword","phrase":"Jonah","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":3,"href":"?bref=Jon.3.4","rawReference":"Jon.3.4"}],"ruleId":"JonahPerson::Jonah::source_verse_citation","sourceHeadwordId":"JonahPerson"},"text":"On the first day of his journey, Jonah set out into the city and proclaimed, “Forty more days and Nineveh will be overturned!”","verse":4}],"id":"JonahPerson","label":"Jonah","matchReviews":[{"ruleId":"JonahPerson::Jonah::source_verse_citation","scope":"source_verse_citation","senseReview":"Original title explicitly labels the subject Person. This is a reviewed person headword, never a stripped book title; the original person article must cite the exact occurrence verse. Other people sharing the name are retained within the original multi-sense person article.","sourceHeadwordId":"JonahPerson","term":"Jonah"}],"matchingRule":"reviewed_qualified_headword","matchingRules":["reviewed_qualified_headword"],"sourceProvenanceId":"JonahPerson","sourceTitle":"Jonah (Person)"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Then the word of the LORD came to Jonah a second time:","verse":1},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"This time Jonah got up and went to Nineveh, in accordance with the word of the LORD. Now Nineveh was an exceedingly great city, requiring a three-day journey.","verse":3}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Jon.3.1-4.11","r":"Jon.3.1-4.11","rawR":"Jon.3.1-4.11","sourceRefs":[{"raw":"Jon.3.1-4.11","value":"Jon.3.1-4.11"}],"t":"ref","v":"3:1–4:11"}],"sourceClass":"sn-ref","t":"span"}," God again commands Jonah to preach to Nineveh. This time Jonah obeys, leading to an irony: The city repents, as Jonah had feared, and he is angry at God."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Jon.3.1-4.11","refs":[{"book":"JON","endChapter":4,"endVerse":11,"startChapter":3,"startVerse":1}],"sourceAttributes":{"name":"Jon.3.1-4.11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JON","sourceChapterCoverage":[3,4],"sourceItemFragmentSha256":"36450bd7f95b2b7d8704ec890f83a2d3b494344aeed589cd40c7221ca6002c1e","sourceItemName":"Jon.3.1-4.11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11230,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JON","canonicalOSIS":"Jonah","method":"official_book_intro_ref_title","sourceOSIS":"Jon"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"Jon.3.1-4.11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Jon.3.1-4.11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Jon.3.1-2","r":"Jon.3.1-2","rawR":"Jon.3.1-2","sourceRefs":[{"raw":"Jon.3.1-2","value":"Jon.3.1-2"}],"t":"ref","v":"3:1-2"}],"sourceClass":"sn-ref","t":"span"}," The second part of the book opens as the first part did (see ",{"href":"?bref=Jon.1.1-2","r":"Jon.1.1-2","rawR":"Jon.1.1-2","sourceRefs":[{"raw":"Jon.1.1-2","value":"Jon.1.1-2"}],"t":"ref","v":"1:1-2"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Jon.3.1-2","refs":[{"book":"JON","endChapter":3,"endVerse":2,"startChapter":3,"startVerse":1}],"sourceAttributes":{"name":"Jon.3.1-2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JON","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"e2d207d2f97851b003192a8a7cab30abe914ae77cecf1c29b00a0e7ae491e9c1","sourceItemName":"Jon.3.1-2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11231,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JON","canonicalOSIS":"Jonah","method":"official_book_intro_ref_title","sourceOSIS":"Jon"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"Jon.3.1-2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Jon.3.1-2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Jon.3.3","r":"Jon.3.3","rawR":"Jon.3.3","sourceRefs":[{"raw":"Jon.3.3","value":"Jon.3.3"}],"t":"ref","v":"3:3"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["a city so large that it took three days to see it all:"],"sourceClass":"sn-excerpt","t":"span"}," God desired to save rather than destroy such a vast city, one teeming with human and natural resources (",{"href":"?bref=Jon.4.11","r":"Jon.4.11","rawR":"Jon.4.11","sourceRefs":[{"raw":"Jon.4.11","value":"Jon.4.11"}],"t":"ref","v":"4:11"},"). This desire on God’s part was precisely what Jonah fought against (see ",{"href":"?bref=Jon.4.2","r":"Jon.4.2","rawR":"Jon.4.2","sourceRefs":[{"raw":"Jon.4.2","value":"Jon.4.2"}],"t":"ref","v":"4:2"},", ",{"href":"?bref=Jon.4.10-11","r":"Jon.4.10-11","rawR":"Jon.4.10-11","sourceRefs":[{"raw":"Jon.4.10-11","value":"Jon.4.10-11"}],"t":"ref","v":"10-11"},"). • The city’s circumference was roughly three miles, and it would not have taken three days to walk around it. This description possibly indicates how long it took Jonah to spread his message throughout the city. It might also include the surrounding villages along with the city."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Jon.3.3","refs":[{"book":"JON","endChapter":3,"endVerse":3,"startChapter":3,"startVerse":3}],"sourceAttributes":{"name":"Jon.3.3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JON","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"81bdb47a686532338810b814404db5f795e4d89943cfd0b6d07a9b82bb96a496","sourceItemName":"Jon.3.3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11232,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JON","canonicalOSIS":"Jonah","method":"official_book_intro_ref_title","sourceOSIS":"Jon"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"Jon.3.3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Jon.3.3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Jon.3.4","r":"Jon.3.4","rawR":"Jon.3.4","sourceRefs":[{"raw":"Jon.3.4","value":"Jon.3.4"}],"t":"ref","v":"3:4"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Forty days from now Nineveh will be destroyed!"],"sourceClass":"sn-excerpt","t":"span"}," Jonah’s message apparently did not include a contingency clause—e.g., “But if you repent, God will not destroy you” (note the king’s uncertainty in ",{"href":"?bref=Jon.3.9","r":"Jon.3.9","rawR":"Jon.3.9","sourceRefs":[{"raw":"Jon.3.9","value":"Jon.3.9"}],"t":"ref","v":"3:9"},"). Jonah knew, however, of God’s desire for people to repent rather than be destroyed (",{"href":"?bref=Jon.3.10","r":"Jon.3.10","rawR":"Jon.3.10","sourceRefs":[{"raw":"Jon.3.10","value":"Jon.3.10"}],"t":"ref","v":"3:10"},"; ",{"href":"?bref=Jon.4.2","r":"Jon.4.2","rawR":"Jon.4.2","sourceRefs":[{"raw":"Jon.4.2","value":"Jon.4.2"}],"t":"ref","v":"4:2"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Jon.3.4","refs":[{"book":"JON","endChapter":3,"endVerse":4,"startChapter":3,"startVerse":4}],"sourceAttributes":{"name":"Jon.3.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JON","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"12fb4fab2e548a02d08aef31aed503669801e4a289b03ada1f50a247725b9253","sourceItemName":"Jon.3.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11233,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JON","canonicalOSIS":"Jonah","method":"official_book_intro_ref_title","sourceOSIS":"Jon"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"Jon.3.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Jon.3.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Jon.3.5-6","r":"Jon.3.5-6","rawR":"Jon.3.5-6","sourceRefs":[{"raw":"Jon.3.5-6","value":"Jon.3.5-6"}],"t":"ref","v":"3:5-6"}],"sourceClass":"sn-ref","t":"span"}," For the second time in this short book, pagans respond favorably to the Lord (cp. ",{"href":"?bref=Jon.1.16","r":"Jon.1.16","rawR":"Jon.1.16","sourceRefs":[{"raw":"Jon.1.16","value":"Jon.1.16"}],"t":"ref","v":"1:16"},"). • In ancient Israel, fasting would often accompany prayer and repentance in times of distress (see ",{"href":"?bref=2Sam.1.12","r":"2Sam.1.12","rawR":"2Sam.1.12","sourceRefs":[{"raw":"2Sam.1.12","value":"2Sam.1.12"}],"t":"ref","v":"2 Sam 1:12"},"; ",{"href":"?bref=Neh.1.4","r":"Neh.1.4","rawR":"Neh.1.4","sourceRefs":[{"raw":"Neh.1.4","value":"Neh.1.4"}],"t":"ref","v":"Neh 1:4"},"). Wearing ",{"c":["burlap"],"sourceClass":"sn-excerpt","t":"span"}," and sitting on ",{"c":["a heap of ashes"],"sourceClass":"sn-excerpt","t":"span"}," would often accompany mourning and sorrowful repentance (see ",{"href":"?bref=Gen.37.34","r":"Gen.37.34","rawR":"Gen.37.34","sourceRefs":[{"raw":"Gen.37.34","value":"Gen.37.34"}],"t":"ref","v":"Gen 37:34"},"; ",{"href":"?bref=Job.16.15","r":"Job.16.15","rawR":"Job.16.15","sourceRefs":[{"raw":"Job.16.15","value":"Job.16.15"}],"t":"ref","v":"Job 16:15"},"; ",{"href":"?bref=Lam.2.10","r":"Lam.2.10","rawR":"Lam.2.10","sourceRefs":[{"raw":"Lam.2.10","value":"Lam.2.10"}],"t":"ref","v":"Lam 2:10"},"). The Assyrians apparently had similar customs. These activities allowed the participants to express their grief in a tangible way for all, including God, to see. • The repentance of the Ninevites was an indictment against the hard-hearted in Jesus’ day (",{"href":"?bref=Matt.12.41","r":"Matt.12.41","rawR":"Matt.12.41","sourceRefs":[{"raw":"Matt.12.41","value":"Matt.12.41"}],"t":"ref","v":"Matt 12:41"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Jon.3.5-6","refs":[{"book":"JON","endChapter":3,"endVerse":6,"startChapter":3,"startVerse":5}],"sourceAttributes":{"name":"Jon.3.5-6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JON","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"58c2d06f3dc5098286947098582f59e265dc698e25f953256427b021b52ea9ab","sourceItemName":"Jon.3.5-6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11234,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JON","canonicalOSIS":"Jonah","method":"official_book_intro_ref_title","sourceOSIS":"Jon"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"Jon.3.5-6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Jon.3.5-6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Jon.3.6","r":"Jon.3.6","rawR":"Jon.3.6","sourceRefs":[{"raw":"Jon.3.6","value":"Jon.3.6"}],"t":"ref","v":"3:6"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["king of Nineveh"],"sourceClass":"sn-excerpt","t":"span"}," was either an unknown governor of the city or perhaps the king of Assyria, who might have used Nineveh as a regular seat of government (cp. ",{"href":"?bref=2Kgs.19.9-13","r":"2Kgs.19.9-13","rawR":"2Kgs.19.9-13","sourceRefs":[{"raw":"2Kgs.19.9-13","value":"2Kgs.19.9-13"}],"t":"ref","v":"2 Kgs 19:9-13"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Jon.3.6","refs":[{"book":"JON","endChapter":3,"endVerse":6,"startChapter":3,"startVerse":6}],"sourceAttributes":{"name":"Jon.3.6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JON","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"a63436064547e567d8253b557d05fa55b0c71c294b75112d441eb432eeecf4ad","sourceItemName":"Jon.3.6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11235,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JON","canonicalOSIS":"Jonah","method":"official_book_intro_ref_title","sourceOSIS":"Jon"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"Jon.3.6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Jon.3.6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Jon.3.7-8","r":"Jon.3.7-8","rawR":"Jon.3.7-8","sourceRefs":[{"raw":"Jon.3.7-8","value":"Jon.3.7-8"}],"t":"ref","v":"3:7-8"}],"sourceClass":"sn-ref","t":"span"}," By extending the fast and the ",{"c":["mourning"],"sourceClass":"sn-excerpt","t":"span"}," rituals to animals, the king communicated that this dire emergency required all normal operations to cease so that everyone might pray earnestly and repent of ",{"c":["their evil ways"],"sourceClass":"sn-excerpt","t":"span"},". The ",{"c":["violence"],"sourceClass":"sn-excerpt","t":"span"}," that had come to permeate their society topped the list."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Jon.3.7-8","refs":[{"book":"JON","endChapter":3,"endVerse":8,"startChapter":3,"startVerse":7}],"sourceAttributes":{"name":"Jon.3.7-8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JON","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"e5cca88e9367556b4f94d3dccfe1b00e780abe6caac0595565cf38b01448619b","sourceItemName":"Jon.3.7-8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11236,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JON","canonicalOSIS":"Jonah","method":"official_book_intro_ref_title","sourceOSIS":"Jon"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"Jon.3.7-8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Jon.3.7-8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Jon.3.10","r":"Jon.3.10","rawR":"Jon.3.10","sourceRefs":[{"raw":"Jon.3.10","value":"Jon.3.10"}],"t":"ref","v":"3:10"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["he changed his mind:"],"sourceClass":"sn-excerpt","t":"span"}," Had the people of Nineveh not repented, God would have destroyed them (",{"href":"?bref=Jon.3.4","r":"Jon.3.4","rawR":"Jon.3.4","sourceRefs":[{"raw":"Jon.3.4","value":"Jon.3.4"}],"t":"ref","v":"3:4"},"). But God was ready to meet their repentance with mercy (see ",{"href":"?bref=Jon.4.2","r":"Jon.4.2","rawR":"Jon.4.2","sourceRefs":[{"raw":"Jon.4.2","value":"Jon.4.2"}],"t":"ref","v":"4:2"},", ",{"href":"?bref=Jon.4.11","r":"Jon.4.11","rawR":"Jon.4.11","sourceRefs":[{"raw":"Jon.4.11","value":"Jon.4.11"}],"t":"ref","v":"11"},"). In God’s mind, the change did not reverse his original intention, because his disposition always included the possibility of mercy. Nor does this change in God’s mind say anything about God’s foreknowledge. Historically, the church has believed that God knows the future fully (see ",{"href":"?bref=Ps.139.4","r":"Ps.139.4","rawR":"Ps.139.4","sourceRefs":[{"raw":"Ps.139.4","value":"Ps.139.4"}],"t":"ref","v":"Ps 139:4"},"; ",{"href":"?bref=Isa.46.10","r":"Isa.46.10","rawR":"Isa.46.10","sourceRefs":[{"raw":"Isa.46.10","value":"Isa.46.10"}],"t":"ref","v":"Isa 46:10"},"; ",{"href":"?bref=Dan.2.28-29","r":"Dan.2.28-29","rawR":"Dan.2.28-29","sourceRefs":[{"raw":"Dan.2.28-29","value":"Dan.2.28-29"}],"t":"ref","v":"Dan 2:28-29"},"; ",{"href":"?bref=Matt.24.36","r":"Matt.24.36","rawR":"Matt.24.36","sourceRefs":[{"raw":"Matt.24.36","value":"Matt.24.36"}],"t":"ref","v":"Matt 24:36"},"). Nothing in this account contradicts that belief."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Jon.3.10","refs":[{"book":"JON","endChapter":3,"endVerse":10,"startChapter":3,"startVerse":10}],"sourceAttributes":{"name":"Jon.3.10","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JON","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"b5f540bd0803028cbb858d9ab8616242bda48181e277b8df2d7689ec6266621c","sourceItemName":"Jon.3.10","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":11237,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JON","canonicalOSIS":"Jonah","method":"official_book_intro_ref_title","sourceOSIS":"Jon"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"Jon.3.10","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Jon.3.10","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}