tify a named person, people, or place. Promotion requires a capitalized whole name and the original article explicitly citing this same BSB verse. No arbitrary qualifier stripping or book-title inference. This citation-constrained rule was reviewed once globally; unmatched contexts remain excluded.","sourceHeadwordId":"Uri","term":"Uri"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Uri","sourceTitle":"Uri"},{"evidence":[{"matchingRule":"source_verified_redirect","phrase":"wave offering","senseEvidence":{"basis":"reviewed_publisher_redirect","originalCitations":[],"ruleId":"OfferingsandSacrifices::Wave Offering::reviewed_publisher_redirect","sourceHeadwordId":"WaveOffering"},"text":"All the gold from the wave offering used for the work on the sanctuary totaled 29 talents and 730 shekels, according to the sanctuary shekel.","verse":24},{"matchingRule":"source_verified_redirect","phrase":"wave offering","senseEvidence":{"basis":"reviewed_publisher_redirect","originalCitations":[],"ruleId":"OfferingsandSacrifices::Wave Offering::reviewed_publisher_redirect","sourceHeadwordId":"WaveOffering"},"text":"The bronze from the wave offering totaled 70 talents and 2,400 shekels.","verse":29}],"id":"OfferingsandSacrifices","label":"wave offering","matchReviews":[{"ruleId":"OfferingsandSacrifices::Wave Offering::reviewed_publisher_redirect","scope":"reviewed_publisher_redirect","senseReview":"The original publisher explicitly links this complete unambiguous name/phrase to this target. Redirect and target were reviewed once; actual BSB phrase and full word boundaries required. Target original title and complete article remain unchanged.","sourceHeadwordId":"WaveOffering","term":"Wave Offering"}],"matchingRule":"source_verified_redirect","matchingRules":["source_verified_redirect"],"sourceProvenanceId":"OfferingsandSacrifices","sourceTitle":"Offerings and Sacrifices"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Exod.38.1-20","r":"Exod.38.1-20","rawR":"Exod.38.1-20","sourceRefs":[{"raw":"Exod.38.1-20","value":"Exod.38.1-20"}],"t":"ref","v":"38:1-20"}],"sourceClass":"sn-ref","t":"span"}," This section reports on building the courtyard (",{"href":"?bref=Exod.38.9-20","r":"Exod.38.9-20","rawR":"Exod.38.9-20","sourceRefs":[{"raw":"Exod.38.9-20","value":"Exod.38.9-20"}],"t":"ref","v":"38:9-20"},") and its equipment, including the altar of burnt offering (",{"href":"?bref=Exod.38.1-7","r":"Exod.38.1-7","rawR":"Exod.38.1-7","sourceRefs":[{"raw":"Exod.38.1-7","value":"Exod.38.1-7"}],"t":"ref","v":"38:1-7"},") and the washbasin (",{"href":"?bref=Exod.38.8","r":"Exod.38.8","rawR":"Exod.38.8","sourceRefs":[{"raw":"Exod.38.8","value":"Exod.38.8"}],"t":"ref","v":"38:8"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Exod.38.1-20","refs":[{"book":"EXO","endChapter":38,"endVerse":20,"startChapter":38,"startVerse":1}],"sourceAttributes":{"name":"Exod.38.1-20","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"EXO","sourceChapterCoverage":[38],"sourceItemFragmentSha256":"1239c03f8fe2cc706af2d02c5459ed590fd1fc7953e465605ac8b35b81efc421","sourceItemName":"Exod.38.1-20","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1223,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"EXO","canonicalOSIS":"Exod","method":"official_book_intro_ref_title","sourceOSIS":"Exod"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Exod.38.1-20","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Exod.38.1-20","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Exod.38.8","r":"Exod.38.8","rawR":"Exod.38.8","sourceRefs":[{"raw":"Exod.38.8","value":"Exod.38.8"}],"t":"ref","v":"38:8"}],"sourceClass":"sn-ref","t":"span"}," While the plans for the ",{"c":["washbasin"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=Exod.30.17-21","r":"Exod.30.17-21","rawR":"Exod.30.17-21","sourceRefs":[{"raw":"Exod.30.17-21","value":"Exod.30.17-21"}],"t":"ref","v":"30:17-21"},") were included in the instructions to the priests (",{"href":"?bref=Exod.29.38-30","r":"Exod.29.38-30","rawR":"Exod.29.38-30","sourceRefs":[{"raw":"Exod.29.38-30","value":"Exod.29.38-30"}],"t":"ref","v":"29:38–30:38"},"), here its construction is reported in logical sequence. • This ",{"c":["bronze"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," which could be polished to a mirror-like finish, was probably of especially high quality, as was fitting for use in God’s Tabernacle."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Exod.38.8","refs":[{"book":"EXO","endChapter":38,"endVerse":8,"startChapter":38,"startVerse":8}],"sourceAttributes":{"name":"Exod.38.8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"EXO","sourceChapterCoverage":[38],"sourceItemFragmentSha256":"6d207c34cf0559221dfc76955ffcbd716d2e47d1d080bc526e5904c0ff7a40ca","sourceItemName":"Exod.38.8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1224,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"EXO","canonicalOSIS":"Exod","method":"official_book_intro_ref_title","sourceOSIS":"Exod"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Exod.38.8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Exod.38.8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Exod.38.21-29","r":"Exod.38.21-29","rawR":"Exod.38.21-29","sourceRefs":[{"raw":"Exod.38.21-29","value":"Exod.38.21-29"}],"t":"ref","v":"38:21-29"}],"sourceClass":"sn-ref","t":"span"}," The immense amount of metal reported in this inventory of materials (more than a ton of ",{"c":["gold"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," almost four tons of ",{"c":["silver"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," and two and a half tons of ",{"c":["bronze"],"sourceClass":"sn-excerpt","t":"span"},") reflects the Egyptians’ eagerness to get the Israelites out of Egypt, giving the Israelites anything they asked for in order to hurry them on their way (see ",{"href":"?bref=Exod.12.35-36","r":"Exod.12.35-36","rawR":"Exod.12.35-36","sourceRefs":[{"raw":"Exod.12.35-36","value":"Exod.12.35-36"}],"t":"ref","v":"12:35-36"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Exod.38.21-29","refs":[{"book":"EXO","endChapter":38,"endVerse":29,"startChapter":38,"startVerse":21}],"sourceAttributes":{"name":"Exod.38.21-29","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"EXO","sourceChapterCoverage":[38],"sourceItemFragmentSha256":"b9a8db2ea12d581dd37e3da877e6dfd7f003fa19bd1ce01e4268afe732b440cb","sourceItemName":"Exod.38.21-29","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1225,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"EXO","canonicalOSIS":"Exod","method":"official_book_intro_ref_title","sourceOSIS":"Exod"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Exod.38.21-29","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Exod.38.21-29","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Exod.38.21","r":"Exod.38.21","rawR":"Exod.38.21","sourceRefs":[{"raw":"Exod.38.21","value":"Exod.38.21"}],"t":"ref","v":"38:21"}],"sourceClass":"sn-ref","t":"span"}," Since the Tabernacle contained the Ark of the Covenant, it is called the ",{"c":["Tabernacle of the Covenant"],"sourceClass":"sn-excerpt","t":"span"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Exod.38.21","refs":[{"book":"EXO","endChapter":38,"endVerse":21,"startChapter":38,"startVerse":21}],"sourceAttributes":{"name":"Exod.38.21","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"EXO","sourceChapterCoverage":[38],"sourceItemFragmentSha256":"85c5a89817c60f570b953d80b0300cac7d129e3b381bb2e95fb162d7266b6814","sourceItemName":"Exod.38.21","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1226,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"EXO","canonicalOSIS":"Exod","method":"official_book_intro_ref_title","sourceOSIS":"Exod"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Exod.38.21","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Exod.38.21","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Exod.38.26","r":"Exod.38.26","rawR":"Exod.38.26","sourceRefs":[{"raw":"Exod.38.26","value":"Exod.38.26"}],"t":"ref","v":"38:26"}],"sourceClass":"sn-ref","t":"span"}," For the earlier discussion of this ",{"c":["tax"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," see ",{"href":"?bref=Exod.30.11-16","r":"Exod.30.11-16","rawR":"Exod.30.11-16","sourceRefs":[{"raw":"Exod.30.11-16","value":"Exod.30.11-16"}],"t":"ref","v":"30:11-16"},". The ",{"c":["sanctuary shekel"],"sourceClass":"sn-excerpt","t":"span"}," was evidently the standard against which other weights were measured for accuracy. • ",{"c":["603,550:"],"sourceClass":"sn-excerpt","t":"span"}," See ",{"href":"?item=Exod.12.37_StudyNote_Filament","id":"Exod.12.37_StudyNote_Filament","rawId":"Exod.12.37_StudyNote_Filament","t":"link","v":"study note on 12:37"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Exod.38.26","refs":[{"book":"EXO","endChapter":38,"endVerse":26,"startChapter":38,"startVerse":26}],"sourceAttributes":{"name":"Exod.38.26","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"EXO",