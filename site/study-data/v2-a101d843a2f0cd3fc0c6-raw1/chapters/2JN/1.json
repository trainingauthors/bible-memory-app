_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Peace","sourceTitle":"Peace"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Jn.1.1-3","r":"2Jn.1.1-3","rawR":"2Jn.1.1-3","sourceRefs":[{"raw":"2Jn.1.1-3","value":"2Jn.1.1-3"}],"t":"ref","v":"1:1-3"}],"sourceClass":"sn-ref","t":"span"}," John begins with a standard introduction for a personal letter. • John mentions ",{"c":["truth"],"sourceClass":"sn-excerpt","t":"span"}," four times in this brief introduction and once in ",{"href":"?bref=2Jn.1.4","r":"2Jn.1.4","rawR":"2Jn.1.4","sourceRefs":[{"raw":"2Jn.1.4","value":"2Jn.1.4"}],"t":"ref","v":"1:4"},". John wanted his readers to know and live out the truths about ",{"c":["Jesus Christ"],"sourceClass":"sn-excerpt","t":"span"}," and their relationship with him and not to be led astray by false teachers."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIJn.1.1-3","refs":[{"book":"2JN","endChapter":1,"endVerse":3,"startChapter":1,"startVerse":1}],"sourceAttributes":{"name":"IIJn.1.1-3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2JN","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"071179e3c57bd04c6d774d0c82e290e21212f1e047c498d9c92b79b716bd00cc","sourceItemName":"IIJn.1.1-3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16513,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2JN","canonicalOSIS":"2John","method":"official_book_intro_ref_title","sourceOSIS":"2Jn"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"2Jn.1.1-3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIJn.1.1-3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Jn.1.1","r":"2Jn.1.1","rawR":"2Jn.1.1","sourceRefs":[{"raw":"2Jn.1.1","value":"2Jn.1.1"}],"t":"ref","v":"1:1"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["This letter is from John, the elder:"],"sourceClass":"sn-excerpt","t":"span"}," The translators have added ",{"c":["John"],"sourceClass":"ital","t":"span"}," for clarification; John refers to himself as ",{"c":["the elder"],"sourceClass":"ital","t":"span"}," to affirm his authority in the church. • ",{"c":["to the chosen lady"],"sourceClass":"sn-excerpt","t":"span"}," (Greek ",{"c":["kuria"],"sourceClass":"greek","t":"span"},") ",{"c":["and to her children:"],"sourceClass":"sn-excerpt","t":"span"}," The Greek word ",{"c":["kuria"],"sourceClass":"greek","t":"span"}," could be the name of a specific individual; more likely, it refers to a particular local church and its believers (cp. ",{"href":"?bref=2Jn.1.13","r":"2Jn.1.13","rawR":"2Jn.1.13","sourceRefs":[{"raw":"2Jn.1.13","value":"2Jn.1.13"}],"t":"ref","v":"1:13"},"). • ",{"c":["whom I love in the truth:"],"sourceClass":"sn-excerpt","t":"span"}," This either means “truly love” (see ",{"href":"?bref=2Jn.1.5-6","r":"2Jn.1.5-6","rawR":"2Jn.1.5-6","sourceRefs":[{"raw":"2Jn.1.5-6","value":"2Jn.1.5-6"}],"t":"ref","v":"1:5-6"},") or, more likely, it refers to love between those who profess the same truth about Christ in contrast to the lies of the false teachers (",{"href":"?bref=2Jn.1.7","r":"2Jn.1.7","rawR":"2Jn.1.7","sourceRefs":[{"raw":"2Jn.1.7","value":"2Jn.1.7"}],"t":"ref","v":"1:7"},"; see ",{"href":"?bref=1Jn.2.21-23","r":"1Jn.2.21-23","rawR":"1Jn.2.21-23","sourceRefs":[{"raw":"1Jn.2.21-23","value":"1Jn.2.21-23"}],"t":"ref","v":"1 Jn 2:21-23"},"). John emphasizes the pronoun ",{"c":["I"],"sourceClass":"ital","t":"span"}," to contrast sharply with the lovelessness of the false teachers, who rejected the true church."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIJn.1.1","refs":[{"book":"2JN","endChapter":1,"endVerse":1,"startChapter":1,"startVerse":1}],"sourceAttributes":{"name":"IIJn.1.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2JN","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"e643398f4facd35403048c110d53b99d6909271495771884d0819fe2eaaf73d3","sourceItemName":"IIJn.1.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16514,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2JN","canonicalOSIS":"2John","method":"official_book_intro_ref_title","sourceOSIS":"2Jn"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"2Jn.1.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIJn.1.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Jn.1.2","r":"2Jn.1.2","rawR":"2Jn.1.2","sourceRefs":[{"raw":"2Jn.1.2","value":"2Jn.1.2"}],"t":"ref","v":"1:2"}],"sourceClass":"sn-ref","t":"span"}," Christian love is rooted in knowing ",{"c":["the truth"],"sourceClass":"sn-excerpt","t":"span"},". The truth that ",{"c":["lives in us"],"sourceClass":"sn-excerpt","t":"span"}," is more than just facts or doctrine; it is the presence of God (see ",{"href":"?bref=John.14.15-17","r":"John.14.15-17","rawR":"John.14.15-17","sourceRefs":[{"raw":"John.14.15-17","value":"John.14.15-17"}],"t":"ref","v":"John 14:15-17"},"), who ",{"c":["will be with us forever"],"sourceClass":"sn-excerpt","t":"span"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIJn.1.2","refs":[{"book":"2JN","endChapter":1,"endVerse":2,"startChapter":1,"startVerse":2}],"sourceAttributes":{"name":"IIJn.1.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2JN","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"b7e0b4364bf9911cf11a5991bc08fc4558a28e8a8ce56d759ed1b55cc80f7276","sourceItemName":"IIJn.1.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16515,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2JN","canonicalOSIS":"2John","method":"official_book_intro_ref_title","sourceOSIS":"2Jn"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"2Jn.1.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIJn.1.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Jn.1.3","r":"2Jn.1.3","rawR":"2Jn.1.3","sourceRefs":[{"raw":"2Jn.1.3","value":"2Jn.1.3"}],"t":"ref","v":"1:3"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Grace, mercy, and peace"],"sourceClass":"sn-excerpt","t":"span"}," are blessings of which John is confident for those ",{"c":["who live in truth and love"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," and who demonstrate by their actions that they are God’s children."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIJn.1.3","refs":[{"book":"2JN","endChapter":1,"endVerse":3,"startChapter":1,"startVerse":3}],"sourceAttributes":{"name":"IIJn.1.3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2JN","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"cb4760ad1a22fd8c683b1ec0576772e04d8d2a50d17892be1412c062f4ec5692","sourceItemName":"IIJn.1.3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16516,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2JN","canonicalOSIS":"2John","method":"official_book_intro_ref_title","sourceOSIS":"2Jn"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"2Jn.1.3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIJn.1.3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Jn.1.4-11","r":"2Jn.1.4-11","rawR":"2Jn.1.4-11","sourceRefs":[{"raw":"2Jn.1.4-11","value":"2Jn.1.4-11"}],"t":"ref","v":"1:4-11"}],"sourceClass":"sn-ref","t":"span"}," John now applies the truth and love that he mentioned in the introduction (",{"href":"?bref=2Jn.1.1-3","r":"2Jn.1.1-3","rawR":"2Jn.1.1-3","sourceRefs":[{"raw":"2Jn.1.1-3","value":"2Jn.1.1-3"}],"t":"ref","v":"1:1-3"},") to the readers’ situation. Living in truth and love means maintaining fellowship with true Christians (",{"href":"?bref=2Jn.1.4-6","r":"2Jn.1.4-6","rawR":"2Jn.1.4-6","sourceRefs":[{"raw":"2Jn.1.4-6","value":"2Jn.1.4-6"}],"t":"ref","v":"1:4-6"},"), but also discerning false teachers and refusing to listen to them or help them (",{"href":"?bref=2Jn.1.7-11","r":"2Jn.1.7-11","rawR":"2Jn.1.7-11","sourceRefs":[{"raw":"2Jn.1.7-11","value":"2Jn.1.7-11"}],"t":"ref","v":"1:7-11"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIJn.1.4-11","refs":[{"book":"2JN","endChapter":1,"endVerse":11,"startChapter":1,"startVerse":4}],"sourceAttributes":{"name":"IIJn.1.4-11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2JN","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"2e52493d44ea0332732a90cd5501af2a870ed2c4f9bc719894c1e917883d2647","sourceItemName":"IIJn.1.4-11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16517,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2JN","canonicalOSIS":"2John","method":"official_book_intro_ref_title","sourceOSIS":"2Jn"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"2Jn.1.4-11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIJn.1.4-11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Jn.1.5","r":"2Jn.1.5","rawR":"2Jn.1.5","sourceRefs":[{"raw":"2Jn.1.5","value":"2Jn.1.5"}],"t":"ref","v":"1:5"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["I am writing to remind you, dear friends:"],"sourceClass":"sn-excerpt","t":"span"}," Literally ",{"c":["I urge you, lady."],"sourceClass":"ital","t":"span"}," See ",{"href":"?item=IIJn.1.1_StudyNote_Filament","id":"IIJn.1.1_StudyNote_Filament","rawId":"IIJn.1.1_StudyNote_Filament","t":"link","v":"study note on 1:1"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIJn.1.5","refs":[{"book":"2JN","endChapter":1,"endVerse":5,"startChapter":1,"startVerse":5}],"sourceAttributes":{"name":"IIJn.1.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2JN","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"3a3da900f9505239c83664402f5f079243dad78a46465ea2826c0fae9873d946","sourceItemName":"IIJn.1.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16518,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2JN","canonicalOSIS":"2John","method":"official_book_intro_ref_title","sourceOSIS":"2Jn"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"2Jn.1.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIJn.1.5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Jn.1.7","r":"2Jn.1.7","rawR":"2Jn.1.7","sourceRefs":[{"raw":"2Jn.1.7","value":"2Jn.1.7"}],"t":"ref","v":"1:7"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["many deceivers have gone out into the world:"],"sourceClass":"sn-excerpt","t":"span"}," Docetists were denying that Jesus Christ came in a real body. John refuted this heresy in his first letter (see ",{"href":"?bref=1Jn.4.2-3","r":"1Jn.4.2-3","rawR":"1Jn.4.2-3","sourceRefs":[{"raw":"1Jn.4.2-3","value":"1Jn.4.2-3"}],"t":"ref","v":"1 Jn 4:2-3"},"). • A false teacher is ",{"c":["a deceiver"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," because they mislead unwary believers, ",{"c":["and an antichrist"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," because they distract and lead people away from the true Christ. By using the apocalyptic symbol of the antichrist, John signals the severity of the heresy and the ultimate judgment upon false teachers."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIJn.1.7","refs":[{"book":"2JN","endChapter":1,"endVerse":7,"startChapter":1,"startVerse":7}],"sourceAttributes":{"name":"IIJn.1.7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2JN","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"d0ea5e96d74126f213f02889f0afac174b8c852791a85f26b6c6ce74fbc06571","sourceItemName":"IIJn.1.7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16519,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2JN","canonicalOSIS":"2John","method":"official_book_intro_ref_title","sourceOSIS":"2Jn"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"2Jn.1.7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIJn.1.7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Jn.1.8","r":"2Jn.1.8","rawR":"2Jn.1.8","sourceRefs":[{"raw":"2Jn.1.8","value":"2Jn.1.8"}],"t":"ref","v":"1:8"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["we:"],"sourceClass":"sn-excerpt","t":"span"}," This word refers to the apostles and their co-workers. The apostles taught the truth and defended it against heresies, and believers (referred to as ",{"c":["you"],"sourceClass":"sn-excerpt","t":"span"},") are admonished to protect their faith from teaching that could destroy them (",{"href":"?bref=2Jn.1.9","r":"2Jn.1.9","rawR":"2Jn.1.9","sourceRefs":[{"raw":"2Jn.1.9","value":"2Jn.1.9"}],"t":"ref","v":"1:9"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIJn.1.8","refs":[{"book":"2JN","endChapter":1,"endVerse":8,"startChapter":1,"startVerse":8}],"sourceAttributes":{"name":"IIJn.1.8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2JN","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"d60c3b431b87b744e588393792b706bff0deba386b48f7c87af2552b13e864b5","sourceItemName":"IIJn.1.8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16520,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2JN","canonicalOSIS":"2John","method":"official_book_intro_ref_title","sourceOSIS":"2Jn"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"2Jn.1.8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIJn.1.8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Jn.1.9","r":"2Jn.1.9","rawR":"2Jn.1.9","sourceRefs":[{"raw":"2Jn.1.9","value":"2Jn.1.9"}],"t":"ref","v":"1:9"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Anyone who wanders away from this teaching"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["everyone going beyond and not remaining in the teaching"],"sourceClass":"ital","t":"span"},"): To ",{"c":["go beyond"],"sourceClass":"ital","t":"span"}," is to contradict the apostolic teachings about Jesus Christ and believe things about Jesus that were not taught by the apostles. This is a warning to the church not to listen to the false teachers."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIJn.1.9","refs":[{"book":"2JN","endChapter":1,"endVerse":9,"startChapter":1,"startVerse":9}],"sourceAttributes":{"name":"IIJn.1.9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2JN","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"c635f14365468a6d938000e235596c6a3089c5f7c37fcfb0b79da6ba2ced3b5f","sourceItemName":"IIJn.1.9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16521,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2JN","canonicalOSIS":"2John","method":"official_book_intro_ref_title","sourceOSIS":"2Jn"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"2Jn.1.9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIJn.1.9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Jn.1.10-11","r":"2Jn.1.10-11","rawR":"2Jn.1.10-11","sourceRefs":[{"raw":"2Jn.1.10-11","value":"2Jn.1.10-11"}],"t":"ref","v":"1:10-11"}],"sourceClass":"sn-ref","t":"span"}," Believers should not ",{"c":["invite that person"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," who does not teach the truth about Christ, into their homes. The early churches met in homes (see ",{"href":"?bref=Acts.2.46","r":"Acts.2.46","rawR":"Acts.2.46","sourceRefs":[{"raw":"Acts.2.46","value":"Acts.2.46"}],"t":"ref","v":"Acts 2:46"},"; ",{"href":"?bref=Acts.5.42","r":"Acts.5.42","rawR":"Acts.5.42","sourceRefs":[{"raw":"Acts.5.42","value":"Acts.5.42"}],"t":"ref","v":"5:42"},"; ",{"href":"?bref=Acts.8.3","r":"Acts.8.3","rawR":"Acts.8.3","sourceRefs":[{"raw":"Acts.8.3","value":"Acts.8.3"}],"t":"ref","v":"8:3"},"; ",{"href":"?bref=Acts.12.5","r":"Acts.12.5","rawR":"Acts.12.5","sourceRefs":[{"raw":"Acts.12.5","value":"Acts.12.5"}],"t":"ref","v":"12:5"},", ",{"href":"?bref=Acts.12.12","r":"Acts.12.12","rawR":"Acts.12.12","sourceRefs":[{"raw":"Acts.12.12","value":"Acts.12.12"}],"t":"ref","v":"12"},"; ",{"href":"?bref=Col.4.15","r":"Col.4.15","rawR":"Col.4.15","sourceRefs":[{"raw":"Col.4.15","value":"Col.4.15"}],"t":"ref","v":"Col 4:15"},"; ",{"href":"?bref=Phlm.1.2","r":"Phlm.1.2","rawR":"Phlm.1.2","sourceRefs":[{"raw":"Phlm.1.2","value":"Phlm.1.2"}],"t":"ref","v":"Phlm 1:2"},"), so this could refer to inviting false teachers to a meeting of the church. It could also refer to giving any form of hospitality to false teachers, which would help their mission. The only way to deal with them was to not accept them into the fellowship."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIJn.1.10-11","refs":[{"book":"2JN","endChapter":1,"endVerse":11,"startChapter":1,"startVerse":10}],"sourceAttributes":{"name":"IIJn.1.10-11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2JN","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"52f61802a30a1c9b9558a800dcd9d4ae511535eeba287d2699120b79caa11258","sourceItemName":"IIJn.1.10-11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16522,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2JN","canonicalOSIS":"2John","method":"official_book_intro_ref_title","sourceOSIS":"2Jn"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"2Jn.1.10-11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIJn.1.10-11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Jn.1.12","r":"2Jn.1.12","rawR":"2Jn.1.12","sourceRefs":[{"raw":"2Jn.1.12","value":"2Jn.1.12"}],"t":"ref","v":"1:12"}],"sourceClass":"sn-ref","t":"span"}," Our English idiom ",{"c":["face to face"],"sourceClass":"sn-excerpt","t":"span"}," has the same meaning as the Greek idiom used here (literally ",{"c":["mouth to mouth;"],"sourceClass":"ital","t":"span"}," see also ",{"href":"?bref=3Jn.1.14","r":"3Jn.1.14","rawR":"3Jn.1.14","sourceRefs":[{"raw":"3Jn.1.14","value":"3Jn.1.14"}],"t":"ref","v":"3 Jn 1:14"},"). • ",{"c":["Then our joy will be complete:"],"sourceClass":"sn-excerpt","t":"span"}," Our relationship with Christ is not merely a private experience; we experience the fullest joy in harmonious fellowship with other believers."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIJn.1.12","refs":[{"book":"2JN","endChapter":1,"endVerse":12,"startChapter":1,"startVerse":12}],"sourceAttributes":{"name":"IIJn.1.12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2JN","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"c0f7e6e537da2b63a63ffcb9e9bc2ec3af5ea3422bcd19a636bd4a6ad75780aa","sourceItemName":"IIJn.1.12","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16523,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2JN","canonicalOSIS":"2John","method":"official_book_intro_ref_title","sourceOSIS":"2Jn"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"2Jn.1.12","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIJn.1.12","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Jn.1.13","r":"2Jn.1.13","rawR":"2Jn.1.13","sourceRefs":[{"raw":"2Jn.1.13","value":"2Jn.1.13"}],"t":"ref","v":"1:13"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["from the children of your sister:"],"sourceClass":"sn-excerpt","t":"span"}," This probably refers to the sister church in Ephesus and its members, with whom John was staying (see ",{"href":"?bref=2Jn.1.1","r":"2Jn.1.1","rawR":"2Jn.1.1","sourceRefs":[{"raw":"2Jn.1.1","value":"2Jn.1.1"}],"t":"ref","v":"1:1"},"). John lived in that region and cared for several churches."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIJn.1.13","refs":[{"book":"2JN","endChapter":1,"endVerse":13,"startChapter":1,"startVerse":13}],"sourceAttributes":{"name":"IIJn.1.13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2JN","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"2a8dd7b471532178c2767b0ee9fd236c94a5ba34438bdd7626ead0353b8cda0f","sourceItemName":"IIJn.1.13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16524,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2JN","canonicalOSIS":"2John","method":"official_book_intro_ref_title","sourceOSIS":"2Jn"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"2Jn.1.13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIJn.1.13","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}