::Mephibosheth::source_verse_citation","sourceHeadwordId":"Mephibosheth"},"text":"And Mephibosheth had a young son named Mica, and all who dwelt in the house of Ziba were servants of Mephibosheth.","verse":12},{"matchingRule":"reviewed_exact_headword","phrase":"Mephibosheth","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":8,"href":"?bref=2Sam.9.1-13","rawReference":"2Sam.9.1-13"}],"ruleId":"Mephibosheth::Mephibosheth::source_verse_citation","sourceHeadwordId":"Mephibosheth"},"text":"So Mephibosheth lived in Jerusalem, because he always ate at the king’s table, and he was lame in both feet.","verse":13}],"id":"Mephibosheth","label":"Mephibosheth","matchReviews":[{"ruleId":"Mephibosheth::Mephibosheth::source_verse_citation","scope":"source_verse_citation","senseReview":"Original complete headword and source opening identify a named person, people, or place. Promotion requires a capitalized whole name and the original article explicitly citing this same BSB verse. No arbitrary qualifier stripping or book-title inference. This citation-constrained rule was reviewed once globally; unmatched contexts remain excluded.","sourceHeadwordId":"Mephibosheth","term":"Mephibosheth"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Mephibosheth","sourceTitle":"Mephibosheth"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Saul","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Saul::Saul::reviewed_unambiguous_name","sourceHeadwordId":"Saul"},"text":"Then David asked, “Is there anyone left from the house of Saul to whom I can show kindness for the sake of Jonathan?”","verse":1},{"matchingRule":"reviewed_exact_headword","phrase":"Saul","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Saul::Saul::reviewed_unambiguous_name","sourceHeadwordId":"Saul"},"text":"And there was a servant of the house of Saul named Ziba. They summoned him to David, and the king inquired, “Are you Ziba?” “I am your servant,” he replied.","verse":2},{"matchingRule":"reviewed_exact_headword","phrase":"Saul","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Saul::Saul::reviewed_unambiguous_name","sourceHeadwordId":"Saul"},"text":"So the king asked, “Is there anyone left of the house of Saul to whom I can show the kindness of God?” Ziba answered, “There is still Jonathan’s son, who is lame in both feet.”","verse":3},{"matchingRule":"reviewed_exact_headword","phrase":"Saul","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Saul::Saul::reviewed_unambiguous_name","sourceHeadwordId":"Saul"},"text":"And when Mephibosheth son of Jonathan, the son of Saul, came to David, he fell facedown in reverence. Then David said, “Mephibosheth!” “I am your servant,” he replied.","verse":6},{"matchingRule":"reviewed_exact_headword","phrase":"Saul","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Saul::Saul::reviewed_unambiguous_name","sourceHeadwordId":"Saul"},"text":"“Do not be afraid,” said David, “for surely I will show you kindness for the sake of your father Jonathan. I will restore to you all the land of your grandfather Saul, and you will always eat at my table.”","verse":7},{"matchingRule":"reviewed_exact_headword","phrase":"Saul","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Saul::Saul::reviewed_unambiguous_name","sourceHeadwordId":"Saul"},"text":"Then the king summoned Saul’s servant Ziba and said to him, “I have given to your master’s grandson all that belonged to Saul and to all his house.","verse":9}],"id":"Saul","label":"Saul","matchReviews":[{"ruleId":"Saul::Saul::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Saul","term":"Saul"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Saul","sourceTitle":"Saul"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Sam.9.1-13","r":"2Sam.9.1-13","rawR":"2Sam.9.1-13","sourceRefs":[{"raw":"2Sam.9.1-13","value":"2Sam.9.1-13"}],"t":"ref","v":"9:1-13"}],"sourceClass":"sn-ref","t":"span"}," David showed mercy to Mephibosheth, Jonathan’s crippled son. The incident is sandwiched between David’s victories in battle (",{"href":"?bref=2Sam.8.1-18","r":"2Sam.8.1-18","rawR":"2Sam.8.1-18","sourceRefs":[{"raw":"2Sam.8.1-18","value":"2Sam.8.1-18"}],"t":"ref","v":"8:1-18"},", ",{"href":"?bref=2Sam.8.10","r":"2Sam.8.10","rawR":"2Sam.8.10","sourceRefs":[{"raw":"2Sam.8.10","value":"2Sam.8.10"}],"t":"ref","v":"10"},"), indicating that David also had concern for individuals and a compassionate heart."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IISam.9.1-13","refs":[{"book":"2SA","endChapter":9,"endVerse":13,"startChapter":9,"startVerse":1}],"sourceAttributes":{"name":"IISam.9.1-13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2SA","sourceChapterCoverage":[9],"sourceItemFragmentSha256":"ee71ce17d64626b21287ab7d1dc524a0aed4163c1980b8824c0ef5a568d12b60","sourceItemName":"IISam.9.1-13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":3807,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2SA","canonicalOSIS":"2Sam","method":"official_book_intro_ref_title","sourceOSIS":"2Sam"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Sam.9.1-13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IISam.9.1-13","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Sam.9.1","r":"2Sam.9.1","rawR":"2Sam.9.1","sourceRefs":[{"raw":"2Sam.9.1","value":"2Sam.9.1"}],"t":"ref","v":"9:1"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["show kindness:"],"sourceClass":"sn-excerpt","t":"span"}," The Hebrew word (",{"c":["khesed"],"sourceClass":"hebrew","t":"span"},") speaks of covenant loyalty and faithfulness. The word frequently describes God’s commitment to his people, but it can also describe the devotion and loyalty between any two persons. David’s use of the word here echoes the language of the covenant of friendship between himself and Jonathan (",{"href":"?bref=1Sam.20.12-17","r":"1Sam.20.12-17","rawR":"1Sam.20.12-17","sourceRefs":[{"raw":"1Sam.20.12-17","value":"1Sam.20.12-17"}],"t":"ref","v":"1 Sam 20:12-17"},"). • ",{"c":["for Jonathan’s sake:"],"sourceClass":"sn-excerpt","t":"span"}," Mephibosheth was Saul’s only remaining descendant and the only son of Jonathan."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IISam.9.1","refs":[{"book":"2SA","endChapter":9,"endVerse":1,"startChapter":9,"startVerse":1}],"sourceAttributes":{"name":"IISam.9.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2SA","sourceChapterCoverage":[9],"sourceItemFragmentSha256":"8a0e1c3ea947528c7c61e6a1c73f5836fc95c3b1fd2237dcd17c13ca8dd66cdd","sourceItemName":"IISam.9.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":3808,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2SA","canonicalOSIS":"2Sam","method":"official_book_intro_ref_title","sourceOSIS":"2Sam"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Sam.9.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IISam.9.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Sam.9.3","r":"2Sam.9.3","rawR":"2Sam.9.3","sourceRefs":[{"raw":"2Sam.9.3","value":"2Sam.9.3"}],"t":"ref","v":"9:3"}],"sourceClass":"sn-ref","t":"span"}," Mephibosheth was ",{"c":["crippled in both feet"],"sourceClass":"sn-excerpt","t":"span"}," from a childhood accident (see ",{"href":"?bref=2Sam.4.4","r":"2Sam.4.4","rawR":"2Sam.4.4","sourceRefs":[{"raw":"2Sam.4.4","value":"2Sam.4.4"}],"t":"ref","v":"4:4"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IISam.9.3","refs":[{"book":"2SA","endChapter":9,"endVerse":3,"startChapter":9,"startVerse":3}],"sourceAttributes":{"name":"IISam.9.3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2SA","sourceChapterCoverage":[9],"sourceItemFragmentSha256":"16cce92a3047598c88f1573583f5aa2e6aed65f9c929e10fe3265de16306dc33","sourceItemName":"IISam.9.3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":3809,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2SA","canonicalOSIS":"2Sam","method":"official_book_intro_ref_title","sourceOSIS":"2Sam"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Sam.9.3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IISam.9.3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Sam.9.4","r":"2Sam.9.4","rawR":"2Sam.9.4","sourceRefs":[{"raw":"2Sam.9.4","value":"2Sam.9.4"}],"t":"ref","v":"9:4"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Lo-debar"],"sourceClass":"sn-excerpt","t":"span"}," was a small town in northern Transjordan (the area east of the Jordan), close to Mahanaim, the capital city of Mephibosheth’s late uncle, Ishbosheth. The town was also near Jabesh-gilead, where Saul first made a name for himself (",{"href":"?bref=1Sam.11.1-13","r":"1Sam.11.1-13","rawR":"1Sam.11.1-13","sourceRefs":[{"raw":"1Sam.11.1-13","value":"1Sam.11.1-13"}],"t":"ref","v":"1 Sam 11:1-13"},"). • ",{"c":["Makir son of Ammiel"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," Mephibosheth’s host, later supported David during Absalom’s revolt (",{"href":"?bref=2Sam.17.27","r":"2Sam.17.27","rawR":"2Sam.17.27","sourceRefs":[{"raw":"2Sam.17.27","value":"2Sam.17.27"}],"t":"ref","v":"2 Sam 17:27"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IISam.9.4","refs":[{"book":"2SA","endChapter":9,"endVerse":4,"startChapter":9,"startVerse":4}],"sourceAttributes":{"name":"IISam.9.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2SA","sourceChapterCoverage":[9],"sourceItemFragmentSha256":"f2e4f65e6207a4d342ede473ef56cb8e0a0e19a17a699faa4a465d5a6035da48","sourceItemName":"IISam.9.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":3810,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2SA","canonicalOSIS":"2Sam","method":"official_book_intro_ref_title","sourceOSIS":"2Sam"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Sam.9.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IISam.9.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Sam.9.5","r":"2Sam.9.5","rawR":"2Sam.9.5","sourceRefs":[{"raw":"2Sam.9.5","value":"2Sam.9.5"}],"t":"ref","v":"9:5"}],"sourceClass":"sn-ref","t":"span"}," As Saul had once sent for David (",{"href":"?bref=1Sam.16.19","r":"1Sam.16.19","rawR":"1Sam.16.19","sourceRefs":[{"raw":"1Sam.16.19","value":"1Sam.16.19"}],"t":"ref","v":"1 Sam 16:19"},"), now ",{"c":["David sent for"],"sourceClass":"sn-excerpt","t":"span"}," Mephibosheth. However, Saul sent for someone to minister to him, whereas David sent for someone to whom he could minister."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IISam.9.5","refs":[{"book":"2SA","endChapter":9,"endVerse":5,"startChapter":9,"startVerse":5}],"sourceAttributes":{"name":"IISam.9.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2SA","sourceChapterCoverage":[9],"sourceItemFragmentSha256":"a1d3ebb4a423f5002ab6e06fa7133360c0cddf76886a0e1fd184a5c123c7cd95","sourceItemName":"IISam.9.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":3811,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2SA","canonicalOSIS":"2Sam","method":"official_book_intro_ref_title","sourceOSIS":"2Sam"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Sam.9.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IISam.9.5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Sam.9.6","r":"2Sam.9.6","rawR":"2Sam.9.6","sourceRefs":[{"raw":"2Sam.9.6","value":"2Sam.9.6"}],"t":"ref","v":"9:6"}],"sourceClass":"sn-ref","t":"span"}," Given Mephibosheth’s physical limitations, bowing ",{"c":["low to the ground"],"sourceClass":"sn-excerpt","t":"span"}," must have been very difficult."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IISam.9.6","refs":[{"book":"2SA","endChapter":9,"endVerse":6,"startChapter":9,"startVerse":6}],"sourceAttributes":{"name":"IISam.9.6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2SA","sourceChapterCoverage":[9],"sourceItemFragmentSha256":"c0b34bf66035ae74a270c550e3e46155a6e86da669318a9e68d96076f8794f0a","sourceItemName":"IISam.9.6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":3812,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2SA","canonicalOSIS":"2Sam","method":"official_book_intro_ref_title","sourceOSIS":"2Sam"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Sam.9.6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IISam.9.6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Sam.9.7","r":"2Sam.9.7","rawR":"2Sam.9.7","sourceRefs":[{"raw":"2Sam.9.7","value":"2Sam.9.7"}],"t":"ref","v":"9:7"}],"sourceClass":"sn-ref","t":"span"}," David had confiscated ",{"c":["all the property"],"sourceClass":"sn-excerpt","t":"span"}," that had ",{"c":["belonged to . . . Saul."],"sourceClass":"sn-excerpt","t":"span"}],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IISam.9.7","refs":[{"book":"2SA","endChapter":9,"endVerse":7,"startChapter":9,"startVerse":7}],"sourceAttributes":{"name":"IISam.9.7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2SA","sourceChapterCoverage":[9],"sourceItemFragmentSha256":"85bb805a59bb972e49ffcbae4c1c2350d7a584c9b3be2b35c9102554f9a450b3","sourceItemName":"IISam.9.7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":3813,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2SA","canonicalOSIS":"2Sam","method":"official_book_intro_ref_title","sourceOSIS":"2Sam"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Sam.9.7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IISam.9.7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Sam.9.8","r":"2Sam.9.8","rawR":"2Sam.9.8","sourceRefs":[{"raw":"2Sam.9.8","value":"2Sam.9.8"}],"t":"ref","v":"9:8"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["a dead dog like me:"],"sourceClass":"sn-excerpt","t":"span"}," Mephibosheth knew that anyone with a possible claim to the throne might be killed as a threat."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IISam.9.8","refs":[{"book":"2SA","endChapter":9,"endVerse":8,"startChapter":9,"startVerse":8}],"sourceAttributes":{"name":"IISam.9.8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2SA","sourceChapterCoverage":[9],"sourceItemFragmentSha256":"2d70c4bce04f7a8e3868dcb042fc24f1a88b66228bb64402bc42589e0b18c2d3","sourceItemName":"IISam.9.8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":3814,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2SA","canonicalOSIS":"2Sam","method":"official_book_intro_ref_title","sourceOSIS":"2Sam"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Sam.9.8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IISam.9.8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Sam.9.11","r":"2Sam.9.11","rawR":"2Sam.9.11","sourceRefs":[{"raw":"2Sam.9.11","value":"2Sam.9.11"}],"t":"ref","v":"9:11"}],"sourceClass":"sn-ref","t":"span"}," Both Ziba and Mephibosheth (",{"href":"?bref=2Sam.9.6","r":"2Sam.9.6","rawR":"2Sam.9.6","sourceRefs":[{"raw":"2Sam.9.6","value":"2Sam.9.6"}],"t":"ref","v":"9:6"},") used the phrase ",{"c":["“I am your servant”"],"sourceClass":"sn-excerpt","t":"span"}," when presenting themselves before King David. By referring to himself as David’s servant, Ziba showed that he was no longer loyal to Saul’s dynasty. The sincerity of both later came into question (",{"href":"?bref=2Sam.16.1-4","r":"2Sam.16.1-4","rawR":"2Sam.16.1-4","sourceRefs":[{"raw":"2Sam.16.1-4","value":"2Sam.16.1-4"}],"t":"ref","v":"16:1-4"},"; ",{"href":"?bref=2Sam.19.17-30","r":"2Sam.19.17-30","rawR":"2Sam.19.17-30","sourceRefs":[{"raw":"2Sam.19.17-30","value":"2Sam.19.17-30"}],"t":"ref","v":"19:17-30"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IISam.9.11","refs":[{"book":"2SA","endChapter":9,"endVerse":11,"startChapter":9,"startVerse":11}],"sourceAttributes":{"name":"IISam.9.11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2SA","sourceChapterCoverage":[9],"sourceItemFragmentSha256":"6e365cbd006f4e2dd30482cdc5590926f01dd4dc0d0bbeb831f03dd973c1250c","sourceItemName":"IISam.9.11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":3815,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2SA","canonicalOSIS":"2Sam","method":"official_book_intro_ref_title","sourceOSIS":"2Sam"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Sam.9.11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IISam.9.11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Sam.9.13","r":"2Sam.9.13","rawR":"2Sam.9.13","sourceRefs":[{"raw":"2Sam.9.13","value":"2Sam.9.13"}],"t":"ref","v":"9:13"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["crippled in both feet:"],"sourceClass":"sn-excerpt","t":"span"}," See ",{"href":"?bref=2Sam.4.4","r":"2Sam.4.4","rawR":"2Sam.4.4","sourceRefs":[{"raw":"2Sam.4.4","value":"2Sam.4.4"}],"t":"ref","v":"4:4"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IISam.9.13","refs":[{"book":"2SA","endChapter":9,"endVerse":13,"startChapter":9,"startVerse":13}],"sourceAttributes":{"name":"IISam.9.13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2SA","sourceChapterCoverage":[9],"sourceItemFragmentSha256":"ed6552ff2e1492ed9318b0498bcc49b6da8e8fe48195e652ed34d9a2199232dc","sourceItemName":"IISam.9.13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":3816,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2SA","canonicalOSIS":"2Sam","method":"official_book_intro_ref_title","sourceOSIS":"2Sam"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Sam.9.13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IISam.9.13","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}