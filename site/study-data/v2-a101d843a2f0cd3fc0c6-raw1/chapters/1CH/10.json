a30e33cd.json","title":"Saul"}},"dictionaryRelated":[{"id":"Abinadab","title":"Abinadab"},{"id":"BethShanBethShean","title":"Beth-Shan, Beth-Shean*"},{"id":"ChroniclesBooksofFirstandSecond","title":"Chronicles, Books of First and Second"},{"id":"Circumcision","title":"Circumcision"},{"id":"Dagon","title":"Dagon"},{"id":"Demon","title":"Demon"},{"id":"GilboaMount","title":"Gilboa, Mount"},{"id":"JabeshJabeshGileadPlace","title":"Jabesh, Jabesh-Gilead (Place)"},{"id":"Jonathan","title":"Jonathan"},{"id":"MalchiShua","title":"Malchi-Shua*"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"David","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"David::David::reviewed_unambiguous_name","sourceHeadwordId":"David"},"text":"and he failed to inquire of the LORD. So the LORD put him to death and turned the kingdom over to David son of Jesse.","verse":14}],"id":"David","label":"David","matchReviews":[{"ruleId":"David::David::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"David","term":"David"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"David","sourceTitle":"David"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"So Saul died for his unfaithfulness to the LORD, because he did not keep the word of the LORD and even consulted a medium for guidance,","verse":13},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"and he failed to inquire of the LORD. So the LORD put him to death and turned the kingdom over to David son of Jesse.","verse":14}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Saul","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Saul::Saul::reviewed_unambiguous_name","sourceHeadwordId":"Saul"},"text":"The Philistines followed hard after Saul and his sons, and they killed Saul’s sons Jonathan, Abinadab, and Malchishua.","verse":2},{"matchingRule":"reviewed_exact_headword","phrase":"Saul","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Saul::Saul::reviewed_unambiguous_name","sourceHeadwordId":"Saul"},"text":"When the battle intensified against Saul, the archers overtook him and wounded him.","verse":3},{"matchingRule":"reviewed_exact_headword","phrase":"Saul","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Saul::Saul::reviewed_unambiguous_name","sourceHeadwordId":"Saul"},"text":"Then Saul said to his armor-bearer, “Draw your sword and run me through with it, or these uncircumcised men will come and torture me!” But his armor-bearer was terrified and refused to do it. So Saul took his own sword and fell on it.","verse":4},{"matchingRule":"reviewed_exact_headword","phrase":"Saul","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Saul::Saul::reviewed_unambiguous_name","sourceHeadwordId":"Saul"},"text":"When his armor-bearer saw that Saul was dead, he too fell on his own sword and died.","verse":5},{"matchingRule":"reviewed_exact_headword","phrase":"Saul","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Saul::Saul::reviewed_unambiguous_name","sourceHeadwordId":"Saul"},"text":"So Saul died together with his three sons and all his house.","verse":6},{"matchingRule":"reviewed_exact_headword","phrase":"Saul","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Saul::Saul::reviewed_unambiguous_name","sourceHeadwordId":"Saul"},"text":"When all the Israelites in the valley saw that the army had fled and that Saul and his sons had died, they abandoned their cities and ran away. So the Philistines came and occupied their cities.","verse":7},{"matchingRule":"reviewed_exact_headword","phrase":"Saul","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Saul::Saul::reviewed_unambiguous_name","sourceHeadwordId":"Saul"},"text":"The next day, when the Philistines came to strip the dead, they found Saul and his sons fallen on Mount Gilboa.","verse":8},{"matchingRule":"reviewed_exact_headword","phrase":"Saul","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Saul::Saul::reviewed_unambiguous_name","sourceHeadwordId":"Saul"},"text":"They stripped Saul, cut off his head, took his armor, and sent messengers throughout the land of the Philistines to proclaim the news in the temple of their idols and among their people.","verse":9},{"matchingRule":"reviewed_exact_headword","phrase":"Saul","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Saul::Saul::reviewed_unambiguous_name","sourceHeadwordId":"Saul"},"text":"When all the people of Jabesh-gilead heard about everything the Philistines had done to Saul,","verse":11},{"matchingRule":"reviewed_exact_headword","phrase":"Saul","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Saul::Saul::reviewed_unambiguous_name","sourceHeadwordId":"Saul"},"text":"all their men of valor set out and retrieved the bodies of Saul and his sons and brought them to Jabesh. And they buried their bones under the oak in Jabesh and fasted seven days.","verse":12},{"matchingRule":"reviewed_exact_headword","phrase":"Saul","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Saul::Saul::reviewed_unambiguous_name","sourceHeadwordId":"Saul"},"text":"So Saul died for his unfaithfulness to the LORD, because he did not keep the word of the LORD and even consulted a medium for guidance,","verse":13}],"id":"Saul","label":"Saul","matchReviews":[{"ruleId":"Saul::Saul::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Saul","term":"Saul"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Saul","sourceTitle":"Saul"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=1Chr.10.1-14","r":"1Chr.10.1-14","rawR":"1Chr.10.1-14","sourceRefs":[{"raw":"1Chr.10.1-14","value":"1Chr.10.1-14"}],"t":"ref","v":"10:1-14"}],"sourceClass":"sn-ref","t":"span"}," The narrative of Israel as a kingdom begins with the death of Saul, who failed to fulfill God’s purposes for him as king and for Israel as a nation. Saul’s death prepares the way for David, whom the Chronicler regarded as the first true king of Israel."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IChr.10.1-14","refs":[{"book":"1CH","endChapter":10,"endVerse":14,"startChapter":10,"startVerse":1}],"sourceAttributes":{"name":"IChr.10.1-14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"1CH","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"5f81a29df6c2f6b6cc58f006aa313614bf349ef8b4049531e604d4f43ac5f337","sourceItemName":"IChr.10.1-14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4799,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"1CH","canonicalOSIS":"1Chr","method":"official_book_intro_ref_title","sourceOSIS":"1Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"1Chr.10.1-14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IChr.10.1-14","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=1Chr.10.6-12","r":"1Chr.10.6-12","rawR":"1Chr.10.6-12","sourceRefs":[{"raw":"1Chr.10.6-12","value":"1Chr.10.6-12"}],"t":"ref","v":"10:6-12"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Saul and his three sons died . . . bringing his dynasty to an end:"],"sourceClass":"sn-excerpt","t":"span"}," The Chronicler does not mention Saul’s armor bearer or the rest of his troops (see ",{"href":"?bref=1Sam.31.6","r":"1Sam.31.6","rawR":"1Sam.31.6","sourceRefs":[{"raw":"1Sam.31.6","value":"1Sam.31.6"}],"t":"ref","v":"1 Sam 31:6"},"), emphasizing God’s action in removing Saul and replacing him with David (",{"href":"?bref=1Chr.10.14","r":"1Chr.10.14","rawR":"1Chr.10.14","sourceRefs":[{"raw":"1Chr.10.14","value":"1Chr.10.14"}],"t":"ref","v":"1 Chr 10:14"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IChr.10.6-12","refs":[{"book":"1CH","endChapter":10,"endVerse":12,"startChapter":10,"startVerse":6}],"sourceAttributes":{"name":"IChr.10.6-12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"1CH","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"b58bb7b6cc4417c8a26c62887611cb66068c264cfab24466919fb004bdc46644","sourceItemName":"IChr.10.6-12","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4800,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"1CH","canonicalOSIS":"1Chr","method":"official_book_intro_ref_title","sourceOSIS":"1Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"1Chr.10.6-12","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IChr.10.6-12","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}