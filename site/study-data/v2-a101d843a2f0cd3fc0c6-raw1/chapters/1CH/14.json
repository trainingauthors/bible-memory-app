":"?bref=1Chr.13.1-14","r":"1Chr.13.1-14","rawR":"1Chr.13.1-14","sourceRefs":[{"raw":"1Chr.13.1-14","value":"1Chr.13.1-14"}],"t":"ref","v":"13:1-14"},"), God blessed David’s palace, his children, and his conquest of the Philistines. God’s blessing did not depend on the presence of the Ark. These blessings eventually encouraged David to carry out his original plan to bring the Ark into Jerusalem (",{"href":"?bref=1Chr.15.1-29","r":"1Chr.15.1-29","rawR":"1Chr.15.1-29","sourceRefs":[{"raw":"1Chr.15.1-29","value":"1Chr.15.1-29"}],"t":"ref","v":"15:1-29"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IChr.14.1-7","refs":[{"book":"1CH","endChapter":14,"endVerse":7,"startChapter":14,"startVerse":1}],"sourceAttributes":{"name":"IChr.14.1-7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"1CH","sourceChapterCoverage":[14],"sourceItemFragmentSha256":"aa06f5e531d72df2d82e962d5063aafd08de00a114d9b4c10cfc8c6a5391cbde","sourceItemName":"IChr.14.1-7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4811,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"1CH","canonicalOSIS":"1Chr","method":"official_book_intro_ref_title","sourceOSIS":"1Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"1Chr.14.1-7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IChr.14.1-7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=1Chr.14.1-2","r":"1Chr.14.1-2","rawR":"1Chr.14.1-2","sourceRefs":[{"raw":"1Chr.14.1-2","value":"1Chr.14.1-2"}],"t":"ref","v":"14:1-2"}],"sourceClass":"sn-ref","t":"span"}," Hiram’s generosity provided further evidence of God’s purpose in making David king."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IChr.14.1-2","refs":[{"book":"1CH","endChapter":14,"endVerse":2,"startChapter":14,"startVerse":1}],"sourceAttributes":{"name":"IChr.14.1-2","product":"TyndaleOpenStudy