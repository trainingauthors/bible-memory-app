:"1Chr.19.1","sourceRefs":[{"raw":"1Chr.19.1","value":"1Chr.19.1"}],"t":"ref","v":"19:1"},"; ",{"href":"?bref=1Chr.20.4","r":"1Chr.20.4","rawR":"1Chr.20.4","sourceRefs":[{"raw":"1Chr.20.4","value":"1Chr.20.4"}],"t":"ref","v":"20:4"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IChr.18.1-20.8","refs":[{"book":"1CH","endChapter":20,"endVerse":8,"startChapter":18,"startVerse":1}],"sourceAttributes":{"name":"IChr.18.1-20.8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"1CH","sourceChapterCoverage":[18,19,20],"sourceItemFragmentSha256":"11c49189da94edeb9e58466ec3ba54506113332334d0dfc51fa064006034c79a","sourceItemName":"IChr.18.1-20.8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4832,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"1CH","canonicalOSIS":"1Chr","method":"official_book_intro_ref_title","sourceOSIS":"1Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"1Chr.18.1-20.8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IChr.18.1-20.8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=1Chr.20.1-3","r":"1Chr.20.1-3","rawR":"1Chr.20.1-3","sourceRefs":[{"raw":"1Chr.20.1-3","value":"1Chr.20.1-3"}],"t":"ref","v":"20:1-3"}],"sourceClass":"sn-ref","t":"span"}," This war against the Ammonites was the context of David’s sin with Bathsheba (",{"href":"?bref=2Sam.11.2-12.25","r":"2Sam.11.2-12.25","rawR":"2Sam.11.2-12.25","sourceRefs":[{"raw":"2Sam.11.2-12.25","value":"2Sam.11.2-12.25"}],"t":"ref","v":"2 Sam 11:2–12:25"},"), which the Chronicler omits."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IChr.20.1-3","refs":[{"book":"1CH","endChapter":20,"endVerse":3,"startChapter":20,"startVerse":1}],"sourceAttributes":{"name":"IChr.20.1-3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"1CH","sourceChapterCoverage":[20],"sourceIt