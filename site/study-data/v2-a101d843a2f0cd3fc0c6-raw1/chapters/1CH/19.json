usalem":{"file":"dictionary/24fbd0896e58f8dbf5d021ab0529a0d914829acba4206c49becc31af70083e18.json","title":"Jerusalem"},"Joab":{"file":"dictionary/b880f013fd5830162a0acaab3156939483912d4b3575dc876dcfd397ea8882d0.json","title":"Joab"},"Lord":{"file":"dictionary/0a54f5caa03523157b50ef58ec814d810e7db1abd5db44ec093ece07106e3447.json","title":"Lord"},"MaacahMaachahPlace":{"file":"dictionary/2c4055c814d9ed1aba688f299abc87c80a9ee6204a717b2151536f99454889f9.json","title":"Maacah, Maachah* (Place)"},"Medeba":{"file":"dictionary/eb3aee00f8de7f7f77d01847816527bf33b62897e8341982e2af43ad4327a241.json","title":"Medeba"},"Mesopotamia":{"file":"dictionary/ec7bc475bdff02bd9a94f2a536dd4e48a1fbcc144a2bd4516fadedd05ff9c430.json","title":"Mesopotamia"},"Nahash":{"file":"dictionary/da58ec79b0a2a0437ff5338f0dc15531d37c95d0a4670f90bc8e24ce642dc45d.json","title":"Nahash"},"Shobach":{"file":"dictionary/cc2208af3c4405d88b5114ce5ec26c3c5ac88fcb1e40ea98a88198b2e2304a25.json","title":"Shobach"},"Shophach":{"file":"dictionary/447384b21b33be2f9dfc42f0a538d7e18a35cabbcff5035e0bcae23d93cbefeb.json","title":"Shophach*"},"Zobah":{"file":"dictionary/07aa8bc4474a504d396e3e728251d93d917c563fce7ad1803115c9ec00c16da3.json","title":"Zobah"}},"dictionaryRelated":[{"id":"Abishai","title":"Abishai"},{"id":"AramMaacahMaachah","title":"Aram-Maacah (Maachah*)"},{"id":"AramNaharaim","title":"Aram-Naharaim"},{"id":"ChroniclesBooksofFirstandSecond","title":"Chronicles, Books of First and Second"},{"id":"Genealogy","title":"Genealogy"},{"id":"Hanun","title":"Hanun"},{"id":"IsraelHistoryof","title":"Israel, History of"},{"id":"Jericho","title":"Jericho"},{"id":"MaacahMaachahPlace","title":"Maacah, Maachah* (Place)"},{"id":"Medeba","title":"Medeba"},{"id":"Mesopotamia","title":"Mesopotamia"},{"id":"Shobach","title":"Shobach"},{"id":"Shophach","title":"Shophach*"},{"id":"Zobah","title":"Zobah"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"David","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"David::David::reviewed_unambiguous_name","sourceHeadwordId":"David"},"text":"And David said, “I will show kindness to Hanun son of Nahash, because his father showed kindness to me.” So David sent messengers to console Hanun concerning his father. But when David’s servants arrived in the land of the Ammonites to console him,","verse":2},{"matchingRule":"reviewed_exact_headword","phrase":"David","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"David::David::reviewed_unambiguous_name","sourceHeadwordId":"David"},"text":"the princes of the Ammonites said to Hanun, “Just because David has sent you comforters, do you really believe he is showing respect for your father? Have not his servants come to you to explore the land, spy it out, and overthrow it?”","verse":3},{"matchingRule":"reviewed_exact_headword","phrase":"David","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"David::David::reviewed_unambiguous_name","sourceHeadwordId":"David"},"text":"So Hanun took David’s servants, shaved their beards, cut off their garments at the hips, and sent them away.","verse":4},{"matchingRule":"reviewed_exact_headword","phrase":"David","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"David::David::reviewed_unambiguous_name","sourceHeadwordId":"David"},"text":"When someone came and told David about his men, he sent messengers to meet them, since the men had been thoroughly humiliated. The king told them, “Stay in Jericho until your beards have grown back, and then return.”","verse":5},{"matchingRule":"reviewed_exact_headword","phrase":"David","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"David::David::reviewed_unambiguous_name","sourceHeadwordId":"David"},"text":"When the Ammonites realized that they had become a stench to David, Hanun and the Ammonites sent a thousand talents of silver to hire for themselves chariots and horsemen from Aram-naharaim, Aram-maacah, and Zobah.","verse":6},{"matchingRule":"reviewed_exact_headword","phrase":"David","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"David::David::reviewed_unambiguous_name","sourceHeadwordId":"David"},"text":"On hearing this, David sent Joab and the entire army of mighty men.","verse":8},{"matchingRule":"reviewed_exact_headword","phrase":"David","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"David::David::reviewed_unambiguous_name","sourceHeadwordId":"David"},"text":"When this was reported to David, he gathered all Israel, crossed the Jordan, advanced toward the Arameans, and arrayed for battle against them. When David lined up to engage them in battle, they fought against him.","verse":17},{"matchingRule":"reviewed_exact_headword","phrase":"David","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"David::David::reviewed_unambiguous_name","sourceHeadwordId":"David"},"text":"But the Arameans fled before Israel, and David killed seven thousand of their charioteers and forty thousand foot soldiers. He also killed Shophach the commander of their army.","verse":18},{"matchingRule":"reviewed_exact_headword","phrase":"David","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"David::David::reviewed_unambiguous_name","sourceHeadwordId":"David"},"text":"When Hadadezer’s subjects saw that they had been defeated by Israel, they made peace with David and became subject to him. So the Arameans were unwilling to help the Ammonites anymore.","verse":19}],"id":"David","label":"David","matchReviews":[{"ruleId":"David::David::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"David","term":"David"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"David","sourceTitle":"David"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Hadadezer","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":6,"href":"?bref=1Chr.19.16,19","rawReference":"1Chr.19.16,19"}],"ruleId":"Hadadezer::Hadadezer::source_verse_citation","sourceHeadwordId":"Hadadezer"},"text":"When the Arameans saw that they had been defeated by Israel, they sent messengers to bring more Arameans from beyond the Euphrates, with Shophach the commander of Hadadezer’s army leading them.","verse":16},{"matchingRule":"reviewed_exact_headword","phrase":"Hadadezer","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":6,"href":"?bref=1Chr.19.16,19","rawReference":"1Chr.19.16,19"}],"ruleId":"Hadadezer::Hadadezer::source_verse_citation","sourceHeadwordId":"Hadadezer"},"text":"When Hadadezer’s subjects saw that they had been defeated by Israel, they made peace with David and became subject to him. So the Arameans were unwilling to help the Ammonites anymore.","verse":19}],"id":"Hadadezer","label":"Hadadezer","matchReviews":[{"ruleId":"Hadadezer::Hadadezer::source_verse_citation","scope":"source_verse_citation","senseReview":"Original complete headword and source opening identify a named person, people, or place. Promotion requires a capitalized whole name and the original article explicitly citing this same BSB verse. No arbitrary qualifier stripping or book-title inference. This citation-constrained rule was reviewed once globally; unmatched contexts remain excluded.","sourceHeadwordId":"Hadadezer","term":"Hadadezer"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Hadadezer","sourceTitle":"Hadadezer"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Jerusalem","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Jerusalem::Jerusalem::reviewed_unambiguous_name","sourceHeadwordId":"Jerusalem"},"text":"When the Ammonites saw that the Arameans had fled, they too fled before Joab’s brother Abishai, and they entered the city. So Joab went back to Jerusalem.","verse":15}],"id":"Jerusalem","label":"Jerusalem","matchReviews":[{"ruleId":"Jerusalem::Jerusalem::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Jerusalem","term":"Jerusalem"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Jerusalem","sourceTitle":"Jerusalem"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Joab","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":14,"href":"?bref=1Chr.19.8-15","rawReference":"1Chr.19.8-15"}],"ruleId":"Joab::Joab::source_verse_citation","sourceHeadwordId":"Joab"},"text":"On hearing this, David sent Joab and the entire army of mighty men.","verse":8},{"matchingRule":"reviewed_exact_headword","phrase":"Joab","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":14,"href":"?bref=1Chr.19.8-15","rawReference":"1Chr.19.8-15"}],"ruleId":"Joab::Joab::source_verse_citation","sourceHeadwordId":"Joab"},"text":"When Joab saw the battle lines before him and behind him, he selected some of the best men of Israel and arrayed them against the Arameans.","verse":10},{"matchingRule":"reviewed_exact_headword","phrase":"Joab","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":14,"href":"?bref=1Chr.19.8-15","rawReference":"1Chr.19.8-15"}],"ruleId":"Joab::Joab::source_verse_citation","sourceHeadwordId":"Joab"},"text":"“If the Arameans are too strong for me,” said Joab, “then you will come to my rescue. And if the Ammonites are too strong for you, then I will come to your rescue.","verse":12},{"matchingRule":"reviewed_exact_headword","phrase":"Joab","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":14,"href":"?bref=1Chr.19.8-15","rawReference":"1Chr.19.8-15"}],"ruleId":"Joab::Joab::source_verse_citation","sourceHeadwordId":"Joab"},"text":"So Joab and his troops advanced to fight the Arameans, who fled before him.","verse":14},{"matchingRule":"reviewed_exact_headword","phrase":"Joab","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":14,"href":"?bref=1Chr.19.8-15","rawReference":"1Chr.19.8-15"}],"ruleId":"Joab::Joab::source_verse_citation","sourceHeadwordId":"Joab"},"text":"When the Ammonites saw that the Arameans had fled, they too fled before Joab’s brother Abishai, and they entered the city. So Joab went back to Jerusalem.","verse":15}],"id":"Joab","label":"Joab","matchReviews":[{"ruleId":"Joab::Joab::source_verse_citation","scope":"source_verse_citation","senseReview":"Original complete headword and source opening identify a named person, people, or place. Promotion requires a capitalized whole name and the original article explicitly citing this same BSB verse. No arbitrary qualifier stripping or book-title inference. This citation-constrained rule was reviewed once globally; unmatched contexts remain excluded.","sourceHeadwordId":"Joab","term":"Joab"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Joab","sourceTitle":"Joab"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Be strong and let us fight bravely for our people and for the cities of our God. May the LORD do what is good in His sight.”","verse":13}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Nahash","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":3,"href":"?bref=1Chr.19.1-2","rawReference":"1Chr.19.1-2"}],"ruleId":"Nahash::Nahash::source_verse_citation","sourceHeadwordId":"Nahash"},"text":"Some time later, Nahash king of the Ammonites died and was succeeded by his son.","verse":1},{"matchingRule":"reviewed_exact_headword","phrase":"Nahash","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":3,"href":"?bref=1Chr.19.1-2","rawReference":"1Chr.19.1-2"}],"ruleId":"Nahash::Nahash::source_verse_citation","sourceHeadwordId":"Nahash"},"text":"And David said, “I will show kindness to Hanun son of Nahash, because his father showed kindness to me.” So David sent messengers to console Hanun concerning his father. But when David’s servants arrived in the land of the Ammonites to console him,","verse":2}],"id":"Nahash","label":"Nahash","matchReviews":[{"ruleId":"Nahash::Nahash::source_verse_citation","scope":"source_verse_citation","senseReview":"Original complete headword and source opening identify a named person, people, or place. Promotion requires a capitalized whole name and the original article explicitly citing this same BSB verse. No arbitrary qualifier stripping or book-title inference. This citation-constrained rule was reviewed once globally; unmatched contexts remain excluded.","sourceHeadwordId":"Nahash","term":"Nahash"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Nahash","sourceTitle":"Nahash"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=1Chr.18.1-20.8","r":"1Chr.18.1-20.8","rawR":"1Chr.18.1-20.8","sourceRefs":[{"raw":"1Chr.18.1-20.8","value":"1Chr.18.1-20.8"}],"t":"ref","v":"18:1–20:8"}],"sourceClass":"sn-ref","t":"span"}," This section recounts David’s wars and military achievements, presenting David as the great warrior of Israel’s history. This account relates the public and political aspects of David’s enemies, but it deals very little with their private affairs. • Three distinct sections reflect accounts in Samuel: (1) the battles in the expansion of the kingdom (",{"href":"?bref=1Chr.18.1-17","r":"1Chr.18.1-17","rawR":"1Chr.18.1-17","sourceRefs":[{"raw":"1Chr.18.1-17","value":"1Chr.18.1-17"}],"t":"ref","v":"18:1-17"},"; see ",{"href":"?bref=2Sam.8.1-16","r":"2Sam.8.1-16","rawR":"2Sam.8.1-16","sourceRefs":[{"raw":"2Sam.8.1-16","value":"2Sam.8.1-16"}],"t":"ref","v":"2 Sam 8:1-16"},"); (2) the battle against the Ammonites (",{"href":"?bref=1Chr.19.1-20.3","r":"1Chr.19.1-20.3","rawR":"1Chr.19.1-20.3","sourceRefs":[{"raw":"1Chr.19.1-20.3","value":"1Chr.19.1-20.3"}],"t":"ref","v":"1 Chr 19:1–20:3"},"; see ",{"href":"?bref=2Sam.10.1-11","r":"2Sam.10.1-11","rawR":"2Sam.10.1-11","sourceRefs":[{"raw":"2Sam.10.1-11","value":"2Sam.10.1-11"}],"t":"ref","v":"2 Sam 10:1–11:1"},"; ",{"href":"?bref=2Sam.12.30-31","r":"2Sam.12.30-31","rawR":"2Sam.12.30-31","sourceRefs":[{"raw":"2Sam.12.30-31","value":"2Sam.12.30-31"}],"t":"ref","v":"12:30-31"},"); and (3) the exploits of David’s mighty men (",{"href":"?bref=1Chr.20.4-8","r":"1Chr.20.4-8","rawR":"1Chr.20.4-8","sourceRefs":[{"raw":"1Chr.20.4-8","value":"1Chr.20.4-8"}],"t":"ref","v":"1 Chr 20:4-8"},"; see ",{"href":"?bref=2Sam.21.18-22","r":"2Sam.21.18-22","rawR":"2Sam.21.18-22","sourceRefs":[{"raw":"2Sam.21.18-22","value":"2Sam.21.18-22"}],"t":"ref","v":"2 Sam 21:18-22"},"). Each section begins with a chronological transition (",{"c":["after this"],"sourceClass":"sn-excerpt","t":"span"},") that loosely joins these events (",{"href":"?bref=1Chr.18.1","r":"1Chr.18.1","rawR":"1Chr.18.1","sourceRefs":[{"raw":"1Chr.18.1","value":"1Chr.18.1"}],"t":"ref","v":"1 Chr 18:1"},"; ",{"href":"?bref=1Chr.19.1","r":"1Chr.19.1","rawR":"1Chr.19.1","sourceRefs":[{"raw":"1Chr.19.1","value":"1Chr.19.1"}],"t":"ref","v":"19:1"},"; ",{"href":"?bref=1Chr.20.4","r":"1Chr.20.4","rawR":"1Chr.20.4","sourceRefs":[{"raw":"1Chr.20.4","value":"1Chr.20.4"}],"t":"ref","v":"20:4"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IChr.18.1-20.8","refs":[{"book":"1CH","endChapter":20,"endVerse":8,"startChapter":18,"startVerse":1}],"sourceAttributes":{"name":"IChr.18.1-20.8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"1CH","sourceChapterCoverage":[18,19,20],"sourceItemFragmentSha256":"11c49189da94edeb9e58466ec3ba54506113332334d0dfc51fa064006034c79a","sourceItemName":"IChr.18.1-20.8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4832,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"1CH","canonicalOSIS":"1Chr","method":"official_book_intro_ref_title","sourceOSIS":"1Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"1Chr.18.1-20.8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IChr.18.1-20.8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=1Chr.19.1-7","r":"1Chr.19.1-7","rawR":"1Chr.19.1-7","sourceRefs":[{"raw":"1Chr.19.1-7","value":"1Chr.19.1-7"}],"t":"ref","v":"19:1-7"}],"sourceClass":"sn-ref","t":"span"}," The new Ammonite ruler, ",{"c":["Hanun"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," took exception to Israel’s presence so close to his nation. The Ammonites hired Aramean armies from the north, and these combined forces assembled ",{"c":["at Medeba"],"sourceClass":"sn-excerpt","t":"span"}," to challenge David’s control of Moab’s plateau."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IChr.19.1-7","refs":[{"book":"1CH","endChapter":19,"endVerse":7,"startChapter":19,"startVerse":1}],"sourceAttributes":{"name":"IChr.19.1-7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"1CH","sourceChapterCoverage":[19],"sourceItemFragmentSha256":"18f4e921513910637beeb9dc21bf868861c5f229547464c28aa15cc8f7441e47","sourceItemName":"IChr.19.1-7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4837,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"1CH","canonicalOSIS":"1Chr","method":"official_book_intro_ref_title","sourceOSIS":"1Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"1Chr.19.1-7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IChr.19.1-7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=1Chr.19.9-13","r":"1Chr.19.9-13","rawR":"1Chr.19.9-13","sourceRefs":[{"raw":"1Chr.19.9-13","value":"1Chr.19.9-13"}],"t":"ref","v":"19:9-13"}],"sourceClass":"sn-ref","t":"span"}," The enemy armies drew their battle lines strategically; ",{"c":["the Ammonites"],"sourceClass":"sn-excerpt","t":"span"}," positioned themselves so that the city of Medeba could serve as a refuge, while the Israelites also had to deal with a second offensive from ",{"c":["the Arameans"],"sourceClass":"sn-excerpt","t":"span"},". ",{"c":["Joab"],"sourceClass":"sn-excerpt","t":"span"}," divided his forces to fight on both fronts from a central rallying point."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IChr.19.9-13","refs":[{"book":"1CH","endChapter":19,"endVerse":13,"startChapter":19,"startVerse":9}],"sourceAttributes":{"name":"IChr.19.9-13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"1CH","sourceChapterCoverage":[19],"sourceItemFragmentSha256":"016d4ae02df5c6a18ac53a9d3766f3b2696010934a83a4dee3d026b0a0022aeb","sourceItemName":"IChr.19.9-13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4838,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"1CH","canonicalOSIS":"1Chr","method":"official_book_intro_ref_title","sourceOSIS":"1Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"1Chr.19.9-13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IChr.19.9-13","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=1Chr.19.13","r":"1Chr.19.13","rawR":"1Chr.19.13","sourceRefs":[{"raw":"1Chr.19.13","value":"1Chr.19.13"}],"t":"ref","v":"19:13"}],"sourceClass":"sn-ref","t":"span"}," Joab knew that the battle was not being waged to gain more territory but to defend the ",{"c":["people and the cities"],"sourceClass":"sn-excerpt","t":"span"}," of Israel from invasion (cp. ",{"href":"?bref=1Chr.19.8","r":"1Chr.19.8","rawR":"1Chr.19.8","sourceRefs":[{"raw":"1Chr.19.8","value":"1Chr.19.8"}],"t":"ref","v":"19:8"},"). • Joab placed his trust in God, knowing that the outcome depended on the Lord’s providence."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IChr.19.13","refs":[{"book":"1CH","endChapter":19,"endVerse":13,"startChapter":19,"startVerse":13}],"sourceAttributes":{"name":"IChr.19.13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"1CH","sourceChapterCoverage":[19],"sourceItemFragmentSha256":"f9fd17e6e67c8ef9671043d52b03026cd05564ecca994e34f44aeda85a3af1f2","sourceItemName":"IChr.19.13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4839,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"1CH","canonicalOSIS":"1Chr","method":"official_book_intro_ref_title","sourceOSIS":"1Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"1Chr.19.13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IChr.19.13","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=1Chr.19.16-19","r":"1Chr.19.16-19","rawR":"1Chr.19.16-19","sourceRefs":[{"raw":"1Chr.19.16-19","value":"1Chr.19.16-19"}],"t":"ref","v":"19:16-19"}],"sourceClass":"sn-ref","t":"span"}," In the battle against ",{"c":["the Arameans"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," David accomplished three objectives: He challenged ",{"c":["Hadadezer’s"],"sourceClass":"sn-excerpt","t":"span"}," supremacy, threw the alliance of the Arameans into disarray, and prevented any possible future alliance between ",{"c":["the Arameans"],"sourceClass":"sn-excerpt","t":"span"}," and ",{"c":["the Ammonites"],"sourceClass":"sn-excerpt","t":"span"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IChr.19.16-19","refs":[{"book":"1CH","endChapter":19,"endVerse":19,"startChapter":19,"startVerse":16}],"sourceAttributes":{"name":"IChr.19.16-19","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"1CH","sourceChapterCoverage":[19],"sourceItemFragmentSha256":"4e9f38e301c152d6b718750aa5022bd5fbc7ec2a53df7edf863160fe9a40af44","sourceItemName":"IChr.19.16-19","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4840,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"1CH","canonicalOSIS":"1Chr","method":"official_book_intro_ref_title","sourceOSIS":"1Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"1Chr.19.16-19","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IChr.19.16-19","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}