y-two days","refs":["Neh 4:1-2"],"sourceRowNumber":21306,"targets":[{"label":"Neh 4:1-2","passages":[{"book":"NEH","chapter":4,"verses":[1,2]}]}],"verse":15},{"anchor":"our enemies heard","refs":["Neh 2:10","Neh 4:1,7","Neh 6:1-2"],"sourceRowNumber":21307,"targets":[{"label":"Neh 2:10","passages":[{"book":"NEH","chapter":2,"verses":[10]}]},{"label":"Neh 4:1,7","passages":[{"book":"NEH","chapter":4,"verses":[1,7]}]},{"label":"Neh 6:1-2","passages":[{"book":"NEH","chapter":6,"verses":[1,2]}]}],"verse":16},{"anchor":"accomplished by our God","refs":["Exod 14:25","Num 23:23","Josh 5:1","Ps 126:2","Acts 5:38"],"sourceRowNumber":21308,"targets":[{"label":"Exod 14:25","passages":[{"book":"EXO","chapter":14,"verses":[25]}]},{"label":"Num 23:23","passages":[{"book":"NUM","chapter":23,"verses":[23]}]},{"label":"Josh 5:1","passages":[{"book":"JOS","chapter":5,"verses":[1]}]},{"label":"Ps 126:2","passages":[{"book":"PSA","chapter":126,"verses":[2]}]},{"label":"Acts 5:38","passages":[{"book":"ACT","chapter":5,"verses":[38]}]}],"verse":16},{"anchor":"nobles of Judah","refs":["Neh 3:5","Neh 5:7","Neh 13:28","Mic 7:1-6","Matt 24:10-12"],"sourceRowNumber":21309,"targets":[{"label":"Neh 3:5","passages":[{"book":"NEH","chapter":3,"verses":[5]}]},{"label":"Neh 5:7","passages":[{"book":"NEH","chapter":5,"verses":[7]}]},{"label":"Neh 13:28","passages":[{"book":"NEH","chapter":13,"verses":[28]}]},{"label":"Mic 7:1-6","passages":[{"book":"MIC","chapter":7,"verses":[1,2,3,4,5,6]}]},{"label":"Matt 24:10-12","passages":[{"book":"MAT","chapter":24,"verses":[10,11,12]}]}],"verse":17},{"anchor":"Arah","refs":["Neh 7:10","Ezra 2:5"],"sourceRowNumber":21310,"targets":[{"label":"Neh 7:10","passages":[{"book":"NEH","chapter":7,"verses":[10]}]},{"label":"Ezra 2:5","passages":[{"book":"EZR","chapter":2,"verses":[5]}]}],"verse":18},{"anchor":"Meshullam","refs":["Neh 3:4,30"],"sourceRowNumber":21311,"targets":[{"label":"Neh 3:4,30","passages":[{"book":"NEH","chapter":3,"verses":[4,30]}]}],"verse":18},{"