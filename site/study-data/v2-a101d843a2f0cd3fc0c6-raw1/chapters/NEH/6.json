0bd0201ff1d56da27b83d16e802e74a950e364ded.json","title":"Tobiah"}},"dictionaryRelated":[{"id":"ArabiaArabs","title":"Arabia, Arabs"},{"id":"Architecture","title":"Architecture"},{"id":"CalendarsAncientandModern","title":"Calendars, Ancient and Modern"},{"id":"Elul","title":"Elul*"},{"id":"Gashmu","title":"Gashmu*"},{"id":"Geshem","title":"Geshem"},{"id":"Jehohanan","title":"Jehohanan"},{"id":"Johanan","title":"Johanan"},{"id":"Kedar","title":"Kedar"},{"id":"LetterWritingAncient","title":"Letter Writing*, Ancient"},{"id":"MalachiBookof","title":"Malachi, Book of"},{"id":"Mehetabel","title":"Mehetabel"},{"id":"Meshullam","title":"Meshullam"},{"id":"NehemiahPerson","title":"Nehemiah (Person)"},{"id":"NehemiahBookof","title":"Nehemiah, Book of"},{"id":"Noadiah","title":"Noadiah"},{"id":"PostexilicPeriod","title":"Postexilic Period*"},{"id":"Sanballat","title":"Sanballat"},{"id":"ShecaniahShechaniah","title":"Shecaniah, Shechaniah*"},{"id":"Shemaiah","title":"Shemaiah"},{"id":"Tobiah","title":"Tobiah"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Berechiah","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":7,"href":"?bref=Neh.6.18","rawReference":"Neh.6.18"}],"ruleId":"Berechiah::Berechiah::source_verse_citation","sourceHeadwordId":"Berechiah"},"text":"For many in Judah were bound by oath to him, since he was a son-in-law of Shecaniah son of Arah, and his son Jehohanan had married the daughter of Meshullam son of Berechiah.","verse":18}],"id":"Berechiah","label":"Berechiah","matchReviews":[{"ruleId":"Berechiah::Berechiah::source_verse_citation","scope":"source_verse_citation","senseReview":"Original complete headword and source opening identify a named person, people, or place. Promotion requires a capitalized whole name and the original article explicitly citing this same BSB verse. No arbitrary qualifier stripping or book-title inference. This citation-constrained rule was reviewed once globally; unmatched contexts remain excluded.","sourceHeadwordId":"Berechiah","term":"Berechiah"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Berechiah","sourceTitle":"Berechiah*"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Delaiah","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":4,"href":"?bref=Neh.6.10","rawReference":"Neh.6.10"}],"ruleId":"Delaiah::Delaiah::source_verse_citation","sourceHeadwordId":"Delaiah"},"text":"Later, I went to the house of Shemaiah son of Delaiah, the son of Mehetabel, who was confined to his house. He said: “Let us meet at the house of God inside the temple. Let us shut the temple doors because they are coming to kill you—by night they are coming to kill you!”","verse":10}],"id":"Delaiah","label":"Delaiah","matchReviews":[{"ruleId":"Delaiah::Delaiah::source_verse_citation","scope":"source_verse_citation","senseReview":"Original complete headword and source opening identify a named person, people, or place. Promotion requires a capitalized whole name and the original article explicitly citing this same BSB verse. No arbitrary qualifier stripping or book-title inference. This citation-constrained rule was reviewed once globally; unmatched contexts remain excluded.","sourceHeadwordId":"Delaiah","term":"Delaiah"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Delaiah","sourceTitle":"Delaiah"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Jerusalem","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Jerusalem::Jerusalem::reviewed_unambiguous_name","sourceHeadwordId":"Jerusalem"},"text":"and you have even appointed prophets in Jerusalem to proclaim on your behalf: ‘There is a king in Judah.’ Soon these rumors will reach the ears of the king. So come, let us confer together.”","verse":7}],"id":"Jerusalem","label":"Jerusalem","matchReviews":[{"ruleId":"Jerusalem::Jerusalem::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Jerusalem","term":"Jerusalem"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Jerusalem","sourceTitle":"Jerusalem"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Ono","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":3,"href":"?bref=Neh.6.2","rawReference":"Neh.6.2"}],"ruleId":"Ono::Ono::source_verse_citation","sourceHeadwordId":"Ono"},"text":"Sanballat and Geshem sent me this message: “Come, let us meet together in one of the villages on the plain of Ono.” But they were planning to harm me.","verse":2}],"id":"Ono","label":"Ono","matchReviews":[{"ruleId":"Ono::Ono::source_verse_citation","scope":"source_verse_citation","senseReview":"Original complete headword and source opening identify a named person, people, or place. Promotion requires a capitalized whole name and the original article explicitly citing this same BSB verse. No arbitrary qualifier stripping or book-title inference. This citation-constrained rule was reviewed once globally; unmatched contexts remain excluded.","sourceHeadwordId":"Ono","term":"Ono"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Ono","sourceTitle":"Ono"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":["Nehemiah"],"sourceClass":"profile-title","t":"h"},{"c":["Nehemiah was a powerful leader of God’s people living in Judea following the Exile. Nehemiah improved the morale and strength of God’s people in the midst of difficulty."],"sourceClass":"profile-body-fl","t":"p"},{"c":["Before Nehemiah returned to Judea, he was cup-bearer to Persian king Artaxerxes I (465–424 ",{"c":["BC"],"sourceClass":"era","t":"span"},"). The cup-bearer brought the king his wine (tasting it first to make sure it wasn’t poisoned) and was his trusted confidant and adviser. Nehemiah heard reports about Jerusalem’s sad state and, moved with compassion, he asked the king’s permission to return to Judea to help his people. The king responded favorably and made him governor of the province of Judea for twelve years to aid his fellow Jews and rebuild the walls of Jerusalem (",{"href":"?bref=Neh.1.1-2.8","r":"Neh.1.1-2.8","rawR":"Neh.1.1-2.8","sourceRefs":[{"raw":"Neh.1.1-2.8","value":"Neh.1.1-2.8"}],"t":"ref","v":"Neh 1:1–2:8"},")."],"sourceClass":"profile-body","t":"p"},{"c":["Nehemiah had the support of the Persian king, but he faced opposition from the inhabitants of the land. These people of mixed heritage were the ancestors of the New Testament Samaritans. Nehemiah showed great courage and skill as he successfully helped the people of Judea rebuild the walls that protected Jerusalem."],"sourceClass":"profile-body","t":"p"},{"c":["Nehemiah had a strong personal faith, as seen by his prayers (",{"href":"?bref=Neh.1.4-11","r":"Neh.1.4-11","rawR":"Neh.1.4-11","sourceRefs":[{"raw":"Neh.1.4-11","value":"Neh.1.4-11"}],"t":"ref","v":"Neh 1:4-11"},"; ",{"href":"?bref=Neh.2.4","r":"Neh.2.4","rawR":"Neh.2.4","sourceRefs":[{"raw":"Neh.2.4","value":"Neh.2.4"}],"t":"ref","v":"2:4"},") and his confidence in divine guidance and help (",{"href":"?bref=Neh.2.8","r":"Neh.2.8","rawR":"Neh.2.8","sourceRefs":[{"raw":"Neh.2.8","value":"Neh.2.8"}],"t":"ref","v":"2:8"},", ",{"href":"?bref=Neh.2.18","r":"Neh.2.18","rawR":"Neh.2.18","sourceRefs":[{"raw":"Neh.2.18","value":"Neh.2.18"}],"t":"ref","v":"18"},", ",{"href":"?bref=Neh.2.20","r":"Neh.2.20","rawR":"Neh.2.20","sourceRefs":[{"raw":"Neh.2.20","value":"Neh.2.20"}],"t":"ref","v":"20"},"). He also advocated economic justice: He rebuked a few rich Judeans who were exploiting a food shortage by exacting high interest from their poorer relatives, and he provided an example of better conduct (",{"href":"?bref=Neh.5.1-19","r":"Neh.5.1-19","rawR":"Neh.5.1-19","sourceRefs":[{"raw":"Neh.5.1-19","value":"Neh.5.1-19"}],"t":"ref","v":"Neh 5"},")."],"sourceClass":"profile-body","t":"p"},{"c":["Nehemiah was vitally concerned about the people’s faithfulness, and he individually confronted men who had married pagan women (",{"href":"?bref=Neh.13.23-29","r":"Neh.13.23-29","rawR":"Neh.13.23-29","sourceRefs":[{"raw":"Neh.13.23-29","value":"Neh.13.23-29"}],"t":"ref","v":"13:23-29"},"). He had a strong interest in maintaining Temple worship, and he led the Jewish community to pledge support for Temple personnel and to provide offerings (",{"href":"?bref=Neh.10.32-39","r":"Neh.10.32-39","rawR":"Neh.10.32-39","sourceRefs":[{"raw":"Neh.10.32-39","value":"Neh.10.32-39"}],"t":"ref","v":"10:32-39"},"). He also reformed Sabbath observance (",{"href":"?bref=Neh.13.15-22","r":"Neh.13.15-22","rawR":"Neh.13.15-22","sourceRefs":[{"raw":"Neh.13.15-22","value":"Neh.13.15-22"}],"t":"ref","v":"13:15-22"},")."],"sourceClass":"profile-body","t":"p"},{"c":["Although there were still problems at the end of his tenure in Jerusalem (see ",{"href":"?bref=Neh.13.1-31","r":"Neh.13.1-31","rawR":"Neh.13.1-31","sourceRefs":[{"raw":"Neh.13.1-31","value":"Neh.13.1-31"}],"t":"ref","v":"Neh 13"},"), Nehemiah was an effective leader who restored a national and religious identity to the Jewish settlers in a period of political and economic weakness."],"sourceClass":"profile-body","t":"p"},{"c":["Passages for Further Study"],"sourceClass":"profile-refs-title","t":"h"},{"c":[{"href":"?bref=Neh.1.1-7.73","r":"Neh.1.1-7.73","rawR":"Neh.1.1-7.73","sourceRefs":[{"raw":"Neh.1.1-7.73","value":"Neh.1.1-7.73"}],"t":"ref","v":"Neh 1:1–7:73"},"; ",{"href":"?bref=Neh.8.9-10","r":"Neh.8.9-10","rawR":"Neh.8.9-10","sourceRefs":[{"raw":"Neh.8.9-10","value":"Neh.8.9-10"}],"t":"ref","v":"8:9-10"},"; ",{"href":"?bref=Neh.10.1-13.31","r":"Neh.10.1-13.31","rawR":"Neh.10.1-13.31","sourceRefs":[{"raw":"Neh.10.1-13.31","value":"Neh.10.1-13.31"}],"t":"ref","v":"10:1–13:31"}],"sourceClass":"profile-refs","t":"p"}],"id":"Profile:Nehemiah","refs":[{"book":"NEH","endChapter":8,"endVerse":12,"startChapter":1,"startVerse":1}],"sourceAttributes":{"name":"Nehemiah","product":"TyndaleOpenStudyNotes","typename":"Profile"},"sourceBookAppCode":"NEH","sourceChapterCoverage":[1,2,3,4,5,6,7,8],"sourceItemFragmentSha256":"91129c64e03ce3d8ba851daaca64ca8fa22412983d6f68a4d1206a1bc29621c6","sourceItemName":"Nehemiah","sourceMember":"Tyndale Open Study Notes/Profiles.xml","sourceOrder":68,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NEH","canonicalOSIS":"Neh","method":"official_book_intro_ref_title","sourceOSIS":"Neh"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Neh.1.1-8.12","sourceRelease":"1.25","sourceTitleExact":"Nehemiah","supplementPointersNotIncludedAsContent":[],"title":"Nehemiah","type":"Profile"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Neh.6.1-19","r":"Neh.6.1-19","rawR":"Neh.6.1-19","sourceRefs":[{"raw":"Neh.6.1-19","value":"Neh.6.1-19"}],"t":"ref","v":"6:1-19"}],"sourceClass":"sn-ref","t":"span"}," With the financial crisis solved (ch ",{"href":"?bref=Neh.5.1-19","r":"Neh.5.1-19","rawR":"Neh.5.1-19","sourceRefs":[{"raw":"Neh.5.1-19","value":"Neh.5.1-19"}],"t":"ref","v":"5"},"), the narrative returns to how the enemies of rebuilding tried to intimidate or eliminate Nehemiah."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Neh.6.1-19","refs":[{"book":"NEH","endChapter":6,"endVerse":19,"startChapter":6,"startVerse":1}],"sourceAttributes":{"name":"Neh.6.1-19","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NEH","sourceChapterCoverage":[6],"sourceItemFragmentSha256":"237877b3f54260a6dcbf4181a16468dcd6349b060fd566f421061e6246283078","sourceItemName":"Neh.6.1-19","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5362,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NEH","canonicalOSIS":"Neh","method":"official_book_intro_ref_title","sourceOSIS":"Neh"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Neh.6.1-19","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Neh.6.1-19","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Neh.6.2","r":"Neh.6.2","rawR":"Neh.6.2","sourceRefs":[{"raw":"Neh.6.2","value":"Neh.6.2"}],"t":"ref","v":"6:2"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["plain of Ono"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," located near Lod (",{"href":"?bref=Ezra.2.33","r":"Ezra.2.33","rawR":"Ezra.2.33","sourceRefs":[{"raw":"Ezra.2.33","value":"Ezra.2.33"}],"t":"ref","v":"Ezra 2:33"},"), was probably a neutral site west of Jerusalem, where Nehemiah would have been unprotected."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Neh.6.2","refs":[{"book":"NEH","endChapter":6,"endVerse":2,"startChapter":6,"startVerse":2}],"sourceAttributes":{"name":"Neh.6.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NEH","sourceChapterCoverage":[6],"sourceItemFragmentSha256":"efff25c6dc6e5618ef2de41918938138d667d2270932a61f6a4d2059290236e5","sourceItemName":"Neh.6.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5363,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NEH","canonicalOSIS":"Neh","method":"official_book_intro_ref_title","sourceOSIS":"Neh"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Neh.6.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Neh.6.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Neh.6.6-7","r":"Neh.6.6-7","rawR":"Neh.6.6-7","sourceRefs":[{"raw":"Neh.6.6-7","value":"Neh.6.6-7"}],"t":"ref","v":"6:6-7"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["planning to rebel . . . you plan to be their king:"],"sourceClass":"sn-excerpt","t":"span"}," Those who had opposed the restoration of the Temple had used similar tactics (see ",{"href":"?bref=Ezra.4.1-24","r":"Ezra.4.1-24","rawR":"Ezra.4.1-24","sourceRefs":[{"raw":"Ezra.4.1-24","value":"Ezra.4.1-24"}],"t":"ref","v":"Ezra 4"},"). • At times in Israel’s history, ",{"c":["prophets"],"sourceClass":"sn-excerpt","t":"span"}," did play a role in establishing a new king (cp. ",{"href":"?bref=1Sam.9.16","r":"1Sam.9.16","rawR":"1Sam.9.16","sourceRefs":[{"raw":"1Sam.9.16","value":"1Sam.9.16"}],"t":"ref","v":"1 Sam 9:16"},"; ",{"href":"?bref=2Kgs.9.1-37","r":"2Kgs.9.1-37","rawR":"2Kgs.9.1-37","sourceRefs":[{"raw":"2Kgs.9.1-37","value":"2Kgs.9.1-37"}],"t":"ref","v":"2 Kgs 9"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Neh.6.6-7","refs":[{"book":"NEH","endChapter":6,"endVerse":7,"startChapter":6,"startVerse":6}],"sourceAttributes":{"name":"Neh.6.6-7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NEH","sourceChapterCoverage":[6],"sourceItemFragmentSha256":"f0557a492753384e158c3d2699d833c4ded4ceaeb202a101f6abde91348f6ce9","sourceItemName":"Neh.6.6-7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5364,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NEH","canonicalOSIS":"Neh","method":"official_book_intro_ref_title","sourceOSIS":"Neh"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Neh.6.6-7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Neh.6.6-7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Neh.6.11","r":"Neh.6.11","rawR":"Neh.6.11","sourceRefs":[{"raw":"Neh.6.11","value":"Neh.6.11"}],"t":"ref","v":"6:11"}],"sourceClass":"sn-ref","t":"span"}," A good leader would not ",{"c":["run from danger"],"sourceClass":"sn-excerpt","t":"span"}," but would stand as an example to his people."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Neh.6.11","refs":[{"book":"NEH","endChapter":6,"endVerse":11,"startChapter":6,"startVerse":11}],"sourceAttributes":{"name":"Neh.6.11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NEH","sourceChapterCoverage":[6],"sourceItemFragmentSha256":"63c155dac84b5279299aea738402e3ba9be9e5ca2031c6c65f6f7000025cd427","sourceItemName":"Neh.6.11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5365,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NEH","canonicalOSIS":"Neh","method":"official_book_intro_ref_title","sourceOSIS":"Neh"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Neh.6.11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Neh.6.11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Neh.6.15-16","r":"Neh.6.15-16","rawR":"Neh.6.15-16","sourceRefs":[{"raw":"Neh.6.15-16","value":"Neh.6.15-16"}],"t":"ref","v":"6:15-16"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["just fifty-two days:"],"sourceClass":"sn-excerpt","t":"span"}," Everyone realized that ",{"c":["the help of our God"],"sourceClass":"sn-excerpt","t":"span"}," was what made such success possible (see also ",{"href":"?bref=Neh.1.11","r":"Neh.1.11","rawR":"Neh.1.11","sourceRefs":[{"raw":"Neh.1.11","value":"Neh.1.11"}],"t":"ref","v":"1:11"},"; ",{"href":"?bref=Neh.2.8","r":"Neh.2.8","rawR":"Neh.2.8","sourceRefs":[{"raw":"Neh.2.8","value":"Neh.2.8"}],"t":"ref","v":"2:8"},", ",{"href":"?bref=Neh.2.18","r":"Neh.2.18","rawR":"Neh.2.18","sourceRefs":[{"raw":"Neh.2.18","value":"Neh.2.18"}],"t":"ref","v":"18"},", ",{"href":"?bref=Neh.2.20","r":"Neh.2.20","rawR":"Neh.2.20","sourceRefs":[{"raw":"Neh.2.20","value":"Neh.2.20"}],"t":"ref","v":"20"},"; ",{"href":"?bref=Neh.4.15","r":"Neh.4.15","rawR":"Neh.4.15","sourceRefs":[{"raw":"Neh.4.15","value":"Neh.4.15"}],"t":"ref","v":"4:15"},", ",{"href":"?bref=Neh.4.20","r":"Neh.4.20","rawR":"Neh.4.20","sourceRefs":[{"raw":"Neh.4.20","value":"Neh.4.20"}],"t":"ref","v":"20"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Neh.6.15-16","refs":[{"book":"NEH","endChapter":6,"endVerse":16,"startChapter":6,"startVerse":15}],"sourceAttributes":{"name":"Neh.6.15-16","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"NEH","sourceChapterCoverage":[6],"sourceItemFragmentSha256":"50d5920cf026b9f0fa2d7d65e8703db20e92b72977b24cdd79ae34987c7e97fa","sourceItemName":"Neh.6.15-16","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5366,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"NEH","canonicalOSIS":"Neh","method":"official_book_intro_ref_title","sourceOSIS":"Neh"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Neh.6.15-16","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Neh.6.15-16","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}