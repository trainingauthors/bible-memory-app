atchReviews":[{"ruleId":"Jerusalem::Jerusalem::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Jerusalem","term":"Jerusalem"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Jerusalem","sourceTitle":"Jerusalem"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Now at the end of the twenty years during which Solomon had built the house of the LORD and his own palace,","verse":1},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Solomon brought the daughter of Pharaoh up from the City of David to the palace he had built for her. For he said, “My wife must not live in the house of David king of Israel, because the places the ark of the LORD has entered are holy.”","verse":11},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"At that time Solomon offered burnt offerings to the LORD on the altar of the LORD he had built in front of the portico.","verse":12},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Thus all the work of Solomon was carried out, from the day the foundation was laid for the house of the LORD until it was finished. So the house of the LORD was completed.","verse":16}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Moses","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Moses::Moses::reviewed_unambiguous_name","sourceHeadwordId":"Moses"},"text":"He observed the daily requirement for offerings according to the commandment of Moses for Sabbaths, New Moons, and the three annual appointed feasts—the Feast of Unleavened Bread, the Feast of Weeks, and the Feast of Tabernacles.","verse":13}],"id":"Moses","label":"Moses","matchReviews":[{"ruleId":"Moses::Moses::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Moses","term":"Moses"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Moses","sourceTitle":"Moses"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Pharaoh","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Pharaoh::Pharaoh::reviewed_unambiguous_name","sourceHeadwordId":"Pharaoh"},"text":"Solomon brought the daughter of Pharaoh up from the City of David to the palace he had built for her. For he said, “My wife must not live in the house of David king of Israel, because the places the ark of the LORD has entered are holy.”","verse":11}],"id":"Pharaoh","label":"Pharaoh","matchReviews":[{"ruleId":"Pharaoh::Pharaoh::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Pharaoh","term":"Pharaoh"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Pharaoh","sourceTitle":"Pharaoh"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.8.2","r":"2Chr.8.2","rawR":"2Chr.8.2","sourceRefs":[{"raw":"2Chr.8.2","value":"2Chr.8.2"}],"t":"ref","v":"8:2"}],"sourceClass":"sn-ref","t":"span"}," The twenty ",{"c":["towns"],"sourceClass":"sn-excerpt","t":"span"}," that Solomon had given Hiram in exchange for gold were unsatisfactory to Hiram (",{"href":"?bref=1Kgs.9.11-14","r":"1Kgs.9.11-14","rawR":"1Kgs.9.11-14","sourceRefs":[{"raw":"1Kgs.9.11-14","value":"1Kgs.9.11-14"}],"t":"ref","v":"1 Kgs 9:11-14"},"); this implies that Hiram gave them back to Solomon, who apparently provided other compensation."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.8.2","refs":[{"book":"2CH","endChapter":8,"endVerse":2,"startChapter":8,"startVerse":2}],"sourceAttributes":{"name":"IIChr.8.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"a05b2b1b99a4ca74e157b7d8c163b1a9e52aee79c325ad5db3aa717ac51fffde","sourceItemName":"IIChr.8.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4948,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.8.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.8.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.8.3","r":"2Chr.8.3","rawR":"2Chr.8.3","sourceRefs":[{"raw":"2Chr.8.3","value":"2Chr.8.3"}],"t":"ref","v":"8:3"}],"sourceClass":"sn-ref","t":"span"}," This verse is the only reference in Chronicles of Solomon’s military accomplishments; he was known as a man of peace (",{"href":"?bref=1Chr.22.9","r":"1Chr.22.9","rawR":"1Chr.22.9","sourceRefs":[{"raw":"1Chr.22.9","value":"1Chr.22.9"}],"t":"ref","v":"1 Chr 22:9"},"). The kingdoms of David and Solomon extended to ",{"c":["Hamath-zobah"],"sourceClass":"sn-excerpt","t":"span"}," in the far north on the Orontes River. King Toi, the ruler of Hamath, sought David’s support against Hadadezer, king of Zobah (",{"href":"?bref=1Chr.18.9-10","r":"1Chr.18.9-10","rawR":"1Chr.18.9-10","sourceRefs":[{"raw":"1Chr.18.9-10","value":"1Chr.18.9-10"}],"t":"ref","v":"1 Chr 18:9-10"},"). Hadadezer was also referred to as the king of Zobah-Hamath (",{"href":"?bref=1Chr.18.3","r":"1Chr.18.3","rawR":"1Chr.18.3","sourceRefs":[{"raw":"1Chr.18.3","value":"1Chr.18.3"}],"t":"ref","v":"1 Chr 18:3"},"). Solomon conducted an expedition against this territory to maintain the stability of his kingdom’s northern border."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.8.3","refs":[{"book":"2CH","endChapter":8,"endVerse":3,"startChapter":8,"startVerse":3}],"sourceAttributes":{"name":"IIChr.8.3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"b1a098f2c974ef17d3f7fe41ebc8b147d8c1267a3dc3e4852c188b1c25eb0ed1","sourceItemName":"IIChr.8.3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4949,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.8.3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.8.3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.8.4","r":"2Chr.8.4","rawR":"2Chr.8.4","sourceRefs":[{"raw":"2Chr.8.4","value":"2Chr.8.4"}],"t":"ref","v":"8:4"}],"sourceClass":"sn-ref","t":"span"}," The Chronicler describes the northern reaches of Solomon’s kingdom. ",{"c":["Tadmor"],"sourceClass":"sn-excerpt","t":"span"}," later became Palmyra, an oasis city in Syria along the desert trade routes with Mesopotamia, 120 miles northeast of Damascus. It is not mentioned elsewhere in the Bible. At some point, it came to be identified with the list of fortified cities in Solomon’s kingdom (cp. ",{"href":"?bref=1Kgs.9.18","r":"1Kgs.9.18","rawR":"1Kgs.9.18","sourceRefs":[{"raw":"1Kgs.9.18","value":"1Kgs.9.18"}],"t":"ref","v":"1 Kgs 9:18"},", where Tamar/Tadmor indicates a city in southeast Judah)."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.8.4","refs":[{"book":"2CH","endChapter":8,"endVerse":4,"startChapter":8,"startVerse":4}],"sourceAttributes":{"name":"IIChr.8.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"c4700dd835aeadf65f11d46cc5f4f70f1a502a92a85e9ab70cef44b78b91d36f","sourceItemName":"IIChr.8.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4950,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.8.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.8.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.8.5","r":"2Chr.8.5","rawR":"2Chr.8.5","sourceRefs":[{"raw":"2Chr.8.5","value":"2Chr.8.5"}],"t":"ref","v":"8:5"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Upper"],"sourceClass":"sn-excerpt","t":"span"}," and ",{"c":["Lower Beth-horon"],"sourceClass":"sn-excerpt","t":"span"}," sit astride a ridge rising from the Valley of Aijalon to the plateau north of Jerusalem. Fortifications protected the route connecting Jerusalem to the major coastal trade route."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.8.5","refs":[{"book":"2CH","endChapter":8,"endVerse":5,"startChapter":8,"startVerse":5}],"sourceAttributes":{"name":"IIChr.8.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"0a7e262429d7110434c8e9f0805a608afe537a0f4bae0fc35d1874810d47d888","sourceItemName":"IIChr.8.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4951,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.8.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.8.5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.8.6","r":"2Chr.8.6","rawR":"2Chr.8.6","sourceRefs":[{"raw":"2Chr.8.6","value":"2Chr.8.6"}],"t":"ref","v":"8:6"}],"sourceClass":"sn-ref","t":"span"}," Some cities were used for storage and for military cavalry. Large building complexes at Hazor, Megiddo, and Gezer contained long rooms divided into three sections with two rows of pillars. They might have been used as stables and storehouses, or they might have provided barracks for a professional army."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.8.6","refs":[{"book":"2CH","endChapter":8,"endVerse":6,"startChapter":8,"startVerse":6}],"sourceAttributes":{"name":"IIChr.8.6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"6c3d374c0294e2afc48f2375a1f8fb508d6b87502c6e3dc9203dd315c54214b0","sourceItemName":"IIChr.8.6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4952,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.8.6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.8.6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.8.11","r":"2Chr.8.11","rawR":"2Chr.8.11","sourceRefs":[{"raw":"2Chr.8.11","value":"2Chr.8.11"}],"t":"ref","v":"8:11"}],"sourceClass":"sn-ref","t":"span"}," Solomon’s alliance with Egypt through his marriage to Pharaoh’s daughter is mentioned repeatedly in Kings (",{"href":"?bref=1Kgs.3.1","r":"1Kgs.3.1","rawR":"1Kgs.3.1","sourceRefs":[{"raw":"1Kgs.3.1","value":"1Kgs.3.1"}],"t":"ref","v":"1 Kgs 3:1"},"; ",{"href":"?bref=1Kgs.9.16","r":"1Kgs.9.16","rawR":"1Kgs.9.16","sourceRefs":[{"raw":"1Kgs.9.16","value":"1Kgs.9.16"}],"t":"ref","v":"9:16"},", ",{"href":"?bref=1Kgs.9.24","r":"1Kgs.9.24","rawR":"1Kgs.9.24","sourceRefs":[{"raw":"1Kgs.9.24","value":"1Kgs.9.24"}],"t":"ref","v":"24"},"; ",{"href":"?bref=1Kgs.11.1","r":"1Kgs.11.1","rawR":"1Kgs.11.1","sourceRefs":[{"raw":"1Kgs.11.1","value":"1Kgs.11.1"}],"t":"ref","v":"11:1"},"). Solomon’s ability to marry into the Egyptian royal family shows the extent of his kingdom and international influence. Solomon provided her with a permanent personal residence to show that he regarded her as the most important of his wives. It also preserved the sanctity of ",{"c":["David’s palace"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," probably because Pharaoh’s daughter was pagan."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.8.11","refs":[{"book":"2CH","endChapter":8,"endVerse":11,"startChapter":8,"startVerse":11}],"sourceAttributes":{"name":"IIChr.8.11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"86ed48ccb191d84f07ce8c7091a89913c410c3104b13643569224d1991d933bb","sourceItemName":"IIChr.8.11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4953,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.8.11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.8.11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.8.17-18","r":"2Chr.8.17-18","rawR":"2Chr.8.17-18","sourceRefs":[{"raw":"2Chr.8.17-18","value":"2Chr.8.17-18"}],"t":"ref","v":"8:17-18"}],"sourceClass":"sn-ref","t":"span"}," By discussing Solomon’s activities at his kingdom’s most northern and southern borders, the Chronicler shows the extent of Solomon’s empire. Solomon controlled ",{"c":["ports"],"sourceClass":"sn-excerpt","t":"span"}," on ",{"c":["the Red Sea"],"sourceClass":"sn-excerpt","t":"span"}," that provided for international trade to the south. • ",{"c":["Hiram"],"sourceClass":"sn-excerpt","t":"span"}," was a valuable ally; his people, the Phoenicians of Tyre, had extensive trade networks and were expert mariners, helping ",{"c":["Solomon"],"sourceClass":"sn-excerpt","t":"span"}," trade with Ophir. • ",{"c":["Ophir"],"sourceClass":"sn-excerpt","t":"span"}," is traditionally thought to be in southwest Arabia (see ",{"href":"?bref=Gen.10.28-29","r":"Gen.10.28-29","rawR":"Gen.10.28-29","sourceRefs":[{"raw":"Gen.10.28-29","value":"Gen.10.28-29"}],"t":"ref","v":"Gen 10:28-29"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.8.17-18","refs":[{"book":"2CH","endChapter":8,"endVerse":18,"startChapter":8,"startVerse":17}],"sourceAttributes":{"name":"IIChr.8.17-18","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"cb2c0a4876fc6569bd088b67e62570f78c1953b300c2b43963cef6f04da98a04","sourceItemName":"IIChr.8.17-18","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4954,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.8.17-18","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.8.17-18","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}