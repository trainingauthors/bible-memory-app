f a woman from the daughters of Dan, and his father is a man of Tyre. He is skilled in work with gold and silver, bronze and iron, stone and wood, purple, blue, and crimson yarn, and fine linen. He is experienced in every kind of engraving and can execute any design that is given him. He will work with your craftsmen and with those of my lord, your father David.","verse":14},{"matchingRule":"reviewed_exact_headword","phrase":"David","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"David::David::reviewed_unambiguous_name","sourceHeadwordId":"David"},"text":"Solomon numbered all the foreign men in the land of Israel following the census his father David had conducted, and there were found to be 153,600 in all.","verse":17}],"id":"David","label":"David","matchReviews":[{"ruleId":"David::David::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"David","term":"David"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"David","sourceTitle":"David"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Jerusalem","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Jerusalem::Jerusalem::reviewed_unambiguous_name","sourceHeadwordId":"Jerusalem"},"text":"Send me, therefore, a craftsman skilled in engraving to work with gold and silver, with bronze and iron, and with purple, crimson, and blue yarn. He will work with my craftsmen in Judah and Jerusalem, whom my father David provided.","verse":7},{"matchingRule":"reviewed_exact_headword","phrase":"Jerusalem","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Jerusalem::Jerusalem::reviewed_unambiguous_name","sourceHeadwordId":"Jerusalem"},"text":"We will cut logs from Lebanon, as many as you need, and we will float them to you as rafts by sea down to Joppa. Then you can take them up to Jerusalem.”","verse":16}],"id":"Jerusalem","label":"Jerusalem","matchReviews":[{"ruleId":"Jerusalem::Jerusalem::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Jerusalem","term":"Jerusalem"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Jerusalem","sourceTitle":"Jerusalem"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Joppa","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":1,"href":"?bref=2Chr.2.16","rawReference":"2Chr.2.16"}],"ruleId":"Joppa::Joppa::source_verse_citation","sourceHeadwordId":"Joppa"},"text":"We will cut logs from Lebanon, as many as you need, and we will float them to you as rafts by sea down to Joppa. Then you can take them up to Jerusalem.”","verse":16}],"id":"Joppa","label":"Joppa","matchReviews":[{"ruleId":"Joppa::Joppa::source_verse_citation","scope":"source_verse_citation","senseReview":"Original complete headword and source opening identify a named person, people, or place. Promotion requires a capitalized whole name and the original article explicitly citing this same BSB verse. No arbitrary qualifier stripping or book-title inference. This citation-constrained rule was reviewed once globally; unmatched contexts remain excluded.","sourceHeadwordId":"Joppa","term":"Joppa"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Joppa","sourceTitle":"Joppa"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Lebanon","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":10,"href":"?bref=2Chr.2.8,16","rawReference":"2Chr.2.8,16"}],"ruleId":"Lebanon::Lebanon::source_verse_citation","sourceHeadwordId":"Lebanon"},"text":"Send me also cedar, cypress, and algum logs from Lebanon, for I know that your servants have skill to cut timber there. And indeed, my servants will work with yours","verse":8},{"matchingRule":"reviewed_exact_headword","phrase":"Lebanon","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":10,"href":"?bref=2Chr.2.8,16","rawReference":"2Chr.2.8,16"}],"ruleId":"Lebanon::Lebanon::source_verse_citation","sourceHeadwordId":"Lebanon"},"text":"We will cut logs from Lebanon, as many as you need, and we will float them to you as rafts by sea down to Joppa. Then you can take them up to Jerusalem.”","verse":16}],"id":"Lebanon","label":"Lebanon","matchReviews":[{"ruleId":"Lebanon::Lebanon::source_verse_citation","scope":"source_verse_citation","senseReview":"Original complete headword and source opening identify a named person, people, or place. Promotion requires a capitalized whole name and the original article explicitly citing this same BSB verse. No arbitrary qualifier stripping or book-title inference. This citation-constrained rule was reviewed once globally; unmatched contexts remain excluded.","sourceHeadwordId":"Lebanon","term":"Lebanon"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lebanon","sourceTitle":"Lebanon"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Now Solomon purposed to build a house for the Name of the LORD and a royal palace for himself.","verse":1},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Behold, I am about to build a house for the Name of the LORD my God to dedicate to Him for burning fragrant incense before Him, for displaying the showbread continuously, and for making burnt offerings every morning and evening as well as on the Sabbaths, New Moons, and appointed feasts of the LORD our God. This is ordained for Israel forever.","verse":4},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Then Hiram king of Tyre wrote a letter in reply to Solomon: “Because the LORD loves His people, He has set you over them as king.”","verse":11},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"And Hiram added: “Blessed be the LORD, the God of Israel, who made the heavens and the earth! He has given King David a wise son with insight and understanding, who will build a temple for the LORD and a royal palace for himself.","verse":12}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"},{"evidence":[{"matchingRule":"reviewed_qualified_headword","phrase":"Solomon","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":10,"href":"?bref=2Chr.2.17-18","rawReference":"2Chr.2.17-18"}],"ruleId":"SolomonPerson::Solomon::source_verse_citation","sourceHeadwordId":"SolomonPerson"},"text":"Solomon numbered all the foreign men in the land of Israel following the census his father David had conducted, and there were found to be 153,600 in all.","verse":17},{"matchingRule":"reviewed_qualified_headword","phrase":"Solomon","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":10,"href":"?bref=2Chr.2.17-18","rawReference":"2Chr.2.17-18"}],"ruleId":"SolomonPerson::Solomon::source_verse_citation","sourceHeadwordId":"SolomonPerson"},"text":"Solomon made 70,000 of them porters, 80,000 stonecutters in the mountains, and 3,600 supervisors.","verse":18}],"id":"SolomonPerson","label":"Solomon","matchReviews":[{"ruleId":"SolomonPerson::Solomon::source_verse_citation","scope":"source_verse_citation","senseReview":"Original title explicitly labels the subject Person. This is a reviewed person headword, never a stripped book title; the original person article must cite the exact occurrence verse. Other people sharing the name are retained within the original multi-sense person article.","sourceHeadwordId":"SolomonPerson","term":"Solomon"}],"matchingRule":"reviewed_qualified_headword","matchingRules":["reviewed_qualified_headword"],"sourceProvenanceId":"SolomonPerson","sourceTitle":"Solomon (Person)"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":["God’s Name on His Temple"],"sourceClass":"theme-title","t":"h"},{"c":["In his prayer of dedication, Solomon declared that the Temple was the house where God’s name would be present (",{"href":"?bref=2Chr.6.20","r":"2Chr.6.20","rawR":"2Chr.6.20","sourceRefs":[{"raw":"2Chr.6.20","value":"2Chr.6.20"}],"t":"ref","v":"2 Chr 6:20"},"; cp. ",{"href":"?bref=2Chr.6.5-6","r":"2Chr.6.5-6","rawR":"2Chr.6.5-6","sourceRefs":[{"raw":"2Chr.6.5-6","value":"2Chr.6.5-6"}],"t":"ref","v":"6:5-6"},"). God had promised David that he would place his own name on the Temple in Jerusalem (",{"href":"?bref=2Sam.7.4-17","r":"2Sam.7.4-17","rawR":"2Sam.7.4-17","sourceRefs":[{"raw":"2Sam.7.4-17","value":"2Sam.7.4-17"}],"t":"ref","v":"2 Sam 7:4-17"},"). When God puts his name in a place, it signifies his possession of it."],"sourceClass":"theme-body-fl","t":"p"},{"c":["For the people of Israel, the Temple embodied the land God promised to them and marked by his name. It was the ultimate symbol of God’s relationship with Israel. So Solomon prayed that God would remember his relationship with Israel and hear their prayers at this Temple. Solomon’s prayer uses God’s personal name (",{"c":["Lord"],"sourceClass":"divine-name","t":"span"},"=",{"c":["Yahweh;"],"sourceClass":"ital","t":"span"}," see ",{"href":"?bref=Exod.3.13-15","r":"Exod.3.13-15","rawR":"Exod.3.13-15","sourceRefs":[{"raw":"Exod.3.13-15","value":"Exod.3.13-15"}],"t":"ref","v":"Exod 3:13-15"},") to make the Temple the definitive symbol of Israel’s faith. The Temple was the chosen place where the covenant was preserved, where the people of Israel called on God’s name and acknowledged God in confession and praise."],"sourceClass":"theme-body","t":"p"},{"c":["The fulfillment of God’s promise to put his name on his Temple is now to be found in the “living temple,” the community of God’s people. Peter urges believers to come “to Christ, who is the living cornerstone of God’s temple. He was rejected by people, but he was chosen by God for great honor. And you are living stones that God is building into his spiritual temple. What’s more, you are his holy priests. Through the mediation of Jesus Christ, you offer spiritual sacrifices that please God” (",{"href":"?bref=1Pet.2.4-5","r":"1Pet.2.4-5","rawR":"1Pet.2.4-5","sourceRefs":[{"raw":"1Pet.2.4-5","value":"1Pet.2.4-5"}],"t":"ref","v":"1 Pet 2:4-5"},"). God’s name rests on his church as it did on his Temple."],"sourceClass":"theme-body","t":"p"},{"c":["Passages for Further Study"],"sourceClass":"theme-refs-title","t":"h"},{"c":[{"href":"?bref=Exod.3.13-15","r":"Exod.3.13-15","rawR":"Exod.3.13-15","sourceRefs":[{"raw":"Exod.3.13-15","value":"Exod.3.13-15"}],"t":"ref","v":"Exod 3:13-15"},"; ",{"href":"?bref=2Sam.7.12-13","r":"2Sam.7.12-13","rawR":"2Sam.7.12-13","sourceRefs":[{"raw":"2Sam.7.12-13","value":"2Sam.7.12-13"}],"t":"ref","v":"2 Sam 7:12-13"},"; ",{"href":"?bref=2Chr.6.3-42","r":"2Chr.6.3-42","rawR":"2Chr.6.3-42","sourceRefs":[{"raw":"2Chr.6.3-42","value":"2Chr.6.3-42"}],"t":"ref","v":"2 Chr 6:3-42"},"; ",{"href":"?bref=Ps.23.3","r":"Ps.23.3","rawR":"Ps.23.3","sourceRefs":[{"raw":"Ps.23.3","value":"Ps.23.3"}],"t":"ref","v":"Ps 23:3"},"; ",{"href":"?bref=1Pet.2.4-5","r":"1Pet.2.4-5","rawR":"1Pet.2.4-5","sourceRefs":[{"raw":"1Pet.2.4-5","value":"1Pet.2.4-5"}],"t":"ref","v":"1 Pet 2:4-5"}],"sourceClass":"theme-refs","t":"p"}],"id":"ThemeNote:GodsNameOnHisTemple","refs":[{"book":"2CH","endChapter":2,"endVerse":4,"startChapter":2,"startVerse":1}],"sourceAttributes":{"name":"GodsNameOnHisTemple","product":"TyndaleOpenStudyNotes","typename":"ThemeNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"1af0102291684f0ec528109e3c0d4bed21d6f3a3ad28c0b05eac30c4d510d493","sourceItemName":"GodsNameOnHisTemple","sourceMember":"Tyndale Open Study Notes/ThemeNotes.xml","sourceOrder":82,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.2.1-4","sourceRelease":"1.25","sourceTitleExact":"God’s Name on His Temple","supplementPointersNotIncludedAsContent":[],"title":"God’s Name on His Temple","type":"ThemeNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.2.1","r":"2Chr.2.1","rawR":"2Chr.2.1","sourceRefs":[{"raw":"2Chr.2.1","value":"2Chr.2.1"}],"t":"ref","v":"2:1"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["Temple"],"sourceClass":"sn-excerpt","t":"span"}," is immediately introduced as the first priority among Solomon’s building projects, although the work actually began in the fourth year of his reign (",{"href":"?bref=2Chr.3.2","r":"2Chr.3.2","rawR":"2Chr.3.2","sourceRefs":[{"raw":"2Chr.3.2","value":"2Chr.3.2"}],"t":"ref","v":"3:2"},"). Solomon used the intervening years to negotiate with King Hiram (",{"href":"?bref=2Chr.2.3","r":"2Chr.2.3","rawR":"2Chr.2.3","sourceRefs":[{"raw":"2Chr.2.3","value":"2Chr.2.3"}],"t":"ref","v":"2:3"},") for materials and skilled workers."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.2.1","refs":[{"book":"2CH","endChapter":2,"endVerse":1,"startChapter":2,"startVerse":1}],"sourceAttributes":{"name":"IIChr.2.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"a31e42e5ffc983ce3ef4d1f1fddfb3fddb2c79d6ffdaf90a634d46997c3e7336","sourceItemName":"IIChr.2.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4902,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.2.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.2.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.2.5-6","r":"2Chr.2.5-6","rawR":"2Chr.2.5-6","sourceRefs":[{"raw":"2Chr.2.5-6","value":"2Chr.2.5-6"}],"t":"ref","v":"2:5-6"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["a magnificent Temple:"],"sourceClass":"sn-excerpt","t":"span"}," The greatness of the Temple and the greatness of God were not of the same order, since ",{"c":["not even the highest heavens can contain"],"sourceClass":"sn-excerpt","t":"span"}," God."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.2.5-6","refs":[{"book":"2CH","endChapter":2,"endVerse":6,"startChapter":2,"startVerse":5}],"sourceAttributes":{"name":"IIChr.2.5-6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"992824a1630489bbe65e938beccb1e9ae03753e8844d4e0a833aa7fd797d1c21","sourceItemName":"IIChr.2.5-6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4903,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.2.5-6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.2.5-6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.2.8","r":"2Chr.2.8","rawR":"2Chr.2.8","sourceRefs":[{"raw":"2Chr.2.8","value":"2Chr.2.8"}],"t":"ref","v":"2:8"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["cedar"],"sourceClass":"sn-excerpt","t":"span"}," is ",{"c":["Cedrus libani"],"sourceClass":"ital","t":"span"}," (“cedar of Lebanon”), a tree renowned for its beauty, impressive height (sometimes reaching 100 feet), and fragrant wood. Kings from Egypt, Phoenicia, Assyria, Babylon, Persia, and Greece used cedar timber ",{"c":["from Lebanon"],"sourceClass":"sn-excerpt","t":"span"}," for building temples and palaces. • ",{"c":["Red sandalwood"],"sourceClass":"sn-excerpt","t":"span"}," was used to make supports for the Temple (possibly pillars or balustrades) as well as musical instruments (see ",{"href":"?bref=1Kgs.10.11","r":"1Kgs.10.11","rawR":"1Kgs.10.11","sourceRefs":[{"raw":"1Kgs.10.11","value":"1Kgs.10.11"}],"t":"ref","v":"1 Kgs 10:11"},"). Often mentioned in ancient writings, the exact identity of this hard, reddish-brown wood is uncertain."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.2.8","refs":[{"book":"2CH","endChapter":2,"endVerse":8,"startChapter":2,"startVerse":8}],"sourceAttributes":{"name":"IIChr.2.8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"4c0591ad4dda8bae31ee326ffc25ed4ef6e720a2006f6741864e1ee5ececfa10","sourceItemName":"IIChr.2.8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4904,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.2.8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.2.8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.2.13-14","r":"2Chr.2.13-14","rawR":"2Chr.2.13-14","sourceRefs":[{"raw":"2Chr.2.13-14","value":"2Chr.2.13-14"}],"t":"ref","v":"2:13-14"}],"sourceClass":"sn-ref","t":"span"}," The skill and knowledge of ",{"c":["Huram-abi"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," a ",{"c":["master"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["wise"],"sourceClass":"ital","t":"span"},") ",{"c":["craftsman"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," was required for building the Temple. Huram-abi had expertise in metals (",{"c":["gold, silver, bronze, and iron"],"sourceClass":"sn-excerpt","t":"span"},"), in ",{"c":["stone and wood"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," and in textiles (",{"c":["purple, blue, and scarlet cloth and fine linen"],"sourceClass":"sn-excerpt","t":"span"},"). Similarly, God had chosen Bezalel as the master craftsman of the Tabernacle and had endowed him with wisdom to carry out the work (",{"href":"?bref=Exod.31.1-5","r":"Exod.31.1-5","rawR":"Exod.31.1-5","sourceRefs":[{"raw":"Exod.31.1-5","value":"Exod.31.1-5"}],"t":"ref","v":"Exod 31:1-5"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.2.13-14","refs":[{"book":"2CH","endChapter":2,"endVerse":14,"startChapter":2,"startVerse":13}],"sourceAttributes":{"name":"IIChr.2.13-14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"c13987627170778914142b45f88570dc259ddba317676a9fe7e8c711beb71816","sourceItemName":"IIChr.2.13-14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4905,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.2.13-14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.2.13-14","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.2.17-18","r":"2Chr.2.17-18","rawR":"2Chr.2.17-18","sourceRefs":[{"raw":"2Chr.2.17-18","value":"2Chr.2.17-18"}],"t":"ref","v":"2:17-18"}],"sourceClass":"sn-ref","t":"span"}," The book of Kings explains that all those left from the seven nations were conscripted for labor. Further, no Israelites were conscripted, and Israelites were placed in charge of the ",{"c":["laborers"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=1Kgs.9.20-23","r":"1Kgs.9.20-23","rawR":"1Kgs.9.20-23","sourceRefs":[{"raw":"1Kgs.9.20-23","value":"1Kgs.9.20-23"}],"t":"ref","v":"1 Kgs 9:20-23"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.2.17-18","refs":[{"book":"2CH","endChapter":2,"endVerse":18,"startChapter":2,"startVerse":17}],"sourceAttributes":{"name":"IIChr.2.17-18","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"9c0346601ea023a3a542f79dd2744073469b72eb45bc7e6234c93e990dc7e1a7","sourceItemName":"IIChr.2.17-18","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4906,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.2.17-18","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.2.17-18","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}