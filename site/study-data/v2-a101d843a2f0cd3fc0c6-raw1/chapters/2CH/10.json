":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.10.1","r":"2Chr.10.1","rawR":"2Chr.10.1","sourceRefs":[{"raw":"2Chr.10.1","value":"2Chr.10.1"}],"t":"ref","v":"10:1"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Shechem"],"sourceClass":"sn-excerpt","t":"span"}," was in the heart of the territory of the northern tribes; the need for ",{"c":["Rehoboam"],"sourceClass":"sn-excerpt","t":"span"}," to go there for confirmation reflects either weak national unity or the comparative strength and influence of the northern tribes. • ",{"c":["Rehoboam"],"sourceClass":"sn-excerpt","t":"span"}," reigned from 931 to 913 ",{"c":["BC"],"sourceClass":"era","t":"span"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.10.1","refs":[{"book":"2CH","endChapter":10,"endVerse":1,"startChapter":10,"startVerse":1}],"sourceAttributes":{"name":"IIChr.10.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"1aaa57e6abca81ba780ca13c36cd2f2701b682a9b3a609f6c0a616d969ed12e4","sourceItemName":"IIChr.10.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4964,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.10.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.10.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.10.2","r":"2Chr.10.2","rawR":"2Chr.10.2","sourceRefs":[{"raw":"2Chr.10.2","value":"2Chr.10.2"}],"t":"ref","v":"10:2"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Jeroboam . . . had fled to Egypt to escape from King Solomon:"],"sourceClass":"sn-excerpt","t":"span"}," See ",{"href":"?bref=1Kgs.11.26-40","r":"1Kgs.11.26-40","rawR":"1Kgs.11.26-40","sourceRefs":[{"raw":"1Kgs.11.26-40","value":"1Kgs.11.26-40"}],"t":"ref","v":"1 Kgs 11:26-40"},". Jeroboam ",{"c":["returned from Egypt"],"sourceClass":"sn-excerpt","t":"span"}," at the news of Solomon’s death."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.10.2","refs":[{"book":"2CH","endChapter":10,"endVerse":2,"startChapter":10,"startVerse":2}],"sourceAttributes":{"name":"IIChr.10.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"bd43715124c27e80384dabf54f9584257ae282d86572a8ea0fc0219b2dd6e4e6","sourceItemName":"IIChr.10.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4965,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.10.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.10.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.10.4","r":"2Chr.10.4","rawR":"2Chr.10.4","sourceRefs":[{"raw":"2Chr.10.4","value":"2Chr.10.4"}],"t":"ref","v":"10:4"}],"sourceClass":"sn-ref","t":"span"}," Rehoboam was not powerful enough to enforce taxation over the northern tribes, so they demanded concessions to remain under his rule."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.10.4","refs":[{"book":"2CH","endChapter":10,"endVerse":4,"startChapter":10,"startVerse":4}],"sourceAttributes":{"name":"IIChr.10.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"268db9d9c580ad2586ce3193f006639241d2a47ee5dab09702f4b066bcf73f87","sourceItemName":"IIChr.10.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4966,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.10.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.10.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.10.6","r":"2Chr.10.6","rawR":"2Chr.10.6","sourceRefs":[{"raw":"2Chr.10.6","value":"2Chr.10.6"}],"t":"ref","v":"10:6"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["older men"],"sourceClass":"sn-excerpt","t":"span"}," of Israel were distinguished from officials, nobles, and guardians (",{"href":"?bref=Judg.8.14","r":"Judg.8.14","rawR":"Judg.8.14","sourceRefs":[{"raw":"Judg.8.14","value":"Judg.8.14"}],"t":"ref","v":"Judg 8:14"},"; ",{"href":"?bref=1Kgs.21.8","r":"1Kgs.21.8","rawR":"1Kgs.21.8","sourceRefs":[{"raw":"1Kgs.21.8","value":"1Kgs.21.8"}],"t":"ref","v":"1 Kgs 21:8"},"; ",{"href":"?bref=2Kgs.10.5","r":"2Kgs.10.5","rawR":"2Kgs.10.5","sourceRefs":[{"raw":"2Kgs.10.5","value":"2Kgs.10.5"}],"t":"ref","v":"2 Kgs 10:5"},") who had official government roles. These elders traditionally exercised considerable influence in royal decisions. When Ben-hadad, king of Aram, attacked Samaria, the elders of Samaria were decisive in rejecting his harsh terms of surrender (",{"href":"?bref=1Kgs.20.7-9","r":"1Kgs.20.7-9","rawR":"1Kgs.20.7-9","sourceRefs":[{"raw":"1Kgs.20.7-9","value":"1Kgs.20.7-9"}],"t":"ref","v":"1 Kgs 20:7-9"},"). Earlier, when Absalom revolted against David, the elders of Israel were influential in critical decisions (",{"href":"?bref=2Sam.17.4","r":"2Sam.17.4","rawR":"2Sam.17.4","sourceRefs":[{"raw":"2Sam.17.4","value":"2Sam.17.4"}],"t":"ref","v":"2 Sam 17:4"},", ",{"href":"?bref=2Sam.17.15","r":"2Sam.17.15","rawR":"2Sam.17.15","sourceRefs":[{"raw":"2Sam.17.15","value":"2Sam.17.15"}],"t":"ref","v":"15"},"; ",{"href":"?bref=2Sam.19.11","r":"2Sam.19.11","rawR":"2Sam.19.11","sourceRefs":[{"raw":"2Sam.19.11","value":"2Sam.19.11"}],"t":"ref","v":"19:11"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.10.6","refs":[{"book":"2CH","endChapter":10,"endVerse":6,"startChapter":10,"startVerse":6}],"sourceAttributes":{"name":"IIChr.10.6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"e1149de00a7fae4bacded6b7bfa40ddf39f1aff35183167600982e82152fff07","sourceItemName":"IIChr.10.6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4967,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.10.6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.10.6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.10.8","r":"2Chr.10.8","rawR":"2Chr.10.8","sourceRefs":[{"raw":"2Chr.10.8","value":"2Chr.10.8"}],"t":"ref","v":"10:8"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Rehoboam"],"sourceClass":"sn-excerpt","t":"span"}," was forty-one years old when he began to reign (",{"href":"?bref=2Chr.12.13","r":"2Chr.12.13","rawR":"2Chr.12.13","sourceRefs":[{"raw":"2Chr.12.13","value":"2Chr.12.13"}],"t":"ref","v":"12:13"},"), so the ",{"c":["young men who had grown up with him"],"sourceClass":"sn-excerpt","t":"span"}," were not novices. They might have been royal princes, sons of Solomon’s other wives. It was natural for them to have a role in Rehoboam’s government, as shown by his promotion of his son Abijah (",{"href":"?bref=2Chr.11.22","r":"2Chr.11.22","rawR":"2Chr.11.22","sourceRefs":[{"raw":"2Chr.11.22","value":"2Chr.11.22"}],"t":"ref","v":"11:22"},"). Referring to these princes as “young” might have been a comment on the value of their advice, because the young were not viewed as being wise (see ",{"href":"?bref=Job.12.12","r":"Job.12.12","rawR":"Job.12.12","sourceRefs":[{"raw":"Job.12.12","value":"Job.12.12"}],"t":"ref","v":"Job 12:12"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.10.8","refs":[{"book":"2CH","endChapter":10,"endVerse":8,"startChapter":10,"startVerse":8}],"sourceAttributes":{"name":"IIChr.10.8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"07e471444110f99bdad0ee10bb4fa81d18e3991402699211515d3b45f5a8e6d7","sourceItemName":"IIChr.10.8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4968,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.10.8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.10.8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.10.10-11","r":"2Chr.10.10-11","rawR":"2Chr.10.10-11","sourceRefs":[{"raw":"2Chr.10.10-11","value":"2Chr.10.10-11"}],"t":"ref","v":"10:10-11"}],"sourceClass":"sn-ref","t":"span"}," The words of the younger counselors corresponded with Rehoboam’s disposition. They lacked the experience of the elders, but they shared Rehoboam’s inclinations and preferences. They delivered their answer in metaphors and rhetoric appropriate to a royal court."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.10.10-11","refs":[{"book":"2CH","endChapter":10,"endVerse":11,"startChapter":10,"startVerse":10}],"sourceAttributes":{"name":"IIChr.10.10-11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"26aa580a73f10ee4561590267890b8a0de6fa31381c2dd1c5d8aae5711333f6a","sourceItemName":"IIChr.10.10-11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4969,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.10.10-11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.10.10-11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.10.16","r":"2Chr.10.16","rawR":"2Chr.10.16","sourceRefs":[{"raw":"2Chr.10.16","value":"2Chr.10.16"}],"t":"ref","v":"10:16"}],"sourceClass":"sn-ref","t":"span"}," The people ",{"c":["responded"],"sourceClass":"sn-excerpt","t":"span"}," using words that were the converse of a poetic saying the Chronicler had used earlier (",{"href":"?bref=1Chr.12.18","r":"1Chr.12.18","rawR":"1Chr.12.18","sourceRefs":[{"raw":"1Chr.12.18","value":"1Chr.12.18"}],"t":"ref","v":"1 Chr 12:18"},"); there, the people of the southern tribes of Benjamin and Judah (",{"href":"?bref=1Chr.12.16","r":"1Chr.12.16","rawR":"1Chr.12.16","sourceRefs":[{"raw":"1Chr.12.16","value":"1Chr.12.16"}],"t":"ref","v":"1 Chr 12:16"},") showed growing support for ",{"c":["David"],"sourceClass":"sn-excerpt","t":"span"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.10.16","refs":[{"book":"2CH","endChapter":10,"endVerse":16,"startChapter":10,"startVerse":16}],"sourceAttributes":{"name":"IIChr.10.16","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"1b2cb2258b350ecf8a498499743086d89cb2475a59f3ceb3cbba027f99d5e010","sourceItemName":"IIChr.10.16","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4970,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.10.16","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.10.16","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.10.18","r":"2Chr.10.18","rawR":"2Chr.10.18","sourceRefs":[{"raw":"2Chr.10.18","value":"2Chr.10.18"}],"t":"ref","v":"10:18"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Rehoboam"],"sourceClass":"sn-excerpt","t":"span"}," came to Shechem to be anointed king but barely escaped with his life. His poor understanding of the situation was particularly evident when he sent a civilian official, rather than an army commander, to enforce conscription."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.10.18","refs":[{"book":"2CH","endChapter":10,"endVerse":18,"startChapter":10,"startVerse":18}],"sourceAttributes":{"name":"IIChr.10.18","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[10],"sourceItemFragmentSha256":"b1ff04f244ce464aaf4b3334f1965c17d4d06cfc708fb635924c3d5618be94e1","sourceItemName":"IIChr.10.18","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4971,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.10.18","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.10.18","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}