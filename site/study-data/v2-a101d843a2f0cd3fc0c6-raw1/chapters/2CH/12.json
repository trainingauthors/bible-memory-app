2:6-7"}],"sourceClass":"sn-ref","t":"span"}," Shemaiah’s speech expresses the elements required in Solomon’s prayer at the dedication of the Temple (",{"href":"?bref=2Chr.7.14","r":"2Chr.7.14","rawR":"2Chr.7.14","sourceRefs":[{"raw":"2Chr.7.14","value":"2Chr.7.14"}],"t":"ref","v":"7:14"},"). ",{"c":["The leaders of Israel . . . humbled themselves"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," and the wrath of judgment was removed from ",{"c":["Jerusalem"],"sourceClass":"sn-excerpt","t":"span"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.12.6-7","refs":[{"book":"2CH","endChapter":12,"endVerse":7,"startChapter":12,"startVerse":6}],"sourceAttributes":{"name":"IIChr.12.6-7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[12],"sourceItemFragmentSha256":"e4dff1d830160e8717675838f30ae9184b634430b4098aad393f74013c9fe2c5","sourceItemName":"IIChr.12.6-7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4983,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.12.6-7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.12.6-7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.12.9-11","r":"2Chr.12.9-11","rawR":"2Chr.12.9-11","sourceRefs":[{"raw":"2Chr.12.9-11","value":"2Chr.12.9-11"}],"t":"ref","v":"12:9-11"}],"sourceClass":"sn-ref","t":"span"}," The looting of the royal ",{"c":["treasuries"],"sourceClass":"sn-excerpt","t":"span"}," and of the ",{"c":["Temple"],"sourceClass":"sn-excerpt","t":"span"}," were the punishment ",{"c":["Rehoboam"],"sourceClass":"sn-excerpt","t":"span"}," received for his disobedience. The ",{"c":["gold shields"],"sourceClass":"sn-excerpt","t":"span"}," were ritually carried by ",{"c":["the guard"],"sourceClass":"sn-excerpt","t":"span"}," accompanying ",{"c":["the king"],"sourceClass":"sn-excerpt","t":"span"}," when he moved from the palace to the Temple. The royal processionals lost much of their splendor with the ",{"c":["bronze shields"],"sourceClass":"sn-excerpt","t":"span"}," (cp. ",{"href":"?bref=2Chr.9.15-16","r":"2Chr.9.15-16","rawR":"2Chr.9.15-16","sourceRefs":[{"raw":"2Chr.9.15-16","value":"2Chr.9.15-16"}],"t":"ref","v":"9:15-16"},"), which were safely stored in the huge armory Solomon had built (",{"href":"?bref=2Chr.8.6","r":"2Chr.8.6","rawR":"2Chr.8.6","sourceRefs":[{"raw":"2Chr.8.6","value":"2Chr.8.6"}],"t":"ref","v":"8:6"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.12.9-11","refs":[{"book":"2CH","endChapter":12,"endVerse":11,"startChapter":12,"startVerse":9}],"sourceAttributes":{"name":"IIChr.12.9-11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[12],"sourceItemFragmentSha256":"079e91f9be0f853c80b1a0f9ce37f220f9437c396b4260e637275effaf280161","sourceItemName":"IIChr.12.9-11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4984,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.12.9-11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.12.9-11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.12.12","r":"2Chr.12.12","rawR":"2Chr.12.12","sourceRefs":[{"raw":"2Chr.12.12","value":"2Chr.12.12"}],"t":"ref","v":"12:12"}],"sourceClass":"sn-ref","t":"span"}," When ",{"c":["Rehoboam"],"sourceClass":"sn-excerpt","t":"span"}," repented, God allowed ",{"c":["good things"],"sourceClass":"sn-excerpt","t":"span"}," to remain in Jerusalem: the repentance of the people, their resolve to seek the Lord, and the preservation of worship (see ",{"href":"?bref=2Chr.19.3","r":"2Chr.19.3","rawR":"2Chr.19.3","sourceRefs":[{"raw":"2Chr.19.3","value":"2Chr.19.3"}],"t":"ref","v":"19:3"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.12.12","refs":[{"book":"2CH","endChapter":12,"endVerse":12,"startChapter":12,"startVerse":12}],"sourceAttributes":{"name":"IIChr.12.12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[12],"sourceItemFragmentSha256":"64fcb3a327d8c2fb5f5a7a23e8928c55f76855ed4bdc90b18c5beb2a9b949fcb","sourceItemName":"IIChr.12.12","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4985,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.12.12","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.12.12","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}