bijah","title":"Abijah"},{"id":"Abijam","title":"Abijam"},{"id":"ArchaeologyandtheBible","title":"Archaeology and the Bible*"},{"id":"Asa","title":"Asa"},{"id":"ChroniclesBooksofFirstandSecond","title":"Chronicles, Books of First and Second"},{"id":"Genealogy","title":"Genealogy"},{"id":"MareshahPlace","title":"Mareshah (Place)"},{"id":"Zerah","title":"Zerah"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"David","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"David::David::reviewed_unambiguous_name","sourceHeadwordId":"David"},"text":"Then Abijah rested with his fathers and was buried in the City of David. And his son Asa reigned in his place, and in his days the land was at peace for ten years.","verse":1}],"id":"David","label":"David","matchReviews":[{"ruleId":"David::David::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"David","term":"David"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"David","sourceTitle":"David"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Gerar","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":7,"href":"?bref=2Chr.14.13-14","rawReference":"2Chr.14.13-14"}],"ruleId":"Gerar::Gerar::source_verse_citation","sourceHeadwordId":"Gerar"},"text":"Then Asa and his army pursued them as far as Gerar. The Cushites fell and could not recover, for they were crushed before the LORD and His army. So the people of Judah carried off a great amount of plunder","verse":13},{"matchingRule":"reviewed_exact_headword","phrase":"Gerar","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":7,"href":"?bref=2Chr.14.13-14","rawReference":"2Chr.14.13-14"}],"ruleId":"Gerar::Gerar::source_verse_citation","sourceHeadwordId":"Gerar"},"text":"and attacked all the cities around Gerar, because the terror of the LORD had fallen upon them. They plundered all the cities, since there was much plunder there.","verse":14}],"id":"Gerar","label":"Gerar","matchReviews":[{"ruleId":"Gerar::Gerar::source_verse_citation","scope":"source_verse_citation","senseReview":"Original complete headword and source opening identify a named person, people, or place. Promotion requires a capitalized whole name and the original article explicitly citing this same BSB verse. No arbitrary qualifier stripping or book-title inference. This citation-constrained rule was reviewed once globally; unmatched contexts remain excluded.","sourceHeadwordId":"Gerar","term":"Gerar"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Gerar","sourceTitle":"Gerar"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Jerusalem","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Jerusalem::Jerusalem::reviewed_unambiguous_name","sourceHeadwordId":"Jerusalem"},"text":"They also attacked the tents of the herdsmen and carried off many sheep and camels. Then they returned to Jerusalem.","verse":15}],"id":"Jerusalem","label":"Jerusalem","matchReviews":[{"ruleId":"Jerusalem::Jerusalem::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Jerusalem","term":"Jerusalem"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Jerusalem","sourceTitle":"Jerusalem"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"And Asa did what was good and right in the eyes of the LORD his God.","verse":2},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"He commanded the people of Judah to seek the LORD, the God of their fathers, and to observe the law and the commandments.","verse":4},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Because the land was at peace, Asa built fortified cities in Judah. In those days no one made war with him, because the LORD had given him rest.","verse":6},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"So he said to the people of Judah, “Let us build these cities and surround them with walls and towers, with doors and bars. The land is still ours because we have sought the LORD our God. We have sought Him, and He has given us rest on every side.” So they built and prospered.","verse":7},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Then Asa cried out to the LORD his God: “O LORD, there is no one besides You to help the powerless against the mighty. Help us, O LORD our God, for we rely on You, and in Your name we have come against this multitude. O LORD, You are our God. Do not let a mere mortal prevail against You.”","verse":11},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"So the LORD struck down the Cushites before Asa and Judah, and the Cushites fled.","verse":12},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Then Asa and his army pursued them as far as Gerar. The Cushites fell and could not recover, for they were crushed before the LORD and His army. So the people of Judah carried off a great amount of plunder","verse":13},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"and attacked all the cities around Gerar, because the terror of the LORD had fallen upon them. They plundered all the cities, since there was much plunder there.","verse":14}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Zephathah","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":0,"href":"?bref=2Chr.14.10","rawReference":"2Chr.14.10"}],"ruleId":"Zephathah::Zephathah::source_verse_citation","sourceHeadwordId":"Zephathah"},"text":"So Asa marched out against him and lined up in battle formation in the Valley of Zephathah near Mareshah.","verse":10}],"id":"Zephathah","label":"Zephathah","matchReviews":[{"ruleId":"Zephathah::Zephathah::source_verse_citation","scope":"source_verse_citation","senseReview":"Original complete headword and source opening identify a named person, people, or place. Promotion requires a capitalized whole name and the original article explicitly citing this same BSB verse. No arbitrary qualifier stripping or book-title inference. This citation-constrained rule was reviewed once globally; unmatched contexts remain excluded.","sourceHeadwordId":"Zephathah","term":"Zephathah"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Zephathah","sourceTitle":"Zephathah*"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":["Asa"],"sourceClass":"profile-title","t":"h"},{"c":["Asa became the third king of Judah after the split of Solomon’s empire into independent kingdoms. Asa succeeded his father, Abijah, after Abijah’s brief kingship (913–910 ",{"c":["BC"],"sourceClass":"era","t":"span"},") and reigned for 41 years (910–869 ",{"c":["BC"],"sourceClass":"era","t":"span"},")."],"sourceClass":"profile-body-fl","t":"p"},{"c":["In the beginning of his reign, Asa was a good king. He opposed the worship of false gods in the land, destroyed the Asherah pole that his grandmother Maacah had set up, and removed her remaining political influence (",{"href":"?bref=1Kgs.15.13","r":"1Kgs.15.13","rawR":"1Kgs.15.13","sourceRefs":[{"raw":"1Kgs.15.13","value":"1Kgs.15.13"}],"t":"ref","v":"1 Kgs 15:13"},"; ",{"href":"?bref=2Chr.15.16","r":"2Chr.15.16","rawR":"2Chr.15.16","sourceRefs":[{"raw":"2Chr.15.16","value":"2Chr.15.16"}],"t":"ref","v":"2 Chr 15:16"},")."],"sourceClass":"profile-body","t":"p"},{"c":["In these early days, God blessed Asa’s reign with military victory and peace. Asa forced out or defeated all who attempted to conquer, divide, or destroy Judah (",{"href":"?bref=2Chr.14.1-8","r":"2Chr.14.1-8","rawR":"2Chr.14.1-8","sourceRefs":[{"raw":"2Chr.14.1-8","value":"2Chr.14.1-8"}],"t":"ref","v":"2 Chr 14:1-8"},"). Asa’s most astounding conquest was over an Ethiopian leader named Zerah, who attacked Judah with more than a million troops. Because of Asa’s obedience and faithfulness, God gave him a tremendous victory (",{"href":"?bref=2Chr.14.9-15","r":"2Chr.14.9-15","rawR":"2Chr.14.9-15","sourceRefs":[{"raw":"2Chr.14.9-15","value":"2Chr.14.9-15"}],"t":"ref","v":"14:9-15"},")."],"sourceClass":"profile-body","t":"p"},{"c":["Unfortunately, Asa’s attitude changed toward the end of his life, and he abandoned his trust in God. Baasha, the king of the northern kingdom, attacked Judah with the support of Ben-hadad, king of Aram, and fortified the city of Ramah. Asa paid the king of Aram to change sides and support him rather than Baasha. This meant that Asa had more confidence in a foreign king than in the Lord. Worse, Asa paid Ben-hadad with gold and silver that he had earlier given to the Temple! Asa’s power play worked, and the northern kingdom of Israel had to leave Judah to stave off Ben-hadad’s threat from the north. But the prophet Hanani rebuked Asa for his disbelief in God. Infuriated, Asa had Hanani thrown into prison (",{"href":"?bref=2Chr.16.7-10","r":"2Chr.16.7-10","rawR":"2Chr.16.7-10","sourceRefs":[{"raw":"2Chr.16.7-10","value":"2Chr.16.7-10"}],"t":"ref","v":"16:7-10"},")."],"sourceClass":"profile-body","t":"p"},{"c":["For the final years of his reign, Asa became ill with a serious foot disease. “Even with the severity of his disease, he did not seek the ",{"c":["Lord"],"sourceClass":"divine-name","t":"span"},"’s help but turned only to his physicians” (",{"href":"?bref=2Chr.16.12","r":"2Chr.16.12","rawR":"2Chr.16.12","sourceRefs":[{"raw":"2Chr.16.12","value":"2Chr.16.12"}],"t":"ref","v":"16:12"},"). Even so, when Asa died he was buried with honor in the royal tombs (",{"href":"?bref=2Chr.16.14","r":"2Chr.16.14","rawR":"2Chr.16.14","sourceRefs":[{"raw":"2Chr.16.14","value":"2Chr.16.14"}],"t":"ref","v":"16:14"},")."],"sourceClass":"profile-body","t":"p"},{"c":["Passages for Further Study"],"sourceClass":"profile-refs-title","t":"h"},{"c":[{"href":"?bref=1Kgs.15.8-24","r":"1Kgs.15.8-24","rawR":"1Kgs.15.8-24","sourceRefs":[{"raw":"1Kgs.15.8-24","value":"1Kgs.15.8-24"}],"t":"ref","v":"1 Kgs 15:8-24"},"; ",{"href":"?bref=2Chr.14.1-16.14","r":"2Chr.14.1-16.14","rawR":"2Chr.14.1-16.14","sourceRefs":[{"raw":"2Chr.14.1-16.14","value":"2Chr.14.1-16.14"}],"t":"ref","v":"2 Chr 14:1–16:14"}],"sourceClass":"profile-refs","t":"p"}],"id":"Profile:Asa","refs":[{"book":"2CH","endChapter":16,"endVerse":14,"startChapter":14,"startVerse":1}],"sourceAttributes":{"name":"Asa","product":"TyndaleOpenStudyNotes","typename":"Profile"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[14,15,16],"sourceItemFragmentSha256":"f6514c334edaaeeb615f478c47e6942855557e8aa8034a8f26b1190f804bdeeb","sourceItemName":"Asa","sourceMember":"Tyndale Open Study Notes/Profiles.xml","sourceOrder":61,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.14.1-16.14","sourceRelease":"1.25","sourceTitleExact":"Asa","supplementPointersNotIncludedAsContent":[],"title":"Asa","type":"Profile"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.14.1","r":"2Chr.14.1","rawR":"2Chr.14.1","sourceRefs":[{"raw":"2Chr.14.1","value":"2Chr.14.1"}],"t":"ref","v":"14:1"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Asa"],"sourceClass":"sn-excerpt","t":"span"}," reigned from 910 to 869 ",{"c":["BC"],"sourceClass":"era","t":"span"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.14.1","refs":[{"book":"2CH","endChapter":14,"endVerse":1,"startChapter":14,"startVerse":1}],"sourceAttributes":{"name":"IIChr.14.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[14],"sourceItemFragmentSha256":"bc4446746c1bc0a835acc773f89a39a0fe2ab9eafd94134d0c2d0930d96d4fec","sourceItemName":"IIChr.14.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4996,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.14.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.14.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.14.2-5","r":"2Chr.14.2-5","rawR":"2Chr.14.2-5","sourceRefs":[{"raw":"2Chr.14.2-5","value":"2Chr.14.2-5"}],"t":"ref","v":"14:2-5"}],"sourceClass":"sn-ref","t":"span"}," At the beginning of his reign, ",{"c":["Asa . . . removed the foreign altars"],"sourceClass":"sn-excerpt","t":"span"}," in Judah (",{"href":"?bref=2Chr.14.5","r":"2Chr.14.5","rawR":"2Chr.14.5","sourceRefs":[{"raw":"2Chr.14.5","value":"2Chr.14.5"}],"t":"ref","v":"14:5"},"). However, he did not remove the pagan shrines from Israel (",{"href":"?bref=2Chr.15.17","r":"2Chr.15.17","rawR":"2Chr.15.17","sourceRefs":[{"raw":"2Chr.15.17","value":"2Chr.15.17"}],"t":"ref","v":"15:17"},"). These were probably in the cities of the northern kingdom that Asa had inherited from Abijah. Idolatry practiced by other peoples occupying the land plagued Judah throughout its history; this pagan activity might have revived toward the end of Asa’s reign more than thirty years later."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.14.2-5","refs":[{"book":"2CH","endChapter":14,"endVerse":5,"startChapter":14,"startVerse":2}],"sourceAttributes":{"name":"IIChr.14.2-5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[14],"sourceItemFragmentSha256":"493775d7d5d4004f54318808cdb2c53efb9ce109a740fdb6e29c9d2c407d5815","sourceItemName":"IIChr.14.2-5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4997,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.14.2-5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.14.2-5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.14.4","r":"2Chr.14.4","rawR":"2Chr.14.4","sourceRefs":[{"raw":"2Chr.14.4","value":"2Chr.14.4"}],"t":"ref","v":"14:4"}],"sourceClass":"sn-ref","t":"span"}," The phrase ",{"c":["seek the"],"sourceClass":"sn-excerpt","t":"span"}," ",{"c":["Lord"],"sourceClass":"sn-excerpt-divine-name","t":"span"}," is the Chronicler’s formula for restoration; it both highlights and critiques Asa’s reign (see ",{"href":"?bref=2Chr.15.2","r":"2Chr.15.2","rawR":"2Chr.15.2","sourceRefs":[{"raw":"2Chr.15.2","value":"2Chr.15.2"}],"t":"ref","v":"15:2"},", ",{"href":"?bref=2Chr.15.12-13","r":"2Chr.15.12-13","rawR":"2Chr.15.12-13","sourceRefs":[{"raw":"2Chr.15.12-13","value":"2Chr.15.12-13"}],"t":"ref","v":"12-13"},"; ",{"href":"?bref=2Chr.16.12","r":"2Chr.16.12","rawR":"2Chr.16.12","sourceRefs":[{"raw":"2Chr.16.12","value":"2Chr.16.12"}],"t":"ref","v":"16:12"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.14.4","refs":[{"book":"2CH","endChapter":14,"endVerse":4,"startChapter":14,"startVerse":4}],"sourceAttributes":{"name":"IIChr.14.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[14],"sourceItemFragmentSha256":"41ef04eac07c99336ace94972c1808b615dff9e7755d84927203cd9d15ba9deb","sourceItemName":"IIChr.14.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4998,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.14.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.14.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.14.7-14","r":"2Chr.14.7-14","rawR":"2Chr.14.7-14","sourceRefs":[{"raw":"2Chr.14.7-14","value":"2Chr.14.7-14"}],"t":"ref","v":"14:7-14"}],"sourceClass":"sn-ref","t":"span"}," Solomon had prayed that the Lord would hear his people when they were led into battle (",{"href":"?bref=2Chr.6.34","r":"2Chr.6.34","rawR":"2Chr.6.34","sourceRefs":[{"raw":"2Chr.6.34","value":"2Chr.6.34"}],"t":"ref","v":"6:34"},"). In the battle against ",{"c":["Zerah"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," God responded to such a prayer. • ",{"c":["Ethiopian"],"sourceClass":"sn-excerpt","t":"span"}," (literally “Cushite”) might refer to someone from southern Egypt (Nubia) or a Midianite territory northeast of Aqabah (see ",{"href":"?bref=Num.12.1","r":"Num.12.1","rawR":"Num.12.1","sourceRefs":[{"raw":"Num.12.1","value":"Num.12.1"}],"t":"ref","v":"Num 12:1"},"; ",{"href":"?bref=Hab.3.7","r":"Hab.3.7","rawR":"Hab.3.7","sourceRefs":[{"raw":"Hab.3.7","value":"Hab.3.7"}],"t":"ref","v":"Hab 3:7"},"). However, the mention of Libya in ",{"href":"?bref=2Chr.16.8","r":"2Chr.16.8","rawR":"2Chr.16.8","sourceRefs":[{"raw":"2Chr.16.8","value":"2Chr.16.8"}],"t":"ref","v":"2 Chr 16:8"},", the size of the battle (comparable to the attack of Shishak against Rehoboam in ",{"href":"?bref=2Chr.12.3","r":"2Chr.12.3","rawR":"2Chr.12.3","sourceRefs":[{"raw":"2Chr.12.3","value":"2Chr.12.3"}],"t":"ref","v":"12:3"},"), and the location of Mareshah in the west of Judah indicate that Zerah was an Egyptian; he is otherwise unknown. He might have been a Nubian general dispatched by Osorkon I, the Libyan pharaoh who ruled Egypt between the tenth and fourteenth years of Asa (900–897 ",{"c":["BC"],"sourceClass":"era","t":"span"},"). Another view is that Shishak established a buffer state around Gerar, supported by Nubian mercenaries that invaded Judah. The account, however, only says that Asa and his armies pursued the armies south to ",{"c":["Gerar"],"sourceClass":"sn-excerpt","t":"span"}," and took a ",{"c":["vast amount of plunder"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," particularly from the herdsmen living in tents around the cities."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.14.7-14","refs":[{"book":"2CH","endChapter":14,"endVerse":14,"startChapter":14,"startVerse":7}],"sourceAttributes":{"name":"IIChr.14.7-14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[14],"sourceItemFragmentSha256":"482f2e2883c8d0d2806748163dcc876a6c11270d43345c62a1fd80d1417fe235","sourceItemName":"IIChr.14.7-14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4999,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.14.7-14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.14.7-14","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}