le":"Chronicles, Books of First and Second"},{"id":"Genealogy","title":"Genealogy"},{"id":"Horesh","title":"Horesh"},{"id":"JerushaJerushah","title":"Jerusha, Jerushah*"},{"id":"Jotham","title":"Jotham"},{"id":"Midrash","title":"Midrash*"},{"id":"SiloamTowerof","title":"Siloam, Tower of"},{"id":"Uzziah","title":"Uzziah"},{"id":"Zadok","title":"Zadok"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"David","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"David::David::reviewed_unambiguous_name","sourceHeadwordId":"David"},"text":"And Jotham rested with his fathers and was buried in the City of David. And his son Ahaz reigned in his place.","verse":9}],"id":"David","label":"David","matchReviews":[{"ruleId":"David::David::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"David","term":"David"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"David","sourceTitle":"David"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Jerusalem","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Jerusalem::Jerusalem::reviewed_unambiguous_name","sourceHeadwordId":"Jerusalem"},"text":"Jotham was twenty-five years old when he became king, and he reigned in Jerusalem sixteen years. His mother’s name was Jerushah daughter of Zadok.","verse":1},{"matchingRule":"reviewed_exact_headword","phrase":"Jerusalem","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Jerusalem::Jerusalem::reviewed_unambiguous_name","sourceHeadwordId":"Jerusalem"},"text":"He was twenty-five years old when he became king, and he reigned in Jerusalem sixteen years.","verse":8}],"id":"Jerusalem","label":"Jerusalem","matchReviews":[{"ruleId":"Jerusalem::Jerusalem::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Jerusalem","term":"Jerusalem"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Jerusalem","sourceTitle":"Jerusalem"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"And he did what was right in the eyes of the LORD, just as his father Uzziah had done. In addition, he did not enter the temple of the LORD. But the people still behaved corruptly.","verse":2},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Jotham rebuilt the Upper Gate of the house of the LORD, and he worked extensively on the wall at the hill of Ophel.","verse":3},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"So Jotham grew powerful because he ordered his ways before the LORD his God.","verse":6}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Ophel","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":1,"href":"?bref=2Chr.27.3","rawReference":"2Chr.27.3"}],"ruleId":"Ophel::Ophel::source_verse_citation","sourceHeadwordId":"Ophel"},"text":"Jotham rebuilt the Upper Gate of the house of the LORD, and he worked extensively on the wall at the hill of Ophel.","verse":3}],"id":"Ophel","label":"Ophel","matchReviews":[{"ruleId":"Ophel::Ophel::source_verse_citation","scope":"source_verse_citation","senseReview":"Original complete headword and source opening identify a named person, people, or place. Promotion requires a capitalized whole name and the original article explicitly citing this same BSB verse. No arbitrary qualifier stripping or book-title inference. This citation-constrained rule was reviewed once globally; unmatched contexts remain excluded.","sourceHeadwordId":"Ophel","term":"Ophel"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Ophel","sourceTitle":"Ophel"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Upper Gate","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":1,"href":"?bref=2Chr.27.3","rawReference":"2Chr.27.3"}],"ruleId":"UpperGate::Upper Gate::source_verse_citation","sourceHeadwordId":"UpperGate"},"text":"Jotham rebuilt the Upper Gate of the house of the LORD, and he worked extensively on the wall at the hill of Ophel.","verse":3}],"id":"UpperGate","label":"Upper Gate","matchReviews":[{"ruleId":"UpperGate::Upper Gate::source_verse_citation","scope":"source_verse_citation","senseReview":"Reviewed full original phrase headword in its stated biblical sense. The entire phrase must occur and this article must explicitly cite the same verse; no shortened fragment or inferred topical synonym is matched.","sourceHeadwordId":"UpperGate","term":"Upper Gate"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"UpperGate","sourceTitle":"Upper Gate"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.27.1","r":"2Chr.27.1","rawR":"2Chr.27.1","sourceRefs":[{"raw":"2Chr.27.1","value":"2Chr.27.1"}],"t":"ref","v":"27:1"}],"sourceClass":"sn-ref","t":"span"}," After a co-regency of eleven years with his father, Uzziah (750–740 ",{"c":["BC"],"sourceClass":"era","t":"span"},"), ",{"c":["Jotham"],"sourceClass":"sn-excerpt","t":"span"}," became king in his own right and ",{"c":["reigned"],"sourceClass":"sn-excerpt","t":"span"}," five more years (740–735 ",{"c":["BC"],"sourceClass":"era","t":"span"},"). This represents the ",{"c":["sixteen years"],"sourceClass":"sn-excerpt","t":"span"}," mentioned in the text. Jotham lived at least four more years, for we read that Hoshea came to power in the northern kingdom “in the twentieth year of Jotham son of Uzziah” (",{"href":"?bref=2Kgs.15.30","r":"2Kgs.15.30","rawR":"2Kgs.15.30","sourceRefs":[{"raw":"2Kgs.15.30","value":"2Kgs.15.30"}],"t":"ref","v":"2 Kgs 15:30"},"). But Jotham’s son, Ahaz, had already begun a co-regency with Jotham. After Jotham’s sixteen official years, Ahaz began to rule in his father’s stead (see ",{"href":"?item=IIKgs.16.1-2_StudyNote_Filament","id":"IIKgs.16.1-2_StudyNote_Filament","rawId":"IIKgs.16.1-2_StudyNote_Filament","t":"link","v":"study note on 2 Kgs 16:1-2"},"). However, Ahaz presumably had his official accession ceremony following his father’s death in 732 ",{"c":["BC"],"sourceClass":"era","t":"span"},", so the author of 2 Chronicles reckons Ahaz’s official regnal years starting in 731 ",{"c":["BC"],"sourceClass":"era","t":"span"}," (see ",{"href":"?bref=2Chr.28.1","r":"2Chr.28.1","rawR":"2Chr.28.1","sourceRefs":[{"raw":"2Chr.28.1","value":"2Chr.28.1"}],"t":"ref","v":"2 Chr 28:1"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.27.1","refs":[{"book":"2CH","endChapter":27,"endVerse":1,"startChapter":27,"startVerse":1}],"sourceAttributes":{"name":"IIChr.27.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[27],"sourceItemFragmentSha256":"f8fbc72c0cad11378f7bbbb2dafee926fa5efbf7de2e72e7829c670534e58a71","sourceItemName":"IIChr.27.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5085,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.27.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.27.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.27.3-4","r":"2Chr.27.3-4","rawR":"2Chr.27.3-4","sourceRefs":[{"raw":"2Chr.27.3-4","value":"2Chr.27.3-4"}],"t":"ref","v":"27:3-4"}],"sourceClass":"sn-ref","t":"span"}," Jotham’s rebuilding endeavors were like those of his father; he continued the work of restoration begun by Uzziah. He also constructed ",{"c":["fortresses and towers"],"sourceClass":"sn-excerpt","t":"span"}," in the forests, providing a network of lookouts and highway defenses within the kingdom and on the frontier."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.27.3-4","refs":[{"book":"2CH","endChapter":27,"endVerse":4,"startChapter":27,"startVerse":3}],"sourceAttributes":{"name":"IIChr.27.3-4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[27],"sourceItemFragmentSha256":"b65e58feb1073fc50b4695ed3138c3eab76f110ce4f0f468c18a451a44aa2179","sourceItemName":"IIChr.27.3-4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5086,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.27.3-4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.27.3-4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.27.5","r":"2Chr.27.5","rawR":"2Chr.27.5","sourceRefs":[{"raw":"2Chr.27.5","value":"2Chr.27.5"}],"t":"ref","v":"27:5"}],"sourceClass":"sn-ref","t":"span"}," Uzziah had received tribute from ",{"c":["the Ammonites"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=2Chr.26.8","r":"2Chr.26.8","rawR":"2Chr.26.8","sourceRefs":[{"raw":"2Chr.26.8","value":"2Chr.26.8"}],"t":"ref","v":"26:8"},"), and Jotham continued to dominate their territory east of the Jordan. The end of these payments after ",{"c":["three years"],"sourceClass":"sn-excerpt","t":"span"}," might have been because of Jotham’s preoccupation with fighting Israel and Aram (",{"href":"?bref=2Kgs.15.37","r":"2Kgs.15.37","rawR":"2Kgs.15.37","sourceRefs":[{"raw":"2Kgs.15.37","value":"2Kgs.15.37"}],"t":"ref","v":"2 Kgs 15:37"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.27.5","refs":[{"book":"2CH","endChapter":27,"endVerse":5,"startChapter":27,"startVerse":5}],"sourceAttributes":{"name":"IIChr.27.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[27],"sourceItemFragmentSha256":"fdf2d1b78ef9d090c9a737344f2d2971d05f89b77e9451e0acb597cdc89f0a0a","sourceItemName":"IIChr.27.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5087,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.27.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.27.5","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}