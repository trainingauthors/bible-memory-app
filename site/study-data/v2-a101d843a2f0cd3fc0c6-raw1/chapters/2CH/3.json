elBooksofFirstandSecond","title":"Samuel, Books of First and Second"},{"id":"Temple","title":"Temple"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"David","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"David::David::reviewed_unambiguous_name","sourceHeadwordId":"David"},"text":"Then Solomon began to build the house of the LORD in Jerusalem on Mount Moriah, where the LORD had appeared to his father David. This was the place that David had prepared on the threshing floor of Ornan the Jebusite.","verse":1}],"id":"David","label":"David","matchReviews":[{"ruleId":"David::David::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"David","term":"David"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"David","sourceTitle":"David"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Jerusalem","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[{"anchorIndex":8,"href":"?bref=2Chr.3.1","rawReference":"2Chr.3.1"}],"ruleId":"Jerusalem::Jerusalem::reviewed_unambiguous_name","sourceHeadwordId":"Jerusalem"},"text":"Then Solomon began to build the house of the LORD in Jerusalem on Mount Moriah, where the LORD had appeared to his father David. This was the place that David had prepared on the threshing floor of Ornan the Jebusite.","verse":1}],"id":"Jerusalem","label":"Jerusalem","matchReviews":[{"ruleId":"Jerusalem::Jerusalem::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Jerusalem","term":"Jerusalem"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Jerusalem","sourceTitle":"Jerusalem"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Then Solomon began to build the house of the LORD in Jerusalem on Mount Moriah, where the LORD had appeared to his father David. This was the place that David had prepared on the threshing floor of Ornan the Jebusite.","verse":1}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.3.1-4","r":"2Chr.3.1-4","rawR":"2Chr.3.1-4","sourceRefs":[{"raw":"2Chr.3.1-4","value":"2Chr.3.1-4"}],"t":"ref","v":"3:1-4a"}],"sourceClass":"sn-ref","t":"span"}," Although in Chronicles ",{"c":["the Temple"],"sourceClass":"sn-excerpt","t":"span"}," is the central topic of Solomon’s reign, attention to its actual architecture and furnishings is considerably less than that found in Kings (e.g., ",{"href":"?bref=1Kgs.6.2-10","r":"1Kgs.6.2-10","rawR":"1Kgs.6.2-10","sourceRefs":[{"raw":"1Kgs.6.2-10","value":"1Kgs.6.2-10"}],"t":"ref","v":"1 Kgs 6:2-10"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.3.1-4","refs":[{"book":"2CH","endChapter":3,"endVerse":4,"startChapter":3,"startVerse":1}],"sourceAttributes":{"name":"IIChr.3.1-4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"7c7decd96ba345a9884f1f7b916b136e008491ddbfe5c9e03d518dbfa33533c2","sourceItemName":"IIChr.3.1-4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4907,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.3.1-4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.3.1-4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.3.1","r":"2Chr.3.1","rawR":"2Chr.3.1","sourceRefs":[{"raw":"2Chr.3.1","value":"2Chr.3.1"}],"t":"ref","v":"3:1"}],"sourceClass":"sn-ref","t":"span"}," While Kings emphasizes the time when ",{"c":["the Temple"],"sourceClass":"sn-excerpt","t":"span"}," was built, Chronicles places great emphasis on the Temple’s building site and the significance of the location. Geographically, it was ",{"c":["in Jerusalem on Mount Moriah"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," the place ",{"c":["where the"],"sourceClass":"sn-excerpt","t":"span"}," ",{"c":["Lord"],"sourceClass":"sn-excerpt-divine-name","t":"span"},{"c":[" had appeared to David"],"sourceClass":"sn-excerpt","t":"span"},{"c":[";"],"sourceClass":"ital","t":"span"}," it was ",{"c":["selected"],"sourceClass":"sn-excerpt","t":"span"}," under David’s authority, and it was the sacred place where the plague was stopped at the ",{"c":["threshing floor of Araunah the Jebusite"],"sourceClass":"sn-excerpt","t":"span"},". Abraham bound Isaac in the land of ",{"c":["Moriah"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=Gen.22.2","r":"Gen.22.2","rawR":"Gen.22.2","sourceRefs":[{"raw":"Gen.22.2","value":"Gen.22.2"}],"t":"ref","v":"Gen 22:2"},"), and tradition associated the Temple Mount as the place where the Lord provided for Abraham (",{"href":"?bref=Gen.22.14","r":"Gen.22.14","rawR":"Gen.22.14","sourceRefs":[{"raw":"Gen.22.14","value":"Gen.22.14"}],"t":"ref","v":"Gen 22:14"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.3.1","refs":[{"book":"2CH","endChapter":3,"endVerse":1,"startChapter":3,"startVerse":1}],"sourceAttributes":{"name":"IIChr.3.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"df3a61d1ef05afd154df7ef860b7274c0ee215943fadd580f4296b8276055249","sourceItemName":"IIChr.3.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4908,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.3.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.3.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.3.2","r":"2Chr.3.2","rawR":"2Chr.3.2","sourceRefs":[{"raw":"2Chr.3.2","value":"2Chr.3.2"}],"t":"ref","v":"3:2"}],"sourceClass":"sn-ref","t":"span"}," The book of Kings dates the beginning of the Temple construction in relation to the exodus from Egypt (",{"href":"?bref=1Kgs.6.1","r":"1Kgs.6.1","rawR":"1Kgs.6.1","sourceRefs":[{"raw":"1Kgs.6.1","value":"1Kgs.6.1"}],"t":"ref","v":"1 Kgs 6:1"},"). Chronicles consistently omits references to the Exodus, perhaps to emphasize the continuous and abiding bond between the people, the land, and God."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.3.2","refs":[{"book":"2CH","endChapter":3,"endVerse":2,"startChapter":3,"startVerse":2}],"sourceAttributes":{"name":"IIChr.3.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"18207307ae1cd96521ee7c57c264028dcc4a7a12c66fee7f25da733f9035ec9f","sourceItemName":"IIChr.3.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4909,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.3.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.3.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.3.5-7","r":"2Chr.3.5-7","rawR":"2Chr.3.5-7","sourceRefs":[{"raw":"2Chr.3.5-7","value":"2Chr.3.5-7"}],"t":"ref","v":"3:5-7"}],"sourceClass":"sn-ref","t":"span"}," The interior of the Temple was finished with costly materials (see ",{"href":"?bref=1Kgs.6.15-18","r":"1Kgs.6.15-18","rawR":"1Kgs.6.15-18","sourceRefs":[{"raw":"1Kgs.6.15-18","value":"1Kgs.6.15-18"}],"t":"ref","v":"1 Kgs 6:15-18"},", ",{"href":"?bref=1Kgs.6.29","r":"1Kgs.6.29","rawR":"1Kgs.6.29","sourceRefs":[{"raw":"1Kgs.6.29","value":"1Kgs.6.29"}],"t":"ref","v":"29"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.3.5-7","refs":[{"book":"2CH","endChapter":3,"endVerse":7,"startChapter":3,"startVerse":5}],"sourceAttributes":{"name":"IIChr.3.5-7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"6d1cd61f53f8759e2f38ab3b5987627046a4214751b03a0618052736ea2169d4","sourceItemName":"IIChr.3.5-7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4910,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.3.5-7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.3.5-7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.3.6","r":"2Chr.3.6","rawR":"2Chr.3.6","sourceRefs":[{"raw":"2Chr.3.6","value":"2Chr.3.6"}],"t":"ref","v":"3:6"}],"sourceClass":"sn-ref","t":"span"}," The gold from ",{"c":["the land of Parvaim"],"sourceClass":"sn-excerpt","t":"span"}," was the highest quality. The actual location of this place was unknown by the time of the earliest translators and might not have been known to the Chronicler either."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.3.6","refs":[{"book":"2CH","endChapter":3,"endVerse":6,"startChapter":3,"startVerse":6}],"sourceAttributes":{"name":"IIChr.3.6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"6a3b31280a9841e8ca0098c6c4d995083f316f1e44e57f47a347c03d92fd3a03","sourceItemName":"IIChr.3.6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4911,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.3.6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.3.6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.3.8","r":"2Chr.3.8","rawR":"2Chr.3.8","sourceRefs":[{"raw":"2Chr.3.8","value":"2Chr.3.8"}],"t":"ref","v":"3:8"}],"sourceClass":"sn-ref","t":"span"}," A special area was constructed at the extreme interior of the hall known as ",{"c":["the Most Holy Place"],"sourceClass":"sn-excerpt","t":"span"}," (the divine throne room). It might have been a sacred throne space within the long hall, or it might have been a secondary room within the main hall. The dimensions of ",{"c":["the Most Holy Place"],"sourceClass":"ital","t":"span"}," were equally ",{"c":["30 feet"],"sourceClass":"sn-excerpt","t":"span"}," (20 cubits) in all directions. It might have rested on an elevated platform, as did the shrines of other temples, and a space might have existed between the room and the roof. ",{"c":["The Most Holy Place"],"sourceClass":"ital","t":"span"}," was prepared as a repository for the Ark, which contained the terms of the covenant."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.3.8","refs":[{"book":"2CH","endChapter":3,"endVerse":8,"startChapter":3,"startVerse":8}],"sourceAttributes":{"name":"IIChr.3.8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"97ee1a37423fa860078924b49e57a19820abc69c6430aa105cea83189ef331cb","sourceItemName":"IIChr.3.8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4912,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.3.8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.3.8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.3.10-13","r":"2Chr.3.10-13","rawR":"2Chr.3.10-13","sourceRefs":[{"raw":"2Chr.3.10-13","value":"2Chr.3.10-13"}],"t":"ref","v":"3:10-13"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["figures shaped like cherubim"],"sourceClass":"sn-excerpt","t":"span"}," were made of costly wild olive wood and were covered with gold. Similar carvings have been found in Mesopotamia, Syria, and Canaan; such figures were a distinguishing feature of ancient thrones. ",{"c":["Cherubim"],"sourceClass":"ital","t":"span"}," were composite creatures signifying the union of royalty (lion) with the highest powers of strength (bull), speed (eagle), and sagacity (human). Ancient temples found in Phoenicia show the throne of the deity supported by two animals. The sides of ancient Canaanite thrones were commonly shaped as cherubs. The cherubs of Solomon’s Temple were distinct because they were not designed to serve as a human throne. They were attached to the Ark, which was the footstool to God’s throne, with the wings touching in the middle and extending to the walls of the throne room. There was no actual seat to the throne, since none was necessary."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.3.10-13","refs":[{"book":"2CH","endChapter":3,"endVerse":13,"startChapter":3,"startVerse":10}],"sourceAttributes":{"name":"IIChr.3.10-13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"ef655ab3ec209c9a8dcb92421aa45df22672a430d01c234e8bb4fc374b8aa6bd","sourceItemName":"IIChr.3.10-13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4913,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.3.10-13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.3.10-13","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.3.15-16","r":"2Chr.3.15-16","rawR":"2Chr.3.15-16","sourceRefs":[{"raw":"2Chr.3.15-16","value":"2Chr.3.15-16"}],"t":"ref","v":"3:15-16"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["two pillars"],"sourceClass":"sn-excerpt","t":"span"}," set in the porch of ",{"c":["the Temple"],"sourceClass":"sn-excerpt","t":"span"}," were made of bronze and were ornately decorated (cp. ",{"href":"?bref=1Kgs.7.15-22","r":"1Kgs.7.15-22","rawR":"1Kgs.7.15-22","sourceRefs":[{"raw":"1Kgs.7.15-22","value":"1Kgs.7.15-22"}],"t":"ref","v":"1 Kgs 7:15-22"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.3.15-16","refs":[{"book":"2CH","endChapter":3,"endVerse":16,"startChapter":3,"startVerse":15}],"sourceAttributes":{"name":"IIChr.3.15-16","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"f7ef30073a2f6131d966b0ca4c587bc4d873d048722cb11bbff3fa2bf706c75b","sourceItemName":"IIChr.3.15-16","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4914,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.3.15-16","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.3.15-16","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.3.17","r":"2Chr.3.17","rawR":"2Chr.3.17","sourceRefs":[{"raw":"2Chr.3.17","value":"2Chr.3.17"}],"t":"ref","v":"3:17"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Jakin"],"sourceClass":"sn-excerpt","t":"span"}," (“he establishes”) might refer to God’s promise regarding the kingdom (see ",{"href":"?bref=1Chr.17.7-14","r":"1Chr.17.7-14","rawR":"1Chr.17.7-14","sourceRefs":[{"raw":"1Chr.17.7-14","value":"1Chr.17.7-14"}],"t":"ref","v":"1 Chr 17:7-14"},"). ",{"c":["Boaz"],"sourceClass":"sn-excerpt","t":"span"}," (“in him is strength”) might have been a proclamation of trust in God. The gilded reliefs of cherubs, palms, and flowers adorning the doors and walls of the Temple suggest that the pillars were related to the tree of life (",{"href":"?bref=Gen.2.9","r":"Gen.2.9","rawR":"Gen.2.9","sourceRefs":[{"raw":"Gen.2.9","value":"Gen.2.9"}],"t":"ref","v":"Gen 2:9"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.3.17","refs":[{"book":"2CH","endChapter":3,"endVerse":17,"startChapter":3,"startVerse":17}],"sourceAttributes":{"name":"IIChr.3.17","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"871c01419b3a0413fe406833e51c10305e52c2326dad781c0c048ba6ababc8b6","sourceItemName":"IIChr.3.17","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4915,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.3.17","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.3.17","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}