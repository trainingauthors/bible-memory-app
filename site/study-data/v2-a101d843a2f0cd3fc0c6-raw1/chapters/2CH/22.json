rceClass":"ital","t":"span"}," a Levitical city in the territory of Gad (",{"href":"?bref=Josh.21.38","r":"Josh.21.38","rawR":"Josh.21.38","sourceRefs":[{"raw":"Josh.21.38","value":"Josh.21.38"}],"t":"ref","v":"Josh 21:38"},"), was located on a major trade route and was strategic for ",{"c":["Aram"],"sourceClass":"sn-excerpt","t":"span"}," and ",{"c":["Israel"],"sourceClass":"sn-excerpt","t":"span"},". • ",{"c":["Jezreel"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," at the foot of Mount Gilboa in the plain of Jezreel, became the summer home of the Israelite kings."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.22.5-6","refs":[{"book":"2CH","endChapter":22,"endVerse":6,"startChapter":22,"startVerse":5}],"sourceAttributes":{"name":"IIChr.22.5-6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[22],"sourceItemFragmentSha256":"eb2a3212afa7bf37e9d95fe3792ed35576a6fbb961af6a447860f797110ca7c5","sourceItemName":"IIChr.22.5-6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5049,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.22.5-6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.22.5-6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.22.7-9","r":"2Chr.22.7-9","rawR":"2Chr.22.7-9","sourceRefs":[{"raw":"2Chr.22.7-9","value":"2Chr.22.7-9"}],"t":"ref","v":"22:7-9"}],"sourceClass":"sn-ref","t":"span"}," The death of ",{"c":["Ahaziah"],"sourceClass":"sn-excerpt","t":"span"}," was a punishment for his alliance with the king of Israel. The Judahite king who lived by the counsel of the Israelite house of Omri shared their fate and found no refuge there at the time of his death. Ahaziah’s infidelity brought David’s line almost to the same point as Saul’s line, with no one left to assume the throne."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.22.7-9","refs":[{"book":"2CH","endChapter":22,"endVerse":9,"startChapter":22,"startVerse":7}],"sourceAttributes":{"name":"IIChr.22.7-9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[22],"sourceItemFragmentSha256":"e9f06bd4aba540788751294e0e731106b496d6c040857a16fc5f142608fdbb95","sourceItemName":"IIChr.22.7-9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5050,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.22.7-9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.22.7-9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.22.10-12","r":"2Chr.22.10-12","rawR":"2Chr.22.10-12","sourceRefs":[{"raw":"2Chr.22.10-12","value":"2Chr.22.10-12"}],"t":"ref","v":"22:10-12"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Athaliah"],"sourceClass":"sn-excerpt","t":"span"}," was never regarded as a legitimate monarch; she was given no royal formula of age or length of reign as were other rulers. Her destruction of ",{"c":["the rest of Judah’s royal family"],"sourceClass":"sn-excerpt","t":"span"}," concentrated on potential male successors; those who were ineligible to reign, such as ",{"c":["Ahaziah’s sister"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," survived the slaughter. ",{"c":["Jehosheba"],"sourceClass":"sn-excerpt","t":"span"}," was Ahaziah’s half sister, ",{"c":["the daughter of King Jehoram"],"sourceClass":"sn-excerpt","t":"span"}," by a wife other than Athaliah. The ",{"c":["six years"],"sourceClass":"sn-excerpt","t":"span"}," of Athaliah’s reign were from 841 to 835 ",{"c":["BC"],"sourceClass":"era","t":"span"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.22.10-12","refs":[{"book":"2CH","endChapter":22,"endVerse":12,"startChapter":22,"startVerse":10}],"sourceAttributes":{"name":"IIChr.22.10-12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[22],"sourceItemFragmentSha256":"8b40a91b89d78b11fa3c324b5b1407149119997c52c71507bf3aba9c33b08c1a","sourceItemName":"IIChr.22.10-12","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5051,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.22.10-12","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.22.10-12","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}