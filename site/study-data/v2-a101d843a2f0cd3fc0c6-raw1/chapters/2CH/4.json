dy-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.4.2-5","r":"2Chr.4.2-5","rawR":"2Chr.4.2-5","sourceRefs":[{"raw":"2Chr.4.2-5","value":"2Chr.4.2-5"}],"t":"ref","v":"4:2-5"}],"sourceClass":"sn-ref","t":"span"}," The Temple, the house of God, depicted Eden, the garden of God (cp. ",{"href":"?bref=Isa.51.3","r":"Isa.51.3","rawR":"Isa.51.3","sourceRefs":[{"raw":"Isa.51.3","value":"Isa.51.3"}],"t":"ref","v":"Isa 51:3"},"). The massive ",{"c":["Sea"],"sourceClass":"sn-excerpt","t":"span"}," that rested on the backs of the ",{"c":["twelve bronze oxen"],"sourceClass":"sn-excerpt","t":"span"}," represented either cosmic pre-creation waters or the waters of life that emanated from the Garden of Eden. Divine forces subdue the waters of chaos (",{"href":"?bref=Gen.1.2","r":"Gen.1.2","rawR":"Gen.1.2","sourceRefs":[{"raw":"Gen.1.2","value":"Gen.1.2"}],"t":"ref","v":"Gen 1:2"},") so that they provide life-giving nourishment for plant, animal, and human life (see ",{"href":"?bref=Rev.21.1","r":"Rev.21.1","rawR":"Rev.21.1","sourceRefs":[{"raw":"Rev.21.1","value":"Rev.21.1"}],"t":"ref","v":"Rev 21:1"},", where the sea is removed forever)."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.4.2-5","refs":[{"book":"2CH","endChapter":4,"endVerse":5,"startChapter":4,"startVerse":2}],"sourceAttributes":{"name":"IIChr.4.2-5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[4],"sourceItemFragmentSha256":"062e508c6e01e8a183530f3710e01371ff94f50c6efb737d1e64d745886d7f17","sourceItemName":"IIChr.4.2-5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4916,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.4.2-5","sourceRelease":"1.25","sourceTitleExact":null,"supplem