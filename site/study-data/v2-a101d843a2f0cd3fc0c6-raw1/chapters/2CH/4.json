sourceRefs":[{"raw":"Job.9.9","value":"Job.9.9"}],"t":"ref","v":"Job 9:9"},"; ",{"href":"?bref=Job.38.31","r":"Job.38.31","rawR":"Job.38.31","sourceRefs":[{"raw":"Job.38.31","value":"Job.38.31"}],"t":"ref","v":"38:31"},"; ",{"href":"?bref=Amos.5.8","r":"Amos.5.8","rawR":"Amos.5.8","sourceRefs":[{"raw":"Amos.5.8","value":"Amos.5.8"}],"t":"ref","v":"Amos 5:8"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.4.7","refs":[{"book":"2CH","endChapter":4,"endVerse":7,"startChapter":4,"startVerse":7}],"sourceAttributes":{"name":"IIChr.4.7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[4],"sourceItemFragmentSha256":"69c06ff3db7694732d753f4431e1aa73815cfa2e88ffe21b25b856f6f37879aa","sourceItemName":"IIChr.4.7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4918,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.4.7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.4.7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.4.11-18","r":"2Chr.4.11-18","rawR":"2Chr.4.11-18","sourceRefs":[{"raw":"2Chr.4.11-18","value":"2Chr.4.11-18"}],"t":"ref","v":"4:11b-18"}],"sourceClass":"sn-ref","t":"span"}," Cp. ",{"href":"?bref=1Kgs.7.40-47","r":"1Kgs.7.40-47","rawR":"1Kgs.7.40-47","sourceRefs":[{"raw":"1Kgs.7.40-47","value":"1Kgs.7.40-47"}],"t":"ref","v":"1 Kgs 7:40b-47"},", which the Chronicler follows almost verbatim."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.4.11-18","refs":[{"book":"2CH","endChapter":4,"endVerse":18,"startChapter":4,"startVerse":11}],"sourceAttributes":{"name":"IIChr.4.11-18","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[4],"sourceItemFragmentSha256":"176b12fb1988a245a2ce0ba6ed4cf222b55215b21c521d26620b263315bc4365","sourceItemName":"IIChr.4.11-18","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4919,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.4.11-18","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.4.11-18","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Chr.4.19","r":"2Chr.4.19","rawR":"2Chr.4.19","sourceRefs":[{"raw":"2Chr.4.19","value":"2Chr.4.19"}],"t":"ref","v":"4:19"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["Bread of the Presence"],"sourceClass":"sn-excerpt","t":"span"}," symbolized God’s provision for his people. It was placed before ",{"c":["God"],"sourceClass":"sn-excerpt","t":"span"}," on ",{"c":["the tables"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=2Chr.4.8","r":"2Chr.4.8","rawR":"2Chr.4.8","sourceRefs":[{"raw":"2Chr.4.8","value":"2Chr.4.8"}],"t":"ref","v":"4:8"},") as a type of offering, demonstrating that it belonged to God and that Israel’s provision came from God’s “table.” Some of the bread was eaten by the priests (",{"href":"?bref=Lev.24.5-9","r":"Lev.24.5-9","rawR":"Lev.24.5-9","sourceRefs":[{"raw":"Lev.24.5-9","value":"Lev.24.5-9"}],"t":"ref","v":"Lev 24:5-9"},"), and the rest was burned; this meal symbolized the covenant meal of fellowship between God and his people (see ",{"href":"?bref=Exod.24.9-11","r":"Exod.24.9-11","rawR":"Exod.24.9-11","sourceRefs":[{"raw":"Exod.24.9-11","value":"Exod.24.9-11"}],"t":"ref","v":"Exod 24:9-11"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIChr.4.19","refs":[{"book":"2CH","endChapter":4,"endVerse":19,"startChapter":4,"startVerse":19}],"sourceAttributes":{"name":"IIChr.4.19","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CH","sourceChapterCoverage":[4],"sourceItemFragmentSha256":"07e46d84fd3fff53113839cb9e6f9e772ecc1a7f823a9814fdba92a7f4877dfc","sourceItemName":"IIChr.4.19","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":4920,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CH","canonicalOSIS":"2Chr","method":"official_book_intro_ref_title","sourceOSIS":"2Chr"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Chr.4.19","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIChr.4.19","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}