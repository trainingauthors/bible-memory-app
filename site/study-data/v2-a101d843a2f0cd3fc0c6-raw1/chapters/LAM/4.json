ent":[{"c":[{"c":[{"href":"?bref=Lam.4.8","r":"Lam.4.8","rawR":"Lam.4.8","sourceRefs":[{"raw":"Lam.4.8","value":"Lam.4.8"}],"t":"ref","v":"4:8"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Skin"],"sourceClass":"sn-excerpt","t":"span"}," sticking to ",{"c":["bones"],"sourceClass":"sn-excerpt","t":"span"}," is symptomatic of the final stages of starvation, just before death."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lam.4.8","refs":[{"book":"LAM","endChapter":4,"endVerse":8,"startChapter":4,"startVerse":8}],"sourceAttributes":{"name":"Lam.4.8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LAM","sourceChapterCoverage":[4],"sourceItemFragmentSha256":"22aac940a1c398e40bddb9adbbcda9243f5518f2e886869323448909684a128f","sourceItemName":"Lam.4.8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10095,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LAM","canonicalOSIS":"Lam","method":"official_book_intro_ref_title","sourceOSIS":"Lam"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lam.4.8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lam.4.8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lam.4.9","r":"Lam.4.9","rawR":"Lam.4.9","sourceRefs":[{"raw":"Lam.4.9","value":"Lam.4.9"}],"t":"ref","v":"4:9"}],"sourceClass":"sn-ref","t":"span"}," Long sieges result in a serious ",{"c":["lack of food"],"sourceClass":"sn-excerpt","t":"span"},". Even if people could get to the fields, they would find the crops destroyed or harvested to feed the soldiers."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lam.4.9","refs":[{"book":"LAM","endChapter":4,"endVerse":9,"startChapter":4,"startVerse":9}],"sourceAttributes":{"name":"Lam.4.9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LAM","sourceChapterCoverage":[4],"sourceItemFragmentSha256":"1fba6d004148737a5952d520583535fcba3f7394850a026e8b808414ec450e5d","sourceItemName":"Lam.4.9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10096,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LAM","canonicalOSIS":"Lam","method":"official_book_intro_ref_title","sourceOSIS":"Lam"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lam.4.9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lam.4.9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lam.4.12","r":"Lam.4.12","rawR":"Lam.4.12","sourceRefs":[{"raw":"Lam.4.12","value":"Lam.4.12"}],"t":"ref","v":"4:12"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Not a king . . . could march through the gates of Jerusalem:"],"sourceClass":"sn-excerpt","t":"span"}," Since God had delivered Jerusalem from Sennacherib of Assyria more than a century earlier (",{"href":"?bref=2Kgs.19.36-37","r":"2Kgs.19.36-37","rawR":"2Kgs.19.36-37","sourceRefs":[{"raw":"2Kgs.19.36-37","value":"2Kgs.19.36-37"}],"t":"ref","v":"2 Kgs 19:36-37"},"), Judeans had strongly believed that not even the mightiest king, Nebuchadnezzar of Babylon, could defeat the city."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lam.4.12","refs":[{"book":"LAM","endChapter":4,"endVerse":12,"startChapter":4,"startVerse":12}],"sourceAttributes":{"name":"Lam.4.12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LAM","sourceChapterCoverage":[4],"sourceItemFragmentSha256":"bfa6b38332ffff9f0b01104422ad48b3dcc543e6655c108298bbcffacfeb56a4","sourceItemName":"Lam.4.12","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10097,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LAM","canonicalOSIS":"Lam","method":"official_book_intro_ref_title","sourceOSIS":"Lam"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lam.4.12","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lam.4.12","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lam.4.15","r":"Lam.4.15","rawR":"Lam.4.15","sourceRefs":[{"raw":"Lam.4.15","value":"Lam.4.15"}],"t":"ref","v":"4:15"}],"sourceClass":"sn-ref","t":"span"}," It appears that these leaders ",{"c":["fled"],"sourceClass":"sn-excerpt","t":"span"}," from Jerusalem as refugees to other ",{"c":["lands"],"sourceClass":"sn-excerpt","t":"span"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lam.4.15","refs":[{"book":"LAM","endChapter":4,"endVerse":15,"startChapter":4,"startVerse":15}],"sourceAttributes":{"name":"Lam.4.15","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LAM","sourceChapterCoverage":[4],"sourceItemFragmentSha256":"11c4861108c5626e55ed7bc5252cc43efdaaf0ef2bfd0d464bc9fbac85c6b29d","sourceItemName":"Lam.4.15","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10098,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LAM","canonicalOSIS":"Lam","method":"official_book_intro_ref_title","sourceOSIS":"Lam"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lam.4.15","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lam.4.15","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lam.4.20","r":"Lam.4.20","rawR":"Lam.4.20","sourceRefs":[{"raw":"Lam.4.20","value":"Lam.4.20"}],"t":"ref","v":"4:20"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Our king . . . was caught:"],"sourceClass":"sn-excerpt","t":"span"}," A reference to Zedekiah, who tried to flee but was caught and treated cruelly by Nebuchadnezzar (",{"href":"?bref=2Kgs.25.4-7","r":"2Kgs.25.4-7","rawR":"2Kgs.25.4-7","sourceRefs":[{"raw":"2Kgs.25.4-7","value":"2Kgs.25.4-7"}],"t":"ref","v":"2 Kgs 25:4-7"},"; ",{"href":"?bref=Jer.39.4-7","r":"Jer.39.4-7","rawR":"Jer.39.4-7","sourceRefs":[{"raw":"Jer.39.4-7","value":"Jer.39.4-7"}],"t":"ref","v":"Jer 39:4-7"},"; ",{"href":"?bref=Jer.52.9-11","r":"Jer.52.9-11","rawR":"Jer.52.9-11","sourceRefs":[{"raw":"Jer.52.9-11","value":"Jer.52.9-11"}],"t":"ref","v":"52:9-11"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lam.4.20","refs":[{"book":"LAM","endChapter":4,"endVerse":20,"startChapter":4,"startVerse":20}],"sourceAttributes":{"name":"Lam.4.20","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LAM","sourceChapterCoverage":[4],"sourceItemFragmentSha256":"e12361e1b950bf90169bd4bc6904e6aca136ce86df2cfc090022549ad9e3d8da","sourceItemName":"Lam.4.20","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10099,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LAM","canonicalOSIS":"Lam","method":"official_book_intro_ref_title","sourceOSIS":"Lam"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lam.4.20","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lam.4.20","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lam.4.21-22","r":"Lam.4.21-22","rawR":"Lam.4.21-22","sourceRefs":[{"raw":"Lam.4.21-22","value":"Lam.4.21-22"}],"t":"ref","v":"4:21-22"}],"sourceClass":"sn-ref","t":"span"}," The people of ",{"c":["Edom"],"sourceClass":"sn-excerpt","t":"span"}," were feeling secure and gloating over Jerusalem’s misfortune, but they, too, would experience ",{"c":["punishment"],"sourceClass":"sn-excerpt","t":"span"}," for their ",{"c":["sins"],"sourceClass":"sn-excerpt","t":"span"}," (see ",{"href":"?bref=Obad.1.1-21","r":"Obad.1.1-21","rawR":"Obad.1.1-21","sourceRefs":[{"raw":"Obad.1.1-21","value":"Obad.1.1-21"}],"t":"ref","v":"Obad 1"},"; ",{"href":"?bref=Jer.49.7-22","r":"Jer.49.7-22","rawR":"Jer.49.7-22","sourceRefs":[{"raw":"Jer.49.7-22","value":"Jer.49.7-22"}],"t":"ref","v":"Jer 49:7-22"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lam.4.21-22","refs":[{"book":"LAM","endChapter":4,"endVerse":22,"startChapter":4,"startVerse":21}],"sourceAttributes":{"name":"Lam.4.21-22","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LAM","sourceChapterCoverage":[4],"sourceItemFragmentSha256":"668ae65ebbf2a0146b7e137690b87599b35049ae6d66714ae561b0d7a3896135","sourceItemName":"Lam.4.21-22","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10100,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LAM","canonicalOSIS":"Lam","method":"official_book_intro_ref_title","sourceOSIS":"Lam"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lam.4.21-22","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lam.4.21-22","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lam.4.21","r":"Lam.4.21","rawR":"Lam.4.21","sourceRefs":[{"raw":"Lam.4.21","value":"Lam.4.21"}],"t":"ref","v":"4:21"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Uz"],"sourceClass":"sn-excerpt","t":"span"}," was an area east of the Jordan River that extended south to Edom. It was Job’s home (",{"href":"?bref=Job.1.1","r":"Job.1.1","rawR":"Job.1.1","sourceRefs":[{"raw":"Job.1.1","value":"Job.1.1"}],"t":"ref","v":"Job 1:1"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lam.4.21","refs":[{"book":"LAM","endChapter":4,"endVerse":21,"startChapter":4,"startVerse":21}],"sourceAttributes":{"name":"Lam.4.21","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LAM","sourceChapterCoverage":[4],"sourceItemFragmentSha256":"21bf671a5ae4b981c9068a58ede264fb4cd812aed45b5ee70903bf0b70183c27","sourceItemName":"Lam.4.21","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10101,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LAM","canonicalOSIS":"Lam","method":"official_book_intro_ref_title","sourceOSIS":"Lam"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lam.4.21","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lam.4.21","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lam.4.22","r":"Lam.4.22","rawR":"Lam.4.22","sourceRefs":[{"raw":"Lam.4.22","value":"Lam.4.22"}],"t":"ref","v":"4:22"}],"sourceClass":"sn-ref","t":"span"}," The first ",{"c":["return from exile"],"sourceClass":"sn-excerpt","t":"span"}," occurred in 538 ",{"c":["BC"],"sourceClass":"era","t":"span"},", after Cyrus of Persia defeated Babylon (",{"href":"?bref=2Chr.36.22-23","r":"2Chr.36.22-23","rawR":"2Chr.36.22-23","sourceRefs":[{"raw":"2Chr.36.22-23","value":"2Chr.36.22-23"}],"t":"ref","v":"2 Chr 36:22-23"},"; ",{"href":"?bref=Ezra.1.1-4","r":"Ezra.1.1-4","rawR":"Ezra.1.1-4","sourceRefs":[{"raw":"Ezra.1.1-4","value":"Ezra.1.1-4"}],"t":"ref","v":"Ezra 1:1-4"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lam.4.22","refs":[{"book":"LAM","endChapter":4,"endVerse":22,"startChapter":4,"startVerse":22}],"sourceAttributes":{"name":"Lam.4.22","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LAM","sourceChapterCoverage":[4],"sourceItemFragmentSha256":"b281f022f5252b9a7b74e8ca5cc85976dff5005c0d80e8426c17a56eae813519","sourceItemName":"Lam.4.22","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":10102,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LAM","canonicalOSIS":"Lam","method":"official_book_intro_ref_title","sourceOSIS":"Lam"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lam.4.22","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lam.4.22","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}