":"Rom.16.23","sourceRefs":[{"raw":"Rom.16.23","value":"Rom.16.23"}],"t":"ref","v":"Rom 16:23"},"; ",{"href":"?bref=1Cor.1.14","r":"1Cor.1.14","rawR":"1Cor.1.14","sourceRefs":[{"raw":"1Cor.1.14","value":"1Cor.1.14"}],"t":"ref","v":"1 Cor 1:14"},"); it was a popular name in the Greco-Roman world."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIIJn.1.1","refs":[{"book":"3JN","endChapter":1,"endVerse":1,"startChapter":1,"startVerse":1}],"sourceAttributes":{"name":"IIIJn.1.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"3JN","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"afa5fbeddffa838c2125d1a64d43416b1cfed2e0522bdf4eafabca1a6c576245","sourceItemName":"IIIJn.1.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16526,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"3JN","canonicalOSIS":"3John","method":"official_book_intro_ref_title","sourceOSIS":"3Jn"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"3Jn.1.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIIJn.1.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=3Jn.1.3","r":"3Jn.1.3","rawR":"3Jn.1.3","sourceRefs":[{"raw":"3Jn.1.3","value":"3Jn.1.3"}],"t":"ref","v":"1:3"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["traveling teachers"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["brothers"],"sourceClass":"ital","t":"span"},") were probably John’s emissaries who traveled from church to church, teaching the Good News and encouraging Christians (see ",{"href":"?bref=3Jn.1.5","r":"3Jn.1.5","rawR":"3Jn.1.5","sourceRefs":[{"raw":"3Jn.1.5","value":"3Jn.1.5"}],"t":"ref","v":"1:5"},", ",{"href":"?bref=3Jn.1.10","r":"3Jn.1.10","rawR":"3Jn.1.10","sourceRefs":[{"raw":"3Jn.1.10","value":"3Jn.1.10"}],"t":"ref","v":"10"},"). • ",{"c":["you are living according to the truth:"],"sourceClass":"sn-excerpt","t":"span"}," Gaius was faithful to the apostolic gospel of Jesus Christ. The false teachers denied the reality of the incarnation or the sacrificial death of Jesus Christ (cp. ",{"href":"?bref=1Jn.4.1-3","r":"1Jn.4.1-3","rawR":"1Jn.4.1-3","sourceRefs":[{"raw":"1Jn.4.1-3","value":"1Jn.4.1-3"}],"t":"ref","v":"1 Jn 4:1-3"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIIJn.1.3","refs":[{"book":"3JN","endChapter":1,"endVerse":3,"startChapter":1,"startVerse":3}],"sourceAttributes":{"name":"IIIJn.1.3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"3JN","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"baad72a5387b9b0306ecbb518be4aedd99791a57ca244cc2c3658dc5b8deaa7e","sourceItemName":"IIIJn.1.3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16527,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"3JN","canonicalOSIS":"3John","method":"official_book_intro_ref_title","sourceOSIS":"3Jn"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"3Jn.1.3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIIJn.1.3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=3Jn.1.4","r":"3Jn.1.4","rawR":"3Jn.1.4","sourceRefs":[{"raw":"3Jn.1.4","value":"3Jn.1.4"}],"t":"ref","v":"1:4"}],"sourceClass":"sn-ref","t":"span"}," As in 2 John (see ",{"href":"?bref=2Jn.1.1-4","r":"2Jn.1.1-4","rawR":"2Jn.1.1-4","sourceRefs":[{"raw":"2Jn.1.1-4","value":"2Jn.1.1-4"}],"t":"ref","v":"2 Jn 1:1-4"},"), John’s emphasis is on knowing and ",{"c":["following the truth"],"sourceClass":"sn-excerpt","t":"span"}," in contrast to Diotrephes and his followers (",{"href":"?bref=3Jn.1.9","r":"3Jn.1.9","rawR":"3Jn.1.9","sourceRefs":[{"raw":"3Jn.1.9","value":"3Jn.1.9"}],"t":"ref","v":"3 Jn 1:9"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIIJn.1.4","refs":[{"book":"3JN","endChapter":1,"endVerse":4,"startChapter":1,"startVerse":4}],"sourceAttributes":{"name":"IIIJn.1.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"3JN","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"59bcc7e0bdf805844523adb45ffbfa7d40ddc373b68b2afb7e0673ec2e6f408a","sourceItemName":"IIIJn.1.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16528,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"3JN","canonicalOSIS":"3John","method":"official_book_intro_ref_title","sourceOSIS":"3Jn"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"3Jn.1.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIIJn.1.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=3Jn.1.5-8","r":"3Jn.1.5-8","rawR":"3Jn.1.5-8","sourceRefs":[{"raw":"3Jn.1.5-8","value":"3Jn.1.5-8"}],"t":"ref","v":"1:5-8"}],"sourceClass":"sn-ref","t":"span"}," John now encourages Gaius to continue supporting the traveling teachers whom John had sent out (",{"href":"?bref=3Jn.1.3","r":"3Jn.1.3","rawR":"3Jn.1.3","sourceRefs":[{"raw":"3Jn.1.3","value":"3Jn.1.3"}],"t":"ref","v":"1:3"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIIJn.1.5-8","refs":[{"book":"3JN","endChapter":1,"endVerse":8,"startChapter":1,"startVerse":5}],"sourceAttributes":{"name":"IIIJn.1.5-8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"3JN","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"9670638c15e399a9954c3af0217afe7fe448fd407a10d94d599bb8da88d93f50","sourceItemName":"IIIJn.1.5-8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16529,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"3JN","canonicalOSIS":"3John","method":"official_book_intro_ref_title","sourceOSIS":"3Jn"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"3Jn.1.5-8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIIJn.1.5-8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=3Jn.1.5","r":"3Jn.1.5","rawR":"3Jn.1.5","sourceRefs":[{"raw":"3Jn.1.5","value":"3Jn.1.5"}],"t":"ref","v":"1:5"}],"sourceClass":"sn-ref","t":"span"}," Gaius provided hospitality for ",{"c":["the traveling teachers"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["the brothers"],"sourceClass":"ital","t":"span"},") sent by John from church to church to affirm the apostles’ teaching about Christ (",{"href":"?bref=3Jn.1.7-8","r":"3Jn.1.7-8","rawR":"3Jn.1.7-8","sourceRefs":[{"raw":"3Jn.1.7-8","value":"3Jn.1.7-8"}],"t":"ref","v":"1:7-8"},"). By doing this, Gaius showed that he had received the truth from the apostles and that he was thus ",{"c":["faithful to God"],"sourceClass":"sn-excerpt","t":"span"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIIJn.1.5","refs":[{"book":"3JN","endChapter":1,"endVerse":5,"startChapter":1,"startVerse":5}],"sourceAttributes":{"name":"IIIJn.1.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"3JN","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"259a4686f11dde7692bd49942aa86b825b93053c7f874a31780dc01e56d694a4","sourceItemName":"IIIJn.1.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16530,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"3JN","canonicalOSIS":"3John","method":"official_book_intro_ref_title","sourceOSIS":"3Jn"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"3Jn.1.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIIJn.1.5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=3Jn.1.6","r":"3Jn.1.6","rawR":"3Jn.1.6","sourceRefs":[{"raw":"3Jn.1.6","value":"3Jn.1.6"}],"t":"ref","v":"1:6"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["The church here"],"sourceClass":"sn-excerpt","t":"span"}," was most likely in Ephesus, where John was probably staying. Ephesus was an important port city in the province of Asia, and the fourth-largest city in the Roman Empire. It became an important city for the Christian community (",{"href":"?bref=Acts.18.19-19.41","r":"Acts.18.19-19.41","rawR":"Acts.18.19-19.41","sourceRefs":[{"raw":"Acts.18.19-19.41","value":"Acts.18.19-19.41"}],"t":"ref","v":"Acts 18:19–19:41"},"; ",{"href":"?bref=1Tim.1.3","r":"1Tim.1.3","rawR":"1Tim.1.3","sourceRefs":[{"raw":"1Tim.1.3","value":"1Tim.1.3"}],"t":"ref","v":"1 Tim 1:3"},"; ",{"href":"?bref=1Pet.1.1","r":"1Pet.1.1","rawR":"1Pet.1.1","sourceRefs":[{"raw":"1Pet.1.1","value":"1Pet.1.1"}],"t":"ref","v":"1 Pet 1:1"},"; ",{"href":"?bref=Rev.2.1-7","r":"Rev.2.1-7","rawR":"Rev.2.1-7","sourceRefs":[{"raw":"Rev.2.1-7","value":"Rev.2.1-7"}],"t":"ref","v":"Rev 2:1-7"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIIJn.1.6","refs":[{"book":"3JN","endChapter":1,"endVerse":6,"startChapter":1,"startVerse":6}],"sourceAttributes":{"name":"IIIJn.1.6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"3JN","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"2a7372f747a382acd6e09de0c944e1dc4e3ba605ab3a251161479056ef103f5c","sourceItemName":"IIIJn.1.6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16531,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"3JN","canonicalOSIS":"3John","method":"official_book_intro_ref_title","sourceOSIS":"3Jn"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"3Jn.1.6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIIJn.1.6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=3Jn.1.7-8","r":"3Jn.1.7-8","rawR":"3Jn.1.7-8","sourceRefs":[{"raw":"3Jn.1.7-8","value":"3Jn.1.7-8"}],"t":"ref","v":"1:7-8"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["for the Lord"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["on behalf of the Name"],"sourceClass":"ital","t":"span"},"): John did not need to identify whose name this was because all the early Christians knew that ",{"c":["the Name"],"sourceClass":"ital","t":"span"}," represented Jesus Christ (see ",{"href":"?bref=Acts.5.41","r":"Acts.5.41","rawR":"Acts.5.41","sourceRefs":[{"raw":"Acts.5.41","value":"Acts.5.41"}],"t":"ref","v":"Acts 5:41"},"). • The traveling teachers had chosen to ",{"c":["accept nothing"],"sourceClass":"sn-excerpt","t":"span"}," offered to them ",{"c":["from people who are not believers"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," but to rely fully on the churches for their support. Christians who support legitimate traveling teachers become ",{"c":["their partners as they teach the truth"],"sourceClass":"sn-excerpt","t":"span"}," (see ",{"href":"?bref=Matt.10.41-42","r":"Matt.10.41-42","rawR":"Matt.10.41-42","sourceRefs":[{"raw":"Matt.10.41-42","value":"Matt.10.41-42"}],"t":"ref","v":"Matt 10:41-42"},"; ",{"href":"?bref=Phil.4.15-19","r":"Phil.4.15-19","rawR":"Phil.4.15-19","sourceRefs":[{"raw":"Phil.4.15-19","value":"Phil.4.15-19"}],"t":"ref","v":"Phil 4:15-19"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIIJn.1.7-8","refs":[{"book":"3JN","endChapter":1,"endVerse":8,"startChapter":1,"startVerse":7}],"sourceAttributes":{"name":"IIIJn.1.7-8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"3JN","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"9146388b3205d0a7d65218a8e21a94d7871db453614ef22630fa7ee77fd10fa1","sourceItemName":"IIIJn.1.7-8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16532,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"3JN","canonicalOSIS":"3John","method":"official_book_intro_ref_title","sourceOSIS":"3Jn"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"3Jn.1.7-8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIIJn.1.7-8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=3Jn.1.9-12","r":"3Jn.1.9-12","rawR":"3Jn.1.9-12","sourceRefs":[{"raw":"3Jn.1.9-12","value":"3Jn.1.9-12"}],"t":"ref","v":"1:9-12"}],"sourceClass":"sn-ref","t":"span"}," In these verses, John condemns Diotrephes and presents Demetrius as the model of a faithful Christian who lives according to the truth. Gaius is urged to emulate Demetrius."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIIJn.1.9-12","refs":[{"book":"3JN","endChapter":1,"endVerse":12,"startChapter":1,"startVerse":9}],"sourceAttributes":{"name":"IIIJn.1.9-12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"3JN","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"6935b625aa57e1d919bd99845f6c6024ef8d092b3bba68446cb19000c99391d5","sourceItemName":"IIIJn.1.9-12","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16533,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"3JN","canonicalOSIS":"3John","method":"official_book_intro_ref_title","sourceOSIS":"3Jn"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"3Jn.1.9-12","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIIJn.1.9-12","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=3Jn.1.9","r":"3Jn.1.9","rawR":"3Jn.1.9","sourceRefs":[{"raw":"3Jn.1.9","value":"3Jn.1.9"}],"t":"ref","v":"1:9"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["I wrote to the church about this:"],"sourceClass":"sn-excerpt","t":"span"}," This could refer to 1 John or to a letter that is now lost. • ",{"c":["Diotrephes"],"sourceClass":"sn-excerpt","t":"span"}," was full of pride and self-importance (cp. ",{"href":"?bref=1Tim.3.6","r":"1Tim.3.6","rawR":"1Tim.3.6","sourceRefs":[{"raw":"1Tim.3.6","value":"1Tim.3.6"}],"t":"ref","v":"1 Tim 3:6"},"), motivated by selfish ambition. • ",{"c":["refuses to have anything to do with us:"],"sourceClass":"sn-excerpt","t":"span"}," This dissidence was one of the key issues John dealt with in 1 John (see, e.g., ",{"href":"?bref=1Jn.2.19","r":"1Jn.2.19","rawR":"1Jn.2.19","sourceRefs":[{"raw":"1Jn.2.19","value":"1Jn.2.19"}],"t":"ref","v":"1 Jn 2:19"},"; ",{"href":"?bref=1Jn.4.5-6","r":"1Jn.4.5-6","rawR":"1Jn.4.5-6","sourceRefs":[{"raw":"1Jn.4.5-6","value":"1Jn.4.5-6"}],"t":"ref","v":"4:5-6"},"). Diotrephes rejected the teachers sent by John and excommunicated any members of the church who did accept them. He wanted to rule the local church without answering to any outside authority."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIIJn.1.9","refs":[{"book":"3JN","endChapter":1,"endVerse":9,"startChapter":1,"startVerse":9}],"sourceAttributes":{"name":"IIIJn.1.9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"3JN","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"acff40e504d8a76784db897e383a7f1b272be7cd6a1c99e69f1adc4e23389251","sourceItemName":"IIIJn.1.9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16534,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"3JN","canonicalOSIS":"3John","method":"official_book_intro_ref_title","sourceOSIS":"3Jn"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"3Jn.1.9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIIJn.1.9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=3Jn.1.11","r":"3Jn.1.11","rawR":"3Jn.1.11","sourceRefs":[{"raw":"3Jn.1.11","value":"3Jn.1.11"}],"t":"ref","v":"1:11"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["those who do evil:"],"sourceClass":"sn-excerpt","t":"span"}," Diotrephes was condemned for his failure to live by the Christian rule of love (",{"href":"?bref=1Jn.3.10-14","r":"1Jn.3.10-14","rawR":"1Jn.3.10-14","sourceRefs":[{"raw":"1Jn.3.10-14","value":"1Jn.3.10-14"}],"t":"ref","v":"1 Jn 3:10-14"},"). This was how Gaius could be sure that Diotrephes was not living according to the truth. This applies to all who refuse to accept the apostolic teaching about Jesus Christ and refuse to live in fellowship with others who do."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIIJn.1.11","refs":[{"book":"3JN","endChapter":1,"endVerse":11,"startChapter":1,"startVerse":11}],"sourceAttributes":{"name":"IIIJn.1.11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"3JN","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"495e89ea01c616feae777df39d08cdfe88fa2388d1f3303ced816e03ca2a4a4c","sourceItemName":"IIIJn.1.11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16535,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"3JN","canonicalOSIS":"3John","method":"official_book_intro_ref_title","sourceOSIS":"3Jn"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"3Jn.1.11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIIJn.1.11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=3Jn.1.12","r":"3Jn.1.12","rawR":"3Jn.1.12","sourceRefs":[{"raw":"3Jn.1.12","value":"3Jn.1.12"}],"t":"ref","v":"1:12"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Demetrius"],"sourceClass":"sn-excerpt","t":"span"}," was the very opposite of Diotrephes, a prime example of one who knows the truth and practices it (",{"href":"?bref=3Jn.1.3","r":"3Jn.1.3","rawR":"3Jn.1.3","sourceRefs":[{"raw":"3Jn.1.3","value":"3Jn.1.3"}],"t":"ref","v":"1:3"},"). The placement of Demetrius’s name at the end of the letter suggests that he was the one who carried John’s letter to Gaius (cp. ",{"href":"?bref=Col.4.7-9","r":"Col.4.7-9","rawR":"Col.4.7-9","sourceRefs":[{"raw":"Col.4.7-9","value":"Col.4.7-9"}],"t":"ref","v":"Col 4:7-9"},"; ",{"href":"?bref=1Pet.5.12","r":"1Pet.5.12","rawR":"1Pet.5.12","sourceRefs":[{"raw":"1Pet.5.12","value":"1Pet.5.12"}],"t":"ref","v":"1 Pet 5:12"},"). • ",{"c":["you know we speak the truth:"],"sourceClass":"sn-excerpt","t":"span"}," John wished to protect his honor as a reliable elder over these churches rather than being shamed by any possible usurpation by Diotrephes and other false teachers."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIIJn.1.12","refs":[{"book":"3JN","endChapter":1,"endVerse":12,"startChapter":1,"startVerse":12}],"sourceAttributes":{"name":"IIIJn.1.12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"3JN","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"4c09afbc1157a71b0f3694cfad0ba3f046274c003974a26cee27175ce7b1c512","sourceItemName":"IIIJn.1.12","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16536,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"3JN","canonicalOSIS":"3John","method":"official_book_intro_ref_title","sourceOSIS":"3Jn"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"3Jn.1.12","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIIJn.1.12","type":"StudyNote"},{"chapterAssociationStatus":"source_chapters_only_unavailable_verse_mapping","content":[{"c":[{"c":[{"href":"?bref=3Jn.1.13-15","r":"3Jn.1.13-15","rawR":"3Jn.1.13-15","sourceRefs":[{"raw":"3Jn.1.13-15","value":"3Jn.1.13-15"}],"t":"ref","v":"1:13-15"}],"sourceClass":"sn-ref","t":"span"}," As in 2 John, the conclusion of 3 John shows John’s desire to make a personal visit and see to the instructions of this letter."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIIJn.1.13-15","refs":[],"sourceAttributes":{"name":"IIIJn.1.13-15","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"3JN","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"ee5a525a9ef17f3ef8d1bda88fdf3f777ef5b50f9c290d7301ca9b8b0e2beb5c","sourceItemName":"IIIJn.1.13-15","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16537,"sourceReferenceException":true,"sourceReferenceMappingEvidence":{"appCode":"3JN","canonicalOSIS":"3John","method":"official_book_intro_ref_title","sourceOSIS":"3Jn"},"sourceReferenceStatus":"verse_out_of_bounds","sourceRefsExact":"3Jn.1.13-15","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIIJn.1.13-15","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=3Jn.1.13","r":"3Jn.1.13","rawR":"3Jn.1.13","sourceRefs":[{"raw":"3Jn.1.13","value":"3Jn.1.13"}],"t":"ref","v":"1:13"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["pen and ink"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["ink and reed"],"sourceClass":"ital","t":"span"},"): In antiquity, writing was typically done with a stylus shaped from a reed and black carbon ink (see also ",{"href":"?bref=2Jn.1.12","r":"2Jn.1.12","rawR":"2Jn.1.12","sourceRefs":[{"raw":"2Jn.1.12","value":"2Jn.1.12"}],"t":"ref","v":"2 Jn 1:12"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIIJn.1.13","refs":[{"book":"3JN","endChapter":1,"endVerse":13,"startChapter":1,"startVerse":13}],"sourceAttributes":{"name":"IIIJn.1.13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"3JN","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"0b0661bb266396329812028695314d790232ac8568405451d59d42dbc634a4e8","sourceItemName":"IIIJn.1.13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16538,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"3JN","canonicalOSIS":"3John","method":"official_book_intro_ref_title","sourceOSIS":"3Jn"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"3Jn.1.13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIIJn.1.13","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=3Jn.1.14","r":"3Jn.1.14","rawR":"3Jn.1.14","sourceRefs":[{"raw":"3Jn.1.14","value":"3Jn.1.14"}],"t":"ref","v":"1:14"}],"sourceClass":"sn-ref","t":"span"}," Our English idiom ",{"c":["face to face"],"sourceClass":"sn-excerpt","t":"span"}," parallels the Greek idiom used here (literally ",{"c":["mouth to mouth;"],"sourceClass":"ital","t":"span"}," see also ",{"href":"?bref=2Jn.1.12","r":"2Jn.1.12","rawR":"2Jn.1.12","sourceRefs":[{"raw":"2Jn.1.12","value":"2Jn.1.12"}],"t":"ref","v":"2 Jn 1:12"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIIJn.1.14","refs":[{"book":"3JN","endChapter":1,"endVerse":14,"startChapter":1,"startVerse":14}],"sourceAttributes":{"name":"IIIJn.1.14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"3JN","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"015ce0a4a74d5d1108a948f8bf62bae73f72706bf1bcc133527fca925363a2c6","sourceItemName":"IIIJn.1.14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16539,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"3JN","canonicalOSIS":"3John","method":"official_book_intro_ref_title","sourceOSIS":"3Jn"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"3Jn.1.14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIIJn.1.14","type":"StudyNote"},{"chapterAssociationStatus":"source_chapters_only_unavailable_verse_mapping","content":[{"c":[{"c":[{"href":"?bref=3Jn.1.15","r":"3Jn.1.15","rawR":"3Jn.1.15","sourceRefs":[{"raw":"3Jn.1.15","value":"3Jn.1.15"}],"t":"ref","v":"1:15"}],"sourceClass":"sn-ref","t":"span"}," John closes his letter with his farewell and with greetings to others. • ",{"c":["Peace be with you:"],"sourceClass":"sn-excerpt","t":"span"}," This was a traditional greeting among the Jews (",{"href":"?bref=Matt.10.12","r":"Matt.10.12","rawR":"Matt.10.12","sourceRefs":[{"raw":"Matt.10.12","value":"Matt.10.12"}],"t":"ref","v":"Matt 10:12"},"; ",{"href":"?bref=Luke.10.5-6","r":"Luke.10.5-6","rawR":"Luke.10.5-6","sourceRefs":[{"raw":"Luke.10.5-6","value":"Luke.10.5-6"}],"t":"ref","v":"Luke 10:5-6"},"), which had taken on heightened significance for Christians because Jesus used it after his resurrection (",{"href":"?bref=John.20.19-21","r":"John.20.19-21","rawR":"John.20.19-21","sourceRefs":[{"raw":"John.20.19-21","value":"John.20.19-21"}],"t":"ref","v":"John 20:19-21"},", ",{"href":"?bref=John.20.26","r":"John.20.26","rawR":"John.20.26","sourceRefs":[{"raw":"John.20.26","value":"John.20.26"}],"t":"ref","v":"26"},"). • ",{"c":["give my personal greetings"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["greet by name"],"sourceClass":"ital","t":"span"},"): Gaius was to greet the ",{"c":["friends"],"sourceClass":"sn-excerpt","t":"span"},"—that is, those who accept the apostolic gospel and live according to the truth (cp. ",{"href":"?bref=3Jn.1.3-4","r":"3Jn.1.3-4","rawR":"3Jn.1.3-4","sourceRefs":[{"raw":"3Jn.1.3-4","value":"3Jn.1.3-4"}],"t":"ref","v":"3 Jn 1:3-4"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IIIJn.1.15","refs":[],"sourceAttributes":{"name":"IIIJn.1.15","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"3JN","sourceChapterCoverage":[1],"sourceItemFragmentSha256":"06bbc99db35d8bd34ca4f2f60a83942bcc48f7206a99a93d3e575ff796463ecb","sourceItemName":"IIIJn.1.15","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":16540,"sourceReferenceException":true,"sourceReferenceMappingEvidence":{"appCode":"3JN","canonicalOSIS":"3John","method":"official_book_intro_ref_title","sourceOSIS":"3Jn"},"sourceReferenceStatus":"verse_out_of_bounds","sourceRefsExact":"3Jn.1.15","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IIIJn.1.15","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}