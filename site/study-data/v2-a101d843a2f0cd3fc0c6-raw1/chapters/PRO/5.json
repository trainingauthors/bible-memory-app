"t":"span"}," because death can result from acting on sexual desire for what is forbidden."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Pr.5.23","refs":[{"book":"PRO","endChapter":5,"endVerse":23,"startChapter":5,"startVerse":23}],"sourceAttributes":{"name":"Pr.5.23","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PRO","sourceChapterCoverage":[5],"sourceItemFragmentSha256":"aa2566df24b04fb798c16d1d638c758f468c92ca289e958bdd4441c39de212e5","sourceItemName":"Pr.5.23","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7556,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PRO","canonicalOSIS":"Prov","method":"official_book_intro_ref_title","sourceOSIS":"Pr"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"Pr.5.23","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Pr.5.23","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}