bs climaxes when the son encounters two women. Both invite the young man, and the reader with him, into an intimate relationship. The young man and the reader must decide between the woman named Wisdom, personifying the true wisdom of God (",{"href":"?bref=Pr.8.1-9.6","r":"Pr.8.1-9.6","rawR":"Pr.8.1-9.6","sourceRefs":[{"raw":"Pr.8.1-9.6","value":"Pr.8.1-9.6"}],"t":"ref","v":"8:1–9:6"},"), and the woman named Folly (",{"href":"?bref=Pr.9.13-18","r":"Pr.9.13-18","rawR":"Pr.9.13-18","sourceRefs":[{"raw":"Pr.9.13-18","value":"Pr.9.13-18"}],"t":"ref","v":"9:13-18"},"), representing the wisdom of the world (",{"href":"?bref=1Cor.1.18-2.16","r":"1Cor.1.18-2.16","rawR":"1Cor.1.18-2.16","sourceRefs":[{"raw":"1Cor.1.18-2.16","value":"1Cor.1.18-2.16"}],"t":"ref","v":"1 Cor 1:18–2:16"},"). Both women’s houses are on “the heights overlooking the city” (",{"href":"?bref=Pr.9.3","r":"Pr.9.3","rawR":"Pr.9.3","sourceRefs":[{"raw":"Pr.9.3","value":"Pr.9.3"}],"t":"ref","v":"Prov 9:3"},", ",{"href":"?bref=Pr.9.14","r":"Pr.9.14","rawR":"Pr.9.14","sourceRefs":[{"raw":"Pr.9.14","value":"Pr.9.14"}],"t":"ref","v":"14"},"), suggesting ancient temples; the choice is thus between the true God and false gods."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Pr.8.1-9.18","refs":[{"book":"PRO","endChapter":9,"endVerse":18,"startChapter":8,"startVerse":1}],"sourceAttributes":{"name":"Pr.8.1-9.18","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PRO","sourceChapterCoverage":[8,9],"sourceItemFragmentSha256":"79bc3d2959b2f33769933cdf4d5597a926b362105af24fe4d70a13c7e9bf6a44","sourceItemName":"Pr.8.1-9.18","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7587,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PRO","canonicalOSIS":"Prov","method":"official_book_intro_ref_title","sourceOSIS":"Pr"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"Pr.8.1-9.18","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Pr.8.1-9.18","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Pr.9.1-6","r":"Pr.9.1-6","rawR":"Pr.9.1-6","sourceRefs":[{"raw":"Pr.9.1-6","value":"Pr.9.1-6"}],"t":"ref","v":"9:1-6"}],"sourceClass":"sn-ref","t":"span"}," The invitation to join ",{"c":["Wisdom"],"sourceClass":"sn-excerpt","t":"span"}," for a lavish meal is met by a competing invitation in ",{"href":"?bref=Pr.9.13-18","r":"Pr.9.13-18","rawR":"Pr.9.13-18","sourceRefs":[{"raw":"Pr.9.13-18","value":"Pr.9.13-18"}],"t":"ref","v":"9:13-18"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Pr.9.1-6","refs":[{"book":"PRO","endChapter":9,"endVerse":6,"startChapter":9,"startVerse":1}],"sourceAttributes":{"name":"Pr.9.1-6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PRO","sourceChapterCoverage":[9],"sourceItemFragmentSha256":"1b8568ea46e4c18d43673ab537937e9b3ac5653b1956b9825a5b5b5f70a3fd78","sourceItemName":"Pr.9.1-6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7601,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PRO","canonicalOSIS":"Prov","method":"official_book_intro_ref_title","sourceOSIS":"Pr"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"Pr.9.1-6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Pr.9.1-6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Pr.9.1","r":"Pr.9.1","rawR":"Pr.9.1","sourceRefs":[{"raw":"Pr.9.1","value":"Pr.9.1"}],"t":"ref","v":"9:1"}],"sourceClass":"sn-ref","t":"span"}," The number ",{"c":["seven"],"sourceClass":"sn-excerpt","t":"span"}," can denote grandeur or fullness, so the seven ",{"c":["columns"],"sourceClass":"sn-excerpt","t":"span"}," represent the grandeur of Wisdom’s ",{"c":["house"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," the place where it dwells."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Pr.9.1","refs":[{"book":"PRO","endChapter":9,"endVerse":1,"startChapter":9,"startVerse":1}],"sourceAttributes":{"name":"Pr.9.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PRO","sourceChapterCoverage":[9],"sourceItemFragmentSha256":"a471168b496b42723105c36c3fff44537e57f7f442afaef74dd06d2c63a73157","sourceItemName":"Pr.9.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7602,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PRO","canonicalOSIS":"Prov","method":"official_book_intro_ref_title","sourceOSIS":"Pr"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"Pr.9.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Pr.9.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Pr.9.2","r":"Pr.9.2","rawR":"Pr.9.2","sourceRefs":[{"raw":"Pr.9.2","value":"Pr.9.2"}],"t":"ref","v":"9:2"}],"sourceClass":"sn-ref","t":"span"}," In the ancient Near East, ",{"c":["a great banquet"],"sourceClass":"sn-excerpt","t":"span"}," would accompany a marriage, a military victory, or the making of a treaty. Wisdom’s celebration marks the beginning of a committed relationship with the hearer."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Pr.9.2","refs":[{"book":"PRO","endChapter":9,"endVerse":2,"startChapter":9,"startVerse":2}],"sourceAttributes":{"name":"Pr.9.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PRO","sourceChapterCoverage":[9],"sourceItemFragmentSha256":"d02ec7fd55464de45d926dfb4375332e569f29d2d07ab9e5b50e56cd002e5cc5","sourceItemName":"Pr.9.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7603,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PRO","canonicalOSIS":"Prov","method":"official_book_intro_ref_title","sourceOSIS":"Pr"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"Pr.9.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Pr.9.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Pr.9.3","r":"Pr.9.3","rawR":"Pr.9.3","sourceRefs":[{"raw":"Pr.9.3","value":"Pr.9.3"}],"t":"ref","v":"9:3"}],"sourceClass":"sn-ref","t":"span"}," Throughout the ancient Near East, temples were built on ",{"c":["the heights overlooking the city"],"sourceClass":"sn-excerpt","t":"span"},". A commitment to wisdom involves a commitment to the Lord (contrast ",{"href":"?bref=Pr.9.14","r":"Pr.9.14","rawR":"Pr.9.14","sourceRefs":[{"raw":"Pr.9.14","value":"Pr.9.14"}],"t":"ref","v":"9:14"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Pr.9.3","refs":[{"book":"PRO","endChapter":9,"endVerse":3,"startChapter":9,"startVerse":3}],"sourceAttributes":{"name":"Pr.9.3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PRO","sourceChapterCoverage":[9],"sourceItemFragmentSha256":"64e4c0489213fd6c31630f2ee2622387fd4d974830338cb97ba98839fe65e7cd","sourceItemName":"Pr.9.3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7604,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PRO","canonicalOSIS":"Prov","method":"official_book_intro_ref_title","sourceOSIS":"Pr"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"Pr.9.3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Pr.9.3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Pr.9.4","r":"Pr.9.4","rawR":"Pr.9.4","sourceRefs":[{"raw":"Pr.9.4","value":"Pr.9.4"}],"t":"ref","v":"9:4"}],"sourceClass":"sn-ref","t":"span"}," Wisdom makes her appeal especially to the ",{"c":["simple"],"sourceClass":"sn-excerpt","t":"span"}," and ",{"c":["those who lack good judgment"],"sourceClass":"sn-excerpt","t":"span"}," because they have not yet decided between wisdom and folly. See ",{"href":"?bref=Pr.9.16","r":"Pr.9.16","rawR":"Pr.9.16","sourceRefs":[{"raw":"Pr.9.16","value":"Pr.9.16"}],"t":"ref","v":"9:16"},", where Folly mimics and then perverts Wisdom’s words."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Pr.9.4","refs":[{"book":"PRO","endChapter":9,"endVerse":4,"startChapter":9,"startVerse":4}],"sourceAttributes":{"name":"Pr.9.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PRO","sourceChapterCoverage":[9],"sourceItemFragmentSha256":"538c071d0f2c03455760f8bf6dc8ee8b2a9a2c580655a9ed75def6272c7347ca","sourceItemName":"Pr.9.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7605,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PRO","canonicalOSIS":"Prov","method":"official_book_intro_ref_title","sourceOSIS":"Pr"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"Pr.9.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Pr.9.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Pr.9.6","r":"Pr.9.6","rawR":"Pr.9.6","sourceRefs":[{"raw":"Pr.9.6","value":"Pr.9.6"}],"t":"ref","v":"9:6"}],"sourceClass":"sn-ref","t":"span"}," Wisdom gives people the ability to navigate life successfully."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Pr.9.6","refs":[{"book":"PRO","endChapter":9,"endVerse":6,"startChapter":9,"startVerse":6}],"sourceAttributes":{"name":"Pr.9.6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PRO","sourceChapterCoverage":[9],"sourceItemFragmentSha256":"033741973bb433d24edada6c78cdb7887de10d039647e3e7d12d330437f1537c","sourceItemName":"Pr.9.6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7606,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PRO","canonicalOSIS":"Prov","method":"official_book_intro_ref_title","sourceOSIS":"Pr"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"Pr.9.6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Pr.9.6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Pr.9.7-9","r":"Pr.9.7-9","rawR":"Pr.9.7-9","sourceRefs":[{"raw":"Pr.9.7-9","value":"Pr.9.7-9"}],"t":"ref","v":"9:7-9"}],"sourceClass":"sn-ref","t":"span"}," These verses seem to create an awkward break between the invitations of Wisdom and Folly, but perhaps the purpose is to caution that, in contrast with inviting the simple (",{"href":"?bref=Pr.9.4","r":"Pr.9.4","rawR":"Pr.9.4","sourceRefs":[{"raw":"Pr.9.4","value":"Pr.9.4"}],"t":"ref","v":"9:4"},"), inviting ",{"c":["mockers"],"sourceClass":"sn-excerpt","t":"span"}," and ",{"c":["the wicked"],"sourceClass":"sn-excerpt","t":"span"}," is futile at best. Such people have already chosen their path and respond to Wisdom’s advice with violence. By contrast, ",{"c":["the wise"],"sourceClass":"sn-excerpt","t":"span"}," appreciate corrective advice; they welcome it and benefit from it."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Pr.9.7-9","refs":[{"book":"PRO","endChapter":9,"endVerse":9,"startChapter":9,"startVerse":7}],"sourceAttributes":{"name":"Pr.9.7-9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PRO","sourceChapterCoverage":[9],"sourceItemFragmentSha256":"eabdd4213839979c476f0fbddc8fd1b6de325298db730cb3833ee6d14975ee2f","sourceItemName":"Pr.9.7-9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7607,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PRO","canonicalOSIS":"Prov","method":"official_book_intro_ref_title","sourceOSIS":"Pr"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"Pr.9.7-9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Pr.9.7-9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Pr.9.10-12","r":"Pr.9.10-12","rawR":"Pr.9.10-12","sourceRefs":[{"raw":"Pr.9.10-12","value":"Pr.9.10-12"}],"t":"ref","v":"9:10-12"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Fear of the"],"sourceClass":"sn-excerpt","t":"span"}," ",{"c":["Lord"],"sourceClass":"sn-excerpt-divine-name","t":"span"},{"c":[":"],"sourceClass":"sn-excerpt","t":"span"}," See ",{"href":"?item=Pr.1.7_StudyNote_Filament","id":"Pr.1.7_StudyNote_Filament","rawId":"Pr.1.7_StudyNote_Filament","t":"link","v":"study note on 1:7"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Pr.9.10-12","refs":[{"book":"PRO","endChapter":9,"endVerse":12,"startChapter":9,"startVerse":10}],"sourceAttributes":{"name":"Pr.9.10-12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PRO","sourceChapterCoverage":[9],"sourceItemFragmentSha256":"452caca0d8597c011af4e1d1003b6978eb0606bf8f139bc304442e396b5928aa","sourceItemName":"Pr.9.10-12","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7608,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PRO","canonicalOSIS":"Prov","method":"official_book_intro_ref_title","sourceOSIS":"Pr"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"Pr.9.10-12","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Pr.9.10-12","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Pr.9.13-18","r":"Pr.9.13-18","rawR":"Pr.9.13-18","sourceRefs":[{"raw":"Pr.9.13-18","value":"Pr.9.13-18"}],"t":"ref","v":"9:13-18"}],"sourceClass":"sn-ref","t":"span"}," The woman named Folly also invites the ",{"c":["simple"],"sourceClass":"sn-excerpt","t":"span"}," and ",{"c":["those who lack good judgment"],"sourceClass":"sn-excerpt","t":"span"}," to join her for the banquet she has prepared. Her invitation and advice are antithetical to Wisdom’s (",{"href":"?bref=Pr.9.1-6","r":"Pr.9.1-6","rawR":"Pr.9.1-6","sourceRefs":[{"raw":"Pr.9.1-6","value":"Pr.9.1-6"}],"t":"ref","v":"9:1-6"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Pr.9.13-18","refs":[{"book":"PRO","endChapter":9,"endVerse":18,"startChapter":9,"startVerse":13}],"sourceAttributes":{"name":"Pr.9.13-18","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PRO","sourceChapterCoverage":[9],"sourceItemFragmentSha256":"d0ae88feafbf6245c30eab36ee019faedeee7507db9892e71fdd0e89a2809b44","sourceItemName":"Pr.9.13-18","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7609,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PRO","canonicalOSIS":"Prov","method":"official_book_intro_ref_title","sourceOSIS":"Pr"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"Pr.9.13-18","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Pr.9.13-18","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Pr.9.13","r":"Pr.9.13","rawR":"Pr.9.13","sourceRefs":[{"raw":"Pr.9.13","value":"Pr.9.13"}],"t":"ref","v":"9:13"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["The woman named Folly is brash:"],"sourceClass":"sn-excerpt","t":"span"}," Fools talk boldly and without shame but have nothing intelligent to say."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Pr.9.13","refs":[{"book":"PRO","endChapter":9,"endVerse":13,"startChapter":9,"startVerse":13}],"sourceAttributes":{"name":"Pr.9.13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PRO","sourceChapterCoverage":[9],"sourceItemFragmentSha256":"e5375fe8d3917d8a56be87fd77f0dea92360b1d3bf81d55c021bd2d6c37badeb","sourceItemName":"Pr.9.13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7610,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PRO","canonicalOSIS":"Prov","method":"official_book_intro_ref_title","sourceOSIS":"Pr"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"Pr.9.13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Pr.9.13","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Pr.9.14","r":"Pr.9.14","rawR":"Pr.9.14","sourceRefs":[{"raw":"Pr.9.14","value":"Pr.9.14"}],"t":"ref","v":"9:14"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["On the heights overlooking the city"],"sourceClass":"sn-excerpt","t":"span"}," was the traditional location for a temple. Folly personifies false gods and goddesses that compete for the affection and loyalty of God’s people (contrast ",{"href":"?bref=Pr.9.2-3","r":"Pr.9.2-3","rawR":"Pr.9.2-3","sourceRefs":[{"raw":"Pr.9.2-3","value":"Pr.9.2-3"}],"t":"ref","v":"9:2-3"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Pr.9.14","refs":[{"book":"PRO","endChapter":9,"endVerse":14,"startChapter":9,"startVerse":14}],"sourceAttributes":{"name":"Pr.9.14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PRO","sourceChapterCoverage":[9],"sourceItemFragmentSha256":"24b855652c987f313253975000f1baf9e19cd0c73813b2fbeb2867a8f97ea67a","sourceItemName":"Pr.9.14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7611,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PRO","canonicalOSIS":"Prov","method":"official_book_intro_ref_title","sourceOSIS":"Pr"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"Pr.9.14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Pr.9.14","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Pr.9.17","r":"Pr.9.17","rawR":"Pr.9.17","sourceRefs":[{"raw":"Pr.9.17","value":"Pr.9.17"}],"t":"ref","v":"9:17"}],"sourceClass":"sn-ref","t":"span"}," Like Wisdom, Folly has prepared a banquet for her guests (cp. ",{"href":"?bref=Pr.9.2-5","r":"Pr.9.2-5","rawR":"Pr.9.2-5","sourceRefs":[{"raw":"Pr.9.2-5","value":"Pr.9.2-5"}],"t":"ref","v":"9:2-5"},"). However, this meal is dishonest and perverse."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Pr.9.17","refs":[{"book":"PRO","endChapter":9,"endVerse":17,"startChapter":9,"startVerse":17}],"sourceAttributes":{"name":"Pr.9.17","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PRO","sourceChapterCoverage":[9],"sourceItemFragmentSha256":"dd68dc6edffe0a6db151d1a5ee77ff08283fc272b3dab75f26bbb720cff4a3a4","sourceItemName":"Pr.9.17","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7612,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PRO","canonicalOSIS":"Prov","method":"official_book_intro_ref_title","sourceOSIS":"Pr"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"Pr.9.17","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Pr.9.17","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Pr.9.18","r":"Pr.9.18","rawR":"Pr.9.18","sourceRefs":[{"raw":"Pr.9.18","value":"Pr.9.18"}],"t":"ref","v":"9:18"}],"sourceClass":"sn-ref","t":"span"}," Folly’s dinner ",{"c":["guests"],"sourceClass":"sn-excerpt","t":"span"}," end up ",{"c":["in the depths of the grave"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," in contrast to the reward for Wisdom’s ",{"c":["guests"],"sourceClass":"ital","t":"span"}," (see ",{"href":"?bref=Pr.9.6","r":"Pr.9.6","rawR":"Pr.9.6","sourceRefs":[{"raw":"Pr.9.6","value":"Pr.9.6"}],"t":"ref","v":"9:6"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Pr.9.18","refs":[{"book":"PRO","endChapter":9,"endVerse":18,"startChapter":9,"startVerse":18}],"sourceAttributes":{"name":"Pr.9.18","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"PRO","sourceChapterCoverage":[9],"sourceItemFragmentSha256":"2881ed169aaf64a24dd0c8c3159af20a560fd568f3dc579f0be3790af6743a7e","sourceItemName":"Pr.9.18","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":7613,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"PRO","canonicalOSIS":"Prov","method":"official_book_intro_ref_title","sourceOSIS":"Pr"},"sourceReferenceStatus":"resolved_source_book_alias","sourceRefsExact":"Pr.9.18","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Pr.9.18","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}