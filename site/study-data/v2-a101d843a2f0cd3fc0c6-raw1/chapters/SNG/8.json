rence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Jerusalem","term":"Jerusalem"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Jerusalem","sourceTitle":"Jerusalem"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Song.8.1-4","r":"Song.8.1-4","rawR":"Song.8.1-4","sourceRefs":[{"raw":"Song.8.1-4","value":"Song.8.1-4"}],"t":"ref","v":"8:1-4"}],"sourceClass":"sn-ref","t":"span"}," The woman expresses her desire to be with the man and in his embrace."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Song.8.1-4","refs":[{"book":"SNG","endChapter":8,"endVerse":4,"startChapter":8,"startVerse":1}],"sourceAttributes":{"name":"Song.8.1-4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"SNG","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"ac0e31469af40ac4212a9942ceb3ffd3d6ebe4ab0d104e0fa522edc5a6019d3e","sourceItemName":"Song.8.1-4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8186,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"SNG","canonicalOSIS":"Song","method":"official_book_intro_ref_title","sourceOSIS":"Song"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Song.8.1-4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Song.8.1-4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Song.8.1","r":"Song.8.1","rawR":"Song.8.1","sourceRefs":[{"raw":"Song.8.1","value":"Song.8.1"}],"t":"ref","v":"8:1"}],"sourceClass":"sn-ref","t":"span"}," If he were her brother she could kiss him publicly; romantic kisses were not appropriate in public, but kisses between blood relatives were acceptable."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Song.8.1","refs":[{"book":"SNG","endChapter":8,"endVerse":1,"startChapter":8,"startVerse":1}],"sourceAttributes":{"name":"Song.8.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"SNG","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"173394b0faf0606309296548d41353a649ad8bc14ac177dbae478298b1e8f71d","sourceItemName":"Song.8.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8187,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"SNG","canonicalOSIS":"Song","method":"official_book_intro_ref_title","sourceOSIS":"Song"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Song.8.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Song.8.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Song.8.2-3","r":"Song.8.2-3","rawR":"Song.8.2-3","sourceRefs":[{"raw":"Song.8.2-3","value":"Song.8.2-3"}],"t":"ref","v":"8:2-3"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["bring you to my childhood home"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["to my mother’s house"],"sourceClass":"ital","t":"span"},"): Cp. ",{"href":"?bref=Song.3.4","r":"Song.3.4","rawR":"Song.3.4","sourceRefs":[{"raw":"Song.3.4","value":"Song.3.4"}],"t":"ref","v":"3:4"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Song.8.2-3","refs":[{"book":"SNG","endChapter":8,"endVerse":3,"startChapter":8,"startVerse":2}],"sourceAttributes":{"name":"Song.8.2-3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"SNG","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"649f2e0c59d5fa4a85af95693825a27f2c0eb8ace4dd02480ed3bf9cbab9ba75","sourceItemName":"Song.8.2-3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8188,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"SNG","canonicalOSIS":"Song","method":"official_book_intro_ref_title","sourceOSIS":"Song"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Song.8.2-3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Song.8.2-3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Song.8.4","r":"Song.8.4","rawR":"Song.8.4","sourceRefs":[{"raw":"Song.8.4","value":"Song.8.4"}],"t":"ref","v":"8:4"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Promise me:"],"sourceClass":"sn-excerpt","t":"span"}," For the third time, the woman encourages the young women of Jerusalem to retain their virginity (see ",{"href":"?bref=Song.2.7","r":"Song.2.7","rawR":"Song.2.7","sourceRefs":[{"raw":"Song.2.7","value":"Song.2.7"}],"t":"ref","v":"2:7"},"; ",{"href":"?bref=Song.3.5","r":"Song.3.5","rawR":"Song.3.5","sourceRefs":[{"raw":"Song.3.5","value":"Song.3.5"}],"t":"ref","v":"3:5"},"). The virtue of virginity is confirmed in ",{"href":"?bref=Song.8.8-9","r":"Song.8.8-9","rawR":"Song.8.8-9","sourceRefs":[{"raw":"Song.8.8-9","value":"Song.8.8-9"}],"t":"ref","v":"8:8-9"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Song.8.4","refs":[{"book":"SNG","endChapter":8,"endVerse":4,"startChapter":8,"startVerse":4}],"sourceAttributes":{"name":"Song.8.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"SNG","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"1efafc5b707ed36e21bc6d69da7f71134c1deae4b48684d6479dacfdfe342496","sourceItemName":"Song.8.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8189,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"SNG","canonicalOSIS":"Song","method":"official_book_intro_ref_title","sourceOSIS":"Song"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Song.8.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Song.8.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Song.8.5","r":"Song.8.5","rawR":"Song.8.5","sourceRefs":[{"raw":"Song.8.5","value":"Song.8.5"}],"t":"ref","v":"8:5"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["I aroused you under the apple tree:"],"sourceClass":"sn-excerpt","t":"span"}," The apple tree is a symbol of fertility because it is fruit-bearing (see ",{"href":"?bref=Song.2.3","r":"Song.2.3","rawR":"Song.2.3","sourceRefs":[{"raw":"Song.2.3","value":"Song.2.3"}],"t":"ref","v":"2:3"},", ",{"href":"?bref=Song.2.5","r":"Song.2.5","rawR":"Song.2.5","sourceRefs":[{"raw":"Song.2.5","value":"Song.2.5"}],"t":"ref","v":"5"},"; ",{"href":"?bref=Song.7.8","r":"Song.7.8","rawR":"Song.7.8","sourceRefs":[{"raw":"Song.7.8","value":"Song.7.8"}],"t":"ref","v":"7:8"},"). • ",{"c":["where your mother gave you birth:"],"sourceClass":"sn-excerpt","t":"span"}," Mentioning his mother may be a subtle way of suggesting procreation as a fruit of sexual love (cp. ",{"href":"?bref=Song.8.2","r":"Song.8.2","rawR":"Song.8.2","sourceRefs":[{"raw":"Song.8.2","value":"Song.8.2"}],"t":"ref","v":"8:2"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Song.8.5","refs":[{"book":"SNG","endChapter":8,"endVerse":5,"startChapter":8,"startVerse":5}],"sourceAttributes":{"name":"Song.8.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"SNG","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"12244c8e5883e69a31e074407f8cc0e5bcced50afcbd15a0292efdce095becc8","sourceItemName":"Song.8.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8190,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"SNG","canonicalOSIS":"Song","method":"official_book_intro_ref_title","sourceOSIS":"Song"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Song.8.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Song.8.5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Song.8.6","r":"Song.8.6","rawR":"Song.8.6","sourceRefs":[{"raw":"Song.8.6","value":"Song.8.6"}],"t":"ref","v":"8:6"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["seal over your heart . . . on your arm:"],"sourceClass":"sn-excerpt","t":"span"}," In ancient Israel a seal was used for identification or to show ownership by pressing the face of a ring into soft wax. The wife wants her husband to mark her with his identity, privately upon her heart, and publicly upon her arm as well. • ",{"c":["love is as strong as death:"],"sourceClass":"sn-excerpt","t":"span"}," Though death is inevitable, the bond of love is resolute, unshakable, and broken only in death. • The energy of ",{"c":["jealousy"],"sourceClass":"sn-excerpt","t":"span"}," moves to protect an exclusive relationship such as that of husband and wife or between God and his people (",{"href":"?bref=Nah.1.2","r":"Nah.1.2","rawR":"Nah.1.2","sourceRefs":[{"raw":"Nah.1.2","value":"Nah.1.2"}],"t":"ref","v":"Nah 1:2"},"; ",{"href":"?bref=Zech.1.14-17","r":"Zech.1.14-17","rawR":"Zech.1.14-17","sourceRefs":[{"raw":"Zech.1.14-17","value":"Zech.1.14-17"}],"t":"ref","v":"Zech 1:14-17"},"). • ",{"c":["as the grave:"],"sourceClass":"sn-excerpt","t":"span"}," Hebrew ",{"c":["as Sheol."],"sourceClass":"ital","t":"span"}," In the Old Testament, Sheol is the abode of the dead. It is not necessarily associated with punishment."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Song.8.6","refs":[{"book":"SNG","endChapter":8,"endVerse":6,"startChapter":8,"startVerse":6}],"sourceAttributes":{"name":"Song.8.6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"SNG","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"aebb4121b7cb86d35f9abea562fc59b9e6fb68feeb3d15920db666629ab08593","sourceItemName":"Song.8.6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8191,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"SNG","canonicalOSIS":"Song","method":"official_book_intro_ref_title","sourceOSIS":"Song"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Song.8.6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Song.8.6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Song.8.8-10","r":"Song.8.8-10","rawR":"Song.8.8-10","sourceRefs":[{"raw":"Song.8.8-10","value":"Song.8.8-10"}],"t":"ref","v":"8:8-10"}],"sourceClass":"sn-ref","t":"span"}," In the midst of a passionate exchange of romantic compliments and commitments, here again is strong praise for sexual abstinence until marriage."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Song.8.8-10","refs":[{"book":"SNG","endChapter":8,"endVerse":10,"startChapter":8,"startVerse":8}],"sourceAttributes":{"name":"Song.8.8-10","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"SNG","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"a1bb8066288bc2002b0e1c46a742dffa315004157d59566b3f8b8a611de1f0f6","sourceItemName":"Song.8.8-10","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8192,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"SNG","canonicalOSIS":"Song","method":"official_book_intro_ref_title","sourceOSIS":"Song"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Song.8.8-10","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Song.8.8-10","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Song.8.8","r":"Song.8.8","rawR":"Song.8.8","sourceRefs":[{"raw":"Song.8.8","value":"Song.8.8"}],"t":"ref","v":"8:8"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["We have a little sister:"],"sourceClass":"sn-excerpt","t":"span"}," The wife’s brothers express concern for their sister’s chastity. According to ancient Near Eastern custom, they are the protectors of their sister’s sexuality until her marriage."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Song.8.8","refs":[{"book":"SNG","endChapter":8,"endVerse":8,"startChapter":8,"startVerse":8}],"sourceAttributes":{"name":"Song.8.8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"SNG","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"85eb98a9096cd6debf0fed9cceefef0f86fc8eb5720e59adc4cbe04d60eab7e9","sourceItemName":"Song.8.8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8193,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"SNG","canonicalOSIS":"Song","method":"official_book_intro_ref_title","sourceOSIS":"Song"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Song.8.8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Song.8.8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Song.8.9","r":"Song.8.9","rawR":"Song.8.9","sourceRefs":[{"raw":"Song.8.9","value":"Song.8.9"}],"t":"ref","v":"8:9"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["wall:"],"sourceClass":"sn-excerpt","t":"span"}," There appear to be two metaphorical meanings for this term: (1) The prepubescent girl’s chest is like a wall (see ",{"href":"?bref=Song.8.10","r":"Song.8.10","rawR":"Song.8.10","sourceRefs":[{"raw":"Song.8.10","value":"Song.8.10"}],"t":"ref","v":"8:10"},"); and (2) until she is married, she should be abstinent, impenetrable like a wall. • ",{"c":["protect her with a silver tower:"],"sourceClass":"sn-excerpt","t":"span"}," Towers were used as lookouts for protecting the city; a silver one would be more prominent and impregnable. If the woman is already a wall, having kept her virginity, they will honor and reinforce her resolve. • On the other hand, a ",{"c":["swinging door"],"sourceClass":"sn-excerpt","t":"span"}," indicates promiscuity. The brothers will force her to restrain herself."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Song.8.9","refs":[{"book":"SNG","endChapter":8,"endVerse":9,"startChapter":8,"startVerse":9}],"sourceAttributes":{"name":"Song.8.9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"SNG","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"edd86d9512873853fd81e4805ab3416901c7ae46f6879d02d429979b36ec2fab","sourceItemName":"Song.8.9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8194,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"SNG","canonicalOSIS":"Song","method":"official_book_intro_ref_title","sourceOSIS":"Song"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Song.8.9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Song.8.9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Song.8.10","r":"Song.8.10","rawR":"Song.8.10","sourceRefs":[{"raw":"Song.8.10","value":"Song.8.10"}],"t":"ref","v":"8:10"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["I was a virgin, like a wall:"],"sourceClass":"sn-excerpt","t":"span"}," The woman affirms that she was chaste in preparation for marriage. • ",{"c":["now . . . like towers:"],"sourceClass":"sn-excerpt","t":"span"}," The woman describes herself in the language of desirability (cp. ",{"href":"?bref=Song.4.4","r":"Song.4.4","rawR":"Song.4.4","sourceRefs":[{"raw":"Song.4.4","value":"Song.4.4"}],"t":"ref","v":"4:4"},"; ",{"href":"?bref=Song.7.4","r":"Song.7.4","rawR":"Song.7.4","sourceRefs":[{"raw":"Song.7.4","value":"Song.7.4"}],"t":"ref","v":"7:4"},", ",{"href":"?bref=Song.7.8","r":"Song.7.8","rawR":"Song.7.8","sourceRefs":[{"raw":"Song.7.8","value":"Song.7.8"}],"t":"ref","v":"8"},") and challenges her brothers’ perception of her as immature."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Song.8.10","refs":[{"book":"SNG","endChapter":8,"endVerse":10,"startChapter":8,"startVerse":10}],"sourceAttributes":{"name":"Song.8.10","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"SNG","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"0690040ab89faa5442a045318328b065b4a8cb84bc60e939c20ec268bb69a707","sourceItemName":"Song.8.10","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8195,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"SNG","canonicalOSIS":"Song","method":"official_book_intro_ref_title","sourceOSIS":"Song"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Song.8.10","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Song.8.10","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Song.8.11-14","r":"Song.8.11-14","rawR":"Song.8.11-14","sourceRefs":[{"raw":"Song.8.11-14","value":"Song.8.11-14"}],"t":"ref","v":"8:11-14"}],"sourceClass":"sn-ref","t":"span"}," In the dramatic view, the wife’s dilemma concerning the vineyard of ",{"href":"?bref=Song.1.6","r":"Song.1.6","rawR":"Song.1.6","sourceRefs":[{"raw":"Song.1.6","value":"Song.1.6"}],"t":"ref","v":"1:6"}," is finally resolved: She has managed to bring in the lease money from her vineyard in Baal-hamon, so she can pay Solomon and her hired harvesters. • If the passage is purely poetic, its main message is that love may not be bought, even by a powerful king like Solomon."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Song.8.11-14","refs":[{"book":"SNG","endChapter":8,"endVerse":14,"startChapter":8,"startVerse":11}],"sourceAttributes":{"name":"Song.8.11-14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"SNG","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"5b5a9e6000e976f559f981a4722e3aeed675446a2542b4a1bdc76c97ec96ff94","sourceItemName":"Song.8.11-14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8196,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"SNG","canonicalOSIS":"Song","method":"official_book_intro_ref_title","sourceOSIS":"Song"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Song.8.11-14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Song.8.11-14","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Song.8.11","r":"Song.8.11","rawR":"Song.8.11","sourceRefs":[{"raw":"Song.8.11","value":"Song.8.11"}],"t":"ref","v":"8:11"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Baal-hamon"],"sourceClass":"sn-excerpt","t":"span"}," is not otherwise mentioned in the Bible. However “Balamon” occurs in later literature as a place in northern Israel; it may be the same place. • ",{"c":["a thousand pieces of silver"],"sourceClass":"sn-excerpt","t":"span"}," (Hebrew ",{"c":["1,000 [shekels] of silver"],"sourceClass":"ital","t":"span"},"): There are different denominations of shekels in the Old Testament, so the exact price cannot be determined, but the vineyard was a large one."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Song.8.11","refs":[{"book":"SNG","endChapter":8,"endVerse":11,"startChapter":8,"startVerse":11}],"sourceAttributes":{"name":"Song.8.11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"SNG","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"a436fb68118fda26bcfdfbe064c40def5efa8222462a4057d03eddbf7636de98","sourceItemName":"Song.8.11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8197,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"SNG","canonicalOSIS":"Song","method":"official_book_intro_ref_title","sourceOSIS":"Song"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Song.8.11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Song.8.11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Song.8.13","r":"Song.8.13","rawR":"Song.8.13","sourceRefs":[{"raw":"Song.8.13","value":"Song.8.13"}],"t":"ref","v":"8:13"}],"sourceClass":"sn-ref","t":"span"}," The scene has changed from that of the lease payment to the more familiar and pleasant ",{"c":["gardens"],"sourceClass":"sn-excerpt","t":"span"},". • ",{"c":["your companions:"],"sourceClass":"sn-excerpt","t":"span"}," It appears that the wife may be talking with her friends. Her man is gently jealous and wants her to himself."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Song.8.13","refs":[{"book":"SNG","endChapter":8,"endVerse":13,"startChapter":8,"startVerse":13}],"sourceAttributes":{"name":"Song.8.13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"SNG","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"33a5938353f1da3f88d12c53258a0eca054612120a8bf1ee915e168685ddbf91","sourceItemName":"Song.8.13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8198,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"SNG","canonicalOSIS":"Song","method":"official_book_intro_ref_title","sourceOSIS":"Song"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Song.8.13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Song.8.13","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Song.8.14","r":"Song.8.14","rawR":"Song.8.14","sourceRefs":[{"raw":"Song.8.14","value":"Song.8.14"}],"t":"ref","v":"8:14"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Come away, my love!"],"sourceClass":"sn-excerpt","t":"span"}," She invites him to follow her, and he chases her with all the robust and exhilarating speed of ",{"c":["a gazelle"],"sourceClass":"sn-excerpt","t":"span"}," (see ",{"href":"?bref=Song.2.8-10","r":"Song.2.8-10","rawR":"Song.2.8-10","sourceRefs":[{"raw":"Song.2.8-10","value":"Song.2.8-10"}],"t":"ref","v":"2:8-10"},"). • ",{"c":["mountains of spices:"],"sourceClass":"sn-excerpt","t":"span"}," Cp. ",{"href":"?bref=Song.4.6","r":"Song.4.6","rawR":"Song.4.6","sourceRefs":[{"raw":"Song.4.6","value":"Song.4.6"}],"t":"ref","v":"4:6"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Song.8.14","refs":[{"book":"SNG","endChapter":8,"endVerse":14,"startChapter":8,"startVerse":14}],"sourceAttributes":{"name":"Song.8.14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"SNG","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"71e50259b6d1a09734911237393373dfa3fc5ebcfed570fb8759bba5ed436b55","sourceItemName":"Song.8.14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":8199,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"SNG","canonicalOSIS":"Song","method":"official_book_intro_ref_title","sourceOSIS":"Song"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Song.8.14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Song.8.14","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}