ead"},{"id":"Land","title":"Land"},{"id":"Memorial","title":"Memorial"},{"id":"Mesopotamia","title":"Mesopotamia"},{"id":"OfferingsandSacrifices","title":"Offerings and Sacrifices"},{"id":"PatriarchsPeriodofthe","title":"Patriarchs, Period of the"},{"id":"Samaritans","title":"Samaritans"},{"id":"SpiritofGod","title":"Spirit of God"},{"id":"Sun","title":"Sun"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"altar","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":1,"href":"?bref=Gen.8.20","rawReference":"Gen.8.20"}],"ruleId":"Altar::Altar::source_verse_citation","sourceHeadwordId":"Altar"},"text":"Then Noah built an altar to the LORD. And taking from every kind of clean animal and clean bird, he offered burnt offerings on the altar.","verse":20}],"id":"Altar","label":"altar","matchReviews":[{"ruleId":"Altar::Altar::source_verse_citation","scope":"source_verse_citation","senseReview":"Reviewed original headword and source sense. This substantive word is admitted only where the original article explicitly cites the exact occurrence verse; ambiguous homographs and known context mismatches are separately excluded. This is selective contextual evidence, not an automatic rule for every same-spelling word.","sourceHeadwordId":"Altar","term":"Altar"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Altar","sourceTitle":"Altar"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Then Noah built an altar to the LORD. And taking from every kind of clean animal and clean bird, he offered burnt offerings on the altar.","verse":20},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"When the LORD smelled the pleasing aroma, He said in His heart, “Never again will I curse the ground because of man, even though every inclination of his heart is evil from his youth. And never again will I destroy all living creatures as I have done.","verse":21}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Noah","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[{"anchorIndex":5,"href":"?bref=Gen.6.14-8.19","rawReference":"Gen.6.14-8.19"}],"ruleId":"Noah::Noah::reviewed_unambiguous_name","sourceHeadwordId":"Noah"},"text":"But God remembered Noah and all the animals and livestock that were with him in the ark. And God sent a wind over the earth, and the waters began to subside.","verse":1},{"matchingRule":"reviewed_exact_headword","phrase":"Noah","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[{"anchorIndex":5,"href":"?bref=Gen.6.14-8.19","rawReference":"Gen.6.14-8.19"}],"ruleId":"Noah::Noah::reviewed_unambiguous_name","sourceHeadwordId":"Noah"},"text":"After forty days Noah opened the window he had made in the ark","verse":6},{"matchingRule":"reviewed_exact_headword","phrase":"Noah","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[{"anchorIndex":5,"href":"?bref=Gen.6.14-8.19","rawReference":"Gen.6.14-8.19"}],"ruleId":"Noah::Noah::reviewed_unambiguous_name","sourceHeadwordId":"Noah"},"text":"Then Noah sent out a dove to see if the waters had receded from the surface of the ground.","verse":8},{"matchingRule":"reviewed_exact_headword","phrase":"Noah","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[{"anchorIndex":5,"href":"?bref=Gen.6.14-8.19","rawReference":"Gen.6.14-8.19"}],"ruleId":"Noah::Noah::reviewed_unambiguous_name","sourceHeadwordId":"Noah"},"text":"Noah waited seven more days and again sent out the dove from the ark.","verse":10},{"matchingRule":"reviewed_exact_headword","phrase":"Noah","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[{"anchorIndex":5,"href":"?bref=Gen.6.14-8.19","rawReference":"Gen.6.14-8.19"}],"ruleId":"Noah::Noah::reviewed_unambiguous_name","sourceHeadwordId":"Noah"},"text":"And behold, the dove returned to him in the evening with a freshly plucked olive leaf in her beak. So Noah knew that the waters had receded from the earth.","verse":11},{"matchingRule":"reviewed_exact_headword","phrase":"Noah","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[{"anchorIndex":5,"href":"?bref=Gen.6.14-8.19","rawReference":"Gen.6.14-8.19"}],"ruleId":"Noah::Noah::reviewed_unambiguous_name","sourceHeadwordId":"Noah"},"text":"And Noah waited seven more days and sent out the dove again, but this time she did not return to him.","verse":12},{"matchingRule":"reviewed_exact_headword","phrase":"Noah","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[{"anchorIndex":5,"href":"?bref=Gen.6.14-8.19","rawReference":"Gen.6.14-8.19"}],"ruleId":"Noah::Noah::reviewed_unambiguous_name","sourceHeadwordId":"Noah"},"text":"In Noah’s six hundred and first year, on the first day of the first month, the waters had dried up from the earth. So Noah removed the covering from the ark and saw that the surface of the ground was dry.","verse":13},{"matchingRule":"reviewed_exact_headword","phrase":"Noah","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[{"anchorIndex":5,"href":"?bref=Gen.6.14-8.19","rawReference":"Gen.6.14-8.19"}],"ruleId":"Noah::Noah::reviewed_unambiguous_name","sourceHeadwordId":"Noah"},"text":"Then God said to Noah,","verse":15},{"matchingRule":"reviewed_exact_headword","phrase":"Noah","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[{"anchorIndex":5,"href":"?bref=Gen.6.14-8.19","rawReference":"Gen.6.14-8.19"}],"ruleId":"Noah::Noah::reviewed_unambiguous_name","sourceHeadwordId":"Noah"},"text":"So Noah came out, along with his sons and his wife and his sons’ wives.","verse":18},{"matchingRule":"reviewed_exact_headword","phrase":"Noah","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[{"anchorIndex":6,"href":"?bref=Gen.8.20-9.17","rawReference":"Gen.8.20-9.17"}],"ruleId":"Noah::Noah::reviewed_unambiguous_name","sourceHeadwordId":"Noah"},"text":"Then Noah built an altar to the LORD. And taking from every kind of clean animal and clean bird, he offered burnt offerings on the altar.","verse":20}],"id":"Noah","label":"Noah","matchReviews":[{"ruleId":"Noah::Noah::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Noah","term":"Noah"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Noah","sourceTitle":"Noah"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Gen.8.1","r":"Gen.8.1","rawR":"Gen.8.1","sourceRefs":[{"raw":"Gen.8.1","value":"Gen.8.1"}],"t":"ref","v":"8:1"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["God remembered:"],"sourceClass":"sn-excerpt","t":"span"}," This structural and theological center of the flood story does not mean that God had at any point forgotten Noah. This is covenant language reflecting God’s faithfulness to his promise to ensure the safety of his covenant partner (cp. ",{"href":"?bref=Gen.6.18","r":"Gen.6.18","rawR":"Gen.6.18","sourceRefs":[{"raw":"Gen.6.18","value":"Gen.6.18"}],"t":"ref","v":"6:18"},"; ",{"href":"?bref=Gen.9.15-16","r":"Gen.9.15-16","rawR":"Gen.9.15-16","sourceRefs":[{"raw":"Gen.9.15-16","value":"Gen.9.15-16"}],"t":"ref","v":"9:15-16"},"; ",{"href":"?bref=Exod.2.24","r":"Exod.2.24","rawR":"Exod.2.24","sourceRefs":[{"raw":"Exod.2.24","value":"Exod.2.24"}],"t":"ref","v":"Exod 2:24"},"; ",{"href":"?bref=Lev.26.42","r":"Lev.26.42","rawR":"Lev.26.42","sourceRefs":[{"raw":"Lev.26.42","value":"Lev.26.42"}],"t":"ref","v":"Lev 26:42"},", ",{"href":"?bref=Lev.26.45","r":"Lev.26.45","rawR":"Lev.26.45","sourceRefs":[{"raw":"Lev.26.45","value":"Lev.26.45"}],"t":"ref","v":"45"},"). • ",{"c":["wind:"],"sourceClass":"sn-excerpt","t":"span"}," The same word is translated “Spirit” in ",{"href":"?bref=Gen.1.2","r":"Gen.1.2","rawR":"Gen.1.2","sourceRefs":[{"raw":"Gen.1.2","value":"Gen.1.2"}],"t":"ref","v":"Gen 1:2"},". This and other parallels (see ",{"href":"?bref=Gen.9.1-2","r":"Gen.9.1-2","rawR":"Gen.9.1-2","sourceRefs":[{"raw":"Gen.9.1-2","value":"Gen.9.1-2"}],"t":"ref","v":"Gen 9:1-2"},") suggest that the restoration of the earth after the flood was effectively a new creation."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Gen.8.1","refs":[{"book":"GEN","endChapter":8,"endVerse":1,"startChapter":8,"startVerse":1}],"sourceAttributes":{"name":"Gen.8.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"GEN","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"beef7cf03552673257d601165a0f222dc76ad3d5ef96c81fca638b2d4f3e8b9e","sourceItemName":"Gen.8.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":120,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"GEN","canonicalOSIS":"Gen","method":"official_book_intro_ref_title","sourceOSIS":"Gen"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Gen.8.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Gen.8.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Gen.8.2","r":"Gen.8.2","rawR":"Gen.8.2","sourceRefs":[{"raw":"Gen.8.2","value":"Gen.8.2"}],"t":"ref","v":"8:2"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["underground waters . . . torrential rains:"],"sourceClass":"sn-excerpt","t":"span"}," See ",{"href":"?item=Gen.7.11-12_StudyNote_Filament","id":"Gen.7.11-12_StudyNote_Filament","rawId":"Gen.7.11-12_StudyNote_Filament","t":"link","v":"study note on 7:11-12"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Gen.8.2","refs":[{"book":"GEN","endChapter":8,"endVerse":2,"startChapter":8,"startVerse":2}],"sourceAttributes":{"name":"Gen.8.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"GEN","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"bae2f3723ff42b3675ad51eeae5d55e28748a51fabc5e3a9b9a68235cc76c4ae","sourceItemName":"Gen.8.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":121,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"GEN","canonicalOSIS":"Gen","method":"official_book_intro_ref_title","sourceOSIS":"Gen"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Gen.8.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Gen.8.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Gen.8.4","r":"Gen.8.4","rawR":"Gen.8.4","sourceRefs":[{"raw":"Gen.8.4","value":"Gen.8.4"}],"t":"ref","v":"8:4"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["mountains of Ararat"],"sourceClass":"sn-excerpt","t":"span"}," might be in the region of Ararat (Urartu) southeast of the Black Sea near Lake Van, which touches parts of eastern Turkey, Armenia, and Iran. There is a Mount Ararat (",{"c":["Agri Dag"],"sourceClass":"ital","t":"span"},") in Turkey, but this verse only identifies the region, not a specific mountain."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Gen.8.4","refs":[{"book":"GEN","endChapter":8,"endVerse":4,"startChapter":8,"startVerse":4}],"sourceAttributes":{"name":"Gen.8.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"GEN","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"32fe6730ded08b34c7ebbf1bd379809eaaacf623a77944df265de2d16c381b5b","sourceItemName":"Gen.8.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":122,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"GEN","canonicalOSIS":"Gen","method":"official_book_intro_ref_title","sourceOSIS":"Gen"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Gen.8.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Gen.8.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Gen.8.5","r":"Gen.8.5","rawR":"Gen.8.5","sourceRefs":[{"raw":"Gen.8.5","value":"Gen.8.5"}],"t":"ref","v":"8:5"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["the waters continued to go down:"],"sourceClass":"sn-excerpt","t":"span"}," Another parallel with the creation week (see ",{"href":"?bref=Gen.1.9","r":"Gen.1.9","rawR":"Gen.1.9","sourceRefs":[{"raw":"Gen.1.9","value":"Gen.1.9"}],"t":"ref","v":"1:9"},") suggests that the earth’s restoration was effectively a new creation (see ",{"href":"?item=Gen.8.1_StudyNote_Filament","id":"Gen.8.1_StudyNote_Filament","rawId":"Gen.8.1_StudyNote_Filament","t":"link","v":"study note on 8:1"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Gen.8.5","refs":[{"book":"GEN","endChapter":8,"endVerse":5,"startChapter":8,"startVerse":5}],"sourceAttributes":{"name":"Gen.8.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"GEN","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"56831a3bba5796912a688706fb1d6a506c5f9546342693bf9144ba5349a6833d","sourceItemName":"Gen.8.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":123,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"GEN","canonicalOSIS":"Gen","method":"official_book_intro_ref_title","sourceOSIS":"Gen"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Gen.8.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Gen.8.5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Gen.8.7","r":"Gen.8.7","rawR":"Gen.8.7","sourceRefs":[{"raw":"Gen.8.7","value":"Gen.8.7"}],"t":"ref","v":"8:7"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["raven"],"sourceClass":"sn-excerpt","t":"span"}," is the largest member of the crow family, and was among Noah’s unclean animals (",{"href":"?bref=Lev.11.15","r":"Lev.11.15","rawR":"Lev.11.15","sourceRefs":[{"raw":"Lev.11.15","value":"Lev.11.15"}],"t":"ref","v":"Lev 11:15"},"; ",{"href":"?bref=Deut.14.14","r":"Deut.14.14","rawR":"Deut.14.14","sourceRefs":[{"raw":"Deut.14.14","value":"Deut.14.14"}],"t":"ref","v":"Deut 14:14"},"). As a scavenger and carrion eater, it was able to sustain itself without returning to the boat."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Gen.8.7","refs":[{"book":"GEN","endChapter":8,"endVerse":7,"startChapter":8,"startVerse":7}],"sourceAttributes":{"name":"Gen.8.7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"GEN","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"1af8452c766e71ecec3c838587cb27431abe1a2b2a920927007d5a150ea7f881","sourceItemName":"Gen.8.7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":124,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"GEN","canonicalOSIS":"Gen","method":"official_book_intro_ref_title","sourceOSIS":"Gen"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Gen.8.7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Gen.8.7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Gen.8.11","r":"Gen.8.11","rawR":"Gen.8.11","sourceRefs":[{"raw":"Gen.8.11","value":"Gen.8.11"}],"t":"ref","v":"8:11"}],"sourceClass":"sn-ref","t":"span"}," Unlike the raven (",{"href":"?bref=Gen.8.7","r":"Gen.8.7","rawR":"Gen.8.7","sourceRefs":[{"raw":"Gen.8.7","value":"Gen.8.7"}],"t":"ref","v":"8:7"},"), the ",{"c":["dove"],"sourceClass":"sn-excerpt","t":"span"}," feeds on vegetation. Since olive trees are not tall, Noah could tell that the water was ",{"c":["almost gone"],"sourceClass":"sn-excerpt","t":"span"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Gen.8.11","refs":[{"book":"GEN","endChapter":8,"endVerse":11,"startChapter":8,"startVerse":11}],"sourceAttributes":{"name":"Gen.8.11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"GEN","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"ec478175012bb73dedecf35bf101be892f85b595169816818afd6f7083635cb3","sourceItemName":"Gen.8.11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":125,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"GEN","canonicalOSIS":"Gen","method":"official_book_intro_ref_title","sourceOSIS":"Gen"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Gen.8.11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Gen.8.11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Gen.8.13","r":"Gen.8.13","rawR":"Gen.8.13","sourceRefs":[{"raw":"Gen.8.13","value":"Gen.8.13"}],"t":"ref","v":"8:13"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["On the first day of the new year, ten and a half months after the flood began:"],"sourceClass":"sn-excerpt","t":"span"}," This was two months after the peaks of the mountains first became visible (",{"href":"?bref=Gen.8.5","r":"Gen.8.5","rawR":"Gen.8.5","sourceRefs":[{"raw":"Gen.8.5","value":"Gen.8.5"}],"t":"ref","v":"8:5"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Gen.8.13","refs":[{"book":"GEN","endChapter":8,"endVerse":13,"startChapter":8,"startVerse":13}],"sourceAttributes":{"name":"Gen.8.13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"GEN","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"4650268e094a5b055c7f56a894897274d1f3ba55f5d52e022763ce2c66f26b23","sourceItemName":"Gen.8.13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":126,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"GEN","canonicalOSIS":"Gen","method":"official_book_intro_ref_title","sourceOSIS":"Gen"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Gen.8.13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Gen.8.13","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Gen.8.14","r":"Gen.8.14","rawR":"Gen.8.14","sourceRefs":[{"raw":"Gen.8.14","value":"Gen.8.14"}],"t":"ref","v":"8:14"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["the earth was dry!"],"sourceClass":"sn-excerpt","t":"span"}," This special word for dry land is uniquely used in connection with the sea to portray God’s sovereignty over both domains (see ",{"href":"?bref=Gen.1.9-10","r":"Gen.1.9-10","rawR":"Gen.1.9-10","sourceRefs":[{"raw":"Gen.1.9-10","value":"Gen.1.9-10"}],"t":"ref","v":"1:9-10"},"; ",{"href":"?bref=Exod.14.22","r":"Exod.14.22","rawR":"Exod.14.22","sourceRefs":[{"raw":"Exod.14.22","value":"Exod.14.22"}],"t":"ref","v":"Exod 14:22"},", ",{"href":"?bref=Exod.14.29","r":"Exod.14.29","rawR":"Exod.14.29","sourceRefs":[{"raw":"Exod.14.29","value":"Exod.14.29"}],"t":"ref","v":"29"},"; ",{"href":"?bref=Ps.95.5","r":"Ps.95.5","rawR":"Ps.95.5","sourceRefs":[{"raw":"Ps.95.5","value":"Ps.95.5"}],"t":"ref","v":"Ps 95:5"},"; ",{"href":"?bref=Jon.1.9","r":"Jon.1.9","rawR":"Jon.1.9","sourceRefs":[{"raw":"Jon.1.9","value":"Jon.1.9"}],"t":"ref","v":"Jon 1:9"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Gen.8.14","refs":[{"book":"GEN","endChapter":8,"endVerse":14,"startChapter":8,"startVerse":14}],"sourceAttributes":{"name":"Gen.8.14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"GEN","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"3f30903436eca64fb1c889014e0373db6d4900b2793e0124cc8729f7ad77b7b8","sourceItemName":"Gen.8.14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":127,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"GEN","canonicalOSIS":"Gen","method":"official_book_intro_ref_title","sourceOSIS":"Gen"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Gen.8.14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Gen.8.14","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Gen.8.17","r":"Gen.8.17","rawR":"Gen.8.17","sourceRefs":[{"raw":"Gen.8.17","value":"Gen.8.17"}],"t":"ref","v":"8:17"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["be fruitful and multiply:"],"sourceClass":"sn-excerpt","t":"span"}," See ",{"href":"?bref=Gen.9.1","r":"Gen.9.1","rawR":"Gen.9.1","sourceRefs":[{"raw":"Gen.9.1","value":"Gen.9.1"}],"t":"ref","v":"9:1"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Gen.8.17","refs":[{"book":"GEN","endChapter":8,"endVerse":17,"startChapter":8,"startVerse":17}],"sourceAttributes":{"name":"Gen.8.17","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"GEN","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"8404bbb219f8972fae4bdbbaebd4da12e6fdb2eccf33d4071254e59c2abdb71e","sourceItemName":"Gen.8.17","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":128,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"GEN","canonicalOSIS":"Gen","method":"official_book_intro_ref_title","sourceOSIS":"Gen"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Gen.8.17","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Gen.8.17","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Gen.8.20","r":"Gen.8.20","rawR":"Gen.8.20","sourceRefs":[{"raw":"Gen.8.20","value":"Gen.8.20"}],"t":"ref","v":"8:20"}],"sourceClass":"sn-ref","t":"span"}," This first mention of an ",{"c":["altar"],"sourceClass":"sn-excerpt","t":"span"}," in the Bible shows Noah’s gratitude for having passed through the judgment. • ",{"c":["sacrificed as burnt offerings:"],"sourceClass":"sn-excerpt","t":"span"}," The same wording is used of the whole burnt offering in Leviticus (",{"href":"?bref=Lev.1.3-9","r":"Lev.1.3-9","rawR":"Lev.1.3-9","sourceRefs":[{"raw":"Lev.1.3-9","value":"Lev.1.3-9"}],"t":"ref","v":"Lev 1:3-9"},"); however, it can refer to any offering that is burned. Noah gave this offering to thank and worship God, who had delivered him and his family from the flood."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Gen.8.20","refs":[{"book":"GEN","endChapter":8,"endVerse":20,"startChapter":8,"startVerse":20}],"sourceAttributes":{"name":"Gen.8.20","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"GEN","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"fcb74bebdc4f078505fd5eb2cab4d341c1059753713450f9f74dc1f8ac964b76","sourceItemName":"Gen.8.20","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":129,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"GEN","canonicalOSIS":"Gen","method":"official_book_intro_ref_title","sourceOSIS":"Gen"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Gen.8.20","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Gen.8.20","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Gen.8.21","r":"Gen.8.21","rawR":"Gen.8.21","sourceRefs":[{"raw":"Gen.8.21","value":"Gen.8.21"}],"t":"ref","v":"8:21"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["pleased with the aroma of the sacrifice"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["smelled the sweet aroma"],"sourceClass":"ital","t":"span"},"): The narrator uses anthropomorphic language (i.e., he describes God’s activity in human terms) to show God’s acceptance of Noah’s offering (see also ",{"href":"?bref=Exod.29.18","r":"Exod.29.18","rawR":"Exod.29.18","sourceRefs":[{"raw":"Exod.29.18","value":"Exod.29.18"}],"t":"ref","v":"Exod 29:18"},"; ",{"href":"?bref=Lev.1.9","r":"Lev.1.9","rawR":"Lev.1.9","sourceRefs":[{"raw":"Lev.1.9","value":"Lev.1.9"}],"t":"ref","v":"Lev 1:9"},"; ",{"href":"?bref=Num.15.3","r":"Num.15.3","rawR":"Num.15.3","sourceRefs":[{"raw":"Num.15.3","value":"Num.15.3"}],"t":"ref","v":"Num 15:3"},"). The common ancient Near Eastern notion that the gods ate the sacrifices offered to them is notably absent. • ",{"c":["to himself"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["in his heart"],"sourceClass":"ital","t":"span"},"): The phrase echoes “broke his heart” (",{"href":"?bref=Gen.6.6","r":"Gen.6.6","rawR":"Gen.6.6","sourceRefs":[{"raw":"Gen.6.6","value":"Gen.6.6"}],"t":"ref","v":"6:6"},"), just as ",{"c":["think or imagine"],"sourceClass":"sn-excerpt","t":"span"}," echoes “everything they thought or imagined” (",{"href":"?bref=Gen.6.5","r":"Gen.6.5","rawR":"Gen.6.5","sourceRefs":[{"raw":"Gen.6.5","value":"Gen.6.5"}],"t":"ref","v":"6:5"},"). God’s commitment to a new order replaced his grief over the old. • ",{"c":["I will never again curse . . . destroy:"],"sourceClass":"sn-excerpt","t":"span"}," The old curse was not lifted (",{"href":"?bref=Gen.5.29","r":"Gen.5.29","rawR":"Gen.5.29","sourceRefs":[{"raw":"Gen.5.29","value":"Gen.5.29"}],"t":"ref","v":"5:29"},"), but God promised not to add to it, thus establishing new limits for life in a disordered world (cp. ",{"href":"?bref=Isa.54.9","r":"Isa.54.9","rawR":"Isa.54.9","sourceRefs":[{"raw":"Isa.54.9","value":"Isa.54.9"}],"t":"ref","v":"Isa 54:9"},"). The flood was to stop violence, not to reform the human heart (",{"href":"?bref=Gen.6.5","r":"Gen.6.5","rawR":"Gen.6.5","sourceRefs":[{"raw":"Gen.6.5","value":"Gen.6.5"}],"t":"ref","v":"Gen 6:5"},"). Humankind’s ",{"c":["bent toward evil"],"sourceClass":"sn-excerpt","t":"span"}," would be contained to some degree through accountability to a new law (",{"href":"?bref=Gen.9.5-6","r":"Gen.9.5-6","rawR":"Gen.9.5-6","sourceRefs":[{"raw":"Gen.9.5-6","value":"Gen.9.5-6"}],"t":"ref","v":"9:5-6"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Gen.8.21","refs":[{"book":"GEN","endChapter":8,"endVerse":21,"startChapter":8,"startVerse":21}],"sourceAttributes":{"name":"Gen.8.21","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"GEN","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"0b6df0bf90acb06bbf173b1b503a7b59aa5b759bac0c2e528601d10b7ef31d7c","sourceItemName":"Gen.8.21","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":130,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"GEN","canonicalOSIS":"Gen","method":"official_book_intro_ref_title","sourceOSIS":"Gen"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Gen.8.21","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Gen.8.21","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Gen.8.22","r":"Gen.8.22","rawR":"Gen.8.22","sourceRefs":[{"raw":"Gen.8.22","value":"Gen.8.22"}],"t":"ref","v":"8:22"}],"sourceClass":"sn-ref","t":"span"}," God’s promise to sustain the rhythm of the seasons reaffirmed the created order (",{"href":"?bref=Gen.1.14","r":"Gen.1.14","rawR":"Gen.1.14","sourceRefs":[{"raw":"Gen.1.14","value":"Gen.1.14"}],"t":"ref","v":"1:14"},"; see also ",{"href":"?bref=Jer.33.20","r":"Jer.33.20","rawR":"Jer.33.20","sourceRefs":[{"raw":"Jer.33.20","value":"Jer.33.20"}],"t":"ref","v":"Jer 33:20"},"; ",{"href":"?bref=Zech.14.7","r":"Zech.14.7","rawR":"Zech.14.7","sourceRefs":[{"raw":"Zech.14.7","value":"Zech.14.7"}],"t":"ref","v":"Zech 14:7"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Gen.8.22","refs":[{"book":"GEN","endChapter":8,"endVerse":22,"startChapter":8,"startVerse":22}],"sourceAttributes":{"name":"Gen.8.22","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"GEN","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"f48ab0b407f2869390fa6bdff9f8ca126df1ffbfe772c741ee44772876a4d8a1","sourceItemName":"Gen.8.22","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":131,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"GEN","canonicalOSIS":"Gen","method":"official_book_intro_ref_title","sourceOSIS":"Gen"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Gen.8.22","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Gen.8.22","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}