":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Blood","sourceTitle":"Blood"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Then the LORD said to Moses,","verse":1},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"“Speak to Aaron, his sons, and all the Israelites and tell them this is what the LORD has commanded:","verse":2},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"instead of bringing it to the entrance to the Tent of Meeting to present it as an offering to the LORD before His tabernacle—that man shall incur bloodguilt. He has shed blood and must be cut off from among his people.","verse":4},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"For this reason the Israelites will bring to the LORD the sacrifices they have been offering in the open fields. They are to bring them to the priest at the entrance to the Tent of Meeting and offer them as sacrifices of peace offerings to the LORD.","verse":5},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"The priest will then splatter the blood on the altar of the LORD at the entrance to the Tent of Meeting and burn the fat as a pleasing aroma to the LORD.","verse":6},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"but does not bring it to the entrance to the Tent of Meeting to sacrifice it to the LORD, that man must be cut off from his people.","verse":9}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Moses","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Moses::Moses::reviewed_unambiguous_name","sourceHeadwordId":"Moses"},"text":"Then the LORD said to Moses,","verse":1}],"id":"Moses","label":"Moses","matchReviews":[{"ruleId":"Moses::Moses::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Moses","term":"Moses"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Moses","sourceTitle":"Moses"},{"evidence":[{"matchingRule":"source_verified_redirect","phrase":"Tent of Meeting","senseEvidence":{"basis":"reviewed_publisher_redirect","originalCitations":[],"ruleId":"Tabernacle::Tent of Meeting::reviewed_publisher_redirect","sourceHeadwordId":"TentofMeeting"},"text":"instead of bringing it to the entrance to the Tent of Meeting to present it as an offering to the LORD before His tabernacle—that man shall incur bloodguilt. He has shed blood and must be cut off from among his people.","verse":4},{"matchingRule":"source_verified_redirect","phrase":"Tent of Meeting","senseEvidence":{"basis":"reviewed_publisher_redirect","originalCitations":[],"ruleId":"Tabernacle::Tent of Meeting::reviewed_publisher_redirect","sourceHeadwordId":"TentofMeeting"},"text":"For this reason the Israelites will bring to the LORD the sacrifices they have been offering in the open fields. They are to bring them to the priest at the entrance to the Tent of Meeting and offer them as sacrifices of peace offerings to the LORD.","verse":5},{"matchingRule":"source_verified_redirect","phrase":"Tent of Meeting","senseEvidence":{"basis":"reviewed_publisher_redirect","originalCitations":[],"ruleId":"Tabernacle::Tent of Meeting::reviewed_publisher_redirect","sourceHeadwordId":"TentofMeeting"},"text":"The priest will then splatter the blood on the altar of the LORD at the entrance to the Tent of Meeting and burn the fat as a pleasing aroma to the LORD.","verse":6},{"matchingRule":"source_verified_redirect","phrase":"Tent of Meeting","senseEvidence":{"basis":"reviewed_publisher_redirect","originalCitations":[],"ruleId":"Tabernacle::Tent of Meeting::reviewed_publisher_redirect","sourceHeadwordId":"TentofMeeting"},"text":"but does not bring it to the entrance to the Tent of Meeting to sacrifice it to the LORD, that man must be cut off from his people.","verse":9}],"id":"Tabernacle","label":"Tent of Meeting","matchReviews":[{"ruleId":"Tabernacle::Tent of Meeting::reviewed_publisher_redirect","scope":"reviewed_publisher_redirect","senseReview":"The original publisher explicitly links this complete unambiguous name/phrase to this target. Redirect and target were reviewed once; actual BSB phrase and full word boundaries required. Target original title and complete article remain unchanged.","sourceHeadwordId":"TentofMeeting","term":"Tent of Meeting"}],"matchingRule":"source_verified_redirect","matchingRules":["source_verified_redirect"],"sourceProvenanceId":"Tabernacle","sourceTitle":"Tabernacle"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.17.1-26.46","r":"Lev.17.1-26.46","rawR":"Lev.17.1-26.46","sourceRefs":[{"raw":"Lev.17.1-26.46","value":"Lev.17.1-26.46"}],"t":"ref","v":"17:1–26:46"}],"sourceClass":"sn-ref","t":"span"}," This section deals with how the community of Israel was to observe holiness. Holiness does not describe one attribute of God among many. Rather, it is the sum of all attributes of his person, nature, and character (see ",{"href":"?item=Exod.3.5_StudyNote_Filament","id":"Exod.3.5_StudyNote_Filament","rawId":"Exod.3.5_StudyNote_Filament","t":"link","v":"study note on Exod 3:5"},"). His “glory” is the manifestation of his perfect person, nature, and character (see ",{"href":"?bref=Lev.9.6","r":"Lev.9.6","rawR":"Lev.9.6","sourceRefs":[{"raw":"Lev.9.6","value":"Lev.9.6"}],"t":"ref","v":"Lev 9:6"},"). God’s covenant with Israel meant that the people and the nation participated in God’s holiness. This holiness depended on Israel’s relationship with God. This relationship brought certain ethical and ritual expectations for Israel to uphold."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.17.1-26.46","refs":[{"book":"LEV","endChapter":17,"endVerse":2,"startChapter":17,"startVerse":1}],"sourceAttributes":{"name":"Lev.17.1-26.46","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[17],"sourceItemFragmentSha256":"c12768c004581300ce4096d8551812e2d093fc54037a283d3da44574a7dab508","sourceItemName":"Lev.17.1-26.46","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1440,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.17.1-2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.17.1-26.46","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.17.3-9","r":"Lev.17.3-9","rawR":"Lev.17.3-9","sourceRefs":[{"raw":"Lev.17.3-9","value":"Lev.17.3-9"}],"t":"ref","v":"17:3-9"}],"sourceClass":"sn-ref","t":"span"}," These regulations (see also ",{"href":"?bref=Deut.12.15-21","r":"Deut.12.15-21","rawR":"Deut.12.15-21","sourceRefs":[{"raw":"Deut.12.15-21","value":"Deut.12.15-21"}],"t":"ref","v":"Deut 12:15-21"},") indicate that unsupervised sacrifice could easily lead to the integration of pagan elements into the true worship of the Lord (",{"href":"?bref=Lev.17.7","r":"Lev.17.7","rawR":"Lev.17.7","sourceRefs":[{"raw":"Lev.17.7","value":"Lev.17.7"}],"t":"ref","v":"Lev 17:7"},"). Israel was camped around the Tabernacle (",{"href":"?bref=Num.2.2-34","r":"Num.2.2-34","rawR":"Num.2.2-34","sourceRefs":[{"raw":"Num.2.2-34","value":"Num.2.2-34"}],"t":"ref","v":"Num 2:2-34"},"), so it was not inconvenient to bring an animal to the sanctuary for slaughter. ",{"href":"?bref=Deut.12.20-24","r":"Deut.12.20-24","rawR":"Deut.12.20-24","sourceRefs":[{"raw":"Deut.12.20-24","value":"Deut.12.20-24"}],"t":"ref","v":"Deuteronomy 12:20-24"}," anticipates Israel’s settlement in the land and the hardship imposed by this regulation. It permitted slaughtering and eating meat without bringing it to the sanctuary, as long as the blood was not consumed."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.17.3-9","refs":[{"book":"LEV","endChapter":17,"endVerse":9,"startChapter":17,"startVerse":3}],"sourceAttributes":{"name":"Lev.17.3-9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[17],"sourceItemFragmentSha256":"827efd5ae0a32df9de42c1d8c2ab970b994efc3cf5d1e7f00210703846387234","sourceItemName":"Lev.17.3-9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1441,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.17.3-9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.17.3-9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.17.4","r":"Lev.17.4","rawR":"Lev.17.4","sourceRefs":[{"raw":"Lev.17.4","value":"Lev.17.4"}],"t":"ref","v":"17:4"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["will be as guilty as a murderer:"],"sourceClass":"sn-excerpt","t":"span"}," The person had shed an animal’s blood in an unlawful manner. The life of the animal had been given by God; it had to be returned to him in the blood of the sacrificed animal. • ",{"c":["cut off:"],"sourceClass":"sn-excerpt","t":"span"}," See ",{"href":"?item=Lev.7.20-21_StudyNote_Filament","id":"Lev.7.20-21_StudyNote_Filament","rawId":"Lev.7.20-21_StudyNote_Filament","t":"link","v":"study note on 7:20-21"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.17.4","refs":[{"book":"LEV","endChapter":17,"endVerse":4,"startChapter":17,"startVerse":4}],"sourceAttributes":{"name":"Lev.17.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[17],"sourceItemFragmentSha256":"833f23b7673be18ae1afce879aed6e41813ba3299bfef9c66e2f82a4583a13d4","sourceItemName":"Lev.17.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1442,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.17.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.17.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.17.7","r":"Lev.17.7","rawR":"Lev.17.7","sourceRefs":[{"raw":"Lev.17.7","value":"Lev.17.7"}],"t":"ref","v":"17:7"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["be unfaithful"],"sourceClass":"sn-excerpt","t":"span"}," (Hebrew ",{"c":["zanah"],"sourceClass":"hebrew","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," “commit fornication”): Israel was not to worship any god but the Lord (",{"href":"?bref=Exod.20.3","r":"Exod.20.3","rawR":"Exod.20.3","sourceRefs":[{"raw":"Exod.20.3","value":"Exod.20.3"}],"t":"ref","v":"Exod 20:3"},"). Israel’s covenant relationship to the Lord was even compared to a marriage (see ",{"href":"?bref=Hos.1.2","r":"Hos.1.2","rawR":"Hos.1.2","sourceRefs":[{"raw":"Hos.1.2","value":"Hos.1.2"}],"t":"ref","v":"Hos 1:2"},"), and worshiping other gods could be described as spiritual adultery. In addition, many of the Canaanite religions were fertility cults. This verb reflects the prostitution conducted at Canaanite shrines to induce fertility in the land through rites of magic involving sexual intercourse. • The Hebrew word translated ",{"c":["goat idols"],"sourceClass":"sn-excerpt","t":"span"}," is the plural for a male goat. In the ancient world, the male goat was often a symbol of fertility or of a god of the underworld. During the reign of Jeroboam I, many Levites from the northern kingdom moved south to Jerusalem; they had been appalled by the use of goats and bulls in the northern kingdom’s worship (",{"href":"?bref=2Chr.11.15-16","r":"2Chr.11.15-16","rawR":"2Chr.11.15-16","sourceRefs":[{"raw":"2Chr.11.15-16","value":"2Chr.11.15-16"}],"t":"ref","v":"2 Chr 11:15-16"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.17.7","refs":[{"book":"LEV","endChapter":17,"endVerse":7,"startChapter":17,"startVerse":7}],"sourceAttributes":{"name":"Lev.17.7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[17],"sourceItemFragmentSha256":"46242f93ba25d4de5a26df5811ce41e46ba01248f781e8660f6b61955242d760","sourceItemName":"Lev.17.7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1443,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.17.7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.17.7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.17.11","r":"Lev.17.11","rawR":"Lev.17.11","sourceRefs":[{"raw":"Lev.17.11","value":"Lev.17.11"}],"t":"ref","v":"17:11"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["the life of the body is in its blood:"],"sourceClass":"sn-excerpt","t":"span"}," Israel was forbidden to consume blood (",{"href":"?bref=Lev.17.10","r":"Lev.17.10","rawR":"Lev.17.10","sourceRefs":[{"raw":"Lev.17.10","value":"Lev.17.10"}],"t":"ref","v":"17:10"},") because it was symbolic of the life given by God and was reserved as God’s portion of each animal offering. God had also designated the sacrificial blood as the means of atonement. In other words, God’s grace permitted the life of the animal to be accepted in exchange for the life of the sinner. In the New Testament, the blood of Christ—representing his life freely given—has provided eternal redemption for believers (",{"href":"?bref=Heb.9.12","r":"Heb.9.12","rawR":"Heb.9.12","sourceRefs":[{"raw":"Heb.9.12","value":"Heb.9.12"}],"t":"ref","v":"Heb 9:12"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.17.11","refs":[{"book":"LEV","endChapter":17,"endVerse":11,"startChapter":17,"startVerse":11}],"sourceAttributes":{"name":"Lev.17.11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[17],"sourceItemFragmentSha256":"1f7d9c431e647f1e89d877e91de111f9ad63996bc4d6557c023596868c7a4d16","sourceItemName":"Lev.17.11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1444,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.17.11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.17.11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.17.13","r":"Lev.17.13","rawR":"Lev.17.13","sourceRefs":[{"raw":"Lev.17.13","value":"Lev.17.13"}],"t":"ref","v":"17:13"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["cover it with earth:"],"sourceClass":"sn-excerpt","t":"span"}," This restriction kept the hunter from using an animal’s blood for food. Just like the blood of animals presented in altar offerings, the blood of wild game also represented life. Uncovered blood was also the sign of violent crime; innocent blood defiled the land (",{"href":"?bref=Num.35.33","r":"Num.35.33","rawR":"Num.35.33","sourceRefs":[{"raw":"Num.35.33","value":"Num.35.33"}],"t":"ref","v":"Num 35:33"},") and cried out to God for justice (",{"href":"?bref=Gen.4.10","r":"Gen.4.10","rawR":"Gen.4.10","sourceRefs":[{"raw":"Gen.4.10","value":"Gen.4.10"}],"t":"ref","v":"Gen 4:10"},"; see ",{"href":"?bref=Job.16.18","r":"Job.16.18","rawR":"Job.16.18","sourceRefs":[{"raw":"Job.16.18","value":"Job.16.18"}],"t":"ref","v":"Job 16:18"},"). Covering the blood of a slain animal gave it a symbolic burial. This demonstrated reverence both for the animal’s life and for God, the life-giver. The burial signified the return of that life to God, just like the disposal of the blood by the priest in the altar offerings."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.17.13","refs":[{"book":"LEV","endChapter":17,"endVerse":13,"startChapter":17,"startVerse":13}],"sourceAttributes":{"name":"Lev.17.13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[17],"sourceItemFragmentSha256":"4f1a18b86e3d15d3f8ea33fc73a2f7e0cb9897a30832461e979f8b7a08a2eb7d","sourceItemName":"Lev.17.13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1445,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.17.13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.17.13","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.17.15-16","r":"Lev.17.15-16","rawR":"Lev.17.15-16","sourceRefs":[{"raw":"Lev.17.15-16","value":"Lev.17.15-16"}],"t":"ref","v":"17:15-16"}],"sourceClass":"sn-ref","t":"span"}," An animal killed by a predator or which died of natural causes still had undrained blood in its tissues. This rendered it ceremonially unclean and a potential source of defilement (",{"href":"?bref=Lev.22.8","r":"Lev.22.8","rawR":"Lev.22.8","sourceRefs":[{"raw":"Lev.22.8","value":"Lev.22.8"}],"t":"ref","v":"22:8"},"). Israelites were to throw such an animal to the dogs (",{"href":"?bref=Exod.22.31","r":"Exod.22.31","rawR":"Exod.22.31","sourceRefs":[{"raw":"Exod.22.31","value":"Exod.22.31"}],"t":"ref","v":"Exod 22:31"},") or give or sell it to a non-Israelite (",{"href":"?bref=Deut.14.21","r":"Deut.14.21","rawR":"Deut.14.21","sourceRefs":[{"raw":"Deut.14.21","value":"Deut.14.21"}],"t":"ref","v":"Deut 14:21"},"). If an Israelite happened to eat an animal with undrained blood, he or she became ceremonially unclean and had to wash in water. The uncleanness itself was not a sin, but neglect of the unclean state brought punishment."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.17.15-16","refs":[{"book":"LEV","endChapter":17,"endVerse":16,"startChapter":17,"startVerse":15}],"sourceAttributes":{"name":"Lev.17.15-16","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[17],"sourceItemFragmentSha256":"98b84e7ac8630474dafca9395ad84b29527eac76bf29a3ad96afa8de42e66d7a","sourceItemName":"Lev.17.15-16","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1446,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.17.15-16","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.17.15-16","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}