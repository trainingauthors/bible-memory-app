,"CleannessandUncleannessRegulationsconcerning":{"file":"dictionary/962f6cb40dfd0637fadcdd3b25c6f7d81c665dddadf88035a1ea8e75d8e4a46c.json","title":"Cleanness and Uncleanness, Regulations concerning"},"DeuteronomyBookof":{"file":"dictionary/98e8abaa0f8fc30647393a1d8e49676753f1ab5a0e5e1bbac37de619f91e28af.json","title":"Deuteronomy, Book of"},"IsraelHistoryof":{"file":"dictionary/fb64f19f022969500f15a37b01a3715fc99aff642319c7e1ccf2832bd8a828ed.json","title":"Israel, History of"},"LawBiblicalConceptof":{"file":"dictionary/3abfe86f0add8235f7dc654a7b16bef5482eac2c4ccc84d543d4b4463992fabb.json","title":"Law, Biblical Concept of"},"LeviticusBookof":{"file":"dictionary/02a2907b793cbe7dae77338fbfd7ba6eda32d4a31e14db30f86958f0a8604201.json","title":"Leviticus, Book of"},"Lord":{"file":"dictionary/0a54f5caa03523157b50ef58ec814d810e7db1abd5db44ec093ece07106e3447.json","title":"Lord"},"MedicineandMedicalPractice":{"file":"dictionary/18a74c4ec34fe3b06dec90cd33ef350fe76e8c236936efba60df76681a7298ee.json","title":"Medicine and Medical Practice"},"Moses":{"file":"dictionary/91ff39375ee14c7621443129210c81b1d472f29d47ddb581180392db8602873d.json","title":"Moses"},"OfferingsandSacrifices":{"file":"dictionary/33e120a122e31e3f3c92a6f7219b21220f75191e0e0e00f3d00985067a35c6d0.json","title":"Offerings and Sacrifices"},"Tabernacle":{"file":"dictionary/34bcab8037ed24a7e58e5513cae53aa2fe13d14876c4a62817a0f8d23d0fb982.json","title":"Tabernacle"},"Uncircumcision":{"file":"dictionary/c98b0298eb105a4077c471afddeda806ff06301230ff3a8845ef5b5aef6410da.json","title":"Uncircumcision*"},"Worship":{"file":"dictionary/b49748b47f4477107e66fb89b6e99498a20192bedd7180ba8bd63c90c434f666.json","title":"Worship"}},"dictionaryRelated":[{"id":"Birds","title":"Birds"},{"id":"Circumcision","title":"Circumcision"},{"id":"CleannessandUncleannessRegulationsconcerning","title":"Cleanness and Uncleanness, Regulations concerning"},{"id":"DeuteronomyBookof","title":"Deuteronomy, Book of"},{"id":"IsraelHistoryof","title":"Israel, History of"},{"id":"LawBiblicalConceptof","title":"Law, Biblical Concept of"},{"id":"LeviticusBookof","title":"Leviticus, Book of"},{"id":"MedicineandMedicalPractice","title":"Medicine and Medical Practice"},{"id":"Uncircumcision","title":"Uncircumcision*"},{"id":"Worship","title":"Worship"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Then the LORD said to Moses,","verse":1},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"And the priest will present them before the LORD and make atonement for her; and she shall be ceremonially cleansed from her flow of blood. This is the law for a woman giving birth, whether to a male or to a female.","verse":7}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Moses","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Moses::Moses::reviewed_unambiguous_name","sourceHeadwordId":"Moses"},"text":"Then the LORD said to Moses,","verse":1}],"id":"Moses","label":"Moses","matchReviews":[{"ruleId":"Moses::Moses::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Moses","term":"Moses"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Moses","sourceTitle":"Moses"},{"evidence":[{"matchingRule":"source_verified_redirect","phrase":"sin offering","senseEvidence":{"basis":"reviewed_publisher_redirect","originalCitations":[],"ruleId":"OfferingsandSacrifices::Sin Offering::reviewed_publisher_redirect","sourceHeadwordId":"SinOffering"},"text":"When the days of her purification are complete, whether for a son or for a daughter, she is to bring to the priest at the entrance to the Tent of Meeting a year-old lamb for a burnt offering and a young pigeon or a turtledove for a sin offering.","verse":6},{"matchingRule":"source_verified_redirect","phrase":"sin offering","senseEvidence":{"basis":"reviewed_publisher_redirect","originalCitations":[],"ruleId":"OfferingsandSacrifices::Sin Offering::reviewed_publisher_redirect","sourceHeadwordId":"SinOffering"},"text":"But if she cannot afford a lamb, she shall bring two turtledoves or two young pigeons, one for a burnt offering and the other for a sin offering. Then the priest will make atonement for her, and she will be clean.’”","verse":8}],"id":"OfferingsandSacrifices","label":"sin offering","matchReviews":[{"ruleId":"OfferingsandSacrifices::Sin Offering::reviewed_publisher_redirect","scope":"reviewed_publisher_redirect","senseReview":"The original publisher explicitly links this complete unambiguous name/phrase to this target. Redirect and target were reviewed once; actual BSB phrase and full word boundaries required. Target original title and complete article remain unchanged.","sourceHeadwordId":"SinOffering","term":"Sin Offering"}],"matchingRule":"source_verified_redirect","matchingRules":["source_verified_redirect"],"sourceProvenanceId":"OfferingsandSacrifices","sourceTitle":"Offerings and Sacrifices"},{"evidence":[{"matchingRule":"source_verified_redirect","phrase":"Tent of Meeting","senseEvidence":{"basis":"reviewed_publisher_redirect","originalCitations":[],"ruleId":"Tabernacle::Tent of Meeting::reviewed_publisher_redirect","sourceHeadwordId":"TentofMeeting"},"text":"When the days of her purification are complete, whether for a son or for a daughter, she is to bring to the priest at the entrance to the Tent of Meeting a year-old lamb for a burnt offering and a young pigeon or a turtledove for a sin offering.","verse":6}],"id":"Tabernacle","label":"Tent of Meeting","matchReviews":[{"ruleId":"Tabernacle::Tent of Meeting::reviewed_publisher_redirect","scope":"reviewed_publisher_redirect","senseReview":"The original publisher explicitly links this complete unambiguous name/phrase to this target. Redirect and target were reviewed once; actual BSB phrase and full word boundaries required. Target original title and complete article remain unchanged.","sourceHeadwordId":"TentofMeeting","term":"Tent of Meeting"}],"matchingRule":"source_verified_redirect","matchingRules":["source_verified_redirect"],"sourceProvenanceId":"Tabernacle","sourceTitle":"Tabernacle"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":["Clean, Unclean, and Holy"],"sourceClass":"theme-title","t":"h"},{"c":["The rites and regulations establishing cleanness and uncleanness were to distinguish Israel from the surrounding nations. To understand a rationale behind these regulations, one suggestion has been that unclean things are associated with death or the ground (see, e.g., ",{"href":"?bref=Lev.21.1","r":"Lev.21.1","rawR":"Lev.21.1","sourceRefs":[{"raw":"Lev.21.1","value":"Lev.21.1"}],"t":"ref","v":"Lev 21:1"},", ",{"href":"?bref=Lev.21.11","r":"Lev.21.11","rawR":"Lev.21.11","sourceRefs":[{"raw":"Lev.21.11","value":"Lev.21.11"}],"t":"ref","v":"11"},"; ",{"href":"?bref=Lev.22.8","r":"Lev.22.8","rawR":"Lev.22.8","sourceRefs":[{"raw":"Lev.22.8","value":"Lev.22.8"}],"t":"ref","v":"22:8"},"). Recent studies, however, suggest the principle of “normalcy.” God is a God of order. Things that are normal in God’s order are called “clean” and are “permitted.” Abnormal things would be unfit for food or offerings and would be “unclean.” A normal land animal would be a vegetarian (see ",{"href":"?bref=Gen.1.30","r":"Gen.1.30","rawR":"Gen.1.30","sourceRefs":[{"raw":"Gen.1.30","value":"Gen.1.30"}],"t":"ref","v":"Gen 1:30"},"). A normal human body would have no infections or discharges. A normal piece of cloth would have no mildew on it. If abnormalities occurred, the animal, person, or cloth was unclean."],"sourceClass":"theme-body-fl","t":"p"},{"c":["What is unclean is not sinful but represents a kind of unworthiness that cannot come in contact with what is holy (e.g., ",{"href":"?bref=Lev.11.44-45","r":"Lev.11.44-45","rawR":"Lev.11.44-45","sourceRefs":[{"raw":"Lev.11.44-45","value":"Lev.11.44-45"}],"t":"ref","v":"Lev 11:44-45"},"). If it is cleansed, it acquires the potential for holiness; it may be dedicated to God and become holy. If what is holy (such as the Sabbath) is treated like something common, God is blasphemed and the thing is profaned. If what is clean becomes unclean, it is defiled and requires cleansing. Some things, such as unclean animals, fish, or birds, remain unclean by definition and can never be cleansed, and, thus, can never become holy."],"sourceClass":"theme-body","t":"p"},{"c":["In the new covenant, things that were previously unclean have been declared clean (",{"href":"?bref=Acts.10.15","r":"Acts.10.15","rawR":"Acts.10.15","sourceRefs":[{"raw":"Acts.10.15","value":"Acts.10.15"}],"t":"ref","v":"Acts 10:15"},", ",{"href":"?bref=Acts.10.28","r":"Acts.10.28","rawR":"Acts.10.28","sourceRefs":[{"raw":"Acts.10.28","value":"Acts.10.28"}],"t":"ref","v":"28"},", ",{"href":"?bref=Acts.10.45","r":"Acts.10.45","rawR":"Acts.10.45","sourceRefs":[{"raw":"Acts.10.45","value":"Acts.10.45"}],"t":"ref","v":"45"},"). Yet God is still a God of order (",{"href":"?bref=1Cor.14.33","r":"1Cor.14.33","rawR":"1Cor.14.33","sourceRefs":[{"raw":"1Cor.14.33","value":"1Cor.14.33"}],"t":"ref","v":"1 Cor 14:33"},") and wants worship to be conducted in an orderly way (",{"href":"?bref=1Cor.14.40","r":"1Cor.14.40","rawR":"1Cor.14.40","sourceRefs":[{"raw":"1Cor.14.40","value":"1Cor.14.40"}],"t":"ref","v":"1 Cor 14:40"},"). While God’s grace is abundant to repentant sinners, some things are still repulsive to his holiness and should never be brought into his presence (e.g., Ananias and Sapphira’s offering; see ",{"href":"?bref=Acts.5.1-11","r":"Acts.5.1-11","rawR":"Acts.5.1-11","sourceRefs":[{"raw":"Acts.5.1-11","value":"Acts.5.1-11"}],"t":"ref","v":"Acts 5:1-11"},")."],"sourceClass":"theme-body","t":"p"},{"c":["Passages for Further Study"],"sourceClass":"theme-refs-title","t":"h"},{"c":[{"href":"?bref=Gen.7.2","r":"Gen.7.2","rawR":"Gen.7.2","sourceRefs":[{"raw":"Gen.7.2","value":"Gen.7.2"}],"t":"ref","v":"Gen 7:2"},"; ",{"href":"?bref=Lev.11.1-15.33","r":"Lev.11.1-15.33","rawR":"Lev.11.1-15.33","sourceRefs":[{"raw":"Lev.11.1-15.33","value":"Lev.11.1-15.33"}],"t":"ref","v":"Lev 11:1–15:33"},"; ",{"href":"?bref=Lev.21.1-23","r":"Lev.21.1-23","rawR":"Lev.21.1-23","sourceRefs":[{"raw":"Lev.21.1-23","value":"Lev.21.1-23"}],"t":"ref","v":"21:1-23"},"; ",{"href":"?bref=Lev.22.3-8","r":"Lev.22.3-8","rawR":"Lev.22.3-8","sourceRefs":[{"raw":"Lev.22.3-8","value":"Lev.22.3-8"}],"t":"ref","v":"22:3-8"},"; ",{"href":"?bref=Num.19.1-22","r":"Num.19.1-22","rawR":"Num.19.1-22","sourceRefs":[{"raw":"Num.19.1-22","value":"Num.19.1-22"}],"t":"ref","v":"Num 19:1-22"},"; ",{"href":"?bref=Deut.14.1-21","r":"Deut.14.1-21","rawR":"Deut.14.1-21","sourceRefs":[{"raw":"Deut.14.1-21","value":"Deut.14.1-21"}],"t":"ref","v":"Deut 14:1-21"},"; ",{"href":"?bref=Deut.21.1-9","r":"Deut.21.1-9","rawR":"Deut.21.1-9","sourceRefs":[{"raw":"Deut.21.1-9","value":"Deut.21.1-9"}],"t":"ref","v":"21:1-9"},"; ",{"href":"?bref=Ps.19.9","r":"Ps.19.9","rawR":"Ps.19.9","sourceRefs":[{"raw":"Ps.19.9","value":"Ps.19.9"}],"t":"ref","v":"Pss 19:9"},"; ",{"href":"?bref=Ps.24.3-4","r":"Ps.24.3-4","rawR":"Ps.24.3-4","sourceRefs":[{"raw":"Ps.24.3-4","value":"Ps.24.3-4"}],"t":"ref","v":"24:3-4"},"; ",{"href":"?bref=Ps.51.7-10","r":"Ps.51.7-10","rawR":"Ps.51.7-10","sourceRefs":[{"raw":"Ps.51.7-10","value":"Ps.51.7-10"}],"t":"ref","v":"51:7-10"},"; ",{"href":"?bref=Isa.52.11","r":"Isa.52.11","rawR":"Isa.52.11","sourceRefs":[{"raw":"Isa.52.11","value":"Isa.52.11"}],"t":"ref","v":"Isa 52:11"},"; ",{"href":"?bref=Matt.8.2-4","r":"Matt.8.2-4","rawR":"Matt.8.2-4","sourceRefs":[{"raw":"Matt.8.2-4","value":"Matt.8.2-4"}],"t":"ref","v":"Matt 8:2-4"},"; ",{"href":"?bref=John.13.10-11","r":"John.13.10-11","rawR":"John.13.10-11","sourceRefs":[{"raw":"John.13.10-11","value":"John.13.10-11"}],"t":"ref","v":"John 13:10-11"},"; ",{"href":"?bref=Acts.10.9-28","r":"Acts.10.9-28","rawR":"Acts.10.9-28","sourceRefs":[{"raw":"Acts.10.9-28","value":"Acts.10.9-28"}],"t":"ref","v":"Acts 10:9-28"},"; ",{"href":"?bref=Heb.9.13-15","r":"Heb.9.13-15","rawR":"Heb.9.13-15","sourceRefs":[{"raw":"Heb.9.13-15","value":"Heb.9.13-15"}],"t":"ref","v":"Heb 9:13-15"},", ",{"href":"?bref=Heb.9.23","r":"Heb.9.23","rawR":"Heb.9.23","sourceRefs":[{"raw":"Heb.9.23","value":"Heb.9.23"}],"t":"ref","v":"23"}],"sourceClass":"theme-refs","t":"p"}],"id":"ThemeNote:Clean-Unclean-AndHoly","refs":[{"book":"LEV","endChapter":15,"endVerse":33,"startChapter":11,"startVerse":1}],"sourceAttributes":{"name":"Clean-Unclean-AndHoly","product":"TyndaleOpenStudyNotes","typename":"ThemeNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[11,12,13,14,15],"sourceItemFragmentSha256":"75963801cf71b24fb636ae7e13200b86f13fc2fef128ef8967212adacb78406b","sourceItemName":"Clean-Unclean-AndHoly","sourceMember":"Tyndale Open Study Notes/ThemeNotes.xml","sourceOrder":28,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.11.1-15.33","sourceRelease":"1.25","sourceTitleExact":"Clean, Unclean, and Holy","supplementPointersNotIncludedAsContent":[],"title":"Clean, Unclean, and Holy","type":"ThemeNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.12.1-8","r":"Lev.12.1-8","rawR":"Lev.12.1-8","sourceRefs":[{"raw":"Lev.12.1-8","value":"Lev.12.1-8"}],"t":"ref","v":"12:1-8"}],"sourceClass":"sn-ref","t":"span"}," These verses detail the regulations pertaining to childbirth. Any bodily discharge, even blood, was considered “abnormal” because it reduced the vitality of the individual and rendered the person ceremonially unclean (see study notes on ",{"href":"?item=Lev.5.3_StudyNote_Filament","id":"Lev.5.3_StudyNote_Filament","rawId":"Lev.5.3_StudyNote_Filament","t":"link","v":"5:3"},"; ",{"href":"?item=Lev.11.1-15.33_StudyNote_Filament","id":"Lev.11.1-15.33_StudyNote_Filament","rawId":"Lev.11.1-15.33_StudyNote_Filament","t":"link","v":"11:1–15:33"},"). Accordingly, not childbirth but the discharge accompanying it is addressed in these verses (",{"href":"?bref=Lev.12.2","r":"Lev.12.2","rawR":"Lev.12.2","sourceRefs":[{"raw":"Lev.12.2","value":"Lev.12.2"}],"t":"ref","v":"12:2"},", ",{"href":"?bref=Lev.12.5","r":"Lev.12.5","rawR":"Lev.12.5","sourceRefs":[{"raw":"Lev.12.5","value":"Lev.12.5"}],"t":"ref","v":"5"},", ",{"href":"?bref=Lev.12.7","r":"Lev.12.7","rawR":"Lev.12.7","sourceRefs":[{"raw":"Lev.12.7","value":"Lev.12.7"}],"t":"ref","v":"7"},"). The uncleanness was not sinful in itself, but only if it was neglected and allowed to come into contact with what is holy (see ",{"href":"?bref=Lev.5.2-3","r":"Lev.5.2-3","rawR":"Lev.5.2-3","sourceRefs":[{"raw":"Lev.5.2-3","value":"Lev.5.2-3"}],"t":"ref","v":"5:2-3"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.12.1-8","refs":[{"book":"LEV","endChapter":12,"endVerse":8,"startChapter":12,"startVerse":1}],"sourceAttributes":{"name":"Lev.12.1-8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[12],"sourceItemFragmentSha256":"bcb35469f038b77b768bf47165854f12ca4c17a181b54415010971c40a038a0a","sourceItemName":"Lev.12.1-8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1382,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.12.1-8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.12.1-8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.12.2","r":"Lev.12.2","rawR":"Lev.12.2","sourceRefs":[{"raw":"Lev.12.2","value":"Lev.12.2"}],"t":"ref","v":"12:2"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["menstrual period:"],"sourceClass":"sn-excerpt","t":"span"}," See ",{"href":"?bref=Lev.15.19-24","r":"Lev.15.19-24","rawR":"Lev.15.19-24","sourceRefs":[{"raw":"Lev.15.19-24","value":"Lev.15.19-24"}],"t":"ref","v":"15:19-24"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.12.2","refs":[{"book":"LEV","endChapter":12,"endVerse":2,"startChapter":12,"startVerse":2}],"sourceAttributes":{"name":"Lev.12.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[12],"sourceItemFragmentSha256":"0e30d9acec67d705bd38df17b906dccc241a9bcc56c031abd88a059c53bd436f","sourceItemName":"Lev.12.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1383,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.12.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.12.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.12.3","r":"Lev.12.3","rawR":"Lev.12.3","sourceRefs":[{"raw":"Lev.12.3","value":"Lev.12.3"}],"t":"ref","v":"12:3"}],"sourceClass":"sn-ref","t":"span"}," By the ",{"c":["eighth day"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," a baby’s system has developed to a point where the blood can clot properly, rendering circumcision relatively safe."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.12.3","refs":[{"book":"LEV","endChapter":12,"endVerse":3,"startChapter":12,"startVerse":3}],"sourceAttributes":{"name":"Lev.12.3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[12],"sourceItemFragmentSha256":"8c991a80cefb234896a889cb17937940757f43457cc5f3258058fea78425bef7","sourceItemName":"Lev.12.3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1384,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.12.3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.12.3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.12.4","r":"Lev.12.4","rawR":"Lev.12.4","sourceRefs":[{"raw":"Lev.12.4","value":"Lev.12.4"}],"t":"ref","v":"12:4"}],"sourceClass":"sn-ref","t":"span"}," These ",{"c":["thirty-three days"],"sourceClass":"sn-excerpt","t":"span"}," are added to the seven previous days (",{"href":"?bref=Lev.12.2","r":"Lev.12.2","rawR":"Lev.12.2","sourceRefs":[{"raw":"Lev.12.2","value":"Lev.12.2"}],"t":"ref","v":"12:2"},", ",{"href":"?bref=Lev.12.3","r":"Lev.12.3","rawR":"Lev.12.3","sourceRefs":[{"raw":"Lev.12.3","value":"Lev.12.3"}],"t":"ref","v":"3"},") to yield a total of forty days to complete the mother’s period of purification."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.12.4","refs":[{"book":"LEV","endChapter":12,"endVerse":4,"startChapter":12,"startVerse":4}],"sourceAttributes":{"name":"Lev.12.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[12],"sourceItemFragmentSha256":"75041dcf83d933f944877d5c927679e152bafc0fc9fac5bcb6520323bccbc204","sourceItemName":"Lev.12.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1385,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.12.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.12.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.12.5","r":"Lev.12.5","rawR":"Lev.12.5","sourceRefs":[{"raw":"Lev.12.5","value":"Lev.12.5"}],"t":"ref","v":"12:5"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["two weeks . . . sixty-six days:"],"sourceClass":"sn-excerpt","t":"span"}," The total is eighty days, double the time required for the birth of a son (see also ",{"href":"?bref=Lev.27.2-7","r":"Lev.27.2-7","rawR":"Lev.27.2-7","sourceRefs":[{"raw":"Lev.27.2-7","value":"Lev.27.2-7"}],"t":"ref","v":"27:2-7"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.12.5","refs":[{"book":"LEV","endChapter":12,"endVerse":5,"startChapter":12,"startVerse":5}],"sourceAttributes":{"name":"Lev.12.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[12],"sourceItemFragmentSha256":"deb08394d8bd11292ee3af09944101a14a94f86ebb75bfab8ad43cc617fd4e15","sourceItemName":"Lev.12.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1386,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.12.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.12.5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.12.6","r":"Lev.12.6","rawR":"Lev.12.6","sourceRefs":[{"raw":"Lev.12.6","value":"Lev.12.6"}],"t":"ref","v":"12:6"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["purification offering:"],"sourceClass":"sn-excerpt","t":"span"}," The Hebrew word is the same as that for the sin offering (",{"c":["khatta’t"],"sourceClass":"hebrew","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," see ",{"href":"?item=Lev.4.1-5.13_StudyNote_Filament","id":"Lev.4.1-5.13_StudyNote_Filament","rawId":"Lev.4.1-5.13_StudyNote_Filament","t":"link","v":"study note on 4:1–5:13"},"). This leads some scholars to think that this offering dealt only with purification or decontamination, including those cases mentioned in ",{"href":"?bref=Lev.5.1-6","r":"Lev.5.1-6","rawR":"Lev.5.1-6","sourceRefs":[{"raw":"Lev.5.1-6","value":"Lev.5.1-6"}],"t":"ref","v":"5:1-6"},". The offering here was certainly part of a purification ritual, but it seems more likely that the sin offering repaired a lack or failure. In this context, the issue is purity rather than sin, and the focus is on restoring the woman to community fellowship, not forgiving a sinner."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.12.6","refs":[{"book":"LEV","endChapter":12,"endVerse":6,"startChapter":12,"startVerse":6}],"sourceAttributes":{"name":"Lev.12.6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[12],"sourceItemFragmentSha256":"0c39471d57158cc1886854108190fc70712407c76a1cda13ef21017796e2757a","sourceItemName":"Lev.12.6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1387,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.12.6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.12.6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.12.7","r":"Lev.12.7","rawR":"Lev.12.7","sourceRefs":[{"raw":"Lev.12.7","value":"Lev.12.7"}],"t":"ref","v":"12:7"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["to purify her:"],"sourceClass":"sn-excerpt","t":"span"}," “Atonement” can be understood in this context to stress ceremonial cleansing and reconciliation of the worshiper (see ",{"href":"?bref=Lev.4.20","r":"Lev.4.20","rawR":"Lev.4.20","sourceRefs":[{"raw":"Lev.4.20","value":"Lev.4.20"}],"t":"ref","v":"4:20"},"; see also ",{"href":"?item=Lev.1.4_StudyNote_Filament","id":"Lev.1.4_StudyNote_Filament","rawId":"Lev.1.4_StudyNote_Filament","t":"link","v":"study note on 1:4"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.12.7","refs":[{"book":"LEV","endChapter":12,"endVerse":7,"startChapter":12,"startVerse":7}],"sourceAttributes":{"name":"Lev.12.7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[12],"sourceItemFragmentSha256":"654c78aef097618fdc78c4c2574af265469291f4da8fb5e024b4d2d00aef80eb","sourceItemName":"Lev.12.7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1388,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.12.7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.12.7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.12.8","r":"Lev.12.8","rawR":"Lev.12.8","sourceRefs":[{"raw":"Lev.12.8","value":"Lev.12.8"}],"t":"ref","v":"12:8"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["cannot afford to bring a lamb:"],"sourceClass":"sn-excerpt","t":"span"}," The alternative offering provided for the poorer class of society (see ",{"href":"?bref=Lev.5.7-13","r":"Lev.5.7-13","rawR":"Lev.5.7-13","sourceRefs":[{"raw":"Lev.5.7-13","value":"Lev.5.7-13"}],"t":"ref","v":"5:7-13"},"; cp. ",{"href":"?bref=Luke.2.22-24","r":"Luke.2.22-24","rawR":"Luke.2.22-24","sourceRefs":[{"raw":"Luke.2.22-24","value":"Luke.2.22-24"}],"t":"ref","v":"Luke 2:22-24"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.12.8","refs":[{"book":"LEV","endChapter":12,"endVerse":8,"startChapter":12,"startVerse":8}],"sourceAttributes":{"name":"Lev.12.8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[12],"sourceItemFragmentSha256":"19042a9e9a043b72119b6b2828bcc167761c7d8ef8ce55d9b198746bbec3b1d6","sourceItemName":"Lev.12.8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1389,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.12.8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.12.8","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}