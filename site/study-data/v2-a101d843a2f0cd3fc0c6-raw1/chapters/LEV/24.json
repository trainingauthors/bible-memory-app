7474dfdb93b77f98c93d99e4ce0612.json","title":"Plants"},"Shelomith":{"file":"dictionary/9a26b8cadd2cdff20403fe7c0b67c1a295616a14d2c98436b4b5bf0d31e460ab.json","title":"Shelomith"},"Tabernacle":{"file":"dictionary/34bcab8037ed24a7e58e5513cae53aa2fe13d14876c4a62817a0f8d23d0fb982.json","title":"Tabernacle"}},"dictionaryRelated":[{"id":"Blasphemy","title":"Blasphemy"},{"id":"BreadofthePresence","title":"Bread of the Presence"},{"id":"CourtsandTrials","title":"Courts and Trials"},{"id":"CriminalLawandPunishment","title":"Criminal Law and Punishment*"},{"id":"CurseCursed","title":"Curse, Cursed"},{"id":"DanTribeof","title":"Dan, Tribe of"},{"id":"DeuteronomyBookof","title":"Deuteronomy, Book of"},{"id":"FeastsandFestivalsofIsrael","title":"Feasts and Festivals of Israel"},{"id":"Foreigner","title":"Foreigner"},{"id":"Frankincense","title":"Frankincense"},{"id":"GodNamesof","title":"God, Names of"},{"id":"Incense","title":"Incense"},{"id":"IsraelHistoryof","title":"Israel, History of"},{"id":"LawBiblicalConceptof","title":"Law, Biblical Concept of"},{"id":"LeviticusBookof","title":"Leviticus, Book of"},{"id":"Naboth","title":"Naboth"},{"id":"Neighbor","title":"Neighbor"},{"id":"Oil","title":"Oil"},{"id":"Plants","title":"Plants"},{"id":"Shelomith","title":"Shelomith"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Aaron","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Aaron::Aaron::reviewed_unambiguous_name","sourceHeadwordId":"Aaron"},"text":"Outside the veil of the Testimony in the Tent of Meeting, Aaron is to tend the lamps continually before the LORD from evening until morning. This is to be a permanent statute for the generations to come.","verse":3},{"matchingRule":"reviewed_exact_headword","phrase":"Aaron","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Aaron::Aaron::reviewed_unambiguous_name","sourceHeadwordId":"Aaron"},"text":"It belongs to Aaron and his sons, who are to eat it in a holy place; for it is to him a most holy part of the food offerings to the LORD—his portion forever.”","verse":9}],"id":"Aaron","label":"Aaron","matchReviews":[{"ruleId":"Aaron::Aaron::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Aaron","term":"Aaron"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Aaron","sourceTitle":"Aaron"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Dibri","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":0,"href":"?bref=Lev.24.10-11","rawReference":"Lev.24.10-11"}],"ruleId":"Dibri::Dibri::source_verse_citation","sourceHeadwordId":"Dibri"},"text":"The son of the Israelite woman blasphemed the Name with a curse. So they brought him to Moses. (His mother’s name was Shelomith daughter of Dibri, of the tribe of Dan.)","verse":11}],"id":"Dibri","label":"Dibri","matchReviews":[{"ruleId":"Dibri::Dibri::source_verse_citation","scope":"source_verse_citation","senseReview":"Original complete headword and source opening identify a named person, people, or place. Promotion requires a capitalized whole name and the original article explicitly citing this same BSB verse. No arbitrary qualifier stripping or book-title inference. This citation-constrained rule was reviewed once globally; unmatched contexts remain excluded.","sourceHeadwordId":"Dibri","term":"Dibri"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Dibri","sourceTitle":"Dibri"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Then the LORD said to Moses,","verse":1},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Outside the veil of the Testimony in the Tent of Meeting, Aaron is to tend the lamps continually before the LORD from evening until morning. This is to be a permanent statute for the generations to come.","verse":3},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"He shall tend the lamps on the pure gold lampstand before the LORD continually.","verse":4},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"and set them in two rows—six per row—on the table of pure gold before the LORD.","verse":6},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"And you are to place pure frankincense near each row, so that it may serve as a memorial portion for the bread, a food offering to the LORD.","verse":7},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Every Sabbath day the bread is to be set out before the LORD on behalf of the Israelites as a permanent covenant.","verse":8},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"It belongs to Aaron and his sons, who are to eat it in a holy place; for it is to him a most holy part of the food offerings to the LORD—his portion forever.”","verse":9},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"They placed him in custody until the will of the LORD should be made clear to them.","verse":12},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Then the LORD said to Moses,","verse":13},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Whoever blasphemes the name of the LORD must surely be put to death; the whole assembly must surely stone him, whether he is a foreign resident or native; if he blasphemes the Name, he must be put to death.","verse":16},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"You are to have the same standard of law for the foreign resident and the native; for I am the LORD your God.’”","verse":22},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Then Moses spoke to the Israelites, and they took the blasphemer outside the camp and stoned him. So the Israelites did as the LORD had commanded Moses.","verse":23}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Moses","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Moses::Moses::reviewed_unambiguous_name","sourceHeadwordId":"Moses"},"text":"Then the LORD said to Moses,","verse":1},{"matchingRule":"reviewed_exact_headword","phrase":"Moses","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Moses::Moses::reviewed_unambiguous_name","sourceHeadwordId":"Moses"},"text":"The son of the Israelite woman blasphemed the Name with a curse. So they brought him to Moses. (His mother’s name was Shelomith daughter of Dibri, of the tribe of Dan.)","verse":11},{"matchingRule":"reviewed_exact_headword","phrase":"Moses","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Moses::Moses::reviewed_unambiguous_name","sourceHeadwordId":"Moses"},"text":"Then the LORD said to Moses,","verse":13},{"matchingRule":"reviewed_exact_headword","phrase":"Moses","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[],"ruleId":"Moses::Moses::reviewed_unambiguous_name","sourceHeadwordId":"Moses"},"text":"Then Moses spoke to the Israelites, and they took the blasphemer outside the camp and stoned him. So the Israelites did as the LORD had commanded Moses.","verse":23}],"id":"Moses","label":"Moses","matchReviews":[{"ruleId":"Moses::Moses::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Moses","term":"Moses"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Moses","sourceTitle":"Moses"},{"evidence":[{"matchingRule":"source_verified_redirect","phrase":"Tent of Meeting","senseEvidence":{"basis":"reviewed_publisher_redirect","originalCitations":[],"ruleId":"Tabernacle::Tent of Meeting::reviewed_publisher_redirect","sourceHeadwordId":"TentofMeeting"},"text":"Outside the veil of the Testimony in the Tent of Meeting, Aaron is to tend the lamps continually before the LORD from evening until morning. This is to be a permanent statute for the generations to come.","verse":3}],"id":"Tabernacle","label":"Tent of Meeting","matchReviews":[{"ruleId":"Tabernacle::Tent of Meeting::reviewed_publisher_redirect","scope":"reviewed_publisher_redirect","senseReview":"The original publisher explicitly links this complete unambiguous name/phrase to this target. Redirect and target were reviewed once; actual BSB phrase and full word boundaries required. Target original title and complete article remain unchanged.","sourceHeadwordId":"TentofMeeting","term":"Tent of Meeting"}],"matchingRule":"source_verified_redirect","matchingRules":["source_verified_redirect"],"sourceProvenanceId":"Tabernacle","sourceTitle":"Tabernacle"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.24.5","r":"Lev.24.5","rawR":"Lev.24.5","sourceRefs":[{"raw":"Lev.24.5","value":"Lev.24.5"}],"t":"ref","v":"24:5"}],"sourceClass":"sn-ref","t":"span"}," Traditionally called the “shewbread” (",{"c":["kjv"],"sourceClass":"sc","t":"span"},"), ",{"c":["twelve flat loaves"],"sourceClass":"sn-excerpt","t":"span"}," (see ",{"href":"?bref=Exod.25.30","r":"Exod.25.30","rawR":"Exod.25.30","sourceRefs":[{"raw":"Exod.25.30","value":"Exod.25.30"}],"t":"ref","v":"Exod 25:30"},") of this bread, the “Bread of the Presence,” were to be placed on the table in the Holy Place each Sabbath (",{"href":"?bref=Exod.25.23-30","r":"Exod.25.23-30","rawR":"Exod.25.23-30","sourceRefs":[{"raw":"Exod.25.23-30","value":"Exod.25.23-30"}],"t":"ref","v":"Exod 25:23-30"},"). This bread was considered part of the priest’s portion of the offerings. David and his men ate this bread while fleeing from Saul (",{"href":"?bref=1Sam.21.1-6","r":"1Sam.21.1-6","rawR":"1Sam.21.1-6","sourceRefs":[{"raw":"1Sam.21.1-6","value":"1Sam.21.1-6"}],"t":"ref","v":"1 Sam 21:1-6"},"; see ",{"href":"?bref=Matt.12.1-8","r":"Matt.12.1-8","rawR":"Matt.12.1-8","sourceRefs":[{"raw":"Matt.12.1-8","value":"Matt.12.1-8"}],"t":"ref","v":"Matt 12:1-8"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.24.5","refs":[{"book":"LEV","endChapter":24,"endVerse":5,"startChapter":24,"startVerse":5}],"sourceAttributes":{"name":"Lev.24.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[24],"sourceItemFragmentSha256":"d2373b350061141b2a0c7f568cae616b3899e93179ecf504efedabefe444cb2f","sourceItemName":"Lev.24.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1530,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.24.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.24.5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.24.7","r":"Lev.24.7","rawR":"Lev.24.7","sourceRefs":[{"raw":"Lev.24.7","value":"Lev.24.7"}],"t":"ref","v":"24:7"}],"sourceClass":"sn-ref","t":"span"}," Since a portion of this bread was to be burned as ",{"c":["a representative offering"],"sourceClass":"sn-excerpt","t":"span"}," (see ",{"href":"?bref=Lev.2.2","r":"Lev.2.2","rawR":"Lev.2.2","sourceRefs":[{"raw":"Lev.2.2","value":"Lev.2.2"}],"t":"ref","v":"2:2"},"), it would have been made without yeast (that is, unleavened; see ",{"href":"?bref=Lev.2.11","r":"Lev.2.11","rawR":"Lev.2.11","sourceRefs":[{"raw":"Lev.2.11","value":"Lev.2.11"}],"t":"ref","v":"2:11"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.24.7","refs":[{"book":"LEV","endChapter":24,"endVerse":7,"startChapter":24,"startVerse":7}],"sourceAttributes":{"name":"Lev.24.7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[24],"sourceItemFragmentSha256":"aea55b1605a7c504a3ddc7e9c00579be5c477e08e333aa87a513b061f36758bb","sourceItemName":"Lev.24.7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1531,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.24.7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.24.7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.24.10-23","r":"Lev.24.10-23","rawR":"Lev.24.10-23","sourceRefs":[{"raw":"Lev.24.10-23","value":"Lev.24.10-23"}],"t":"ref","v":"24:10-23"}],"sourceClass":"sn-ref","t":"span"}," A large body of non-Israelites, including other Semitic people as well as Egyptians, came out of Egypt with Israel (",{"href":"?bref=Exod.12.38","r":"Exod.12.38","rawR":"Exod.12.38","sourceRefs":[{"raw":"Exod.12.38","value":"Exod.12.38"}],"t":"ref","v":"Exod 12:38"},"). Among them was a man of mixed parentage, whose mother was an Israelite and whose father was an Egyptian. A quarrel broke out between the man and a full-blooded Israelite. In the altercation, the man who was half-Egyptian verbally cursed the Israelite, using the name of God in an irreverent manner."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.24.10-23","refs":[{"book":"LEV","endChapter":24,"endVerse":23,"startChapter":24,"startVerse":10}],"sourceAttributes":{"name":"Lev.24.10-23","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[24],"sourceItemFragmentSha256":"553502c84d0007cfab8348489770fe0f092f64e8026f552e123de98306c635ed","sourceItemName":"Lev.24.10-23","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1532,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.24.10-23","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.24.10-23","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.24.11","r":"Lev.24.11","rawR":"Lev.24.11","sourceRefs":[{"raw":"Lev.24.11","value":"Lev.24.11"}],"t":"ref","v":"24:11"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["blasphemed . . . with a curse"],"sourceClass":"sn-excerpt","t":"span"}," In biblical times, a name was more than a means of identification; it represented a person’s character, reputation, and origin. God is holy, and he was to be regarded as holy in all of Israel’s life (see ",{"href":"?bref=Lev.10.3","r":"Lev.10.3","rawR":"Lev.10.3","sourceRefs":[{"raw":"Lev.10.3","value":"Lev.10.3"}],"t":"ref","v":"10:3"},"). The Israelites had been instructed to treat God’s name with reverence (",{"href":"?bref=Exod.20.7","r":"Exod.20.7","rawR":"Exod.20.7","sourceRefs":[{"raw":"Exod.20.7","value":"Exod.20.7"}],"t":"ref","v":"Exod 20:7"},"). Using his name in a curse reflected a sinful attitude toward God himself (",{"href":"?bref=Lev.24.15","r":"Lev.24.15","rawR":"Lev.24.15","sourceRefs":[{"raw":"Lev.24.15","value":"Lev.24.15"}],"t":"ref","v":"Lev 24:15"},"), and it deserved death (",{"href":"?bref=Lev.24.13-16","r":"Lev.24.13-16","rawR":"Lev.24.13-16","sourceRefs":[{"raw":"Lev.24.13-16","value":"Lev.24.13-16"}],"t":"ref","v":"24:13-16"},"). The wording in the Hebrew text is very strong: Two verbs meaning “curse” are used, one that indicated a more formal type of curse, the other a blasphemous or irreverent expression. The two terms are synonymous in ",{"href":"?bref=Lev.24.15-16","r":"Lev.24.15-16","rawR":"Lev.24.15-16","sourceRefs":[{"raw":"Lev.24.15-16","value":"Lev.24.15-16"}],"t":"ref","v":"24:15-16"},". • ",{"c":["the Name of the"],"sourceClass":"sn-excerpt","t":"span"}," ",{"c":["Lord"],"sourceClass":"sn-excerpt-divine-name","t":"span"},": The Hebrew text refers simply to “the Name” to reflect care and reverence for God’s name."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.24.11","refs":[{"book":"LEV","endChapter":24,"endVerse":11,"startChapter":24,"startVerse":11}],"sourceAttributes":{"name":"Lev.24.11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[24],"sourceItemFragmentSha256":"9033a2e57f2e696224622eb6dfd365d335beae2198600cc8b66bb02794534196","sourceItemName":"Lev.24.11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1533,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.24.11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.24.11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.24.14","r":"Lev.24.14","rawR":"Lev.24.14","sourceRefs":[{"raw":"Lev.24.14","value":"Lev.24.14"}],"t":"ref","v":"24:14"}],"sourceClass":"sn-ref","t":"span"}," Those who heard a ",{"c":["blasphemer"],"sourceClass":"sn-excerpt","t":"span"}," curse were to ",{"c":["lay their hands on his head"],"sourceClass":"sn-excerpt","t":"span"},". This indicated their own innocence by symbolically transferring the guilt (see ",{"href":"?bref=Lev.16.21","r":"Lev.16.21","rawR":"Lev.16.21","sourceRefs":[{"raw":"Lev.16.21","value":"Lev.16.21"}],"t":"ref","v":"16:21"},"), as well as their willingness to accept responsibility for the blasphemer’s death. A single witness was not enough to cause a man to die (see ",{"href":"?bref=Num.35.30","r":"Num.35.30","rawR":"Num.35.30","sourceRefs":[{"raw":"Num.35.30","value":"Num.35.30"}],"t":"ref","v":"Num 35:30"},"; ",{"href":"?bref=Deut.17.2-7","r":"Deut.17.2-7","rawR":"Deut.17.2-7","sourceRefs":[{"raw":"Deut.17.2-7","value":"Deut.17.2-7"}],"t":"ref","v":"Deut 17:2-7"},"; ",{"href":"?bref=Matt.18.16","r":"Matt.18.16","rawR":"Matt.18.16","sourceRefs":[{"raw":"Matt.18.16","value":"Matt.18.16"}],"t":"ref","v":"Matt 18:16"},"; ",{"href":"?bref=2Cor.13.1","r":"2Cor.13.1","rawR":"2Cor.13.1","sourceRefs":[{"raw":"2Cor.13.1","value":"2Cor.13.1"}],"t":"ref","v":"2 Cor 13:1"},"; ",{"href":"?bref=1Tim.5.19","r":"1Tim.5.19","rawR":"1Tim.5.19","sourceRefs":[{"raw":"1Tim.5.19","value":"1Tim.5.19"}],"t":"ref","v":"1 Tim 5:19"},"; ",{"href":"?bref=Heb.10.28","r":"Heb.10.28","rawR":"Heb.10.28","sourceRefs":[{"raw":"Heb.10.28","value":"Heb.10.28"}],"t":"ref","v":"Heb 10:28"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.24.14","refs":[{"book":"LEV","endChapter":24,"endVerse":14,"startChapter":24,"startVerse":14}],"sourceAttributes":{"name":"Lev.24.14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[24],"sourceItemFragmentSha256":"893e04a8d2002ea1ff4ef0620f12e5bb5c50970b8132e12043dbf9e9987662e1","sourceItemName":"Lev.24.14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1534,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.24.14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.24.14","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.24.17","r":"Lev.24.17","rawR":"Lev.24.17","sourceRefs":[{"raw":"Lev.24.17","value":"Lev.24.17"}],"t":"ref","v":"24:17"}],"sourceClass":"sn-ref","t":"span"}," Because human life was patterned after the life of God himself (",{"href":"?bref=Gen.1.26","r":"Gen.1.26","rawR":"Gen.1.26","sourceRefs":[{"raw":"Gen.1.26","value":"Gen.1.26"}],"t":"ref","v":"Gen 1:26"},", ",{"href":"?bref=Gen.1.27","r":"Gen.1.27","rawR":"Gen.1.27","sourceRefs":[{"raw":"Gen.1.27","value":"Gen.1.27"}],"t":"ref","v":"27"},"), murder was a blasphemous act. It required the same penalty as oral blasphemy (",{"href":"?bref=Gen.9.6","r":"Gen.9.6","rawR":"Gen.9.6","sourceRefs":[{"raw":"Gen.9.6","value":"Gen.9.6"}],"t":"ref","v":"Gen 9:6"},"). For a similar law and its qualifiers, see ",{"href":"?bref=Exod.21.12-14","r":"Exod.21.12-14","rawR":"Exod.21.12-14","sourceRefs":[{"raw":"Exod.21.12-14","value":"Exod.21.12-14"}],"t":"ref","v":"Exod 21:12-14"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.24.17","refs":[{"book":"LEV","endChapter":24,"endVerse":17,"startChapter":24,"startVerse":17}],"sourceAttributes":{"name":"Lev.24.17","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[24],"sourceItemFragmentSha256":"58c181d4962d8ed9a4acda8144966cc0ebd86d3bbf216dd4bdf46ffdf7978a55","sourceItemName":"Lev.24.17","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1535,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.24.17","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.24.17","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.24.20","r":"Lev.24.20","rawR":"Lev.24.20","sourceRefs":[{"raw":"Lev.24.20","value":"Lev.24.20"}],"t":"ref","v":"24:20"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["eye for an eye:"],"sourceClass":"sn-excerpt","t":"span"}," The legal principle involved is often called ",{"c":["lex talionis"],"sourceClass":"ital","t":"span"}," (“law of retaliation”), which is that the penalty must fit the crime. When an injured party sought revenge on behalf of their kinsman (see ",{"href":"?bref=Num.35.19-21","r":"Num.35.19-21","rawR":"Num.35.19-21","sourceRefs":[{"raw":"Num.35.19-21","value":"Num.35.19-21"}],"t":"ref","v":"Num 35:19-21"},"), excessive revenge naturally ensued instead of appropriate justice. This provoked even greater retaliation, resulting in a cycle of increasing violence. ",{"c":["Lex talionis"],"sourceClass":"ital","t":"span"}," served to regulate the prosecution of crimes (see also ",{"href":"?bref=Lev.6.2-7","r":"Lev.6.2-7","rawR":"Lev.6.2-7","sourceRefs":[{"raw":"Lev.6.2-7","value":"Lev.6.2-7"}],"t":"ref","v":"Lev 6:2-7"},"; cp. ",{"href":"?bref=Exod.21.24","r":"Exod.21.24","rawR":"Exod.21.24","sourceRefs":[{"raw":"Exod.21.24","value":"Exod.21.24"}],"t":"ref","v":"Exod 21:24"},"; ",{"href":"?bref=Lev.24.20","r":"Lev.24.20","rawR":"Lev.24.20","sourceRefs":[{"raw":"Lev.24.20","value":"Lev.24.20"}],"t":"ref","v":"Lev 24:20"},"; ",{"href":"?bref=Deut.19.21","r":"Deut.19.21","rawR":"Deut.19.21","sourceRefs":[{"raw":"Deut.19.21","value":"Deut.19.21"}],"t":"ref","v":"Deut 19:21"},"; ",{"href":"?bref=Matt.5.28-39","r":"Matt.5.28-39","rawR":"Matt.5.28-39","sourceRefs":[{"raw":"Matt.5.28-39","value":"Matt.5.28-39"}],"t":"ref","v":"Matt 5:28-39"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.24.20","refs":[{"book":"LEV","endChapter":24,"endVerse":20,"startChapter":24,"startVerse":20}],"sourceAttributes":{"name":"Lev.24.20","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[24],"sourceItemFragmentSha256":"6d7fe4470754c8ca7be8c2de29249d7a20ce0ee03926d3abdbe1e891172e8897","sourceItemName":"Lev.24.20","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1536,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.24.20","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.24.20","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.24.22","r":"Lev.24.22","rawR":"Lev.24.22","sourceRefs":[{"raw":"Lev.24.22","value":"Lev.24.22"}],"t":"ref","v":"24:22"}],"sourceClass":"sn-ref","t":"span"}," Although ",{"c":["foreigners"],"sourceClass":"sn-excerpt","t":"span"}," were not citizens, they were human beings entitled to equal justice under the law (see ",{"href":"?bref=Lev.16.29","r":"Lev.16.29","rawR":"Lev.16.29","sourceRefs":[{"raw":"Lev.16.29","value":"Lev.16.29"}],"t":"ref","v":"16:29"},", ",{"href":"?bref=Lev.16.31","r":"Lev.16.31","rawR":"Lev.16.31","sourceRefs":[{"raw":"Lev.16.31","value":"Lev.16.31"}],"t":"ref","v":"31"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.24.22","refs":[{"book":"LEV","endChapter":24,"endVerse":22,"startChapter":24,"startVerse":22}],"sourceAttributes":{"name":"Lev.24.22","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[24],"sourceItemFragmentSha256":"84b57f6ec64f5997b1f18f1e3e1e148160efc6871f11bc0797803a9d782b6e71","sourceItemName":"Lev.24.22","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1537,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.24.22","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.24.22","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}