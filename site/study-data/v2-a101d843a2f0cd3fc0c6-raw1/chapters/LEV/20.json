ceRefs":[{"raw":"John.8.1-11","value":"John.8.1-11"}],"t":"ref","v":"John 8:1-11"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.20.2","refs":[{"book":"LEV","endChapter":20,"endVerse":2,"startChapter":20,"startVerse":2}],"sourceAttributes":{"name":"Lev.20.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[20],"sourceItemFragmentSha256":"6ec26b47c8ef9823e29962f8e254a2b6df10486d4630f52c56acf7a3c68d40d2","sourceItemName":"Lev.20.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1489,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.20.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.20.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.20.9-27","r":"Lev.20.9-27","rawR":"Lev.20.9-27","sourceRefs":[{"raw":"Lev.20.9-27","value":"Lev.20.9-27"}],"t":"ref","v":"20:9-27"}],"sourceClass":"sn-ref","t":"span"}," Because pagan worship affected ethics, the regulations for families follow immediately after those dealing with pagan religious practices. To some extent, the laws of this section replicate those of ",{"href":"?bref=Lev.18.6-30","r":"Lev.18.6-30","rawR":"Lev.18.6-30","sourceRefs":[{"raw":"Lev.18.6-30","value":"Lev.18.6-30"}],"t":"ref","v":"18:6-30"},", which precede the section dealing with proper expressions of holiness (",{"href":"?bref=Lev.19.1-37","r":"Lev.19.1-37","rawR":"Lev.19.1-37","sourceRefs":[{"raw":"Lev.19.1-37","value":"Lev.19.1-37"}],"t":"ref","v":"19:1-37"},"). These were all related issues, as the proper worship of God led to proper conduct toward other people, while improper worship of God led to moral violations."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.20.9-27","refs":[{"book":"LEV","endChapter":20,"endVerse":27,"startChapter":20,"startVerse":9}],"sourceAttributes":{"name":"Lev.20.9-27","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[20],"sourceItemFragmentSha256":"3b39d50ba811b907c123c4eb91c91afa4bc934b1b03f1569ef057b8d5384a037","sourceItemName":"Lev.20.9-27","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1490,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.20.9-27","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.20.9-27","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.20.9","r":"Lev.20.9","rawR":"Lev.20.9","sourceRefs":[{"raw":"Lev.20.9","value":"Lev.20.9"}],"t":"ref","v":"20:9"}],"sourceClass":"sn-ref","t":"span"}," The Hebrew word for ",{"c":["dishonors"],"sourceClass":"sn-excerpt","t":"span"}," means “to make light of, treat with contempt,” and is traditionally translated “curse,” in the sense of calling someone a vulgar or profane name. Parental authority was given by God, not chosen by the child (see ",{"href":"?bref=Exod.20.12","r":"Exod.20.12","rawR":"Exod.20.12","sourceRefs":[{"raw":"Exod.20.12","value":"Exod.20.12"}],"t":"ref","v":"Exod 20:12"},"; ",{"href":"?bref=Deut.21.18-21","r":"Deut.21.18-21","rawR":"Deut.21.18-21","sourceRefs":[{"raw":"Deut.21.18-21","value":"Deut.21.18-21"}],"t":"ref","v":"Deut 21:18-21"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.20.9","refs":[{"book":"LEV","endChapter":20,"endVerse":9,"startChapter":20,"startVerse":9}],"sourceAttributes":{"name":"Lev.20.9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[20],"sourceItemFragmentSha256":"42a99653a35e787c277c1715e9d9eae66753c9c059fe063d1ca2b1390aadefb7","sourceItemName":"Lev.20.9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1491,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.20.9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.20.9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.20.10","r":"Lev.20.10","rawR":"Lev.20.10","sourceRefs":[{"raw":"Lev.20.10","value":"Lev.20.10"}],"t":"ref","v":"20:10"}],"sourceClass":"sn-ref","t":"span"}," See ",{"href":"?item=Lev.18.20_StudyNote_Filament","id":"Lev.18.20_StudyNote_Filament","rawId":"Lev.18.20_StudyNote_Filament","t":"link","v":"study note on 18:20"},"; see also ",{"href":"?bref=Exod.20.14","r":"Exod.20.14","rawR":"Exod.20.14","sourceRefs":[{"raw":"Exod.20.14","value":"Exod.20.14"}],"t":"ref","v":"Exod 20:14"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.20.10","refs":[{"book":"LEV","endChapter":20,"endVerse":10,"startChapter":20,"startVerse":10}],"sourceAttributes":{"name":"Lev.20.10","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[20],"sourceItemFragmentSha256":"6a71b5be82c5dc6692d9ffce5a29f8baaa8113f49a19a5beee4be523dcc908cb","sourceItemName":"Lev.20.10","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1492,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.20.10","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.20.10","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.20.11","r":"Lev.20.11","rawR":"Lev.20.11","sourceRefs":[{"raw":"Lev.20.11","value":"Lev.20.11"}],"t":"ref","v":"20:11"}],"sourceClass":"sn-ref","t":"span"}," See ",{"href":"?item=Lev.18.7-8_StudyNote_Filament","id":"Lev.18.7-8_StudyNote_Filament","rawId":"Lev.18.7-8_StudyNote_Filament","t":"link","v":"study note on 18:7-8"},". This injunction made it clear that the crime was seen as both incest and adultery."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.20.11","refs":[{"book":"LEV","endChapter":20,"endVerse":11,"startChapter":20,"startVerse":11}],"sourceAttributes":{"name":"Lev.20.11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[20],"sourceItemFragmentSha256":"1938651815134901905cf0b00fd36bfc00caa33a6f94603c66482f10d3e138e2","sourceItemName":"Lev.20.11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1493,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.20.11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.20.11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.20.17","r":"Lev.20.17","rawR":"Lev.20.17","sourceRefs":[{"raw":"Lev.20.17","value":"Lev.20.17"}],"t":"ref","v":"20:17"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["a shameful disgrace:"],"sourceClass":"sn-excerpt","t":"span"}," Proper conduct brings honor both to individuals and to their households; improper conduct brings shame. • Both parties are ",{"c":["cut off"],"sourceClass":"sn-excerpt","t":"span"}," (see ",{"href":"?bref=Lev.7.20-21","r":"Lev.7.20-21","rawR":"Lev.7.20-21","sourceRefs":[{"raw":"Lev.7.20-21","value":"Lev.7.20-21"}],"t":"ref","v":"7:20-21"},"), but the man ",{"c":["will be punished"],"sourceClass":"sn-excerpt","t":"span"}," (see ",{"href":"?bref=Lev.5.1","r":"Lev.5.1","rawR":"Lev.5.1","sourceRefs":[{"raw":"Lev.5.1","value":"Lev.5.1"}],"t":"ref","v":"5:1"},"; ",{"href":"?bref=Lev.18.6","r":"Lev.18.6","rawR":"Lev.18.6","sourceRefs":[{"raw":"Lev.18.6","value":"Lev.18.6"}],"t":"ref","v":"18:6"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.20.17","refs":[{"book":"LEV","endChapter":20,"endVerse":17,"startChapter":20,"startVerse":17}],"sourceAttributes":{"name":"Lev.20.17","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[20],"sourceItemFragmentSha256":"de1eeae3262b3043705093f48e5f8c4fa03bd6de151331002f0605d32569a00f","sourceItemName":"Lev.20.17","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1494,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.20.17","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.20.17","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.20.20-21","r":"Lev.20.20-21","rawR":"Lev.20.20-21","sourceRefs":[{"raw":"Lev.20.20-21","value":"Lev.20.20-21"}],"t":"ref","v":"20:20-21"}],"sourceClass":"sn-ref","t":"span"}," Being left ",{"c":["childless"],"sourceClass":"sn-excerpt","t":"span"}," carried a social stigma and was considered a judgment from God (see ",{"href":"?bref=Gen.30.1-2","r":"Gen.30.1-2","rawR":"Gen.30.1-2","sourceRefs":[{"raw":"Gen.30.1-2","value":"Gen.30.1-2"}],"t":"ref","v":"Gen 30:1-2"},"; ",{"href":"?bref=Deut.7.14","r":"Deut.7.14","rawR":"Deut.7.14","sourceRefs":[{"raw":"Deut.7.14","value":"Deut.7.14"}],"t":"ref","v":"Deut 7:14"},"). What situation is envisioned in these verses? Sexual relations with a sister-in-law (",{"href":"?bref=Lev.18.16","r":"Lev.18.16","rawR":"Lev.18.16","sourceRefs":[{"raw":"Lev.18.16","value":"Lev.18.16"}],"t":"ref","v":"Lev 18:16"},") or an ",{"c":["uncle’s wife"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=Lev.18.14","r":"Lev.18.14","rawR":"Lev.18.14","sourceRefs":[{"raw":"Lev.18.14","value":"Lev.18.14"}],"t":"ref","v":"18:14"},") have already been discussed. Adultery is dealt with elsewhere and would bring death to both parties (",{"href":"?bref=Deut.22.22","r":"Deut.22.22","rawR":"Deut.22.22","sourceRefs":[{"raw":"Deut.22.22","value":"Deut.22.22"}],"t":"ref","v":"Deut 22:22"},"). If the woman involved was a widow without a male heir, the law of levirate marriage could be invoked (",{"href":"?bref=Deut.25.5-6","r":"Deut.25.5-6","rawR":"Deut.25.5-6","sourceRefs":[{"raw":"Deut.25.5-6","value":"Deut.25.5-6"}],"t":"ref","v":"Deut 25:5-6"},"; see ",{"href":"?item=Lev.18.16_StudyNote_Filament","id":"Lev.18.16_StudyNote_Filament","rawId":"Lev.18.16_StudyNote_Filament","t":"link","v":"study note on Lev 18:16"},"). Since those situations don’t seem to apply, it would appear that this law refers to marrying an aunt or a sister-in-law after she has been divorced from her husband. John the Baptist apparently applied this law to condemn Herod Antipas’s marriage to Herodias (see ",{"href":"?bref=Mark.6.17-29","r":"Mark.6.17-29","rawR":"Mark.6.17-29","sourceRefs":[{"raw":"Mark.6.17-29","value":"Mark.6.17-29"}],"t":"ref","v":"Mark 6:17-29"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.20.20-21","refs":[{"book":"LEV","endChapter":20,"endVerse":21,"startChapter":20,"startVerse":20}],"sourceAttributes":{"name":"Lev.20.20-21","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[20],"sourceItemFragmentSha256":"a90d149f38829ba2ee5162112a82a209c21cb84b6bea7e9d08ad70b39b8a4a0a","sourceItemName":"Lev.20.20-21","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1495,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.20.20-21","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.20.20-21","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Lev.20.24","r":"Lev.20.24","rawR":"Lev.20.24","sourceRefs":[{"raw":"Lev.20.24","value":"Lev.20.24"}],"t":"ref","v":"20:24"}],"sourceClass":"sn-ref","t":"span"}," The expression ",{"c":["flowing with milk and honey"],"sourceClass":"sn-excerpt","t":"span"}," is common in Exodus—Deuteronomy. It conveys the idea of food being abundant and easy to get. This contrasts with Egypt, where everything depended on the flooding of the Nile and irrigation (",{"href":"?bref=Deut.11.9-12","r":"Deut.11.9-12","rawR":"Deut.11.9-12","sourceRefs":[{"raw":"Deut.11.9-12","value":"Deut.11.9-12"}],"t":"ref","v":"Deut 11:9-12"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Lev.20.24","refs":[{"book":"LEV","endChapter":20,"endVerse":24,"startChapter":20,"startVerse":24}],"sourceAttributes":{"name":"Lev.20.24","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"LEV","sourceChapterCoverage":[20],"sourceItemFragmentSha256":"10960744fe9caa1ff8503dedcf46eba4a204ef2e38bcd38f13fad668228e5209","sourceItemName":"Lev.20.24","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":1496,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"LEV","canonicalOSIS":"Lev","method":"official_book_intro_ref_title","sourceOSIS":"Lev"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Lev.20.24","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Lev.20.24","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}