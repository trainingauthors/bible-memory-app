:"?bref=Isa.41.2","r":"Isa.41.2","rawR":"Isa.41.2","sourceRefs":[{"raw":"Isa.41.2","value":"Isa.41.2"}],"t":"ref","v":"Isa 41:2"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.13.25","refs":[{"book":"JOB","endChapter":13,"endVerse":25,"startChapter":13,"startVerse":25}],"sourceAttributes":{"name":"Job.13.25","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[13],"sourceItemFragmentSha256":"29025de2d1adea1800a9b864110ff3000e9b1e7701de3cbd2a37bb4ea014a16e","sourceItemName":"Job.13.25","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5687,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.13.25","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.13.25","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}