ob would ",{"c":["answer"],"sourceClass":"sn-excerpt","t":"span"}," in his own defense; or Job would ",{"c":["speak to"],"sourceClass":"sn-excerpt","t":"span"}," God, and then God would ",{"c":["reply"],"sourceClass":"sn-excerpt","t":"span"}," to substantiate the charges against Job. Since God did not take the first option, Job initiated the second one (",{"href":"?bref=Job.13.23","r":"Job.13.23","rawR":"Job.13.23","sourceRefs":[{"raw":"Job.13.23","value":"Job.13.23"}],"t":"ref","v":"13:23"},"). Eventually, God did summon Job (",{"href":"?bref=Job.38.1-3","r":"Job.38.1-3","rawR":"Job.38.1-3","sourceRefs":[{"raw":"Job.38.1-3","value":"Job.38.1-3"}],"t":"ref","v":"38:1-3"},"; ",{"href":"?bref=Job.40.1-2","r":"Job.40.1-2","rawR":"Job.40.1-2","sourceRefs":[{"raw":"Job.40.1-2","value":"Job.40.1-2"}],"t":"ref","v":"40:1-2"},"), and Job was unable to reply (",{"href":"?bref=Job.40.3-5","r":"Job.40.3-5","rawR":"Job.40.3-5","sourceRefs":[{"raw":"Job.40.3-5","value":"Job.40.3-5"}],"t":"ref","v":"40:3-5"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.13.22-23","refs":[{"book":"JOB","endChapter":13,"endVerse":23,"startChapter":13,"startVerse":22}],"sourceAttributes":{"name":"Job.13.22-23","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[13],"sourceItemFragmentSha256":"c0b6bacf8231516281b338b9337ceb460e6666b3e58d1c17dd09e487a423ded4","sourceItemName":"Job.13.22-23","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5685,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.13.22-23","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.13.22-23","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.13.24","r":"Job.13.24","rawR":"Job.13.24","sourceRefs":[{"raw":"Job.13.24","value":"Job.13.24"}],"t":"ref","v":"13:24"}],"sourceClass":"sn-ref","t":"span"}," God can ",{"c":["turn away"],"sourceClass":"sn-excerpt","t":"span"}," in wrath (",{"href":"?bref=Deut.31.18","r":"Deut.31.18","rawR":"Deut.31.18","sourceRefs":[{"raw":"Deut.31.18","value":"Deut.31.18"}],"t":"ref","v":"Deut 31:18"},"; ",{"href":"?bref=Isa.54.8","r":"Isa.54.8","rawR":"Isa.54.8","sourceRefs":[{"raw":"Isa.54.8","value":"Isa.54.8"}],"t":"ref","v":"Isa 54:8"},"; ",{"href":"?bref=Jer.33.5","r":"Jer.33.5","rawR":"Jer.33.5","sourceRefs":[{"raw":"Jer.33.5","value":"Jer.33.5"}],"t":"ref","v":"Jer 33:5"},") or refuse to show friendship (",{"href":"?bref=Ps.30.7","r":"Ps.30.7","rawR":"Ps.30.7","sourceRefs":[{"raw":"Ps.30.7","value":"Ps.30.7"}],"t":"ref","v":"Pss 30:7"},"; ",{"href":"?bref=Ps.69.17","r":"Ps.69.17","rawR":"Ps.69.17","sourceRefs":[{"raw":"Ps.69.17","value":"Ps.69.17"}],"t":"ref","v":"69:17"},"; ",{"href":"?bref=Ps.102.2","r":"Ps.102.2","rawR":"Ps.102.2","sourceRefs":[{"raw":"Ps.102.2","value":"Ps.102.2"}],"t":"ref","v":"102:2"},"). • Job, perhaps playing on his own name (",{"c":["’iyyob"],"sourceClass":"hebrew","t":"span"},"), denied that he was God’s ",{"c":["enemy"],"sourceClass":"sn-excerpt","t":"span"}," (",{"c":["’oyeb"],"sourceClass":"hebrew","t":"span"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.13.24","refs":[{"book":"JOB","endChapter":13,"endVerse":24,"startChapter":13,"startVerse":24}],"sourceAttributes":{"name":"Job.13.24","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[13],"sourceItemFragmentSha256":"8526b7d9459a0a96adb8a1906de4cbc162f7bbf65bdeac67f1837e78833d490f","sourceItemName":"Job.13.24","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5686,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","source