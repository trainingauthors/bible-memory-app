ffd7756ebbbfe6b9.json","title":"Right Hand"},"Whirlwind":{"file":"dictionary/632583d71b62c150c762978113e187937e76325d573e573562e4303a1aaa17ab.json","title":"Whirlwind"},"WisdomLiterature":{"file":"dictionary/60bfca9559688f5416772ffa946be9b716b746bcc70e530673ed00ad7da5af62.json","title":"Wisdom Literature*"}},"dictionaryRelated":[{"id":"Animals","title":"Animals"},{"id":"Behemoth","title":"Behemoth"},{"id":"Garmite","title":"Garmite"},{"id":"JobBookof","title":"Job, Book of"},{"id":"Lotus","title":"Lotus"},{"id":"Plants","title":"Plants"},{"id":"RightHand","title":"Right Hand"},{"id":"Whirlwind","title":"Whirlwind"},{"id":"WisdomLiterature","title":"Wisdom Literature*"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[{"anchorIndex":4,"href":"?bref=Job.40.1-41.34","rawReference":"Job.40.1-41.34"}],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"And the LORD said to Job:","verse":1},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[{"anchorIndex":4,"href":"?bref=Job.40.1-41.34","rawReference":"Job.40.1-41.34"}],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Then Job answered the LORD:","verse":3},{"matchingRule":"reviewed_exact_headword","phrase":"LORD","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[{"anchorIndex":4,"href":"?bref=Job.40.1-41.34","rawReference":"Job.40.1-41.34"}],"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","sourceHeadwordId":"Lord"},"text":"Then the LORD answered Job out of the whirlwind and said:","verse":6}],"id":"Lord","label":"LORD","matchReviews":[{"ruleId":"Lord::LORD::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Only literal uppercase LORD is admitted globally. Source Lord article explicitly covers God as Lord; lowercase human lord and sentence-title Lord are not inferred from this rule.","sourceHeadwordId":"Lord","term":"LORD"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Lord","sourceTitle":"Lord"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":["Understanding Job"],"sourceClass":"theme-title","t":"h"},{"c":["For as long as people have read Job’s story, they have struggled with the tension between the positive and negative aspects of Job’s character. The book’s approval of Job in the opening prologue is unequivocal (",{"href":"?bref=Job.1.1","r":"Job.1.1","rawR":"Job.1.1","sourceRefs":[{"raw":"Job.1.1","value":"Job.1.1"}],"t":"ref","v":"1:1"},", ",{"href":"?bref=Job.1.8","r":"Job.1.8","rawR":"Job.1.8","sourceRefs":[{"raw":"Job.1.8","value":"Job.1.8"}],"t":"ref","v":"8"},"; ",{"href":"?bref=Job.2.3","r":"Job.2.3","rawR":"Job.2.3","sourceRefs":[{"raw":"Job.2.3","value":"Job.2.3"}],"t":"ref","v":"2:3"},"), yet we later hear God interrogate Job: “Who is this that questions my wisdom with such ignorant words?” (",{"href":"?bref=Job.38.2","r":"Job.38.2","rawR":"Job.38.2","sourceRefs":[{"raw":"Job.38.2","value":"Job.38.2"}],"t":"ref","v":"38:2"},"). “Will you discredit my justice and condemn me just to prove you are right?” (",{"href":"?bref=Job.40.8","r":"Job.40.8","rawR":"Job.40.8","sourceRefs":[{"raw":"Job.40.8","value":"Job.40.8"}],"t":"ref","v":"40:8"},")."],"sourceClass":"theme-body-fl","t":"p"},{"c":["God’s questions have led various interpreters to accuse Job of talking too much and even of confusing God’s work with the work of Satan. Some contemporary interpretations side with Job’s counselors in blaming Job for his suffering. Still others follow Eliphaz (",{"href":"?bref=Job.5.17-27","r":"Job.5.17-27","rawR":"Job.5.17-27","sourceRefs":[{"raw":"Job.5.17-27","value":"Job.5.17-27"}],"t":"ref","v":"5:17-27"},") and Elihu (",{"href":"?bref=Job.33.15-33","r":"Job.33.15-33","rawR":"Job.33.15-33","sourceRefs":[{"raw":"Job.33.15-33","value":"Job.33.15-33"}],"t":"ref","v":"33:15-33"},"; ",{"href":"?bref=Job.36.7-17","r":"Job.36.7-17","rawR":"Job.36.7-17","sourceRefs":[{"raw":"Job.36.7-17","value":"Job.36.7-17"}],"t":"ref","v":"36:7-17"},") in arguing that Job’s suffering was God’s loving and sanctifying chastisement. Even the faithful are not exempt from such discipline (",{"href":"?bref=Heb.12.6-12","r":"Heb.12.6-12","rawR":"Heb.12.6-12","sourceRefs":[{"raw":"Heb.12.6-12","value":"Heb.12.6-12"}],"t":"ref","v":"Heb 12:6-12"},"; see ",{"href":"?bref=Pr.3.11-12","r":"Pr.3.11-12","rawR":"Pr.3.11-12","sourceRefs":[{"raw":"Pr.3.11-12","value":"Pr.3.11-12"}],"t":"ref","v":"Prov 3:11-12"},"), but this explanation flies in the face of the rationale given in the book’s opening verses."],"sourceClass":"theme-body","t":"p"},{"c":["Job suffered because God wanted to prove Job’s integrity to Satan. God’s own judgment of Job’s life was positive from start to finish (",{"href":"?bref=Job.1.1","r":"Job.1.1","rawR":"Job.1.1","sourceRefs":[{"raw":"Job.1.1","value":"Job.1.1"}],"t":"ref","v":"Job 1:1"},", ",{"href":"?bref=Job.1.8","r":"Job.1.8","rawR":"Job.1.8","sourceRefs":[{"raw":"Job.1.8","value":"Job.1.8"}],"t":"ref","v":"8"},"; ",{"href":"?bref=Job.2.3","r":"Job.2.3","rawR":"Job.2.3","sourceRefs":[{"raw":"Job.2.3","value":"Job.2.3"}],"t":"ref","v":"2:3"},"; ",{"href":"?bref=Job.42.7","r":"Job.42.7","rawR":"Job.42.7","sourceRefs":[{"raw":"Job.42.7","value":"Job.42.7"}],"t":"ref","v":"42:7"},"). This perspective carries through to the New Testament, where Job is an example of endurance that we should imitate (",{"href":"?bref=Jas.5.11","r":"Jas.5.11","rawR":"Jas.5.11","sourceRefs":[{"raw":"Jas.5.11","value":"Jas.5.11"}],"t":"ref","v":"Jas 5:11"},")."],"sourceClass":"theme-body","t":"p"},{"c":["Job’s reactions are normal. He does not stand like a rock in reverent stoicism as though he were unaffected by his trials. Neither does he trumpet heroic defiance of his troubles, as though they could never get him down. He reacts in a natural human way. Job rages, protests, moans, and vacillates between confidence and despair, but he never gives up. He does not curse God, and he does not make a false confession of guilt in the hope that God will then let up on him. Although Job cannot understand his situation, he knows that his answer will be found in God (",{"href":"?bref=Job.19.25-27","r":"Job.19.25-27","rawR":"Job.19.25-27","sourceRefs":[{"raw":"Job.19.25-27","value":"Job.19.25-27"}],"t":"ref","v":"Job 19:25-27"},")."],"sourceClass":"theme-body","t":"p"},{"c":["Passages for Further Study"],"sourceClass":"theme-refs-title","t":"h"},{"c":[{"href":"?bref=Job.1.1","r":"Job.1.1","rawR":"Job.1.1","sourceRefs":[{"raw":"Job.1.1","value":"Job.1.1"}],"t":"ref","v":"Job 1:1"},", ",{"href":"?bref=Job.1.8","r":"Job.1.8","rawR":"Job.1.8","sourceRefs":[{"raw":"Job.1.8","value":"Job.1.8"}],"t":"ref","v":"8"},"; ",{"href":"?bref=Job.2.3","r":"Job.2.3","rawR":"Job.2.3","sourceRefs":[{"raw":"Job.2.3","value":"Job.2.3"}],"t":"ref","v":"2:3"},"; ",{"href":"?bref=Job.5.17-18","r":"Job.5.17-18","rawR":"Job.5.17-18","sourceRefs":[{"raw":"Job.5.17-18","value":"Job.5.17-18"}],"t":"ref","v":"5:17-18"},"; ",{"href":"?bref=Job.19.25-27","r":"Job.19.25-27","rawR":"Job.19.25-27","sourceRefs":[{"raw":"Job.19.25-27","value":"Job.19.25-27"}],"t":"ref","v":"19:25-27"},"; ",{"href":"?bref=Job.33.15-28","r":"Job.33.15-28","rawR":"Job.33.15-28","sourceRefs":[{"raw":"Job.33.15-28","value":"Job.33.15-28"}],"t":"ref","v":"33:15-28"},"; ",{"href":"?bref=Job.36.8-15","r":"Job.36.8-15","rawR":"Job.36.8-15","sourceRefs":[{"raw":"Job.36.8-15","value":"Job.36.8-15"}],"t":"ref","v":"36:8-15"},"; ",{"href":"?bref=Job.38.2","r":"Job.38.2","rawR":"Job.38.2","sourceRefs":[{"raw":"Job.38.2","value":"Job.38.2"}],"t":"ref","v":"38:2"},"; ",{"href":"?bref=Job.40.8","r":"Job.40.8","rawR":"Job.40.8","sourceRefs":[{"raw":"Job.40.8","value":"Job.40.8"}],"t":"ref","v":"40:8"},"; ",{"href":"?bref=Job.42.7","r":"Job.42.7","rawR":"Job.42.7","sourceRefs":[{"raw":"Job.42.7","value":"Job.42.7"}],"t":"ref","v":"42:7"},"; ",{"href":"?bref=Pr.3.11","r":"Pr.3.11","rawR":"Pr.3.11","sourceRefs":[{"raw":"Pr.3.11","value":"Pr.3.11"}],"t":"ref","v":"Prov 3:11"},"; ",{"href":"?bref=Heb.12.7","r":"Heb.12.7","rawR":"Heb.12.7","sourceRefs":[{"raw":"Heb.12.7","value":"Heb.12.7"}],"t":"ref","v":"Heb 12:7"},", ",{"href":"?bref=Heb.12.10","r":"Heb.12.10","rawR":"Heb.12.10","sourceRefs":[{"raw":"Heb.12.10","value":"Heb.12.10"}],"t":"ref","v":"10"},"; ",{"href":"?bref=Jas.5.11","r":"Jas.5.11","rawR":"Jas.5.11","sourceRefs":[{"raw":"Jas.5.11","value":"Jas.5.11"}],"t":"ref","v":"Jas 5:11"}],"sourceClass":"theme-refs","t":"p"}],"id":"ThemeNote:UnderstandingJob","refs":[{"book":"JOB","endChapter":42,"endVerse":17,"startChapter":38,"startVerse":1}],"sourceAttributes":{"name":"UnderstandingJob","product":"TyndaleOpenStudyNotes","typename":"ThemeNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[38,39,40,41,42],"sourceItemFragmentSha256":"5ca39c43e11da8de13a2a430f8b5cd8f60e873839923ba2070e996921f8e26bd","sourceItemName":"UnderstandingJob","sourceMember":"Tyndale Open Study Notes/ThemeNotes.xml","sourceOrder":106,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.38.1-42.17","sourceRelease":"1.25","sourceTitleExact":"Understanding Job","supplementPointersNotIncludedAsContent":[],"title":"Understanding Job","type":"ThemeNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.38.1-40.5","r":"Job.38.1-40.5","rawR":"Job.38.1-40.5","sourceRefs":[{"raw":"Job.38.1-40.5","value":"Job.38.1-40.5"}],"t":"ref","v":"38:1–40:5"}],"sourceClass":"sn-ref","t":"span"}," God challenges Job, who acknowledges his inability to judge the moral world by demonstrating his ignorance of the natural world’s cosmic (",{"href":"?bref=Job.38.4-21","r":"Job.38.4-21","rawR":"Job.38.4-21","sourceRefs":[{"raw":"Job.38.4-21","value":"Job.38.4-21"}],"t":"ref","v":"38:4-21"},") and meteorological elements (",{"href":"?bref=Job.38.22-38","r":"Job.38.22-38","rawR":"Job.38.22-38","sourceRefs":[{"raw":"Job.38.22-38","value":"Job.38.22-38"}],"t":"ref","v":"38:22-38"},"), animals, and birds (",{"href":"?bref=Job.38.39-39.30","r":"Job.38.39-39.30","rawR":"Job.38.39-39.30","sourceRefs":[{"raw":"Job.38.39-39.30","value":"Job.38.39-39.30"}],"t":"ref","v":"38:39–39:30"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.38.1-40.5","refs":[{"book":"JOB","endChapter":40,"endVerse":5,"startChapter":38,"startVerse":1}],"sourceAttributes":{"name":"Job.38.1-40.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[38,39,40],"sourceItemFragmentSha256":"a22ac306c0f72f17aefd51662864c5054e1721c24aaee43c4890ef2b6b7a5977","sourceItemName":"Job.38.1-40.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5919,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.38.1-40.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.38.1-40.5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.40.1-2","r":"Job.40.1-2","rawR":"Job.40.1-2","sourceRefs":[{"raw":"Job.40.1-2","value":"Job.40.1-2"}],"t":"ref","v":"40:1-2"}],"sourceClass":"sn-ref","t":"span"}," The Greek Old Testament omits this conclusion to God’s first speech."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.40.1-2","refs":[{"book":"JOB","endChapter":40,"endVerse":2,"startChapter":40,"startVerse":1}],"sourceAttributes":{"name":"Job.40.1-2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[40],"sourceItemFragmentSha256":"71759f13702db0307ca7268863412307bbd4173d1fcd92a03768e326dea9f373","sourceItemName":"Job.40.1-2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5936,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.40.1-2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.40.1-2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.40.3-5","r":"Job.40.3-5","rawR":"Job.40.3-5","sourceRefs":[{"raw":"Job.40.3-5","value":"Job.40.3-5"}],"t":"ref","v":"40:3-5"}],"sourceClass":"sn-ref","t":"span"}," Job’s brief and humble response does not acknowledge guilt, but it does admit his insignificance (",{"href":"?bref=Job.40.4","r":"Job.40.4","rawR":"Job.40.4","sourceRefs":[{"raw":"Job.40.4","value":"Job.40.4"}],"t":"ref","v":"40:4"},"). He had previously thought that he could approach God like a prince (",{"href":"?bref=Job.31.37","r":"Job.31.37","rawR":"Job.31.37","sourceRefs":[{"raw":"Job.31.37","value":"Job.31.37"}],"t":"ref","v":"31:37"},") or even cross-examine him (",{"href":"?bref=Job.13.22-23","r":"Job.13.22-23","rawR":"Job.13.22-23","sourceRefs":[{"raw":"Job.13.22-23","value":"Job.13.22-23"}],"t":"ref","v":"13:22-23"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.40.3-5","refs":[{"book":"JOB","endChapter":40,"endVerse":5,"startChapter":40,"startVerse":3}],"sourceAttributes":{"name":"Job.40.3-5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[40],"sourceItemFragmentSha256":"d86435bdce6cc017b44e6ad37f2f5ea82890131b9f65f48c4bce0e9e663866da","sourceItemName":"Job.40.3-5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5937,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.40.3-5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.40.3-5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.40.4","r":"Job.40.4","rawR":"Job.40.4","sourceRefs":[{"raw":"Job.40.4","value":"Job.40.4"}],"t":"ref","v":"40:4"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["I am nothing"],"sourceClass":"sn-excerpt","t":"span"}," (cp. ",{"href":"?bref=Job.42.6","r":"Job.42.6","rawR":"Job.42.6","sourceRefs":[{"raw":"Job.42.6","value":"Job.42.6"}],"t":"ref","v":"42:6"},"): Job was not repenting from sin; like Abraham, he recognized his unworthiness (",{"href":"?bref=Gen.18.27","r":"Gen.18.27","rawR":"Gen.18.27","sourceRefs":[{"raw":"Gen.18.27","value":"Gen.18.27"}],"t":"ref","v":"Gen 18:27"},"). • Job had asked his comforters to ",{"c":["cover"],"sourceClass":"sn-excerpt","t":"span"}," their ",{"c":["mouth"],"sourceClass":"sn-excerpt","t":"span"}," to acknowledge shock (",{"href":"?bref=Job.21.5","r":"Job.21.5","rawR":"Job.21.5","sourceRefs":[{"raw":"Job.21.5","value":"Job.21.5"}],"t":"ref","v":"21:5"},"); here he does so himself in reaction to his own rash words."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.40.4","refs":[{"book":"JOB","endChapter":40,"endVerse":4,"startChapter":40,"startVerse":4}],"sourceAttributes":{"name":"Job.40.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[40],"sourceItemFragmentSha256":"6479d5085b3d6928c36d28f945bd328d3e981bb8a07545261b796d99da739c1a","sourceItemName":"Job.40.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5938,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.40.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.40.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.40.5","r":"Job.40.5","rawR":"Job.40.5","sourceRefs":[{"raw":"Job.40.5","value":"Job.40.5"}],"t":"ref","v":"40:5"}],"sourceClass":"sn-ref","t":"span"}," Job had ",{"c":["nothing more to say"],"sourceClass":"sn-excerpt","t":"span"},{"c":[";"],"sourceClass":"ital","t":"span"}," he had no further charges against God, nor would he make a rebuttal."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.40.5","refs":[{"book":"JOB","endChapter":40,"endVerse":5,"startChapter":40,"startVerse":5}],"sourceAttributes":{"name":"Job.40.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[40],"sourceItemFragmentSha256":"502e8c39bbb42202454ae16df837808052cd18fd10750f533ab1e5b3f4fb8b43","sourceItemName":"Job.40.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5939,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.40.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.40.5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.40.6-7","r":"Job.40.6-7","rawR":"Job.40.6-7","sourceRefs":[{"raw":"Job.40.6-7","value":"Job.40.6-7"}],"t":"ref","v":"40:6-7"}],"sourceClass":"sn-ref","t":"span"}," The Lord repeated his earlier challenge (see ",{"href":"?bref=Job.38.1-3","r":"Job.38.1-3","rawR":"Job.38.1-3","sourceRefs":[{"raw":"Job.38.1-3","value":"Job.38.1-3"}],"t":"ref","v":"38:1-3"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.40.6-7","refs":[{"book":"JOB","endChapter":40,"endVerse":7,"startChapter":40,"startVerse":6}],"sourceAttributes":{"name":"Job.40.6-7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[40],"sourceItemFragmentSha256":"e3c207e2a23514baf584b739140b969717fd2a5882a6d14c0a2f8b3840a187f1","sourceItemName":"Job.40.6-7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5940,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.40.6-7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.40.6-7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.40.8","r":"Job.40.8","rawR":"Job.40.8","sourceRefs":[{"raw":"Job.40.8","value":"Job.40.8"}],"t":"ref","v":"40:8"}],"sourceClass":"sn-ref","t":"span"}," Job’s words (",{"href":"?bref=Job.10.7","r":"Job.10.7","rawR":"Job.10.7","sourceRefs":[{"raw":"Job.10.7","value":"Job.10.7"}],"t":"ref","v":"10:7"},"; ",{"href":"?bref=Job.27.2","r":"Job.27.2","rawR":"Job.27.2","sourceRefs":[{"raw":"Job.27.2","value":"Job.27.2"}],"t":"ref","v":"27:2"},"; ",{"href":"?bref=Job.31.35-37","r":"Job.31.35-37","rawR":"Job.31.35-37","sourceRefs":[{"raw":"Job.31.35-37","value":"Job.31.35-37"}],"t":"ref","v":"31:35-37"},") had angered Elihu (",{"href":"?bref=Job.32.2","r":"Job.32.2","rawR":"Job.32.2","sourceRefs":[{"raw":"Job.32.2","value":"Job.32.2"}],"t":"ref","v":"32:2"},"; ",{"href":"?bref=Job.34.5","r":"Job.34.5","rawR":"Job.34.5","sourceRefs":[{"raw":"Job.34.5","value":"Job.34.5"}],"t":"ref","v":"34:5"},"); now God himself challenged them."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.40.8","refs":[{"book":"JOB","endChapter":40,"endVerse":8,"startChapter":40,"startVerse":8}],"sourceAttributes":{"name":"Job.40.8","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[40],"sourceItemFragmentSha256":"3eabcf23f4d16061340366ca9fbded82927768f98a6b823a1e193f55ce9a3207","sourceItemName":"Job.40.8","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5941,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.40.8","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.40.8","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.40.11-12","r":"Job.40.11-12","rawR":"Job.40.11-12","sourceRefs":[{"raw":"Job.40.11-12","value":"Job.40.11-12"}],"t":"ref","v":"40:11-12"}],"sourceClass":"sn-ref","t":"span"}," Job could not do God’s work of humbling the proud (",{"href":"?bref=Isa.2.11-12","r":"Isa.2.11-12","rawR":"Isa.2.11-12","sourceRefs":[{"raw":"Isa.2.11-12","value":"Isa.2.11-12"}],"t":"ref","v":"Isa 2:11-12"},", ",{"href":"?bref=Isa.2.17","r":"Isa.2.17","rawR":"Isa.2.17","sourceRefs":[{"raw":"Isa.2.17","value":"Isa.2.17"}],"t":"ref","v":"17"},"; ",{"href":"?bref=Jas.4.6","r":"Jas.4.6","rawR":"Jas.4.6","sourceRefs":[{"raw":"Jas.4.6","value":"Jas.4.6"}],"t":"ref","v":"Jas 4:6"},"; ",{"href":"?bref=1Pet.5.5-6","r":"1Pet.5.5-6","rawR":"1Pet.5.5-6","sourceRefs":[{"raw":"1Pet.5.5-6","value":"1Pet.5.5-6"}],"t":"ref","v":"1 Pet 5:5-6"},") apart from God’s authority (",{"href":"?bref=Mal.4.3","r":"Mal.4.3","rawR":"Mal.4.3","sourceRefs":[{"raw":"Mal.4.3","value":"Mal.4.3"}],"t":"ref","v":"Mal 4:3"},"; ",{"href":"?bref=Rom.16.20","r":"Rom.16.20","rawR":"Rom.16.20","sourceRefs":[{"raw":"Rom.16.20","value":"Rom.16.20"}],"t":"ref","v":"Rom 16:20"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.40.11-12","refs":[{"book":"JOB","endChapter":40,"endVerse":12,"startChapter":40,"startVerse":11}],"sourceAttributes":{"name":"Job.40.11-12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[40],"sourceItemFragmentSha256":"dfab8d334b9cd5217fed7645b267c500eefc5a41f22cdfdbbd6b3e50c46e7392","sourceItemName":"Job.40.11-12","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5942,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.40.11-12","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.40.11-12","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.40.15-24","r":"Job.40.15-24","rawR":"Job.40.15-24","sourceRefs":[{"raw":"Job.40.15-24","value":"Job.40.15-24"}],"t":"ref","v":"40:15-24"}],"sourceClass":"sn-ref","t":"span"}," Following a list of natural animals (",{"href":"?bref=Job.39.1-30","r":"Job.39.1-30","rawR":"Job.39.1-30","sourceRefs":[{"raw":"Job.39.1-30","value":"Job.39.1-30"}],"t":"ref","v":"39:1-30"},"), God described Behemoth (",{"href":"?bref=Job.40.15-24","r":"Job.40.15-24","rawR":"Job.40.15-24","sourceRefs":[{"raw":"Job.40.15-24","value":"Job.40.15-24"}],"t":"ref","v":"40:15-24"},") and Leviathan (",{"href":"?bref=Job.41.1-34","r":"Job.41.1-34","rawR":"Job.41.1-34","sourceRefs":[{"raw":"Job.41.1-34","value":"Job.41.1-34"}],"t":"ref","v":"41:1-34"},") as creatures that man cannot tame. Job couldn’t tame the wild donkey or ox (",{"href":"?bref=Job.39.5-12","r":"Job.39.5-12","rawR":"Job.39.5-12","sourceRefs":[{"raw":"Job.39.5-12","value":"Job.39.5-12"}],"t":"ref","v":"39:5-12"},"), let alone Behemoth and Leviathan (",{"href":"?bref=Job.40.15-24","r":"Job.40.15-24","rawR":"Job.40.15-24","sourceRefs":[{"raw":"Job.40.15-24","value":"Job.40.15-24"}],"t":"ref","v":"40:15-24"},"), but God created them and could control them, and Job had to acknowledge it (",{"href":"?bref=Job.41.2","r":"Job.41.2","rawR":"Job.41.2","sourceRefs":[{"raw":"Job.41.2","value":"Job.41.2"}],"t":"ref","v":"41:2"},"). • Here ",{"c":["Behemoth"],"sourceClass":"sn-excerpt","t":"span"}," seems to be a natural creature: (1) It is an animal that God ",{"c":["made"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," just as he made Job (",{"href":"?bref=Job.40.15","r":"Job.40.15","rawR":"Job.40.15","sourceRefs":[{"raw":"Job.40.15","value":"Job.40.15"}],"t":"ref","v":"40:15"},"); (2) it is not a dreadful predator but ",{"c":["eats grass like an ox"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=Job.40.15","r":"Job.40.15","rawR":"Job.40.15","sourceRefs":[{"raw":"Job.40.15","value":"Job.40.15"}],"t":"ref","v":"40:15"},"); and (3) it is in a poem describing God’s creation of the natural order, rather than in a mythological story of the world’s formation. Most commentators identify Behemoth with the hippopotamus, a huge, grass-eating animal (",{"href":"?bref=Job.40.15-19","r":"Job.40.15-19","rawR":"Job.40.15-19","sourceRefs":[{"raw":"Job.40.15-19","value":"Job.40.15-19"}],"t":"ref","v":"40:15-19"},") that lies in the river among the lotus plants and reeds (",{"href":"?bref=Job.40.21","r":"Job.40.21","rawR":"Job.40.21","sourceRefs":[{"raw":"Job.40.21","value":"Job.40.21"}],"t":"ref","v":"40:21"},"). Like the wild ox, Behemoth is powerful (",{"href":"?bref=Job.40.16-18","r":"Job.40.16-18","rawR":"Job.40.16-18","sourceRefs":[{"raw":"Job.40.16-18","value":"Job.40.16-18"}],"t":"ref","v":"40:16-18"},", ",{"href":"?bref=Job.40.24","r":"Job.40.24","rawR":"Job.40.24","sourceRefs":[{"raw":"Job.40.24","value":"Job.40.24"}],"t":"ref","v":"24"},"; ",{"href":"?bref=Job.39.11","r":"Job.39.11","rawR":"Job.39.11","sourceRefs":[{"raw":"Job.39.11","value":"Job.39.11"}],"t":"ref","v":"39:11"},"), yet is essentially peaceful (",{"href":"?bref=Job.40.20-23","r":"Job.40.20-23","rawR":"Job.40.20-23","sourceRefs":[{"raw":"Job.40.20-23","value":"Job.40.20-23"}],"t":"ref","v":"40:20-23"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.40.15-24","refs":[{"book":"JOB","endChapter":40,"endVerse":24,"startChapter":40,"startVerse":15}],"sourceAttributes":{"name":"Job.40.15-24","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[40],"sourceItemFragmentSha256":"95b753ab548ce066da238208c21f8965de634708a6ca6996c9065ab1fd1ffa7e","sourceItemName":"Job.40.15-24","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5943,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.40.15-24","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.40.15-24","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}