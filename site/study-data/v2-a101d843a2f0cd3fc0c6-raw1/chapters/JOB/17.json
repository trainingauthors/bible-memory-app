14"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["my father . . . mother . . . sister:"],"sourceClass":"sn-excerpt","t":"span"}," This bitter parody of a family reunion in a graveyard shows how Job envisioned his impending death."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.17.14","refs":[{"book":"JOB","endChapter":17,"endVerse":14,"startChapter":17,"startVerse":14}],"sourceAttributes":{"name":"Job.17.14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[17],"sourceItemFragmentSha256":"31eb07dffc74f66acbe709058151e808f720e3798477a1a5613d26f4093df0e9","sourceItemName":"Job.17.14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5730,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.17.14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.17.14","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.17.16","r":"Job.17.16","rawR":"Job.17.16","sourceRefs":[{"raw":"Job.17.16","value":"Job.17.16"}],"t":"ref","v":"17:16"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["the grave"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["the bars of Sheol"],"sourceClass":"ital","t":"span"},"): Sheol—the abode of the dead—was seen as having a barred gate, allowing no escape."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.17.16","refs":[{"book":"JOB","endChapter":17,"endVerse":16,"startChapter":17,"startVerse":16}],"sourceAttributes":{"name":"Job.17.16","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[17],"sourceItemFragmentSha256":"82143aed18756b8f487a84e632b7f6a8ce4f2df54a7f32c69631dab9f5420b9f","sourceItemName":"Job.17.16","sourc