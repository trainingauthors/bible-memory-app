.20.16","sourceRefs":[{"raw":"Pr.20.16","value":"Pr.20.16"}],"t":"ref","v":"Prov 20:16"},"; ",{"href":"?bref=Pr.27.13","r":"Pr.27.13","rawR":"Pr.27.13","sourceRefs":[{"raw":"Pr.27.13","value":"Pr.27.13"}],"t":"ref","v":"27:13"},"), so this might suggest atonement. It might also be another reference to Job’s desire for an advocate to plead his case (see ",{"href":"?item=Job.16.19-21_StudyNote_Filament","id":"Job.16.19-21_StudyNote_Filament","rawId":"Job.16.19-21_StudyNote_Filament","t":"link","v":"study note on Job 16:19-21"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.17.3-5","refs":[{"book":"JOB","endChapter":17,"endVerse":5,"startChapter":17,"startVerse":3}],"sourceAttributes":{"name":"Job.17.3-5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[17],"sourceItemFragmentSha256":"96ce246d346aac346269d00d576a3cd51789f33ae85990bd2573adafbd7620b3","sourceItemName":"Job.17.3-5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5725,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.17.3-5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.17.3-5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.17.6","r":"Job.17.6","rawR":"Job.17.6","sourceRefs":[{"raw":"Job.17.6","value":"Job.17.6"}],"t":"ref","v":"17:6"}],"sourceClass":"sn-ref","t":"span"}," To ",{"c":["spit in"],"sourceClass":"sn-excerpt","t":"span"}," someone’s ",{"c":["face"],"sourceClass":"sn-excerpt","t":"span"}," was even more insulting than a slap (",{"href":"?bref=Job.16.10","r":"Job.16.10","rawR":"Job.16.10","sourceRefs":[{"raw":"Job.16.10","value":"Job.16.10"}],"t":"ref","v":"16:10"},") because spit made the person unclean (",{"href":"?bref=Num.12.14","r":"Num.12.14","rawR":"Num.12.14","sourceRefs":[{"raw":"Num.12.14","value":"Num.12.14"}],"t":"ref","v":"Num 12:14"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.17.6","refs":[{"book":"JOB","endChapter":17,"endVerse":6,"startChapter":17,"startVerse":6}],"sourceAttributes":{"name":"Job.17.6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[17],"sourceItemFragmentSha256":"bccb30b8a978b0c137ffd2c5fa52d3bea3c41fe518d209e13e2647c1bc095c5b","sourceItemName":"Job.17.6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5726,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.17.6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.17.6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.17.8-9","r":"Job.17.8-9","rawR":"Job.17.8-9","sourceRefs":[{"raw":"Job.17.8-9","value":"Job.17.8-9"}],"t":"ref","v":"17:8-9"}],"sourceClass":"sn-ref","t":"span"}," Some scholars view these verses as being out of place, but perhaps Job was ironically quoting his opponents’ words."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.17.8-9","refs":[{"book":"JOB","endChapter":17,"endVerse":9,"startChapter":17,"startVerse":8}],"sourceAttributes":{"name":"Job.17.8-9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[17],"sourceItemFragmentSha256":"1ed5aec07096d246cebfc1c728295368065b8100fd3cc35d3a068b6fdb579479","sourceItemName":"Job.17.8-9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5727,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"officia