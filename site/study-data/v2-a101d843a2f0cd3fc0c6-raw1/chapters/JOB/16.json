rceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.16.13","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.16.14","r":"Job.16.14","rawR":"Job.16.14","sourceRefs":[{"raw":"Job.16.14","value":"Job.16.14"}],"t":"ref","v":"16:14"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Again and again he smashes against me:"],"sourceClass":"sn-excerpt","t":"span"}," Job pictures himself as a fortress that God is besieging. Job saw God as a ",{"c":["warrior"],"sourceClass":"sn-excerpt","t":"span"}," (cp. ",{"href":"?bref=Exod.15.3","r":"Exod.15.3","rawR":"Exod.15.3","sourceRefs":[{"raw":"Exod.15.3","value":"Exod.15.3"}],"t":"ref","v":"Exod 15:3"},"; ",{"href":"?bref=Ps.24.8","r":"Ps.24.8","rawR":"Ps.24.8","sourceRefs":[{"raw":"Ps.24.8","value":"Ps.24.8"}],"t":"ref","v":"Ps 24:8"},") who did not defend him or offer him salvation (",{"href":"?bref=Jer.20.11","r":"Jer.20.11","rawR":"Jer.20.11","sourceRefs":[{"raw":"Jer.20.11","value":"Jer.20.11"}],"t":"ref","v":"Jer 20:11"},"; ",{"href":"?bref=Zeph.3.17","r":"Zeph.3.17","rawR":"Zeph.3.17","sourceRefs":[{"raw":"Zeph.3.17","value":"Zeph.3.17"}],"t":"ref","v":"Zeph 3:17"},") but attacked him as though he were dangerous (",{"href":"?bref=Job.6.12","r":"Job.6.12","rawR":"Job.6.12","sourceRefs":[{"raw":"Job.6.12","value":"Job.6.12"}],"t":"ref","v":"Job 6:12"},"; see ",{"href":"?bref=Isa.42.13","r":"Isa.42.13","rawR":"Isa.42.13","sourceRefs":[{"raw":"Isa.42.13","value":"Isa.42.13"}],"t":"ref","v":"Isa 42:13"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.16.14","refs":[{"book":"JOB","endChapter":16,"endVerse":14,"startChapter":16,"startVerse":14}],"sourceAttributes":{"name":"Job.16.14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[16],"sourceItemFragmentSha256":"ad56c37cc1d38c105a024aa6bb374b8e39210e50cf00ba4a6a6c1ab7cd62826c","sourceItemName":"Job.16.14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5717,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.16.14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.16.14","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.16.15","r":"Job.16.15","rawR":"Job.16.15","sourceRefs":[{"raw":"Job.16.15","value":"Job.16.15"}],"t":"ref","v":"16:15"}],"sourceClass":"sn-ref","t":"span"}," Since Job insisted on his innocence, his wearing ",{"c":["burlap"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["I sewed on burlap"],"sourceClass":"ital","t":"span"},") was a sign of mourning, not penitence. Perhaps it was attached to indicate that he would never remove it because he could never be consoled (",{"href":"?bref=Gen.37.34-35","r":"Gen.37.34-35","rawR":"Gen.37.34-35","sourceRefs":[{"raw":"Gen.37.34-35","value":"Gen.37.34-35"}],"t":"ref","v":"Gen 37:34-35"},"). • ",{"c":["My pride lies in the dust"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["I have buried my horn in the dust"],"sourceClass":"ital","t":"span"},"): A horn symbolized dignity and power (",{"href":"?bref=1Sam.2.1","r":"1Sam.2.1","rawR":"1Sam.2.1","sourceRefs":[{"raw":"1Sam.2.1","value":"1Sam.2.1"}],"t":"ref","v":"1 Sam 2:1"},"; ",{"href":"?bref=Ps.75.4-5","r":"Ps.75.4-5","rawR":"Ps.75.4-5","sourceRefs":[{"raw":"Ps.75.4-5","value":"Ps.75.4-5"}],"t":"ref","v":"Pss 75:4-5"},"; ",{"href":"?bref=Ps.89.17","r":"Ps.89.17","rawR":"Ps.89.17","sourceRefs":[{"raw":"Ps.89.17","value":"Ps.89.17"}],"t":"ref","v":"89:17"},", ",{"href":"?bref=Ps.89.24","r":"Ps.89.24","rawR":"Ps.89.24","sourceRefs":[{"raw":"Ps.89.24","value":"Ps.89.24"}],"t":"ref","v":"24"},"; ",{"href":"?bref=Ps.92.10","r":"Ps.92.10","rawR":"Ps.92.10","sourceRefs":[{"raw":"Ps.92.10","value":"Ps.92.10"}],"t":"ref","v":"92:10"},"; ",{"href":"?bref=Ps.112.9","r":"Ps.112.9","rawR":"Ps.112.9","sourceRefs":[{"raw":"Ps.112.9","value":"Ps.112.9"}],"t":"ref","v":"112:9"},"; ",{"href":"?bref=Ps.148.14","r":"Ps.148.14","rawR":"Ps.148.14","sourceRefs":[{"raw":"Ps.148.14","value":"Ps.148.14"}],"t":"ref","v":"148:14"},"); cutting it off inflicted degrading humiliation (",{"href":"?bref=Ps.75.10","r":"Ps.75.10","rawR":"Ps.75.10","sourceRefs":[{"raw":"Ps.75.10","value":"Ps.75.10"}],"t":"ref","v":"Ps 75:10"},"; ",{"href":"?bref=Jer.48.25","r":"Jer.48.25","rawR":"Jer.48.25","sourceRefs":[{"raw":"Jer.48.25","value":"Jer.48.25"}],"t":"ref","v":"Jer 48:25"},"; ",{"href":"?bref=Zech.1.12","r":"Zech.1.12","rawR":"Zech.1.12","sourceRefs":[{"raw":"Zech.1.12","value":"Zech.1.12"}],"t":"ref","v":"Zech 1:12"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.16.15","refs":[{"book":"JOB","endChapter":16,"endVerse":15,"startChapter":16,"startVerse":15}],"sourceAttributes":{"name":"Job.16.15","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[16],"sourceItemFragmentSha256":"94d73a0fa71cdc79e997c5b155ef04d252d23b6ce8a223550fe770d02f6827c9","sourceItemName":"Job.16.15","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5718,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.16.15","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.16.15","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.16.17","r":"Job.16.17","rawR":"Job.16.17","sourceRefs":[{"raw":"Job.16.17","value":"Job.16.17"}],"t":"ref","v":"16:17"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["done no wrong"],"sourceClass":"sn-excerpt","t":"span"}," (or ",{"c":["done no violence;"],"sourceClass":"ital","t":"span"}," Hebrew ",{"c":["lo’-khamas"],"sourceClass":"hebrew","t":"span"},"): If ",{"c":["violence"],"sourceClass":"ital","t":"span"}," is the meaning, Job was possibly denying that he was a formidable warrior who should be attacked (",{"href":"?bref=Job.16.12-14","r":"Job.16.12-14","rawR":"Job.16.12-14","sourceRefs":[{"raw":"Job.16.12-14","value":"Job.16.12-14"}],"t":"ref","v":"16:12-14"},"; see also ",{"href":"?bref=Isa.59.6","r":"Isa.59.6","rawR":"Isa.59.6","sourceRefs":[{"raw":"Isa.59.6","value":"Isa.59.6"}],"t":"ref","v":"Isa 59:6"},"; ",{"href":"?bref=Jon.3.8","r":"Jon.3.8","rawR":"Jon.3.8","sourceRefs":[{"raw":"Jon.3.8","value":"Jon.3.8"}],"t":"ref","v":"Jon 3:8"},"). • Contrary to Eliphaz’s charge (",{"href":"?bref=Job.15.4-5","r":"Job.15.4-5","rawR":"Job.15.4-5","sourceRefs":[{"raw":"Job.15.4-5","value":"Job.15.4-5"}],"t":"ref","v":"Job 15:4-5"},") and Bildad’s assumption (",{"href":"?bref=Job.8.6","r":"Job.8.6","rawR":"Job.8.6","sourceRefs":[{"raw":"Job.8.6","value":"Job.8.6"}],"t":"ref","v":"8:6"},"), Job’s prayer was ",{"c":["pure"],"sourceClass":"sn-excerpt","t":"span"}," because he was innocent (",{"href":"?bref=Gen.20.5","r":"Gen.20.5","rawR":"Gen.20.5","sourceRefs":[{"raw":"Gen.20.5","value":"Gen.20.5"}],"t":"ref","v":"Gen 20:5"},"; ",{"href":"?bref=Isa.59.3","r":"Isa.59.3","rawR":"Isa.59.3","sourceRefs":[{"raw":"Isa.59.3","value":"Isa.59.3"}],"t":"ref","v":"Isa 59:3"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.16.17","refs":[{"book":"JOB","endChapter":16,"endVerse":17,"startChapter":16,"startVerse":17}],"sourceAttributes":{"name":"Job.16.17","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[16],"sourceItemFragmentSha256":"57d04f15ceaf6995362bcb52efd9debe0b668e1aca7a5940ab6cb80809e67705","sourceItemName":"Job.16.17","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5719,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.16.17","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.16.17","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.16.18-22","r":"Job.16.18-22","rawR":"Job.16.18-22","sourceRefs":[{"raw":"Job.16.18-22","value":"Job.16.18-22"}],"t":"ref","v":"16:18-22"}],"sourceClass":"sn-ref","t":"span"}," Job expected his suffering to prove fatal (",{"href":"?bref=Job.7.7","r":"Job.7.7","rawR":"Job.7.7","sourceRefs":[{"raw":"Job.7.7","value":"Job.7.7"}],"t":"ref","v":"7:7"},", ",{"href":"?bref=Job.7.21","r":"Job.7.21","rawR":"Job.7.21","sourceRefs":[{"raw":"Job.7.21","value":"Job.7.21"}],"t":"ref","v":"21"},"; ",{"href":"?bref=Job.10.20-22","r":"Job.10.20-22","rawR":"Job.10.20-22","sourceRefs":[{"raw":"Job.10.20-22","value":"Job.10.20-22"}],"t":"ref","v":"10:20-22"},"); he pleaded with God to reveal his innocence even if he died first."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.16.18-22","refs":[{"book":"JOB","endChapter":16,"endVerse":22,"startChapter":16,"startVerse":18}],"sourceAttributes":{"name":"Job.16.18-22","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[16],"sourceItemFragmentSha256":"ee3d6da520a5c28f8ebc09566f07d6fcbe0ddc8e8ed4a92e1b13725d7cd2ff6e","sourceItemName":"Job.16.18-22","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5720,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.16.18-22","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.16.18-22","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.16.18","r":"Job.16.18","rawR":"Job.16.18","sourceRefs":[{"raw":"Job.16.18","value":"Job.16.18"}],"t":"ref","v":"16:18"}],"sourceClass":"sn-ref","t":"span"}," Job’s ",{"c":["blood"],"sourceClass":"sn-excerpt","t":"span"}," would ",{"c":["cry out"],"sourceClass":"sn-excerpt","t":"span"}," that he had been innocent and that he had suffered undeservedly (cp. ",{"href":"?bref=Gen.4.10-11","r":"Gen.4.10-11","rawR":"Gen.4.10-11","sourceRefs":[{"raw":"Gen.4.10-11","value":"Gen.4.10-11"}],"t":"ref","v":"Gen 4:10-11"},"; ",{"href":"?bref=Isa.26.21","r":"Isa.26.21","rawR":"Isa.26.21","sourceRefs":[{"raw":"Isa.26.21","value":"Isa.26.21"}],"t":"ref","v":"Isa 26:21"},"; ",{"href":"?bref=Ezek.24.7-8","r":"Ezek.24.7-8","rawR":"Ezek.24.7-8","sourceRefs":[{"raw":"Ezek.24.7-8","value":"Ezek.24.7-8"}],"t":"ref","v":"Ezek 24:7-8"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.16.18","refs":[{"book":"JOB","endChapter":16,"endVerse":18,"startChapter":16,"startVerse":18}],"sourceAttributes":{"name":"Job.16.18","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[16],"sourceItemFragmentSha256":"e28a55b287e3326d658474151a12d5c7332ec70279817b2619ea3d82ca0c5067","sourceItemName":"Job.16.18","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5721,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.16.18","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.16.18","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.16.19-21","r":"Job.16.19-21","rawR":"Job.16.19-21","sourceRefs":[{"raw":"Job.16.19-21","value":"Job.16.19-21"}],"t":"ref","v":"16:19-21"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["my witness is in heaven:"],"sourceClass":"sn-excerpt","t":"span"}," Job wished for a benevolent third party who would ",{"c":["mediate"],"sourceClass":"sn-excerpt","t":"span"}," between him and God (see ",{"href":"?bref=Job.9.32-35","r":"Job.9.32-35","rawR":"Job.9.32-35","sourceRefs":[{"raw":"Job.9.32-35","value":"Job.9.32-35"}],"t":"ref","v":"9:32-35"},"). Job wanted an ",{"c":["advocate"],"sourceClass":"sn-excerpt","t":"span"}," from heaven (",{"href":"?bref=Job.16.19","r":"Job.16.19","rawR":"Job.16.19","sourceRefs":[{"raw":"Job.16.19","value":"Job.16.19"}],"t":"ref","v":"16:19"},"; cp. ",{"href":"?bref=Zech.3.1","r":"Zech.3.1","rawR":"Zech.3.1","sourceRefs":[{"raw":"Zech.3.1","value":"Zech.3.1"}],"t":"ref","v":"Zech 3:1"},") who would eventually stand on the earth (",{"href":"?bref=Job.19.25","r":"Job.19.25","rawR":"Job.19.25","sourceRefs":[{"raw":"Job.19.25","value":"Job.19.25"}],"t":"ref","v":"Job 19:25"},"; cp. ",{"href":"?bref=1Sam.24.15","r":"1Sam.24.15","rawR":"1Sam.24.15","sourceRefs":[{"raw":"1Sam.24.15","value":"1Sam.24.15"}],"t":"ref","v":"1 Sam 24:15"},"; ",{"href":"?bref=John.14.16","r":"John.14.16","rawR":"John.14.16","sourceRefs":[{"raw":"John.14.16","value":"John.14.16"}],"t":"ref","v":"John 14:16"},", ",{"href":"?bref=John.14.26","r":"John.14.26","rawR":"John.14.26","sourceRefs":[{"raw":"John.14.26","value":"John.14.26"}],"t":"ref","v":"26"},"; ",{"href":"?bref=John.15.26","r":"John.15.26","rawR":"John.15.26","sourceRefs":[{"raw":"John.15.26","value":"John.15.26"}],"t":"ref","v":"15:26"},"; ",{"href":"?bref=John.16.7","r":"John.16.7","rawR":"John.16.7","sourceRefs":[{"raw":"John.16.7","value":"John.16.7"}],"t":"ref","v":"16:7"},"; ",{"href":"?bref=1Jn.2.1","r":"1Jn.2.1","rawR":"1Jn.2.1","sourceRefs":[{"raw":"1Jn.2.1","value":"1Jn.2.1"}],"t":"ref","v":"1 Jn 2:1"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.16.19-21","refs":[{"book":"JOB","endChapter":16,"endVerse":21,"startChapter":16,"startVerse":19}],"sourceAttributes":{"name":"Job.16.19-21","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[16],"sourceItemFragmentSha256":"94706cb666f95b158785011c8e68048540569834630b3fa1285588527de3ec6f","sourceItemName":"Job.16.19-21","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5722,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.16.19-21","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.16.19-21","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}