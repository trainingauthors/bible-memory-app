ionary/671a6220f6ba4cf305c5c3801b8eeabb644e18172a40dd0934540fcdab3bcf74.json","title":"Miscarriage"},"Taskmaster":{"file":"dictionary/447e968c568d6618c98bbfe747dc9998e97090e60990af37ec23e27802012c30.json","title":"Taskmaster*"}},"dictionaryRelated":[{"id":"Color","title":"Color"},{"id":"Day","title":"Day"},{"id":"Desert","title":"Desert"},{"id":"Hell","title":"Hell"},{"id":"JobBookof","title":"Job, Book of"},{"id":"Leviathan","title":"Leviathan"},{"id":"Liberty","title":"Liberty*"},{"id":"Miscarriage","title":"Miscarriage"},{"id":"Taskmaster","title":"Taskmaster*"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"darkness","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":29,"href":"?bref=Job.3.4-6","rawReference":"Job.3.4-6"}],"ruleId":"Darkness::Darkness::source_verse_citation","sourceHeadwordId":"Darkness"},"text":"If only that day had turned to darkness! May God above disregard it; may no light shine upon it.","verse":4},{"matchingRule":"reviewed_exact_headword","phrase":"darkness","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":29,"href":"?bref=Job.3.4-6","rawReference":"Job.3.4-6"}],"ruleId":"Darkness::Darkness::source_verse_citation","sourceHeadwordId":"Darkness"},"text":"May darkness and gloom reclaim it, and a cloud settle over it; may the blackness of the day overwhelm it.","verse":5},{"matchingRule":"reviewed_exact_headword","phrase":"darkness","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":29,"href":"?bref=Job.3.4-6","rawReference":"Job.3.4-6"}],"ruleId":"Darkness::Darkness::source_verse_citation","sourceHeadwordId":"Darkness"},"text":"If only darkness had taken that night away! May it not appear among the days of the year; may it never be entered in any of the months.","verse":6}],"id":"Darkness","label":"darkness","matchReviews":[{"ruleId":"Darkness::Darkness::source_verse_citation","scope":"source_verse_citation","senseReview":"Reviewed original headword and source sense. This substantive word is admitted only where the original article explicitly cites the exact occurrence verse; ambiguous homographs and known context mismatches are separately excluded. This is selective contextual evidence, not an automatic rule for every same-spelling word.","sourceHeadwordId":"Darkness","term":"Darkness"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Darkness","sourceTitle":"Darkness"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":["Complaints"],"sourceClass":"theme-title","t":"h"},{"c":["The Bible generally depicts complaining as wrong. For example, God judged the Israelites for grumbling about their hardships in the wilderness (",{"href":"?bref=Num.14.27-37","r":"Num.14.27-37","rawR":"Num.14.27-37","sourceRefs":[{"raw":"Num.14.27-37","value":"Num.14.27-37"}],"t":"ref","v":"Num 14:27-37"},"). Job complained mightily and earned God’s rebuke for it, yet God ultimately confirmed Job’s righteousness and rejected those who tried to stop him from complaining (",{"href":"?bref=Job.42.7-8","r":"Job.42.7-8","rawR":"Job.42.7-8","sourceRefs":[{"raw":"Job.42.7-8","value":"Job.42.7-8"}],"t":"ref","v":"Job 42:7-8"},")."],"sourceClass":"theme-body-fl","t":"p"},{"c":["Job’s fundamental complaint was that God did not give him a fair hearing to demonstrate his innocence. Job’s friends attacked him for trying to vindicate himself, but God upheld Job’s innocence. In a gracious but firm act of self-revelation, God rebuked Job for his overreaching self-defense and implied criticism of God’s fairness. God shifted Job’s focus away from his troubles and toward God himself (",{"href":"?bref=Job.38.1-41.34","r":"Job.38.1-41.34","rawR":"Job.38.1-41.34","sourceRefs":[{"raw":"Job.38.1-41.34","value":"Job.38.1-41.34"}],"t":"ref","v":"Job 38–41"},")."],"sourceClass":"theme-body","t":"p"},{"c":["Scripture admonishes us to rejoice and give thanks in all situations (",{"href":"?bref=Eph.5.20","r":"Eph.5.20","rawR":"Eph.5.20","sourceRefs":[{"raw":"Eph.5.20","value":"Eph.5.20"}],"t":"ref","v":"Eph 5:20"},"; ",{"href":"?bref=Phil.4.4","r":"Phil.4.4","rawR":"Phil.4.4","sourceRefs":[{"raw":"Phil.4.4","value":"Phil.4.4"}],"t":"ref","v":"Phil 4:4"},"; ",{"href":"?bref=1Thes.5.16-18","r":"1Thes.5.16-18","rawR":"1Thes.5.16-18","sourceRefs":[{"raw":"1Thes.5.16-18","value":"1Thes.5.16-18"}],"t":"ref","v":"1 Thes 5:16-18"},"). It also calls us to endure through suffering and to persist in prayer (",{"href":"?bref=Jas.5.10-18","r":"Jas.5.10-18","rawR":"Jas.5.10-18","sourceRefs":[{"raw":"Jas.5.10-18","value":"Jas.5.10-18"}],"t":"ref","v":"Jas 5:10-18"},"). If we do want to complain in prayer, we should follow the pattern of the psalms, which lead us past ourselves and back to God (see, e.g., ",{"href":"?bref=Ps.13.1-6","r":"Ps.13.1-6","rawR":"Ps.13.1-6","sourceRefs":[{"raw":"Ps.13.1-6","value":"Ps.13.1-6"}],"t":"ref","v":"Ps 13"},"). Job’s positive example (",{"href":"?bref=Jas.5.11","r":"Jas.5.11","rawR":"Jas.5.11","sourceRefs":[{"raw":"Jas.5.11","value":"Jas.5.11"}],"t":"ref","v":"Jas 5:11"},") is not so much in how he responded to his troubles or to his comforters but in how he responded to God (",{"href":"?bref=Job.40.3-5","r":"Job.40.3-5","rawR":"Job.40.3-5","sourceRefs":[{"raw":"Job.40.3-5","value":"Job.40.3-5"}],"t":"ref","v":"Job 40:3-5"},"; ",{"href":"?bref=Job.42.1-6","r":"Job.42.1-6","rawR":"Job.42.1-6","sourceRefs":[{"raw":"Job.42.1-6","value":"Job.42.1-6"}],"t":"ref","v":"42:1-6"},"). In the midst of difficult and confusing situations that may precipitate a desire to complain, we can still acknowledge the sovereignty and goodness of God."],"sourceClass":"theme-body","t":"p"},{"c":["Passages for Further Study"],"sourceClass":"theme-refs-title","t":"h"},{"c":[{"href":"?bref=Gen.4.13-14","r":"Gen.4.13-14","rawR":"Gen.4.13-14","sourceRefs":[{"raw":"Gen.4.13-14","value":"Gen.4.13-14"}],"t":"ref","v":"Gen 4:13-14"},"; ",{"href":"?bref=Exod.16.2-18","r":"Exod.16.2-18","rawR":"Exod.16.2-18","sourceRefs":[{"raw":"Exod.16.2-18","value":"Exod.16.2-18"}],"t":"ref","v":"Exod 16:2-18"},"; ",{"href":"?bref=Num.14.27-37","r":"Num.14.27-37","rawR":"Num.14.27-37","sourceRefs":[{"raw":"Num.14.27-37","value":"Num.14.27-37"}],"t":"ref","v":"Num 14:27-37"},"; ",{"href":"?bref=1Kgs.19.3-18","r":"1Kgs.19.3-18","rawR":"1Kgs.19.3-18","sourceRefs":[{"raw":"1Kgs.19.3-18","value":"1Kgs.19.3-18"}],"t":"ref","v":"1 Kgs 19:3-18"},"; ",{"href":"?bref=Job.3.1-26","r":"Job.3.1-26","rawR":"Job.3.1-26","sourceRefs":[{"raw":"Job.3.1-26","value":"Job.3.1-26"}],"t":"ref","v":"Job 3:1-26"},"; ",{"href":"?bref=Job.6.1-7.21","r":"Job.6.1-7.21","rawR":"Job.6.1-7.21","sourceRefs":[{"raw":"Job.6.1-7.21","value":"Job.6.1-7.21"}],"t":"ref","v":"6:1–7:21"},"; ",{"href":"?bref=Ps.38.1-22","r":"Ps.38.1-22","rawR":"Ps.38.1-22","sourceRefs":[{"raw":"Ps.38.1-22","value":"Ps.38.1-22"}],"t":"ref","v":"Pss 38"},"; ",{"href":"?bref=Ps.39.1-13","r":"Ps.39.1-13","rawR":"Ps.39.1-13","sourceRefs":[{"raw":"Ps.39.1-13","value":"Ps.39.1-13"}],"t":"ref","v":"39"},"; ",{"href":"?bref=Ps.44.1-26","r":"Ps.44.1-26","rawR":"Ps.44.1-26","sourceRefs":[{"raw":"Ps.44.1-26","value":"Ps.44.1-26"}],"t":"ref","v":"44"},"; ",{"href":"?bref=Ps.73.1-28","r":"Ps.73.1-28","rawR":"Ps.73.1-28","sourceRefs":[{"raw":"Ps.73.1-28","value":"Ps.73.1-28"}],"t":"ref","v":"73"},"; ",{"href":"?bref=Jer.20.14-18","r":"Jer.20.14-18","rawR":"Jer.20.14-18","sourceRefs":[{"raw":"Jer.20.14-18","value":"Jer.20.14-18"}],"t":"ref","v":"Jer 20:14-18"},"; ",{"href":"?bref=Jon.4.1-11","r":"Jon.4.1-11","rawR":"Jon.4.1-11","sourceRefs":[{"raw":"Jon.4.1-11","value":"Jon.4.1-11"}],"t":"ref","v":"Jon 4:1-11"},"; ",{"href":"?bref=Matt.27.46","r":"Matt.27.46","rawR":"Matt.27.46","sourceRefs":[{"raw":"Matt.27.46","value":"Matt.27.46"}],"t":"ref","v":"Matt 27:46"},"; ",{"href":"?bref=John.6.41-59","r":"John.6.41-59","rawR":"John.6.41-59","sourceRefs":[{"raw":"John.6.41-59","value":"John.6.41-59"}],"t":"ref","v":"John 6:41-59"},"; ",{"href":"?bref=1Cor.10.1-10","r":"1Cor.10.1-10","rawR":"1Cor.10.1-10","sourceRefs":[{"raw":"1Cor.10.1-10","value":"1Cor.10.1-10"}],"t":"ref","v":"1 Cor 10:1-10"},"; ",{"href":"?bref=Eph.5.20","r":"Eph.5.20","rawR":"Eph.5.20","sourceRefs":[{"raw":"Eph.5.20","value":"Eph.5.20"}],"t":"ref","v":"Eph 5:20"},"; ",{"href":"?bref=Phil.2.14-15","r":"Phil.2.14-15","rawR":"Phil.2.14-15","sourceRefs":[{"raw":"Phil.2.14-15","value":"Phil.2.14-15"}],"t":"ref","v":"Phil 2:14-15"},"; ",{"href":"?bref=Jas.5.9-11","r":"Jas.5.9-11","rawR":"Jas.5.9-11","sourceRefs":[{"raw":"Jas.5.9-11","value":"Jas.5.9-11"}],"t":"ref","v":"Jas 5:9-11"}],"sourceClass":"theme-refs","t":"p"}],"id":"ThemeNote:Complaints","refs":[{"book":"JOB","endChapter":3,"endVerse":26,"startChapter":3,"startVerse":1}],"sourceAttributes":{"name":"Complaints","product":"TyndaleOpenStudyNotes","typename":"ThemeNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"612b325d7e99485ef62f6a95478543f3104538053c82bfb0c0bcc3ae5ec328e6","sourceItemName":"Complaints","sourceMember":"Tyndale Open Study Notes/ThemeNotes.xml","sourceOrder":100,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.3.1-26","sourceRelease":"1.25","sourceTitleExact":"Complaints","supplementPointersNotIncludedAsContent":[],"title":"Complaints","type":"ThemeNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.3.1-26","r":"Job.3.1-26","rawR":"Job.3.1-26","sourceRefs":[{"raw":"Job.3.1-26","value":"Job.3.1-26"}],"t":"ref","v":"3:1-26"}],"sourceClass":"sn-ref","t":"span"}," Job’s outburst did not mean that his integrity had cracked under the strain (",{"href":"?bref=Job.42.7-8","r":"Job.42.7-8","rawR":"Job.42.7-8","sourceRefs":[{"raw":"Job.42.7-8","value":"Job.42.7-8"}],"t":"ref","v":"42:7-8"},"; ",{"href":"?bref=Jas.5.11","r":"Jas.5.11","rawR":"Jas.5.11","sourceRefs":[{"raw":"Jas.5.11","value":"Jas.5.11"}],"t":"ref","v":"Jas 5:11"},"). Elijah and Jeremiah, both godly men, used the same hyperbolic language (",{"href":"?bref=1Kgs.19.4","r":"1Kgs.19.4","rawR":"1Kgs.19.4","sourceRefs":[{"raw":"1Kgs.19.4","value":"1Kgs.19.4"}],"t":"ref","v":"1 Kgs 19:4"},"; ",{"href":"?bref=Jer.20.14-18","r":"Jer.20.14-18","rawR":"Jer.20.14-18","sourceRefs":[{"raw":"Jer.20.14-18","value":"Jer.20.14-18"}],"t":"ref","v":"Jer 20:14-18"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.3.1-26","refs":[{"book":"JOB","endChapter":3,"endVerse":26,"startChapter":3,"startVerse":1}],"sourceAttributes":{"name":"Job.3.1-26","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"2ff38da0cd0701b8c9c7d32429cd3559f67281dd7572cfab7e0c3bd7ef75eac1","sourceItemName":"Job.3.1-26","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5583,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.3.1-26","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.3.1-26","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.3.1-10","r":"Job.3.1-10","rawR":"Job.3.1-10","sourceRefs":[{"raw":"Job.3.1-10","value":"Job.3.1-10"}],"t":"ref","v":"3:1-10"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Job spoke"],"sourceClass":"sn-excerpt","t":"span"}," and thus put at risk his refusal to sin with his mouth (",{"href":"?bref=Job.1.21","r":"Job.1.21","rawR":"Job.1.21","sourceRefs":[{"raw":"Job.1.21","value":"Job.1.21"}],"t":"ref","v":"1:21"},"; ",{"href":"?bref=Job.2.10","r":"Job.2.10","rawR":"Job.2.10","sourceRefs":[{"raw":"Job.2.10","value":"Job.2.10"}],"t":"ref","v":"2:10"},"). • Job ",{"c":["cursed the day of his birth"],"sourceClass":"sn-excerpt","t":"span"}," in great detail. However, his words sound more like pitiful complaints. Job didn’t curse God as his creator, but he lamented the conditions of his existence."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.3.1-10","refs":[{"book":"JOB","endChapter":3,"endVerse":10,"startChapter":3,"startVerse":1}],"sourceAttributes":{"name":"Job.3.1-10","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"cc29343b6903de422b383b5075e687cd939d3ccfd96e8a62f90eb2863d567a31","sourceItemName":"Job.3.1-10","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5584,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.3.1-10","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.3.1-10","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.3.5","r":"Job.3.5","rawR":"Job.3.5","sourceRefs":[{"raw":"Job.3.5","value":"Job.3.5"}],"t":"ref","v":"3:5"}],"sourceClass":"sn-ref","t":"span"}," Job longed for the sinister ",{"c":["darkness"],"sourceClass":"sn-excerpt","t":"span"}," of the underworld (",{"href":"?bref=Exod.10.22","r":"Exod.10.22","rawR":"Exod.10.22","sourceRefs":[{"raw":"Exod.10.22","value":"Exod.10.22"}],"t":"ref","v":"Exod 10:22"},"; ",{"href":"?bref=Pr.4.19","r":"Pr.4.19","rawR":"Pr.4.19","sourceRefs":[{"raw":"Pr.4.19","value":"Pr.4.19"}],"t":"ref","v":"Prov 4:19"},"; ",{"href":"?bref=Joel.2.2","r":"Joel.2.2","rawR":"Joel.2.2","sourceRefs":[{"raw":"Joel.2.2","value":"Joel.2.2"}],"t":"ref","v":"Joel 2:2"},") and the ",{"c":["gloom"],"sourceClass":"sn-excerpt","t":"span"}," of death (",{"href":"?bref=Job.10.21-22","r":"Job.10.21-22","rawR":"Job.10.21-22","sourceRefs":[{"raw":"Job.10.21-22","value":"Job.10.21-22"}],"t":"ref","v":"Job 10:21-22"},"; ",{"href":"?bref=Job.38.17","r":"Job.38.17","rawR":"Job.38.17","sourceRefs":[{"raw":"Job.38.17","value":"Job.38.17"}],"t":"ref","v":"38:17"},") to ",{"c":["claim"],"sourceClass":"sn-excerpt","t":"span"}," the ",{"c":["day"],"sourceClass":"sn-excerpt","t":"span"}," of his birth."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.3.5","refs":[{"book":"JOB","endChapter":3,"endVerse":5,"startChapter":3,"startVerse":5}],"sourceAttributes":{"name":"Job.3.5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[3],"sourceItemFragmentSha256":"5aae5d10ce881ac933e6fb3757701830fb4d77319da518f9b0e5992ff88fd41a","sourceItemName":"Job.3.5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5585,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.3.5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.3.5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.3.8","r":"Job.3.8","rawR":"Job.3.8","sourceRefs":[{"raw":"Job.3.8","value":"Job.3.8"}],"t":"ref","v":"3:8"}],"sourceClass":"sn-ref","t":"span"}," The expression ",{"c":["experts at cursing"],"sourceClass":"sn-excerpt","t":"span"}," refers to professional cursers such as Balaam (",{"href":"?bref=Num.22.1-24.25","r":"Num.22.1-24.25","rawR":"Num.22.1-24.25","sourceRefs":[{"raw":"Num.22.1-24.25","value":"Num.22.1-24.25"}],"t":"ref","v":"Num 22–24"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.3.8"