9b","sourceItemName":"Job.26.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5810,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.26.4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.26.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.26.5-6","r":"Job.26.5-6","rawR":"Job.26.5-6","sourceRefs":[{"raw":"Job.26.5-6","value":"Job.26.5-6"}],"t":"ref","v":"26:5-6"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["The underworld"],"sourceClass":"sn-excerpt","t":"span"}," (Hebrew ",{"c":["Sheol"],"sourceClass":"ital","t":"span"},"), the abode of all the dead, is located ",{"c":["beneath the waters"],"sourceClass":"sn-excerpt","t":"span"}," of the sea. • ",{"c":["The place of destruction"],"sourceClass":"sn-excerpt","t":"span"}," (Hebrew ",{"c":["Abaddon"],"sourceClass":"ital","t":"span"},") existed specifically for the wicked."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.26.5-6","refs":[{"book":"JOB","endChapter":26,"endVerse":6,"startChapter":26,"startVerse":5}],"sourceAttributes":{"name":"Job.26.5-6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[26],"sourceItemFragmentSha256":"01aa4cc457331568f5761a9693b95b2c0399a2f09e7e4faa5bd06b4c6e85a635","sourceItemName":"Job.26.5-6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5811,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.26.5-6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.26.5-6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.26.7","r":"Job.26.7","rawR":"Job.26.7","sourceRefs":[{"raw":"Job.26.7","value":"Job.26.7"}],"t":"ref","v":"26:7"}],"sourceClass":"sn-ref","t":"span"}," The Hebrew ",{"c":["tsapon"],"sourceClass":"hebrew","t":"span"}," (“north,” ",{"href":"?bref=Gen.13.14","r":"Gen.13.14","rawR":"Gen.13.14","sourceRefs":[{"raw":"Gen.13.14","value":"Gen.13.14"}],"t":"ref","v":"Gen 13:14"},") sometimes refers to the ",{"c":["northern"],"sourceClass":"sn-excerpt","t":"span"}," mountain of the Canaanite gods (the Canaanite equivalent of Olympus); here the NLT understands it to refer to the ",{"c":["sky"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," stretched out ",{"c":["over empty space"],"sourceClass":"sn-excerpt","t":"span"}," (see ",{"href":"?bref=Gen.1.6-8","r":"Gen.1.6-8","rawR":"Gen.1.6-8","sourceRefs":[{"raw":"Gen.1.6-8","value":"Gen.1.6-8"}],"t":"ref","v":"Gen 1:6-8"},"; ",{"href":"?bref=Ps.104.2-3","r":"Ps.104.2-3","rawR":"Ps.104.2-3","sourceRefs":[{"raw":"Ps.104.2-3","value":"Ps.104.2-3"}],"t":"ref","v":"Ps 104:2-3"},"; ",{"href":"?bref=Isa.40.22-23","r":"Isa.40.22-23","rawR":"Isa.40.22-23","sourceRefs":[{"raw":"Isa.40.22-23","value":"Isa.40.22-23"}],"t":"ref","v":"Isa 40:22-23"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.26.7","refs":[{"book":"JOB","endChapter":26,"endVerse":7,"startChapter":26,"startVerse":7}],"sourceAttributes":{"name":"Job.26.7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[26],"sourceItemFragmentSha256":"8d5f12b29ad4df37ce8f3a46bb82bdc6b6f49a54a895de866fa75ad7be7cf955","sourceItemName":"Job.26.7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5812,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.26.7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.26.7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.26.10","r":"Job.26.10","rawR":"Job.26.10","sourceRefs":[{"raw":"Job.26.10","value":"Job.26.10"}],"t":"ref","v":"26:10"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["created the horizon:"],"sourceClass":"sn-excerpt","t":"span"}," See ",{"href":"?bref=Gen.1.6-10","r":"Gen.1.6-10","rawR":"Gen.1.6-10","sourceRefs":[{"raw":"Gen.1.6-10","value":"Gen.1.6-10"}],"t":"ref","v":"Gen 1:6-10"},"; ",{"href":"?bref=Ps.104.6-9","r":"Ps.104.6-9","rawR":"Ps.104.6-9","sourceRefs":[{"raw":"Ps.104.6-9","value":"Ps.104.6-9"}],"t":"ref","v":"Ps 104:6-9"},"; ",{"href":"?bref=Pr.8.29","r":"Pr.8.29","rawR":"Pr.8.29","sourceRefs":[{"raw":"Pr.8.29","value":"Pr.8.29"}],"t":"ref","v":"Prov 8:29"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.26.10","refs":[{"book":"JOB","endChapter":26,"endVerse":10,"startChapter":26,"startVerse":10}],"sourceAttributes":{"name":"Job.26.10","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[26],"sourceItemFragmentSha256":"827456bfe364c680b18ad8e37293ef3f267ea6117456de173c40d05fbbfa1fe6","sourceItemName":"Job.26.10","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5813,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.26.10","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.26.10","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.26.11","r":"Job.26.11","rawR":"Job.26.11","sourceRefs":[{"raw":"Job.26.11","value":"Job.26.11"}],"t":"ref","v":"26:11"}],"sourceClass":"sn-ref","t":"span"}," Mountains at the edge of the horizon might be the ",{"c":["foundations"],"sourceClass":"sn-excerpt","t":"span"}," (or “pillars,” ",{"href":"?bref=Judg.16.25-26","r":"Judg.16.25-26","rawR":"Judg.16.25-26","sourceRefs":[{"raw":"Judg.16.25-26","value":"Judg.16.25-26"}],"t":"ref","v":"Judg 16:25-26"},") ",{"c":["of heaven"],"sourceClass":"sn-excerpt","t":"span"}," or the earth (",{"href":"?bref=Job.9.6","r":"Job.9.6","rawR":"Job.9.6","sourceRefs":[{"raw":"Job.9.6","value":"Job.9.6"}],"t":"ref","v":"Job 9:6"},"). They were thought to reach from below the waters of the sea (",{"href":"?bref=Jon.2.6","r":"Jon.2.6","rawR":"Jon.2.6","sourceRefs":[{"raw":"Jon.2.6","value":"Jon.2.6"}],"t":"ref","v":"Jon 2:6"},") and up to the clouds to support the vaults of heaven."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.26.11","refs":[{"book":"JOB","endChapter":26,"endVerse":11,"startChapter":26,"startVerse":11}],"sourceAttributes":{"name":"Job.26.11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[26],"sourceItemFragmentSha256":"6154034b186e61ce5b3520ed97ace882e53ccdccad4f5287d650912cbdf20a87","sourceItemName":"Job.26.11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5814,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.26.11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.26.11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.26.12","r":"Job.26.12","rawR":"Job.26.12","sourceRefs":[{"raw":"Job.26.12","value":"Job.26.12"}],"t":"ref","v":"26:12"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["the sea grew calm"],"sourceClass":"sn-excerpt","t":"span"}," (cp. ",{"href":"?bref=Exod.14.21","r":"Exod.14.21","rawR":"Exod.14.21","sourceRefs":[{"raw":"Exod.14.21","value":"Exod.14.21"}],"t":"ref","v":"Exod 14:21"},"; ",{"href":"?bref=Mark.4.39","r":"Mark.4.39","rawR":"Mark.4.39","sourceRefs":[{"raw":"Mark.4.39","value":"Mark.4.39"}],"t":"ref","v":"Mark 4:39"},"): Or ",{"c":["the sea was stirred up"],"sourceClass":"ital","t":"span"}," (cp. ",{"href":"?bref=Isa.51.15","r":"Isa.51.15","rawR":"Isa.51.15","sourceRefs":[{"raw":"Isa.51.15","value":"Isa.51.15"}],"t":"ref","v":"Isa 51:15"},"; ",{"href":"?bref=Jer.31.35","r":"Jer.31.35","rawR":"Jer.31.35","sourceRefs":[{"raw":"Jer.31.35","value":"Jer.31.35"}],"t":"ref","v":"Jer 31:35"},"). In either interpretation, God performed a miracle on behalf of his people. • ",{"c":["crushed the great sea monster:"],"sourceClass":"sn-excerpt","t":"span"}," God’s dominance over the sea demythologized popular beliefs about the sea’s divinity. See also ",{"href":"?bref=Ps.74.13-14","r":"Ps.74.13-14","rawR":"Ps.74.13-14","sourceRefs":[{"raw":"Ps.74.13-14","value":"Ps.74.13-14"}],"t":"ref","v":"Pss 74:13-14"},"; ",{"href":"?bref=Ps.89.9-10","r":"Ps.89.9-10","rawR":"Ps.89.9-10","sourceRefs":[{"raw":"Ps.89.9-10","value":"Ps.89.9-10"}],"t":"ref","v":"89:9-10"},"; ",{"href":"?bref=Isa.27.1","r":"Isa.27.1","rawR":"Isa.27.1","sourceRefs":[{"raw":"Isa.27.1","value":"Isa.27.1"}],"t":"ref","v":"Isa 27:1"},"; ",{"href":"?bref=Isa.51.9-10","r":"Isa.51.9-10","rawR":"Isa.51.9-10","sourceRefs":[{"raw":"Isa.51.9-10","value":"Isa.51.9-10"}],"t":"ref","v":"51:9-10"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.26.12","refs":[{"book":"JOB","endChapter":26,"endVerse":12,"startChapter":26,"startVerse":12}],"sourceAttributes":{"name":"Job.26.12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[26],"sourceItemFragmentSha256":"fd42f90193e6eb9fbcf32a1f5b8b71a6e0eeb06ca5fb87297f28d2d92d029281","sourceItemName":"Job.26.12","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5815,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.26.12","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.26.12","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.26.13","r":"Job.26.13","rawR":"Job.26.13","sourceRefs":[{"raw":"Job.26.13","value":"Job.26.13"}],"t":"ref","v":"26:13"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["His Spirit"],"sourceClass":"sn-excerpt","t":"span"}," (or ",{"c":["wind"],"sourceClass":"ital","t":"span"},"): God’s authority clears the skies after a storm (",{"href":"?bref=Job.26.12","r":"Job.26.12","rawR":"Job.26.12","sourceRefs":[{"raw":"Job.26.12","value":"Job.26.12"}],"t":"ref","v":"26:12"},"). • The ",{"c":["gliding serpent"],"sourceClass":"sn-excerpt","t":"span"}," corresponds to Yam and Rahab (see ",{"href":"?item=Job.7.12_StudyNote_Filament","id":"Job.7.12_StudyNote_Filament","rawId":"Job.7.12_StudyNote_Filament","t":"link","v":"study note on 7:12"},"); it provides background for the image of Satan as a dragon (",{"href":"?bref=Isa.27.1","r":"Isa.27.1","rawR":"Isa.27.1","sourceRefs":[{"raw":"Isa.27.1","value":"Isa.27.1"}],"t":"ref","v":"Isa 27:1"},"; also ",{"href":"?bref=Ps.74.13-14","r":"Ps.74.13-14","rawR":"Ps.74.13-14","sourceRefs":[{"raw":"Ps.74.13-14","value":"Ps.74.13-14"}],"t":"ref","v":"Ps 74:13-14"},"; see ",{"href":"?bref=Gen.3.15","r":"Gen.3.15","rawR":"Gen.3.15","sourceRefs":[{"raw":"Gen.3.15","value":"Gen.3.15"}],"t":"ref","v":"Gen 3:15"},"; ",{"href":"?bref=Rom.16.20","r":"Rom.16.20","rawR":"Rom.16.20","sourceRefs":[{"raw":"Rom.16.20","value":"Rom.16.20"}],"t":"ref","v":"Rom 16:20"},"; ",{"href":"?bref=Rev.12.9","r":"Rev.12.9","rawR":"Rev.12.9","sourceRefs":[{"raw":"Rev.12.9","value":"Rev.12.9"}],"t":"ref","v":"Rev 12:9"},"; ",{"href":"?bref=Rev.20.2","r":"Rev.20.2","rawR":"Rev.20.2","sourceRefs":[{"raw":"Rev.20.2","value":"Rev.20.2"}],"t":"ref","v":"20:2"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.26.13","refs":[{"book":"JOB","endChapter":26,"endVerse":13,"startChapter":26,"startVerse":13}],"sourceAttributes":{"name":"Job.26.13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[26],"sourceItemFragmentSha256":"b087cb5a27a6c5c0a9ad40a758f09652b429009c328f59f72d7d371ce02a2d9d","sourceItemName":"Job.26.13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5816,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.26.13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.26.13","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}