b.1.1","r":"Job.1.1","rawR":"Job.1.1","sourceRefs":[{"raw":"Job.1.1","value":"Job.1.1"}],"t":"ref","v":"Job 1:1"},"). • Elihu repeatedly stated that he was ",{"c":["angry"],"sourceClass":"sn-excerpt","t":"span"},{"c":[";"],"sourceClass":"ital","t":"span"}," he probably regarded his anger as righteous zeal (",{"href":"?bref=Ps.69.9","r":"Ps.69.9","rawR":"Ps.69.9","sourceRefs":[{"raw":"Ps.69.9","value":"Ps.69.9"}],"t":"ref","v":"Ps 69:9"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.32.2","refs":[{"book":"JOB","endChapter":32,"endVerse":2,"startChapter":32,"startVerse":2}],"sourceAttributes":{"name":"Job.32.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[32],"sourceItemFragmentSha256":"ae1aaea9245a4e230624956036d0982056cad2b48da12c278eba37a69da45782","sourceItemName":"Job.32.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5871,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.32.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.32.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.32.4-7","r":"Job.32.4-7","rawR":"Job.32.4-7","sourceRefs":[{"raw":"Job.32.4-7","value":"Job.32.4-7"}],"t":"ref","v":"32:4-7"}],"sourceClass":"sn-ref","t":"span"}," Elihu’s deference to elders followed a well-known principle (see also ",{"href":"?bref=Job.12.12","r":"Job.12.12","rawR":"Job.12.12","sourceRefs":[{"raw":"Job.12.12","value":"Job.12.12"}],"t":"ref","v":"12:12"},"; ",{"href":"?bref=Job.15.10","r":"Job.15.10","rawR":"Job.15.10","sourceRefs":[{"raw":"Job.15.10","value":"Job.15.10"}],"t":"ref","v":"15:10"},"; ",{"href":"?bref=Lev.19.32","r":"Lev.19.32","rawR":"Lev.19.32","sourceRefs":[{"raw":"Lev.19.32","value":"Lev.19.32"}],"t":"ref","v":"Lev 19:32"},"; ",{"href":"?bref=1Tim.5.1","r":"1Tim.5.1","rawR":"1Tim.5.1","sourceRefs":[{"raw":"1Tim.5.1","value":"1Tim.5.1"}],"t":"ref","v":"1 Tim 5:1"},"; ",{"href":"?bref=1Pet.5.5","r":"1Pet.5.5","rawR":"1Pet.5.5","sourceRefs":[{"raw":"1Pet.5.5","value":"1Pet.5.5"}],"t":"ref","v":"1 Pet 5:5"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.32.4-7","refs":[{"book":"JOB","endChapter":32,"endVerse":7,"startChapter":32,"startVerse":4}],"sourceAttributes":{"name":"Job.32.4-7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[32],"sourceItemFragmentSha256":"889b74d889227658745403ce6bebe23fd573f1c6698386cd98aff20deeee3276","sourceItemName":"Job.32.4-7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5872,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.32.4-7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.32.4-7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.32.8-9","r":"Job.32.8-9","rawR":"Job.32.8-9","sourceRefs":[{"raw":"Job.32.8-9","value":"Job.32.8-9"}],"t":"ref","v":"32:8-9"}],"sourceClass":"sn-ref","t":"span"}," The ",{"c":["spirit within people"],"sourceClass":"sn-excerpt","t":"span"}," might not be the prophetic Spirit that Elihu later appeals to (",{"href":"?bref=Job.33.14-15","r":"Job.33.14-15","rawR":"Job.33.14-15","sourceRefs":[{"raw":"Job.33.14-15","value":"Job.33.14-15"}],"t":"ref","v":"33:14-15"},"), as Eliphaz had done (",{"href":"?bref=Job.4.12-17","r":"Job.4.12-17","rawR":"Job.4.12-17","sourceRefs":[{"raw":"Job.4.12-17","value":"Job.4.12-17"}],"t":"ref","v":"4:12-17"},"; cp. ",{"href":"?bref=Job.32.18-20","r":"Job.32.18-20","rawR":"Job.32.18-20","sourceRefs":[{"raw":"Job.32.18-20","value":"Job.32.18-20"}],"t":"ref","v":"32:18-20"},"). This spirit might simply exist by virtue of creation (",{"href":"?bref=Job.33.4","r":"Job.33.4","rawR":"Job.33.4","sourceRefs":[{"raw":"Job.33.4","value":"Job.33.4"}],"t":"ref","v":"33:4"},"; ",{"href":"?bref=Gen.2.7","r":"Gen.2.7","rawR":"Gen.2.7","sourceRefs":[{"raw":"Gen.2.7","value":"Gen.2.7"}],"t":"ref","v":"Gen 2:7"},"; ",{"href":"?bref=Acts.17.25","r":"Acts.17.25","rawR":"Acts.17.25","sourceRefs":[{"raw":"Acts.17.25","value":"Acts.17.25"}],"t":"ref","v":"Acts 17:25"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.32.8-9","refs":[{"book":"JOB","endChapter":32,"endVerse":9,"startChapter":32,"startVerse":8}],"sourceAttributes":{"name":"Job.32.8-9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[32],"sourceItemFragmentSha256":"a41156fd08e39952dff6920b3ade9ffa1ee19e3ccd28b5b343005d4d62183cb0","sourceItemName":"Job.32.8-9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5873,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.32.8-9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.32.8-9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.32.15-16","r":"Job.32.15-16","rawR":"Job.32.15-16","sourceRefs":[{"raw":"Job.32.15-16","value":"Job.32.15-16"}],"t":"ref","v":"32:15-16"}],"sourceClass":"sn-ref","t":"span"}," As translated, the phrase ",{"c":["you sit there . . . you are silent"],"sourceClass":"sn-excerpt","t":"span"}," is addressed to Job’s friends. An alternate translation is ",{"c":["they sit there . . . they are silent,"],"sourceClass":"ital","t":"span"}," in which case Elihu is speaking to Job about his friends."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.32.15-16","refs":[{"book":"JOB","endChapter":32,"endVerse":16,"startChapter":32,"startVerse":15}],"sourceAttributes":{"name":"Job.32.15-16","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[32],"sourceItemFragmentSha256":"bdfb9d636c8c1592de74d013d4d22f6b5b5196e7efc0a82cb6f8c4393b87f63d","sourceItemName":"Job.32.15-16","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5874,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.32.15-16","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.32.15-16","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.32.18-20","r":"Job.32.18-20","rawR":"Job.32.18-20","sourceRefs":[{"raw":"Job.32.18-20","value":"Job.32.18-20"}],"t":"ref","v":"32:18-20"}],"sourceClass":"sn-ref","t":"span"}," The length of Elihu’s speech (",{"href":"?bref=Job.32.1-37.24","r":"Job.32.1-37.24","rawR":"Job.32.1-37.24","sourceRefs":[{"raw":"Job.32.1-37.24","value":"Job.32.1-37.24"}],"t":"ref","v":"32:1–37:24"},") demonstrates that he truly was ",{"c":["full of pent-up words"],"sourceClass":"sn-excerpt","t":"span"},". • Elihu probably thought ",{"c":["the spirit"],"sourceClass":"sn-excerpt","t":"span"}," (Hebrew ",{"c":["ruakh"],"sourceClass":"hebrew","t":"span"},") ",{"c":["within"],"sourceClass":"sn-excerpt","t":"span"}," him was prophetic urgency (",{"href":"?bref=Job.32.8","r":"Job.32.8","rawR":"Job.32.8","sourceRefs":[{"raw":"Job.32.8","value":"Job.32.8"}],"t":"ref","v":"32:8"},", ",{"href":"?bref=Job.32.19-20","r":"Job.32.19-20","rawR":"Job.32.19-20","sourceRefs":[{"raw":"Job.32.19-20","value":"Job.32.19-20"}],"t":"ref","v":"19-20"},"; ",{"href":"?bref=Ps.39.3","r":"Ps.39.3","rawR":"Ps.39.3","sourceRefs":[{"raw":"Ps.39.3","value":"Ps.39.3"}],"t":"ref","v":"Ps 39:3"},"), but the reader might find him full of ",{"c":["wind"],"sourceClass":"ital","t":"span"}," (Hebrew ",{"c":["ruakh;"],"sourceClass":"hebrew","t":"span"}," see ",{"href":"?item=Job.15.2-3_StudyNote_Filament","id":"Job.15.2-3_StudyNote_Filament","rawId":"Job.15.2-3_StudyNote_Filament","t":"link","v":"study note on Job 15:2-3"},"). • Like Zophar, Elihu ",{"c":["must speak to find relief"],"sourceClass":"sn-excerpt","t":"span"}," (cp. ",{"href":"?bref=Job.20.2","r":"Job.20.2","rawR":"Job.20.2","sourceRefs":[{"raw":"Job.20.2","value":"Job.20.2"}],"t":"ref","v":"20:2"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.32.18-20","refs":[{"book":"JOB","endChapter":32,"endVerse":20,"startChapter":32,"startVerse":18}],"sourceAttributes":{"name":"Job.32.18-20","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[32],"sourceItemFragmentSha256":"34cf559d77818370169253f86cab78c9d718ebcd31a2c2fcaa1695f5d50028c4","sourceItemName":"Job.32.18-20","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5875,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.32.18-20","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.32.18-20","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}