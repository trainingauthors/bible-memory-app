":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5909,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.36.12","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.36.12","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.36.31","r":"Job.36.31","rawR":"Job.36.31","sourceRefs":[{"raw":"Job.36.31","value":"Job.36.31"}],"t":"ref","v":"36:31"}],"sourceClass":"sn-ref","t":"span"}," The Hebrew ",{"c":["yadin"],"sourceClass":"hebrew","t":"span"}," can mean ",{"c":["he governs"],"sourceClass":"ital","t":"span"}," or ",{"c":["he nourishes"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," which parallels ",{"c":["food in abundance"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=Job.38.26","r":"Job.38.26","rawR":"Job.38.26","sourceRefs":[{"raw":"Job.38.26","value":"Job.38.26"}],"t":"ref","v":"38:26"},"; ",{"href":"?bref=Ps.65.9-13","r":"Ps.65.9-13","rawR":"Ps.65.9-13","sourceRefs":[{"raw":"Ps.65.9-13","value":"Ps.65.9-13"}],"t":"ref","v":"Pss 65:9-13"},"; ",{"href":"?bref=Ps.104.13-15","r":"Ps.104.13-15","rawR":"Ps.104.13-15","sourceRefs":[{"raw":"Ps.104.13-15","value":"Ps.104.13-15"}],"t":"ref","v":"104:13-15"},", ",{"href":"?bref=Ps.104.27-28","r":"Ps.104.27-28","rawR":"Ps.104.27-28","sourceRefs":[{"raw":"Ps.104.27-28","value":"Ps.104.27-28"}],"t":"ref","v":"27-28"},"). The more common meaning for ",{"c":["yadin"],"sourceClass":"hebrew","t":"span"}," is “judge,” which would mean that God does all things to bless his people and judge his enemies (",{"href":"?bref=Job.37.11-13","r":"Job.37.11-13","rawR":"Job.37.11-13","sourceRefs":[{"raw":"Job.37.11-13","value":"Job.37.11-13"}],"t":"ref","v":"Job 37:11-13"},"; ",{"href":"?bref=Job.38.22-