":"Num.11.15","value":"Num.11.15"}],"t":"ref","v":"Num 11:15"},"; ",{"href":"?bref=1Kgs.19.4","r":"1Kgs.19.4","rawR":"1Kgs.19.4","sourceRefs":[{"raw":"1Kgs.19.4","value":"1Kgs.19.4"}],"t":"ref","v":"1 Kgs 19:4"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.6.9","refs":[{"book":"JOB","endChapter":6,"endVerse":9,"startChapter":6,"startVerse":9}],"sourceAttributes":{"name":"Job.6.9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[6],"sourceItemFragmentSha256":"d769ded899d0aaa809609773ab4a8bc7986f6afc71f648e0157b4f8a40df0e9b","sourceItemName":"Job.6.9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5620,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.6.9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.6.9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.6.14-27","r":"Job.6.14-27","rawR":"Job.6.14-27","sourceRefs":[{"raw":"Job.6.14-27","value":"Job.6.14-27"}],"t":"ref","v":"6:14-27"}],"sourceClass":"sn-ref","t":"span"}," Job and his friends might have been bound by a covenant of loyalty and faithfulness (Hebrew ",{"c":["khesed;"],"sourceClass":"hebrew","t":"span"}," see ",{"href":"?bref=Gen.21.23","r":"Gen.21.23","rawR":"Gen.21.23","sourceRefs":[{"raw":"Gen.21.23","value":"Gen.21.23"}],"t":"ref","v":"Gen 21:23"},"; ",{"href":"?bref=Exod.15.13","r":"Exod.15.13","rawR":"Exod.15.13","sourceRefs":[{"raw":"Exod.15.13","value":"Exod.15.13"}],"t":"ref","v":"Exod 15:13"},"; ",{"href":"?bref=1Chr.16.34","r":"1Chr.16.34","rawR":"1Chr.16.34","sourceRefs":[{"raw":"1Chr.16.34","value":"1Chr.16.34"}],"t":"ref","v":"1 Chr 16:34"},") that made them like brothers (",{"href":"?bref=Job.6.14-15","r":"Job.6.14-15","rawR":"Job.6.14-15","sourceRefs":[{"raw":"Job.6.14-15","value":"Job.6.14-15"}],"t":"ref","v":"Job 6:14-15"},"), protectors (",{"href":"?bref=Job.6.21-23","r":"Job.6.21-23","rawR":"Job.6.21-23","sourceRefs":[{"raw":"Job.6.21-23","value":"Job.6.21-23"}],"t":"ref","v":"6:21-23"},"), and trusted friends (",{"href":"?bref=Job.6.27","r":"Job.6.27","rawR":"Job.6.27","sourceRefs":[{"raw":"Job.6.27","value":"Job.6.27"}],"t":"ref","v":"6:27"},"). If this was the case, Job was accusing his friends of violating their covenant with him."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.6.14-27","refs":[{"book":"JOB","endChapter":6,"endVerse":27,"startChapter":6,"startVerse":14}],"sourceAttributes":{"name":"Job.6.14-27","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[6],"sourceItemFragmentSha256":"e424f7329a3931375a809abdc15dc612c1189ccad80b433fdbed85172adf72c2","sourceItemName":"Job.6.14-27","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5621,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.6.14-27","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.6.14-27","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.6.19","r":"Job.6.19","rawR":"Job.6.19","sourceRefs":[{"raw":"Job.6.19","value":"Job.6.19"}],"t":"ref","v":"6:19"}],"sourceClass":"sn-ref","t":"span"},"  The city of ",{"c":["Tema"],"sourceClass":"sn-excerpt","t":"span"}," in the northern Arabian desert was at the junction of roads from Damascus to Mecca and from the Persian Gulf to Aqaba (",{"href":"?bref=Isa.21.14","r":"Isa.21.14","rawR":"Isa.21.14","sourceRefs":[{"raw":"Isa.21.14","value":"Isa.21.14"}],"t":"ref","v":"Isa 21:14"},"; ",{"href":"?bref=Jer.25.23","r":"Jer.25.23","rawR":"Jer.25.23","sourceRefs":[{"raw":"Jer.25.23","value":"Jer.25.23"}],"t":"ref","v":"Jer 25:23"},"). It might have been named after one of Ishmael’s descendants (",{"href":"?bref=Gen.25.15","r":"Gen.25.15","rawR":"Gen.25.15","sourceRefs":[{"raw":"Gen.25.15","value":"Gen.25.15"}],"t":"ref","v":"Gen 25:15"},"). It was not the same as Teman, Eliphaz’s home in Edom. • ",{"c":["Sheba,"],"sourceClass":"sn-excerpt","t":"span"}," located in southwest Arabia, was a market city for precious commodities (",{"href":"?bref=Ps.72.10","r":"Ps.72.10","rawR":"Ps.72.10","sourceRefs":[{"raw":"Ps.72.10","value":"Ps.72.10"}],"t":"ref","v":"Ps 72:10"},", ",{"href":"?bref=Ps.72.15","r":"Ps.72.15","rawR":"Ps.72.15","sourceRefs":[{"raw":"Ps.72.15","value":"Ps.72.15"}],"t":"ref","v":"15"},"; ",{"href":"?bref=Isa.60.6","r":"Isa.60.6","rawR":"Isa.60.6","sourceRefs":[{"raw":"Isa.60.6","value":"Isa.60.6"}],"t":"ref","v":"Isa 60:6"},"; ",{"href":"?bref=Jer.6.20","r":"Jer.6.20","rawR":"Jer.6.20","sourceRefs":[{"raw":"Jer.6.20","value":"Jer.6.20"}],"t":"ref","v":"Jer 6:20"},"; ",{"href":"?bref=Ezek.27.22-23","r":"Ezek.27.22-23","rawR":"Ezek.27.22-23","sourceRefs":[{"raw":"Ezek.27.22-23","value":"Ezek.27.22-23"}],"t":"ref","v":"Ezek 27:22-23"},"; ",{"href":"?bref=Ezek.38.13","r":"Ezek.38.13","rawR":"Ezek.38.13","sourceRefs":[{"raw":"Ezek.38.13","value":"Ezek.38.13"}],"t":"ref","v":"38:13"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.6.19","refs":[{"book":"JOB","endChapter":6,"endVerse":19,"startChapter":6,"startVerse":19}],"sourceAttributes":{"name":"Job.6.19","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[6],"sourceItemFragmentSha256":"affcfda2ec88ed50934686674a2cb6dbe970de4c276f951b23dd1176912d76d1","sourceItemName":"Job.6.19","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5622,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.6.19","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.6.19","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.6.27","r":"Job.6.27","rawR":"Job.6.27","sourceRefs":[{"raw":"Job.6.27","value":"Job.6.27"}],"t":"ref","v":"6:27"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["even send an orphan into slavery:"],"sourceClass":"sn-excerpt","t":"span"}," Job, the former protector of orphans (",{"href":"?bref=Job.31.17","r":"Job.31.17","rawR":"Job.31.17","sourceRefs":[{"raw":"Job.31.17","value":"Job.31.17"}],"t":"ref","v":"31:17"},", ",{"href":"?bref=Job.31.21","r":"Job.31.21","rawR":"Job.31.21","sourceRefs":[{"raw":"Job.31.21","value":"Job.31.21"}],"t":"ref","v":"21"},"), used a proverbial example of his counselors’ hard-heartedness toward the defenseless (see ",{"href":"?bref=Job.17.5","r":"Job.17.5","rawR":"Job.17.5","sourceRefs":[{"raw":"Job.17.5","value":"Job.17.5"}],"t":"ref","v":"17:5"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.6.27","refs":[{"book":"JOB","endChapter":6,"endVerse":27,"startChapter":6,"startVerse":27}],"sourceAttributes":{"name":"Job.6.27","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[6],"sourceItemFragmentSha256":"65e287a368e98fecfb5cc7ddf9c94bf10e4a2c04903fd94397ceca0e6e79e2b7","sourceItemName":"Job.6.27","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5623,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.6.27","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.6.27","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.6.30","r":"Job.6.30","rawR":"Job.6.30","sourceRefs":[{"raw":"Job.6.30","value":"Job.6.30"}],"t":"ref","v":"6:30"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["Don’t I know the difference between right and wrong?"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["Can’t my palate discern malice?"],"sourceClass":"ital","t":"span"},"): Job might have been echoing his earlier comment about a tasteless, revolting diet (",{"href":"?bref=Job.6.6-7","r":"Job.6.6-7","rawR":"Job.6.6-7","sourceRefs":[{"raw":"Job.6.6-7","value":"Job.6.6-7"}],"t":"ref","v":"6:6-7"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.6.30","refs":[{"book":"JOB","endChapter":6,"endVerse":30,"startChapter":6,"startVerse":30}],"sourceAttributes":{"name":"Job.6.30","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[6],"sourceItemFragmentSha256":"a72504d8319776d659718b6c9dc62f92dd591a9f0e9edbd4dd1809e4f59438c2","sourceItemName":"Job.6.30","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5624,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.6.30","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.6.30","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}