tartChapter":24,"startVerse":2}],"sourceAttributes":{"name":"Job.24.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[24],"sourceItemFragmentSha256":"b6cd6a05efd43b4549538a221caa10020bf4b6d86fa791076ad2c611697bb500","sourceItemName":"Job.24.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5800,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.24.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.24.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.24.3","r":"Job.24.3","rawR":"Job.24.3","sourceRefs":[{"raw":"Job.24.3","value":"Job.24.3"}],"t":"ref","v":"24:3"}],"sourceClass":"sn-ref","t":"span"}," The law did not allow seizing necessary belongings as ",{"c":["security"],"sourceClass":"sn-excerpt","t":"span"}," or collateral ",{"c":["for a loan"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=Job.22.6-9","r":"Job.22.6-9","rawR":"Job.22.6-9","sourceRefs":[{"raw":"Job.22.6-9","value":"Job.22.6-9"}],"t":"ref","v":"22:6-9"},"; ",{"href":"?bref=Deut.24.6","r":"Deut.24.6","rawR":"Deut.24.6","sourceRefs":[{"raw":"Deut.24.6","value":"Deut.24.6"}],"t":"ref","v":"Deut 24:6"},", ",{"href":"?bref=Deut.24.10-13","r":"Deut.24.10-13","rawR":"Deut.24.10-13","sourceRefs":[{"raw":"Deut.24.10-13","value":"Deut.24.10-13"}],"t":"ref","v":"10-13"},", ",{"href":"?bref=Deut.24.17-21","r":"Deut.24.17-21","rawR":"Deut.24.17-21","sourceRefs":[{"raw":"Deut.24.17-21","value":"Deut.24.17-21"}],"t":"ref","v":"17-21"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.24.3","refs":[{"book":"JOB","endChapter":24,"endVerse":3,"startChapter":24,"startVerse":3}],"sourceAttributes":{"name":"Job.24.3","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[24],"sourceItemFragmentSha256":"4bbb24eeb0d2f1117f06ee320e16ace576187f8ba5c2fff8ba980c47692f4089","sourceItemName":"Job.24.3","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5801,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.24.3","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.24.3","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.24.6","r":"Job.24.6","rawR":"Job.24.6","sourceRefs":[{"raw":"Job.24.6","value":"Job.24.6"}],"t":"ref","v":"24:6"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["glean in the vineyards of the wicked:"],"sourceClass":"sn-excerpt","t":"span"}," Job was depicting the desperate condition of the poor. If their fields had been stolen like Naboth’s vineyard (",{"href":"?bref=Job.24.2","r":"Job.24.2","rawR":"Job.24.2","sourceRefs":[{"raw":"Job.24.2","value":"Job.24.2"}],"t":"ref","v":"24:2"},"; see ",{"href":"?bref=1Kgs.21.1-29","r":"1Kgs.21.1-29","rawR":"1Kgs.21.1-29","sourceRefs":[{"raw":"1Kgs.21.1-29","value":"1Kgs.21.1-29"}],"t":"ref","v":"1 Kgs 21:1-29"},"), the poor would harvest for the thieving owners what should have been their own crops; instead of owning the whole crop, they would get just the leftover pickings for themselves. Perhaps the point is that the poor were forced to glean from the fields of wicked people who left no gleanings (",{"href":"?bref=Lev.19.10","r":"Lev.19.10","rawR":"Lev.19.10","sourceRefs":[{"raw":"Lev.19.10","value":"Lev.19.10"}],"t":"ref","v":"Lev 19:10"},"; ",{"href":"?bref=Lev.23.22","r":"Lev.23.22","rawR":"Lev.23.22","sourceRefs":[{"raw":"Lev.23.22","value":"Lev.23.22"}],"t":"ref","v":"23:22"},"), instead of being able to glean from the righteous, who leave something for the poor (",{"href":"?bref=Lev.19.9-10","r":"Lev.19.9-10","rawR":"Lev.19.9-10","sourceRefs":[{"raw":"Lev.19.9-10","value":"Lev.19.9-10"}],"t":"ref","v":"Lev 19:9-10"},"; ",{"href":"?bref=Lev.23.22","r":"Lev.23.22","rawR":"Lev.23.22","sourceRefs":[{"raw":"Lev.23.22","value":"Lev.23.22"}],"t":"ref","v":"23:22"},"; ",{"href":"?bref=Ruth.2.1-23","r":"Ruth.2.1-23","rawR":"Ruth.2.1-23","sourceRefs":[{"raw":"Ruth.2.1-23","value":"Ruth.2.1-23"}],"t":"ref","v":"Ruth 2:1-23"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.24.6","refs":[{"book":"JOB","endChapter":24,"endVerse":6,"startChapter":24,"startVerse":6}],"sourceAttributes":{"name":"Job.24.6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[24],"sourceItemFragmentSha256":"9015f98ab5a5908e581c31c1d935a5ac3c40832310e04f2e1b35d1f8de167ec9","sourceItemName":"Job.24.6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5802,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.24.6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.24.6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.24.7","r":"Job.24.7","rawR":"Job.24.7","sourceRefs":[{"raw":"Job.24.7","value":"Job.24.7"}],"t":"ref","v":"24:7"}],"sourceClass":"sn-ref","t":"span"}," Unjust lenders sometimes left debtors ",{"c":["without clothing or covering"],"sourceClass":"sn-excerpt","t":"span"},", which they had seized as collateral on loans (",{"href":"?bref=Job.22.6","r":"Job.22.6","rawR":"Job.22.6","sourceRefs":[{"raw":"Job.22.6","value":"Job.22.6"}],"t":"ref","v":"22:6"},"; ",{"href":"?bref=Exod.22.26-27","r":"Exod.22.26-27","rawR":"Exod.22.26-27","sourceRefs":[{"raw":"Exod.22.26-27","value":"Exod.22.26-27"}],"t":"ref","v":"Exod 22:26-27"},"; ",{"href":"?bref=Deut.24.11-13","r":"Deut.24.11-13","rawR":"Deut.24.11-13","sourceRefs":[{"raw":"Deut.24.11-13","value":"Deut.24.11-13"}],"t":"ref","v":"Deut 24:11-13"},"; ",{"href":"?bref=Amos.2.8","r":"Amos.2.8","rawR":"Amos.2.8","sourceRefs":[{"raw":"Amos.2.8","value":"Amos.2.8"}],"t":"ref","v":"Amos 2:8"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.24.7","refs":[{"book":"JOB","endChapter":24,"endVerse":7,"startChapter":24,"startVerse":7}],"sourceAttributes":{"name":"Job.24.7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[24],"sourceItemFragmentSha256":"06f38924849a3ffb82a07198203ec3347a8996b802382d30845ca19ccb069faf","sourceItemName":"Job.24.7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5803,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.24.7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.24.7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.24.9","r":"Job.24.9","rawR":"Job.24.9","sourceRefs":[{"raw":"Job.24.9","value":"Job.24.9"}],"t":"ref","v":"24:9"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["widow’s child . . . security for a loan:"],"sourceClass":"sn-excerpt","t":"span"}," See ",{"href":"?bref=2Kgs.4.1","r":"2Kgs.4.1","rawR":"2Kgs.4.1","sourceRefs":[{"raw":"2Kgs.4.1","value":"2Kgs.4.1"}],"t":"ref","v":"2 Kgs 4:1"},"; ",{"href":"?bref=Neh.5.1-5","r":"Neh.5.1-5","rawR":"Neh.5.1-5","sourceRefs":[{"raw":"Neh.5.1-5","value":"Neh.5.1-5"}],"t":"ref","v":"Neh 5:1-5"},"; ",{"href":"?bref=Matt.18.25","r":"Matt.18.25","rawR":"Matt.18.25","sourceRefs":[{"raw":"Matt.18.25","value":"Matt.18.25"}],"t":"ref","v":"Matt 18:25"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.24.9","refs":[{"book":"JOB","endChapter":24,"endVerse":9,"startChapter":24,"startVerse":9}],"sourceAttributes":{"name":"Job.24.9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[24],"sourceItemFragmentSha256":"10a16455cd5faaddd56b6fd847c5fd82c07d825f3be31943dca45c795476e7a1","sourceItemName":"Job.24.9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5804,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.24.9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.24.9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.24.11","r":"Job.24.11","rawR":"Job.24.11","sourceRefs":[{"raw":"Job.24.11","value":"Job.24.11"}],"t":"ref","v":"24:11"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["without being allowed to taste it:"],"sourceClass":"sn-excerpt","t":"span"}," These words, which are not in the original text, are implied by the parallel with ",{"c":["starving"],"sourceClass":"ital","t":"span"}," and ",{"c":["suffer from thirst"],"sourceClass":"sn-excerpt","t":"span"},". • To force workers to ",{"c":["tread in the winepress as they suffer from thirst"],"sourceClass":"sn-excerpt","t":"span"}," violates the principle of letting workers enjoy some of the produce they are harvesting (see ",{"href":"?bref=Deut.25.4","r":"Deut.25.4","rawR":"Deut.25.4","sourceRefs":[{"raw":"Deut.25.4","value":"Deut.25.4"}],"t":"ref","v":"Deut 25:4"},"; cp. ",{"href":"?bref=2Tim.2.6","r":"2Tim.2.6","rawR":"2Tim.2.6","sourceRefs":[{"raw":"2Tim.2.6","value":"2Tim.2.6"}],"t":"ref","v":"2 Tim 2:6"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.24.11","refs":[{"book":"JOB","endChapter":24,"endVerse":11,"startChapter":24,"startVerse":11}],"sourceAttributes":{"name":"Job.24.11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[24],"sourceItemFragmentSha256":"ff008c2f442aa195ebbeb6013144b02bfc018889b09215b2847af25c5db79ccf","sourceItemName":"Job.24.11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5805,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.24.11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.24.11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.24.12","r":"Job.24.12","rawR":"Job.24.12","sourceRefs":[{"raw":"Job.24.12","value":"Job.24.12"}],"t":"ref","v":"24:12"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["ignores their moaning:"],"sourceClass":"sn-excerpt","t":"span"}," It appeared to Job that contrary to God’s own character (",{"href":"?bref=Exod.2.23-24","r":"Exod.2.23-24","rawR":"Exod.2.23-24","sourceRefs":[{"raw":"Exod.2.23-24","value":"Exod.2.23-24"}],"t":"ref","v":"Exod 2:23-24"},"; ",{"href":"?bref=Ps.12.5","r":"Ps.12.5","rawR":"Ps.12.5","sourceRefs":[{"raw":"Ps.12.5","value":"Ps.12.5"}],"t":"ref","v":"Ps 12:5"},"), God neither relieved the plight of the wronged (",{"href":"?bref=Job.24.2-12","r":"Job.24.2-12","rawR":"Job.24.2-12","sourceRefs":[{"raw":"Job.24.2-12","value":"Job.24.2-12"}],"t":"ref","v":"Job 24:2-12"},") nor hindered the wicked from harming their victims (",{"href":"?bref=Job.24.13-17","r":"Job.24.13-17","rawR":"Job.24.13-17","sourceRefs":[{"raw":"Job.24.13-17","value":"Job.24.13-17"}],"t":"ref","v":"24:13-17"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.24.12","refs":[{"book":"JOB","endChapter":24,"endVerse":12,"startChapter":24,"startVerse":12}],"sourceAttributes":{"name":"Job.24.12","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[24],"sourceItemFragmentSha256":"d69ddf4d0762679fe5173a9d9009a63af93803fa2e871b37a3948ec63f0df473","sourceItemName":"Job.24.12","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5806,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.24.12","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.24.12","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.24.18-24","r":"Job.24.18-24","rawR":"Job.24.18-24","sourceRefs":[{"raw":"Job.24.18-24","value":"Job.24.18-24"}],"t":"ref","v":"24:18-24"}],"sourceClass":"sn-ref","t":"span"}," These sentiments appear to oppose Job’s observations, so some scholars suggest that they were the words of Bildad or Zophar. However, Job might have been pronouncing curses on the wicked, sarcastically quoting his friends’ views, or saying that the fate of the wicked presented by Eliphaz (",{"href":"?bref=Job.5.2-7","r":"Job.5.2-7","rawR":"Job.5.2-7","sourceRefs":[{"raw":"Job.5.2-7","value":"Job.5.2-7"}],"t":"ref","v":"5:2-7"},"; ",{"href":"?bref=Job.15.17-25","r":"Job.15.17-25","rawR":"Job.15.17-25","sourceRefs":[{"raw":"Job.15.17-25","value":"Job.15.17-25"}],"t":"ref","v":"15:17-25"},"), Bildad (",{"href":"?bref=Job.8.8-19","r":"Job.8.8-19","rawR":"Job.8.8-19","sourceRefs":[{"raw":"Job.8.8-19","value":"Job.8.8-19"}],"t":"ref","v":"8:8-19"},"; ",{"href":"?bref=Job.18.5-21","r":"Job.18.5-21","rawR":"Job.18.5-21","sourceRefs":[{"raw":"Job.18.5-21","value":"Job.18.5-21"}],"t":"ref","v":"18:5-21"},"), and Zophar (",{"href":"?bref=Job.20.4-29","r":"Job.20.4-29","rawR":"Job.20.4-29","sourceRefs":[{"raw":"Job.20.4-29","value":"Job.20.4-29"}],"t":"ref","v":"20:4-29"},") also overtakes the righteous (",{"href":"?bref=Job.21.23-26","r":"Job.21.23-26","rawR":"Job.21.23-26","sourceRefs":[{"raw":"Job.21.23-26","value":"Job.21.23-26"}],"t":"ref","v":"21:23-26"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.24.18-24","refs":[{"book":"JOB","endChapter":24,"endVerse":24,"startChapter":24,"startVerse":18}],"sourceAttributes":{"name":"Job.24.18-24","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[24],"sourceItemFragmentSha256":"89f184268b7cd8eaf2493fc47ec953b87338957167c6ba6800e15e6e63f40c2f","sourceItemName":"Job.24.18-24","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5807,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.24.18-24","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.24.18-24","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}