2-21","sourceRefs":[{"raw":"Job.4.12-21","value":"Job.4.12-21"}],"t":"ref","v":"4:12-21"},"; ",{"href":"?bref=Job.5.9-16","r":"Job.5.9-16","rawR":"Job.5.9-16","sourceRefs":[{"raw":"Job.5.9-16","value":"Job.5.9-16"}],"t":"ref","v":"5:9-16"},") and encouragement (",{"href":"?bref=Job.8.5-7","r":"Job.8.5-7","rawR":"Job.8.5-7","sourceRefs":[{"raw":"Job.8.5-7","value":"Job.8.5-7"}],"t":"ref","v":"8:5-7"},", ",{"href":"?bref=Job.8.20-22","r":"Job.8.20-22","rawR":"Job.8.20-22","sourceRefs":[{"raw":"Job.8.20-22","value":"Job.8.20-22"}],"t":"ref","v":"20-22"},"; cp. ",{"href":"?bref=Job.4.6","r":"Job.4.6","rawR":"Job.4.6","sourceRefs":[{"raw":"Job.4.6","value":"Job.4.6"}],"t":"ref","v":"4:6"},"; ",{"href":"?bref=Job.5.19-26","r":"Job.5.19-26","rawR":"Job.5.19-26","sourceRefs":[{"raw":"Job.5.19-26","value":"Job.5.19-26"}],"t":"ref","v":"5:19-26"},"). His point was that Job should quit blustering. He advised Job to repent and allow God’s justice to bring about restoration (",{"href":"?bref=Job.8.1-7","r":"Job.8.1-7","rawR":"Job.8.1-7","sourceRefs":[{"raw":"Job.8.1-7","value":"Job.8.1-7"}],"t":"ref","v":"8:1-7"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.8.1","refs":[{"book":"JOB","endChapter":8,"endVerse":1,"startChapter":8,"startVerse":1}],"sourceAttributes":{"name":"Job.8.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"18b77cf8916581a8212f1256e9db35ba39cd6f4c5dc67fb1a0e4c7bd44b9cdde","sourceItemName":"Job.8.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5640,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.8.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.8.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.8.2","r":"Job.8.2","rawR":"Job.8.2","sourceRefs":[{"raw":"Job.8.2","value":"Job.8.2"}],"t":"ref","v":"8:2"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["How long?"],"sourceClass":"sn-excerpt","t":"span"}," Bildad’s question might be an ironic parody of Job’s question in ",{"href":"?bref=Job.7.19","r":"Job.7.19","rawR":"Job.7.19","sourceRefs":[{"raw":"Job.7.19","value":"Job.7.19"}],"t":"ref","v":"7:19"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.8.2","refs":[{"book":"JOB","endChapter":8,"endVerse":2,"startChapter":8,"startVerse":2}],"sourceAttributes":{"name":"Job.8.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[8],"sourceItemFragmentSha256":"1d9cbc185e03c5a1a447b7dec7fd10d7bfc5bfff6a8714a93806b44f5146e37b","sourceItemName":"Job.8.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5641,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS":"Job","method":"official_book_intro_ref_title","sourceOSIS":"Job"},"sourceReferenceStatus":"canonical","sourceRefsExact":"Job.8.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"Job.8.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=Job.8.3-4","r":"Job.8.3-4","rawR":"Job.8.3-4","sourceRefs":[{"raw":"Job.8.3-4","value":"Job.8.3-4"}],"t":"ref","v":"8:3-4"}],"sourceClass":"sn-ref","t":"span"}," According to Bildad, ",{"c":["God"],"sourceClass":"sn-excerpt","t":"span"}," does not ",{"c":["twist justice"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," so the death of Job’s children proved that they had ",{"c":["sinned against"],"sourceClass":"sn-excerpt","t":"span"}," God. Bildad divided people into the blameless (Hebrew ",{"c":["tam,"],"sourceClass":"hebrew","t":"span"}," ",{