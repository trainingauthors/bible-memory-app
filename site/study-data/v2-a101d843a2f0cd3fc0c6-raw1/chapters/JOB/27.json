20","Ezek 9:5-6","Rom 8:32","2 Pet 2:4-5"],"sourceRowNumber":23464,"targets":[{"label":"Deut 29:20","passages":[{"book":"DEU","chapter":29,"verses":[20]}]},{"label":"Ezek 9:5-6","passages":[{"book":"EZK","chapter":9,"verses":[5,6]}]},{"label":"Rom 8:32","passages":[{"book":"ROM","chapter":8,"verses":[32]}]},{"label":"2 Pet 2:4-5","passages":[{"book":"2PE","chapter":2,"verses":[4,5]}]}],"verse":22},{"anchor":"flees headlong","refs":["Job 20:24","Exod 14:25-28","Judg 4:17-21","Isa 10:3","Amos 2:14","Amos 9:1-3"],"sourceRowNumber":23465,"targets":[{"label":"Job 20:24","passages":[{"book":"JOB","chapter":20,"verses":[24]}]},{"label":"Exod 14:25-28","passages":[{"book":"EXO","chapter":14,"verses":[25,26,27,28]}]},{"label":"Judg 4:17-21","passages":[{"book":"JDG","chapter":4,"verses":[17,18,19,20,21]}]},{"label":"Isa 10:3","passages":[{"book":"ISA","chapter":10,"verses":[3]}]},{"label":"Amos 2:14","passages":[{"book":"AMO","chapter":2,"verses":[14]}]},{"label":"Amos 9:1-3","passages":[{"book":"AMO","chapter":9,"verses":[1,2,3]}]}],"verse":22},{"anchor":"claps its hands","refs":["Esth 9:22-25","Prov 11:10","Lam 2:15","Rev 18:20"],"sourceRowNumber":23466,"targets":[{"label":"Esth 9:22-25","passages":[{"book":"EST","chapter":9,"verses":[22,23,24,25]}]},{"label":"Prov 11:10","passages":[{"book":"PRO","chapter":11,"verses":[10]}]},{"label":"Lam 2:15","passages":[{"book":"LAM","chapter":2,"verses":[15]}]},{"label":"Rev 18:20","passages":[{"book":"REV","chapter":18,"verses":[20]}]}],"verse":23},{"anchor":"hisses him out of his place","refs":["1 Kgs 9:8","Jer 19:8","Mic 6:16","Zeph 2:15"],"sourceRowNumber":23467,"targets":[{"label":"1 Kgs 9:8","passages":[{"book":"1KI","chapter":9,"verses":[8]}]},{"label":"Jer 19:8","passages":[{"book":"JER","chapter":19,"verses":[8]}]},{"label":"Mic 6:16","passages":[{"book":"MIC","chapter":6,"verses":[16]}]},{"label":"Zeph 2:15","passages":[{"book":"ZEP","chapter":2,"verses":[15]}]}],"verse":23}],"dictionaryArticles":{"Booth":{"file":"dictionary/c34d00b9d2ad5cf6a71c98023f03457bdb418249f324cdbcfa85938814107aa0.json","title":"Booth"},"Inheritance":{"file":"dictionary/498399d3acc1f455b361d572cfe6ec952ec4783d5b014259d1ec14666f29060d.json","title":"Inheritance"},"JobBookof":{"file":"dictionary/ac644ad8adcc60700d414cfd9602f5cdbf11499b8eb9ee555034ea6be7aa0ae0.json","title":"Job, Book of"},"Whirlwind":{"file":"dictionary/632583d71b62c150c762978113e187937e76325d573e573562e4303a1aaa17ab.json","title":"Whirlwind"}},"dictionaryRelated":[{"id":"Booth","title":"Booth"},{"id":"Inheritance","title":"Inheritance"},{"id":"JobBookof","title":"Job, Book of"},{"id":"Whirlwind","title":"Whirlwind"}],"dictionaryWords":[],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":["Job’s Innocence"],"sourceClass":"theme-title","t":"h"},{"c":["Job’s comforters could not stomach the idea that any human could be truly innocent (",{"href":"?bref=Job.4.17-19","r":"Job.4.17-19","rawR":"Job.4.17-19","sourceRefs":[{"raw":"Job.4.17-19","value":"Job.4.17-19"}],"t":"ref","v":"Job 4:17-19"},"; ",{"href":"?bref=Job.15.14-16","r":"Job.15.14-16","rawR":"Job.15.14-16","sourceRefs":[{"raw":"Job.15.14-16","value":"Job.15.14-16"}],"t":"ref","v":"15:14-16"},"; ",{"href":"?bref=Job.25.4-6","r":"Job.25.4-6","rawR":"Job.25.4-6","sourceRefs":[{"raw":"Job.25.4-6","value":"Job.25.4-6"}],"t":"ref","v":"25:4-6"},"). Job’s claim to innocence also seems to conflict with the biblical teaching that “no one is righteous—not even one. . . . All fall short of God’s glorious standard” (",{"href":"?bref=Rom.3.10","r":"Rom.3.10","rawR":"Rom.3.10","sourceRefs":[{"raw":"Rom.3.10","value":"Rom.3.10"}],"t":"ref","v":"Rom 3:10"},", ",{"href":"?bref=Rom.3.23","r":"Rom.3.23","rawR":"Rom.3.23","sourceRefs":[{"raw":"Rom.3.23","value":"Rom.3.23"}],"t":"ref","v":"23"},"). Was Job right in proclaiming his innocence?"],"sourceClass":"theme-body-fl","t":"p"},{"c":["Eliphaz and the others talked right past Job. When they denied that Job could be right or pure, they were referring to the absolute difference between the creature and the Creator. But Job was not claiming absolute purity. He acknowledged his youthful sins (",{"href":"?bref=Job.13.26","r":"Job.13.26","rawR":"Job.13.26","sourceRefs":[{"raw":"Job.13.26","value":"Job.13.26"}],"t":"ref","v":"Job 13:26"},") and was aware of his need to have his sins and his guilt covered (",{"href":"?bref=Job.14.16-17","r":"Job.14.16-17","rawR":"Job.14.16-17","sourceRefs":[{"raw":"Job.14.16-17","value":"Job.14.16-17"}],"t":"ref","v":"14:16-17"},")."],"sourceClass":"theme-body","t":"p"},{"c":["Nonetheless, Job repeatedly claimed to be a man of integrity and innocence in his relationship with God (",{"href":"?bref=Job.13.14-18","r":"Job.13.14-18","rawR":"Job.13.14-18","sourceRefs":[{"raw":"Job.13.14-18","value":"Job.13.14-18"}],"t":"ref","v":"13:14-18"},"; ",{"href":"?bref=Job.23.10-12","r":"Job.23.10-12","rawR":"Job.23.10-12","sourceRefs":[{"raw":"Job.23.10-12","value":"Job.23.10-12"}],"t":"ref","v":"23:10-12"},"; ",{"href":"?bref=Job.27.3-6","r":"Job.27.3-6","rawR":"Job.27.3-6","sourceRefs":[{"raw":"Job.27.3-6","value":"Job.27.3-6"}],"t":"ref","v":"27:3-6"},"; ",{"href":"?bref=Job.31.1-40","r":"Job.31.1-40","rawR":"Job.31.1-40","sourceRefs":[{"raw":"Job.31.1-40","value":"Job.31.1-40"}],"t":"ref","v":"31:1-40"},"). Even Eliphaz acknowledged that Job’s life was upright (",{"href":"?bref=Job.4.6","r":"Job.4.6","rawR":"Job.4.6","sourceRefs":[{"raw":"Job.4.6","value":"Job.4.6"}],"t":"ref","v":"4:6"},"). Job’s faith made him doggedly pursue an audience with God and tenaciously believe in God’s justice despite his immediate experience. Job kept looking for his Redeemer (",{"href":"?bref=Job.19.25","r":"Job.19.25","rawR":"Job.19.25","sourceRefs":[{"raw":"Job.19.25","value":"Job.19.25"}],"t":"ref","v":"19:25"},"). Although God’s justice might require a mediator (",{"href":"?bref=Job.9.33-35","r":"Job.9.33-35","rawR":"Job.9.33-35","sourceRefs":[{"raw":"Job.9.33-35","value":"Job.9.33-35"}],"t":"ref","v":"9:33-35"},"), and it might not be evident before death (",{"href":"?bref=Job.19.26","r":"Job.19.26","rawR":"Job.19.26","sourceRefs":[{"raw":"Job.19.26","value":"Job.19.26"}],"t":"ref","v":"19:26"},"), it guaranteed Job’s acquittal. Job lived “by believing and not by seeing” (",{"href":"?bref=2Cor.5.7","r":"2Cor.5.7","rawR":"2Cor.5.7","sourceRefs":[{"raw":"2Cor.5.7","value":"2Cor.5.7"}],"t":"ref","v":"2 Cor 5:7"},"; see also ",{"href":"?bref=Rom.8.24","r":"Rom.8.24","rawR":"Rom.8.24","sourceRefs":[{"raw":"Rom.8.24","value":"Rom.8.24"}],"t":"ref","v":"Rom 8:24"},"; ",{"href":"?bref=1Cor.13.12","r":"1Cor.13.12","rawR":"1Cor.13.12","sourceRefs":[{"raw":"1Cor.13.12","value":"1Cor.13.12"}],"t":"ref","v":"1 Cor 13:12"},"; ",{"href":"?bref=2Cor.4.18","r":"2Cor.4.18","rawR":"2Cor.4.18","sourceRefs":[{"raw":"2Cor.4.18","value":"2Cor.4.18"}],"t":"ref","v":"2 Cor 4:18"},"; ",{"href":"?bref=Heb.11.1-2","r":"Heb.11.1-2","rawR":"Heb.11.1-2","sourceRefs":[{"raw":"Heb.11.1-2","value":"Heb.11.1-2"}],"t":"ref","v":"Heb 11:1-2"},"; ",{"href":"?bref=1Pet.1.6-8","r":"1Pet.1.6-8","rawR":"1Pet.1.6-8","sourceRefs":[{"raw":"1Pet.1.6-8","value":"1Pet.1.6-8"}],"t":"ref","v":"1 Pet 1:6-8"},")."],"sourceClass":"theme-body","t":"p"},{"c":["When held up to the light of Christ’s absolute righteousness, Job stands with all of us as a sinner. Job was not justified by his deeds but by his faith, and on that basis God declared that Job was “blameless—a man of complete integrity” (",{"href":"?bref=Job.1.1","r":"Job.1.1","rawR":"Job.1.1","sourceRefs":[{"raw":"Job.1.1","value":"Job.1.1"}],"t":"ref","v":"Job 1:1"},", ",{"href":"?bref=Job.1.8","r":"Job.1.8","rawR":"Job.1.8","sourceRefs":[{"raw":"Job.1.8","value":"Job.1.8"}],"t":"ref","v":"8"},"; ",{"href":"?bref=Job.2.3","r":"Job.2.3","rawR":"Job.2.3","sourceRefs":[{"raw":"Job.2.3","value":"Job.2.3"}],"t":"ref","v":"2:3"},"; ",{"href":"?bref=Job.42.7-8","r":"Job.42.7-8","rawR":"Job.42.7-8","sourceRefs":[{"raw":"Job.42.7-8","value":"Job.42.7-8"}],"t":"ref","v":"42:7-8"},"). God does the same for us when we, like Job, put our complete trust in him (see ",{"href":"?bref=Rom.4.4-5","r":"Rom.4.4-5","rawR":"Rom.4.4-5","sourceRefs":[{"raw":"Rom.4.4-5","value":"Rom.4.4-5"}],"t":"ref","v":"Rom 4:4-5"},"; ",{"href":"?bref=Jas.2.23","r":"Jas.2.23","rawR":"Jas.2.23","sourceRefs":[{"raw":"Jas.2.23","value":"Jas.2.23"}],"t":"ref","v":"Jas 2:23"},")."],"sourceClass":"theme-body","t":"p"},{"c":["Passages for Further Study"],"sourceClass":"theme-refs-title","t":"h"},{"c":[{"href":"?bref=1Kgs.8.46","r":"1Kgs.8.46","rawR":"1Kgs.8.46","sourceRefs":[{"raw":"1Kgs.8.46","value":"1Kgs.8.46"}],"t":"ref","v":"1 Kgs 8:46"},"; ",{"href":"?bref=Job.1.1","r":"Job.1.1","rawR":"Job.1.1","sourceRefs":[{"raw":"Job.1.1","value":"Job.1.1"}],"t":"ref","v":"Job 1:1"},", ",{"href":"?bref=Job.1.8-11","r":"Job.1.8-11","rawR":"Job.1.8-11","sourceRefs":[{"raw":"Job.1.8-11","value":"Job.1.8-11"}],"t":"ref","v":"8-11"},"; ",{"href":"?bref=Job.2.3-5","r":"Job.2.3-5","rawR":"Job.2.3-5","sourceRefs":[{"raw":"Job.2.3-5","value":"Job.2.3-5"}],"t":"ref","v":"2:3-5"},"; ",{"href":"?bref=Job.4.6","r":"Job.4.6","rawR":"Job.4.6","sourceRefs":[{"raw":"Job.4.6","value":"Job.4.6"}],"t":"ref","v":"4:6"},"; ",{"href":"?bref=Job.9.33-34","r":"Job.9.33-34","rawR":"Job.9.33-34","sourceRefs":[{"raw":"Job.9.33-34","value":"Job.9.33-34"}],"t":"ref","v":"9:33-34"},"; ",{"href":"?bref=Job.13.18","r":"Job.13.18","rawR":"Job.13.18","sourceRefs":[{"raw":"Job.13.18","value":"Job.13.18"}],"t":"ref","v":"13:18"},"; ",{"href":"?bref=Job.14.16-17","r":"Job.14.16-17","rawR":"Job.14.16-17","sourceRefs":[{"raw":"Job.14.16-17","value":"Job.14.16-17"}],"t":"ref","v":"14:16-17"},"; ",{"href":"?bref=Job.15.14","r":"Job.15.14","rawR":"Job.15.14","sourceRefs":[{"raw":"Job.15.14","value":"Job.15.14"}],"t":"ref","v":"15:14"},"; ",{"href":"?bref=Job.19.25-26","r":"Job.19.25-26","rawR":"Job.19.25-26","sourceRefs":[{"raw":"Job.19.25-26","value":"Job.19.25-26"}],"t":