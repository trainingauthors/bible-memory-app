[{"raw":"1Sam.14.45","value":"1Sam.14.45"}],"t":"ref","v":"45"},"; ",{"href":"?bref=Jer.5.2","r":"Jer.5.2","rawR":"Jer.5.2","sourceRefs":[{"raw":"Jer.5.2","value":"Jer.5.2"}],"t":"ref","v":"Jer 5:2"},"). • Elihu later criticized Job for saying that God had ",{"c":["taken away"],"sourceClass":"sn-excerpt","t":"span"}," his ",{"c":["rights"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=Job.34.5","r":"Job.34.5","rawR":"Job.34.5","sourceRefs":[{"raw":"Job.34.5","value":"Job.34.5"}],"t":"ref","v":"Job 34:5"},"). • ",{"c":["embittered . . . soul"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=Job.7.11","r":"Job.7.11","rawR":"Job.7.11","sourceRefs":[{"raw":"Job.7.11","value":"Job.7.11"}],"t":"ref","v":"7:11"},"; ",{"href":"?bref=Job.10.1","r":"Job.10.1","rawR":"Job.10.1","sourceRefs":[{"raw":"Job.10.1","value":"Job.10.1"}],"t":"ref","v":"10:1"},"; ",{"href":"?bref=Job.21.25","r":"Job.21.25","rawR":"Job.21.25","sourceRefs":[{"raw":"Job.21.25","value":"Job.21.25"}],"t":"ref","v":"21:25"},"): Cp. Naomi (",{"href":"?bref=Ruth.1.20-21","r":"Ruth.1.20-21","rawR":"Ruth.1.20-21","sourceRefs":[{"raw":"Ruth.1.20-21","value":"Ruth.1.20-21"}],"t":"ref","v":"Ruth 1:20-21"},") and the widow from Shunem after the loss of her son (",{"href":"?bref=2Kgs.4.27","r":"2Kgs.4.27","rawR":"2Kgs.4.27","sourceRefs":[{"raw":"2Kgs.4.27","value":"2Kgs.4.27"}],"t":"ref","v":"2 Kgs 4:27"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:Job.27.2","refs":[{"book":"JOB","endChapter":27,"endVerse":2,"startChapter":27,"startVerse":2}],"sourceAttributes":{"name":"Job.27.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"JOB","sourceChapterCoverage":[27],"sourceItemFragmentSha256":"bbdcfa9f5f3fe846ddbcade86fd61f697caf657e2ec516e0fa06a166b8bfd7f6","sourceItemName":"Job.27.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":5818,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"JOB","canonicalOSIS"