:{"file":"dictionary/a1f7e19eab26fc98ac7ea351a6248245beaa6f9b33ab0a150a5259feed22360d.json","title":"Christ"},"CorinthiansFirstLettertothe":{"file":"dictionary/19f8bf675491c3d86fb410aa75065ecc9cc49fa91ea691c6d416878d7ae2d381.json","title":"Corinthians, First Letter to the"},"CorinthiansSecondLettertothe":{"file":"dictionary/16f53b3e6c244f99624c6e9dbd0cf63f5107f9dafd4a87bacc0f4615abc0e8db.json","title":"Corinthians, Second Letter to the"},"Fellowship":{"file":"dictionary/623eca3d9a3ce934629246505906b34af02adaba25f92baf529d518ead880110.json","title":"Fellowship"},"GalatiansLettertothe":{"file":"dictionary/5ae6f40aa517a396307c5bb51c172bbe202179c5591cc316ee0f103a379a285d.json","title":"Galatians, Letter to the"},"Gratitude":{"file":"dictionary/35a5d37de00985fff241ff51f4b5c57e135b73b8040d6601fa10bf0d854b8302.json","title":"Gratitude"},"Macedonia":{"file":"dictionary/3e07719fd4ab5f9076a86e7caef2b182d492a6dcf5071a554a8f4c2a257b9884.json","title":"Macedonia"},"Prayer":{"file":"dictionary/fae981bffb99abab976ccf52d1a775ce94b4b4da3dfcb674c63c57004f2ccc2d.json","title":"Prayer"},"RomansLettertothe":{"file":"dictionary/dcafd2aa0fa20d479aa12d3d7a699b17e063e0967e6f5c88204d4b7e7efd6e08.json","title":"Romans, Letter to the"}},"dictionaryRelated":[{"id":"BibleManuscriptsandTextoftheNewTestament","title":"Bible*, Manuscripts and Text of the (New Testament)"},{"id":"Boast","title":"Boast"},{"id":"CorinthiansFirstLettertothe","title":"Corinthians, First Letter to the"},{"id":"CorinthiansSecondLettertothe","title":"Corinthians, Second Letter to the"},{"id":"Fellowship","title":"Fellowship"},{"id":"GalatiansLettertothe","title":"Galatians, Letter to the"},{"id":"Macedonia","title":"Macedonia"},{"id":"Prayer","title":"Prayer"},{"id":"RomansLettertothe","title":"Romans, Letter to the"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Christ","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Christ::Christ::reviewed_capitalized_divine_title","sourceHeadwordId":"Christ"},"text":"Because of the proof this ministry provides, the saints will glorify God for your obedient confession of the gospel of Christ, and for the generosity of your contribution to them and to all the others.","verse":13}],"id":"Christ","label":"Christ","matchReviews":[{"ruleId":"Christ::Christ::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Original article identifies Christ as the title of Jesus. Exact capitalized Christ is matched; plural or lower-case false christs is not automatically included.","sourceHeadwordId":"Christ","term":"Christ"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Christ","sourceTitle":"Christ"},{"evidence":[{"matchingRule":"source_verified_redirect","phrase":"thanksgiving","senseEvidence":{"basis":"reviewed_publisher_redirect","originalCitations":[],"ruleId":"Gratitude::Thanksgiving::reviewed_publisher_redirect","sourceHeadwordId":"Thanksgiving"},"text":"You will be enriched in every way to be generous on every occasion, and through us your generosity will produce thanksgiving to God.","verse":11},{"matchingRule":"source_verified_redirect","phrase":"thanksgiving","senseEvidence":{"basis":"reviewed_publisher_redirect","originalCitations":[],"ruleId":"Gratitude::Thanksgiving::reviewed_publisher_redirect","sourceHeadwordId":"Thanksgiving"},"text":"For this ministry of service is not only supplying the needs of the saints but is also overflowing in many expressions of thanksgiving to God.","verse":12}],"id":"Gratitude","label":"thanksgiving","matchReviews":[{"ruleId":"Gratitude::Thanksgiving::reviewed_publisher_redirect","scope":"reviewed_publisher_redirect","senseReview":"The original publisher explicitly links this complete unambiguous name/phrase to this target. Redirect and target were reviewed once; actual BSB phrase and full word boundaries required. Target original title and complete article remain unchanged.","sourceHeadwordId":"Thanksgiving","term":"Thanksgiving"}],"matchingRule":"source_verified_redirect","matchingRules":["source_verified_redirect"],"sourceProvenanceId":"Gratitude","sourceTitle":"Gratitude"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":["Christian Giving"],"sourceClass":"theme-title","t":"h"},{"c":["Bountiful giving is a mark of true grace. We see its sublime expression in the Lord of glory, who by his poverty became one with us and made us rich (",{"href":"?bref=2Cor.8.9","r":"2Cor.8.9","rawR":"2Cor.8.9","sourceRefs":[{"raw":"2Cor.8.9","value":"2Cor.8.9"}],"t":"ref","v":"2 Cor 8:9"},"; ",{"href":"?bref=Phil.2.5-8","r":"Phil.2.5-8","rawR":"Phil.2.5-8","sourceRefs":[{"raw":"Phil.2.5-8","value":"Phil.2.5-8"}],"t":"ref","v":"Phil 2:5-8"},"). We have received his unmerited favor in salvation, and we give sacrificially in response to “this gift too wonderful for words!” (",{"href":"?bref=2Cor.9.15","r":"2Cor.9.15","rawR":"2Cor.9.15","sourceRefs":[{"raw":"2Cor.9.15","value":"2Cor.9.15"}],"t":"ref","v":"9:15"},")."],"sourceClass":"theme-body-fl","t":"p"},{"c":["Jesus taught that generosity would be one evidence of those who follow him (",{"href":"?bref=Matt.25.34-36","r":"Matt.25.34-36","rawR":"Matt.25.34-36","sourceRefs":[{"raw":"Matt.25.34-36","value":"Matt.25.34-36"}],"t":"ref","v":"Matt 25:34-36"},"), and he stressed the importance of a person’s intentions and attitude, not simply the amount given (",{"href":"?bref=Mark.12.41-44","r":"Mark.12.41-44","rawR":"Mark.12.41-44","sourceRefs":[{"raw":"Mark.12.41-44","value":"Mark.12.41-44"}],"t":"ref","v":"Mark 12:41-44"},")."],"sourceClass":"theme-body","t":"p"},{"c":["Paul dedicates a lot of his attention in 2 Corinthians to the theme of giving. The church at Corinth was encouraged to give generously in response to human need, specifically the needs of the poor Jewish Christians in Jerusalem (",{"href":"?bref=2Cor.8.6-7","r":"2Cor.8.6-7","rawR":"2Cor.8.6-7","sourceRefs":[{"raw":"2Cor.8.6-7","value":"2Cor.8.6-7"}],"t":"ref","v":"2 Cor 8:6-7"},"; ",{"href":"?bref=2Cor.9.1-5","r":"2Cor.9.1-5","rawR":"2Cor.9.1-5","sourceRefs":[{"raw":"2Cor.9.1-5","value":"2Cor.9.1-5"}],"t":"ref","v":"9:1-5"},"). It would be a sign that the Gentile Christians were one body with the Jewish Christians in Jerusalem."],"sourceClass":"theme-body","t":"p"},{"c":["Paul’s teaching on Christian giving in can be summarized as follows:"],"sourceClass":"theme-body","t":"p"},{"c":["(1) Our giving should spring from a willing mind and heart (",{"href":"?bref=2Cor.8.12","r":"2Cor.8.12","rawR":"2Cor.8.12","sourceRefs":[{"raw":"2Cor.8.12","value":"2Cor.8.12"}],"t":"ref","v":"2 Cor 8:12"},"; ",{"href":"?bref=2Cor.9.7","r":"2Cor.9.7","rawR":"2Cor.9.7","sourceRefs":[{"raw":"2Cor.9.7","value":"2Cor.9.7"}],"t":"ref","v":"9:7"},"). Paul emphasizes motives because all giving should hinge on why we give."],"sourceClass":"theme-body","t":"p"},{"c":["(2) True giving is a joy, in contrast with grudging gifts (",{"href":"?bref=2Cor.9.5","r":"2Cor.9.5","rawR":"2Cor.9.5","sourceRefs":[{"raw":"2Cor.9.5","value":"2Cor.9.5"}],"t":"ref","v":"9:5"},"). There is joy in sowing seed, like a farmer who anticipates a crop (",{"href":"?bref=2Cor.9.6-10","r":"2Cor.9.6-10","rawR":"2Cor.9.6-10","sourceRefs":[{"raw":"2Cor.9.6-10","value":"2Cor.9.6-10"}],"t":"ref","v":"9:6-10"},"); and there is joy in sharing with others in need (",{"href":"?bref=2Cor.9.1-2","r":"2Cor.9.1-2","rawR":"2Cor.9.1-2","sourceRefs":[{"raw":"2Cor.9.1-2","value":"2Cor.9.1-2"}],"t":"ref","v":"9:1-2"},")."],"sourceClass":"theme-body","t":"p"},{"c":["(3) Christian giving is marked by generosity and may entail sacrifice, as it did for the Macedonians (",{"href":"?bref=2Cor.8.1-5","r":"2Cor.8.1-5","rawR":"2Cor.8.1-5","sourceRefs":[{"raw":"2Cor.8.1-5","value":"2Cor.8.1-5"}],"t":"ref","v":"8:1-5"},")."],"sourceClass":"theme-body","t":"p"},{"c":["(4) The handling of financial gifts calls for honesty, integrity, and care. Paul was careful to deflect any suspicion of his colleagues who were sent to collect gifts from the churches (",{"href":"?bref=2Cor.8.20-21","r":"2Cor.8.20-21","rawR":"2Cor.8.20-21","sourceRefs":[{"raw":"2Cor.8.20-21","value":"2Cor.8.20-21"}],"t":"ref","v":"8:20-21"},"). Those who handle monetary gifts in the church should be persons of proven reputation and responsibility."],"sourceClass":"theme-body","t":"p"},{"c":["Christian living is to be marked by a generous concern for those in need, and Paul instructs believers to please God, not themselves (",{"href":"?bref=2Cor.5.15","r":"2Cor.5.15","rawR":"2Cor.5.15","sourceRefs":[{"raw":"2Cor.5.15","value":"2Cor.5.15"}],"t":"ref","v":"5:15"},"). Believers are called to live under Christ’s lordship and be motivated by his love (",{"href":"?bref=2Cor.5.14","r":"2Cor.5.14","rawR":"2Cor.5.14","sourceRefs":[{"raw":"2Cor.5.14","value":"2Cor.5.14"}],"t":"ref","v":"5:14"},"). We can demonstrate his love tangibly in our giving."],"sourceClass":"theme-body","t":"p"},{"c":["Passages for Further Study"],"sourceClass":"theme-refs-title","t":"h"},{"c":[{"href":"?bref=Exod.25.2","r":"Exod.25.2","rawR":"Exod.25.2","sourceRefs":[{"raw":"Exod.25.2","value":"Exod.25.2"}],"t":"ref","v":"Exod 25:2"},"; ",{"href":"?bref=Exod.35.5","r":"Exod.35.5","rawR":"Exod.35.5","sourceRefs":[{"raw":"Exod.35.5","value":"Exod.35.5"}],"t":"ref","v":"35:5"},"; ",{"href":"?bref=Lev.25.35","r":"Lev.25.35","rawR":"Lev.25.35","sourceRefs":[{"raw":"Lev.25.35","value":"Lev.25.35"}],"t":"ref","v":"Lev 25:35"},"; ",{"href":"?bref=Deut.15.7-11","r":"Deut.15.7-11","rawR":"Deut.15.7-11","sourceRefs":[{"raw":"Deut.15.7-11","value":"Deut.15.7-11"}],"t":"ref","v":"Deut 15:7-11"},"; ",{"href":"?bref=Deut.16.17","r":"Deut.16.17","rawR":"Deut.16.17","sourceRefs":[{"raw":"Deut.16.17","value":"Deut.16.17"}],"t":"ref","v":"16:17"},"; ",{"href":"?bref=1Chr.29.9","r":"1Chr.29.9","rawR":"1Chr.29.9","sourceRefs":[{"raw":"1Chr.29.9","value":"1Chr.29.9"}],"t":"ref","v":"1 Chr 29:9"},"; ",{"href":"?bref=Pr.3.9-10","r":"Pr.3.9-10","rawR":"Pr.3.9-10","sourceRefs":[{"raw":"Pr.3.9-10","value":"Pr.3.9-10"}],"t":"ref","v":"Prov 3:9-10"},"; ",{"href":"?bref=Pr.11.24-26","r":"Pr.11.24-26","rawR":"Pr.11.24-26","sourceRefs":[{"raw":"Pr.11.24-26","value":"Pr.11.24-26"}],"t":"ref","v":"11:24-26"},"; ",{"href":"?bref=Pr.21.13","r":"Pr.21.13","rawR":"Pr.21.13","sourceRefs":[{"raw":"Pr.21.13","value":"Pr.21.13"}],"t":"ref","v":"21:13"},"; ",{"href":"?bref=Pr.28.27","r":"Pr.28.27","rawR":"Pr.28.27","sourceRefs":[{"raw":"Pr.28.27","value":"Pr.28.27"}],"t":"ref","v":"28:27"},"; ",{"href":"?bref=Mal.3.8","r":"Mal.3.8","rawR":"Mal.3.8","sourceRefs":[{"raw":"Mal.3.8","value":"Mal.3.8"}],"t":"ref","v":"Mal 3:8"},"; ",{"href":"?bref=Matt.5.42","r":"Matt.5.42","rawR":"Matt.5.42","sourceRefs":[{"raw":"Matt.5.42","value":"Matt.5.42"}],"t":"ref","v":"Matt 5:42"},"; ",{"href":"?bref=Matt.6.3-4","r":"Matt.6.3-4","rawR":"Matt.6.3-4","sourceRefs":[{"raw":"Matt.6.3-4","value":"Matt.6.3-4"}],"t":"ref","v":"6:3-4"},"; ",{"href":"?bref=Matt.10.8","r":"Matt.10.8","rawR":"Matt.10.8","sourceRefs":[{"raw":"Matt.10.8","value":"Matt.10.8"}],"t":"ref","v":"10:8"},"; ",{"href":"?bref=Matt.19.21","r":"Matt.19.21","rawR":"Matt.19.21","sourceRefs":[{"raw":"Matt.19.21","value":"Matt.19.21"}],"t":"ref","v":"19:21"},"; ",{"href":"?bref=Luke.6.38","r":"Luke.6.38","rawR":"Luke.6.38","sourceRefs":[{"raw":"Luke.6.38","value":"Luke.6.38"}],"t":"ref","v":"Luke 6:38"},"; ",{"href":"?bref=Luke.11.41","r":"Luke.11.41","rawR":"Luke.11.41","sourceRefs":[{"raw":"Luke.11.41","value":"Luke.11.41"}],"t":"ref","v":"11:41"},"; ",{"href":"?bref=Luke.12.33-34","r":"Luke.12.33-34","rawR":"Luke.12.33-34","sourceRefs":[{"raw":"Luke.12.33-34","value":"Luke.12.33-34"}],"t":"ref","v":"12:33-34"},"; ",{"href":"?bref=Luke.18.22","r":"Luke.18.22","rawR":"Luke.18.22","sourceRefs":[{"raw":"Luke.18.22","value":"Luke.18.22"}],"t":"ref","v":"18:22"},"; ",{"href":"?bref=Acts.11.29","r":"Acts.11.29","rawR":"Acts.11.29","sourceRefs":[{"raw":"Acts.11.29","value":"Acts.11.29"}],"t":"ref","v":"Acts 11:29"},"; ",{"href":"?bref=1Cor.13.3","r":"1Cor.13.3","rawR":"1Cor.13.3","sourceRefs":[{"raw":"1Cor.13.3","value":"1Cor.13.3"}],"t":"ref","v":"1 Cor 13:3"},"; ",{"href":"?bref=1Cor.16.2-3","r":"1Cor.16.2-3","rawR":"1Cor.16.2-3","sourceRefs":[{"raw":"1Cor.16.2-3","value":"1Cor.16.2-3"}],"t":"ref","v":"16:2-3"},"; ",{"href":"?bref=2Cor.5.17-18","r":"2Cor.5.17-18","rawR":"2Cor.5.17-18","sourceRefs":[{"raw":"2Cor.5.17-18","value":"2Cor.5.17-18"}],"t":"ref","v":"2 Cor 5:17-18"},"; ",{"href":"?bref=2Cor.8.1-9.15","r":"2Cor.8.1-9.15","rawR":"2Cor.8.1-9.15","sourceRefs":[{"raw":"2Cor.8.1-9.15","value":"2Cor.8.1-9.15"}],"t":"ref","v":"2 Cor 8:1–9:15"},"; ",{"href":"?bref=Phil.2.3-11","r":"Phil.2.3-11","rawR":"Phil.2.3-11","sourceRefs":[{"raw":"Phil.2.3-11","value":"Phil.2.3-11"}],"t":"ref","v":"Phil 2:3-11"}],"sourceClass":"theme-refs","t":"p"}],"id":"ThemeNote:ChristianGiving","refs":[{"book":"2CO","endChapter":9,"endVerse":15,"startChapter":8,"startVerse":1}],"sourceAttributes":{"name":"ChristianGiving","product":"TyndaleOpenStudyNotes","typename":"ThemeNote"},"sourceBookAppCode":"2CO","sourceChapterCoverage":[8,9],"sourceItemFragmentSha256":"42a57ef03aeb5d3ee878832ba4514f64da0360961e0a29994743d31f6464d0d1","sourceItemName":"ChristianGiving","sourceMember":"Tyndale Open Study Notes/ThemeNotes.xml","sourceOrder":258,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CO","canonicalOSIS":"2Cor","method":"official_book_intro_ref_title","sourceOSIS":"2Cor"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Cor.8.1-9.15","sourceRelease":"1.25","sourceTitleExact":"Christian Giving","supplementPointersNotIncludedAsContent":[],"title":"Christian Giving","type":"ThemeNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Cor.9.1-5","r":"2Cor.9.1-5","rawR":"2Cor.9.1-5","sourceRefs":[{"raw":"2Cor.9.1-5","value":"2Cor.9.1-5"}],"t":"ref","v":"9:1-5"}],"sourceClass":"sn-ref","t":"span"}," Two motives reinforce the spirit of love in giving: (1) to emulate the Macedonians, who in their poverty had been forthcoming in their generosity (",{"href":"?bref=2Cor.9.2","r":"2Cor.9.2","rawR":"2Cor.9.2","sourceRefs":[{"raw":"2Cor.9.2","value":"2Cor.9.2"}],"t":"ref","v":"9:2"},"); and (2) not to shame Paul or themselves, since he had boasted about the Corinthians’ generosity to the Macedonians (",{"href":"?bref=2Cor.9.3-5","r":"2Cor.9.3-5","rawR":"2Cor.9.3-5","sourceRefs":[{"raw":"2Cor.9.3-5","value":"2Cor.9.3-5"}],"t":"ref","v":"9:3-5"},"). To ensure the timely gathering of the collection at Corinth, Paul would send the delegates (",{"href":"?bref=2Cor.8.16-24","r":"2Cor.8.16-24","rawR":"2Cor.8.16-24","sourceRefs":[{"raw":"2Cor.8.16-24","value":"2Cor.8.16-24"}],"t":"ref","v":"8:16-24"},") in advance to ",{"c":["make sure the gift you promised is ready"],"sourceClass":"sn-excerpt","t":"span"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IICor.9.1-5","refs":[{"book":"2CO","endChapter":9,"endVerse":5,"startChapter":9,"startVerse":1}],"sourceAttributes":{"name":"IICor.9.1-5","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CO","sourceChapterCoverage":[9],"sourceItemFragmentSha256":"ae772fb3d1696a7167246ae97a599051bfdae44cc1301ef62092c678cc199b4d","sourceItemName":"IICor.9.1-5","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":15087,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CO","canonicalOSIS":"2Cor","method":"official_book_intro_ref_title","sourceOSIS":"2Cor"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Cor.9.1-5","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IICor.9.1-5","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Cor.9.6","r":"2Cor.9.6","rawR":"2Cor.9.6","sourceRefs":[{"raw":"2Cor.9.6","value":"2Cor.9.6"}],"t":"ref","v":"9:6"}],"sourceClass":"sn-ref","t":"span"}," Paul turns to agriculture for an illustration of the benefits of generosity. ",{"c":["A farmer"],"sourceClass":"sn-excerpt","t":"span"}," who expects a rich harvest must sow many seeds."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IICor.9.6","refs":[{"book":"2CO","endChapter":9,"endVerse":6,"startChapter":9,"startVerse":6}],"sourceAttributes":{"name":"IICor.9.6","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CO","sourceChapterCoverage":[9],"sourceItemFragmentSha256":"723bebae43f759e8fefbb3aff7700cf23086e82477559829fd8574c9346edfdd","sourceItemName":"IICor.9.6","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":15088,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CO","canonicalOSIS":"2Cor","method":"official_book_intro_ref_title","sourceOSIS":"2Cor"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Cor.9.6","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IICor.9.6","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Cor.9.7","r":"2Cor.9.7","rawR":"2Cor.9.7","sourceRefs":[{"raw":"2Cor.9.7","value":"2Cor.9.7"}],"t":"ref","v":"9:7"}],"sourceClass":"sn-ref","t":"span"}," It is the spirit of giving that counts, ",{"c":["“For God loves a person who gives cheerfully.”"],"sourceClass":"sn-excerpt","t":"span"}," Cheerfulness in giving is contrasted with giving ",{"c":["reluctantly"],"sourceClass":"sn-excerpt","t":"span"}," (literally ",{"c":["out of sorrow"],"sourceClass":"ital","t":"span"},") or ",{"c":["in response to pressure"],"sourceClass":"sn-excerpt","t":"span"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IICor.9.7","refs":[{"book":"2CO","endChapter":9,"endVerse":7,"startChapter":9,"startVerse":7}],"sourceAttributes":{"name":"IICor.9.7","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CO","sourceChapterCoverage":[9],"sourceItemFragmentSha256":"e7f5e4182d4dec85d3861e9ac95092767419acb05accc1cf2364187a4f16f95f","sourceItemName":"IICor.9.7","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":15089,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CO","canonicalOSIS":"2Cor","method":"official_book_intro_ref_title","sourceOSIS":"2Cor"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Cor.9.7","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IICor.9.7","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Cor.9.8-9","r":"2Cor.9.8-9","rawR":"2Cor.9.8-9","sourceRefs":[{"raw":"2Cor.9.8-9","value":"2Cor.9.8-9"}],"t":"ref","v":"9:8-9"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["As the Scriptures say:"],"sourceClass":"sn-excerpt","t":"span"}," The quotation from ",{"href":"?bref=Ps.112.9","r":"Ps.112.9","rawR":"Ps.112.9","sourceRefs":[{"raw":"Ps.112.9","value":"Ps.112.9"}],"t":"ref","v":"Ps 112:9"}," supports the assurance that God, who provides for all human needs, will reward generosity."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IICor.9.8-9","refs":[{"book":"2CO","endChapter":9,"endVerse":9,"startChapter":9,"startVerse":8}],"sourceAttributes":{"name":"IICor.9.8-9","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CO","sourceChapterCoverage":[9],"sourceItemFragmentSha256":"45fa7966defea9245ef7a594cdd0e0f4e2c2106f364b906fcb0813c5f43e23c1","sourceItemName":"IICor.9.8-9","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":15090,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CO","canonicalOSIS":"2Cor","method":"official_book_intro_ref_title","sourceOSIS":"2Cor"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Cor.9.8-9","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IICor.9.8-9","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Cor.9.10-14","r":"2Cor.9.10-14","rawR":"2Cor.9.10-14","sourceRefs":[{"raw":"2Cor.9.10-14","value":"2Cor.9.10-14"}],"t":"ref","v":"9:10-14"}],"sourceClass":"sn-ref","t":"span"}," The Corinthians’ ",{"c":["generosity"],"sourceClass":"sn-excerpt","t":"span"}," would be matched by God’s generosity (",{"href":"?bref=2Cor.9.10-11","r":"2Cor.9.10-11","rawR":"2Cor.9.10-11","sourceRefs":[{"raw":"2Cor.9.10-11","value":"2Cor.9.10-11"}],"t":"ref","v":"9:10-11"},"). It would also meet ",{"c":["the needs"],"sourceClass":"sn-excerpt","t":"span"}," of Jewish Christians (",{"href":"?bref=2Cor.9.12","r":"2Cor.9.12","rawR":"2Cor.9.12","sourceRefs":[{"raw":"2Cor.9.12","value":"2Cor.9.12"}],"t":"ref","v":"9:12"},"), honor God (",{"href":"?bref=2Cor.9.13","r":"2Cor.9.13","rawR":"2Cor.9.13","sourceRefs":[{"raw":"2Cor.9.13","value":"2Cor.9.13"}],"t":"ref","v":"9:13"},"), show believers in Jerusalem that their Gentile brothers and sisters were genuine believers (",{"href":"?bref=2Cor.9.13","r":"2Cor.9.13","rawR":"2Cor.9.13","sourceRefs":[{"raw":"2Cor.9.13","value":"2Cor.9.13"}],"t":"ref","v":"9:13"},"), and result in the Jewish believers’ intercessory prayer and ",{"c":["affection"],"sourceClass":"sn-excerpt","t":"span"}," for the Gentile believers (",{"href":"?bref=2Cor.9.14","r":"2Cor.9.14","rawR":"2Cor.9.14","sourceRefs":[{"raw":"2Cor.9.14","value":"2Cor.9.14"}],"t":"ref","v":"9:14"},"). Paul envisioned a united, worldwide Christian church, composed of believing Jews and Gentiles who are all one in Christ Jesus (",{"href":"?bref=Gal.3.28","r":"Gal.3.28","rawR":"Gal.3.28","sourceRefs":[{"raw":"Gal.3.28","value":"Gal.3.28"}],"t":"ref","v":"Gal 3:28"},"; ",{"href":"?bref=Eph.2.11-22","r":"Eph.2.11-22","rawR":"Eph.2.11-22","sourceRefs":[{"raw":"Eph.2.11-22","value":"Eph.2.11-22"}],"t":"ref","v":"Eph 2:11-22"},"), which would become a powerful witness to the Lord’s work of reconciliation."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IICor.9.10-14","refs":[{"book":"2CO","endChapter":9,"endVerse":14,"startChapter":9,"startVerse":10}],"sourceAttributes":{"name":"IICor.9.10-14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CO","sourceChapterCoverage":[9],"sourceItemFragmentSha256":"e6f7321ce552550d6ff99880c68195cffa833bdd2b1b180334b48c2d7c96d004","sourceItemName":"IICor.9.10-14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":15091,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CO","canonicalOSIS":"2Cor","method":"official_book_intro_ref_title","sourceOSIS":"2Cor"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Cor.9.10-14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IICor.9.10-14","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}