ocrypha*"},{"id":"BibleManuscriptsandTextoftheNewTestament","title":"Bible*, Manuscripts and Text of the (New Testament)"},{"id":"CorinthiansFirstLettertothe","title":"Corinthians, First Letter to the"},{"id":"CorinthiansSecondLettertothe","title":"Corinthians, Second Letter to the"},{"id":"Demon","title":"Demon"},{"id":"Forgiveness","title":"Forgiveness"},{"id":"Gratitude","title":"Gratitude"},{"id":"Grief","title":"Grief"},{"id":"Incense","title":"Incense"},{"id":"PaultheApostle","title":"Paul, the Apostle"},{"id":"TitusLetterto","title":"Titus, Letter to"}],"dictionaryWords":[{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Christ","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Christ::Christ::reviewed_capitalized_divine_title","sourceHeadwordId":"Christ"},"text":"If you forgive anyone, I also forgive him. And if I have forgiven anything, I have forgiven it in the presence of Christ for your sake,","verse":10},{"matchingRule":"reviewed_exact_headword","phrase":"Christ","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Christ::Christ::reviewed_capitalized_divine_title","sourceHeadwordId":"Christ"},"text":"Now when I went to Troas to preach the gospel of Christ and a door stood open for me in the Lord,","verse":12},{"matchingRule":"reviewed_exact_headword","phrase":"Christ","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Christ::Christ::reviewed_capitalized_divine_title","sourceHeadwordId":"Christ"},"text":"But thanks be to God, who always leads us triumphantly as captives in Christ and through us spreads everywhere the fragrance of the knowledge of Him.","verse":14},{"matchingRule":"reviewed_exact_headword","phrase":"Christ","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Christ::Christ::reviewed_capitalized_divine_title","sourceHeadwordId":"Christ"},"text":"For we are to God the sweet aroma of Christ among those who are being saved and those who are perishing.","verse":15},{"matchingRule":"reviewed_exact_headword","phrase":"Christ","senseEvidence":{"basis":"reviewed_capitalized_divine_title","originalCitations":[],"ruleId":"Christ::Christ::reviewed_capitalized_divine_title","sourceHeadwordId":"Christ"},"text":"For we are not like so many others, who peddle the word of God for profit. On the contrary, in Christ we speak before God with sincerity, as men sent from God.","verse":17}],"id":"Christ","label":"Christ","matchReviews":[{"ruleId":"Christ::Christ::reviewed_capitalized_divine_title","scope":"reviewed_capitalized_divine_title","senseReview":"Original article identifies Christ as the title of Jesus. Exact capitalized Christ is matched; plural or lower-case false christs is not automatically included.","sourceHeadwordId":"Christ","term":"Christ"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Christ","sourceTitle":"Christ"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Macedonia","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[{"anchorIndex":9,"href":"?bref=2Cor.2.13","rawReference":"2Cor.2.13"}],"ruleId":"Macedonia::Macedonia::reviewed_unambiguous_name","sourceHeadwordId":"Macedonia"},"text":"I had no peace in my spirit, because I did not find my brother Titus there. So I said goodbye to them and went on to Macedonia.","verse":13}],"id":"Macedonia","label":"Macedonia","matchReviews":[{"ruleId":"Macedonia::Macedonia::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Macedonia","term":"Macedonia"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Macedonia","sourceTitle":"Macedonia"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Satan","senseEvidence":{"basis":"reviewed_unambiguous_name","originalCitations":[{"anchorIndex":19,"href":"?bref=2Cor.2.11","rawReference":"2Cor.2.11"}],"ruleId":"Satan::Satan::reviewed_unambiguous_name","sourceHeadwordId":"Satan"},"text":"in order that Satan should not outwit us. For we are not unaware of his schemes.","verse":11}],"id":"Satan","label":"Satan","matchReviews":[{"ruleId":"Satan::Satan::reviewed_unambiguous_name","scope":"reviewed_unambiguous_name","senseReview":"Reviewed complete original name headword and source subject. Article covers the biblical person(s), named place, or named spiritual figure denoted by this exact spelling; multiple persons under one unchanged source article remain together. Actual proper-name capitalization and whole-name boundaries required. Explicit occurrence-level ambiguity exclusions override this rule.","sourceHeadwordId":"Satan","term":"Satan"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Satan","sourceTitle":"Satan"},{"evidence":[{"matchingRule":"reviewed_exact_headword","phrase":"Troas","senseEvidence":{"basis":"source_verse_citation","originalCitations":[{"anchorIndex":3,"href":"?bref=2Cor.2.12","rawReference":"2Cor.2.12"}],"ruleId":"Troas::Troas::source_verse_citation","sourceHeadwordId":"Troas"},"text":"Now when I went to Troas to preach the gospel of Christ and a door stood open for me in the Lord,","verse":12}],"id":"Troas","label":"Troas","matchReviews":[{"ruleId":"Troas::Troas::source_verse_citation","scope":"source_verse_citation","senseReview":"Original complete headword and source opening identify a named person, people, or place. Promotion requires a capitalized whole name and the original article explicitly citing this same BSB verse. No arbitrary qualifier stripping or book-title inference. This citation-constrained rule was reviewed once globally; unmatched contexts remain excluded.","sourceHeadwordId":"Troas","term":"Troas"}],"matchingRule":"reviewed_exact_headword","matchingRules":["reviewed_exact_headword"],"sourceProvenanceId":"Troas","sourceTitle":"Troas"}],"format":"bsb-study-chapter-v2","notes":[{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Cor.1.15-2.2","r":"2Cor.1.15-2.2","rawR":"2Cor.1.15-2.2","sourceRefs":[{"raw":"2Cor.1.15-2.2","value":"2Cor.1.15-2.2"}],"t":"ref","v":"1:15–2:2"}],"sourceClass":"sn-ref","t":"span"}," Paul had ",{"c":["changed"],"sourceClass":"sn-excerpt","t":"span"}," his travel ",{"c":["plan"],"sourceClass":"sn-excerpt","t":"span"},". In ",{"href":"?bref=1Cor.16.5","r":"1Cor.16.5","rawR":"1Cor.16.5","sourceRefs":[{"raw":"1Cor.16.5","value":"1Cor.16.5"}],"t":"ref","v":"1 Cor 16:5"},", he expressed the hope of visiting Corinth after passing through ",{"c":["Macedonia"],"sourceClass":"sn-excerpt","t":"span"},". Then he evidently promised to visit Corinth earlier (perhaps in his “severe letter,” ",{"href":"?bref=2Cor.7.8","r":"2Cor.7.8","rawR":"2Cor.7.8","sourceRefs":[{"raw":"2Cor.7.8","value":"2Cor.7.8"}],"t":"ref","v":"2 Cor 7:8"},")—on his way north. Now he would have to go back to the original plan, and that earlier visit, bringing ",{"c":["a double blessing"],"sourceClass":"sn-excerpt","t":"span"},", would not be happening after all."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IICor.1.15-2.2","refs":[{"book":"2CO","endChapter":2,"endVerse":2,"startChapter":1,"startVerse":15}],"sourceAttributes":{"name":"IICor.1.15-2.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CO","sourceChapterCoverage":[1,2],"sourceItemFragmentSha256":"ae867afe208b4cd719f617770b21a2a7889d0476cba0df820a763573a39b5ac6","sourceItemName":"IICor.1.15-2.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":15012,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CO","canonicalOSIS":"2Cor","method":"official_book_intro_ref_title","sourceOSIS":"2Cor"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Cor.1.15-2.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IICor.1.15-2.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Cor.1.23-2.2","r":"2Cor.1.23-2.2","rawR":"2Cor.1.23-2.2","sourceRefs":[{"raw":"2Cor.1.23-2.2","value":"2Cor.1.23-2.2"}],"t":"ref","v":"1:23–2:2"}],"sourceClass":"sn-ref","t":"span"}," ",{"c":["God as my witness:"],"sourceClass":"sn-excerpt","t":"span"}," This mild oath indicates that he is telling the truth (see ",{"href":"?bref=1Sam.12.5","r":"1Sam.12.5","rawR":"1Sam.12.5","sourceRefs":[{"raw":"1Sam.12.5","value":"1Sam.12.5"}],"t":"ref","v":"1 Sam 12:5"},"; ",{"href":"?bref=1Sam.20.12","r":"1Sam.20.12","rawR":"1Sam.20.12","sourceRefs":[{"raw":"1Sam.20.12","value":"1Sam.20.12"}],"t":"ref","v":"20:12"},"; ",{"href":"?bref=Job.16.19","r":"Job.16.19","rawR":"Job.16.19","sourceRefs":[{"raw":"Job.16.19","value":"Job.16.19"}],"t":"ref","v":"Job 16:19"},"; cp. ",{"href":"?bref=Ruth.1.17","r":"Ruth.1.17","rawR":"Ruth.1.17","sourceRefs":[{"raw":"Ruth.1.17","value":"Ruth.1.17"}],"t":"ref","v":"Ruth 1:17"},"; ",{"href":"?bref=1Sam.14.44","r":"1Sam.14.44","rawR":"1Sam.14.44","sourceRefs":[{"raw":"1Sam.14.44","value":"1Sam.14.44"}],"t":"ref","v":"1 Sam 14:44"},"; ",{"href":"?bref=2Sam.3.35","r":"2Sam.3.35","rawR":"2Sam.3.35","sourceRefs":[{"raw":"2Sam.3.35","value":"2Sam.3.35"}],"t":"ref","v":"2 Sam 3:35"},"; ",{"href":"?bref=1Kgs.2.23","r":"1Kgs.2.23","rawR":"1Kgs.2.23","sourceRefs":[{"raw":"1Kgs.2.23","value":"1Kgs.2.23"}],"t":"ref","v":"1 Kgs 2:23"},"; ",{"href":"?bref=Jer.42.5","r":"Jer.42.5","rawR":"Jer.42.5","sourceRefs":[{"raw":"Jer.42.5","value":"Jer.42.5"}],"t":"ref","v":"Jer 42:5"},"). The real reason for Paul’s change of travel plans was ",{"c":["to spare"],"sourceClass":"sn-excerpt","t":"span"}," them ",{"c":["from a severe rebuke"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=2Cor.1.23","r":"2Cor.1.23","rawR":"2Cor.1.23","sourceRefs":[{"raw":"2Cor.1.23","value":"2Cor.1.23"}],"t":"ref","v":"2 Cor 1:23"},") and not inflict ",{"c":["another painful visit"],"sourceClass":"sn-excerpt","t":"span"}," on them (",{"href":"?bref=2Cor.2.1","r":"2Cor.2.1","rawR":"2Cor.2.1","sourceRefs":[{"raw":"2Cor.2.1","value":"2Cor.2.1"}],"t":"ref","v":"2:1"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IICor.1.23-2.2","refs":[{"book":"2CO","endChapter":2,"endVerse":2,"startChapter":1,"startVerse":23}],"sourceAttributes":{"name":"IICor.1.23-2.2","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CO","sourceChapterCoverage":[1,2],"sourceItemFragmentSha256":"c5db7ddf70285fc78760a0b3ea818c5f80267b5b09ba212ad1e0223bf2abe60b","sourceItemName":"IICor.1.23-2.2","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":15019,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CO","canonicalOSIS":"2Cor","method":"official_book_intro_ref_title","sourceOSIS":"2Cor"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Cor.1.23-2.2","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IICor.1.23-2.2","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Cor.2.1","r":"2Cor.2.1","rawR":"2Cor.2.1","sourceRefs":[{"raw":"2Cor.2.1","value":"2Cor.2.1"}],"t":"ref","v":"2:1"}],"sourceClass":"sn-ref","t":"span"}," Paul’s previous ",{"c":["visit"],"sourceClass":"sn-excerpt","t":"span"}," had been very ",{"c":["painful"],"sourceClass":"sn-excerpt","t":"span"}," and had caused him great distress. This visit is not recorded in Acts; it apparently took place during Paul’s three-year ministry in Ephesus (see ",{"href":"?bref=Acts.19.8-22","r":"Acts.19.8-22","rawR":"Acts.19.8-22","sourceRefs":[{"raw":"Acts.19.8-22","value":"Acts.19.8-22"}],"t":"ref","v":"Acts 19:8-22"},"). During that visit, Paul severely rebuked the church (",{"href":"?bref=2Cor.1.23","r":"2Cor.1.23","rawR":"2Cor.1.23","sourceRefs":[{"raw":"2Cor.1.23","value":"2Cor.1.23"}],"t":"ref","v":"2 Cor 1:23"},") and was insulted by an unnamed man (",{"href":"?bref=2Cor.2.5-11","r":"2Cor.2.5-11","rawR":"2Cor.2.5-11","sourceRefs":[{"raw":"2Cor.2.5-11","value":"2Cor.2.5-11"}],"t":"ref","v":"2:5-11"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IICor.2.1","refs":[{"book":"2CO","endChapter":2,"endVerse":1,"startChapter":2,"startVerse":1}],"sourceAttributes":{"name":"IICor.2.1","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CO","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"42bbc11ba71a9b034ae88b773cf2d8efb901908754494298d5a00ad79408fc0d","sourceItemName":"IICor.2.1","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":15020,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CO","canonicalOSIS":"2Cor","method":"official_book_intro_ref_title","sourceOSIS":"2Cor"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Cor.2.1","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IICor.2.1","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Cor.2.3-4","r":"2Cor.2.3-4","rawR":"2Cor.2.3-4","sourceRefs":[{"raw":"2Cor.2.3-4","value":"2Cor.2.3-4"}],"t":"ref","v":"2:3-4"}],"sourceClass":"sn-ref","t":"span"}," After his painful visit (",{"href":"?bref=2Cor.2.1","r":"2Cor.2.1","rawR":"2Cor.2.1","sourceRefs":[{"raw":"2Cor.2.1","value":"2Cor.2.1"}],"t":"ref","v":"2:1"},"), Paul then wrote a letter with ",{"c":["great anguish . . . and many tears"],"sourceClass":"sn-excerpt","t":"span"}," that was intended for the Corinthians’ good. That letter (see also ",{"href":"?bref=2Cor.7.8-10","r":"2Cor.7.8-10","rawR":"2Cor.7.8-10","sourceRefs":[{"raw":"2Cor.7.8-10","value":"2Cor.7.8-10"}],"t":"ref","v":"7:8-10"},") has evidently been lost. But it was effective in bringing about the needed repentance and change."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IICor.2.3-4","refs":[{"book":"2CO","endChapter":2,"endVerse":4,"startChapter":2,"startVerse":3}],"sourceAttributes":{"name":"IICor.2.3-4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CO","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"8dc3b7d639da50e06e707c459328480bc49381d4f92c881712d312ae8452b8c6","sourceItemName":"IICor.2.3-4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":15021,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CO","canonicalOSIS":"2Cor","method":"official_book_intro_ref_title","sourceOSIS":"2Cor"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Cor.2.3-4","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IICor.2.3-4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Cor.2.5-11","r":"2Cor.2.5-11","rawR":"2Cor.2.5-11","sourceRefs":[{"raw":"2Cor.2.5-11","value":"2Cor.2.5-11"}],"t":"ref","v":"2:5-11"}],"sourceClass":"sn-ref","t":"span"}," These verses are the outcome of Paul’s earlier visit and the insult he received. Following Paul’s severe but tearful letter, the church condemned the behavior of ",{"c":["the man who caused all the trouble"],"sourceClass":"sn-excerpt","t":"span"}," and disciplined him (",{"href":"?bref=2Cor.2.6","r":"2Cor.2.6","rawR":"2Cor.2.6","sourceRefs":[{"raw":"2Cor.2.6","value":"2Cor.2.6"}],"t":"ref","v":"2:6"},"). He repented, so now it was ",{"c":["time to forgive and comfort him"],"sourceClass":"sn-excerpt","t":"span"},{"c":[","],"sourceClass":"ital","t":"span"}," as Paul had already done."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IICor.2.5-11","refs":[{"book":"2CO","endChapter":2,"endVerse":11,"startChapter":2,"startVerse":5}],"sourceAttributes":{"name":"IICor.2.5-11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CO","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"36ba5afea5d329fd14653a4bad3e711a3a77e5885726e24ecbd33ac0f30d1abd","sourceItemName":"IICor.2.5-11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":15022,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CO","canonicalOSIS":"2Cor","method":"official_book_intro_ref_title","sourceOSIS":"2Cor"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Cor.2.5-11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IICor.2.5-11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Cor.2.11","r":"2Cor.2.11","rawR":"2Cor.2.11","sourceRefs":[{"raw":"2Cor.2.11","value":"2Cor.2.11"}],"t":"ref","v":"2:11"}],"sourceClass":"sn-ref","t":"span"}," If we exercise forgiveness, as Paul did, ",{"c":["Satan will not outsmart us"],"sourceClass":"sn-excerpt","t":"span"}," by making us either too lax over sin or too rigorous in punishing offenders. • ",{"c":["familiar with his evil schemes:"],"sourceClass":"sn-excerpt","t":"span"}," Cp. ",{"href":"?bref=2Cor.11.3","r":"2Cor.11.3","rawR":"2Cor.11.3","sourceRefs":[{"raw":"2Cor.11.3","value":"2Cor.11.3"}],"t":"ref","v":"11:3"},", ",{"href":"?bref=2Cor.11.14","r":"2Cor.11.14","rawR":"2Cor.11.14","sourceRefs":[{"raw":"2Cor.11.14","value":"2Cor.11.14"}],"t":"ref","v":"14"},"; ",{"href":"?bref=Eph.6.11","r":"Eph.6.11","rawR":"Eph.6.11","sourceRefs":[{"raw":"Eph.6.11","value":"Eph.6.11"}],"t":"ref","v":"Eph 6:11"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IICor.2.11","refs":[{"book":"2CO","endChapter":2,"endVerse":11,"startChapter":2,"startVerse":11}],"sourceAttributes":{"name":"IICor.2.11","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CO","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"2ac2c95a23665eeb717afe934c67a324a4fdb4ac324ae1834610f68fa6e33f91","sourceItemName":"IICor.2.11","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":15023,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CO","canonicalOSIS":"2Cor","method":"official_book_intro_ref_title","sourceOSIS":"2Cor"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Cor.2.11","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IICor.2.11","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Cor.2.12-13","r":"2Cor.2.12-13","rawR":"2Cor.2.12-13","sourceRefs":[{"raw":"2Cor.2.12-13","value":"2Cor.2.12-13"}],"t":"ref","v":"2:12-13"}],"sourceClass":"sn-ref","t":"span"}," After the riot at Ephesus (",{"href":"?bref=Acts.19.1-20","r":"Acts.19.1-20","rawR":"Acts.19.1-20","sourceRefs":[{"raw":"Acts.19.1-20","value":"Acts.19.1-20"}],"t":"ref","v":"Acts 19:1–20:1"},"), Paul went to the seaport of ",{"c":["Troas"],"sourceClass":"sn-excerpt","t":"span"}," (",{"href":"?bref=Acts.20.5","r":"Acts.20.5","rawR":"Acts.20.5","sourceRefs":[{"raw":"Acts.20.5","value":"Acts.20.5"}],"t":"ref","v":"Acts 20:5"},"). He was impatient to get news from ",{"c":["Titus"],"sourceClass":"sn-excerpt","t":"span"}," about the result of the severe but tearful letter (",{"href":"?bref=2Cor.2.4","r":"2Cor.2.4","rawR":"2Cor.2.4","sourceRefs":[{"raw":"2Cor.2.4","value":"2Cor.2.4"}],"t":"ref","v":"2 Cor 2:4"},"), and he crossed over to Macedonia in northern Greece ",{"c":["to find him"],"sourceClass":"sn-excerpt","t":"span"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IICor.2.12-13","refs":[{"book":"2CO","endChapter":2,"endVerse":13,"startChapter":2,"startVerse":12}],"sourceAttributes":{"name":"IICor.2.12-13","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CO","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"b24ec2e1212bd66b06e1ee06c7efe798a577f271b55e570270c2c386d395da3a","sourceItemName":"IICor.2.12-13","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":15024,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CO","canonicalOSIS":"2Cor","method":"official_book_intro_ref_title","sourceOSIS":"2Cor"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Cor.2.12-13","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IICor.2.12-13","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Cor.2.14-7.4","r":"2Cor.2.14-7.4","rawR":"2Cor.2.14-7.4","sourceRefs":[{"raw":"2Cor.2.14-7.4","value":"2Cor.2.14-7.4"}],"t":"ref","v":"2:14–7:4"}],"sourceClass":"sn-ref","t":"span"}," At this point, the story about finding Titus breaks off and will not be resumed until ",{"href":"?bref=2Cor.7.5","r":"2Cor.7.5","rawR":"2Cor.7.5","sourceRefs":[{"raw":"2Cor.7.5","value":"2Cor.7.5"}],"t":"ref","v":"7:5"},". Paul digresses to discuss his ministry as an apostle proclaiming the Good News."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IICor.2.14-7.4","refs":[{"book":"2CO","endChapter":2,"endVerse":14,"startChapter":2,"startVerse":14}],"sourceAttributes":{"name":"IICor.2.14-7.4","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CO","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"12222d4b79c4acdecfa4fce89453514b54de9f828ddf35f935dc7897894b05be","sourceItemName":"IICor.2.14-7.4","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":15025,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CO","canonicalOSIS":"2Cor","method":"official_book_intro_ref_title","sourceOSIS":"2Cor"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Cor.2.14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IICor.2.14-7.4","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Cor.2.14","r":"2Cor.2.14","rawR":"2Cor.2.14","sourceRefs":[{"raw":"2Cor.2.14","value":"2Cor.2.14"}],"t":"ref","v":"2:14"}],"sourceClass":"sn-ref","t":"span"}," Like ",{"c":["captives"],"sourceClass":"sn-excerpt","t":"span"}," in a Roman general’s celebration march, Paul was ",{"c":["in Christ’s triumphal procession"],"sourceClass":"sn-excerpt","t":"span"}," (cp. ",{"href":"?bref=1Cor.4.9","r":"1Cor.4.9","rawR":"1Cor.4.9","sourceRefs":[{"raw":"1Cor.4.9","value":"1Cor.4.9"}],"t":"ref","v":"1 Cor 4:9"},"; ",{"href":"?bref=Eph.4.7-11","r":"Eph.4.7-11","rawR":"Eph.4.7-11","sourceRefs":[{"raw":"Eph.4.7-11","value":"Eph.4.7-11"}],"t":"ref","v":"Eph 4:7-11"},"), carrying the marks of willing servitude (see ",{"href":"?bref=Rom.1.1","r":"Rom.1.1","rawR":"Rom.1.1","sourceRefs":[{"raw":"Rom.1.1","value":"Rom.1.1"}],"t":"ref","v":"Rom 1:1"},"; ",{"href":"?bref=Gal.6.17","r":"Gal.6.17","rawR":"Gal.6.17","sourceRefs":[{"raw":"Gal.6.17","value":"Gal.6.17"}],"t":"ref","v":"Gal 6:17"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IICor.2.14","refs":[{"book":"2CO","endChapter":2,"endVerse":14,"startChapter":2,"startVerse":14}],"sourceAttributes":{"name":"IICor.2.14","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CO","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"7fa6f6259c031ab0a64b9040ff81fad9499f6008d0b9c5ba82d96e8ca81d1e5f","sourceItemName":"IICor.2.14","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":15026,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CO","canonicalOSIS":"2Cor","method":"official_book_intro_ref_title","sourceOSIS":"2Cor"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Cor.2.14","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IICor.2.14","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Cor.2.15-16","r":"2Cor.2.15-16","rawR":"2Cor.2.15-16","sourceRefs":[{"raw":"2Cor.2.15-16","value":"2Cor.2.15-16"}],"t":"ref","v":"2:15-16"}],"sourceClass":"sn-ref","t":"span"}," Incense was scattered along the parade route of a victorious Roman general, and it was received in one of two ways. For the captives, who were on their way to the arena and death, it was ",{"c":["a dreadful smell of death and doom"],"sourceClass":"sn-excerpt","t":"span"},". For the victors, it was ",{"c":["a life-giving perfume"],"sourceClass":"sn-excerpt","t":"span"},". So it is with the lives of those who proclaim the Good News, which either leads to eternal life or seals the fate of the person who rejects it (cp. ",{"href":"?bref=1Cor.1.18","r":"1Cor.1.18","rawR":"1Cor.1.18","sourceRefs":[{"raw":"1Cor.1.18","value":"1Cor.1.18"}],"t":"ref","v":"1 Cor 1:18"},")."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IICor.2.15-16","refs":[{"book":"2CO","endChapter":2,"endVerse":16,"startChapter":2,"startVerse":15}],"sourceAttributes":{"name":"IICor.2.15-16","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CO","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"619f9c2c148b4a2fa8deae3fb22a81b9963cc85b89eac2eea762d89ac84f4b13","sourceItemName":"IICor.2.15-16","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":15027,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CO","canonicalOSIS":"2Cor","method":"official_book_intro_ref_title","sourceOSIS":"2Cor"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Cor.2.15-16","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IICor.2.15-16","type":"StudyNote"},{"chapterAssociationStatus":"canonical_reference","content":[{"c":[{"c":[{"href":"?bref=2Cor.2.17","r":"2Cor.2.17","rawR":"2Cor.2.17","sourceRefs":[{"raw":"2Cor.2.17","value":"2Cor.2.17"}],"t":"ref","v":"2:17"}],"sourceClass":"sn-ref","t":"span"}," Paul contrasts his service with that of his opponents. • They ",{"c":["preach for personal profit"],"sourceClass":"sn-excerpt","t":"span"}," and adulterate the truth, like merchants in Paul’s day who offered shoddy goods, or innkeepers who watered down the wine. By contrast, Paul preached ",{"c":["with sincerity and with Christ’s authority"],"sourceClass":"sn-excerpt","t":"span"}," (cp. ",{"href":"?bref=2Cor.1.12","r":"2Cor.1.12","rawR":"2Cor.1.12","sourceRefs":[{"raw":"2Cor.1.12","value":"2Cor.1.12"}],"t":"ref","v":"1:12"},"; ",{"href":"?bref=2Cor.4.2","r":"2Cor.4.2","rawR":"2Cor.4.2","sourceRefs":[{"raw":"2Cor.4.2","value":"2Cor.4.2"}],"t":"ref","v":"4:2"},"). Paul’s denial of mercenary motives reemerges in ",{"href":"?bref=2Cor.11.1-12.21","r":"2Cor.11.1-12.21","rawR":"2Cor.11.1-12.21","sourceRefs":[{"raw":"2Cor.11.1-12.21","value":"2Cor.11.1-12.21"}],"t":"ref","v":"11:1–12:21"},"."],"sourceClass":"sn-text","t":"p"}],"id":"StudyNote:IICor.2.17","refs":[{"book":"2CO","endChapter":2,"endVerse":17,"startChapter":2,"startVerse":17}],"sourceAttributes":{"name":"IICor.2.17","product":"TyndaleOpenStudyNotes","typename":"StudyNote"},"sourceBookAppCode":"2CO","sourceChapterCoverage":[2],"sourceItemFragmentSha256":"3e48e1b6aba9fa397b3156fe413d8dd6d93693d6258985e1659d090fca3f0859","sourceItemName":"IICor.2.17","sourceMember":"Tyndale Open Study Notes/StudyNotes.xml","sourceOrder":15028,"sourceReferenceException":false,"sourceReferenceMappingEvidence":{"appCode":"2CO","canonicalOSIS":"2Cor","method":"official_book_intro_ref_title","sourceOSIS":"2Cor"},"sourceReferenceStatus":"canonical","sourceRefsExact":"2Cor.2.17","sourceRelease":"1.25","sourceTitleExact":null,"supplementPointersNotIncludedAsContent":[],"title":"IICor.2.17","type":"StudyNote"}],"version":"v2-a101d843a2f0cd3fc0c6"}