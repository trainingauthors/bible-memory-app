,"targets":[{"label":"Ezek 41:7","passages":[{"book":"EZK","chapter":41,"verses":[7]}]}],"verse":5},{"anchor":"three stories, and unlike the courts, they had no pillars","refs":["Ezek 41:6","1 Kgs 6:8"],"sourceRowNumber":41135,"targets":[{"label":"Ezek 41:6","passages":[{"book":"EZK","chapter":41,"verses":[6]}]},{"label":"1 Kgs 6:8","passages":[{"book":"1KI","chapter":6,"verses":[8]}]}],"verse":6},{"anchor":"below these chambers","refs":["Ezek 46:19"],"sourceRowNumber":41136,"targets":[{"label":"Ezek 46:19","passages":[{"book":"EZK","chapter":46,"verses":[19]}]}],"verse":9},{"anchor":"length of the wall","refs":["Ezek 41:12"],"sourceRowNumber":41137,"targets":[{"label":"Ezek 41:12","passages":[{"book":"EZK","chapter":41,"verses":[12]}]}],"verse":10},{"anchor":"opposite the building","refs":["Ezek 42:1,13","Ezek 41:13-15"],"sourceRowNumber":41138,"targets":[{"label":"Ezek 42:1,13","passages":[{"book":"EZK","chapter":42,"verses":[1,13]}]},{"label":"Ezek 41:13-15","passages":[{"book":"EZK","chapter":41,"verses":[13,14,15]}]}],"verse":10},{"anchor":"holy chambers","refs":["Exod 29:31","Lev 6:14-16,26","Lev 7:6","Lev 10:13-14,17","Lev 24:9","Num 18:9"],"sourceRowNumber":41139,"targets":[{"label":"Exod 29:31","passages":[{"book":"EXO","chapter":29,"verses":[31]}]},{"label":"Lev 6:14-16,26","passages":[{"book":"LEV","chapter":6,"verses":[14,15,16,26]}]},{"label":"Lev 7:6","passages":[{"book":"LEV","chapter":7,"verses":[6]}]},{"label":"Lev 10:13-14,17","passages":[{"book":"LEV","chapter":10,"verses":[13,14,17]}]},{"label":"Lev 24:9","passages":[{"book":"LEV","chapter":24,"verses":[9]}]},{"label":"Num 18:9","passages":[{"book":"NUM","chapter":18,"verses":[9]}]}],"verse":13},{"anchor":"approach the LORD","refs":["Ezek 40:46","Lev 10:3","Num 16:5,40","Num 18:7","Deut 21:5"],"sourceRowNumber":41140,"targets":[{"label":"Ezek 40:46","passages":[{"book":"EZK","chapter":40,"verses":[46]}]},{"label":"Lev 10:3","passages":[{"book":"LEV","chapter":10,"verses":[3]}]},{"label":"Num 16:5